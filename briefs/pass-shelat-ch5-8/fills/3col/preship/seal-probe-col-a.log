## Probe/ColASeal2.lean
import TCSlib.Cryptography.ZeroKnowledge.ThreeColoring.Protocol
set_option maxHeartbeats 400000
set_option autoImplicit false
open TCSlib.Cryptography Complexity Turing
namespace SealProbeA2
section Sealed
attribute [local irreducible] TCSlib.Cryptography.Protocol.outV
  TCSlib.Cryptography.Protocol.transcriptWith TCSlib.Cryptography.exec
  TCSlib.Cryptography.Strategy.coinLen TCSlib.Cryptography.Protocol.withV
variable {Com : List Bool → List Bool} {ℓ : PolyExpr}
/-- A5: from `outV_withV` to the plain protocol through `withV_self`. -/
theorem a5 (P' : Strategy) (x y z : List Bool) (r : (colProtocolRep Com ℓ).ExecCoins P' x) :
    (colProtocolRep Com ℓ).outV P' x y z r =
      (colVerifierRep Com ℓ).next x z (List.ofFn r.2)
        (exec P' (colVerifierRep Com ℓ) false x y z (List.ofFn r.1) (List.ofFn r.2)
          ((PolyExpr.mul (.const 4) (.mul .var .var)).eval x.length)).2 := by
  have h := Protocol.outV_withV (colProtocolRep Com ℓ) (colProtocolRep Com ℓ).V P' x y z
  rw [Protocol.withV_self] at h
  exact h r
/-- A6: the coin length of the one-iteration prover (`Strategy.coinLen` body); expected FAIL. -/
example (N : ℕ) : (colProver Com ℓ).coinLen N = 3 * N + N * ℓ.eval N := by
  show (PolyExpr.add (.mul (.const 3) .var) (.mul .var ℓ)).eval N = _
  simp
end Sealed
end SealProbeA2

