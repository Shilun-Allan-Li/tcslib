## Probe/ColASeal.lean
import TCSlib.Cryptography.ZeroKnowledge.ThreeColoring.Simulator
set_option maxHeartbeats 400000
set_option autoImplicit false
open TCSlib.Cryptography Complexity Turing

/-! Rule-10 shape probe for col-a's routes (and the shadow device), plus `Strategy.Efficient`. -/
namespace SealProbeA

section Sealed
attribute [local irreducible] TCSlib.Cryptography.Protocol.outV
  TCSlib.Cryptography.Protocol.transcriptWith TCSlib.Cryptography.exec TCSlib.Cryptography.R3COL
  TCSlib.Cryptography.L3COL TCSlib.Cryptography.encColoring TCSlib.Cryptography.Strategy.Efficient
  TCSlib.Cryptography.ColProofs.colProverRep

variable {Com : List Bool → List Bool} {ℓ : PolyExpr}

/-- A1: the verdict of the repeated protocol against `P'` in the published form
(`outV_withV` after `withV_self`). -/
theorem a1 (P' : Strategy) (x y z : List Bool)
    (r : ((colProtocolRep Com ℓ).withV (colProtocolRep Com ℓ).V).ExecCoins P' x) :
    ((colProtocolRep Com ℓ).withV (colProtocolRep Com ℓ).V).outV P' x y z r =
      (colVerifierRep Com ℓ).next x z (List.ofFn r.2)
        (exec P' (colVerifierRep Com ℓ) false x y z (List.ofFn r.1) (List.ofFn r.2)
          ((PolyExpr.mul (.const 4) (.mul .var .var)).eval x.length)).2 :=
  Protocol.outV_withV _ _ _ _ _ _ _

/-- A2: the same without `withV` (reads `outV`/`transcriptWith` by `rfl`); expected FAIL sealed. -/
example (P' : Strategy) (x y z : List Bool) (r : (colProtocolRep Com ℓ).ExecCoins P' x) :
    (colProtocolRep Com ℓ).outV P' x y z r =
      (colVerifierRep Com ℓ).next x z (List.ofFn r.2)
        (exec P' (colVerifierRep Com ℓ) false x y z (List.ofFn r.1) (List.ofFn r.2)
          ((PolyExpr.mul (.const 4) (.mul .var .var)).eval x.length)).2 := rfl

/-- A3: destructuring `R3COL` (Language.lean) reads its body; expected FAIL sealed. -/
example (x y : List Bool) (h : R3COL x y) : ∃ n : ℕ, x.length = n * n := by
  obtain ⟨n, G, c, rfl, rfl, -⟩ := h
  exact ⟨n, length_encGraph G⟩

/-- A4: the shadow device under a seal of the shadow (`ColProofs.colProverRep`). -/
example (hCom : PolyTimeComputable Com) : (colProverRep Com ℓ).Efficient :=
  ColProofs.colProverRep_efficient hCom ℓ

/-- B1 (col-b): destructuring `Strategy.Efficient` (Interaction.lean); expected FAIL sealed. -/
example (V' : Strategy) (hV' : V'.Efficient) : ∃ A : NUPPT, A.Uniform := by
  obtain ⟨A, hA, -, -⟩ := hV'
  exact ⟨A, hA⟩

/-- B2 (col-b): the published route `Efficient.exists_uniform`. -/
example (V' : Strategy) (hV' : V'.Efficient) : ∃ A : NUPPT, A.Uniform :=
  (hV'.exists_uniform).imp fun _ h => h.1

end Sealed

section Unsealed
variable {Com : List Bool → List Bool} {ℓ : PolyExpr}
example (P' : Strategy) (x y z : List Bool) (r : (colProtocolRep Com ℓ).ExecCoins P' x) :
    (colProtocolRep Com ℓ).outV P' x y z r =
      (colVerifierRep Com ℓ).next x z (List.ofFn r.2)
        (exec P' (colVerifierRep Com ℓ) false x y z (List.ofFn r.1) (List.ofFn r.2)
          ((PolyExpr.mul (.const 4) (.mul .var .var)).eval x.length)).2 := rfl
example (x y : List Bool) (h : R3COL x y) : ∃ n : ℕ, x.length = n * n := by
  obtain ⟨n, G, c, rfl, rfl, -⟩ := h
  exact ⟨n, length_encGraph G⟩
example (hCom : PolyTimeComputable Com) : (colProverRep Com ℓ).Efficient :=
  ColProofs.colProverRep_efficient hCom ℓ
example (V' : Strategy) (hV' : V'.Efficient) : ∃ A : NUPPT, A.Uniform := by
  obtain ⟨A, hA, -, -⟩ := hV'
  exact ⟨A, hA⟩
end Unsealed
end SealProbeA

