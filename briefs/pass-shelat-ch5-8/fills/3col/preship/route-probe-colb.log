/-- C1 (seal control): `PolyExpr.eval` read through its body; must FAIL sealed. -/
example (n : ℕ) : Complexity.PolyExpr.eval .var n = n := rfl

/-- C2 (seal control): `distAdv` read through its body; must FAIL sealed. -/
example {σ τ γ ρ : Type} [Fintype σ] [Fintype τ] [Fintype ρ] (X : σ → γ) (Y : τ → γ)
    (D : γ → ρ → Bool) : 0 ≤ distAdv X Y D := abs_nonneg _

variable {Com : List Bool → List Bool} {ℓ : PolyExpr}

/-- R1: step (4) and the fixed-coin bridge (ladder step 4, `exists_colSimRed_fixCoins`):
`exists_colSimRed_ge` then `CommitmentLemmas.exists_fixCoins` with `κ :=` the attempt table and
`ρ :=` `D'`'s coins. -/
theorem r1 {n : ℕ} (G : Graph n) (hm : 0 < edgeCount G) (c : Fin n → Fin 3) {ρ : Type}
    [Fintype ρ] [Nonempty ρ] (V : List Bool → ρ → List Bool) (N : ℕ) (hN : 0 < N) {ρ' : Type}
    [Fintype ρ'] (D' : Option (ColView ρ) → ρ' → Bool) :
    ∃ (k : Fin N) (e₀ : Fin (edgeCount G)) (π₀ : Equiv.Perm (Fin 3))
      (w₀ : Fin N → ((Fin (edgeCount G) × Equiv.Perm (Fin 3)) ×
        (Fin n → Fin (ℓ.eval n) → Bool)) × ρ),
      distAdv (colSimTruncW Com (ℓ.eval n) G c V N) (colSimTruncH Com (ℓ.eval n) G c V N) D' / N ≤
        distAdv
          (fun r : Fin n → Fin (ℓ.eval n) → Bool =>
            multiCom Com (fun i => padColor n (simColorsW (edgeOf G e₀) π₀ c i)) r)
          (fun r : Fin n → Fin (ℓ.eval n) → Bool => multiCom Com (fun i => padColor n (π₀ (c i))) r)
          (fun cv c' => colSimRed Com (ℓ.eval n) G c V N k e₀ π₀ D' cv (w₀, c')) := by
  obtain ⟨k, e₀, π₀, h⟩ := exists_colSimRed_ge Com (ℓ.eval n) G hm c V N hN D'
  haveI : Nonempty (Fin (edgeCount G)) := ⟨⟨0, hm⟩⟩
  obtain ⟨w₀, hw₀⟩ := CommitmentLemmas.exists_fixCoins
    (fun r : Fin n → Fin (ℓ.eval n) → Bool =>
      multiCom Com (fun i => padColor n (simColorsW (edgeOf G e₀) π₀ c i)) r)
    (fun r : Fin n → Fin (ℓ.eval n) → Bool => multiCom Com (fun i => padColor n (π₀ (c i))) r)
    (colSimRed Com (ℓ.eval n) G c V N k e₀ π₀ D')
  exact ⟨k, e₀, π₀, w₀, h.trans hw₀⟩

/-- R2: with the table fixed, only attempt `k` reads the challenge (statement only). -/
theorem r2 {n : ℕ} (G : Graph n) (c : Fin n → Fin 3) {ρ : Type} (V : List Bool → ρ → List Bool)
    {N : ℕ} (k : Fin N) (e₀ : Fin (edgeCount G)) (π₀ : Equiv.Perm (Fin 3)) {ρ' : Type}
    (D' : Option (ColView ρ) → ρ' → Bool)
    (w₀ : Fin N → ((Fin (edgeCount G) × Equiv.Perm (Fin 3)) × (Fin n → Fin (ℓ.eval n) → Bool)) × ρ)
    (cv : List Bool) (c' : ρ') :
    colSimRed Com (ℓ.eval n) G c V N k e₀ π₀ D' cv (w₀, c') =
      D' ((firstSome fun t : Fin N =>
            if (t : ℕ) < k then colSimAttemptH Com (ℓ.eval n) G c V (w₀ t) else none) <|>
          colSimAttemptPlanted Com (ℓ.eval n) G c V e₀ π₀ cv (w₀ k) <|>
          (firstSome fun t : Fin N =>
            if k < t then colSimAttemptW Com (ℓ.eval n) G c V (w₀ t) else none)) c' := by
  sorry

/-- R3a: `Commitment.multiHiding` with `q := var` applied directly to vectors indexed by `Fin n`
(needs `var.eval n ≡ n` by unfolding `PolyExpr.eval`). Expected to FAIL sealed. -/
example (hC : Commitment Com ℓ) (B : NUPPT) : ∃ ε : ℕ → ℝ, Negligible ε ∧
    ∀ (n : ℕ) (v v' : Fin n → Fin n → Bool),
      distAdv (fun r : Fin n → Fin (ℓ.eval n) → Bool => multiCom Com v r)
        (fun r : Fin n → Fin (ℓ.eval n) → Bool => multiCom Com v' r) (B.distinguisherL n) ≤ ε n := by
  obtain ⟨ε, hε, h⟩ := hC.multiHiding .var B
  exact ⟨ε, hε, fun n v v' => h n v v'⟩

/-- R3b: the same through the published `PolyExpr.eval_var` (`rw … at`). -/
theorem r3b (hC : Commitment Com ℓ) (B : NUPPT) : ∃ ε : ℕ → ℝ, Negligible ε ∧
    ∀ (n : ℕ) (v v' : Fin n → Fin n → Bool),
      distAdv (fun r : Fin n → Fin (ℓ.eval n) → Bool => multiCom Com v r)
        (fun r : Fin n → Fin (ℓ.eval n) → Bool => multiCom Com v' r) (B.distinguisherL n) ≤ ε n := by
  obtain ⟨ε, hε, h⟩ := hC.multiHiding .var B
  refine ⟨ε, hε, fun n => ?_⟩
  have h' := h n
  rw [PolyExpr.eval_var] at h'
  exact h'

/-- R4: the machine `B` (`D` at parameter `n²`) by `NUPPT.exists_reparam` and
`NUPPT.exists_withAdvice`, its runs in the published equations. -/
theorem r4 (D : NUPPT) (β : ℕ → List Bool) (b : PolyExpr) (hβ : ∀ n, (β n).length ≤ b.eval n) :
    ∃ B : NUPPT, B.coins = D.coins.subst (.mul .var .var) ∧
      ∀ n y r, B.runAtL n y r = D.runAtL (n * n) (pairEncode y (β (n * n))) r := by
  obtain ⟨A, hAc, hA⟩ := D.exists_withAdvice β b hβ
  obtain ⟨B, hBc, -, hB⟩ := A.exists_reparam (.mul .var .var)
  refine ⟨B, by rw [hBc, hAc], fun n y r => ?_⟩
  rw [hB, hA, PolyExpr.eval_mul, PolyExpr.eval_var]

/-- R5: two-parameter coin transport. `EnsembleLemmas.acceptProb_coins_equiv` applies; the rest
needs `NUPPT.distinguisherL` and `NUPPT.coinLen` through their bodies (no equation lemmas). -/
theorem r5 (B D : NUPPT) (n : ℕ) (F : List Bool → List Bool)
    (hc : B.coins = D.coins.subst (.mul .var .var))
    (hrun : ∀ y r, B.runAtL n y r = D.runAtL (n * n) (F y) r) {σ : Type} [Fintype σ]
    (X : σ → List Bool) :
    acceptProb X (B.distinguisherL n) =
      acceptProb X fun y c => D.distinguisherL (n * n) (F y) c := by
  have hlen : D.coinLen (n * n) = B.coinLen n := by
    sorry -- needs `NUPPT.coinLen` (PPT.lean) through its body, then `PolyExpr.eval_subst`
  rw [← EnsembleLemmas.acceptProb_coins_equiv
    (Equiv.arrowCongr (finCongr hlen) (Equiv.refl Bool)) X (B.distinguisherL n)]
  congr 1
  funext y c
  sorry -- needs `NUPPT.distinguisherL` (Adversary.lean) through its body, then `NUPPT.runAt_eq`

/-- R6: the target's quantifiers. `intro` on `ZK` reads its body; expected to FAIL sealed. -/
example (hC : Commitment Com ℓ) : ZK (colProtocol Com ℓ) R3COL := by
  intro V' hV'
  sorry

/-- R7: the simulator of `exists_colSimulator` and the target's simulator slot. -/
example (hC : Commitment Com ℓ) (V' : Strategy) (hV' : V'.Efficient) :
    ∃ S : NUPPT, S.Uniform ∧ ∀ x z (r : S.Coins x.length),
      S.simulate x z r = colSim Com ℓ V' x z (List.ofFn r) := by
  obtain ⟨S, hS, -, hsim⟩ := exists_colSimulator hC.easy ℓ V' hV'
  exact ⟨S, hS, hsim⟩

/-- R8: nonnegativity of the hiding bound (review: `0 ≤ ε_B` from the conclusion at `v = v'`)
needs `0 ≤ distAdv …`, i.e. `distAdv`'s body. Expected to FAIL sealed. -/
example (hC : Commitment Com ℓ) (B : NUPPT) (ε : ℕ → ℝ)
    (h : ∀ n (v v' : Fin (PolyExpr.var.eval n) → Fin n → Bool),
      distAdv (fun r : Fin (PolyExpr.var.eval n) → Fin (ℓ.eval n) → Bool => multiCom Com v r)
        (fun r : Fin (PolyExpr.var.eval n) → Fin (ℓ.eval n) → Bool => multiCom Com v' r)
        (B.distinguisherL n) ≤ ε n) (n : ℕ) : 0 ≤ ε n :=
  (abs_nonneg _).trans (h n (fun _ _ => false) (fun _ _ => false))

end Sealed

