## probe source
import TCSlib.Cryptography.ZeroKnowledge.ThreeColoring.Protocol
set_option maxHeartbeats 400000
set_option autoImplicit false
open TCSlib.Cryptography Complexity Turing

/-! Duplication probe, col-a: `exact?` (maxHeartbeats 400000) on each target and planned lemma. -/
namespace DupA
variable {Com : List Bool → List Bool} {ℓ : PolyExpr}

/-- T1: the decidable clause of `R3COL_witnessRelation`. -/
example : ∃ T : List Bool → Bool, PolyTimeComputable (fun z => [T z]) ∧
    ∀ x y, T (pairEncode x y) = true ↔ R3COL x y := by exact?

/-- T1': the whole target. -/
example : WitnessRelation L3COL R3COL := by exact?

/-- T2: `colRep_efficientProverProof`. -/
example (hC : Commitment Com ℓ) : EfficientProverProof (colProtocolRep Com ℓ) L3COL R3COL := by
  exact?

/-- H1: the soundness error of the repeated protocol is negligible. -/
example : Negligible fun N : ℕ =>
    Real.exp (-(Nat.sqrt N : ℝ)) + (N : ℝ) ^ 2 * (1 / 2 : ℝ) ^ N + (2 : ℝ)⁻¹ ^ N := by exact?

/-- H2: `K` independent edge samplers are `K (1/2)^T`-close to uniform. -/
example {m : ℕ} (hm : 0 < m) (T K : ℕ) :
    StatClose (fun r : Fin K → Fin (T * Nat.size m) → Bool => fun t =>
        (⟨sampleEdgeIdx m T (List.ofFn (r t)), sampleEdgeIdx_lt hm T _⟩ : Fin m))
      (fun e : Fin K → Fin m => e) (K * (1 / 2 : ℝ) ^ T) := by exact?

/-- H3: the iteration count is at most `|x|²`. -/
example {n : ℕ} (G : Graph n) : n * edgeCount G ≤ (encGraph G).length * (encGraph G).length := by
  exact?
end DupA

