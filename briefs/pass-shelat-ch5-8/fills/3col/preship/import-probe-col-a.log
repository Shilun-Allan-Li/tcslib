exec_succ : ∀ (P V : Strategy) (vFirst : Bool) (x zP zV rP rV : List Bool) (k : ℕ),
  exec P V vFirst x zP zV rP rV (k + 1) =
    have e := exec P V vFirst x zP zV rP rV k;
    if moverIsV vFirst k = true then (e.1 ++ [V.next x zV rV e.2], e.2) else (e.1, e.2 ++ [P.next x zP rP e.1])
