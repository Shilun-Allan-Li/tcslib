  StatClose X Y δ → ∀ (P : γ → ρ → Prop), |(uprob fun z => P (X z.1) z.2) - uprob fun z => P (Y z.1) z.2| ≤ δ
@uprob_col_cheat_le : ∀ {Com : List Bool → List Bool} {ℓ : PolyExpr},
  Commitment Com ℓ →
    ∀ {n : ℕ},
      2 ≤ n →
        ∀ {G : Graph n},
          ¬ThreeColorable G →
            ∀ (k : ℕ) {W : Type u_1} [inst : Fintype W]
              (comF : (i : Fin k) → (Fin ↑i → Fin (edgeCount G)) → W → List Bool)
              (opnF : (i : Fin k) → (Fin (↑i + 1) → Fin (edgeCount G)) → W → List Bool),
              (uprob fun z =>
                  ∀ (i : Fin k),
                    colVerify Com (ℓ.eval n) G (↑(z.1 i)) (comF i (challengesBefore z.1 i) z.2)
                        (opnF i (challengesUpTo z.1 i) z.2) =
                      true) ≤
                (1 - 1 / ↑(edgeCount G)) ^ k
