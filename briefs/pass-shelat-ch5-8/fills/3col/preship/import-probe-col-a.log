polyTimeComputable_pairEq : PolyTimeComputable fun z => [decide (pairFstD z = pairSndD z)]
polyTimeComputable_blockMap : ∀ (b : PolyExpr) {g : List Bool → List Bool},
  PolyTimeComputable g →
    PolyTimeComputable fun z =>
      List.flatMap
        (fun i => g (List.take (b.eval (pairFstD z).length) (List.drop (i * b.eval (pairFstD z).length) (pairSndD z))))
        (List.range ((pairSndD z).length / b.eval (pairFstD z).length))
@polyTimeComputable_iterateEmit : ∀ {g emit : List Bool → List Bool},
  PolyTimeComputable g →
