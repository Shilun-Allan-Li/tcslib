import TCSlib.Cryptography.ZeroKnowledge.ThreeColoring.Simulator
set_option maxHeartbeats 400000
set_option autoImplicit false
open TCSlib.Cryptography Complexity Turing ColSimLemmas

/-! Duplication probe, col-b: `exact?` (maxHeartbeats 400000) on the target and each ladder step. -/
namespace DupB
variable {Com : List Bool → List Bool} {ℓ : PolyExpr}

/-- L1 `statClose_sampleColorPair`. -/
example (T : ℕ) : StatClose (fun r : Fin (T * 3) → Bool => sampleColorPair T (List.ofFn r))
    (id : ColorPair → ColorPair) ((1 / 4 : ℝ) ^ T) := by exact?

/-- L2 the real view to `some ∘ colRealView` (encoded). -/
example (V' : Strategy) {n : ℕ} (G : Graph n) (c : Fin n → Fin 3) (hc : ProperColoring G c)
    (z : List Bool) :
    StatClose (fun r => (((colProtocol Com ℓ).withV V').viewV (encGraph G) (encColoring c) z r).encode)
      (fun w : (Equiv.Perm (Fin 3) × (Fin n → Fin (ℓ.eval n) → Bool)) × V'.Coins (encGraph G).length =>
        (some (colRealView Com (ℓ.eval n) G c
            (fun com ρ => V'.next (encGraph G) z (List.ofFn ρ) [com]) w)).elim []
          fun v => View.encode ⟨encGraph G, z, List.ofFn v.1, [v.2.1, v.2.2]⟩)
      ((1 / 4 : ℝ) ^ (encGraph G).length) := by exact?

/-- L3 `colSim` to `colSimTrunc` (encoded), `m > 0`. -/
example (V' : Strategy) {n : ℕ} (G : Graph n) (hm : 0 < edgeCount G) (z : List Bool) :
    StatClose (fun r : Fin ((colSimCoins ℓ V').eval (encGraph G).length) → Bool =>
        colSim Com ℓ V' (encGraph G) z (List.ofFn r))
      (fun w : Fin (n * edgeCount G) → ((Fin (edgeCount G) × ColorPair) ×
          (Fin n → Fin (ℓ.eval n) → Bool)) × V'.Coins (encGraph G).length =>
        (colSimTrunc Com (ℓ.eval n) G (fun com ρ => V'.next (encGraph G) z (List.ofFn ρ) [com])
            (n * edgeCount G) w).elim []
          fun v => View.encode ⟨encGraph G, z, List.ofFn v.1, [v.2.1, v.2.2]⟩)
      ((n * edgeCount G : ℕ) * ((1 / 2 : ℝ) ^ (encGraph G).length +
        (1 / 4 : ℝ) ^ (encGraph G).length)) := by exact?

/-- L4 `exists_colSimRed_fixCoins` (the route probe's `r1`). -/
example {n : ℕ} (G : Graph n) (hm : 0 < edgeCount G) (c : Fin n → Fin 3) {ρ : Type}
    [Fintype ρ] [Nonempty ρ] (V : List Bool → ρ → List Bool) (N : ℕ) (hN : 0 < N) {ρ' : Type}
    [Fintype ρ'] (D' : Option (ColView ρ) → ρ' → Bool) :
    ∃ (k : Fin N) (e₀ : Fin (edgeCount G)) (π₀ : Equiv.Perm (Fin 3))
      (w₀ : Fin N → ((Fin (edgeCount G) × Equiv.Perm (Fin 3)) ×
        (Fin n → Fin (ℓ.eval n) → Bool)) × ρ),
      distAdv (colSimTruncW Com (ℓ.eval n) G c V N) (colSimTruncH Com (ℓ.eval n) G c V N) D' / N ≤
        distAdv
          (fun r : Fin n → Fin (ℓ.eval n) → Bool =>
            multiCom Com (fun i => padColor n (simColorsW (edgeOf G e₀) π₀ c i)) r)
          (fun r : Fin n → Fin (ℓ.eval n) → Bool => multiCom Com (fun i => padColor n (π₀ (c i))) r)
          (fun cv c' => colSimRed Com (ℓ.eval n) G c V N k e₀ π₀ D' cv (w₀, c')) := by exact?

/-- L5a the machine shape: `D` at parameter `n²` after a polynomial-time map of the challenge and
the advice. -/
example (D : NUPPT) {f : List Bool → List Bool} (hf : PolyTimeComputable f) (β : ℕ → List Bool)
    (b : PolyExpr) (hβ : ∀ n, (β n).length ≤ b.eval n) :
    ∃ B : NUPPT, B.coins = D.coins.subst (.mul .var .var) ∧
      ∀ n y r, B.runAtL n y r = D.runAtL (n * n) (f (pairEncode y (β n))) r := by exact?

/-- L5b two-parameter coin transport. -/
example (B D : NUPPT) (n m : ℕ) (F : List Bool → List Bool) (hc : B.coinLen n = D.coinLen m)
    (hrun : ∀ y r, B.runAtL n y r = D.runAtL m (F y) r) {σ : Type} [Fintype σ]
    (X : σ → List Bool) :
    acceptProb X (B.distinguisherL n) = acceptProb X fun y c => D.distinguisherL m (F y) c := by
  exact?

/-- L5c one call of an efficient verifier on an arbitrary polynomial-time tape. -/
example {V' : Strategy} (hV' : V'.Efficient) {X Z R C : List Bool → List Bool}
    (hX : PolyTimeComputable X) (hZ : PolyTimeComputable Z) (hR : PolyTimeComputable R)
    (hC : PolyTimeComputable C) : PolyTimeComputable fun w => V'.next (X w) (Z w) (R w) [C w] := by
  exact?

/-- L6 the edgeless case (`m = 0`, `n ≥ 1`). -/
example (V' : Strategy) {n : ℕ} (hn : 1 ≤ n) (G : Graph n) (hm : edgeCount G = 0)
    (c : Fin n → Fin 3) (z : List Bool) (D : NUPPT) :
    ∃ (π₀ : Equiv.Perm (Fin 3)) (rV : V'.Coins (encGraph G).length),
      distAdv (fun r => (((colProtocol Com ℓ).withV V').viewV (encGraph G) (encColoring c) z r).encode)
          (fun r : Fin ((colSimCoins ℓ V').eval (encGraph G).length) → Bool =>
            colSim Com ℓ V' (encGraph G) z (List.ofFn r))
          (D.distinguisherL (encGraph G).length) ≤
        (1 / 4 : ℝ) ^ (encGraph G).length +
          distAdv (fun r : Fin n → Fin (ℓ.eval n) → Bool =>
              multiCom Com (fun i => padColor n (π₀ (c i))) r)
            (fun r : Fin n → Fin (ℓ.eval n) → Bool => multiCom Com (fun _ => padColor n 0) r)
            (fun cv d => D.distinguisherL (encGraph G).length
              (View.encode ⟨encGraph G, z, List.ofFn rV, [cv, []]⟩) d) := by exact?

/-- L7a the assembled error is negligible. -/
example {εB : ℕ → ℝ} (h : Negligible εB) : Negligible fun N : ℕ =>
    (N : ℝ) ^ 2 * εB (Nat.sqrt N) + Real.exp (-(Nat.sqrt N : ℝ)) +
      (N : ℝ) ^ 2 * ((1 / 2 : ℝ) ^ N + (1 / 4 : ℝ) ^ N) + (1 / 4 : ℝ) ^ N := by exact?

/-- L7b the attempt count. -/
example {n : ℕ} (G : Graph n) : n * edgeCount G ≤ (encGraph G).length ^ 2 := by exact?

/-- L7 the target. -/
example (hC : Commitment Com ℓ) : ZK (colProtocol Com ℓ) R3COL := by exact?
end DupB

