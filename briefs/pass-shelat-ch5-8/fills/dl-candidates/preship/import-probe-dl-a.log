rejectBlocksL_eq : ∀ (E : ℕ → Prop) [inst : DecidablePred E] (k B T : ℕ) (r : List Bool),
  rejectBlocksL E k B T r =
    List.findSome?
      (fun t =>
        if E (listToNat (List.take k (List.drop (t * B) r))) then some (listToNat (List.take k (List.drop (t * B) r)))
        else none)
      (List.range T)
@rejectBlocksL_spec : ∀ {E : ℕ → Prop} [inst : DecidablePred E] {k B T : ℕ} {r : List Bool} {v : ℕ},
  rejectBlocksL E k B T r = some v → E v ∧ v < 2 ^ k
sampleBelowL_eq_rejectBlocksL : ∀ (m k B T : ℕ), sampleBelowL m k B T = rejectBlocksL (fun x => x < m) k B T
@sampleBelowL_lt : ∀ {m k B T : ℕ} {r : List Bool} {v : ℕ}, sampleBelowL m k B T r = some v → v < m
@bitsEquiv_val : ∀ {k : ℕ} (b : Fin k → Bool), ↑((bitsEquiv k) b) = bitsToNat b
@bitsToNat_eq_listToNat : ∀ {n : ℕ} (b : Fin n → Bool), bitsToNat b = listToNat (List.ofFn b)
@uprob_bitsToNat_lt : ∀ {m k : ℕ}, m ≤ 2 ^ k → (uprob fun b => bitsToNat b < m) = ↑m / 2 ^ k
@mem_QR_iff : ∀ {N : ℕ} (x : (ZMod N)ˣ), x ∈ QR N ↔ ∃ y, y ^ 2 = x
@coe_sqTo : ∀ {N : ℕ} (x : (ZMod N)ˣ), ↑(sqTo N x) = x ^ 2
leStr_pairEncode : ∀ (a b : List Bool), leStr (pairEncode a b) = [decide (listToNat a ≤ listToNat b)]
modExpStr_pairEncode : ∀ (a x N : List Bool),
  modExpStr (pairEncode a (pairEncode x N)) = natToList N.length (listToNat a ^ listToNat x % listToNat N)
mulStr_pairEncode : ∀ (a b : List Bool),
  mulStr (pairEncode a b) = natToList (a.length + b.length) (listToNat a * listToNat b)
subStr_pairEncode : ∀ (a b : List Bool), subStr (pairEncode a b) = natToList a.length (listToNat a - listToNat b)
addStr_pairEncode : ∀ (a b : List Bool),
  addStr (pairEncode a b) = natToList (a.length + b.length) (listToNat a + listToNat b)
length_sizeStr : ∀ (w : List Bool), (sizeStr w).length = (listToNat w).size
@listToNat_natToList : ∀ {k N : ℕ}, N < 2 ^ k → listToNat (natToList k N) = N
natToList_length_listToNat : ∀ (w : List Bool), natToList w.length (listToNat w) = w
@decodeFin_ofFn : ∀ {ℓ : ℕ} (x : Fin ℓ → Bool), decodeFin ℓ (List.ofFn x) = some x
@ofFn_of_decodeFin_eq_some : ∀ {ℓ : ℕ} {w : List Bool} {x : Fin ℓ → Bool}, decodeFin ℓ w = some x → List.ofFn x = w
@padFin_ofFn : ∀ {ℓ : ℕ} (x : Fin ℓ → Bool), padFin ℓ (List.ofFn x) = x
