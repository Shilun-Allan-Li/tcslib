NUPPT.inArg_layout : ∀ (u y α r : List Bool), NUPPT.inArg (NUPPT.layout u y α r) = y
NUPPT.inAdvice_layout : ∀ (u y α r : List Bool), NUPPT.inAdvice (NUPPT.layout u y α r) = α
NUPPT.inCoins_layout : ∀ (u y α r : List Bool), NUPPT.inCoins (NUPPT.layout u y α r) = r
