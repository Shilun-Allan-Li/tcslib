@pow_eq_pow_iff_modEq : ∀ {G : Type u_1} [inst : LeftCancelMonoid G] {x : G} {m n : ℕ},
  x ^ n = x ^ m ↔ n ≡ m [MOD orderOf x]
ZMod.euler_criterion_units : ∀ (p : ℕ) [inst : Fact (Nat.Prime p)] (x : (ZMod p)ˣ), (∃ y, y ^ 2 = x) ↔ x ^ (p / 2) = 1
@ZMod.pow_card_sub_one_eq_one : ∀ {p : ℕ} [inst : Fact (Nat.Prime p)] {a : ZMod p}, a ≠ 0 → a ^ (p - 1) = 1
ZMod.units_pow_card_sub_one_eq_one : ∀ (p : ℕ) [inst : Fact (Nat.Prime p)] (a : (ZMod p)ˣ), a ^ (p - 1) = 1
@orderOf_eq_prime : ∀ {G : Type u_1} [inst : Monoid G] {x : G} {p : ℕ} [hp : Fact (Nat.Prime p)],
  x ^ p = 1 → x ≠ 1 → orderOf x = p
@Subgroup.eq_of_le_of_card_ge : ∀ {G : Type u_1} [inst : Group G] {H K : Subgroup G} [Finite ↥K],
  H ≤ K → Nat.card ↥K ≤ Nat.card ↥H → H = K
@Nat.card_zpowers : ∀ {α : Type u_1} [inst : Group α] (a : α), Nat.card ↥(Subgroup.zpowers a) = orderOf a
@ZMod.neg_one_ne_one : ∀ {n : ℕ} [Fact (2 < n)], -1 ≠ 1
@ZMod.exists_sq_eq_neg_one_iff : ∀ {p : ℕ} [inst : Fact (Nat.Prime p)], IsSquare (-1) ↔ p % 4 ≠ 3
