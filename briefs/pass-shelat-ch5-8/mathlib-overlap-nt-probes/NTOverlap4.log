@ZMod.unitsEquivCoprime : {n : ℕ} → [NeZero n] → (ZMod n)ˣ ≃ { x // x.val.Coprime n }
ZMod.finEquiv : (n : ℕ) → [NeZero n] → Fin n ≃+* ZMod n
@ZMod.val_coe_unit_coprime : ∀ {n : ℕ} (u : (ZMod n)ˣ), (↑u).val.Coprime n
@ZMod.coe_unitOfCoprime : ∀ {n : ℕ} (x : ℕ) (h : x.Coprime n), ↑(ZMod.unitOfCoprime x h) = ↑x
ZMod.isUnit_iff_coprime : ∀ (m n : ℕ), IsUnit ↑m ↔ m.Coprime n
@Units.sq_eq_sq_iff_eq_or_eq_neg : ∀ {R : Type u_1} [inst : CommRing R] [NoZeroDivisors R] {a b : Rˣ},
