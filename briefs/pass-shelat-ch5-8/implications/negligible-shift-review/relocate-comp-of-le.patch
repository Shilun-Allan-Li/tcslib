+/-- Composing a negligible function with a natural-valued map pointwise at least the identity
+preserves negligibility. Technical glue for reparameterizing inverse-polynomial bounds.
+
+**Proof sketch.** For the requested exponent, take the original threshold and also require
+`N ≥ 1`. Then `φ N ≥ N` is past that threshold, and the inverse-power bound at `φ N` is at
+most the bound at `N`. No condition is imposed on the finite initial range. -/
+theorem Negligible.comp_of_le {μ : ℕ → ℝ} (hμ : Negligible μ) (φ : ℕ → ℕ) (hφ : ∀ N, N ≤ φ N) :
+    Negligible fun N => μ (φ N) := by
+  intro c
+  obtain ⟨n₀, h₀⟩ := hμ c
+  refine ⟨max n₀ 1, fun N hN => ?_⟩
+  have hN1 : 1 ≤ N := le_trans (le_max_right _ _) hN
+  have hφN : n₀ ≤ φ N := le_trans (le_trans (le_max_left _ _) hN) (hφ N)
+  refine lt_of_lt_of_le (h₀ (φ N) hφN) ?_
+  have hNpos : (0 : ℝ) < (N : ℝ) ^ c := pow_pos (by exact_mod_cast hN1) c
+  exact one_div_le_one_div_of_le hNpos (pow_le_pow_left₀ (by positivity) (by exact_mod_cast hφ N) c)
 
 /-- The sum of two negligible functions is negligible. [Gar26, Exercise 1.1(1)–(2)].
 
