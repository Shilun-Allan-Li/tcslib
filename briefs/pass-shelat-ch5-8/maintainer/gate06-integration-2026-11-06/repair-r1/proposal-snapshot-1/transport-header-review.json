  "cases": [
    {
      "id": "hash_gen",
      "verdict": "no_static_finding",
      "original_domain": "rho : (hsGen S H).Coins n",
      "transport": "sigma j = rho (Fin.cast (hsGen_coinLen S H n).symm j)",
      "equivalence": "Canonical value-preserving index identification, then unchanged prefix/suffix split. List.ofFn_congr gives the entire same coin word; ofFn_coins_split gives exactly its take/drop segments.",
      "zero_case": "Arbitrary n, including 0; no positivity premise. Empty first/second coin segment works with take/drop; nonzero constant coin lengths at n=0 are also covered.",
      "owner_reader_rhs_exact": true,
      "new_premises": false,
      "data_changed": false
    },
    {
      "id": "hash_sign_and_correctness",
      "verdict": "no_static_finding",
      "original_domain": "r : S.sign.Coins n; arbitrary rs : (hsSign S H).Coins n in correctness",
      "transport": "e = NUPPT.coinsCongr (coins_ofPolyTimeUniform ...).symm n; use e r / e.symm rs",
      "equivalence": "e is a bijection. coinsCongr_ofFn preserves the forward word; apply_symm_apply transfers the same fact to inverse tapes. runAt_coinsCongr preserves the literal activation. The typed hashed message is identified with the original padded hash word by List.ofFn_congr and ofFn_padFin_eq_padStr.",
      "zero_case": "All finite lengths, including 0; no chosen bit or nonempty assumption.",
      "owner_reader_rhs_exact": true,
      "new_premises": false,
      "data_changed": false
    },
    {
      "id": "public_pad_enc",
      "verdict": "no_static_finding",
      "original_domain": "r : enc.Coins n",
      "new_domain": "r : (padEnc enc L).Coins n",
      "transport": "e = NUPPT.coinsCongr (padEnc_coins enc L) n maps padded coins to original coins",
      "equivalence": "The new forall ranges over the equivalent full coin domain; e is bijective and coinsCongr_ofFn preserves the exact word. Uniform enc and arbitrary y,n,L are retained. Both ofPadded callers pass e re to their unchanged correct/hL premises.",
      "zero_case": "n=0 and zero coin lengths are covered; no new length bound or positivity hypothesis.",
      "owner_reader_rhs_exact": true,
      "new_premises": false,
      "data_changed": false
    },
    {
      "id": "yao_call_headers",
      "verdict": "no_static_finding",
      "original_domain": "c : Fin 2 / c : Fin 1; j : Fin (Y.inB.eval n * n)",
      "transport": "Fin.cast of symmetric evaluated otFunctionality_inA/inB equalities",
      "equivalence": "Fin.cast preserves c.val and is invertible. Alice selects the same c=1 key bit; Bob ignores c and returns the same getD value. Arbitrary input/tape words and defaults remain covered.",
      "zero_case": "At n=0 the call index type is empty, so no call is excluded by a new premise. The fixed two-bit/one-bit OT domains remain meaningful for the owner point reader.",
      "owner_reader_rhs_exact": true,
      "new_premises": false,
      "data_changed": false
    },
    {
      "id": "ot_point_reader_and_answers",
      "verdict": "no_static_finding",
      "transport": "Typed OT point reader casts choice 0 and selected 0/1 through the identical input equalities; answers uses outB=1 under evaluation.",
      "equivalence": "The owner f outputs the selected sender bit as a constant one-bit function, so the reader is exact for arbitrary typed a,b and every typed output index. Public answersB_eq, singleton flattening, finProdFinEquiv indexing and the repaired call headers preserve call order and index i*n+t. Both foreign-body show steps are removed.",
      "zero_case": "n=0 makes t : Fin n impossible; Y.inB.eval n=0 makes i impossible. No positivity premise is added. xs,ys,rA,rB remain arbitrary words.",
      "owner_reader_rhs_exact": true,
      "new_premises": false,
      "data_changed": false
    }
  ],
