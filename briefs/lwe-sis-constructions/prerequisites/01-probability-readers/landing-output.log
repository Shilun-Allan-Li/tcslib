TCSlib.InformationTheory.isUniversal_iff.{u_1, u_2, u_3} {S : Type u_1} {α : Type u_2} {β : Type u_3} [Fintype S]
  [Fintype β] [DecidableEq β] (f : S → α → β) :
  TCSlib.InformationTheory.IsUniversal f ↔
    ∀ (x y : α), x ≠ y → ↑{s | f s x = f s y}.card ≤ ↑(Fintype.card S) / ↑(Fintype.card β)
'TCSlib.InformationTheory.isUniversal_iff' depends on axioms: [propext, Classical.choice, Quot.sound]
