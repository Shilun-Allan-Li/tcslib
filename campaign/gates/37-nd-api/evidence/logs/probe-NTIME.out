$S/wt-ndapi/TCSlib/NDApiProbe_NTIME.lean:257:8: warning: `Set.eq_empty_iff_forall_not_mem` has been deprecated: Use `Set.eq_empty_iff_forall_notMem` instead
@Turing.FinNDTM.acceptsWithin_iff : ∀ {N : Turing.FinNDTM Bool} {x : List Bool} {t : ℕ},
  N.AcceptsWithin x t ↔
    ∃ w,
      w.length = t ∧
        (Turing.NDTM.runWith w (Turing.NDTM.initCfg x)).state = none ∧
          (Turing.NDTM.runWith w (Turing.NDTM.initCfg x)).output = [true]
'Turing.FinNDTM.acceptsWithin_iff' depends on axioms: [propext, Quot.sound]
@Turing.FinNDTM.decidesInTime_iff : ∀ {N : Turing.FinNDTM Bool} {L : Language Bool} {T : ℕ → ℕ},
  N.DecidesInTime L T ↔ ∀ (x : List Bool), N.tm.HaltsWithin x (T x.length) ∧ (x ∈ L ↔ N.AcceptsWithin x (T x.length))
'Turing.FinNDTM.decidesInTime_iff' depends on axioms: [propext, Quot.sound]
@Complexity.mem_NTIME_iff : ∀ {T : ℕ → ℕ} {L : Language Bool},
  L ∈ Complexity.NTIME T ↔ ∃ c N, N.DecidesInTime L fun n => c * T n
'Complexity.mem_NTIME_iff' depends on axioms: [propext, Quot.sound]
