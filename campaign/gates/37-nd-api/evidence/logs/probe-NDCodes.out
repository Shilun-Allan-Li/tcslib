Turing.CodeNDTM.toFinNDTM_k : ∀ (M : Turing.CodeNDTM), M.toFinNDTM.k = 2
'Turing.CodeNDTM.toFinNDTM_k' depends on axioms: [propext, Classical.choice, Quot.sound]
Turing.CodeNDTM.toFinNDTM_State : ∀ (M : Turing.CodeNDTM), M.toFinNDTM.State = Fin (M.numStates + 1)
'Turing.CodeNDTM.toFinNDTM_State' depends on axioms: [propext, Classical.choice, Quot.sound]
Turing.CodeNDTM.toFinNDTM_tm : ∀ (M : Turing.CodeNDTM), M.toFinNDTM.tm = M.tm
'Turing.CodeNDTM.toFinNDTM_tm' depends on axioms: [propext, Classical.choice, Quot.sound]
