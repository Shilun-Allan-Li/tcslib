From 95d54ce2ef4fd882c73ad610434128b2933c603c Mon Sep 17 00:00:00 2001
From: Seyoon Ragavan <complexzetaprime@gmail.com>
Date: Wed, 4 Nov 2026 21:50:44 -0800
Subject: [PATCH 2/6] CfgFacts: the chunk-length lemma is
 length_flatMap_uniform, avoiding a namesake

Complexity.CfgTableau.length_flatMap_const exists in CircuitComplexity files that open both Turing
and CfgTableau, where an unqualified name would become ambiguous.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 TCSlib/Complexity/TuringMachine/CfgFacts.lean | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/TCSlib/Complexity/TuringMachine/CfgFacts.lean b/TCSlib/Complexity/TuringMachine/CfgFacts.lean
index 828c3788..57ab9954 100644
--- a/TCSlib/Complexity/TuringMachine/CfgFacts.lean
+++ b/TCSlib/Complexity/TuringMachine/CfgFacts.lean
@@ -29,7 +29,7 @@ No new definitions.
   gives phase `i`'s tagged configuration at `q`.
 * `Turing.Cfg.mapState_sigma_state_ne` — a configuration tagged by phase `i` is at no state of
   another phase.
-* `Turing.length_flatMap_const` — a list of equal-length chunks has length count × chunk length.
+* `Turing.length_flatMap_uniform` — a list of equal-length chunks has length count × chunk length.
 -/
 
 namespace Turing
@@ -88,7 +88,7 @@ theorem Cfg.mapState_sigma_state_ne {k : ℕ} {Γ I : Type*} {Ph : I → Type*}
 
 /-- **Equal-length chunks.** If every chunk `f a` has length `c`, the concatenation of the chunks
 of a list `l` has length `|l| · c`. -/
-theorem length_flatMap_const {α β : Type*} (l : List α) (f : α → List β) {c : ℕ}
+theorem length_flatMap_uniform {α β : Type*} (l : List α) (f : α → List β) {c : ℕ}
     (hf : ∀ a, (f a).length = c) : (l.flatMap f).length = l.length * c := by
   rw [List.length_flatMap, List.map_congr_left (fun a _ => hf a), List.map_const',
     List.sum_replicate]
