From 225bf4425a1ece7cc8a3d1b81ba9cf927ca7da69 Mon Sep 17 00:00:00 2001
From: Seyoon Ragavan <complexzetaprime@gmail.com>
Date: Thu, 22 Oct 2026 19:28:02 -0400
Subject: [PATCH] CodeSimulator: the increment lemma reads `Bool.toNat` through
 its equations

`simp [Bool.toNat]` (twice, in `canonStageInc_value`) unfolded the core definition and created the
module's only new public constant, `Bool.toNat.eq_1`; `simp only [Bool.toNat_true,
Bool.toNat_false]` does the same work (the review's F2).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 TCSlib/Complexity/TuringMachine/CodeSimulator.lean | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/TCSlib/Complexity/TuringMachine/CodeSimulator.lean b/TCSlib/Complexity/TuringMachine/CodeSimulator.lean
index 3acc87c1..bea488d7 100644
--- a/TCSlib/Complexity/TuringMachine/CodeSimulator.lean
+++ b/TCSlib/Complexity/TuringMachine/CodeSimulator.lean
@@ -6172,13 +6172,13 @@ private lemma canonStageInc_value : ∀ (w v : List Bool), incFixed w = some v 
   | false :: w, v, h => by
     obtain rfl : true :: w = v := Option.some.inj ((incFixed_false_cons w).symm.trans h)
     simp only [List.map_cons, Nat.ofDigits_cons]
-    simp [Bool.toNat]
+    simp only [Bool.toNat_true, Bool.toNat_false]
     omega
   | true :: w, v, h => by
     obtain ⟨z, hz, rfl⟩ :=
       Option.map_eq_some_iff.mp ((incFixed_true_cons w).symm.trans h)
     simp only [List.map_cons, Nat.ofDigits_cons, canonStageInc_value w z hz]
-    simp [Bool.toNat]
+    simp only [Bool.toNat_true, Bool.toNat_false]
     ring
 
 /-- A trailing `false` pad keeps the binary value. -/
-- 
