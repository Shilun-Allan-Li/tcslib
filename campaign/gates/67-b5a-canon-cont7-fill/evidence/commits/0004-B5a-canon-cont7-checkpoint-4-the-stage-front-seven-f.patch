+            have h1 := hcon.2.1
+            rw [hA_cp] at h1
+            exact h1), (by
+            have h2 := hcon.2.2
+            rw [hA_cp] at h2
+            simpa using h2)⟩), hA_c, hB_c, FinTM.bufferTape_eq, FinTM.bufferTape_eq]
