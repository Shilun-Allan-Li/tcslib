+    by_cases hj2 : j = ctrOuter
+    · subst hj2
+      rw [hA_cp, hB_cp]
+    · by_cases hj1 : j = header
+      · subst hj1
+        rw [hA_hp, hB_hp]
+      · rw [(hA_o j hj1 hj2).2, (hB_o j hj1 hj2).2]
+  · rw [Cfg.mapState_output, Cfg.mapState_output]
+    rfl
