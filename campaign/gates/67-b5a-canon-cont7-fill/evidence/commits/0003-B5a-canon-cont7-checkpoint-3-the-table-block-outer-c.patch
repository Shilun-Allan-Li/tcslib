+        · rw [Fin.lastCases_castSucc]
+      · funext jj
+        dsimp only
+        refine Fin.lastCases ?_ (fun j' => ?_) jj
+        · rw [Fin.lastCases_last]
+          exact h9
+        · rw [Fin.lastCases_castSucc]
+      · rfl
+    have he' : ∀ v : ℕ, L.runFrom e v =
+        L.runFrom (counterLoopCfg (some (CounterLoopState.dec FlagPhase.run)) c₂
