+      obtain ⟨hrun, hcutT, -, -⟩ := counterLoopTM_run_done N₂ anchor₂ (some escape₂) τ₂ c₂
+        u (e.workTapes (Fin.last (m + 1))) 0 hword (counterValue w + 1) hu
+        (by
