+import TCSlib.Complexity.TuringMachine.Build.NDHost
+
+/-! The NDHost API PR's seal controls (a probe record): each sealed definition's `rfl` control and each
+erased definition's `simp` control closes unsealed (a `PASS` message) and fails sealed (an error). -/
+
+open Lean Elab Command Meta in
+elab "#rfl_control " id:ident : command => do
+  let n ← liftCoreM (realizeGlobalConstNoOverload id)
+  let ci ← getConstInfo n
+  let some value := ci.value? | throwError "not a definition: {n}"
+  liftTermElabM do
+    let goal ← mkEq (mkConst n (ci.levelParams.map Level.param)) value
+    let proof ← Term.elabTermEnsuringType (← `(by rfl)) goal
+    Term.synthesizeSyntheticMVarsNoPostponing
+    if (← instantiateMVars proof).hasSorry then throwError "control admits: {n}"
+    logInfo m!"RFL_CONTROL_PASS {n}"
+
+open Lean Elab Command Meta in
+elab "#simp_control " id:ident : command => do
+  let n ← liftCoreM (realizeGlobalConstNoOverload id)
+  let ci ← getConstInfo n
+  let some value := ci.value? | throwError "not a definition: {n}"
+  liftTermElabM do
+    let c := mkConst n (ci.levelParams.map Level.param)
+    let goal ← forallTelescopeReducing ci.type fun xs _ => do
+      mkForallFVars xs (← mkEq (mkAppN c xs) (mkAppN value xs).headBeta)
+    let proof ← Term.elabTermEnsuringType (← `(by intros; simp)) goal
+    Term.synthesizeSyntheticMVarsNoPostponing
+    if (← instantiateMVars proof).hasSorry then throwError "control admits: {n}"
+    logInfo m!"SIMP_CONTROL_PASS {n}"
+
+section Unsealed
+
+#rfl_control Turing.moveInputPos
+#rfl_control Turing.Cfg.inputSymbol
+#rfl_control Turing.Cfg.workTapeSymbols
+#rfl_control Turing.Cfg.init
+#rfl_control Turing.Action.apply
+#rfl_control Turing.Action.mapState
+#rfl_control Turing.Cfg.mapState
+#rfl_control Turing.NDTM.stepWith
+#rfl_control Turing.NDTM.initCfg
+-- recursive: a usage control stands in for its `rfl` control
+example {k : ℕ} (tm : Turing.NDTM k Bool Unit) {x : List Bool} (c : Turing.Cfg k Bool Unit x)
+    (b : Bool) : tm.runWith [b] c = tm.stepWith b c := rfl
+#rfl_control Turing.MultiTapeTM.toNDTM
+#rfl_control Turing.MultiTapeTM.initCfg
+#rfl_control Turing.MultiTapeTM.runFrom
+#rfl_control Turing.MultiTapeTM.step
+#rfl_control Turing.FinTM.bufferTape
+#rfl_control Turing.skipTM
