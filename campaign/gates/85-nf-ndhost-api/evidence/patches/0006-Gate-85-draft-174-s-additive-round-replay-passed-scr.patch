+++ b/campaign/gates/85-nf-ndhost-api/evidence/patches/0001-NDHost-the-controller-stopped-writer-s-contract-ndWr.patch
@@ -0,0 +1,216 @@
+From 782d4f4af6c0896b5d415e731af0d663a8a68fb5 Mon Sep 17 00:00:00 2001
+From: Seyoon Ragavan <complexzetaprime@gmail.com>
+Date: Tue, 27 Oct 2026 16:10:24 -0500
+Subject: [PATCH 1/5] NDHost: the controller-stopped writer's contract
+ (ndWriterTM_run_controller), proved on the writer's helpers generalized to
+ any controller
+
+Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
+---
+ .../TuringMachine/Build/NDHost.lean           | 129 +++++++++++++-----
+ 1 file changed, 98 insertions(+), 31 deletions(-)
+
+diff --git a/TCSlib/Complexity/TuringMachine/Build/NDHost.lean b/TCSlib/Complexity/TuringMachine/Build/NDHost.lean
+index 0013f6b9..811fe3a9 100644
+--- a/TCSlib/Complexity/TuringMachine/Build/NDHost.lean
++++ b/TCSlib/Complexity/TuringMachine/Build/NDHost.lean
+@@ -211,12 +211,13 @@ def ndWriterTM (k : ℕ) (j : Fin k) {Q : Type} (q₀ : Q) (δ : Q → Bool →
+       else ⟨0, fun i => if i = j then (some (some b), 1) else (none, 0), none,
+         some (.run (δ q b))⟩
+ 
+-/-- The configuration after writing the word `s`, before testing the next cell. -/
+-private def wr_cfg {k : ℕ} (j : Fin k) {x : List Bool}
+-    (c : Cfg k Bool (NDWriterState Unit) x) (s : List Bool) :
+-    Cfg k Bool (NDWriterState Unit) x :=
++/-- The configuration after writing the word `s`, in the writer state `q`, before testing the
++next cell. -/
++private def wr_cfg {k : ℕ} (j : Fin k) {Q : Type} {x : List Bool}
++    (c : Cfg k Bool (NDWriterState Q) x) (q : NDWriterState Q) (s : List Bool) :
++    Cfg k Bool (NDWriterState Q) x :=
+   { c with
+-    state := some (.run ())
++    state := some q
+     workTapes := Function.update c.workTapes j (fun p =>
+       if c.workTapePos j ≤ p ∧ p < c.workTapePos j + s.length then
+         FinTM.bufferTape s (p - c.workTapePos j)
+@@ -246,10 +247,10 @@ private theorem wr_tape_append (t : ℤ → Option Bool) (a : ℤ) (s : List Boo
+     · rw [if_pos h, if_pos (by omega)]
+     · rw [if_neg h, if_neg (by omega)]
+ 
+-/-- The empty written prefix gives the original running configuration. -/
+-private theorem wr_cfg_nil {k : ℕ} (j : Fin k) {x : List Bool}
+-    (c : Cfg k Bool (NDWriterState Unit) x) (hc : c.state = some (.run ())) :
+-    wr_cfg j c [] = c := by
++/-- The empty written prefix in the start state gives the original configuration. -/
++private theorem wr_cfg_nil {k : ℕ} (j : Fin k) {Q : Type} {x : List Bool}
++    (c : Cfg k Bool (NDWriterState Q) x) (q : NDWriterState Q) (hc : c.state = some q) :
++    wr_cfg j c q [] = c := by
+   apply Cfg.ext
+   · exact hc.symm
+   · rfl
+@@ -261,29 +262,31 @@ private theorem wr_cfg_nil {k : ℕ} (j : Fin k) {x : List Bool}
+   · rfl
+ 
+ /-- The next cell of the block still has its original symbol. -/
+-private theorem wr_cfg_scan {k : ℕ} (j : Fin k) {x : List Bool}
+-    (c : Cfg k Bool (NDWriterState Unit) x) (s : List Bool) :
+-    (wr_cfg j c s).workTapeSymbols j = c.workTapes j (c.workTapePos j + s.length) := by
++private theorem wr_cfg_scan {k : ℕ} (j : Fin k) {Q : Type} {x : List Bool}
