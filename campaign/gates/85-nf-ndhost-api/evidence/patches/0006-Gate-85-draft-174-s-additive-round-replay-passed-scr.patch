++  have hslen : s.length = m := by simp [s]; omega
++  have hslive : ∀ i < s.length, stop ((s.take i).foldl δ q₀) = false := by
++    intro i hi
++    rw [hslen] at hi
++    rw [hs_def, List.take_take, Nat.min_eq_left hi.le]
++    exact hl i hi
