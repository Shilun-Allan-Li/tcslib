++      (guessCtlRunTM P pexit j q₀ δ stop V qentry acc rej).runWith w
++      ((guessCtlRunTM P pexit j q₀ δ stop V qentry acc rej).initCfg z) := by
++    simp only [w']
++    rw [NDTM.runWith_append, NDTM.runWith_of_halt _ hhalt]
