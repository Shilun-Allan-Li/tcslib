         FinTM.bufferTape s (p - c.workTapePos j)
@@ -246,10 +247,10 @@ private theorem wr_tape_append (t : ℤ → Option Bool) (a : ℤ) (s : List Boo
     · rw [if_pos h, if_pos (by omega)]
