    RecordRun (recordStepMachine M upd seek start finish) (recordStepVerdict true) (recordStepVerdict false)
        (cfg q head cut b).workTapePos r u v t →
      head + r ≤ L + 1 →
        RecordRun (recordStepMachine M upd seek start finish) (recordStepVerdict true) (recordStepVerdict false)
          d.workTapePos (L + 1) u v t
mapRaw :
  ∀ (j : ℕ) (hj : j < k + 3) (b : List (RecSym Q T)) (f : RecSym Q T → RecSym Q T),
    List.map f fs[j] = gs[j] →
      let raw := cfg (ScanPhase.fwd ()) (fieldOffset fs j) (fieldOffset fs j) b;
      let row := scanTM 4 0 (scanMap f) scanKeep ();
      MultiTapeTM.runFrom raw (2 * fs[j].length + 2) =
          cfg (ScanPhase.done ()) (fieldOffset fs j) (fieldOffset fs (j + 1)) b ∧
        (∀ u < 2 * fs[j].length + 2, ∀ (v : Unit), (MultiTapeTM.runFrom raw u).state ≠ some (ScanPhase.done v)) ∧
