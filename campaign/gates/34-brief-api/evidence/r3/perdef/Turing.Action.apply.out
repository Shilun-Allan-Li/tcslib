k : ℕ
Q T S : Type
inst✝² : DecidableEq Q
inst✝¹ : DecidableEq T
inst✝ : DecidableEq S
M : MultiTapeTM k Bool Q
upd : T → Option Bool → T
seek : MultiTapeTM 2 Bool S
start finish : S
x : List Bool
s : ℕ
c : Cfg k Bool Q x
τ : T
hc : Cfg.InWindow s c
data : RecordStepData k Q T
hinput : data.input = c.inputSymbol
hzero : data.posZero = decide (↑c.inputPos = 0)
htag : data.tag = some τ
d : Cfg 4 (RecSym Q T) (RecordStepControl k Q T S) (List.map (⇑(RecSym.digitEmb Q T)) x)
hrec : RecordAt d 0 (cfgRecord s c τ)
blank : ∀ (j : Fin 4), j ≠ 0 → ∀ (z : ℤ), d.workTapes j z = none
a : Action k Bool Q := recordStepAction M data
fs : List (List (RecSym Q T)) := cfgRecord s c τ
gs : List (List (RecSym Q T)) := cfgRecord s (a.apply c) (upd τ a.output)
L : ℕ := (joinFields fs).length
w : List (RecSym Q T) := List.map (⇑(RecSym.digitEmb Q T)) (binDigits (posWidth x.length) ↑c.inputPos)
cfg : {A : Type} → A → ℕ → ℕ → List (RecSym Q T) → Cfg 4 (RecSym Q T) A (List.map (⇑(RecSym.digitEmb Q T)) x) :=
  fun {A} q head cut b =>
    recordStepSnapshot
      { state := d.state, inputPos := d.inputPos,
        workTapes := fun j z =>
          if j = 0 ∧ d.workTapePos j ≤ z ∧ z < d.workTapePos j + ↑cut then fieldsTape gs (z - d.workTapePos j)
          else d.workTapes j z,
        workTapePos := d.workTapePos, output := d.output }
      q (↑head) b []
snap :
  ∀ {A B : Type} (q : A) (q' : B) (head cut p : ℕ) (b : List (RecSym Q T)),
    recordStepSnapshot (cfg q head cut []) q' (↑p) b [] = cfg q' (head + p) cut b
snap0 :
  ∀ {A B : Type} (q : A) (q' : B) (head cut : ℕ) (b : List (RecSym Q T)),
    recordStepSnapshot (cfg q head cut []) q' 0 b [] = cfg q' head cut b
flen : fs.length = k + 3
glen : gs.length = k + 3
lengths : List.map List.length fs = List.map List.length gs
sizes : List.map (fun u => u.length + 1) fs = List.map (fun u => u.length + 1) gs
offsets : ∀ (j : ℕ), fieldOffset fs j = fieldOffset gs j
sameLength : (joinFields gs).length = L
len : ∀ (j : ℕ) (hj : j < k + 3), gs[j].length = fs[j].length
oldField :
  ∀ (j : ℕ) (hj : j < k + 3) (z : ℤ),
    -1 ≤ z → z ≤ ↑fs[j].length → d.workTapes 0 (d.workTapePos 0 + ↑(fieldOffset fs j) + z) = FinTM.bufferTape fs[j] z
newField :
  ∀ (j : ℕ) (hj : j < k + 3) (z : ℤ),
    -1 ≤ z → z ≤ ↑fs[j].length → fieldsTape gs (↑(fieldOffset fs j) + z) = FinTM.bufferTape gs[j] z
field :
  ∀ {A : Type} (q : A) (j : ℕ) (hj : j < k + 3) (b : List (RecSym Q T)) (z : ℤ),
    -1 ≤ z →
      z ≤ ↑fs[j].length →
        (cfg q (fieldOffset fs j) (fieldOffset fs j) b).workTapes 0
            ((cfg q (fieldOffset fs j) (fieldOffset fs j) b).workTapePos 0 + z) =
          FinTM.bufferTape fs[j] z
extend :
  ∀ {A : Type} (q : A) (j : ℕ) (hj : j < k + 3) (b : List (RecSym Q T)),
    (let __src := cfg q (fieldOffset fs j) (fieldOffset fs j) b;
      { state := __src.state, inputPos := __src.inputPos,
        workTapes := fun i z =>
          if
              i = 0 ∧
                (cfg q (fieldOffset fs j) (fieldOffset fs j) b).workTapePos i ≤ z ∧
                  z < (cfg q (fieldOffset fs j) (fieldOffset fs j) b).workTapePos i + ↑fs[j].length then
            FinTM.bufferTape gs[j] (z - (cfg q (fieldOffset fs j) (fieldOffset fs j) b).workTapePos i)
          else (cfg q (fieldOffset fs j) (fieldOffset fs j) b).workTapes i z,
        workTapePos := __src.workTapePos, output := __src.output }) =
      cfg q (fieldOffset fs j) (fieldOffset fs (j + 1)) b
processed :
  ∀ {A : Type} (q : A) (j : ℕ) (hj : j < k + 3) (b : List (RecSym Q T)) (z : ℤ),
    -1 ≤ z →
      z ≤ ↑fs[j].length →
        (cfg q (fieldOffset fs j) (fieldOffset fs (j + 1)) b).workTapes 0
            ((cfg q (fieldOffset fs j) (fieldOffset fs (j + 1)) b).workTapePos 0 + z) =
          FinTM.bufferTape gs[j] z
shift :
  ∀ {A : Type} (q : A) (head cut : ℕ) (b : List (RecSym Q T))
