      (∀ u < fs[j].length + 1, (MultiTapeTM.runFrom raw u).state ≠ some SeekPhase.done) ∧
        ∀ u ≤ fs[j].length + 1, ∀ (i : Fin 4), |(MultiTapeTM.runFrom raw u).workTapePos i - d.workTapePos i| ≤ ↑(L + 1)
posEntry : RecordStepControl k Q T S :=
  match a.inputTape with
  | SignType.zero => ⟨(RecordStepStage.clearB, data), SweepPhase.sweep⟩
  | SignType.neg =>
    if data.posZero = true then ⟨(RecordStepStage.clearB, data), SweepPhase.sweep⟩
    else ⟨(RecordStepStage.decB, data), FlagPhase.run⟩
  | SignType.pos =>
    if (data.input.isNone && !data.posZero) = true then ⟨(RecordStepStage.clearB, data), SweepPhase.sweep⟩
    else ⟨(RecordStepStage.incB, data), FlagPhase.run⟩
first : fs[0] = [RecSym.st c.state]
⊢ gs[0] = [RecSym.st a.state]
