@Turing.RoundContract.counterLoopDone_pre : ∀ {k : ℕ} {Γ S : Type} [inst : DecidableEq S] [inst_1 : DecidableEq Γ]
  (e : Bool ↪ Γ) {M : Turing.MultiTapeTM k Γ S} {a : S} {exit : Option S} {ι : Type} {x : List Γ}
  (R : Turing.RoundContract M a {exit} ι x) (p : ι × List Bool)
  (d : Turing.Cfg (k + 1) Γ (Turing.CounterLoopState S) x),
  (Turing.RoundContract.counterLoopDone e R).pre p d =
    ((∀ (q : ℤ),
        -1 ≤ q →
          q ≤ ↑p.2.length →
            d.workTapes (Fin.last k) (d.workTapePos (Fin.last k) + q) = Turing.FinTM.bufferTape (List.map (⇑e) p.2) q) ∧
      ∀ r < Turing.counterValue p.2,
        R.pre p.1 (Turing.roundOrbit M (R.time p.1) (Turing.counterLoopBody a d) r) ∧
          (R.post p.1 (Turing.roundOrbit M (R.time p.1) (Turing.counterLoopBody a d) r)).state = some a)
'Turing.RoundContract.counterLoopDone_pre' depends on axioms: [propext, Classical.choice, Quot.sound]
@Turing.RoundContract.counterLoopDone_time : ∀ {k : ℕ} {Γ S : Type} [inst : DecidableEq S] [inst_1 : DecidableEq Γ]
  (e : Bool ↪ Γ) {M : Turing.MultiTapeTM k Γ S} {a : S} {exit : Option S} {ι : Type} {x : List Γ}
  (R : Turing.RoundContract M a {exit} ι x) (p : ι × List Bool)
  (d : Turing.Cfg (k + 1) Γ (Turing.CounterLoopState S) x),
  (Turing.RoundContract.counterLoopDone e R).time p d =
    ∑ r ∈ Finset.range (Turing.counterValue p.2),
        R.time p.1 (Turing.roundOrbit M (R.time p.1) (Turing.counterLoopBody a d) r) +
      Turing.counterOverhead p.2 (Turing.counterValue p.2 + 1)
'Turing.RoundContract.counterLoopDone_time' depends on axioms: [propext, Classical.choice, Quot.sound]
@Turing.RoundContract.counterLoopDone_post : ∀ {k : ℕ} {Γ S : Type} [inst : DecidableEq S] [inst_1 : DecidableEq Γ]
  (e : Bool ↪ Γ) {M : Turing.MultiTapeTM k Γ S} {a : S} {exit : Option S} {ι : Type} {x : List Γ}
  (R : Turing.RoundContract M a {exit} ι x) (p : ι × List Bool)
  (d : Turing.Cfg (k + 1) Γ (Turing.CounterLoopState S) x),
  (Turing.RoundContract.counterLoopDone e R).post p d =
    Turing.counterLoopCfg (some Turing.CounterLoopState.done)
      (Turing.roundOrbit M (R.time p.1) (Turing.counterLoopBody a d) (Turing.counterValue p.2))
      (fun q =>
        if d.workTapePos (Fin.last k) ≤ q ∧ q < d.workTapePos (Fin.last k) + ↑p.2.length then some (e true)
        else d.workTapes (Fin.last k) q)
      (d.workTapePos (Fin.last k))
'Turing.RoundContract.counterLoopDone_post' depends on axioms: [propext, Classical.choice, Quot.sound]
@Turing.RoundContract.counterLoopDone_lo : ∀ {k : ℕ} {Γ S : Type} [inst : DecidableEq S] [inst_1 : DecidableEq Γ]
  (e : Bool ↪ Γ) {M : Turing.MultiTapeTM k Γ S} {a : S} {exit : Option S} {ι : Type} {x : List Γ}
  (R : Turing.RoundContract M a {exit} ι x) (p : ι × List Bool) (d : Turing.Cfg (k + 1) Γ (Turing.CounterLoopState S) x)
  (i : Fin (k + 1)),
  (Turing.RoundContract.counterLoopDone e R).lo p d i =
    Fin.lastCases (d.workTapePos (Fin.last k) - 1) (R.hullLo p.1 (Turing.counterLoopBody a d) (Turing.counterValue p.2))
      i
'Turing.RoundContract.counterLoopDone_lo' depends on axioms: [propext, Classical.choice, Quot.sound]
@Turing.RoundContract.counterLoopDone_hi : ∀ {k : ℕ} {Γ S : Type} [inst : DecidableEq S] [inst_1 : DecidableEq Γ]
  (e : Bool ↪ Γ) {M : Turing.MultiTapeTM k Γ S} {a : S} {exit : Option S} {ι : Type} {x : List Γ}
  (R : Turing.RoundContract M a {exit} ι x) (p : ι × List Bool) (d : Turing.Cfg (k + 1) Γ (Turing.CounterLoopState S) x)
  (i : Fin (k + 1)),
  (Turing.RoundContract.counterLoopDone e R).hi p d i =
    Fin.lastCases (d.workTapePos (Fin.last k) + ↑p.2.length)
      (R.hullHi p.1 (Turing.counterLoopBody a d) (Turing.counterValue p.2)) i
'Turing.RoundContract.counterLoopDone_hi' depends on axioms: [propext, Classical.choice, Quot.sound]
@Turing.RoundContract.counterLoopEscape_pre : ∀ {k : ℕ} {Γ S : Type} [inst : DecidableEq S] [inst_1 : DecidableEq Γ]
  (e : Bool ↪ Γ) {M : Turing.MultiTapeTM k Γ S} {a ex : S} (hea : ex ≠ a) {ι : Type} {x : List Γ}
  (R : Turing.RoundContract M a {some ex} ι x) (p : ι × List Bool × ℕ)
  (d : Turing.Cfg (k + 1) Γ (Turing.CounterLoopState S) x),
  (Turing.RoundContract.counterLoopEscape e hea R).pre p d =
    ((∀ (q : ℤ),
        -1 ≤ q →
          q ≤ ↑p.2.1.length →
            d.workTapes (Fin.last k) (d.workTapePos (Fin.last k) + q) =
              Turing.FinTM.bufferTape (List.map (⇑e) p.2.1) q) ∧
      p.2.2 < Turing.counterValue p.2.1 ∧
        (∀ r < p.2.2 + 1, R.pre p.1 (Turing.roundOrbit M (R.time p.1) (Turing.counterLoopBody a d) r)) ∧
          (∀ r < p.2.2, (R.post p.1 (Turing.roundOrbit M (R.time p.1) (Turing.counterLoopBody a d) r)).state = some a) ∧
            (R.post p.1 (Turing.roundOrbit M (R.time p.1) (Turing.counterLoopBody a d) p.2.2)).state = some ex)
'Turing.RoundContract.counterLoopEscape_pre' depends on axioms: [propext, Classical.choice, Quot.sound]
@Turing.RoundContract.counterLoopEscape_time : ∀ {k : ℕ} {Γ S : Type} [inst : DecidableEq S] [inst_1 : DecidableEq Γ]
  (e : Bool ↪ Γ) {M : Turing.MultiTapeTM k Γ S} {a ex : S} (hea : ex ≠ a) {ι : Type} {x : List Γ}
  (R : Turing.RoundContract M a {some ex} ι x) (p : ι × List Bool × ℕ)
  (d : Turing.Cfg (k + 1) Γ (Turing.CounterLoopState S) x),
  (Turing.RoundContract.counterLoopEscape e hea R).time p d =
    ∑ r ∈ Finset.range (p.2.2 + 1), R.time p.1 (Turing.roundOrbit M (R.time p.1) (Turing.counterLoopBody a d) r) +
      Turing.counterOverhead p.2.1 (p.2.2 + 1)
'Turing.RoundContract.counterLoopEscape_time' depends on axioms: [propext, Classical.choice, Quot.sound]
@Turing.RoundContract.counterLoopEscape_post : ∀ {k : ℕ} {Γ S : Type} [inst : DecidableEq S] [inst_1 : DecidableEq Γ]
  (e : Bool ↪ Γ) {M : Turing.MultiTapeTM k Γ S} {a ex : S} (hea : ex ≠ a) {ι : Type} {x : List Γ}
  (R : Turing.RoundContract M a {some ex} ι x) (p : ι × List Bool × ℕ)
  (d : Turing.Cfg (k + 1) Γ (Turing.CounterLoopState S) x),
  (Turing.RoundContract.counterLoopEscape e hea R).post p d =
    Turing.counterLoopCfg (some Turing.CounterLoopState.escape)
      (Turing.roundOrbit M (R.time p.1) (Turing.counterLoopBody a d) (p.2.2 + 1))
      (fun q =>
        if d.workTapePos (Fin.last k) ≤ q ∧ q < d.workTapePos (Fin.last k) + ↑p.2.1.length then
          Turing.FinTM.bufferTape (List.map (⇑e) (Turing.counterWord p.2.1 (p.2.2 + 1)))
            (q - d.workTapePos (Fin.last k))
        else d.workTapes (Fin.last k) q)
      (d.workTapePos (Fin.last k))
'Turing.RoundContract.counterLoopEscape_post' depends on axioms: [propext, Classical.choice, Quot.sound]
