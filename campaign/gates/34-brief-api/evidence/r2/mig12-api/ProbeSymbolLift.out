@Turing.Action.liftSymbols_inputTape : ∀ {k : ℕ} {Γ : Type u_1} {State : Type u_2} (e : Bool ↪ Γ)
  (a : Turing.Action k Bool State), (Turing.Action.liftSymbols e a).inputTape = a.inputTape
'Turing.Action.liftSymbols_inputTape' does not depend on any axioms
@Turing.Action.liftSymbols_workTapes : ∀ {k : ℕ} {Γ : Type u_1} {State : Type u_2} (e : Bool ↪ Γ)
  (a : Turing.Action k Bool State) (j : Fin k),
  (Turing.Action.liftSymbols e a).workTapes j = (Option.map (Option.map ⇑e) (a.workTapes j).1, (a.workTapes j).2)
'Turing.Action.liftSymbols_workTapes' does not depend on any axioms
@Turing.Action.liftSymbols_output : ∀ {k : ℕ} {Γ : Type u_1} {State : Type u_2} (e : Bool ↪ Γ)
  (a : Turing.Action k Bool State), (Turing.Action.liftSymbols e a).output = Option.map (⇑e) a.output
'Turing.Action.liftSymbols_output' does not depend on any axioms
@Turing.Action.liftSymbols_state : ∀ {k : ℕ} {Γ : Type u_1} {State : Type u_2} (e : Bool ↪ Γ)
  (a : Turing.Action k Bool State), (Turing.Action.liftSymbols e a).state = a.state
'Turing.Action.liftSymbols_state' does not depend on any axioms
@Turing.Cfg.liftSymbols_inputPos : ∀ {k : ℕ} {Γ : Type u_1} {State : Type u_2} (e : Bool ↪ Γ) {x : List Bool}
  (c : Turing.Cfg k Bool State x), (Turing.Cfg.liftSymbols e c).inputPos = Fin.cast ⋯ c.inputPos
'Turing.Cfg.liftSymbols_inputPos' depends on axioms: [propext]
@Turing.Cfg.liftSymbols_workTapes : ∀ {k : ℕ} {Γ : Type u_1} {State : Type u_2} (e : Bool ↪ Γ) {x : List Bool}
  (c : Turing.Cfg k Bool State x) (j : Fin k) (p : ℤ),
  (Turing.Cfg.liftSymbols e c).workTapes j p = Option.map (⇑e) (c.workTapes j p)
'Turing.Cfg.liftSymbols_workTapes' depends on axioms: [propext]
@Turing.Cfg.liftSymbols_output : ∀ {k : ℕ} {Γ : Type u_1} {State : Type u_2} (e : Bool ↪ Γ) {x : List Bool}
  (c : Turing.Cfg k Bool State x), (Turing.Cfg.liftSymbols e c).output = List.map (⇑e) c.output
'Turing.Cfg.liftSymbols_output' depends on axioms: [propext]
