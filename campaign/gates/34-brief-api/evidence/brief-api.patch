 /-! ### The record -/
 
 /-- **Fixed-width binary digits** (design §12.8a §2): the `w` low bits of `v`,
 least significant first. -/
 def binDigits (w v : ℕ) : List Bool := (List.range w).map v.testBit
 
+/-- The `w` low bits of `v`, least significant first: `binDigits w v = (range w).map v.testBit` (the
+specification API, the briefs' pre-ship inventories, 2026-10-16). -/
+theorem binDigits_eq (w v : ℕ) : binDigits w v = (List.range w).map v.testBit :=
+  rfl
+
 /-- **The input-position width** (design §12.8a §2) at input length `n`: the
 bit length of `n + 1`, so that `2 ^ posWidth n > n + 1` and every input
 position `0, …, n + 1` has a distinct `Turing.binDigits` code. -/
 def posWidth (n : ℕ) : ℕ := (Nat.bits (n + 1)).length
 
+/-- The input-position width is the bit length of `n + 1`: `posWidth n = (Nat.bits (n + 1)).length`
+(the specification API, the briefs' pre-ship inventories, 2026-10-16). -/
+theorem posWidth_eq (n : ℕ) : posWidth n = (Nat.bits (n + 1)).length :=
+  rfl
+
 /-- **The configuration record** (design §12.8a §2) of `c` at window radius
 `s` with tag `τ`: `k + 3` fields. Field `0` is the state, field `1` the input
 position in `Turing.binDigits` of width `Turing.posWidth |x|`, fields `2` to
diff --git a/TCSlib/Complexity/TuringMachine/Build/CounterLoop.lean b/TCSlib/Complexity/TuringMachine/Build/CounterLoop.lean
index f2078d38..77a7cf13 100644
--- a/TCSlib/Complexity/TuringMachine/Build/CounterLoop.lean
+++ b/TCSlib/Complexity/TuringMachine/Build/CounterLoop.lean
@@ -211,6 +211,23 @@ def decFixed : List Bool → Option (List Bool)
   | true :: rest => some (false :: rest)
   | false :: rest => (decFixed rest).map (true :: ·)
 
+/-- The empty word has no predecessor: `decFixed [] = none` (the specification API, the briefs'
+pre-ship inventories, 2026-10-16). -/
+theorem decFixed_nil : decFixed [] = none :=
+  rfl
+
+/-- A leading `true` becomes `false`: `decFixed (true :: w) = some (false :: w)` (the specification
+API, the briefs' pre-ship inventories, 2026-10-16). -/
+theorem decFixed_true_cons (w : List Bool) : decFixed (true :: w) = some (false :: w) :=
+  rfl
+
+/-- A leading `false` becomes `true` and borrows from the rest:
+`decFixed (false :: w) = (decFixed w).map (true :: ·)` (the specification API, the briefs' pre-ship
+inventories, 2026-10-16). -/
+theorem decFixed_false_cons (w : List Bool) :
+    decFixed (false :: w) = (decFixed w).map (true :: ·) :=
+  rfl
+
 /-- Complement exchanges the word-level carry and borrow recursions. -/
 private lemma counter_dec_complement (w : List Bool) :
     decFixed w = (incFixed (w.map not)).map (List.map not) := by
@@ -1966,6 +1983,10 @@ def counterLoopBody {S : Type} {x : List Γ} (a : S) (d : Cfg (k + 1) Γ (Counte
   ⟨some a, d.inputPos, fun j => d.workTapes j.castSucc, fun j => d.workTapePos j.castSucc,
     d.output⟩
 
+/-! The body configuration's fields, as equations (the specification API, the briefs' pre-ship
+inventories, 2026-10-16): generated by `simps` without the `simp` attribute. -/
+attribute [simps (config := { isSimp := false })] counterLoopBody
+
 /-- **The counter-loop host layout is an R1 reconstruction** (a seventh member of the family:
 `CounterLoop`'s private `counter_layout`, `Build/CounterLoop.lean:650`): every host configuration
 is the counter-loop configuration of its body, its counter tape and its counter head.
