uring.MultiTapeTM.runFrom d (w.length + 1) =\n              { state := some Turing.SeekPhase.done, inputPos := d.inputPos, workTapes := d.workTapes,\n                workTapePos := fun j => d.workTapePos j + if moved j then ↑dir * ↑(w.length + 1) else 0,\n                output := d.output } ∧\n            (∀ t < w.length + 1, (Turing.MultiTapeTM.runFrom d t).state ≠ some Turing.SeekPhase.done) ∧\n              ∀ (j : Fin k),\n                ∀ t ≤ w.length + 1,\n                  (Turing.MultiTapeTM.runFrom d t).workTapePos j = d.workTapePos j + if moved j then ↑dir * ↑t else 0","unfold":false,"universes":["u_1"]}
