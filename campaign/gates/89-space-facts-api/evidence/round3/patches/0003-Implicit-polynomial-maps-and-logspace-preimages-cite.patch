From 8d41671c2452a79f76d4313f6c9fb92ec32a11c6 Mon Sep 17 00:00:00 2001
From: Seyoon Ragavan <complexzetaprime@gmail.com>
Date: Wed, 4 Nov 2026 13:33:15 -0800
Subject: [PATCH 3/3] Implicit polynomial maps and logspace preimages: cite
 logSpace_le_succ for the linear bound
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

ImplicitlyLogspaceComputable.computesInSpace (ImplicitPoly) and mem_LOGSPACE_preimage
(PreimageHost) each re-derived Nat.log 2 (m) + 1 ≤ m + 1 inline; both now read it from
Complexity.logSpace_le_succ through Complexity.logSpace_eq.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 TCSlib/Complexity/SpaceComplexity/ImplicitPoly.lean          | 4 +++-
 TCSlib/Complexity/SpaceComplexity/Logspace/PreimageHost.lean | 5 ++++-
 2 files changed, 7 insertions(+), 2 deletions(-)

diff --git a/TCSlib/Complexity/SpaceComplexity/ImplicitPoly.lean b/TCSlib/Complexity/SpaceComplexity/ImplicitPoly.lean
index 470fc9f2..46e38faf 100644
--- a/TCSlib/Complexity/SpaceComplexity/ImplicitPoly.lean
+++ b/TCSlib/Complexity/SpaceComplexity/ImplicitPoly.lean
@@ -376,7 +376,9 @@ theorem ImplicitlyLogspaceComputable.computesInSpace {f : List Bool → List Boo
     omega
   have hlogW : logSpace (2 * n + 2 + W) ≤ K2 * L := by
     have hWle : W ≤ F + 2 := by
-      have := Nat.log_le_self 2 (F + 1); omega
+      have := Complexity.logSpace_le_succ (F + 1)
+      rw [Complexity.logSpace_eq] at this
+      omega
     have hle : 2 * n + 2 + W ≤ (C + 2) * (n + 1) ^ (e + 1) + 2 := by
       have h1 : n + 1 ≤ (n + 1) ^ (e + 1) := by
         calc n + 1 = (n + 1) ^ 1 := by ring
diff --git a/TCSlib/Complexity/SpaceComplexity/Logspace/PreimageHost.lean b/TCSlib/Complexity/SpaceComplexity/Logspace/PreimageHost.lean
index e250e66c..52645a40 100644
--- a/TCSlib/Complexity/SpaceComplexity/Logspace/PreimageHost.lean
+++ b/TCSlib/Complexity/SpaceComplexity/Logspace/PreimageHost.lean
@@ -784,7 +784,10 @@ theorem mem_LOGSPACE_preimage {f : List Bool → List Bool} (hf : ImplicitlyLogs
     omega
   have hJx : logSpace (2 * x.length + 2 + W) ≤ J * L := by
     have hw : W ≤ (f x).length + 2 :=
-      (LogProg.length_bits_le_log _).trans (by have := Nat.log_le_self 2 ((f x).length + 1); omega)
+      (LogProg.length_bits_le_log _).trans (by
+        have := Complexity.logSpace_le_succ ((f x).length + 1)
+        rw [Complexity.logSpace_eq] at this
+        omega)
     have hp : x.length + 1 ≤ (x.length + 1) ^ (e + 1) := by
       simpa only [pow_one] using
         Nat.pow_le_pow_right (show 1 ≤ x.length + 1 by omega) (show 1 ≤ e + 1 by omega)
