BEFORE_ANY_REFERENCE|Complexity.PrefixByLength.drop.eq_1|owner=TCSlib.Complexity.ClassNP.PolyTimePrefix|kind=theorem|private=false|AX=[]
READER_TYPE|∀ (z : List Bool),
  Complexity.PrefixByLength.drop z = List.drop (Complexity.pairFstD z).length (Complexity.pairSndD z)
READER_VALUE|fun z => Eq.refl (Complexity.PrefixByLength.drop z)
