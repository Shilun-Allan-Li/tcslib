GUARD _private.TCSlib.Complexity.ClassNP.SAT.0.Complexity.sat_guard_add : ∀ {k : ℕ} {S : Type} {x : List Bool}
  (tm : Turing.MultiTapeTM k Bool S) (anchor : S) (c d : Turing.Cfg k Bool S x) (a b : ℕ),
  (∀ v < a, (Turing.MultiTapeTM.runFrom c v).state ≠ some anchor) →
    Turing.MultiTapeTM.runFrom c a = d →
      (∀ v < b, (Turing.MultiTapeTM.runFrom d v).state ≠ some anchor) →
        ∀ v < a + b, (Turing.MultiTapeTM.runFrom c v).state ≠ some anchor
GUARD_AXIOMS _private.TCSlib.Complexity.ClassNP.SAT.0.Complexity.sat_guard_add: [propext, Quot.sound]
