Complexity.pairMapSnd.eq_def (g : List Bool → List Bool) (z : List Bool) :
  Complexity.pairMapSnd g z =
    match Turing.pairDecode z with
    | some (a, b) => Turing.pairEncode a (g b)
    | none => []
Complexity.pairMapSnd.eq_1 (g : List Bool → List Bool) (z : List Bool) :
  Complexity.pairMapSnd g z =
    match Turing.pairDecode z with
    | some (a, b) => Turing.pairEncode a (g b)
    | none => []
