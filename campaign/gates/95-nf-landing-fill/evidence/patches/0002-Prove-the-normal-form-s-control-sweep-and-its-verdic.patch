@@ -368,6 +368,344 @@ private theorem nf_display_prefix_length (N : FinNDTM Bool) (x w : List Bool) (t
     (ht : t ≤ w.length) : (nf_display N x (w.take t)).length = (2 * N.k + 4) * t := by
