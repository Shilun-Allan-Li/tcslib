diff --git a/TCSlib/Complexity/TuringMachine/Deterministic.lean b/TCSlib/Complexity/TuringMachine/Deterministic.lean
index 48e33936..7e3fcbe7 100644
--- a/TCSlib/Complexity/TuringMachine/Deterministic.lean
