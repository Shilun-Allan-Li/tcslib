From f36f1eb5421d6855e0a29daafb6e75d67a1dfb0c Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 28 Oct 2026 00:18:24 +0000
Subject: [PATCH 7/9] NTimeDiagonalizer: cite Classical.exists_or_forall_not;
 drop four unused privates

The semantic duplication search's `exact?` probe closes `QyKit.tape_cases` by Mathlib's
`Classical.exists_or_forall_not`: its proof now cites it. Four new privates that nothing uses
are removed (`qy_round_le`, `qyEmb2_zero`, `qyEmb2_one`, `QyKit.bCb_ne`).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01PqpVTj5speLTvae6QLXuLG
---
 .../Diagonalization/NTimeDiagonalizer.lean    | 29 ++-----------------
 1 file changed, 3 insertions(+), 26 deletions(-)

diff --git a/TCSlib/Complexity/Diagonalization/NTimeDiagonalizer.lean b/TCSlib/Complexity/Diagonalization/NTimeDiagonalizer.lean
index 466f380c..e4753571 100644
--- a/TCSlib/Complexity/Diagonalization/NTimeDiagonalizer.lean
+++ b/TCSlib/Complexity/Diagonalization/NTimeDiagonalizer.lean
@@ -378,15 +378,6 @@ private theorem qy_ladder_succ_eq (f : ℕ → ℕ) (i : ℕ) :
     ladder f (i + 1) = 2 ^ (f (ladder f i + 1) + (ladder f i + 1) + 1) ^ 4 := by
   rw [ladder_succ, budget_eq, ← pow_mul]
 
-/-- A passed rung's operands are at most the next rung. -/
-private theorem qy_round_le (f : ℕ → ℕ) (i : ℕ) :
-    f (ladder f i + 1) + (ladder f i + 1) + 1 ≤ ladder f (i + 1) := by
-  rw [qy_ladder_succ_eq]
-  set X := f (ladder f i + 1) + (ladder f i + 1) + 1
-  have h4 : X ≤ X ^ 4 := Nat.le_self_pow (by norm_num) X
-  have := Nat.lt_two_pow_self (n := X ^ 4)
-  omega
-
 /-- The ledger: the rungs passed before stage `s` sum to at most twice its bottom. -/
 private theorem qy_ledger (f : ℕ → ℕ) (s : ℕ) :
     ∑ h ∈ Finset.range s, ladder f (h + 1) ≤ 2 * ladder f s := by
@@ -2477,12 +2468,6 @@ private def qyEmb2 {K : ℕ} (a b : Fin K) (h : a ≠ b) : Fin 2 ↪ Fin K where
     · rw [if_neg (by omega), if_pos hj] at hij; exact absurd hij.symm h
     · exact Fin.ext (by omega)
 
-/-- The two-tape bank's first tape. -/
-private theorem qyEmb2_zero {K : ℕ} (a b : Fin K) (h : a ≠ b) : qyEmb2 a b h 0 = a := rfl
-
-/-- The two-tape bank's second tape. -/
-private theorem qyEmb2_one {K : ℕ} (a b : Fin K) (h : a ≠ b) : qyEmb2 a b h 1 = b := rfl
-
 /-- The value of a named tape. -/
 private theorem QyKit.tp_val {f g : ℕ → ℕ} (κ : QyKit f g) (c : Fin 16) : (κ.tp c : ℕ) = c := rfl
 
@@ -2938,14 +2923,10 @@ private def qyLay {f g : ℕ → ℕ} (κ : QyKit f g) (n a j k : ℕ) (t : Fin
   else if t = κ.tp 9 then List.replicate (κ.m n) true
   else []
 
-/-- Every tape is named or lies in a bank block. -/
+/-- Every tape is a named tape or none of them (`Classical.exists_or_forall_not`). -/
 private theorem QyKit.tape_cases {f g : ℕ → ℕ} (κ : QyKit f g) (t : Fin κ.K) :
-    (∃ c : Fin 16, t = κ.tp c) ∨ ∀ c : Fin 16, t ≠ κ.tp c := by
-  by_cases h : (t : ℕ) < 16
-  · exact Or.inl ⟨⟨t, h⟩, Fin.ext rfl⟩
-  · refine Or.inr fun c hc => h ?_
-    rw [hc, κ.tp_val]
-    exact c.isLt
+    (∃ c : Fin 16, t = κ.tp c) ∨ ∀ c : Fin 16, t ≠ κ.tp c :=
+  Classical.exists_or_forall_not fun c => t = κ.tp c
 
 /-- A bank's tapes other than its tape `0` lie in its block, off every named tape. -/
 private theorem qyBank_ne_tp {f g : ℕ → ℕ} (κ : QyKit f g) (t0 : Fin κ.K) (off k : ℕ)
@@ -2991,10 +2972,6 @@ private theorem qy_arg_bank {K k : ℕ} (σ : Fin k ↪ Fin K) (hk : 0 < k) (T :
     rw [this, h0]
   · rw [if_neg hi, hT i hi]
 
-/-- The input call's bank tapes other than tape `0` are off the named tapes. -/
-private theorem QyKit.bCb_ne {f g : ℕ → ℕ} (κ : QyKit f g) (i : Fin κ.cb.k) (hi : (i : ℕ) ≠ 0)
-    (c : Fin 16) :
-    κ.bCb i ≠ κ.tp c := qyBank_ne_tp κ _ _ _ _ _ (le_refl _) i hi c
 /-- The prefix call's bank tapes other than tape `0` are off the named tapes. -/
 private theorem QyKit.bPr_ne {f g : ℕ → ℕ} (κ : QyKit f g) (i : Fin κ.pr.k) (hi : (i : ℕ) ≠ 0)
     (c : Fin 16) :
