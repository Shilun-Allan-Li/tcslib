+        unfold QyKit.m
+        omega
+      exact qy_timeout_cert f κ.cfc κ.cfA a n tc ha htc (by rw [← hm]; omega)
+    · obtain ⟨h3, h4, h5, h6, h7, h8⟩ := qy_not_scratch κ ht
+      obtain ⟨e1, e2⟩ := hkeep t (fun hm => ht (Or.inl hm))
+      rw [e1, e2, hT₁, Function.update_of_ne h7]
+      exact ⟨rfl, rfl⟩
