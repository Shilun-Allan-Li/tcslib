+      (fun _ => 0) [] := by
+    unfold qyLoc qyAnc
+    exact qy_hosted_run (qyLocM κ) ⟨.anc, SweepPhase.sweep⟩ (qyLocRed κ) .anc .sweep .sweep
+      ⟨.r1, SweepPhase.sweep⟩ 1 1 _ _ _ _ [] [] 0 MultiTapeTM.runFrom_zero (by simp [qyLocRed])
