+            c' = qyC ⟨.escTop, SweepPhase.sweep⟩ 1 T P [] ∧ QyEscT κ x.length a j k T P ∧
+            T (κ.tp 4) = FinTM.bufferTape (List.replicate (f a + a) true) ∧ P (κ.tp 4) = 0)) := by
+  have h1 : (qyLoc κ).runFrom (qyC (x := x) (qyAnc κ) 1 (qyLayT κ x.length a j k)
