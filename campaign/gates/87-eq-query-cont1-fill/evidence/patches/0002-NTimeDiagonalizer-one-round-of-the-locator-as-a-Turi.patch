+      ((2 ^ (f a + a + 1) ^ 4 < x.length ∧
+          c' = qyC (qyAnc κ) 1 (qyLayT κ x.length (2 ^ (f a + a + 1) ^ 4 + 1)
+            (Nat.unpair (h + 1)).1 (Nat.unpair (h + 1)).2) (fun _ => 0) [] ∧
+          t ≤ qyRndP κ x.length (2 ^ (f a + a + 1) ^ 4) j k) ∨
