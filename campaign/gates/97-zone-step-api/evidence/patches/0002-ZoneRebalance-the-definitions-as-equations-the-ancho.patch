   have hD0 : (zr_hostDispatchContract MB e back x).pre () c := by
     rw [zr_hostDispatchContract, Contract.inPhase_pre, zr_anchorContract,
-      Contract.ofSegment_pre]
+      Contract.zero_pre]
     trivial
   have hDt : (zr_hostDispatchContract MB e back x).time () c = 1 := by
