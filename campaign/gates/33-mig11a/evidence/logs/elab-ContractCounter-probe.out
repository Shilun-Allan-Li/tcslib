                    ∀ t ≤ 2 * (List.takeWhile lead w).length + 2,
                      if j = i then
                        (Turing.MultiTapeTM.runFrom d t).workTapePos j ∈
                          Finset.Icc (d.workTapePos j - 1) (d.workTapePos j + ↑(List.takeWhile lead w).length)
                      else (Turing.MultiTapeTM.runFrom d t).workTapePos j = d.workTapePos j)
  (p : List Bool × List Bool) (d : Turing.Cfg k Bool Turing.FlagPhase x),
  (Turing.counterRowContract M i x fix lead hrun).post p d =
    { state := some (Turing.FlagPhase.done true), inputPos := d.inputPos,
      workTapes := fun j q =>
        if j = i ∧ d.workTapePos j ≤ q ∧ q < d.workTapePos j + ↑p.1.length then
          Turing.FinTM.bufferTape p.2 (q - d.workTapePos j)
        else d.workTapes j q,
      workTapePos := d.workTapePos, output := d.output }
@Turing.counterRowContract_lo : ∀ {k : ℕ} (M : Turing.MultiTapeTM k Bool Turing.FlagPhase) (i : Fin k) (x : List Bool)
  (fix : List Bool → Option (List Bool)) (lead : Bool → Bool)
  (hrun :
    ∀ (w v : List Bool),
      fix w = some v →
        ∀ (d : Turing.Cfg k Bool Turing.FlagPhase x),
          d.state = some Turing.FlagPhase.run →
            (∀ (q : ℤ), -1 ≤ q → q ≤ ↑w.length → d.workTapes i (d.workTapePos i + q) = Turing.FinTM.bufferTape w q) →
              Turing.MultiTapeTM.runFrom d (2 * (List.takeWhile lead w).length + 2) =
                  { state := some (Turing.FlagPhase.done true), inputPos := d.inputPos,
                    workTapes := fun j q =>
                      if j = i ∧ d.workTapePos j ≤ q ∧ q < d.workTapePos j + ↑w.length then
                        Turing.FinTM.bufferTape v (q - d.workTapePos j)
                      else d.workTapes j q,
                    workTapePos := d.workTapePos, output := d.output } ∧
                (∀ t < 2 * (List.takeWhile lead w).length + 2,
                    ∀ (b : Bool), (Turing.MultiTapeTM.runFrom d t).state ≠ some (Turing.FlagPhase.done b)) ∧
                  ∀ (j : Fin k),
                    ∀ t ≤ 2 * (List.takeWhile lead w).length + 2,
                      if j = i then
                        (Turing.MultiTapeTM.runFrom d t).workTapePos j ∈
                          Finset.Icc (d.workTapePos j - 1) (d.workTapePos j + ↑(List.takeWhile lead w).length)
                      else (Turing.MultiTapeTM.runFrom d t).workTapePos j = d.workTapePos j)
  (p : List Bool × List Bool) (d : Turing.Cfg k Bool Turing.FlagPhase x) (j : Fin k),
  (Turing.counterRowContract M i x fix lead hrun).lo p d j = if j = i then d.workTapePos j - 1 else d.workTapePos j
