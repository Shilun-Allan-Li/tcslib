@Turing.incrementTM_contract_pre : ∀ {k : ℕ} (i : Fin k) (x : List Bool) (p : List Bool × List Bool)
  (d : Turing.Cfg k Bool Turing.FlagPhase x),
  (Turing.incrementTM_contract i x).pre p d =
    (Turing.incFixed p.1 = some p.2 ∧
      ∀ (q : ℤ), -1 ≤ q → q ≤ ↑p.1.length → d.workTapes i (d.workTapePos i + q) = Turing.FinTM.bufferTape p.1 q)
@Turing.incrementTM_contract_time : ∀ {k : ℕ} (i : Fin k) (x : List Bool) (p : List Bool × List Bool)
  (x_1 : Turing.Cfg k Bool Turing.FlagPhase x),
  (Turing.incrementTM_contract i x).time p x_1 = 2 * (List.takeWhile id p.1).length + 2
@Turing.incrementTM_contract_post : ∀ {k : ℕ} (i : Fin k) (x : List Bool) (p : List Bool × List Bool)
  (d : Turing.Cfg k Bool Turing.FlagPhase x),
  (Turing.incrementTM_contract i x).post p d =
    { state := some (Turing.FlagPhase.done true), inputPos := d.inputPos,
      workTapes := fun j q =>
        if j = i ∧ d.workTapePos j ≤ q ∧ q < d.workTapePos j + ↑p.1.length then
          Turing.FinTM.bufferTape p.2 (q - d.workTapePos j)
        else d.workTapes j q,
      workTapePos := d.workTapePos, output := d.output }
@Turing.incrementTM_contract_lo : ∀ {k : ℕ} (i : Fin k) (x : List Bool) (p : List Bool × List Bool)
  (d : Turing.Cfg k Bool Turing.FlagPhase x) (j : Fin k),
  (Turing.incrementTM_contract i x).lo p d j = if j = i then d.workTapePos j - 1 else d.workTapePos j
@Turing.incrementTM_contract_hi : ∀ {k : ℕ} (i : Fin k) (x : List Bool) (p : List Bool × List Bool)
  (d : Turing.Cfg k Bool Turing.FlagPhase x) (j : Fin k),
  (Turing.incrementTM_contract i x).hi p d j =
    if j = i then d.workTapePos j + ↑(List.takeWhile id p.1).length else d.workTapePos j
@Turing.decrementTM_contract_pre : ∀ {k : ℕ} (i : Fin k) (x : List Bool) (p : List Bool × List Bool)
  (d : Turing.Cfg k Bool Turing.FlagPhase x),
  (Turing.decrementTM_contract i x).pre p d =
    (Turing.decFixed p.1 = some p.2 ∧
      ∀ (q : ℤ), -1 ≤ q → q ≤ ↑p.1.length → d.workTapes i (d.workTapePos i + q) = Turing.FinTM.bufferTape p.1 q)
@Turing.decrementTM_contract_time : ∀ {k : ℕ} (i : Fin k) (x : List Bool) (p : List Bool × List Bool)
  (x_1 : Turing.Cfg k Bool Turing.FlagPhase x),
  (Turing.decrementTM_contract i x).time p x_1 = 2 * (List.takeWhile not p.1).length + 2
@Turing.decrementTM_contract_post : ∀ {k : ℕ} (i : Fin k) (x : List Bool) (p : List Bool × List Bool)
  (d : Turing.Cfg k Bool Turing.FlagPhase x),
  (Turing.decrementTM_contract i x).post p d =
    { state := some (Turing.FlagPhase.done true), inputPos := d.inputPos,
      workTapes := fun j q =>
        if j = i ∧ d.workTapePos j ≤ q ∧ q < d.workTapePos j + ↑p.1.length then
          Turing.FinTM.bufferTape p.2 (q - d.workTapePos j)
        else d.workTapes j q,
      workTapePos := d.workTapePos, output := d.output }
@Turing.decrementTM_contract_lo : ∀ {k : ℕ} (i : Fin k) (x : List Bool) (p : List Bool × List Bool)
  (d : Turing.Cfg k Bool Turing.FlagPhase x) (j : Fin k),
  (Turing.decrementTM_contract i x).lo p d j = if j = i then d.workTapePos j - 1 else d.workTapePos j
@Turing.decrementTM_contract_hi : ∀ {k : ℕ} (i : Fin k) (x : List Bool) (p : List Bool × List Bool)
  (d : Turing.Cfg k Bool Turing.FlagPhase x) (j : Fin k),
  (Turing.decrementTM_contract i x).hi p d j =
    if j = i then d.workTapePos j + ↑(List.takeWhile not p.1).length else d.workTapePos j
exit=0
