From f3c43d921311d02b59bb29796d340c3aac659148 Mon Sep 17 00:00:00 2001
From: Seyoon Ragavan <complexzetaprime@gmail.com>
Date: Wed, 4 Nov 2026 13:56:23 -0800
Subject: [PATCH 2/3] Configuration codec: read the shape and the oracle
 through stated lemmas

Adds Shape1.eq and Shape1.width (Codec/Parse) and orc_eq (Codec/Run), so that edgeLang_mem reads
the shape of its input and the codec's oracle without unfolding their definitions.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 TCSlib/Complexity/SpaceComplexity/Codec/Deciders.lean | 9 +++++----
 TCSlib/Complexity/SpaceComplexity/Codec/Parse.lean    | 8 ++++++++
 TCSlib/Complexity/SpaceComplexity/Codec/Run.lean      | 3 +++
 3 files changed, 16 insertions(+), 4 deletions(-)

diff --git a/TCSlib/Complexity/SpaceComplexity/Codec/Deciders.lean b/TCSlib/Complexity/SpaceComplexity/Codec/Deciders.lean
index c95ffd6d..5e25f1fe 100644
--- a/TCSlib/Complexity/SpaceComplexity/Codec/Deciders.lean
+++ b/TCSlib/Complexity/SpaceComplexity/Codec/Deciders.lean
@@ -768,19 +768,20 @@ theorem edgeLang_mem : edgeLang N ∈ LOGSPACE := by
     fun y => ?_
   rw [← val_empty]
   refine AHalt.mono ?_ (fun a h => gd_mono a h)
+  rw [← orc_eq]
   rcases one_run (N := N) (mode := .edge) (by decide) y with
     ⟨x, w, s, hsh, hpre, st, R, hst, hR, hA, hS, hT, -, run⟩ | ⟨hfail, hhalt⟩
   · have hyl : y.length = 2 * x.length + 2 * w.length + 4 + (Nat.bits s).length := by
-      rw [hsh.1, length_pairEncode, length_pairEncode]; ring
-    have hs := s_le_of_width y s (by omega) hsh.2
+      rw [hsh.eq, length_pairEncode, length_pairEncode]; ring
+    have hs := s_le_of_width y s (by omega) hsh.width
     have hind : MultiTapeTM.indicator (edgeLang N : Set (List Bool)) y =
         decide (VAcc N st.1 ∧ ∃ i : Fin N.k, w.getD (hH N + 3 * (i : ℕ) + 2) false = true ∨
           w.getD (W N * (2 * s) + (hH N + 3 * (i : ℕ) + 2)) false = true) := by
       apply indicator_eq_of_iff
-      rw [hsh.1, edgeLang_iff, edgeChk_def, validChk_iff_pre, hst]
+      rw [hsh.eq, edgeLang_iff, edgeChk_def, validChk_iff_pre, hst]
       exact ⟨fun ⟨⟨_, hv⟩, h⟩ => ⟨hv, h⟩, fun ⟨hv, h⟩ => ⟨⟨hpre, hv⟩, h⟩⟩
     rw [hind]
-    exact AReach.halt run (edge_tail y x w (Nat.bits s) hsh.1 R s st hR hA hS hT hs
+    exact AReach.halt run (edge_tail y x w (Nat.bits s) hsh.eq R s st hR hA hS hT hs
       (by have := hpre.1; omega))
   · have hind : MultiTapeTM.indicator (edgeLang N : Set (List Bool)) y = false := by
       rw [indicator_eq_of_iff (P := False) (Iff.intro (fun h => ?_) False.elim)]
diff --git a/TCSlib/Complexity/SpaceComplexity/Codec/Parse.lean b/TCSlib/Complexity/SpaceComplexity/Codec/Parse.lean
index e857152c..08de3fa7 100644
--- a/TCSlib/Complexity/SpaceComplexity/Codec/Parse.lean
+++ b/TCSlib/Complexity/SpaceComplexity/Codec/Parse.lean
@@ -200,6 +200,14 @@ check. -/
 def Shape1 (y x w : List Bool) (s : ℕ) : Prop :=
   y = pairEncode x (pairEncode w (Nat.bits s)) ∧ (Nat.bits s).length ≤ (Nat.bits y.length).length
 
+/-- A well-shaped input is the pair `⟨x, ⟨w, bits s⟩⟩`. -/
+lemma Shape1.eq {y x w : List Bool} {s : ℕ} (h : Shape1 y x w s) :
+    y = pairEncode x (pairEncode w (Nat.bits s)) := h.1
+
+/-- A well-shaped input passes the width check of its radius field. -/
+lemma Shape1.width {y x w : List Bool} {s : ℕ} (h : Shape1 y x w s) :
+    (Nat.bits s).length ≤ (Nat.bits y.length).length := h.2
+
 /-- The well-shaped step inputs `⟨x, ⟨w, ⟨w', bits s⟩⟩⟩` whose radius field fits the width
 check. -/
 def Shape2 (y x w w' : List Bool) (s : ℕ) : Prop :=
diff --git a/TCSlib/Complexity/SpaceComplexity/Codec/Run.lean b/TCSlib/Complexity/SpaceComplexity/Codec/Run.lean
index 66fd1b90..84cd5a6b 100644
--- a/TCSlib/Complexity/SpaceComplexity/Codec/Run.lean
+++ b/TCSlib/Complexity/SpaceComplexity/Codec/Run.lean
@@ -56,6 +56,9 @@ lemma codecAs_mem (j : Fin 2) : codecAs j ∈ LOGSPACE := by
 noncomputable def orc : Fin 2 → List Bool → Bool :=
   fun j V => MultiTapeTM.indicator (codecAs j : Set (List Bool)) V
 
+/-- The oracle is the indicator of the codec's deciders. -/
+lemma orc_eq : orc = fun j V => MultiTapeTM.indicator (codecAs j : Set (List Bool)) V := rfl
+
 /-- The bit oracle reads the input. -/
 lemma orc_bit (y : List Bool) (a : ℕ) : orc jBit (pairEncode y (Nat.bits a)) = y.getD a false := by
   show MultiTapeTM.indicator (inputBitLang : Set (List Bool)) _ = _
