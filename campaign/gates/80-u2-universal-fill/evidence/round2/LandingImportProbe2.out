@Turing.step_of_tapeAction_write : ∀ {Symbol : Type u_1} {State : Type u_2} {k : ℕ} {x : List Symbol}
  (M : Turing.MultiTapeTM k Symbol State) (c : Turing.Cfg k Symbol State x) {q q' : State} (i : Fin k) (inp : SignType)
  (s : Option Symbol) (m : SignType),
  c.state = some q →
    M.tr q c.inputSymbol c.workTapeSymbols = Turing.tapeAction i inp (some s) m q' →
      Turing.MultiTapeTM.step c =
        { state := some q', inputPos := Turing.moveInputPos c.inputPos inp,
          workTapes := Function.update c.workTapes i (Function.update (c.workTapes i) (c.workTapePos i) s),
          workTapePos := Function.update c.workTapePos i (c.workTapePos i + ↑m), output := c.output }
