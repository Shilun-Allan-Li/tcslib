  (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ) (pre : List Symbol) (c : Turing.Cfg m Symbol S x),
  (Turing.embedEmitCfg ι tapes heads pre c).output = pre ++ c.output
