Turing.exists_selfUniversalK : ∀ (k : ℕ) (E : Turing.EffectiveCodeK k),
  ∃ U,
    ∀ (α : List Bool),
      ∃ C,
        0 < C ∧
          ∀ (w : List Bool),
            (∀ (output : List Bool) (t : ℕ),
                (E.toFinTM α).ComputesInTime (Turing.pairEncode α w) output t →
                  U.ComputesInTime (Turing.pairEncode α w) output (C * (t + 1)) ∧
                    Turing.MultiTapeTM.spaceUsed (Turing.MultiTapeTM.initCfg (Turing.pairEncode α w)) (C * (t + 1)) ≤
                      C * (Turing.MultiTapeTM.spaceUsed (Turing.MultiTapeTM.initCfg (Turing.pairEncode α w)) t + 1)) ∧
              ∀ (output : List Bool),
                (∃ t', U.ComputesInTime (Turing.pairEncode α w) output t') →
                  ∃ t, (E.toFinTM α).ComputesInTime (Turing.pairEncode α w) output t
Turing.universalK : ∀ (k : ℕ) (E : Turing.EffectiveCodeK k),
  ∃ U,
    ∀ (α : List Bool),
      ∃ C,
        ∀ (x : List Bool),
          (∀ (output : List Bool) (t : ℕ),
              (E.toFinTM α).ComputesInTime x output t → U.ComputesInTime (Turing.pairEncode α x) output (C * (t + 1))) ∧
            ∀ (output : List Bool),
              (∃ t, U.ComputesInTime (Turing.pairEncode α x) output t) → ∃ t, (E.toFinTM α).ComputesInTime x output t
Turing.exists_selfStartupTMK : ∀ (k : ℕ) (E : Turing.EffectiveCodeK k),
  ∃ K P x x R exit,
    ∀ (α : List Bool),
      ∃ T B,
        ∀ (w : List Bool),
          Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg (Turing.pairEncode α w)) T =
              { state := some exit, inputPos := 1,
                workTapes := fun j =>
                  if ↑j = k then Turing.FinTM.bufferTape (Turing.tableBitsK (E.machine α).tr)
                  else
                    if ↑j = k + 1 then fun p => Turing.FinTM.bufferTape (Turing.unaryFin (E.machine α).q₀) (p - 2)
                    else fun x => none,
                workTapePos := fun x => 0, output := [] } ∧
            (∀ u < T,
                (Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg (Turing.pairEncode α w)) u).state ≠ some exit) ∧
              (∀ u ≤ T,
                  (Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg (Turing.pairEncode α w)) u).output = []) ∧
                Turing.MultiTapeTM.spaceUsed (Turing.MultiTapeTM.initCfg (Turing.pairEncode α w)) T ≤ B
Turing.EffectiveCodeK : ℕ → Type 1
@Turing.EffectiveCodeK.machine : {k : ℕ} →
  (self : Turing.EffectiveCodeK k) → (α : List Bool) → Turing.MultiTapeTM k Bool (Fin (self.numStates α + 1))
@Turing.EffectiveCodeK.numStates : {k : ℕ} → Turing.EffectiveCodeK k → List Bool → ℕ
@Turing.EffectiveCodeK.toFinTM : {k : ℕ} → Turing.EffectiveCodeK k → List Bool → Turing.FinTM Bool
Turing.StepBlock.exists_forwardLoopTM : ∀ (k : ℕ),
  ∃ Q x x L entry C,
    ∀ {n : ℕ} {x : List Bool} (M : Turing.MultiTapeTM k Bool (Fin (n + 1))),
      ∃ cost,
        Turing.Lockstep M L (Turing.StepBlock.forwardLoopCfg entry M) cost {none} {none} ∧
          (∀ (c : Turing.Cfg k Bool (Fin (n + 1)) x),
              c.state ≠ none → 0 < cost c ∧ cost c ≤ 50 * ((Turing.tableBitsK M.tr).length + 1) + C) ∧
            ∀ (c : Turing.Cfg k Bool (Fin (n + 1)) x) (t : ℕ),
              (∀ u < t, (Turing.MultiTapeTM.runFrom c u).state ≠ none) →
                (∀ (i : Fin k),
                    Turing.MultiTapeTM.visitedByTapeHead (Turing.StepBlock.forwardLoopCfg entry M c)
                        (∑ u ∈ Finset.range t, cost (Turing.MultiTapeTM.runFrom c u)) (Fin.castAdd 2 i) ⊆
                      Turing.MultiTapeTM.visitedByTapeHead c t i) ∧
                  ∀ (j : Fin (k + 2)),
                    k ≤ ↑j →
                      Turing.MultiTapeTM.visitedByTapeHead (Turing.StepBlock.forwardLoopCfg entry M c)
                          (∑ u ∈ Finset.range t, cost (Turing.MultiTapeTM.runFrom c u)) j ⊆
                        Finset.Icc (-↑(50 * ((Turing.tableBitsK M.tr).length + 1) + C))
                          ↑(50 * ((Turing.tableBitsK M.tr).length + 1) + C)
@Turing.StepBlock.forwardLoopCfg : {k n : ℕ} →
  {Q : Type} →
    {x : List Bool} →
      Q → Turing.MultiTapeTM k Bool (Fin (n + 1)) → Turing.Cfg k Bool (Fin (n + 1)) x → Turing.Cfg (k + 2) Bool Q x
@Turing.Lockstep : {k : ℕ} →
  {Γ : Type} →
    {k' : ℕ} →
      {Γ' S S' : Type} →
        {x : List Γ} →
          {x' : List Γ'} →
            Turing.MultiTapeTM k Γ S →
              Turing.MultiTapeTM k' Γ' S' →
                (Turing.Cfg k Γ S x → Turing.Cfg k' Γ' S' x') →
                  (Turing.Cfg k Γ S x → ℕ) → Set (Option S) → Set (Option S') → Prop
@Turing.Lockstep.step : ∀ {k : ℕ} {Γ : Type} {k' : ℕ} {Γ' S S' : Type} {x : List Γ} {x' : List Γ'}
  {M : Turing.MultiTapeTM k Γ S} {N : Turing.MultiTapeTM k' Γ' S'} {enc : Turing.Cfg k Γ S x → Turing.Cfg k' Γ' S' x'}
  {cost : Turing.Cfg k Γ S x → ℕ} {X : Set (Option S)} {X' : Set (Option S')},
  Turing.Lockstep M N enc cost X X' →
    ∀ (c : Turing.Cfg k Γ S x),
      c.state ∉ X → Turing.MultiTapeTM.runFrom (enc c) (cost c) = enc (Turing.MultiTapeTM.step c)
@Turing.Lockstep.exit : ∀ {k : ℕ} {Γ : Type} {k' : ℕ} {Γ' S S' : Type} {x : List Γ} {x' : List Γ'}
  {M : Turing.MultiTapeTM k Γ S} {N : Turing.MultiTapeTM k' Γ' S'} {enc : Turing.Cfg k Γ S x → Turing.Cfg k' Γ' S' x'}
  {cost : Turing.Cfg k Γ S x → ℕ} {X : Set (Option S)} {X' : Set (Option S')},
  Turing.Lockstep M N enc cost X X' → ∀ (c : Turing.Cfg k Γ S x), c.state ∈ X → (enc c).state ∈ X'
@Turing.Lockstep.inner : ∀ {k : ℕ} {Γ : Type} {k' : ℕ} {Γ' S S' : Type} {x : List Γ} {x' : List Γ'}
  {M : Turing.MultiTapeTM k Γ S} {N : Turing.MultiTapeTM k' Γ' S'} {enc : Turing.Cfg k Γ S x → Turing.Cfg k' Γ' S' x'}
  {cost : Turing.Cfg k Γ S x → ℕ} {X : Set (Option S)} {X' : Set (Option S')},
  Turing.Lockstep M N enc cost X X' →
    ∀ (c : Turing.Cfg k Γ S x), c.state ∉ X → ∀ v < cost c, (Turing.MultiTapeTM.runFrom (enc c) v).state ∉ X'
@Turing.Lockstep.runFrom : ∀ {k : ℕ} {Γ : Type} {k' : ℕ} {Γ' S S' : Type} {x : List Γ} {x' : List Γ'}
  {M : Turing.MultiTapeTM k Γ S} {N : Turing.MultiTapeTM k' Γ' S'} {enc : Turing.Cfg k Γ S x → Turing.Cfg k' Γ' S' x'}
  {cost : Turing.Cfg k Γ S x → ℕ} {X : Set (Option S)} {X' : Set (Option S')},
  Turing.Lockstep M N enc cost X X' →
    ∀ (d : Turing.Cfg k Γ S x) (t : ℕ),
      (∀ u < t, (Turing.MultiTapeTM.runFrom d u).state ∉ X) →
        Turing.MultiTapeTM.runFrom (enc d) (∑ u ∈ Finset.range t, cost (Turing.MultiTapeTM.runFrom d u)) =
          enc (Turing.MultiTapeTM.runFrom d t)
@Turing.Lockstep.cut : ∀ {k : ℕ} {Γ : Type} {k' : ℕ} {Γ' S S' : Type} {x : List Γ} {x' : List Γ'}
  {M : Turing.MultiTapeTM k Γ S} {N : Turing.MultiTapeTM k' Γ' S'} {enc : Turing.Cfg k Γ S x → Turing.Cfg k' Γ' S' x'}
  {cost : Turing.Cfg k Γ S x → ℕ} {X : Set (Option S)} {X' : Set (Option S')},
  Turing.Lockstep M N enc cost X X' →
    ∀ (d : Turing.Cfg k Γ S x) (t : ℕ),
      (∀ u < t, (Turing.MultiTapeTM.runFrom d u).state ∉ X) →
        ∀ v < ∑ u ∈ Finset.range t, cost (Turing.MultiTapeTM.runFrom d u),
          (Turing.MultiTapeTM.runFrom (enc d) v).state ∉ X'
@Turing.Lockstep.locate : ∀ {k : ℕ} {Γ : Type} {k' : ℕ} {Γ' S S' : Type} {x : List Γ} {x' : List Γ'}
  {M : Turing.MultiTapeTM k Γ S} {N : Turing.MultiTapeTM k' Γ' S'} {enc : Turing.Cfg k Γ S x → Turing.Cfg k' Γ' S' x'}
  {cost : Turing.Cfg k Γ S x → ℕ} {X : Set (Option S)} {X' : Set (Option S')},
  Turing.Lockstep M N enc cost X X' →
    ∀ (d : Turing.Cfg k Γ S x) (t : ℕ),
      (∀ u < t, (Turing.MultiTapeTM.runFrom d u).state ∉ X) →
        ∀ v ≤ ∑ u ∈ Finset.range t, cost (Turing.MultiTapeTM.runFrom d u),
          ∃ u ≤ t,
            ∃ w,
              (w = 0 ∨ (Turing.MultiTapeTM.runFrom d u).state ∉ X ∧ w ≤ cost (Turing.MultiTapeTM.runFrom d u)) ∧
                Turing.MultiTapeTM.runFrom (enc d) v =
                  Turing.MultiTapeTM.runFrom (enc (Turing.MultiTapeTM.runFrom d u)) w
@Turing.tableBitsK : {k n : ℕ} →
  (Fin (n + 1) → Option Bool → (Fin k → Option Bool) → Turing.Action k Bool (Fin (n + 1))) → List Bool
Turing.StepBlock.summaryCells : Option Bool → List Bool → ℤ → Option Bool
Turing.StepBlock.summaryCells_eq : ∀ (summary : Option Bool) (word : List Bool) (z : ℤ),
  Turing.StepBlock.summaryCells summary word z = if z = 0 then summary else Turing.FinTM.bufferTape word (z - 2)
@Turing.unaryFin_eq : ∀ {n : ℕ} (s : Fin n), Turing.unaryFin s = List.replicate (↑s) true ++ [false]
@Turing.FinTM.bufferTape_of_neg : ∀ {Symbol : Type u_1} (w : List Symbol) {z : ℤ},
  z < 0 → Turing.FinTM.bufferTape w z = none
@Turing.FinTM.bufferTape_eq : ∀ {Symbol : Type u_1} (w : List Symbol) (z : ℤ),
  Turing.FinTM.bufferTape w z = if 0 ≤ z then w[z.toNat]? else none
@Fin.addCases_left : ∀ {m n : ℕ} {motive : Fin (m + n) → Sort u_1} {left : (i : Fin m) → motive (Fin.castAdd n i)}
  {right : (i : Fin n) → motive (Fin.natAdd m i)} (i : Fin m), Fin.addCases left right (Fin.castAdd n i) = left i
@Fin.addCases_right : ∀ {m n : ℕ} {motive : Fin (m + n) → Sort u_1} {left : (i : Fin m) → motive (Fin.castAdd n i)}
  {right : (i : Fin n) → motive (Fin.natAdd m i)} (i : Fin n), Fin.addCases left right (Fin.natAdd m i) = right i
@Fin.lastCases_last : ∀ {n : ℕ} {motive : Fin (n + 1) → Sort u_1} {last : motive (Fin.last n)}
  {cast : (i : Fin n) → motive i.castSucc}, Fin.lastCases last cast (Fin.last n) = last
@Fin.lastCases_castSucc : ∀ {n : ℕ} {motive : Fin (n + 1) → Sort u_1} {last : motive (Fin.last n)}
  {cast : (i : Fin n) → motive i.castSucc} (i : Fin n), Fin.lastCases last cast i.castSucc = cast i
@Turing.exists_rulerHostTM : ∀ {m : ℕ} {S : Type} [Fintype S] [DecidableEq S] (M : Turing.MultiTapeTM m Bool S),
  ∃ Q x x H inj C,
    0 < C ∧
      ∀ {y z : List Bool} (ℓ : ℕ) (hz : z.length = ℓ + y.length),
        0 < ℓ →
          List.drop ℓ z = y →
            ∀ (rt : ℤ → Option Bool) (rp : ℤ),
              (∀ (p : ℤ), -1 ≤ p → p ≤ ↑ℓ → rt (rp + p) = Turing.FinTM.bufferTape (List.replicate ℓ true) p) →
                ∀ (c : Turing.Cfg m Bool S y) (b : Bool),
                  (b = true ↔ ↑c.inputPos = 0) →
                    ∀ (t : ℕ),
                      have d := Turing.rulerHostCfg ℓ hz (Option.map (fun q => inj q b) c.state) c rt rp;
                      ∃ t',
                        t ≤ t' ∧
                          t' ≤ C * (ℓ + 1) * t ∧
                            (∃ b',
                                (b' = true ↔ ↑(Turing.MultiTapeTM.runFrom c t).inputPos = 0) ∧
                                  Turing.MultiTapeTM.runFrom d t' =
                                    Turing.rulerHostCfg ℓ hz
                                      (Option.map (fun q => inj q b') (Turing.MultiTapeTM.runFrom c t).state)
                                      (Turing.MultiTapeTM.runFrom c t) rt rp) ∧
                              ((∀ u < t, (Turing.MultiTapeTM.runFrom c u).state ≠ none) →
                                  ∀ u < t', (Turing.MultiTapeTM.runFrom d u).state ≠ none) ∧
                                (∀ u ≤ t',
                                    ∃ v ≤ t,
                                      (∀ (i : Fin m),
                                          (Turing.MultiTapeTM.runFrom d u).workTapes i.castSucc =
                                              (Turing.MultiTapeTM.runFrom c v).workTapes i ∧
                                            (Turing.MultiTapeTM.runFrom d u).workTapePos i.castSucc =
                                              (Turing.MultiTapeTM.runFrom c v).workTapePos i) ∧
                                        (Turing.MultiTapeTM.runFrom d u).output =
                                            (Turing.MultiTapeTM.runFrom c v).output ∧
                                          (Turing.MultiTapeTM.runFrom d u).workTapes (Fin.last m) = rt ∧
                                            (Turing.MultiTapeTM.runFrom d u).workTapePos (Fin.last m) ∈
                                              Finset.Icc (rp - 1) (rp + ↑ℓ)) ∧
                                  (∀ (i : Fin m),
                                      Turing.MultiTapeTM.visitedByTapeHead d t' i.castSucc =
                                        Turing.MultiTapeTM.visitedByTapeHead c t i) ∧
                                    Turing.MultiTapeTM.visitedByTapeHead d t' (Fin.last m) ⊆
                                      Finset.Icc (rp - 1) (rp + ↑ℓ)
@Turing.rulerHostCfg : {m : ℕ} →
  {S Q : Type} →
    {y z : List Bool} →
      (ℓ : ℕ) →
        z.length = ℓ + y.length → Option Q → Turing.Cfg m Bool S y → (ℤ → Option Bool) → ℤ → Turing.Cfg (m + 1) Bool Q z
Turing.universal_pair_length : ∀ (α x : List Bool), (Turing.pairEncode α x).length = 2 * α.length + 2 + x.length
Turing.length_pairEncode : ∀ (x y : List Bool), (Turing.pairEncode x y).length = 2 * x.length + 2 + y.length
Turing.pairEncode_eq : ∀ (x α : List Bool),
  Turing.pairEncode x α = List.flatMap (fun b => [b, b]) x ++ [false, true] ++ α
@Turing.rewindTM : {Symbol : Type u_1} → (k : ℕ) → Fin k → Turing.MultiTapeTM k Symbol Turing.RewindPhase
@Turing.rewindTM_run_ofCfg : ∀ {Symbol : Type u_1} {k : ℕ} {x : List Symbol} (i : Fin k) (u : List Symbol),
  ∀ n ≤ u.length,
    ∀ (d : Turing.Cfg k Symbol Turing.RewindPhase x),
      d.state = some Turing.RewindPhase.start →
        (∀ (p : ℤ), -1 ≤ p → p < ↑n → d.workTapes i (d.workTapePos i - ↑n + p) = Turing.FinTM.bufferTape u p) →
          Turing.MultiTapeTM.runFrom d (n + 2) =
              { state := some Turing.RewindPhase.done, inputPos := d.inputPos, workTapes := d.workTapes,
                workTapePos := Function.update d.workTapePos i (d.workTapePos i - ↑n), output := d.output } ∧
            (∀ t < n + 2, (Turing.MultiTapeTM.runFrom d t).state ≠ some Turing.RewindPhase.done) ∧
              ∀ (j : Fin k),
                ∀ t ≤ n + 2,
                  if j = i then
                    (Turing.MultiTapeTM.runFrom d t).workTapePos j ∈
                      Finset.Icc (d.workTapePos j - ↑n - 1) (d.workTapePos j)
                  else (Turing.MultiTapeTM.runFrom d t).workTapePos j = d.workTapePos j
@Turing.tapeAction : {k : ℕ} →
  {Symbol : Type u_1} →
    {State : Type u_2} → Fin k → SignType → Option (Option Symbol) → SignType → State → Turing.Action k Symbol State
@Turing.step_of_tapeAction_move : ∀ {Symbol : Type u_1} {State : Type u_2} {k : ℕ} {x : List Symbol}
  (M : Turing.MultiTapeTM k Symbol State) (c : Turing.Cfg k Symbol State x) {q q' : State} (i : Fin k)
  (inp m : SignType),
  c.state = some q →
    M.tr q c.inputSymbol c.workTapeSymbols = Turing.tapeAction i inp none m q' →
      Turing.MultiTapeTM.step c =
        { state := some q', inputPos := Turing.moveInputPos c.inputPos inp, workTapes := c.workTapes,
          workTapePos := Function.update c.workTapePos i (c.workTapePos i + ↑m), output := c.output }
@Turing.step_of_inputMoveAction : ∀ {Symbol : Type u_1} {State : Type u_2} {k : ℕ} {x : List Symbol}
  (M : Turing.MultiTapeTM k Symbol State) (c : Turing.Cfg k Symbol State x) {q q' : State} (inp : SignType),
  c.state = some q →
    M.tr q c.inputSymbol c.workTapeSymbols = Turing.inputMoveAction inp q' →
      Turing.MultiTapeTM.step c =
        { state := some q', inputPos := Turing.moveInputPos c.inputPos inp, workTapes := c.workTapes,
          workTapePos := c.workTapePos, output := c.output }
@Turing.MultiTapeTM.step_of_some : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  {tm : Turing.MultiTapeTM k Symbol State} {cfg : Turing.Cfg k Symbol State input} {q : State},
  cfg.state = some q → Turing.MultiTapeTM.step cfg = (tm.tr q cfg.inputSymbol cfg.workTapeSymbols).apply cfg
@Turing.MultiTapeTM.step_of_halt : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  {tm : Turing.MultiTapeTM k Symbol State} {cfg : Turing.Cfg k Symbol State input},
  cfg.state = none → Turing.MultiTapeTM.step cfg = cfg
@Turing.seamCompTM : {k : ℕ} →
  {S₁ : Type u_1} →
    {S₂ : Type u_2} →
      {Symbol : Type u_3} →
        [DecidableEq S₁] →
          Turing.MultiTapeTM k Symbol S₁ →
            S₁ → Turing.MultiTapeTM k Symbol S₂ → S₂ → Turing.MultiTapeTM k Symbol (S₁ ⊕ S₂)
@Turing.seamCompTM_run_ofCfg : ∀ {k : ℕ} {S₁ : Type u_1} {S₂ : Type u_2} {Symbol : Type u_3} {x : List Symbol}
  [inst : DecidableEq S₁] (M₁ : Turing.MultiTapeTM k Symbol S₁) (exit : S₁) (M₂ : Turing.MultiTapeTM k Symbol S₂)
  (entry : S₂) {c₀ c₁ : Turing.Cfg k Symbol S₁ x} {c₃ : Turing.Cfg k Symbol S₂ x} {T₁ T₂ : ℕ},
  Turing.MultiTapeTM.runFrom c₀ T₁ = c₁ →
    c₁.state = some exit →
      (∀ t < T₁, (Turing.MultiTapeTM.runFrom c₀ t).state ≠ some exit) →
        Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState (fun x => entry) c₁) T₂ = c₃ →
          Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState Sum.inl c₀) (T₁ + 1 + T₂) = Turing.Cfg.mapState Sum.inr c₃
@Turing.seamCompTM_firstReturn_ofCfg : ∀ {k : ℕ} {S₁ : Type u_1} {S₂ : Type u_2} {Symbol : Type u_3} {x : List Symbol}
  [inst : DecidableEq S₁] (M₁ : Turing.MultiTapeTM k Symbol S₁) (exit : S₁) (M₂ : Turing.MultiTapeTM k Symbol S₂)
  (entry q₂ : S₂) {c₀ c₁ : Turing.Cfg k Symbol S₁ x} {c₃ : Turing.Cfg k Symbol S₂ x} {T₁ T₂ : ℕ},
  Turing.MultiTapeTM.runFrom c₀ T₁ = c₁ →
    c₁.state = some exit →
      (∀ t < T₁, (Turing.MultiTapeTM.runFrom c₀ t).state ≠ some exit) →
        Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState (fun x => entry) c₁) T₂ = c₃ →
          c₃.state = some q₂ →
            (∀ t < T₂, (Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState (fun x => entry) c₁) t).state ≠ some q₂) →
              ∀ t < T₁ + 1 + T₂,
                (Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState Sum.inl c₀) t).state ≠ some (Sum.inr q₂)
@Turing.seamCompTM_runFrom_left : ∀ {k : ℕ} {S₁ : Type u_1} {S₂ : Type u_2} {Symbol : Type u_3} {x : List Symbol}
  [inst : DecidableEq S₁] (M₁ : Turing.MultiTapeTM k Symbol S₁) (exit : S₁) (M₂ : Turing.MultiTapeTM k Symbol S₂)
  (entry : S₂) {c : Turing.Cfg k Symbol S₁ x} {T : ℕ},
  (∀ t < T, (Turing.MultiTapeTM.runFrom c t).state ≠ some exit) →
    ∀ t ≤ T,
      Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState Sum.inl c) t =
        Turing.Cfg.mapState Sum.inl (Turing.MultiTapeTM.runFrom c t)
@Turing.seamCompTM_runFrom_right : ∀ {k : ℕ} {S₁ : Type u_1} {S₂ : Type u_2} {Symbol : Type u_3} {x : List Symbol}
  [inst : DecidableEq S₁] (M₁ : Turing.MultiTapeTM k Symbol S₁) (exit : S₁) (M₂ : Turing.MultiTapeTM k Symbol S₂)
  (entry : S₂) {c₀ c₁ : Turing.Cfg k Symbol S₁ x} {T₁ : ℕ},
  Turing.MultiTapeTM.runFrom c₀ T₁ = c₁ →
    c₁.state = some exit →
      (∀ t < T₁, (Turing.MultiTapeTM.runFrom c₀ t).state ≠ some exit) →
        ∀ (t : ℕ),
          Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState Sum.inl c₀) (T₁ + 1 + t) =
            Turing.Cfg.mapState Sum.inr (Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState (fun x => entry) c₁) t)
@Turing.seamCompTM_visitedByTapeHead_ofCfg : ∀ {k : ℕ} {S₁ : Type u_1} {S₂ : Type u_2} {Symbol : Type u_3}
  {x : List Symbol} [inst : DecidableEq S₁] (M₁ : Turing.MultiTapeTM k Symbol S₁) (exit : S₁)
  (M₂ : Turing.MultiTapeTM k Symbol S₂) (entry : S₂) {c₀ c₁ : Turing.Cfg k Symbol S₁ x} {T₁ T₂ : ℕ},
  Turing.MultiTapeTM.runFrom c₀ T₁ = c₁ →
    c₁.state = some exit →
      (∀ t < T₁, (Turing.MultiTapeTM.runFrom c₀ t).state ≠ some exit) →
        ∀ (i : Fin k),
          Turing.MultiTapeTM.visitedByTapeHead (Turing.Cfg.mapState Sum.inl c₀) (T₁ + 1 + T₂) i ⊆
            Turing.MultiTapeTM.visitedByTapeHead c₀ T₁ i ∪
              Turing.MultiTapeTM.visitedByTapeHead (Turing.Cfg.mapState (fun x => entry) c₁) T₂ i
@Turing.seamCompTM_spaceUsed_le_add : ∀ {k : ℕ} {S₁ : Type u_1} {S₂ : Type u_2} {x : List Bool} [inst : DecidableEq S₁]
  (M₁ : Turing.MultiTapeTM k Bool S₁) (exit : S₁) (M₂ : Turing.MultiTapeTM k Bool S₂) (entry : S₂) (start : S₁)
  (q₂ : S₂) (w₀ w₁ w₂ : Fin k → List Bool) (T₁ T₂ : ℕ),
  Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords start w₀) T₁ = Turing.Cfg.ofWords exit w₁ →
    (∀ t < T₁, (Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords start w₀) t).state ≠ some exit) →
      Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords entry w₁) T₂ = Turing.Cfg.ofWords q₂ w₂ →
        Turing.MultiTapeTM.spaceUsed (Turing.Cfg.ofWords (Sum.inl start) w₀) (T₁ + 1 + T₂) ≤
          Turing.MultiTapeTM.spaceUsed (Turing.Cfg.ofWords start w₀) T₁ +
            Turing.MultiTapeTM.spaceUsed (Turing.Cfg.ofWords entry w₁) T₂
@Turing.phaseHostTM : {k : ℕ} →
  {Γ I : Type} →
    {Ph : I → Type} →
      ((i : I) → Turing.MultiTapeTM k Γ (Ph i)) →
        (i : I) × Ph i → ((i : I) → Ph i → Option ((i : I) × Ph i)) → Turing.MultiTapeTM k Γ ((i : I) × Ph i)
@Turing.phaseHostTM_run : ∀ {k : ℕ} {Γ I : Type} {Ph : I → Type} (M : (i : I) → Turing.MultiTapeTM k Γ (Ph i))
  (q0 : (i : I) × Ph i) (red : (i : I) → Ph i → Option ((i : I) × Ph i)) (i : I) {x : List Γ}
  (c c' : Turing.Cfg k Γ (Ph i) x) (T : ℕ),
  Turing.MultiTapeTM.runFrom c T = c' →
    ∀ (s' : Ph i),
      c'.state = some s' →
        ∀ (q' : (i : I) × Ph i),
          red i s' = some q' →
            (∀ u < T, ∀ (s : Ph i), (Turing.MultiTapeTM.runFrom c u).state = some s → red i s = none) →
              (∀ u ≤ T,
                  Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState (Sigma.mk i) c) u =
                    Turing.Cfg.mapState (Sigma.mk i) (Turing.MultiTapeTM.runFrom c u)) ∧
                Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState (Sigma.mk i) c) (T + 1) =
                  Turing.Cfg.mapState (fun x => q') c'
@Turing.embedEmitTM : {m k : ℕ} →
  {S : Type u_1} → {Symbol : Type u_2} → (Fin m ↪ Fin k) → Turing.MultiTapeTM m Symbol S → Turing.MultiTapeTM k Symbol S
@Turing.embedEmitTM_runFrom : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol} (ι : Fin m ↪ Fin k)
  (M : Turing.MultiTapeTM m Symbol S) (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ) (pre : List Symbol)
  (c : Turing.Cfg m Symbol S x) (t : ℕ),
  Turing.MultiTapeTM.runFrom (Turing.embedEmitCfg ι tapes heads pre c) t =
    Turing.embedEmitCfg ι tapes heads pre (Turing.MultiTapeTM.runFrom c t)
@Turing.embedEmitCfg_eq : ∀ {k : ℕ} {Γ : Type u_1} {m : ℕ} {S : Type u_2} {x : List Γ} (σ : Fin m ↪ Fin k)
  (tapes : Fin k → ℤ → Option Γ) (heads : Fin k → ℤ) (pre : List Γ) (c : Turing.Cfg m Γ S x) (d : Turing.Cfg k Γ S x),
  c.state = d.state →
    c.inputPos = d.inputPos →
      pre ++ c.output = d.output →
        (∀ (i : Fin m), c.workTapes i = d.workTapes (σ i) ∧ c.workTapePos i = d.workTapePos (σ i)) →
          (∀ j ∉ Set.range ⇑σ, tapes j = d.workTapes j ∧ heads j = d.workTapePos j) →
            Turing.embedEmitCfg σ tapes heads pre c = d
@Turing.embedEmitTM_visitedByTapeHead : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol}
  (ι : Fin m ↪ Fin k) (M : Turing.MultiTapeTM m Symbol S) (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ)
  (pre : List Symbol) (c : Turing.Cfg m Symbol S x) (t : ℕ) (i : Fin m),
  Turing.MultiTapeTM.visitedByTapeHead (Turing.embedEmitCfg ι tapes heads pre c) t (ι i) =
      Turing.MultiTapeTM.visitedByTapeHead c t i ∧
    Turing.MultiTapeTM.spaceUsedByTape (Turing.embedEmitCfg ι tapes heads pre c) t (ι i) =
      Turing.MultiTapeTM.spaceUsedByTape c t i
@Turing.embedEmitTM_visitedByTapeHead_frame : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol}
  (ι : Fin m ↪ Fin k) (M : Turing.MultiTapeTM m Symbol S) (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ)
  (pre : List Symbol) (c : Turing.Cfg m Symbol S x) (t : ℕ),
  ∀ j ∉ Set.range ⇑ι,
    Turing.MultiTapeTM.visitedByTapeHead (Turing.embedEmitCfg ι tapes heads pre c) t j = {heads j} ∧
      Turing.MultiTapeTM.spaceUsedByTape (Turing.embedEmitCfg ι tapes heads pre c) t j = 1
@Turing.MultiTapeTM.initCfg_eq : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2}
  {tm : Turing.MultiTapeTM k Symbol State} (input : List Symbol),
  Turing.MultiTapeTM.initCfg input = Turing.Cfg.init tm.q₀ input
@Turing.Cfg.init_state : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} (q₀ : State) (input : List Symbol),
  (Turing.Cfg.init q₀ input).state = some q₀
@Turing.Cfg.init_inputPos : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} (q₀ : State) (input : List Symbol),
  (Turing.Cfg.init q₀ input).inputPos = 1
@Turing.Cfg.init_workTapes : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} (q₀ : State) (input : List Symbol)
  (x : Fin k) (x_1 : ℤ), (Turing.Cfg.init q₀ input).workTapes x x_1 = none
@Turing.Cfg.init_workTapePos : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} (q₀ : State) (input : List Symbol)
  (x : Fin k), (Turing.Cfg.init q₀ input).workTapePos x = 0
@Turing.Cfg.init_output : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} (q₀ : State) (input : List Symbol),
  (Turing.Cfg.init q₀ input).output = []
@Turing.MultiTapeTM.runFrom_add : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  {tm : Turing.MultiTapeTM k Symbol State} (cfg : Turing.Cfg k Symbol State input) (a b : ℕ),
  Turing.MultiTapeTM.runFrom cfg (a + b) = Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.runFrom cfg a) b
@Turing.MultiTapeTM.runFrom_zero : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  {tm : Turing.MultiTapeTM k Symbol State} {cfg : Turing.Cfg k Symbol State input},
  Turing.MultiTapeTM.runFrom cfg 0 = cfg
@Turing.MultiTapeTM.runFrom_of_halt : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  {tm : Turing.MultiTapeTM k Symbol State} (cfg : Turing.Cfg k Symbol State input),
  cfg.state = none → ∀ {n : ℕ}, Turing.MultiTapeTM.runFrom cfg n = cfg
@Turing.MultiTapeTM.exists_first_halt : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {input : List Symbol}
  (tm : Turing.MultiTapeTM k Symbol State) (cfg : Turing.Cfg k Symbol State input) {t : ℕ},
  (Turing.MultiTapeTM.runFrom cfg t).state = none →
    ∃ u ≤ t,
      (∀ v < u, ¬(Turing.MultiTapeTM.runFrom cfg v).Halted) ∧
        Turing.MultiTapeTM.runFrom cfg u = Turing.MultiTapeTM.runFrom cfg t
@Turing.MultiTapeTM.output_prefix : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {input : List Symbol}
  (tm : Turing.MultiTapeTM k Symbol State) (cfg : Turing.Cfg k Symbol State input) {t t' : ℕ},
  t ≤ t' → (Turing.MultiTapeTM.runFrom cfg t).output <+: (Turing.MultiTapeTM.runFrom cfg t').output
@Turing.FinTM.computesInTime_iff : ∀ {Symbol : Type} (M : Turing.FinTM Symbol) (x w : List Symbol) (t : ℕ),
  M.ComputesInTime x w t ↔
    (Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) t).state = none ∧
      (Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) t).output = w
@Turing.FinTM.ComputesInTime.mono : ∀ {Symbol : Type} {M : Turing.FinTM Symbol} {input output : List Symbol} {t t' : ℕ},
  M.ComputesInTime input output t → t ≤ t' → M.ComputesInTime input output t'
@Turing.MultiTapeTM.spaceUsed_eq_sum : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  {tm : Turing.MultiTapeTM k Symbol State} (cfg : Turing.Cfg k Symbol State input) (t : ℕ),
  Turing.MultiTapeTM.spaceUsed cfg t = ∑ i, Turing.MultiTapeTM.spaceUsedByTape cfg t i
@Turing.MultiTapeTM.spaceUsed_le_of_abs_le : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {input : List Symbol}
  (tm : Turing.MultiTapeTM k Symbol State) (d : Turing.Cfg k Symbol State input) (t r : ℕ),
  (∀ u ≤ t, ∀ (j : Fin k), |(Turing.MultiTapeTM.runFrom d u).workTapePos j - d.workTapePos j| ≤ ↑r) →
    Turing.MultiTapeTM.spaceUsed d t ≤ k * (2 * r + 1)
@Turing.MultiTapeTM.spaceUsedByTape_le_card_Icc : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {input : List Symbol}
  (tm : Turing.MultiTapeTM k Symbol State) (d : Turing.Cfg k Symbol State input) (t : ℕ) (i : Fin k) (lo hi : ℤ),
  (∀ u ≤ t, (Turing.MultiTapeTM.runFrom d u).workTapePos i ∈ Finset.Icc lo hi) →
    Turing.MultiTapeTM.spaceUsedByTape d t i ≤ (hi + 1 - lo).toNat
@Turing.MultiTapeTM.spaceUsed_le_mul_succ : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {input : List Symbol}
  (tm : Turing.MultiTapeTM k Symbol State) (cfg : Turing.Cfg k Symbol State input) (t : ℕ),
  Turing.MultiTapeTM.spaceUsed cfg t ≤ k * (t + 1)
@Turing.MultiTapeTM.mem_visitedByTapeHead_iff : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  {tm : Turing.MultiTapeTM k Symbol State} (cfg : Turing.Cfg k Symbol State input) (t : ℕ) (i : Fin k) (p : ℤ),
  p ∈ Turing.MultiTapeTM.visitedByTapeHead cfg t i ↔ ∃ u ≤ t, (Turing.MultiTapeTM.runFrom cfg u).workTapePos i = p
@Turing.MultiTapeTM.visitedByTapeHead_add_subset : ∀ {m : ℕ} {S : Type} {x : List Bool}
  (M : Turing.MultiTapeTM m Bool S) (d : Turing.Cfg m Bool S x) (T₁ T₂ : ℕ) (j : Fin m),
  Turing.MultiTapeTM.visitedByTapeHead d (T₁ + T₂) j ⊆
    Turing.MultiTapeTM.visitedByTapeHead d T₁ j ∪
      Turing.MultiTapeTM.visitedByTapeHead (Turing.MultiTapeTM.runFrom d T₁) T₂ j
@Turing.Cfg.mapState_state : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {State' : Type u_3} {input : List Symbol}
  (f : State → State') (cfg : Turing.Cfg k Symbol State input),
  (Turing.Cfg.mapState f cfg).state = Option.map f cfg.state
@Turing.Cfg.mapState_inputPos : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {State' : Type u_3}
  {input : List Symbol} (f : State → State') (cfg : Turing.Cfg k Symbol State input),
  (Turing.Cfg.mapState f cfg).inputPos = cfg.inputPos
@Turing.Cfg.mapState_workTapes : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {State' : Type u_3}
  {input : List Symbol} (f : State → State') (cfg : Turing.Cfg k Symbol State input) (a : Fin k) (a_1 : ℤ),
  (Turing.Cfg.mapState f cfg).workTapes a a_1 = cfg.workTapes a a_1
@Turing.Cfg.mapState_workTapePos : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {State' : Type u_3}
  {input : List Symbol} (f : State → State') (cfg : Turing.Cfg k Symbol State input) (a : Fin k),
  (Turing.Cfg.mapState f cfg).workTapePos a = cfg.workTapePos a
@Turing.Cfg.mapState_output : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {State' : Type u_3} {input : List Symbol}
  (f : State → State') (cfg : Turing.Cfg k Symbol State input), (Turing.Cfg.mapState f cfg).output = cfg.output
@Turing.Cfg.ext : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {input : List Symbol}
  {x y : Turing.Cfg k Symbol State input},
  x.state = y.state →
    x.inputPos = y.inputPos → x.workTapes = y.workTapes → x.workTapePos = y.workTapePos → x.output = y.output → x = y
'Turing.exists_selfStartupTMK' depends on axioms: [propext, Classical.choice, Quot.sound]
'Turing.StepBlock.exists_forwardLoopTM' depends on axioms: [propext, Classical.choice, Quot.sound]
'Turing.exists_rulerHostTM' depends on axioms: [propext, Classical.choice, Quot.sound]
'Turing.Lockstep.runFrom' depends on axioms: [propext, Classical.choice, Quot.sound]
'Turing.rewindTM_run_ofCfg' depends on axioms: [propext, Classical.choice, Quot.sound]
@Turing.StepBlock.forwardLoopCfg_state : ∀ {k n : ℕ} {Q : Type} {x : List Bool} (entry : Q)
  (M : Turing.MultiTapeTM k Bool (Fin (n + 1))) (c : Turing.Cfg k Bool (Fin (n + 1)) x),
  (Turing.StepBlock.forwardLoopCfg entry M c).state = Option.map (fun x => entry) c.state
@Turing.StepBlock.forwardLoopCfg_inputPos : ∀ {k n : ℕ} {Q : Type} {x : List Bool} (entry : Q)
  (M : Turing.MultiTapeTM k Bool (Fin (n + 1))) (c : Turing.Cfg k Bool (Fin (n + 1)) x),
  (Turing.StepBlock.forwardLoopCfg entry M c).inputPos = c.inputPos
@Turing.StepBlock.forwardLoopCfg_workTapes : ∀ {k n : ℕ} {Q : Type} {x : List Bool} (entry : Q)
  (M : Turing.MultiTapeTM k Bool (Fin (n + 1))) (c : Turing.Cfg k Bool (Fin (n + 1)) x) (i : Fin (k + 2)) (a : ℤ),
  (Turing.StepBlock.forwardLoopCfg entry M c).workTapes i a =
    Fin.addCases (motive := fun x => ℤ → Option Bool) c.workTapes
      (fun j =>
        if j = 0 then Turing.FinTM.bufferTape (Turing.tableBitsK M.tr)
        else Turing.StepBlock.summaryCells none ((Option.map Turing.unaryFin c.state).getD []))
      i a
@Turing.StepBlock.forwardLoopCfg_workTapePos : ∀ {k n : ℕ} {Q : Type} {x : List Bool} (entry : Q)
  (M : Turing.MultiTapeTM k Bool (Fin (n + 1))) (c : Turing.Cfg k Bool (Fin (n + 1)) x) (i : Fin (k + 2)),
  (Turing.StepBlock.forwardLoopCfg entry M c).workTapePos i = Fin.addCases c.workTapePos (fun x => 0) i
@Turing.StepBlock.forwardLoopCfg_output : ∀ {k n : ℕ} {Q : Type} {x : List Bool} (entry : Q)
  (M : Turing.MultiTapeTM k Bool (Fin (n + 1))) (c : Turing.Cfg k Bool (Fin (n + 1)) x),
  (Turing.StepBlock.forwardLoopCfg entry M c).output = c.output
@Turing.rulerHostCfg_state : ∀ {m : ℕ} {S Q : Type} {y z : List Bool} (ℓ : ℕ) (hz : z.length = ℓ + y.length)
  (q : Option Q) (c : Turing.Cfg m Bool S y) (rt : ℤ → Option Bool) (rp : ℤ),
  (Turing.rulerHostCfg ℓ hz q c rt rp).state = q
@Turing.rulerHostCfg_inputPos : ∀ {m : ℕ} {S Q : Type} {y z : List Bool} (ℓ : ℕ) (hz : z.length = ℓ + y.length)
  (q : Option Q) (c : Turing.Cfg m Bool S y) (rt : ℤ → Option Bool) (rp : ℤ),
  (Turing.rulerHostCfg ℓ hz q c rt rp).inputPos = ⟨ℓ + ↑c.inputPos, ⋯⟩
@Turing.rulerHostCfg_workTapes : ∀ {m : ℕ} {S Q : Type} {y z : List Bool} (ℓ : ℕ) (hz : z.length = ℓ + y.length)
  (q : Option Q) (c : Turing.Cfg m Bool S y) (rt : ℤ → Option Bool) (rp : ℤ) (i : Fin (m + 1)) (a : ℤ),
  (Turing.rulerHostCfg ℓ hz q c rt rp).workTapes i a =
    Fin.lastCases (motive := fun x => ℤ → Option Bool) rt c.workTapes i a
@Turing.rulerHostCfg_workTapePos : ∀ {m : ℕ} {S Q : Type} {y z : List Bool} (ℓ : ℕ) (hz : z.length = ℓ + y.length)
  (q : Option Q) (c : Turing.Cfg m Bool S y) (rt : ℤ → Option Bool) (rp : ℤ) (i : Fin (m + 1)),
  (Turing.rulerHostCfg ℓ hz q c rt rp).workTapePos i = Fin.lastCases rp c.workTapePos i
@Turing.rulerHostCfg_output : ∀ {m : ℕ} {S Q : Type} {y z : List Bool} (ℓ : ℕ) (hz : z.length = ℓ + y.length)
  (q : Option Q) (c : Turing.Cfg m Bool S y) (rt : ℤ → Option Bool) (rp : ℤ),
  (Turing.rulerHostCfg ℓ hz q c rt rp).output = c.output
@Turing.MultiTapeTM.spaceUsedByTape_eq_card : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  {tm : Turing.MultiTapeTM k Symbol State} (cfg : Turing.Cfg k Symbol State input) (t : ℕ) (i : Fin k),
  Turing.MultiTapeTM.spaceUsedByTape cfg t i = (Turing.MultiTapeTM.visitedByTapeHead cfg t i).card
Turing.pairEncode_drop : ∀ (u x : List Bool), List.drop (2 * u.length + 2) (Turing.pairEncode u x) = x
@Turing.phaseHostTM_run_le : ∀ {k : ℕ} {Γ I : Type} {Ph : I → Type} (M : (i : I) → Turing.MultiTapeTM k Γ (Ph i))
  (q0 : (i : I) × Ph i) (red : (i : I) → Ph i → Option ((i : I) × Ph i)) (i : I) {x : List Γ}
  (c : Turing.Cfg k Γ (Ph i) x) (T : ℕ),
  (∀ u < T, ∀ (s : Ph i), (Turing.MultiTapeTM.runFrom c u).state = some s → red i s = none) →
    ∀ u ≤ T,
      Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState (Sigma.mk i) c) u =
        Turing.Cfg.mapState (Sigma.mk i) (Turing.MultiTapeTM.runFrom c u)
@Turing.phaseHostTM_tr_of_red_none : ∀ {k : ℕ} {Γ I : Type} {Ph : I → Type}
  (M : (i : I) → Turing.MultiTapeTM k Γ (Ph i)) (q0 : (i : I) × Ph i) (red : (i : I) → Ph i → Option ((i : I) × Ph i))
  (i : I) (s : Ph i),
  red i s = none →
    ∀ (inp : Option Γ) (w : Fin k → Option Γ),
      (Turing.phaseHostTM M q0 red).tr ⟨i, s⟩ inp w = Turing.Action.mapState (Sigma.mk i) ((M i).tr s inp w)
@Turing.phaseHostTM_q₀ : ∀ {k : ℕ} {Γ I : Type} {Ph : I → Type} (M : (i : I) → Turing.MultiTapeTM k Γ (Ph i))
  (q0 : (i : I) × Ph i) (red : (i : I) → Ph i → Option ((i : I) × Ph i)), (Turing.phaseHostTM M q0 red).q₀ = q0
@Turing.phaseHostTM_tr_of_red_some : ∀ {k : ℕ} {Γ I : Type} {Ph : I → Type}
  (M : (i : I) → Turing.MultiTapeTM k Γ (Ph i)) (q0 : (i : I) × Ph i) (red : (i : I) → Ph i → Option ((i : I) × Ph i))
  (i : I) (s : Ph i) {q' : (i : I) × Ph i},
  red i s = some q' →
    ∀ (inp : Option Γ) (w : Fin k → Option Γ),
      (Turing.phaseHostTM M q0 red).tr ⟨i, s⟩ inp w =
        { inputTape := 0, workTapes := fun x => (none, 0), output := none, state := some q' }
