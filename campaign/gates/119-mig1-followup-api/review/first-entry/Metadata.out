  {input : List Symbol} (tm : Turing.MultiTapeTM k Symbol State) (stop : State → Prop)
  (c d : Turing.Cfg k Symbol State input) (T : ℕ),
  (∀ (z : Turing.Cfg k Symbol State input), (∃ q, z.state = some q ∧ stop q) → Turing.MultiTapeTM.step z = z) →
