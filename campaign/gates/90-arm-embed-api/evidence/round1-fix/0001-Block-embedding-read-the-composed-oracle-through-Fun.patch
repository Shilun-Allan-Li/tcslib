From 940932752e598b4a452311465dee81adea46d17b Mon Sep 17 00:00:00 2001
From: Seyoon Ragavan <complexzetaprime@gmail.com>
Date: Wed, 4 Nov 2026 13:11:56 -0800
Subject: [PATCH] Block embedding: read the composed oracle through
 Function.comp_apply

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 TCSlib/Complexity/SpaceComplexity/Machines/ARMProof.lean | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/TCSlib/Complexity/SpaceComplexity/Machines/ARMProof.lean b/TCSlib/Complexity/SpaceComplexity/Machines/ARMProof.lean
index edb73d3c..3fba6a19 100644
--- a/TCSlib/Complexity/SpaceComplexity/Machines/ARMProof.lean
+++ b/TCSlib/Complexity/SpaceComplexity/Machines/ARMProof.lean
@@ -454,7 +454,7 @@ lemma astep_embed (hρ : Function.Injective ρ) (hD : ∀ l, D (ι l) = (A l).em
         (fun r' => Nat.bits (v' r')) = callSegs ⟨j, md, args, l₁, l₀⟩ x
         (fun r => Nat.bits (v r)) :=
       callSegs_congr rfl (by simp only [List.map_map]; congr 1; funext r; simp [hv.reg r])
-    rw [astep_call (hDl _ hAl), hseg]; dsimp only [Function.comp]; split_ifs <;> rfl
+    rw [astep_call (hDl _ hAl), hseg]; simp only [Function.comp_apply]; split_ifs <;> rfl
   | ret b =>
     refine Or.inr ⟨b, astep_ret hAl, ?_⟩
     rw [astep_jz (hDl _ hAl)]; split_ifs <;> rfl
