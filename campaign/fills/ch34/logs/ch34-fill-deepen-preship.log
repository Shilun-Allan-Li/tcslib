              (∀ (s : Fin m), v s ≤ B) →
                v r ≤ x.length →
                  AReach A oracle x (fun a => PreS A x a ∧ ∀ (s : Fin m), a.2.1 s ≤ B) (some scan, v, none)
                    (some done, Function.update v r x.length, none)
