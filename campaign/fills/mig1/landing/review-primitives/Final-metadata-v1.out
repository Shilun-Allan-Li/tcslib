  (M : Turing.FinTM Bool) {x : List Bool} (c : Turing.Cfg (1 + (1 + M.k)) Bool (Turing.FinTM.FwdMapState✝ M.State) x),
  Turing.FinTM.fwdMapEntered✝ M c → ∀ (t : ℕ), Turing.MultiTapeTM.runFrom c t = c
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.fwdMapSetup_step|TCSlib.Complexity.TuringMachine.Build.Primitives|kind=theorem|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.fwdMapSetup_step|∀ (M : Turing.FinTM Bool)
  {x : List Bool} (c : Turing.Cfg (1 + (1 + M.k)) Bool (Turing.FinTM.FwdMapState✝ M.State) x),
  ¬Turing.FinTM.fwdMapEntered✝ M c → Turing.MultiTapeTM.step c = Turing.MultiTapeTM.step c
