TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.emitterP2_admin_frame|TCSlib.Complexity.TuringMachine.Build.Primitives|kind=theorem|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.emitterP2_admin_frame|∀ {S H : Type}
  (candidate : Bool) (k l : ℕ) (hk : 0 < k) (hl : 0 < l)
  (index : Fin (if candidate = true then 3 else 2) ↪ Fin (k + l + 1)),
  (∀ (i : Fin (if candidate = true then 3 else 2)),
      index i =
        if ↑i = 0 then if candidate = true then 0 else (Turing.FinTM.emitterP2LeftIndex✝ k l) ⟨0, hk⟩
        else
          if candidate = true then
            if ↑i = 1 then (Turing.FinTM.emitterP2LeftIndex✝¹ k l) ⟨0, hk⟩
            else (Turing.FinTM.emitterP2RightIndex✝ k l) ⟨0, hl⟩
          else (Turing.FinTM.emitterP2RightIndex✝¹ k l) ⟨0, hl⟩) →
    ∀ (emb : S → H) (w s u v : List Bool) (q : S),
      Turing.Cfg.mapState emb
          (Turing.embedEmitCfg index
            (if candidate = true then fun x x_1 => none
            else fun i => Turing.FinTM.bufferTape (Turing.FinTM.emitterP2Words✝ k l s [] [] i))
            (fun x => 0) []
            (Turing.Cfg.ofWords q fun i =>
              if candidate = true then if ↑i = 0 then s else if ↑i = 1 then u else v else if ↑i = 0 then u else v)) =
        Turing.Cfg.ofWords (emb q) (Turing.FinTM.emitterP2Words✝¹ k l s u v)
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.emitterP2_bank_frame|TCSlib.Complexity.TuringMachine.Build.Primitives|kind=theorem|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.emitterP2_bank_frame|∀ {S H : Type}
  (right : Bool) (k l : ℕ) (emb : S → H) (w s u v : List Bool) (q : S),
  have index :=
    match right with
    | false => Turing.FinTM.emitterP2LeftIndex✝ k l
    | true => Turing.FinTM.emitterP2RightIndex✝ k l;
  Turing.Cfg.mapState emb
      (Turing.embedEmitCfg index
        (fun i =>
          Turing.FinTM.bufferTape
            (Turing.FinTM.emitterP2Words✝ k l s (if right = true then u else []) (if right = true then [] else v) i))
        (fun x => 0) []
        (Turing.Cfg.ofWords q (Turing.stateWord (if right = true then l else k) (if right = true then v else u)))) =
    Turing.Cfg.ofWords (emb q) (Turing.FinTM.emitterP2Words✝¹ k l s u v)
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.emitterP2_body_erase|TCSlib.Complexity.TuringMachine.Build.Primitives|kind=theorem|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.emitterP2_body_erase|∀ (right : Bool)
  (C D : Turing.FinTM Bool) (hk : 0 < C.k) (hl : 0 < D.k) (ce cx : C.State) (de dx : D.State) (w s u v : List Bool)
  (ok : Bool),
  let B := Turing.FinTM.emitterP2BodyTM✝ C D hk hl ce cx de dx;
  have tag :=
    if right = true then Turing.FinTM.EmitterP2State.eraseRight✝ ok else Turing.FinTM.EmitterP2State.eraseLeft✝ ok;
  ∃ t ≤ 2 * ((if right = true then v else u).length + 1),
    Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords (tag 0) (Turing.FinTM.emitterP2Words✝ C.k D.k s u v)) t =
        Turing.Cfg.ofWords (tag 2)
          (Turing.FinTM.emitterP2Words✝¹ C.k D.k s (if right = true then u else []) (if right = true then [] else v)) ∧
      Turing.FinTM.splitSafe✝ B.tm Turing.FinTM.EmitterP2State.anchor✝
        (Turing.Cfg.ofWords (tag 0) (Turing.FinTM.emitterP2Words✝² C.k D.k s u v)) t
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.emitterP2_body_erase_left|TCSlib.Complexity.TuringMachine.Build.Primitives|kind=theorem|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.emitterP2_body_erase_left|∀
  (C D : Turing.FinTM Bool) (hk : 0 < C.k) (hl : 0 < D.k) (ce cx : C.State) (de dx : D.State) (w s u v : List Bool)
  (ok : Bool),
  let B := Turing.FinTM.emitterP2BodyTM✝ C D hk hl ce cx de dx;
  ∃ t ≤ 2 * (u.length + 1),
    Turing.MultiTapeTM.runFrom
          (Turing.Cfg.ofWords (Turing.FinTM.EmitterP2State.eraseLeft✝ ok 0)
            (Turing.FinTM.emitterP2Words✝ C.k D.k s u v))
          t =
        Turing.Cfg.ofWords (Turing.FinTM.EmitterP2State.eraseLeft✝¹ ok 2)
          (Turing.FinTM.emitterP2Words✝¹ C.k D.k s [] v) ∧
      Turing.FinTM.splitSafe✝ B.tm Turing.FinTM.EmitterP2State.anchor✝
        (Turing.Cfg.ofWords (Turing.FinTM.EmitterP2State.eraseLeft✝² ok 0)
          (Turing.FinTM.emitterP2Words✝² C.k D.k s u v))
        t
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.emitterP2_body_erase_right|TCSlib.Complexity.TuringMachine.Build.Primitives|kind=theorem|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.emitterP2_body_erase_right|∀
  (C D : Turing.FinTM Bool) (hk : 0 < C.k) (hl : 0 < D.k) (ce cx : C.State) (de dx : D.State) (w s u v : List Bool)
  (ok : Bool),
  let B := Turing.FinTM.emitterP2BodyTM✝ C D hk hl ce cx de dx;
  ∃ t ≤ 2 * (v.length + 1),
    Turing.MultiTapeTM.runFrom
          (Turing.Cfg.ofWords (Turing.FinTM.EmitterP2State.eraseRight✝ ok 0)
            (Turing.FinTM.emitterP2Words✝ C.k D.k s u v))
          t =
        Turing.Cfg.ofWords (Turing.FinTM.EmitterP2State.eraseRight✝¹ ok 2)
          (Turing.FinTM.emitterP2Words✝¹ C.k D.k s u []) ∧
      Turing.FinTM.splitSafe✝ B.tm Turing.FinTM.EmitterP2State.anchor✝
        (Turing.Cfg.ofWords (Turing.FinTM.EmitterP2State.eraseRight✝² ok 0)
          (Turing.FinTM.emitterP2Words✝² C.k D.k s u v))
        t
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.emitterP2_index_injective|TCSlib.Complexity.TuringMachine.Build.Primitives|kind=theorem|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.emitterP2_index_injective|∀
  (candidate : Bool) (k l : ℕ) (hk : 0 < k) (hl : 0 < l),
  Function.Injective fun i =>
    if ↑i = 0 then if candidate = true then 0 else (Turing.FinTM.emitterP2LeftIndex✝ k l) ⟨0, hk⟩
    else
      if candidate = true then
        if ↑i = 1 then (Turing.FinTM.emitterP2LeftIndex✝¹ k l) ⟨0, hk⟩
        else (Turing.FinTM.emitterP2RightIndex✝ k l) ⟨0, hl⟩
      else (Turing.FinTM.emitterP2RightIndex✝¹ k l) ⟨0, hl⟩
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.emitterP2_left_frame|TCSlib.Complexity.TuringMachine.Build.Primitives|kind=theorem|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.emitterP2_left_frame|∀ {S H : Type}
  (k l : ℕ) (emb : S → H) (w s u v : List Bool) (q : S),
  Turing.Cfg.mapState emb
      (Turing.embedEmitCfg (Turing.FinTM.emitterP2LeftIndex✝ k l)
        (fun i => Turing.FinTM.bufferTape (Turing.FinTM.emitterP2Words✝ k l s [] v i)) (fun x => 0) []
        (Turing.Cfg.ofWords q (Turing.stateWord k u))) =
    Turing.Cfg.ofWords (emb q) (Turing.FinTM.emitterP2Words✝¹ k l s u v)
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.emitterP2_pair_frame|TCSlib.Complexity.TuringMachine.Build.Primitives|kind=theorem|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.emitterP2_pair_frame|∀ {H : Type}
  (k l : ℕ) (hk : 0 < k) (hl : 0 < l) (emb : Fin 3 × Bool → H) (w s u v : List Bool) (q : Fin 3) (b : Bool),
  Turing.Cfg.mapState emb
      (Turing.embedEmitCfg (Turing.FinTM.emitterP2PairIndex✝ k l hk hl)
        (fun i => Turing.FinTM.bufferTape (Turing.FinTM.emitterP2Words✝ k l s [] [] i)) (fun x => 0) []
        (Turing.FinTM.emitterCompareCfg✝ w u v 1 q b 0)) =
    Turing.Cfg.ofWords (emb (q, b)) (Turing.FinTM.emitterP2Words✝¹ k l s u v)
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.emitterP2_prepare_rewind_bank|TCSlib.Complexity.TuringMachine.Build.Primitives|kind=theorem|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.emitterP2_prepare_rewind_bank|∀
  (candidate : Bool) (w s v : List Bool) (over : Bool) (p : Fin (w.length + 2)) (other : ℤ),
  ∀ j ≤ (if candidate = true then s else v).length,
    Turing.MultiTapeTM.runFrom
        (Turing.FinTM.emitterP2PrepareCfg✝ w s s v (if candidate = true then 3 else 5) over p
          (if candidate = true then ↑j - 1 else other) (if candidate = true then other else ↑j - 1))
        (j + 1) =
      Turing.FinTM.emitterP2PrepareCfg✝¹ w s s v (if candidate = true then 4 else 6) over p
        (if candidate = true then 0 else other) (if candidate = true then other else 0)
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.emitterP2_prepare_rewind_candidate|TCSlib.Complexity.TuringMachine.Build.Primitives|kind=theorem|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.emitterP2_prepare_rewind_candidate|∀
  (w s v : List Bool) (over : Bool) (p : Fin (w.length + 2)) (b : ℤ),
  ∀ j ≤ s.length,
    Turing.MultiTapeTM.runFrom (Turing.FinTM.emitterP2PrepareCfg✝ w s s v 3 over p (↑j - 1) b) (j + 1) =
      Turing.FinTM.emitterP2PrepareCfg✝¹ w s s v 4 over p 0 b
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.emitterP2_prepare_rewind_suffix|TCSlib.Complexity.TuringMachine.Build.Primitives|kind=theorem|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.emitterP2_prepare_rewind_suffix|∀
  (w s v : List Bool) (over : Bool) (p : Fin (w.length + 2)),
  ∀ j ≤ v.length,
    Turing.MultiTapeTM.runFrom (Turing.FinTM.emitterP2PrepareCfg✝ w s s v 5 over p 0 (↑j - 1)) (j + 1) =
      Turing.FinTM.emitterP2PrepareCfg✝¹ w s s v 6 over p 0 0
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.emitterP2_right_frame|TCSlib.Complexity.TuringMachine.Build.Primitives|kind=theorem|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.emitterP2_right_frame|∀ {S H : Type}
  (k l : ℕ) (emb : S → H) (w s u v : List Bool) (q : S),
  Turing.Cfg.mapState emb
      (Turing.embedEmitCfg (Turing.FinTM.emitterP2RightIndex✝ k l)
        (fun i => Turing.FinTM.bufferTape (Turing.FinTM.emitterP2Words✝ k l s u [] i)) (fun x => 0) []
        (Turing.Cfg.ofWords q (Turing.stateWord l v))) =
    Turing.Cfg.ofWords (emb q) (Turing.FinTM.emitterP2Words✝¹ k l s u v)
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.emitterP2_small_frame|TCSlib.Complexity.TuringMachine.Build.Primitives|kind=theorem|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.emitterP2_small_frame|∀ {H : Type}
  (k l : ℕ) (hk : 0 < k) (hl : 0 < l) (emb : Fin 9 × Bool → H) (w s u v : List Bool) (q : Fin 9) (over : Bool),
  Turing.Cfg.mapState emb
      (Turing.embedEmitCfg (Turing.FinTM.emitterP2SmallIndex✝ k l hk hl) (fun x x_1 => none) (fun x => 0) []
        (Turing.FinTM.emitterP2PrepareCfg✝ w s u v q over 1 0 0)) =
    Turing.Cfg.ofWords (emb (q, over)) (Turing.FinTM.emitterP2Words✝ k l s u v)
