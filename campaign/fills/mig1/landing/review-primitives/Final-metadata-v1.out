  (w : List Bool),
  List.find? (fun i => Turing.FinTM.emitterSplitAccept✝ f w ((Turing.FinTM.splitStep✝ w)^[i] []))
      (List.range (w.length + 1)) =
    Turing.solveSplitWith f w.length
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.extract_replay|TCSlib.Complexity.TuringMachine.Build.Primitives|kind=theorem|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.extract_replay|∀ (first second : Bool)
  (x a : List Bool) (i : ℕ) (hi : i ≤ x.length),
  ∀ j ≤ a.length,
    Turing.MultiTapeTM.runFrom (Turing.FinTM.extractCfg✝ x (some (Sum.inr 1)) i hi a 0 []) j =
      Turing.FinTM.extractCfg✝¹ x (some (Sum.inr 1)) i hi a (↑j) (if first = true then List.take j a else [])
