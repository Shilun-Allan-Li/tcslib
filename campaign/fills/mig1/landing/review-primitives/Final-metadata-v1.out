TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.fwdMapStateFintype|(Q : Type) →
  [Fintype Q] → Fintype (Turing.FinTM.FwdMapState✝ Q)
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.fwdMapTM|TCSlib.Complexity.TuringMachine.Build.Primitives|kind=definition|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.fwdMapTM|Turing.FinTM Bool →
  Bool → Turing.FinTM Bool
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.fwdMapVirtual|TCSlib.Complexity.TuringMachine.Build.Primitives|kind=definition|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.fwdMapVirtual|(M : Turing.FinTM Bool) →
  {x y : List Bool} →
    Turing.Cfg M.k Bool M.State y →
      Bool →
        Fin (x.length + 2) →
          List Bool → List Bool → Turing.Cfg (1 + (1 + M.k)) Bool (Turing.FinTM.FwdMapState✝ M.State) x
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.fwdMapVirtual_run|TCSlib.Complexity.TuringMachine.Build.Primitives|kind=theorem|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.fwdMapVirtual_run|∀
  (M : Turing.FinTM Bool) {x y : List Bool} (c : Turing.Cfg M.k Bool M.State y) (tag : Bool),
  Turing.FinTM.VirtualTag c.inputPos tag →
    ∀ (p : Fin (x.length + 2)) (a pre : List Bool) (t : ℕ),
      ∃ tag',
        Turing.FinTM.VirtualTag (Turing.MultiTapeTM.runFrom c t).inputPos tag' ∧
          Turing.MultiTapeTM.runFrom (Turing.FinTM.fwdMapVirtual✝ M c tag p a pre) t =
            Turing.FinTM.fwdMapVirtual✝¹ M (Turing.MultiTapeTM.runFrom c t) tag' p a pre
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.fwdMapVirtual_step|TCSlib.Complexity.TuringMachine.Build.Primitives|kind=theorem|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.fwdMapVirtual_step|∀
  (M : Turing.FinTM Bool) {x y : List Bool} (c : Turing.Cfg M.k Bool M.State y) (tag : Bool),
  Turing.FinTM.VirtualTag c.inputPos tag →
    ∀ (p : Fin (x.length + 2)) (a pre : List Bool),
      ∃ tag',
        Turing.FinTM.VirtualTag (Turing.MultiTapeTM.step c).inputPos tag' ∧
          Turing.MultiTapeTM.step (Turing.FinTM.fwdMapVirtual✝ M c tag p a pre) =
            Turing.FinTM.fwdMapVirtual✝¹ M (Turing.MultiTapeTM.step c) tag' p a pre
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.fwdMap_backA|TCSlib.Complexity.TuringMachine.Build.Primitives|kind=theorem|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.fwdMap_backA|∀ (M : Turing.FinTM Bool)
  (x a b : List Bool) (p : Fin (x.length + 2)),
  ∀ j ≤ a.length,
    Turing.MultiTapeTM.runFrom (Turing.FinTM.fwdMapCfg✝ M x (some Turing.FinTM.FwdMapState.backA✝) p a b (↑j - 1) 0 [])
        (j + 1) =
      Turing.FinTM.fwdMapCfg✝¹ M x (some Turing.FinTM.FwdMapState.emitA✝) p a b 0 0 []
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.fwdMap_backB|TCSlib.Complexity.TuringMachine.Build.Primitives|kind=theorem|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.fwdMap_backB|∀ (M : Turing.FinTM Bool)
  (x a b : List Bool) (p : Fin (x.length + 2)),
  ∀ j ≤ b.length,
    Turing.MultiTapeTM.runFrom
        (Turing.FinTM.fwdMapCfg✝ M x (some Turing.FinTM.FwdMapState.backB✝) p a b (↑a.length - 1) (↑j - 1) []) (j + 1) =
      Turing.FinTM.fwdMapCfg✝¹ M x (some Turing.FinTM.FwdMapState.backA✝) p a b (↑a.length - 1) 0 []
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.fwdMap_block|TCSlib.Complexity.TuringMachine.Build.Primitives|kind=theorem|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.fwdMap_block|∀ (M : Turing.FinTM Bool)
  (x pre rest a : List Bool) (b c : Bool) (hx : x = pre ++ b :: c :: rest),
  Turing.MultiTapeTM.runFrom
      (Turing.FinTM.fwdMapCfg✝ M x (some (Turing.FinTM.FwdMapState.parse✝ none)) ⟨pre.length + 1, ⋯⟩ a [] (↑a.length) 0
        [])
      2 =
    if b = c then
      Turing.FinTM.fwdMapCfg✝¹ M x (some (Turing.FinTM.FwdMapState.parse✝¹ none)) ⟨pre.length + 3, ⋯⟩ (a ++ [b]) []
        (↑(a ++ [b]).length) 0 []
    else
      if b = true then Turing.FinTM.fwdMapCfg✝² M x none ⟨pre.length + 3, ⋯⟩ a [] (↑a.length) 0 []
      else
        Turing.FinTM.fwdMapCfg✝³ M x (some Turing.FinTM.FwdMapState.copyB✝) ⟨pre.length + 3, ⋯⟩ a [] (↑a.length - 1) 0
          []
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.fwdMap_emit|TCSlib.Complexity.TuringMachine.Build.Primitives|kind=theorem|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.fwdMap_emit|∀ (M : Turing.FinTM Bool)
  (x a b rest : List Bool) (p : Fin (x.length + 2)) (pre out : List Bool),
  a = pre ++ rest →
    Turing.MultiTapeTM.runFrom
        (Turing.FinTM.fwdMapCfg✝ M x (some Turing.FinTM.FwdMapState.emitA✝) p a b (↑pre.length) 0 out)
        (2 * rest.length + 2) =
      Turing.FinTM.fwdMapCfg✝¹ M x (some (Turing.FinTM.FwdMapState.run✝ M.tm.q₀ true)) p a b (↑a.length) 0
        (out ++ List.flatMap (fun d => [d, d]) rest ++ [false, true])
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.fwdMap_finish|TCSlib.Complexity.TuringMachine.Build.Primitives|kind=theorem|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.fwdMap_finish|∀ (M : Turing.FinTM Bool)
  (x pre a b : List Bool) (hx : x = pre ++ b),
  Turing.MultiTapeTM.runFrom
      (Turing.FinTM.fwdMapCfg✝ M x (some Turing.FinTM.FwdMapState.copyB✝) ⟨pre.length + 1, ⋯⟩ a [] (↑a.length - 1) 0 [])
      (3 * a.length + 2 * b.length + 5) =
    Turing.FinTM.fwdMapVirtual✝ M (Turing.MultiTapeTM.initCfg b) true ⟨x.length + 1, ⋯⟩ a (Turing.pairEncode a [])
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.fwdMap_first|TCSlib.Complexity.TuringMachine.Build.Primitives|kind=theorem|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.fwdMap_first|∀ (M : Turing.FinTM Bool)
  (x pre rest a : List Bool) (b : Bool) (hx : x = pre ++ b :: rest),
  Turing.MultiTapeTM.step
      (Turing.FinTM.fwdMapCfg✝ M x (some (Turing.FinTM.FwdMapState.parse✝ none)) ⟨pre.length + 1, ⋯⟩ a [] (↑a.length) 0
        []) =
    Turing.FinTM.fwdMapCfg✝¹ M x (some (Turing.FinTM.FwdMapState.parse✝¹ (some b))) ⟨pre.length + 2, ⋯⟩ a [] (↑a.length)
      0 []
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.fwdMap_launch|TCSlib.Complexity.TuringMachine.Build.Primitives|kind=theorem|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.fwdMap_launch|∀ (M : Turing.FinTM Bool)
  (x a b : List Bool),
  Turing.pairDecode x = some (a, b) →
    ∃ u ≤ 5 * (x.length + 1),
      Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) u =
          Turing.FinTM.fwdMapVirtual✝ M (Turing.MultiTapeTM.initCfg b) true ⟨x.length + 1, ⋯⟩ a
            (Turing.pairEncode a []) ∧
        ∀ v ≤ u,
          Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) v =
            Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) v
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.fwdMap_move|TCSlib.Complexity.TuringMachine.Build.Primitives|kind=theorem|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.fwdMap_move|∀ (M : Turing.FinTM Bool)
  (x : List Bool) (q q' : Option (Turing.FinTM.FwdMapState✝ M.State)) (p : Fin (x.length + 2)) (a b : List Bool)
  (ha hb : ℤ) (out : List Bool) (mi ma mb : SignType) (emit : Option Bool),
  (Turing.FinTM.fwdMapAct✝ M mi (none, ma) (none, mb) emit q').apply (Turing.FinTM.fwdMapCfg✝ M x q p a b ha hb out) =
    Turing.FinTM.fwdMapCfg✝¹ M x q' (Turing.moveInputPos p mi) a b (ha + ↑ma) (hb + ↑mb) (out ++ emit.toList)
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.fwdMap_parse|TCSlib.Complexity.TuringMachine.Build.Primitives|kind=theorem|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.fwdMap_parse|∀ (M : Turing.FinTM Bool)
  (x rest pre a : List Bool) (hx : x = pre ++ rest),
  ∃ t ≤ 3 * rest.length + 3 * a.length + 5,
    match Turing.pairDecode rest with
    | some (d, b) =>
      Turing.MultiTapeTM.runFrom
          (Turing.FinTM.fwdMapCfg✝ M x (some (Turing.FinTM.FwdMapState.parse✝ none)) ⟨pre.length + 1, ⋯⟩ a []
            (↑a.length) 0 [])
          t =
        Turing.FinTM.fwdMapVirtual✝ M (Turing.MultiTapeTM.initCfg b) true ⟨x.length + 1, ⋯⟩ (a ++ d)
          (Turing.pairEncode (a ++ d) [])
    | none =>
      (Turing.MultiTapeTM.runFrom
              (Turing.FinTM.fwdMapCfg✝¹ M x (some (Turing.FinTM.FwdMapState.parse✝¹ none)) ⟨pre.length + 1, ⋯⟩ a []
                (↑a.length) 0 [])
              t).state =
          none ∧
        (Turing.MultiTapeTM.runFrom
              (Turing.FinTM.fwdMapCfg✝² M x (some (Turing.FinTM.FwdMapState.parse✝² none)) ⟨pre.length + 1, ⋯⟩ a []
                (↑a.length) 0 [])
              t).output =
          []
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.fwdMap_reject|TCSlib.Complexity.TuringMachine.Build.Primitives|kind=theorem|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.fwdMap_reject|∀ (M : Turing.FinTM Bool)
  (x : List Bool),
  Turing.pairDecode x = none →
    ∃ u ≤ 5 * (x.length + 1),
      (Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) u).state = none ∧
        (Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) u).output = [] ∧
          ∀ (v : ℕ),
            Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) v =
              Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) v
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.fwdMap_setup|TCSlib.Complexity.TuringMachine.Build.Primitives|kind=theorem|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.fwdMap_setup|∀ (M : Turing.FinTM Bool)
  (x : List Bool),
  ∃ t ≤ 5 * (x.length + 1),
    match Turing.pairDecode x with
    | some (a, b) =>
      Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) t =
        Turing.FinTM.fwdMapVirtual✝ M (Turing.MultiTapeTM.initCfg b) true ⟨x.length + 1, ⋯⟩ a (Turing.pairEncode a [])
    | none =>
      (Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) t).state = none ∧
        (Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) t).output = []
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.fwdMap_space|TCSlib.Complexity.TuringMachine.Build.Primitives|kind=theorem|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.fwdMap_space|∀ (M : Turing.FinTM Bool)
  (x y : List Bool) (t D S : ℕ),
  (∀ u ≤ t,
      -↑D ≤ (Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) u).workTapePos (Fin.castAdd (1 + M.k) 0) ∧
        (Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) u).workTapePos (Fin.castAdd (1 + M.k) 0) ≤ ↑D) →
    (∀ u ≤ t,
        -↑D ≤
            (Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) u).workTapePos
              (Fin.natAdd 1 (Fin.castAdd M.k 0)) ∧
          (Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) u).workTapePos (Fin.natAdd 1 (Fin.castAdd M.k 0)) ≤
            ↑D) →
      (∀ (i : Fin M.k),
          Turing.MultiTapeTM.visitedByTapeHead (Turing.MultiTapeTM.initCfg x) t (Fin.natAdd 1 (Fin.natAdd 1 i)) ⊆
            Turing.MultiTapeTM.visitedByTapeHead (Turing.MultiTapeTM.initCfg y) t i) →
        Turing.MultiTapeTM.spaceUsed (Turing.MultiTapeTM.initCfg y) t ≤ S →
          Turing.MultiTapeTM.spaceUsed (Turing.MultiTapeTM.initCfg x) t ≤ S + 2 * (2 * D + 1)
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.fwdMap_suffix|TCSlib.Complexity.TuringMachine.Build.Primitives|kind=theorem|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.fwdMap_suffix|∀ (M : Turing.FinTM Bool)
  (x rest a pre b : List Bool) (hx : x = pre ++ rest),
  Turing.MultiTapeTM.runFrom
      (Turing.FinTM.fwdMapCfg✝ M x (some Turing.FinTM.FwdMapState.copyB✝) ⟨pre.length + 1, ⋯⟩ a b (↑a.length - 1)
        ↑b.length [])
      (rest.length + 1) =
    Turing.FinTM.fwdMapCfg✝¹ M x (some Turing.FinTM.FwdMapState.backB✝) ⟨x.length + 1, ⋯⟩ a (b ++ rest) (↑a.length - 1)
      (↑(b ++ rest).length - 1) []
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.polyHeads|TCSlib.Complexity.TuringMachine.Build.Primitives|kind=definition|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.polyHeads|{d C : ℕ} →
  ℕ → Option (Turing.FinTM.CatalogPolyControl✝ d C) → (Fin (d + 1) → ℤ) → Prop
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.polyHeads_bounds|TCSlib.Complexity.TuringMachine.Build.Primitives|kind=theorem|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.polyHeads_bounds|∀ {d C q : ℕ}
  {s : Option (Turing.FinTM.CatalogPolyControl✝ d C)} {h : Fin (d + 1) → ℤ},
  Turing.FinTM.polyHeads✝ q s h → ∀ (j : Fin (d + 1)), -1 ≤ h j ∧ h j ≤ ↑q
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.poly_space|TCSlib.Complexity.TuringMachine.Build.Primitives|kind=theorem|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.poly_space|∀ (d C : ℕ) (x : List Bool)
  (t : ℕ), Turing.MultiTapeTM.spaceUsed (Turing.MultiTapeTM.initCfg x) t ≤ 5 * (d + 1) * (x.length + 1)
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.poly_step|TCSlib.Complexity.TuringMachine.Build.Primitives|kind=theorem|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.poly_step|∀ {d C q : ℕ} {x : List Bool},
  0 < q →
    ∀ (c : Turing.Cfg (d + 1) Bool (Turing.FinTM.CatalogPolyControl✝ d C) x),
      (c.workTapes = fun x => Turing.FinTM.catalogPolyTape✝ q) →
        Turing.FinTM.polyHeads✝ q c.state c.workTapePos →
          ((Turing.MultiTapeTM.step c).workTapes = fun x => Turing.FinTM.catalogPolyTape✝¹ q) ∧
            Turing.FinTM.polyHeads✝¹ q (Turing.MultiTapeTM.step c).state (Turing.MultiTapeTM.step c).workTapePos
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.rawStrip_replay|TCSlib.Complexity.TuringMachine.Build.Primitives|kind=theorem|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.rawStrip_replay|∀ (x a : List Bool)
  (i : ℕ) (hi : i ≤ x.length),
  ∀ j ≤ a.length,
    Turing.MultiTapeTM.runFrom (Turing.FinTM.stripCfg✝ x (some 3) i hi a 0 []) j =
      Turing.FinTM.stripCfg✝¹ x (some 3) i hi a (↑j) (List.take j a)
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.splitFind_eq|TCSlib.Complexity.TuringMachine.Build.Primitives|kind=theorem|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.splitFind_eq|∀ (C e : ℕ) (w : List Bool),
  List.find? (fun i => Turing.FinTM.splitAccept✝ C e w ((Turing.FinTM.splitStep✝ w)^[i] []))
      (List.range (w.length + 1)) =
    Turing.solveSplit C e w.length
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.splitOrbit_find|TCSlib.Complexity.TuringMachine.Build.Primitives|kind=theorem|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.splitOrbit_find|∀ (w : List Bool)
  (accept : List Bool → Bool) (p : ℕ → Bool),
  (∀ (s : List Bool), accept s = p s.length) →
    List.find? (fun i => accept ((Turing.FinTM.splitStep✝ w)^[i] [])) (List.range (w.length + 1)) =
      List.find? p (List.range (w.length + 1))
