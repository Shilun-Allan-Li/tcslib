TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.fwdMapCfg_read|∀ (M : Turing.FinTM Bool)
  (x : List Bool) (q : Option (Turing.FinTM.FwdMapState✝ M.State)) (i : ℕ) (hi : i ≤ x.length) (a b : List Bool)
  (ha hb : ℤ) (out : List Bool), (Turing.FinTM.fwdMapCfg✝ M x q ⟨i + 1, ⋯⟩ a b ha hb out).inputSymbol = x[i]?
