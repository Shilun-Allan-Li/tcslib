TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.bufferReplay_run|TCSlib.Complexity.TuringMachine.Build.Primitives|kind=theorem|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.bufferReplay_run|∀ {S : Type}
  {x : List Bool} (tm : Turing.MultiTapeTM 1 Bool S) (q : S) (emit : Bool),
  (∀ (inp : Option Bool) (bit : Bool),
      (tm.tr q inp fun x => some bit) =
        { inputTape := 0, workTapes := fun x => (none, SignType.pos), output := if emit = true then some bit else none,
          state := some q }) →
    ∀ (p : Fin (x.length + 2)) (a : List Bool),
      ∀ j ≤ a.length,
        Turing.MultiTapeTM.runFrom
            { state := some q, inputPos := p, workTapes := fun x => Turing.FinTM.bufferTape a,
              workTapePos := fun x => 0, output := [] }
            j =
          { state := some q, inputPos := p, workTapes := fun x => Turing.FinTM.bufferTape a, workTapePos := fun x => ↑j,
            output := if emit = true then List.take j a else [] }
