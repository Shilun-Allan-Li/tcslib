TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.fwdMapSetup_head_step|∀
  (M : Turing.FinTM Bool) {x : List Bool} (c : Turing.Cfg (1 + (1 + M.k)) Bool (Turing.FinTM.FwdMapState✝ M.State) x)
  (i : Fin M.k),
  (Turing.MultiTapeTM.step c).workTapePos (Fin.natAdd 1 (Fin.natAdd 1 i)) =
    c.workTapePos (Fin.natAdd 1 (Fin.natAdd 1 i))
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.fwdMapSetup_heads|TCSlib.Complexity.TuringMachine.Build.Primitives|kind=theorem|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.fwdMapSetup_heads|∀
  (M : Turing.FinTM Bool) (x : List Bool) (t : ℕ) (i : Fin M.k),
  (Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) t).workTapePos (Fin.natAdd 1 (Fin.natAdd 1 i)) = 0
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.fwdMapSetup_run|TCSlib.Complexity.TuringMachine.Build.Primitives|kind=theorem|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.fwdMapSetup_run|∀ (M : Turing.FinTM Bool)
  (x : List Bool) (t : ℕ),
  (∀ u < t, ¬Turing.FinTM.fwdMapEntered✝ M (Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) u)) →
    Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) t =
      Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) t
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Primitives.0.Turing.FinTM.fwdMapSetup_stationary|TCSlib.Complexity.TuringMachine.Build.Primitives|kind=theorem|private=true|internal=true|simp=false|unfold=false
