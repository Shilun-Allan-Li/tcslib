TARGET|Turing.FinTM.computesFunInTime_comp|TCSlib.Complexity.TuringMachine.Composition|private=false|internal=false|simp=false|unfold=false
TYPE|Turing.FinTM.computesFunInTime_comp|∀ {M₁ M₂ : Turing.FinTM Bool} {f g : List Bool → List Bool} {T₁ T₂ : ℕ → ℕ},
  M₁.ComputesFunInTime f T₁ →
    M₂.ComputesFunInTime g T₂ → Monotone T₂ → ∃ M c, M.ComputesFunInTime (g ∘ f) fun n => c * (T₁ n + T₂ (T₁ n) + 1)
TARGET|Turing.FinTM.computesFunInTime_cond|TCSlib.Complexity.TuringMachine.Build.Wrappers|private=false|internal=false|simp=false|unfold=false
TYPE|Turing.FinTM.computesFunInTime_cond|∀ {D M₁ M₂ : Turing.FinTM Bool} {p : List Bool → Bool}
  {f₁ f₂ : List Bool → List Bool} {T₀ T₁ T₂ : ℕ → ℕ},
  D.ComputesFunInTime (fun x => [p x]) T₀ →
    M₁.ComputesFunInTime f₁ T₁ →
      M₂.ComputesFunInTime f₂ T₂ →
        ∃ M c,
          M.ComputesFunInTime (fun x => if p x = true then f₁ x else f₂ x) fun n => c * (T₀ n + max (T₁ n) (T₂ n) + 1)
TARGET|Turing.FinTM.computesFunInTime_id|TCSlib.Complexity.TuringMachine.Composition|private=false|internal=false|simp=false|unfold=false
TYPE|Turing.FinTM.computesFunInTime_id|∃ M c, M.ComputesFunInTime id fun n => c * (n + 1)
TARGET|Turing.FinTM.computesFunInTime_ifEq|TCSlib.Complexity.TuringMachine.Composition|private=false|internal=false|simp=false|unfold=false
TYPE|Turing.FinTM.computesFunInTime_ifEq|∀ (w₀ u v : List Bool),
  ∃ M c, M.ComputesFunInTime (fun w => if w = w₀ then u else v) fun n => c * (n + 1)
TARGET|Turing.FinTM.condTM_computes_iff|TCSlib.Complexity.TuringMachine.Composition|private=false|internal=false|simp=false|unfold=false
TYPE|Turing.FinTM.condTM_computes_iff|∀ (D M₁ M₂ : Turing.FinTM Bool) (p : List Bool → Bool),
  (D.Computes fun x => [p x]) →
    ∀ (x w : List Bool),
      (∃ t, (D.condTM M₁ M₂).ComputesInTime x w t) ↔ ∃ t, (bif p x then M₁ else M₂).ComputesInTime x w t
TARGET|Turing.FinTM.emitLoopTM_computes|TCSlib.Complexity.TuringMachine.Build.Loop|private=false|internal=false|simp=false|unfold=false
TYPE|Turing.FinTM.emitLoopTM_computes|∀ (body F : Turing.FinTM Bool) (anchor : body.State)
  (Inv : List Bool → List Bool → Prop) (stepF emitF : List Bool → List Bool → List Bool) (s0 : List Bool → List Bool)
  (R T : ℕ → ℕ),
  F.ComputesFunInTime (fun x => (R x.length).bits) T →
    (∀ (x : List Bool), Inv x (s0 x)) →
      (∀ (x s : List Bool), Inv x s → Inv x (stepF x s)) →
        (∀ (x : List Bool),
            ∃ t ≤ T x.length,
              (∀ t' < t, (Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) t').state ≠ some anchor) ∧
                Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) t =
                  Turing.Cfg.ofWords anchor (Turing.stateWord body.k (s0 x))) →
          (∀ (x s : List Bool),
              Inv x s →
                ∃ t,
                  0 < t ∧
                    t ≤ T x.length ∧
                      (∀ (t' : ℕ),
                          0 < t' →
                            t' < t →
                              (Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords anchor (Turing.stateWord body.k s))
                                    t').state ≠
                                some anchor) ∧
                        Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords anchor (Turing.stateWord body.k s)) t =
                          have __src := Turing.Cfg.ofWords anchor (Turing.stateWord body.k (stepF x s));
                          { state := __src.state, inputPos := __src.inputPos, workTapes := __src.workTapes,
                            workTapePos := __src.workTapePos, output := emitF x s }) →
            (body.emitLoopTM F anchor).ComputesFunInTime
              (fun x => List.flatMap (fun i => emitF x ((stepF x)^[i] (s0 x))) (List.range (R x.length + 1))) fun n =>
              10 * (T n + 1) * (R n + 2)
TARGET|Turing.FinTM.exists_comp_on_image|TCSlib.Complexity.TuringMachine.Composition|private=false|internal=false|simp=false|unfold=false
TYPE|Turing.FinTM.exists_comp_on_image|∀ (M U : Turing.FinTM Bool) (f g : List Bool → List Bool) (T₁ T₂ : ℕ → ℕ),
  M.ComputesFunInTime f T₁ →
    (∀ (x : List Bool), U.ComputesInTime (f x) (g x) (T₂ x.length)) →
      ∃ N, N.ComputesFunInTime g fun n => 2 * T₁ n + T₂ n + 2
TARGET|Turing.FinTM.exists_comp_partial|TCSlib.Complexity.TuringMachine.Composition|private=false|internal=false|simp=false|unfold=false
TYPE|Turing.FinTM.exists_comp_partial|∀ (M₁ M₂ : Turing.FinTM Bool),
  ∃ M,
    ∀ (x w : List Bool),
      (∃ t, M.ComputesInTime x w t) ↔ ∃ y, (∃ t, M₁.ComputesInTime x y t) ∧ ∃ t, M₂.ComputesInTime y w t
TARGET|Turing.FinTM.exists_cond|TCSlib.Complexity.TuringMachine.Composition|private=false|internal=false|simp=false|unfold=false
TYPE|Turing.FinTM.exists_cond|∀ (D M₁ M₂ : Turing.FinTM Bool) (p : List Bool → Bool),
  (D.Computes fun x => [p x]) →
    ∃ M, ∀ (x w : List Bool), (∃ t, M.ComputesInTime x w t) ↔ ∃ t, (bif p x then M₁ else M₂).ComputesInTime x w t
TARGET|Turing.FinTM.exists_emitLoopTM|TCSlib.Complexity.TuringMachine.Build.Loop|private=false|internal=false|simp=false|unfold=false
TYPE|Turing.FinTM.exists_emitLoopTM|∀ (body F : Turing.FinTM Bool) (anchor : body.State)
  (Inv : List Bool → List Bool → Prop) (stepF emitF : List Bool → List Bool → List Bool) (s0 : List Bool → List Bool)
  (R T : ℕ → ℕ),
  F.ComputesFunInTime (fun x => (R x.length).bits) T →
    (∀ (x : List Bool), Inv x (s0 x)) →
      (∀ (x s : List Bool), Inv x s → Inv x (stepF x s)) →
        (∀ (x : List Bool),
            ∃ t ≤ T x.length,
              (∀ t' < t, (Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) t').state ≠ some anchor) ∧
                Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) t =
                  Turing.Cfg.ofWords anchor (Turing.stateWord body.k (s0 x))) →
          (∀ (x s : List Bool),
              Inv x s →
                ∃ t,
                  0 < t ∧
                    t ≤ T x.length ∧
                      (∀ (t' : ℕ),
                          0 < t' →
                            t' < t →
                              (Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords anchor (Turing.stateWord body.k s))
                                    t').state ≠
                                some anchor) ∧
                        Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords anchor (Turing.stateWord body.k s)) t =
                          have __src := Turing.Cfg.ofWords anchor (Turing.stateWord body.k (stepF x s));
                          { state := __src.state, inputPos := __src.inputPos, workTapes := __src.workTapes,
                            workTapePos := __src.workTapePos, output := emitF x s }) →
            ∃ E c,
              E.ComputesFunInTime
                (fun x => List.flatMap (fun i => emitF x ((stepF x)^[i] (s0 x))) (List.range (R x.length + 1))) fun n =>
                c * (T n + 1) * (R n + 2)
TARGET|Turing.FinTM.exists_loopCfgTM|TCSlib.Complexity.TuringMachine.Build.Loop|private=false|internal=false|simp=false|unfold=false
TYPE|Turing.FinTM.exists_loopCfgTM|∀ (body F : Turing.FinTM Bool) (anchor : body.State)
  (Inv : List Bool → List Bool → Prop) (stepF : List Bool → List Bool → List Bool)
  (acceptF : List Bool → List Bool → Bool) (s0 : List Bool → List Bool) (R T : ℕ → ℕ),
  F.ComputesFunInTime (fun x => (R x.length).bits) T →
    (∀ (x : List Bool), Inv x (s0 x)) →
      (∀ (x s : List Bool), Inv x s → Inv x (stepF x s)) →
        (∀ (x : List Bool),
            ∃ t ≤ T x.length,
              (∀ t' < t, (Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) t').state ≠ some anchor) ∧
                Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) t =
                  Turing.Cfg.ofWords anchor (Turing.stateWord body.k (s0 x))) →
          (∀ (x s : List Bool),
              Inv x s →
                ∃ t,
                  0 < t ∧
                    t ≤ T x.length ∧
                      (∀ (t' : ℕ),
                          0 < t' →
                            t' < t →
                              (Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords anchor (Turing.stateWord body.k s))
                                    t').state ≠
                                some anchor) ∧
                        if acceptF x s = true then
                          (Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords anchor (Turing.stateWord body.k s)) t).state =
                              none ∧
                            (Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords anchor (Turing.stateWord body.k s))
                                  t).output =
                              [true]
                        else
                          Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords anchor (Turing.stateWord body.k s)) t =
                            Turing.Cfg.ofWords anchor (Turing.stateWord body.k (stepF x s))) →
            ∃ E c,
              ∀ (x : List Bool),
                ∃ cfg,
                  ∃ startup ≤ c * (T x.length + 1),
                    Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) startup = cfg 0 ∧
                      (∀ i ≤ R x.length, (cfg i).output = []) ∧
                        (cfg (R x.length + 1)).state = none ∧
                          (cfg (R x.length + 1)).output = [false] ∧
                            ∀ i ≤ R x.length,
                              ∃ t ≤ c * (T x.length + 1),
                                if acceptF x ((stepF x)^[i] (s0 x)) = true then
                                  (Turing.MultiTapeTM.runFrom (cfg i) t).state = none ∧
                                    (Turing.MultiTapeTM.runFrom (cfg i) t).output = [true]
                                else Turing.MultiTapeTM.runFrom (cfg i) t = cfg (i + 1)
TARGET|Turing.FinTM.exists_loopFindTM|TCSlib.Complexity.TuringMachine.Build.Loop|private=false|internal=false|simp=false|unfold=false
TYPE|Turing.FinTM.exists_loopFindTM|∀ (body F : Turing.FinTM Bool) (anchor : body.State)
  (Inv : List Bool → List Bool → Prop) (stepF : List Bool → List Bool → List Bool)
  (acceptF : List Bool → List Bool → Bool) (out : List Bool → List Bool → List Bool) (s0 : List Bool → List Bool)
  (R T : ℕ → ℕ),
  F.ComputesFunInTime (fun x => (R x.length).bits) T →
    (∀ (x : List Bool), Inv x (s0 x)) →
      (∀ (x s : List Bool), Inv x s → Inv x (stepF x s)) →
        (∀ (x : List Bool),
            ∃ t ≤ T x.length,
              (∀ t' < t, (Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) t').state ≠ some anchor) ∧
                Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) t =
                  Turing.Cfg.ofWords anchor (Turing.stateWord body.k (s0 x))) →
          (∀ (x s : List Bool),
              Inv x s →
                ∃ t,
                  0 < t ∧
                    t ≤ T x.length ∧
                      (∀ (t' : ℕ),
                          0 < t' →
                            t' < t →
                              (Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords anchor (Turing.stateWord body.k s))
                                    t').state ≠
                                some anchor) ∧
                        if acceptF x s = true then
                          (Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords anchor (Turing.stateWord body.k s)) t).state =
                              none ∧
                            (Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords anchor (Turing.stateWord body.k s))
                                  t).output =
                              out x s
                        else
                          Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords anchor (Turing.stateWord body.k s)) t =
                            Turing.Cfg.ofWords anchor (Turing.stateWord body.k (stepF x s))) →
            ∃ E c,
              E.ComputesFunInTime
                (fun x =>
                  match List.find? (fun i => acceptF x ((stepF x)^[i] (s0 x))) (List.range (R x.length + 1)) with
                  | some i => out x ((stepF x)^[i] (s0 x))
                  | none => [])
                fun n => c * (T n + 1) * (R n + 2)
TARGET|Turing.FinTM.exists_loopTM|TCSlib.Complexity.TuringMachine.Build.Loop|private=false|internal=false|simp=false|unfold=false
TYPE|Turing.FinTM.exists_loopTM|∀ (body F : Turing.FinTM Bool) (anchor : body.State)
  (Inv : List Bool → List Bool → Prop) (stepF : List Bool → List Bool → List Bool)
  (acceptF : List Bool → List Bool → Bool) (s0 : List Bool → List Bool) (R T : ℕ → ℕ),
  F.ComputesFunInTime (fun x => (R x.length).bits) T →
    (∀ (x : List Bool), Inv x (s0 x)) →
      (∀ (x s : List Bool), Inv x s → Inv x (stepF x s)) →
        (∀ (x : List Bool),
            ∃ t ≤ T x.length,
              (∀ t' < t, (Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) t').state ≠ some anchor) ∧
                Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) t =
                  Turing.Cfg.ofWords anchor (Turing.stateWord body.k (s0 x))) →
          (∀ (x s : List Bool),
              Inv x s →
                ∃ t,
                  0 < t ∧
                    t ≤ T x.length ∧
                      (∀ (t' : ℕ),
                          0 < t' →
                            t' < t →
                              (Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords anchor (Turing.stateWord body.k s))
                                    t').state ≠
                                some anchor) ∧
                        if acceptF x s = true then
                          (Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords anchor (Turing.stateWord body.k s)) t).state =
                              none ∧
                            (Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords anchor (Turing.stateWord body.k s))
                                  t).output =
                              [true]
                        else
                          Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords anchor (Turing.stateWord body.k s)) t =
                            Turing.Cfg.ofWords anchor (Turing.stateWord body.k (stepF x s))) →
            ∃ E c,
              E.ComputesFunInTime
                (fun x => [(List.range (R x.length + 1)).any fun i => acceptF x ((stepF x)^[i] (s0 x))]) fun n =>
                c * (T n + 1) * (R n + 2)
TARGET|Turing.FinTM.idTM_computes|TCSlib.Complexity.TuringMachine.Composition|private=false|internal=false|simp=false|unfold=false
TYPE|Turing.FinTM.idTM_computes|∀ (x : List Bool), Turing.FinTM.idTM.ComputesInTime x x (x.length + 1)
TARGET|Turing.FinTM.ifEqTM_computes|TCSlib.Complexity.TuringMachine.Composition|private=false|internal=false|simp=false|unfold=false
TYPE|Turing.FinTM.ifEqTM_computes|∀ (w₀ u v : List Bool),
  (Turing.FinTM.ifEqTM w₀ u v).ComputesFunInTime (fun w => if w = w₀ then u else v) fun n =>
    (w₀.length + max u.length v.length + 3) * (n + 1)
TARGET|Turing.FinTM.loopHostTM_contracts|TCSlib.Complexity.TuringMachine.Build.Loop|private=false|internal=false|simp=false|unfold=false
TYPE|Turing.FinTM.loopHostTM_contracts|∀ (body F : Turing.FinTM Bool) (anchor : body.State)
  (Inv : List Bool → List Bool → Prop) (stepF : List Bool → List Bool → List Bool)
  (acceptF : List Bool → List Bool → Bool) (out : List Bool → List Bool → List Bool) (findMode : Bool)
  (s0 : List Bool → List Bool) (R T : ℕ → ℕ),
  F.ComputesFunInTime (fun x => (R x.length).bits) T →
    (∀ (x : List Bool), Inv x (s0 x)) →
      (∀ (x s : List Bool), Inv x s → Inv x (stepF x s)) →
        (∀ (x : List Bool),
            ∃ t ≤ T x.length,
              (∀ t' < t, (Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) t').state ≠ some anchor) ∧
                Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) t =
                  Turing.Cfg.ofWords anchor (Turing.stateWord body.k (s0 x))) →
          (∀ (x s : List Bool),
              Inv x s →
                ∃ t,
                  0 < t ∧
                    t ≤ T x.length ∧
                      (∀ (t' : ℕ),
                          0 < t' →
                            t' < t →
                              (Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords anchor (Turing.stateWord body.k s))
                                    t').state ≠
                                some anchor) ∧
                        if acceptF x s = true then
                          (Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords anchor (Turing.stateWord body.k s)) t).state =
                              none ∧
                            (Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords anchor (Turing.stateWord body.k s))
                                  t).output =
                              out x s
                        else
                          Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords anchor (Turing.stateWord body.k s)) t =
                            Turing.Cfg.ofWords anchor (Turing.stateWord body.k (stepF x s))) →
            ∀ (x : List Bool),
              ∃ cfg,
                ∃ startup ≤ 10 * (T x.length + 1),
                  Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) startup = cfg 0 ∧
                    (∀ i ≤ R x.length, (cfg i).output = []) ∧
                      (cfg (R x.length + 1)).state = none ∧
                        ((cfg (R x.length + 1)).output = if findMode = true then [] else [false]) ∧
                          ∀ i ≤ R x.length,
                            ∃ t ≤ 10 * (T x.length + 1),
                              if acceptF x ((stepF x)^[i] (s0 x)) = true then
                                (Turing.MultiTapeTM.runFrom (cfg i) t).state = none ∧
                                  (Turing.MultiTapeTM.runFrom (cfg i) t).output =
                                    if findMode = true then out x ((stepF x)^[i] (s0 x)) else [true]
                              else Turing.MultiTapeTM.runFrom (cfg i) t = cfg (i + 1)
TARGET|Turing.FinTM.loopHostTM_decides|TCSlib.Complexity.TuringMachine.Build.Loop|private=false|internal=false|simp=false|unfold=false
TYPE|Turing.FinTM.loopHostTM_decides|∀ (body F : Turing.FinTM Bool) (anchor : body.State)
  (Inv : List Bool → List Bool → Prop) (stepF : List Bool → List Bool → List Bool)
  (acceptF : List Bool → List Bool → Bool) (s0 : List Bool → List Bool) (R T : ℕ → ℕ),
  F.ComputesFunInTime (fun x => (R x.length).bits) T →
    (∀ (x : List Bool), Inv x (s0 x)) →
      (∀ (x s : List Bool), Inv x s → Inv x (stepF x s)) →
        (∀ (x : List Bool),
            ∃ t ≤ T x.length,
              (∀ t' < t, (Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) t').state ≠ some anchor) ∧
                Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) t =
                  Turing.Cfg.ofWords anchor (Turing.stateWord body.k (s0 x))) →
          (∀ (x s : List Bool),
              Inv x s →
                ∃ t,
                  0 < t ∧
                    t ≤ T x.length ∧
                      (∀ (t' : ℕ),
                          0 < t' →
                            t' < t →
                              (Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords anchor (Turing.stateWord body.k s))
                                    t').state ≠
                                some anchor) ∧
                        if acceptF x s = true then
                          (Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords anchor (Turing.stateWord body.k s)) t).state =
                              none ∧
                            (Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords anchor (Turing.stateWord body.k s))
                                  t).output =
                              [true]
                        else
                          Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords anchor (Turing.stateWord body.k s)) t =
                            Turing.Cfg.ofWords anchor (Turing.stateWord body.k (stepF x s))) →
            (body.loopHostTM F anchor false).ComputesFunInTime
              (fun x => [(List.range (R x.length + 1)).any fun i => acceptF x ((stepF x)^[i] (s0 x))]) fun n =>
              10 * (T n + 1) * (R n + 2)
TARGET|Turing.FinTM.loopHostTM_finds|TCSlib.Complexity.TuringMachine.Build.Loop|private=false|internal=false|simp=false|unfold=false
TYPE|Turing.FinTM.loopHostTM_finds|∀ (body F : Turing.FinTM Bool) (anchor : body.State)
  (Inv : List Bool → List Bool → Prop) (stepF : List Bool → List Bool → List Bool)
  (acceptF : List Bool → List Bool → Bool) (out : List Bool → List Bool → List Bool) (s0 : List Bool → List Bool)
  (R T : ℕ → ℕ),
  F.ComputesFunInTime (fun x => (R x.length).bits) T →
    (∀ (x : List Bool), Inv x (s0 x)) →
      (∀ (x s : List Bool), Inv x s → Inv x (stepF x s)) →
        (∀ (x : List Bool),
            ∃ t ≤ T x.length,
              (∀ t' < t, (Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) t').state ≠ some anchor) ∧
                Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) t =
                  Turing.Cfg.ofWords anchor (Turing.stateWord body.k (s0 x))) →
          (∀ (x s : List Bool),
              Inv x s →
                ∃ t,
                  0 < t ∧
                    t ≤ T x.length ∧
                      (∀ (t' : ℕ),
                          0 < t' →
                            t' < t →
                              (Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords anchor (Turing.stateWord body.k s))
                                    t').state ≠
                                some anchor) ∧
                        if acceptF x s = true then
                          (Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords anchor (Turing.stateWord body.k s)) t).state =
                              none ∧
                            (Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords anchor (Turing.stateWord body.k s))
                                  t).output =
                              out x s
                        else
                          Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords anchor (Turing.stateWord body.k s)) t =
                            Turing.Cfg.ofWords anchor (Turing.stateWord body.k (stepF x s))) →
            (body.loopHostTM F anchor true).ComputesFunInTime
              (fun x =>
                match List.find? (fun i => acceptF x ((stepF x)^[i] (s0 x))) (List.range (R x.length + 1)) with
                | some i => out x ((stepF x)^[i] (s0 x))
                | none => [])
              fun n => 10 * (T n + 1) * (R n + 2)
TARGET|Turing.FinTM.loopHostTM_spaceUsed_le_budget|TCSlib.Complexity.TuringMachine.Build.Loop|private=false|internal=false|simp=false|unfold=false
TYPE|Turing.FinTM.loopHostTM_spaceUsed_le_budget|∀ (body F : Turing.FinTM Bool) (anchor : body.State)
  (Inv : List Bool → List Bool → Prop) (stepF : List Bool → List Bool → List Bool)
  (acceptF : List Bool → List Bool → Bool) (out : List Bool → List Bool → List Bool) (findMode : Bool)
  (s0 : List Bool → List Bool) (R T : ℕ → ℕ),
  F.ComputesFunInTime (fun x => (R x.length).bits) T →
    (∀ (x : List Bool), Inv x (s0 x)) →
      (∀ (x s : List Bool), Inv x s → Inv x (stepF x s)) →
        (∀ (x : List Bool),
            ∃ t ≤ T x.length,
              (∀ t' < t, (Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) t').state ≠ some anchor) ∧
                Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) t =
                  Turing.Cfg.ofWords anchor (Turing.stateWord body.k (s0 x))) →
          (∀ (x s : List Bool),
              Inv x s →
                ∃ t,
                  0 < t ∧
                    t ≤ T x.length ∧
                      (∀ (t' : ℕ),
                          0 < t' →
                            t' < t →
                              (Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords anchor (Turing.stateWord body.k s))
                                    t').state ≠
                                some anchor) ∧
                        if acceptF x s = true then
                          (Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords anchor (Turing.stateWord body.k s)) t).state =
                              none ∧
                            (Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords anchor (Turing.stateWord body.k s))
                                  t).output =
                              out x s
                        else
                          Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords anchor (Turing.stateWord body.k s)) t =
                            Turing.Cfg.ofWords anchor (Turing.stateWord body.k (stepF x s))) →
            ∀ (x : List Bool) (t : ℕ),
              Turing.MultiTapeTM.spaceUsed (Turing.MultiTapeTM.initCfg x) t ≤
                23 * (body.loopHostTM F anchor findMode).k * (T x.length + 1)
TARGET|Turing.FinTM.timedCondTM_computes|TCSlib.Complexity.TuringMachine.Build.Wrappers|private=false|internal=false|simp=false|unfold=false
TYPE|Turing.FinTM.timedCondTM_computes|∀ {D M₁ M₂ : Turing.FinTM Bool} {p : List Bool → Bool}
  {f₁ f₂ : List Bool → List Bool} {T₀ T₁ T₂ : ℕ → ℕ},
  D.ComputesFunInTime (fun x => [p x]) T₀ →
    M₁.ComputesFunInTime f₁ T₁ →
      M₂.ComputesFunInTime f₂ T₂ →
        (D.timedCondTM M₁ M₂).ComputesFunInTime (fun x => if p x = true then f₁ x else f₂ x) fun n =>
          5 * (T₀ n + max (T₁ n) (T₂ n) + 1)
TARGET|Turing.FinTM.timedCondTM_spaceUsed|TCSlib.Complexity.TuringMachine.Build.Wrappers|private=false|internal=false|simp=false|unfold=false
TYPE|Turing.FinTM.timedCondTM_spaceUsed|∀ (D M₁ M₂ : Turing.FinTM Bool) (x : List Bool) (b : Bool) (T t : ℕ),
  D.ComputesInTime x [b] T →
    Turing.MultiTapeTM.spaceUsed (Turing.MultiTapeTM.initCfg x) t ≤
      Turing.MultiTapeTM.spaceUsed (Turing.MultiTapeTM.initCfg x) T +
          Turing.MultiTapeTM.spaceUsed (Turing.MultiTapeTM.initCfg x) t +
        2
TARGET|_private.TCSlib.Complexity.TuringMachine.Composition.0.Turing.FinTM.condTM_branch_run|TCSlib.Complexity.TuringMachine.Composition|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Composition.0.Turing.FinTM.condTM_branch_run|∀
  (D M₁ M₂ : Turing.FinTM Bool) (b : Bool) {x : List Bool} (c : Turing.Cfg (M₁.k + M₂.k) Bool (M₁.State ⊕ M₂.State) x)
  (tapes : Fin D.k → ℤ → Option Bool) (heads : Fin D.k → ℤ) (t : ℕ),
  have V := fun tag => ⋯.mpr (⋯.mpr (M₁.branchTM M₂ tag).tm);
  Turing.MultiTapeTM.runFrom (Turing.FinTM.rightCfg (fun q => Sum.inr (Sum.inr q)) c tapes heads) t =
    Turing.FinTM.rightCfg (fun q => Sum.inr (Sum.inr q)) (Turing.MultiTapeTM.runFrom c t) tapes heads
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Loop.0.Turing.FinTM.emCall_bank_final|TCSlib.Complexity.TuringMachine.Build.Loop|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Loop.0.Turing.FinTM.emCall_bank_final|∀ (M : Turing.FinTM Bool)
  (emit : Bool) (x arg cap : List Bool) (T : ℕ) (i : Fin M.k),
  have frame := Turing.FinTM.emCallBankFrame✝ M emit x arg cap T (↑i) (Sum.inr (Sum.inl (i.castSucc, 0)));
  Turing.FinTM.emCallEmbeddedCfg✝ (Turing.FinTM.emCallTripleEmbedding✝ M i) (fun q => Sum.inr (Sum.inl (i.castSucc, q)))
      frame.workTapes frame.workTapePos
      (Turing.FinTM.emCallClearCfg✝ x 1 3 (fun x => none) (fun x => none) (fun x => none) 0) =
    Turing.FinTM.emCallBankFrame✝¹ M emit x arg cap T (↑i + 1) (Sum.inr (Sum.inl (i.castSucc, 3)))
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Loop.0.Turing.FinTM.emCall_bank_initial|TCSlib.Complexity.TuringMachine.Build.Loop|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Loop.0.Turing.FinTM.emCall_bank_initial|∀ (M : Turing.FinTM Bool)
  (emit : Bool) (x arg cap : List Bool) (T : ℕ) (i : Fin M.k),
  have frame := Turing.FinTM.emCallBankFrame✝ M emit x arg cap T (↑i) (Sum.inr (Sum.inl (i.castSucc, 0)));
  Turing.FinTM.emCallEmbeddedCfg✝ (Turing.FinTM.emCallTripleEmbedding✝ M i) (fun q => Sum.inr (Sum.inl (i.castSucc, q)))
      frame.workTapes frame.workTapePos
      (Turing.FinTM.emCallClearCfg✝ x 1 0 ((Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg arg) T).workTapes i)
        (Turing.FinTM.emCallSpan✝ (Turing.FinTM.emCallLo✝ M arg T i) (Turing.FinTM.emCallHi✝ M arg T i))
        (Turing.FinTM.bufferTape [true])
        ((Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg arg) T).workTapePos i)) =
    frame
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Loop.0.Turing.FinTM.emCall_pair_not_mem|TCSlib.Complexity.TuringMachine.Build.Loop|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Loop.0.Turing.FinTM.emCall_pair_not_mem|∀ (M : Turing.FinTM Bool)
  (i : Fin M.k) (r : Fin 2), Turing.FinTM.emCallPairIndex✝ M r ∉ Set.range ⇑(Turing.FinTM.emCallTripleEmbedding✝ M i)
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Loop.0.Turing.FinTM.emCall_triple_not_mem|TCSlib.Complexity.TuringMachine.Build.Loop|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Loop.0.Turing.FinTM.emCall_triple_not_mem|∀ (M : Turing.FinTM Bool)
  (i j : Fin M.k) (r : Fin 3),
  j ≠ i → Turing.FinTM.emCallTripleIndex✝ M j r ∉ Set.range ⇑(Turing.FinTM.emCallTripleEmbedding✝ M i)
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Loop.0.Turing.FinTM.loopCall_heads|TCSlib.Complexity.TuringMachine.Build.Loop|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Loop.0.Turing.FinTM.loopCall_heads|∀ (body F : Turing.FinTM Bool)
  (anchor : body.State) (x s word : List Bool) (fuel : Turing.Cfg F.k Bool F.State x) (B : ℕ),
  (∀ (i : Fin F.k), -↑B ≤ fuel.workTapePos i ∧ fuel.workTapePos i ≤ ↑B) →
    ∀ (i : Fin (body.k + 1 + (1 + F.k) + 1)),
      -↑B ≤
          (Turing.FinTM.loopCall✝ body F anchor false (Turing.Cfg.ofWords anchor (Turing.stateWord body.k s)) true none
                word fuel).workTapePos
            i ∧
        (Turing.FinTM.loopCall✝¹ body F anchor false (Turing.Cfg.ofWords anchor (Turing.stateWord body.k s)) true none
                word fuel).workTapePos
            i ≤
          ↑B
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Loop.0.Turing.FinTM.loopHost_contracts|TCSlib.Complexity.TuringMachine.Build.Loop|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Loop.0.Turing.FinTM.loopHost_contracts|∀
  (body F : Turing.FinTM Bool) (anchor : body.State) (Inv : List Bool → List Bool → Prop)
  (stepF : List Bool → List Bool → List Bool) (acceptF : List Bool → List Bool → Bool)
  (out : List Bool → List Bool → List Bool) (findMode : Bool) (s0 : List Bool → List Bool) (R T : ℕ → ℕ),
  F.ComputesFunInTime (fun x => (R x.length).bits) T →
    (∀ (x : List Bool), Inv x (s0 x)) →
      (∀ (x s : List Bool), Inv x s → Inv x (stepF x s)) →
        (∀ (x : List Bool),
            ∃ t ≤ T x.length,
              (∀ t' < t, (Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) t').state ≠ some anchor) ∧
                Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) t =
                  Turing.Cfg.ofWords anchor (Turing.stateWord body.k (s0 x))) →
          (∀ (x s : List Bool),
              Inv x s →
                ∃ t,
                  0 < t ∧
                    t ≤ T x.length ∧
                      (∀ (t' : ℕ),
                          0 < t' →
                            t' < t →
                              (Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords anchor (Turing.stateWord body.k s))
                                    t').state ≠
                                some anchor) ∧
                        if acceptF x s = true then
                          (Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords anchor (Turing.stateWord body.k s)) t).state =
                              none ∧
                            (Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords anchor (Turing.stateWord body.k s))
                                  t).output =
                              out x s
                        else
                          Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords anchor (Turing.stateWord body.k s)) t =
                            Turing.Cfg.ofWords anchor (Turing.stateWord body.k (stepF x s))) →
            ∀ (x : List Bool),
              ∃ cfg,
                ∃ startup ≤ 10 * (T x.length + 1),
                  Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) startup = cfg 0 ∧
                    (∀ i ≤ R x.length, (cfg i).output = []) ∧
                      (cfg (R x.length + 1)).state = none ∧
                        ((cfg (R x.length + 1)).output = if findMode = true then [] else [false]) ∧
                          (∀ i ≤ R x.length,
                              ∃ t ≤ 10 * (T x.length + 1),
                                if acceptF x ((stepF x)^[i] (s0 x)) = true then
                                  (Turing.MultiTapeTM.runFrom (cfg i) t).state = none ∧
                                    (Turing.MultiTapeTM.runFrom (cfg i) t).output =
                                      if findMode = true then out x ((stepF x)^[i] (s0 x)) else [true]
                                else Turing.MultiTapeTM.runFrom (cfg i) t = cfg (i + 1)) ∧
                            (∀ i ≤ R x.length,
                                ∀ (j : Fin (body.loopHostTM F anchor findMode).k),
                                  -↑(T x.length) ≤ (cfg i).workTapePos j ∧ (cfg i).workTapePos j ≤ ↑(T x.length)) ∧
                              ∀ (j : Fin (body.loopHostTM F anchor findMode).k),
                                -↑(T x.length + 10 * (T x.length + 1)) ≤ (cfg (R x.length + 1)).workTapePos j ∧
                                  (cfg (R x.length + 1)).workTapePos j ≤ ↑(T x.length + 10 * (T x.length + 1))
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Loop.0.Turing.FinTM.loopHost_input_rewind|TCSlib.Complexity.TuringMachine.Build.Loop|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Loop.0.Turing.FinTM.loopHost_input_rewind|∀
  (body F : Turing.FinTM Bool) (anchor : body.State) (forward findMode : Bool) {x : List Bool}
  (cfg :
    Turing.Cfg (Turing.FinTM.loopHostM✝ body F anchor forward findMode).k Bool
      (Turing.FinTM.loopHostM✝¹ body F anchor forward findMode).State x),
  cfg.state = some (Sum.inr (Sum.inr 4)) →
    ∃ t ≤ ↑cfg.inputPos + 2,
      Turing.MultiTapeTM.runFrom cfg t =
        { state := some (Sum.inr (Sum.inl (true, body.tm.q₀, false))), inputPos := 1, workTapes := cfg.workTapes,
          workTapePos := cfg.workTapePos, output := cfg.output }
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Loop.0.Turing.FinTM.loopHost_prepare|TCSlib.Complexity.TuringMachine.Build.Loop|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Loop.0.Turing.FinTM.loopHost_prepare|∀ (body F : Turing.FinTM Bool)
  (anchor : body.State) (forward findMode : Bool) (R T : ℕ → ℕ),
  F.ComputesFunInTime (fun x => (R x.length).bits) T →
    ∀ (x : List Bool),
      ∃ c t,
        c.state = none ∧
          c.output = (R x.length).bits ∧
            t ≤ 5 * T x.length + 7 ∧
              Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) t = Turing.FinTM.loopReady✝ body F c ∧
                ∀ (i : Fin F.k), -↑(T x.length) ≤ c.workTapePos i ∧ c.workTapePos i ≤ ↑(T x.length)
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Loop.0.Turing.FinTM.loop_first_halt|TCSlib.Complexity.TuringMachine.Build.Loop|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Loop.0.Turing.FinTM.loop_first_halt|∀ {k : ℕ} {S : Type u_1}
  {x : List Bool} (tm : Turing.MultiTapeTM k Bool S) (cfg : Turing.Cfg k Bool S x) (t : ℕ),
  cfg.state ≠ none →
    (Turing.MultiTapeTM.runFrom cfg t).state = none →
      ∃ u,
        0 < u ∧
          u ≤ t ∧
            (∀ v < u, ¬(Turing.MultiTapeTM.runFrom cfg v).Halted) ∧
              (Turing.MultiTapeTM.runFrom cfg u).state = none ∧
                Turing.MultiTapeTM.runFrom cfg u = Turing.MultiTapeTM.runFrom cfg t
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Loop.0.Turing.FinTM.seamed_space|TCSlib.Complexity.TuringMachine.Build.Loop|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Loop.0.Turing.FinTM.seamed_space|∀ (M : Turing.FinTM Bool)
  (x : List Bool) (cfg : ℕ → Turing.Cfg M.k Bool M.State x) (N B H startup : ℕ),
  startup ≤ B →
    Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) startup = cfg 0 →
      (∀ j < N, ∀ (i : Fin M.k), -↑H ≤ (cfg j).workTapePos i ∧ (cfg j).workTapePos i ≤ ↑H) →
        (cfg N).state = none →
          (∀ (i : Fin M.k), -↑(H + B) ≤ (cfg N).workTapePos i ∧ (cfg N).workTapePos i ≤ ↑(H + B)) →
            (∀ j < N,
                ∃ u ≤ B,
                  (Turing.MultiTapeTM.runFrom (cfg j) u).state = none ∨
                    Turing.MultiTapeTM.runFrom (cfg j) u = cfg (j + 1)) →
              ∀ (t : ℕ), Turing.MultiTapeTM.spaceUsed (Turing.MultiTapeTM.initCfg x) t ≤ M.k * (2 * (H + B) + 1)
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Loop.0.Turing.FinTM.segment_heads|TCSlib.Complexity.TuringMachine.Build.Loop|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Loop.0.Turing.FinTM.segment_heads|∀ {k : ℕ} {S : Type}
  {x : List Bool} (tm : Turing.MultiTapeTM k Bool S) (cfg : ℕ → Turing.Cfg k Bool S x) (N B H : ℕ),
  (∀ j < N, ∀ (i : Fin k), -↑H ≤ (cfg j).workTapePos i ∧ (cfg j).workTapePos i ≤ ↑H) →
    (cfg N).state = none →
      (∀ (i : Fin k), -↑(H + B) ≤ (cfg N).workTapePos i ∧ (cfg N).workTapePos i ≤ ↑(H + B)) →
        (∀ j < N,
            ∃ u ≤ B,
              (Turing.MultiTapeTM.runFrom (cfg j) u).state = none ∨
                Turing.MultiTapeTM.runFrom (cfg j) u = cfg (j + 1)) →
          ∀ (t : ℕ) (i : Fin k),
            -↑(H + B) ≤ (Turing.MultiTapeTM.runFrom (cfg 0) t).workTapePos i ∧
              (Turing.MultiTapeTM.runFrom (cfg 0) t).workTapePos i ≤ ↑(H + B)
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Wrappers.0.Turing.FinTM.timedHeads|TCSlib.Complexity.TuringMachine.Build.Wrappers|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Wrappers.0.Turing.FinTM.timedHeads|(D M₁ M₂ : Turing.FinTM Bool) →
  (Fin D.k → ℤ) → (Fin (M₁.k + M₂.k) → ℤ) → ℤ → Fin (D.k + (M₁.k + M₂.k) + 1) → ℤ
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Wrappers.0.Turing.FinTM.timedReadyCfg_workTapePos|TCSlib.Complexity.TuringMachine.Build.Wrappers|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Wrappers.0.Turing.FinTM.timedReadyCfg_workTapePos|∀
  (D M₁ M₂ : Turing.FinTM Bool) {x : List Bool} (c : Turing.Cfg D.k Bool D.State x) (b : Bool),
  (Turing.FinTM.timedReadyCfg✝ D M₁ M₂ c b).workTapePos = Turing.FinTM.timedHeads✝ D M₁ M₂ c.workTapePos (fun x => 0) 0
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Wrappers.0.Turing.FinTM.timedReady_dispatch|TCSlib.Complexity.TuringMachine.Build.Wrappers|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Wrappers.0.Turing.FinTM.timedReady_dispatch|∀
  (D M₁ M₂ : Turing.FinTM Bool) {x : List Bool} (c : Turing.Cfg D.k Bool D.State x) (b : Bool),
  have V := ⋯.mpr (⋯.mpr (M₁.branchTM M₂ b).tm);
  (have __src := Turing.FinTM.timedReadyCfg✝ D M₁ M₂ c b;
    { state := some (Sum.inr (Sum.inr (Sum.inr V.q₀))), inputPos := 1, workTapes := __src.workTapes,
      workTapePos := __src.workTapePos, output := __src.output }) =
    Turing.FinTM.timedBranchCfg✝ D M₁ M₂ (Turing.MultiTapeTM.initCfg x) c.workTapes c.workTapePos b
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Wrappers.0.Turing.FinTM.timed_branch_heads|TCSlib.Complexity.TuringMachine.Build.Wrappers|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Wrappers.0.Turing.FinTM.timed_branch_heads|∀
  (D M₁ M₂ : Turing.FinTM Bool) {x : List Bool} (c : Turing.Cfg (M₁.k + M₂.k) Bool (M₁.State ⊕ M₂.State) x)
  (tapes : Fin D.k → ℤ → Option Bool) (heads : Fin D.k → ℤ) (b : Bool),
  (Turing.FinTM.timedBranchCfg✝ D M₁ M₂ c tapes heads b).workTapePos =
    Turing.FinTM.timedHeads✝ D M₁ M₂ heads c.workTapePos 0
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Wrappers.0.Turing.FinTM.timed_control_heads|TCSlib.Complexity.TuringMachine.Build.Wrappers|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Wrappers.0.Turing.FinTM.timed_control_heads|∀
  (D M₁ M₂ : Turing.FinTM Bool) {x : List Bool} (c : Turing.Cfg D.k Bool D.State x),
  (Turing.FinTM.timedControlCfg✝ D M₁ M₂ c).workTapePos =
    Turing.FinTM.timedHeads✝ D M₁ M₂ c.workTapePos (fun x => 0) ↑c.output.length
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Wrappers.0.Turing.FinTM.timed_ledger|TCSlib.Complexity.TuringMachine.Build.Wrappers|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Wrappers.0.Turing.FinTM.timed_ledger|∀ (D M₁ M₂ : Turing.FinTM Bool)
  (x : List Bool) (b : Bool) (T : ℕ),
  D.ComputesInTime x [b] T →
    have V := ⋯.mpr (⋯.mpr (M₁.branchTM M₂ b).tm);
    ∀ (u : ℕ),
      ∃ v ≤ T,
        ∃ w ≤ u,
          ∃ z,
            0 ≤ z ∧
              z ≤ 1 ∧
                (Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) u).workTapePos =
                  Turing.FinTM.timedHeads✝ D M₁ M₂
                    (Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) v).workTapePos
                    (Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) w).workTapePos z
TARGET|_private.TCSlib.Complexity.TuringMachine.Build.Wrappers.0.Turing.FinTM.timed_read_heads|TCSlib.Complexity.TuringMachine.Build.Wrappers|private=true|internal=true|simp=false|unfold=false
TYPE|_private.TCSlib.Complexity.TuringMachine.Build.Wrappers.0.Turing.FinTM.timed_read_heads|∀
  (D M₁ M₂ : Turing.FinTM Bool) {x : List Bool} (c : Turing.Cfg D.k Bool D.State x) (b : Bool),
  c.state = none →
    c.output = [b] →
      ∀ u ≤ 2,
        ∃ z,
          0 ≤ z ∧
            z ≤ 1 ∧
              (Turing.MultiTapeTM.runFrom (Turing.FinTM.timedControlCfg✝ D M₁ M₂ c) u).workTapePos =
                Turing.FinTM.timedHeads✝ D M₁ M₂ c.workTapePos (fun x => 0) z
