case refine_3
body F : FinTM Bool
anchor : body.State
Inv : List Bool → List Bool → Prop
stepF : List Bool → List Bool → List Bool
acceptF : List Bool → List Bool → Bool
out : List Bool → List Bool → List Bool
findMode : Bool
s0 : List Bool → List Bool
R T : ℕ → ℕ
hF : F.ComputesFunInTime (fun x => (R x.length).bits) T
hInv0 : ∀ (x : List Bool), Inv x (s0 x)
hInvStep : ∀ (x s : List Bool), Inv x s → Inv x (stepF x s)
hstart :
  ∀ (x : List Bool),
    ∃ t ≤ T x.length,
      (∀ t' < t, (MultiTapeTM.runFrom (MultiTapeTM.initCfg x) t').state ≠ some anchor) ∧
        MultiTapeTM.runFrom (MultiTapeTM.initCfg x) t = Cfg.ofWords anchor (stateWord body.k (s0 x))
hround :
  ∀ (x s : List Bool),
    Inv x s →
      ∃ t,
        0 < t ∧
          t ≤ T x.length ∧
            (∀ (t' : ℕ),
                0 < t' →
                  t' < t → (MultiTapeTM.runFrom (Cfg.ofWords anchor (stateWord body.k s)) t').state ≠ some anchor) ∧
              if acceptF x s = true then
                (MultiTapeTM.runFrom (Cfg.ofWords anchor (stateWord body.k s)) t).state = none ∧
                  (MultiTapeTM.runFrom (Cfg.ofWords anchor (stateWord body.k s)) t).output = out x s
              else
                MultiTapeTM.runFrom (Cfg.ofWords anchor (stateWord body.k s)) t =
                  Cfg.ofWords anchor (stateWord body.k (stepF x s))
x : List Bool
fuel : Cfg F.k Bool F.State x
ftime : ℕ
hfh : fuel.state = none
hfo : fuel.output = (R x.length).bits
hft : ftime ≤ 5 * T x.length + 7
hprepare : MultiTapeTM.runFrom (MultiTapeTM.initCfg x) ftime = body.loopReady F fuel
hfuel : ∀ (i : Fin F.k), -↑(T x.length) ≤ fuel.workTapePos i ∧ fuel.workTapePos i ≤ ↑(T x.length)
btime : ℕ
hbt : btime ≤ T x.length
hbguard : ∀ t' < btime, (MultiTapeTM.runFrom (MultiTapeTM.initCfg x) t').state ≠ some anchor
hbend : MultiTapeTM.runFrom (MultiTapeTM.initCfg x) btime = Cfg.ofWords anchor (stateWord body.k (s0 x))
words : ℕ → List Bool := fun i => (fun w => (loopDebit w).1)^[i] (R x.length).bits
orbit : ℕ → List Bool := fun i => (stepF x)^[i] (s0 x)
candidate : ℕ → Cfg (body.k + 1 + (1 + F.k) + 1) Bool (body.LoopHostState F) x :=
  fun i => body.loopCall F anchor false (Cfg.ofWords anchor (stateWord body.k (orbit i))) true none (words i) fuel
hheads :
  ∀ (i : ℕ) (j : Fin (body.k + 1 + (1 + F.k) + 1)),
    -↑(T x.length) ≤ (candidate i).workTapePos j ∧ (candidate i).workTapePos j ≤ ↑(T x.length)
hwidth : ∀ (i : ℕ), (words i).length ≤ T x.length
hsuccess : ∀ i ≤ R x.length, (loopDebit (words i)).2 = true ↔ i < R x.length
hlocal :
  ∀ i ≤ R x.length,
    ∃ t ≤ loopHost_bound * (T x.length + 1),
      if acceptF x (orbit i) = true then
        (MultiTapeTM.runFrom (candidate i) t).state = none ∧
          (MultiTapeTM.runFrom (candidate i) t).output = if findMode = true then out x (orbit i) else [true]
      else
        if i < R x.length then MultiTapeTM.runFrom (candidate i) t = candidate (i + 1)
        else
          (MultiTapeTM.runFrom (candidate i) t).state = none ∧
            (MultiTapeTM.runFrom (candidate i) t).output = if findMode = true then [] else [false]
time : ℕ → ℕ := fun i => if hi : i ≤ R x.length then ⋯.choose else 0
htime :
  ∀ i ≤ R x.length,
    time i ≤ loopHost_bound * (T x.length + 1) ∧
      if acceptF x (orbit i) = true then
        (MultiTapeTM.runFrom (candidate i) (time i)).state = none ∧
          (MultiTapeTM.runFrom (candidate i) (time i)).output = if findMode = true then out x (orbit i) else [true]
      else
        if i < R x.length then MultiTapeTM.runFrom (candidate i) (time i) = candidate (i + 1)
        else
          (MultiTapeTM.runFrom (candidate i) (time i)).state = none ∧
            (MultiTapeTM.runFrom (candidate i) (time i)).output = if findMode = true then [] else [false]
hlast :
  time (R x.length) ≤ loopHost_bound * (T x.length + 1) ∧
    if acceptF x (orbit (R x.length)) = true then
      (MultiTapeTM.runFrom (candidate (R x.length)) (time (R x.length))).state = none ∧
        (MultiTapeTM.runFrom (candidate (R x.length)) (time (R x.length))).output =
          if findMode = true then out x (orbit (R x.length)) else [true]
    else
      if R x.length < R x.length then
        MultiTapeTM.runFrom (candidate (R x.length)) (time (R x.length)) = candidate (R x.length + 1)
      else
        (MultiTapeTM.runFrom (candidate (R x.length)) (time (R x.length))).state = none ∧
          (MultiTapeTM.runFrom (candidate (R x.length)) (time (R x.length))).output =
            if findMode = true then [] else [false]
terminal : Cfg (body.loopHostTM F anchor findMode).k Bool (body.loopHostTM F anchor findMode).State x :=
  if acceptF x (orbit (R x.length)) = true then
    let __src := candidate (R x.length + 1);
    { state := none, inputPos := __src.inputPos, workTapes := __src.workTapes, workTapePos := __src.workTapePos,
      output := if findMode = true then [] else [false] }
  else MultiTapeTM.runFrom (candidate (R x.length)) (time (R x.length))
hterminal : terminal.state = none ∧ terminal.output = if findMode = true then [] else [false]
hterminalheads :
  ∀ (j : Fin (body.loopHostTM F anchor findMode).k),
    -↑(T x.length + loopHost_bound * (T x.length + 1)) ≤ terminal.workTapePos j ∧
      terminal.workTapePos j ≤ ↑(T x.length + loopHost_bound * (T x.length + 1))
cfg : ℕ → Cfg (body.k + 1 + (1 + F.k) + 1) Bool (body.LoopHostState F) x :=
  fun i => if i ≤ R x.length then candidate i else terminal
hcfg : ∀ i ≤ R x.length, cfg i = candidate i
i : ℕ
hi : i ≤ R x.length
⊢ (candidate i).output = []
