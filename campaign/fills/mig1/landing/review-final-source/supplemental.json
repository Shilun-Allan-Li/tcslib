  "long_changed_proofs_missing_leading_sketch": [
    {
      "name": "Turing.FinTM.fwdMap_block",
      "private": true,
      "kind": "lemma",
      "line": 2821,
      "end": 2860,
      "path": "TCSlib/Complexity/TuringMachine/Build/Primitives.lean",
      "change": "new-proof",
      "body_lines": 27,
      "leading_doc": "/-- Doubled blocks append one bit to the first buffer. `01` starts suffix\nbuffering; `10` rejects before emitting. Both missing-bit cases are handled\nby the surrounding parser induction. -/"
    },
    {
      "name": "Turing.FinTM.fwdMap_suffix",
      "private": true,
      "kind": "lemma",
      "line": 2861,
      "end": 2915,
      "path": "TCSlib/Complexity/TuringMachine/Build/Primitives.lean",
      "change": "new-proof",
      "body_lines": 46,
      "leading_doc": "/-- After validation, the complete suffix is buffered silently. Its right\nblank is turned left exactly once, including when the suffix is empty. -/"
    },
    {
      "name": "Turing.FinTM.fwdMap_backB",
      "private": true,
      "kind": "lemma",
      "line": 2916,
      "end": 2950,
      "path": "TCSlib/Complexity/TuringMachine/Build/Primitives.lean",
      "change": "new-proof",
      "body_lines": 29,
      "leading_doc": "/-- Rewind the second buffer to zero, preserving the first buffer and the\nblank payload bank. The left-blank step is present even at width zero. -/"
    },
    {
      "name": "Turing.FinTM.fwdMap_backA",
      "private": true,
      "kind": "lemma",
      "line": 2951,
      "end": 2989,
      "path": "TCSlib/Complexity/TuringMachine/Build/Primitives.lean",
      "change": "new-proof",
      "body_lines": 29,
      "leading_doc": "/-- The corresponding first-buffer rewind, leaving virtual input at zero. -/"
    },
    {
      "name": "Turing.FinTM.fwdMap_finish",
      "private": true,
      "kind": "lemma",
      "line": 3045,
      "end": 3082,
      "path": "TCSlib/Complexity/TuringMachine/Build/Primitives.lean",
      "change": "new-proof",
      "body_lines": 27,
      "leading_doc": "/-- Successful suffix buffering, two rewinds, and encoded-prefix emission\nreach the initialized payload seam within `3|a|+2|b|+5` transitions. -/"
    },
    {
      "name": "Turing.FinTM.fwdMap_setup",
      "private": true,
      "kind": "lemma",
      "line": 3172,
      "end": 3206,
      "path": "TCSlib/Complexity/TuringMachine/Build/Primitives.lean",
      "change": "new-proof",
      "body_lines": 28,
      "leading_doc": "/-- Starting with empty buffers gives a uniform linear setup budget on every\ninput, including malformed encodings. -/"
    },
    {
      "name": "Turing.FinTM.fwdMapVirtual_step",
      "private": true,
      "kind": "lemma",
      "line": 3207,
      "end": 3259,
      "path": "TCSlib/Complexity/TuringMachine/Build/Primitives.lean",
      "change": "new-proof",
      "body_lines": 45,
      "leading_doc": "/-- One forwarded payload step has exactly the source work actions and\nemission. `virtualMove_correct` proves both boundary clamps and preserves\nits arrival tag, without a nonempty-input assumption. -/"
    },
    {
      "name": "Turing.FinTM.fwdMapSetup_head_step",
      "private": true,
      "kind": "lemma",
      "line": 3325,
      "end": 3369,
      "path": "TCSlib/Complexity/TuringMachine/Build/Primitives.lean",
      "change": "new-proof",
      "body_lines": 39,
      "leading_doc": "/-- Every setup action leaves each payload work head fixed. -/"
    },
    {
      "name": "Turing.FinTM.fwdMap_launch",
      "private": true,
      "kind": "lemma",
      "line": 3382,
      "end": 3418,
      "path": "TCSlib/Complexity/TuringMachine/Build/Primitives.lean",
      "change": "new-proof",
      "body_lines": 27,
      "leading_doc": "/-- Choose the first payload entry, then transfer every prefix to the\noperational host. The stationary setup seam identifies this first entry\nwith the complete validating/buffering/emission endpoint, so no payload\nwork is hidden in the administrative time bound. -/"
    },
    {
      "name": "Turing.FinTM.fwdMap_reject",
      "private": true,
      "kind": "lemma",
      "line": 3419,
      "end": 3456,
      "path": "TCSlib/Complexity/TuringMachine/Build/Primitives.lean",
      "change": "new-proof",
      "body_lines": 25,
      "leading_doc": "/-- A malformed encoding never reaches a payload state, since such a setup\nstate would remain live forever. Hence its entire operational trajectory\nagrees with setup, including the silent halt and every later time. -/"
    }
  ]
}
