-  induction bs with
-  | nil => simp [f2_counterInc, f2_counterCarry]
-  | cons b bs ih =>
-    cases b with
-    | false => simp [f2_counterInc, f2_counterCarry]
-    | true => simp [f2_counterInc, f2_counterCarry]; omega
