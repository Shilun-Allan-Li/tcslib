Turing.solveSplit.eq_def (C e n : Nat) :
  @Eq (Option Nat) (Turing.solveSplit C e n)
    (@List.find? Nat
      (fun i =>
        @BEq.beq Nat (@instBEqOfDecidableEq Nat instDecidableEqNat)
          (@HAdd.hAdd Nat Nat Nat (@instHAdd Nat instAddNat) i
            (@HMul.hMul Nat Nat Nat (@instHMul Nat instMulNat) C
              (@HPow.hPow Nat Nat Nat (@instHPow Nat Nat (@Monoid.toNatPow Nat Nat.instMonoid))
                (@HAdd.hAdd Nat Nat Nat (@instHAdd Nat instAddNat) i
                  (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1))))
                e)))
          n)
      (List.range
        (@HAdd.hAdd Nat Nat Nat (@instHAdd Nat instAddNat) n
          (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1))))))
Turing.solveSplitWith.eq_def (f : Nat → Nat) (n : Nat) :
  @Eq (Option Nat) (Turing.solveSplitWith f n)
    (@List.find? Nat
      (fun i =>
        @BEq.beq Nat (@instBEqOfDecidableEq Nat instDecidableEqNat)
          (@HAdd.hAdd Nat Nat Nat (@instHAdd Nat instAddNat) i (f i)) n)
      (List.range
        (@HAdd.hAdd Nat Nat Nat (@instHAdd Nat instAddNat) n
          (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1))))))
