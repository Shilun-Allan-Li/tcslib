Turing.FinTM.emitLoopTM_computes (body F : FinTM Bool) (anchor : body.State) (Inv : List Bool → List Bool → Prop)
  (stepF emitF : List Bool → List Bool → List Bool) (s0 : List Bool → List Bool) (R T : ℕ → ℕ)
  (hF : F.ComputesFunInTime (fun x => (R x.length).bits) T) (hInv0 : ∀ (x : List Bool), Inv x (s0 x))
  (hInvStep : ∀ (x s : List Bool), Inv x s → Inv x (stepF x s))
  (hstart :
    ∀ (x : List Bool),
      ∃ t ≤ T x.length,
        (∀ t' < t, (MultiTapeTM.runFrom (MultiTapeTM.initCfg x) t').state ≠ some anchor) ∧
          MultiTapeTM.runFrom (MultiTapeTM.initCfg x) t = Cfg.ofWords anchor (stateWord body.k (s0 x)))
  (hround :
    ∀ (x s : List Bool),
      Inv x s →
        ∃ t,
          0 < t ∧
            t ≤ T x.length ∧
              (∀ (t' : ℕ),
                  0 < t' →
                    t' < t → (MultiTapeTM.runFrom (Cfg.ofWords anchor (stateWord body.k s)) t').state ≠ some anchor) ∧
                MultiTapeTM.runFrom (Cfg.ofWords anchor (stateWord body.k s)) t =
                  have __src := Cfg.ofWords anchor (stateWord body.k (stepF x s));
                  { state := __src.state, inputPos := __src.inputPos, workTapes := __src.workTapes,
                    workTapePos := __src.workTapePos, output := emitF x s }) :
  (body.emitLoopTM F anchor).ComputesFunInTime
    (fun x => List.flatMap (fun i => emitF x ((stepF x)^[i] (s0 x))) (List.range (R x.length + 1))) fun n =>
    10 * (T n + 1) * (R n + 2)
