  (hM : M.ComputesFunInTime f T₁) (hU : ∀ (x : List Bool), U.ComputesInTime (f x) (g x) (T₂ x.length)) :
  (M.bufferedCompTM U).ComputesFunInTime g fun n => 2 * T₁ n + T₂ n + 2
Turing.FinTM.bufferedCompTM_computes_iff (M₁ M₂ : FinTM Bool) (x w : List Bool) :
  (∃ t, (M₁.bufferedCompTM M₂).ComputesInTime x w t) ↔
    ∃ y, (∃ t, M₁.ComputesInTime x y t) ∧ ∃ t, M₂.ComputesInTime y w t
