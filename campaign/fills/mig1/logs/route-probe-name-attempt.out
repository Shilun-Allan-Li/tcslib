Turing.FinTM.bufferedCompTM_computesFunInTime {M₁ M₂ : FinTM Bool} {f g : List Bool → List Bool} {T₁ T₂ : ℕ → ℕ}
  (h₁ : M₁.ComputesFunInTime f T₁) (h₂ : M₂.ComputesFunInTime g T₂) (hT₂ : Monotone T₂) :
  (M₁.bufferedCompTM M₂).ComputesFunInTime (g ∘ f) fun n => 2 * (T₁ n + T₂ (T₁ n) + 1)
