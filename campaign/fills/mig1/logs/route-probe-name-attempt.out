Turing.FinTM.loopHostTM_contracts (body F : FinTM Bool) (anchor : body.State) (Inv : List Bool → List Bool → Prop)
  (stepF : List Bool → List Bool → List Bool) (acceptF : List Bool → List Bool → Bool)
  (out : List Bool → List Bool → List Bool) (findMode : Bool) (s0 : List Bool → List Bool) (R T : ℕ → ℕ)
  (hF : F.ComputesFunInTime (fun x => (R x.length).bits) T) (hInv0 : ∀ (x : List Bool), Inv x (s0 x))
  (hInvStep : ∀ (x s : List Bool), Inv x s → Inv x (stepF x s))
  (hstart :
    ∀ (x : List Bool),
      ∃ t ≤ T x.length,
        (∀ t' < t, (MultiTapeTM.runFrom (MultiTapeTM.initCfg x) t').state ≠ some anchor) ∧
          MultiTapeTM.runFrom (MultiTapeTM.initCfg x) t = Cfg.ofWords anchor (stateWord body.k (s0 x)))
  (hround :
    ∀ (x s : List Bool),
      Inv x s →
        ∃ t,
          0 < t ∧
            t ≤ T x.length ∧
              (∀ (t' : ℕ),
                  0 < t' →
                    t' < t → (MultiTapeTM.runFrom (Cfg.ofWords anchor (stateWord body.k s)) t').state ≠ some anchor) ∧
                if acceptF x s = true then
                  (MultiTapeTM.runFrom (Cfg.ofWords anchor (stateWord body.k s)) t).state = none ∧
                    (MultiTapeTM.runFrom (Cfg.ofWords anchor (stateWord body.k s)) t).output = out x s
                else
                  MultiTapeTM.runFrom (Cfg.ofWords anchor (stateWord body.k s)) t =
                    Cfg.ofWords anchor (stateWord body.k (stepF x s)))
  (x : List Bool) :
  ∃ cfg,
    ∃ startup ≤ 10 * (T x.length + 1),
      MultiTapeTM.runFrom (MultiTapeTM.initCfg x) startup = cfg 0 ∧
        (∀ i ≤ R x.length, (cfg i).output = []) ∧
          (cfg (R x.length + 1)).state = none ∧
            ((cfg (R x.length + 1)).output = if findMode = true then [] else [false]) ∧
              ∀ i ≤ R x.length,
                ∃ t ≤ 10 * (T x.length + 1),
                  if acceptF x ((stepF x)^[i] (s0 x)) = true then
                    (MultiTapeTM.runFrom (cfg i) t).state = none ∧
                      (MultiTapeTM.runFrom (cfg i) t).output =
                        if findMode = true then out x ((stepF x)^[i] (s0 x)) else [true]
                  else MultiTapeTM.runFrom (cfg i) t = cfg (i + 1)
