Turing.FinTM.incFixedTM.eq_1 : Turing.FinTM.incFixedTM =
  { k := 0, State := Fin 4, fintypeState := Fin.fintype 4, decEqState := instDecidableEqFin 4,
    tm :=
      { q₀ := 0,
        tr := fun q inp x =>
          match ↑q with
          | 0 =>
            match inp with
            | some true => { inputTape := SignType.pos, workTapes := fun j => j.elim0, output := none, state := some 0 }
            | some false => Turing.FinTM.controlAction SignType.neg (some 1)
            | none => Turing.FinTM.controlAction 0 none
          | 1 =>
            match inp with
            | some val => Turing.FinTM.controlAction SignType.neg (some 1)
            | none => Turing.FinTM.controlAction SignType.pos (some 2)
          | 2 =>
            match inp with
            | some true =>
              { inputTape := SignType.pos, workTapes := fun j => j.elim0, output := some false, state := some 2 }
            | some false =>
              { inputTape := SignType.pos, workTapes := fun j => j.elim0, output := some true, state := some 3 }
            | none => Turing.FinTM.controlAction 0 none
          | x =>
            match inp with
            | some b => { inputTape := SignType.pos, workTapes := fun j => j.elim0, output := some b, state := some 3 }
            | none => { inputTape := 0, workTapes := fun j => j.elim0, output := none, state := none } } }
