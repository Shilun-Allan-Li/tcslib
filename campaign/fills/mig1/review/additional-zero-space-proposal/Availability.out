Turing.pairDiagTM.eq_1 : Turing.pairDiagTM =
  { k := 0, State := Fin 6, fintypeState := Fin.fintype 6, decEqState := instDecidableEqFin 6,
    tm :=
      { q₀ := 0,
        tr := fun q inp x =>
          match q with
          | 0 =>
            match inp with
            | some b => { inputTape := SignType.zero, workTapes := fun i => i.elim0, output := some b, state := some 1 }
            | none =>
              { inputTape := SignType.zero, workTapes := fun i => i.elim0, output := some false, state := some 2 }
          | 1 => { inputTape := SignType.pos, workTapes := fun i => i.elim0, output := inp, state := some 0 }
          | 2 => { inputTape := SignType.zero, workTapes := fun i => i.elim0, output := some true, state := some 3 }
          | 3 => { inputTape := SignType.neg, workTapes := fun i => i.elim0, output := none, state := some 4 }
          | 4 =>
            match inp with
            | some val => { inputTape := SignType.neg, workTapes := fun i => i.elim0, output := none, state := some 4 }
            | none => { inputTape := SignType.pos, workTapes := fun i => i.elim0, output := none, state := some 5 }
          | x =>
            match inp with
            | some b => { inputTape := SignType.pos, workTapes := fun i => i.elim0, output := some b, state := some 5 }
            | none => { inputTape := SignType.zero, workTapes := fun i => i.elim0, output := none, state := none } } }
