@Turing.FinTM.decEqState : {Symbol : Type} → (self : Turing.FinTM Symbol) → DecidableEq self.State
Turing.FinTM.decidesInSpace_iff : ∀ (M : Turing.FinTM Bool) (L : Language Bool) (s : ℕ → ℕ),
  M.DecidesInSpace L s ↔ M.ComputesInSpace (fun x => [Turing.MultiTapeTM.indicator L x]) s
