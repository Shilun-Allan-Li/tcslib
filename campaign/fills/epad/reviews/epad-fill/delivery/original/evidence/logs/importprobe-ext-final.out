Complexity.LogProg.OIS.compile_decides : ∀ (M : Turing.FinTM Bool) (Ms : Fin 2 → Turing.FinTM Bool)
  (As : Fin 2 → Language Bool) (sb : Fin 2 → ℕ → ℕ),
  (∀ (j : Fin 2), (Ms j).DecidesInSpace (As j) (sb j)) →
    ∀ (x v w : List Bool),
      (∀ i ≤ v.length, Turing.pairEncode x i.bits ∈ As 0 ↔ i < v.length) →
        (∀ i < v.length, Turing.pairEncode x i.bits ∈ As 1 ↔ v.getD i false = true) →
          ∀ (t : ℕ),
            M.ComputesInTime v w t →
              ∀ (B : ℕ),
                (∀ (j : Fin 2), ∀ i ≤ v.length, max (sb j (Turing.pairEncode x i.bits).length) 1 ≤ B) →
                  ∃ T,
                    (Complexity.LogProg.compileFinTM (Complexity.LogProg.OIS.prog M) (Complexity.LogProg.OIS.start M)
                            (Complexity.LogProg.bankTM Ms) (Complexity.LogProg.bankStart Ms)).ComputesInTime
                        x w T ∧
                      Turing.MultiTapeTM.spaceUsed (Turing.MultiTapeTM.initCfg x) T ≤
                        M.k * (2 * Turing.MultiTapeTM.spaceUsed (Turing.MultiTapeTM.initCfg v) t + 1) +
                            ((v.length + 1).bits.length + 2) +
                          (Complexity.LogProg.bankK Ms + Complexity.LogProg.bankK Ms) * (2 * B + 1)
Complexity.LogProg.OIS.instDecidableEqPh : DecidableEq Complexity.LogProg.OIS.Ph
