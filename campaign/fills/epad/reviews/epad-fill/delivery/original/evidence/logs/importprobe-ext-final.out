  {Λ : Type} → Complexity.LogProg.ARM m d Λ → List Bool → Complexity.LogProg.AConf m Λ → Prop
Complexity.LogProg.ValidPair : List Bool → Prop
Complexity.LogProg.ValidPlain : List Bool → Prop
@Complexity.LogProg.alignedPair_loop : ∀ {m d : ℕ} {Λ : Type} (A : Complexity.LogProg.ARM m d Λ)
  (oracle : Fin d → List Bool → Bool) (x : List Bool) (r limit : Fin m) (j : Fin d) (scan first : Λ)
  (test read : Bool → Λ) (fail done : Λ) (advance : Fin 4 → ℕ → Λ) (stride B : ℕ),
  0 < stride →
    r ≠ limit →
      A scan = Complexity.LogProg.Ins.jeq r limit fail first →
        A first = Complexity.LogProg.Ins.call j Complexity.LogProg.Mode.whole [r] (advance 1 0) (advance 0 0) →
          (∀ (b : Bool), A (test b) = Complexity.LogProg.Ins.jeq r limit fail (read b)) →
            (∀ (b : Bool),
                A (read b) =
                  Complexity.LogProg.Ins.call j Complexity.LogProg.Mode.whole [r]
                    (if b = true then advance 2 0 else advance 3 0) (if b = true then fail else advance 2 0)) →
              (∀ (k : Fin 4), ∀ i < stride, A (advance k i) = Complexity.LogProg.Ins.inc r (advance k (i + 1))) →
                advance 0 stride = test false ∧
                    advance 1 stride = test true ∧ advance 2 stride = scan ∧ advance 3 stride = done →
                  ∀ (w : List Bool) (v : Fin m → ℕ),
                    (∀ (s : Fin m), v s ≤ B) →
                      v limit = v r + stride * w.length →
                        (∀ i < w.length, oracle j (Turing.pairEncode x (v r + stride * i).bits) = w.getD i false) →
                          match Turing.pairDecode w with
                          | none =>
                            ∃ t ≤ w.length,
                              Complexity.LogProg.AReach A oracle x
                                (fun a => Complexity.LogProg.PreS A x a ∧ ∀ (s : Fin m), a.2.1 s ≤ B)
                                (some scan, v, none) (some fail, Function.update v r (v r + stride * t), none)
                          | some (a, snd) =>
                            Complexity.LogProg.AReach A oracle x
                              (fun a => Complexity.LogProg.PreS A x a ∧ ∀ (s : Fin m), a.2.1 s ≤ B) (some scan, v, none)
                              (some done, Function.update v r (v r + stride * (2 * a.length + 2)), none)
@Complexity.LogProg.arm_chain : ∀ {m d : ℕ} {Λ : Type} (A : Complexity.LogProg.ARM m d Λ)
  (oracle : Fin d → List Bool → Bool) (x : List Bool) (r : Fin m) (up : Bool) (labels : ℕ → Λ) (k B : ℕ),
  (∀ i < k,
      A (labels i) =
        bif up then Complexity.LogProg.Ins.inc r (labels (i + 1)) else Complexity.LogProg.Ins.dec r (labels (i + 1))) →
    ∀ (v : Fin m → ℕ),
      (∀ (s : Fin m), v s ≤ B) →
        (bif up then v r + k ≤ B else k ≤ v r) →
          Complexity.LogProg.AReach A oracle x (fun a => Complexity.LogProg.PreS A x a ∧ ∀ (s : Fin m), a.2.1 s ≤ B)
            (some (labels 0), v, none) (some (labels k), Function.update v r (bif up then v r + k else v r - k), none)
@Complexity.LogProg.arm_decides_poly : ∀ {m d : ℕ} {Λ : Type} {L : Language Bool} [Fintype Λ] [DecidableEq Λ]
  (A : Complexity.LogProg.ARM m d Λ) (l₀ : Λ) (As : Fin d → Language Bool),
  (∀ (j : Fin d), As j ∈ Complexity.LOGSPACE) →
    ∀ (C₀ c₀ : ℕ),
      (∀ (x : List Bool),
          Complexity.LogProg.AHalt A (fun j V => Turing.MultiTapeTM.indicator (As j) V) x
            (fun a => Complexity.LogProg.PreS A x a ∧ ∀ (r : Fin m), a.2.1 r ≤ C₀ * (x.length + 1) ^ c₀)
            (some l₀, fun x => 0, none) (Turing.MultiTapeTM.indicator L x)) →
        L ∈ Complexity.LOGSPACE
@Complexity.LogProg.astep : {m d : ℕ} →
  {Λ : Type} →
    Complexity.LogProg.ARM m d Λ →
      (Fin d → List Bool → Bool) → List Bool → Complexity.LogProg.AConf m Λ → Complexity.LogProg.AConf m Λ
@Complexity.LogProg.astep_call : ∀ {m d : ℕ} {Λ : Type} {A : Complexity.LogProg.ARM m d Λ}
  {oracle : Fin d → List Bool → Bool} {x : List Bool} {l : Λ} {v : Fin m → ℕ} {res : Option Bool} {j : Fin d}
  {md : Complexity.LogProg.Mode} {args : List (Fin m)} {l₁ l₀ : Λ},
  A l = Complexity.LogProg.Ins.call j md args l₁ l₀ →
    Complexity.LogProg.astep A oracle x (some l, v, res) =
      (some
          (if
              oracle j
                  (Complexity.LogProg.vword
                    (Complexity.LogProg.callSegs { dec := j, mode := md, args := args, yes := l₁, no := l₀ } x fun r =>
                      (v r).bits)) =
                true then
            l₁
          else l₀),
        v, res)
@Complexity.LogProg.astep_clr : ∀ {m d : ℕ} {Λ : Type} {A : Complexity.LogProg.ARM m d Λ}
  {oracle : Fin d → List Bool → Bool} {x : List Bool} {l : Λ} {v : Fin m → ℕ} {res : Option Bool} {r : Fin m} {l' : Λ},
  A l = Complexity.LogProg.Ins.clr r l' →
    Complexity.LogProg.astep A oracle x (some l, v, res) = (some l', Function.update v r 0, res)
@Complexity.LogProg.astep_dec : ∀ {m d : ℕ} {Λ : Type} {A : Complexity.LogProg.ARM m d Λ}
  {oracle : Fin d → List Bool → Bool} {x : List Bool} {l : Λ} {v : Fin m → ℕ} {res : Option Bool} {r : Fin m} {l' : Λ},
  A l = Complexity.LogProg.Ins.dec r l' →
    Complexity.LogProg.astep A oracle x (some l, v, res) = (some l', Function.update v r (v r - 1), res)
@Complexity.LogProg.astep_half : ∀ {m d : ℕ} {Λ : Type} {A : Complexity.LogProg.ARM m d Λ}
  {oracle : Fin d → List Bool → Bool} {x : List Bool} {l : Λ} {v : Fin m → ℕ} {res : Option Bool} {r : Fin m} {l' : Λ},
  A l = Complexity.LogProg.Ins.half r l' →
    Complexity.LogProg.astep A oracle x (some l, v, res) = (some l', Function.update v r (v r / 2), res)
@Complexity.LogProg.astep_inc : ∀ {m d : ℕ} {Λ : Type} {A : Complexity.LogProg.ARM m d Λ}
  {oracle : Fin d → List Bool → Bool} {x : List Bool} {l : Λ} {v : Fin m → ℕ} {res : Option Bool} {r : Fin m} {l' : Λ},
  A l = Complexity.LogProg.Ins.inc r l' →
    Complexity.LogProg.astep A oracle x (some l, v, res) = (some l', Function.update v r (v r + 1), res)
@Complexity.LogProg.astep_jeq : ∀ {m d : ℕ} {Λ : Type} {A : Complexity.LogProg.ARM m d Λ}
  {oracle : Fin d → List Bool → Bool} {x : List Bool} {l : Λ} {v : Fin m → ℕ} {res : Option Bool} {r s : Fin m}
  {l₁ l₀ : Λ},
  A l = Complexity.LogProg.Ins.jeq r s l₁ l₀ →
    Complexity.LogProg.astep A oracle x (some l, v, res) = (some (if v r = v s then l₁ else l₀), v, res)
@Complexity.LogProg.astep_jz : ∀ {m d : ℕ} {Λ : Type} {A : Complexity.LogProg.ARM m d Λ}
  {oracle : Fin d → List Bool → Bool} {x : List Bool} {l : Λ} {v : Fin m → ℕ} {res : Option Bool} {r : Fin m}
  {l₁ l₀ : Λ},
  A l = Complexity.LogProg.Ins.jz r l₁ l₀ →
    Complexity.LogProg.astep A oracle x (some l, v, res) = (some (if v r = 0 then l₁ else l₀), v, res)
@Complexity.LogProg.bankK : {d : ℕ} → (Fin d → Turing.FinTM Bool) → ℕ
@Complexity.LogProg.bankStart : {d : ℕ} →
  (Ms : Fin d → Turing.FinTM Bool) →
    Fin d → Complexity.LogProg.CleanSt (Complexity.LogProg.BankS Ms) (Complexity.LogProg.bankK Ms)
@Complexity.LogProg.bankTM : {d : ℕ} →
  (Ms : Fin d → Turing.FinTM Bool) →
    Turing.MultiTapeTM (Complexity.LogProg.bankK Ms + Complexity.LogProg.bankK Ms) Bool
      (Complexity.LogProg.CleanSt (Complexity.LogProg.BankS Ms) (Complexity.LogProg.bankK Ms))
Complexity.LogProg.bitsVal : List Bool → ℕ
Complexity.LogProg.bitsVal_bits : ∀ (n : ℕ), Complexity.LogProg.bitsVal n.bits = n
@Complexity.LogProg.boundedDecode_loop : ∀ {m d : ℕ} {Λ : Type} (A : Complexity.LogProg.ARM m d Λ)
  (oracle : Fin d → List Bool → Bool) (x : List Bool) (ptr base acc tmp : Fin m),
  ptr ≠ base →
    ptr ≠ acc →
      ptr ≠ tmp →
        base ≠ acc →
          base ≠ tmp →
            acc ≠ tmp →
              ∀ (j : Fin d) (test down read done : Λ) (copy bump clear scale take add : Bool → Λ) (incs : Bool → ℕ → Λ),
                A test = Complexity.LogProg.Ins.jeq ptr base done down →
                  A down = Complexity.LogProg.Ins.dec ptr read →
                    A read =
                        Complexity.LogProg.Ins.call j Complexity.LogProg.Mode.whole [ptr] (copy true) (copy false) →
                      (∀ (b : Bool), A (copy b) = Complexity.LogProg.Ins.jeq tmp acc (clear b) (bump b)) →
                        (∀ (b : Bool), A (bump b) = Complexity.LogProg.Ins.inc tmp (copy b)) →
                          (∀ (b : Bool), A (clear b) = Complexity.LogProg.Ins.clr acc (scale b)) →
                            (∀ (b : Bool), A (scale b) = Complexity.LogProg.Ins.jz tmp (add b) (take b)) →
                              (∀ (b : Bool), A (take b) = Complexity.LogProg.Ins.dec tmp (incs b 0)) →
                                (∀ (b : Bool),
                                    ∀ i < 2, A (incs b i) = Complexity.LogProg.Ins.inc acc (incs b (i + 1))) →
                                  (∀ (b : Bool), incs b 2 = scale b) →
                                    (∀ (b : Bool),
                                        A (add b) =
                                          if b = true then Complexity.LogProg.Ins.inc acc test
                                          else Complexity.LogProg.Ins.jz tmp test test) →
                                      ∀ (w : List Bool) (B : ℕ),
                                        (∀ i ≤ w.length, Complexity.LogProg.bitsVal (List.drop i w) ≤ B) →
                                          ∀ k ≤ w.length,
                                            ∀ (v : Fin m → ℕ),
                                              (∀ (r : Fin m), v r ≤ B) →
                                                v ptr = v base + k →
                                                  v acc = Complexity.LogProg.bitsVal (List.drop k w) →
                                                    v tmp = 0 →
                                                      (∀ i < w.length,
                                                          oracle j (Turing.pairEncode x (v base + i).bits) =
                                                            w.getD i false) →
                                                        ∃ v',
                                                          (∀ (r : Fin m), v' r ≤ B) ∧
                                                            v' ptr = v base ∧
                                                              v' acc = Complexity.LogProg.bitsVal w ∧
                                                                v' tmp = 0 ∧
                                                                  (∀ (r : Fin m),
                                                                      r ≠ ptr → r ≠ acc → r ≠ tmp → v' r = v r) ∧
                                                                    Complexity.LogProg.AReach A oracle x
                                                                      (fun a =>
                                                                        Complexity.LogProg.PreS A x a ∧
                                                                          ∀ (r : Fin m), a.2.1 r ≤ B)
                                                                      (some test, v, none) (some done, v', none)
@Complexity.LogProg.callSegs : {m d : ℕ} →
  {Λ : Type} → Complexity.LogProg.CallSpec m d Λ → List Bool → (Fin m → List Bool) → List Complexity.LogProg.Seg
Complexity.LogProg.canon_bits : ∀ (n : ℕ), Complexity.LogProg.Canon n.bits
@Complexity.LogProg.canonicalTail_loop : ∀ {m d : ℕ} {Λ : Type} (A : Complexity.LogProg.ARM m d Λ)
  (oracle : Fin d → List Bool → Bool) (x : List Bool) (ptr limit cap : Fin m),
  ptr ≠ limit →
    ptr ≠ cap →
      cap ≠ limit →
        ∀ (j : Fin d) (test : Bool → Λ) (check read fail done : Λ) (halve : Bool → Λ) (advance : Bool → ℕ → Λ)
          (stride B : ℕ),
          0 < stride →
            (∀ (b : Bool), A (test b) = Complexity.LogProg.Ins.jeq ptr limit (if b = true then done else fail) check) →
              A check = Complexity.LogProg.Ins.jz cap fail read →
                A read = Complexity.LogProg.Ins.call j Complexity.LogProg.Mode.whole [ptr] (halve true) (halve false) →
                  (∀ (b : Bool), A (halve b) = Complexity.LogProg.Ins.half cap (advance b 0)) →
                    (∀ (b : Bool), ∀ i < stride, A (advance b i) = Complexity.LogProg.Ins.inc ptr (advance b (i + 1))) →
                      (∀ (b : Bool), advance b stride = test b) →
                        ∀ (w : List Bool) (last : Bool) (v : Fin m → ℕ),
                          (∀ (r : Fin m), v r ≤ B) →
                            v limit = v ptr + stride * w.length →
                              (∀ i < w.length,
                                  oracle j (Turing.pairEncode x (v ptr + stride * i).bits) = w.getD i false) →
                                ∃ v',
                                  (∀ (r : Fin m), v' r ≤ B) ∧
                                    v' ptr ≤ v limit ∧
                                      (∀ (r : Fin m), r ≠ ptr → r ≠ cap → v' r = v r) ∧
                                        Complexity.LogProg.AReach A oracle x
                                          (fun a => Complexity.LogProg.PreS A x a ∧ ∀ (r : Fin m), a.2.1 r ≤ B)
                                          (some (test last), v, none)
                                          (some
                                              (if w.length ≤ (v cap).bits.length then
                                                if w.getLastD last = true then done else fail
                                              else fail),
                                            v', none)
@Complexity.LogProg.compileFinTM : {m d kD : ℕ} →
  {Λ SD : Type} →
    [Fintype Λ] →
      [DecidableEq Λ] →
        [Fintype SD] →
          [DecidableEq SD] →
            Complexity.LogProg.RProg m d Λ → Λ → Turing.MultiTapeTM kD Bool SD → (Fin d → SD) → Turing.FinTM Bool
Complexity.LogProg.drop_canon : ∀ (w : List Bool), w.getLastD true = true ↔ Complexity.LogProg.Canon w
@Complexity.LogProg.indexedSeek_loop : ∀ {m d : ℕ} {Λ : Type} (A : Complexity.LogProg.ARM m d Λ)
  (oracle : Fin d → List Bool → Bool) (x : List Bool) (ptr limit idx query : Fin m),
  ptr ≠ limit →
    ptr ≠ idx →
      ptr ≠ query →
        limit ≠ idx →
          limit ≠ query →
            idx ≠ query →
              ∀ (test probe bump hit miss : Λ) (advance : ℕ → Λ) (stride B : ℕ),
                0 < stride →
                  A test = Complexity.LogProg.Ins.jeq ptr limit miss probe →
                    A probe = Complexity.LogProg.Ins.jeq idx query hit bump →
                      A bump = Complexity.LogProg.Ins.inc idx (advance 0) →
                        (∀ i < stride, A (advance i) = Complexity.LogProg.Ins.inc ptr (advance (i + 1))) →
                          advance stride = test →
                            ∀ (count : ℕ) (v : Fin m → ℕ),
                              (∀ (r : Fin m), v r ≤ B) →
                                v limit = v ptr + stride * count →
                                  v idx + count ≤ B →
                                    v idx ≤ v query →
                                      if v query < v idx + count then
                                        Complexity.LogProg.AReach A oracle x
                                          (fun a => Complexity.LogProg.PreS A x a ∧ ∀ (r : Fin m), a.2.1 r ≤ B)
                                          (some test, v, none)
                                          (some hit,
                                            Function.update (Function.update v ptr (v ptr + stride * (v query - v idx)))
                                              idx (v query),
                                            none)
                                      else
                                        Complexity.LogProg.AReach A oracle x
                                          (fun a => Complexity.LogProg.PreS A x a ∧ ∀ (r : Fin m), a.2.1 r ≤ B)
                                          (some test, v, none)
                                          (some miss,
                                            Function.update (Function.update v ptr (v limit)) idx (v idx + count), none)
@Complexity.LogProg.indicator_eq_decide : ∀ {α : Type} (S : Set α) (a : α),
  Turing.MultiTapeTM.indicator S a = decide (a ∈ S)
@Complexity.LogProg.inputLength_loop : ∀ {m d : ℕ} {Λ : Type} (A : Complexity.LogProg.ARM m d Λ)
  (oracle : Fin d → List Bool → Bool) (x : List Bool) (r : Fin m) (j : Fin d) (scan inc done : Λ),
  A scan = Complexity.LogProg.Ins.call j Complexity.LogProg.Mode.whole [r] inc done →
    A inc = Complexity.LogProg.Ins.inc r scan →
      (∀ n ≤ x.length, oracle j (Turing.pairEncode x n.bits) = decide (n < x.length)) →
        ∀ (B : ℕ),
          x.length ≤ B →
            ∀ (v : Fin m → ℕ),
              (∀ (s : Fin m), v s ≤ B) →
                v r ≤ x.length →
                  Complexity.LogProg.AReach A oracle x
                    (fun a => Complexity.LogProg.PreS A x a ∧ ∀ (s : Fin m), a.2.1 s ≤ B) (some scan, v, none)
                    (some done, Function.update v r x.length, none)
@Complexity.LogProg.instDecidableEqCleanSt : {S : Type} →
  {k : ℕ} → [DecidableEq S] → DecidableEq (Complexity.LogProg.CleanSt S k)
@Complexity.LogProg.instFintypeCleanSt : {S : Type} → {k : ℕ} → [Fintype S] → Fintype (Complexity.LogProg.CleanSt S k)
Complexity.LogProg.length_bits_le_log : ∀ (n : ℕ), n.bits.length ≤ Nat.log 2 n + 1
@Complexity.LogProg.length_bits_mono : ∀ {a b : ℕ}, a ≤ b → a.bits.length ≤ b.bits.length
@Complexity.LogProg.preS_of_ins : ∀ {m d : ℕ} {Λ : Type} {x : List Bool} {A : Complexity.LogProg.ARM m d Λ} {l : Λ}
  {v : Fin m → ℕ} {res : Option Bool},
  (∀ (r s : Fin m) (l₁ l₀ : Λ), A l = Complexity.LogProg.Ins.jeq r s l₁ l₀ → r ≠ s) →
    (∀ (j : Fin d) (md : Complexity.LogProg.Mode) (args : List (Fin m)) (l₁ l₀ : Λ),
        A l = Complexity.LogProg.Ins.call j md args l₁ l₀ → args.Nodup) →
      (∀ (r : Fin m) (l₁ l₀ : Λ), A l = Complexity.LogProg.Ins.jeqIn r l₁ l₀ → Complexity.LogProg.ValidPlain x) →
        (∀ (r : Fin m) (l₁ l₀ : Λ), A l = Complexity.LogProg.Ins.jeqFst r l₁ l₀ → Complexity.LogProg.ValidPair x) →
          (∀ (r : Fin m) (l₁ l₀ : Λ), A l = Complexity.LogProg.Ins.jeqSnd r l₁ l₀ → Complexity.LogProg.ValidPair x) →
            Complexity.LogProg.PreS A x (some l, v, res)
@Complexity.LogProg.registerCopy_loop : ∀ {m d : ℕ} {Λ : Type} (A : Complexity.LogProg.ARM m d Λ)
  (oracle : Fin d → List Bool → Bool) (x : List Bool) (dst src : Fin m),
  dst ≠ src →
    ∀ (test bump done : Λ),
      A test = Complexity.LogProg.Ins.jeq dst src done bump →
        A bump = Complexity.LogProg.Ins.inc dst test →
          ∀ (B : ℕ) (v : Fin m → ℕ),
            (∀ (r : Fin m), v r ≤ B) →
              v dst ≤ v src →
                Complexity.LogProg.AReach A oracle x
                  (fun a => Complexity.LogProg.PreS A x a ∧ ∀ (r : Fin m), a.2.1 r ≤ B) (some test, v, none)
                  (some done, Function.update v dst (v src), none)
@Complexity.LogProg.registerScale_loop : ∀ {m d : ℕ} {Λ : Type} (A : Complexity.LogProg.ARM m d Λ)
  (oracle : Fin d → List Bool → Bool) (x : List Bool) (src dst : Fin m),
  src ≠ dst →
    ∀ (test down done : Λ) (inc : ℕ → Λ) (factor : ℕ),
      A test = Complexity.LogProg.Ins.jz src done down →
        A down = Complexity.LogProg.Ins.dec src (inc 0) →
          (∀ i < factor, A (inc i) = Complexity.LogProg.Ins.inc dst (inc (i + 1))) →
            inc factor = test →
              ∀ (B : ℕ) (v : Fin m → ℕ),
                (∀ (r : Fin m), v r ≤ B) →
                  v dst + factor * v src ≤ B →
                    Complexity.LogProg.AReach A oracle x
                      (fun a => Complexity.LogProg.PreS A x a ∧ ∀ (r : Fin m), a.2.1 r ≤ B) (some test, v, none)
                      (some done, Function.update (Function.update v src 0) dst (v dst + factor * v src), none)
@Complexity.LogProg.register_update_le : ∀ {m : ℕ} (v : Fin m → ℕ) (r : Fin m) (B n : ℕ),
  (∀ (s : Fin m), v s ≤ B) → n ≤ B → ∀ (s : Fin m), Function.update v r n s ≤ B
