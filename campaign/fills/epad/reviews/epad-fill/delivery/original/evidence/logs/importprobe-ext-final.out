Complexity.indicator_inputBitLang : ∀ (y : List Bool) (a : ℕ),
  Turing.MultiTapeTM.indicator Complexity.inputBitLang (Turing.pairEncode y a.bits) = y.getD a false
Complexity.indicator_inputLenLang : ∀ (y : List Bool) (a : ℕ),
  Turing.MultiTapeTM.indicator Complexity.inputLenLang (Turing.pairEncode y a.bits) = decide (a < y.length)
Complexity.inputBitLang : Language Bool
Complexity.inputBitLang_mem : Complexity.inputBitLang ∈ Complexity.LOGSPACE
Complexity.inputLenLang : Language Bool
Complexity.inputLenLang_mem : Complexity.inputLenLang ∈ Complexity.LOGSPACE
Complexity.length_pairFstD_le : ∀ (z : List Bool), (Complexity.pairFstD z).length ≤ z.length
Complexity.logSpace : ℕ → ℕ
Complexity.logSpace_le_succ : ∀ (n : ℕ), Complexity.logSpace n ≤ n + 1
@Complexity.mem_SPACE_iff : ∀ {s : ℕ → ℕ} {L : Language Bool},
  L ∈ Complexity.SPACE s ↔ ∃ c M, M.DecidesInSpace L fun n => c * s n
Complexity.pairEncode_getD : ∀ (u v : List Bool) (j : ℕ),
  (Turing.pairEncode u v).getD j false =
    if j < 2 * u.length then u.getD (j / 2) false
    else if j = 2 * u.length then false else if j = 2 * u.length + 1 then true else v.getD (j - 2 * u.length - 2) false
Complexity.pairEncode_getD_snd : ∀ (u v : List Bool) (j : ℕ),
  (Turing.pairEncode u v).getD (2 * u.length + 2 + j) false = v.getD j false
Complexity.pairFstD : List Bool → List Bool
Complexity.pairFstD_pairEncode : ∀ (a b : List Bool), Complexity.pairFstD (Turing.pairEncode a b) = a
Turing.FinTM : Type → Type 1
@Turing.FinTM.ComputesFunInTime : {Symbol : Type} → Turing.FinTM Symbol → (List Symbol → List Symbol) → (ℕ → ℕ) → Prop
Turing.FinTM.ComputesInSpace : Turing.FinTM Bool → (List Bool → List Bool) → (ℕ → ℕ) → Prop
@Turing.FinTM.ComputesInSpace.computesFunInTime_and_forall_spaceUsed_le : ∀ {M : Turing.FinTM Bool}
  {f : List Bool → List Bool} {s : ℕ → ℕ},
  M.ComputesInSpace f s →
    (M.ComputesFunInTime f fun n => M.configBound n (s n)) ∧
      ∀ (x : List Bool) (t : ℕ), Turing.MultiTapeTM.spaceUsed (Turing.MultiTapeTM.initCfg x) t ≤ s x.length
@Turing.FinTM.ComputesInTime : {Symbol : Type} → Turing.FinTM Symbol → List Symbol → List Symbol → ℕ → Prop
Turing.FinTM.DecidesInSpace : Turing.FinTM Bool → Language Bool → (ℕ → ℕ) → Prop
@Turing.FinTM.State : {Symbol : Type} → Turing.FinTM Symbol → Type
@Turing.FinTM.computesFunInTime_cond_spaceUsed : ∀ {D M₁ M₂ : Turing.FinTM Bool} {p : List Bool → Bool}
  {f₁ f₂ : List Bool → List Bool} {T₀ T₁ T₂ : ℕ → ℕ} (sD s₁ s₂ : ℕ → ℕ),
  D.ComputesFunInTime (fun x => [p x]) T₀ →
    M₁.ComputesFunInTime f₁ T₁ →
      M₂.ComputesFunInTime f₂ T₂ →
        (∀ (x : List Bool) (t : ℕ), Turing.MultiTapeTM.spaceUsed (Turing.MultiTapeTM.initCfg x) t ≤ sD x.length) →
          (∀ (x : List Bool) (t : ℕ), Turing.MultiTapeTM.spaceUsed (Turing.MultiTapeTM.initCfg x) t ≤ s₁ x.length) →
            (∀ (x : List Bool) (t : ℕ), Turing.MultiTapeTM.spaceUsed (Turing.MultiTapeTM.initCfg x) t ≤ s₂ x.length) →
              ∃ M c,
                (M.ComputesFunInTime (fun x => if p x = true then f₁ x else f₂ x) fun n =>
                    c * (T₀ n + max (T₁ n) (T₂ n) + 1)) ∧
                  ∀ (x : List Bool) (t : ℕ),
                    Turing.MultiTapeTM.spaceUsed (Turing.MultiTapeTM.initCfg x) t ≤
                      sD x.length + max (s₁ x.length) (s₂ x.length) + c
Turing.FinTM.computesFunInTime_const_spaceUsed : ∀ (w : List Bool),
  ∃ M c,
    (M.ComputesFunInTime (fun x => w) fun n => c * (n + 1)) ∧
      ∀ (x : List Bool) (t : ℕ), Turing.MultiTapeTM.spaceUsed (Turing.MultiTapeTM.initCfg x) t ≤ c
@Turing.FinTM.computesFunInTime_iff : ∀ {Symbol : Type} (M : Turing.FinTM Symbol) (f : List Symbol → List Symbol)
  (T : ℕ → ℕ), M.ComputesFunInTime f T ↔ ∀ (input : List Symbol), M.ComputesInTime input (f input) (T input.length)
Turing.FinTM.computesInSpace_iff : ∀ (M : Turing.FinTM Bool) (f : List Bool → List Bool) (s : ℕ → ℕ),
  M.ComputesInSpace f s ↔
    ∀ (x : List Bool),
      ∃ t, M.ComputesInTime x (f x) t ∧ Turing.MultiTapeTM.spaceUsed (Turing.MultiTapeTM.initCfg x) t ≤ s x.length
