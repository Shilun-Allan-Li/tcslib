@Complexity.LogProg.Ins.casesOn : {m d : ℕ} →
  {Λ : Type} →
    {motive : Complexity.LogProg.Ins m d Λ → Sort u_1} →
      (t : Complexity.LogProg.Ins m d Λ) →
        ((r : Fin m) → (l : Λ) → motive (Complexity.LogProg.Ins.inc r l)) →
          ((r : Fin m) → (l : Λ) → motive (Complexity.LogProg.Ins.dec r l)) →
            ((r : Fin m) → (l : Λ) → motive (Complexity.LogProg.Ins.clr r l)) →
              ((r : Fin m) → (l : Λ) → motive (Complexity.LogProg.Ins.half r l)) →
                ((r : Fin m) → (l₁ l₀ : Λ) → motive (Complexity.LogProg.Ins.jz r l₁ l₀)) →
                  ((r : Fin m) → (l₁ l₀ : Λ) → motive (Complexity.LogProg.Ins.jodd r l₁ l₀)) →
                    ((r s : Fin m) → (l₁ l₀ : Λ) → motive (Complexity.LogProg.Ins.jeq r s l₁ l₀)) →
                      ((j : Fin d) →
                          (mode : Complexity.LogProg.Mode) →
                            (args : List (Fin m)) →
                              (l₁ l₀ : Λ) → motive (Complexity.LogProg.Ins.call j mode args l₁ l₀)) →
                        ((b : Bool) → motive (Complexity.LogProg.Ins.ret b)) →
                          ((r : Fin m) → (l : Λ) → motive (Complexity.LogProg.Ins.valP r l)) →
                            ((r : Fin m) → (l : Λ) → motive (Complexity.LogProg.Ins.valQ r l)) →
                              ((r : Fin m) → (l₁ l₀ : Λ) → motive (Complexity.LogProg.Ins.jeqIn r l₁ l₀)) →
                                ((r : Fin m) → (l₁ l₀ : Λ) → motive (Complexity.LogProg.Ins.jeqFst r l₁ l₀)) →
                                  ((r : Fin m) → (l₁ l₀ : Λ) → motive (Complexity.LogProg.Ins.jeqSnd r l₁ l₀)) →
                                    motive t
