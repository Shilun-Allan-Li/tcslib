@Complexity.LogProg.AReach.refl : ∀ {m d : ℕ} {Λ : Type} {x : List Bool} {A : Complexity.LogProg.ARM m d Λ}
  {oracle : Fin d → List Bool → Bool} {G : Complexity.LogProg.AConf m Λ → Prop} (a : Complexity.LogProg.AConf m Λ),
