@Complexity.LogProg.AReach.single : ∀ {m d : ℕ} {Λ : Type} {x : List Bool} {A : Complexity.LogProg.ARM m d Λ}
  {oracle : Fin d → List Bool → Bool} {G : Complexity.LogProg.AConf m Λ → Prop} {a : Complexity.LogProg.AConf m Λ},
  G a → Complexity.LogProg.AReach A oracle x G a (Complexity.LogProg.astep A oracle x a)
@Complexity.LogProg.AReach.step : ∀ {m d : ℕ} {Λ : Type} {x : List Bool} {A : Complexity.LogProg.ARM m d Λ}
  {oracle : Fin d → List Bool → Bool} {G : Complexity.LogProg.AConf m Λ → Prop} {a c : Complexity.LogProg.AConf m Λ},
