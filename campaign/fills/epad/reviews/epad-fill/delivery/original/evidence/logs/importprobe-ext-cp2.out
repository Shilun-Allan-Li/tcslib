  {oracle : Fin d → List Bool → Bool} {G : Complexity.LogProg.AConf m Λ → Prop} {l : Λ} {v : Fin m → ℕ} {r : Bool},
  A l = Complexity.LogProg.Ins.ret r → G (some l, v, none) → Complexity.LogProg.AHalt A oracle x G (some l, v, none) r
