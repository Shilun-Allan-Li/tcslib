@Complexity.LogProg.AReach.halt : ∀ {m d : ℕ} {Λ : Type} {x : List Bool} {A : Complexity.LogProg.ARM m d Λ}
  {oracle : Fin d → List Bool → Bool} {G : Complexity.LogProg.AConf m Λ → Prop} {a b : Complexity.LogProg.AConf m Λ}
  {r : Bool},
  Complexity.LogProg.AReach A oracle x G a b →
