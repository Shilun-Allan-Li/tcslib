CodeFormat : Type 1
CodeFormat.parseFull : (F : CodeFormat) → List Bool → Option (F.Code × List Bool)
CodeFormat.decode : (F : CodeFormat) → List Bool → F.Code
CodeFormat.scan : CodeFormat → List Bool → Option (List Bool)
CodeFormat.canonical : CodeFormat → List Bool → List Bool
CodeFormat.parseFull_serialize_pad : ∀ (F : CodeFormat) (M : F.Code) (m : ℕ),
  F.parseFull (F.serialize M ++ List.replicate m true) = some (M, List.replicate m true)
CodeFormat.decode_serialize_pad : ∀ (F : CodeFormat) (M : F.Code) (m : ℕ),
  F.decode (F.serialize M ++ List.replicate m true) = M
CodeFormat.parseFull_sound : ∀ (F : CodeFormat) (xs : List Bool) (M : F.Code) (tail : List Bool),
  F.parseFull xs = some (M, tail) → xs = F.serialize M ++ tail
CodeFormat.scan_full : ∀ (F : CodeFormat) (xs : List Bool), F.scan xs = Option.map Prod.snd (F.parseFull xs)
CodeFormat.canonical_eq : ∀ (F : CodeFormat) (xs : List Bool), F.canonical xs = F.serialize (F.decode xs)
CodeFormat.serialize_decode_length_le : ∀ (F : CodeFormat) (α : List Bool),
  (F.serialize (F.decode α)).length ≤ max α.length (F.serialize F.fallback).length
CodeFormat.numStates_decode_le : ∀ (F : CodeFormat) (α : List Bool),
  F.guard * (F.numStates (F.decode α) + 1) ≤ max α.length (F.serialize F.fallback).length
CodeFormat.decode_of_parseFull_none : ∀ (F : CodeFormat) (α : List Bool), F.parseFull α = none → F.decode α = F.fallback
CodeFormat.decode_of_guard_lt : ∀ (F : CodeFormat) (α bits rest : List Bool),
  pairDecode α = some (bits, rest) → rest.length < F.guard * (codeBitsNat bits + 1) → F.decode α = F.fallback
CodeFormat.exists_canonizer : ∀ (F : CodeFormat),
  Primrec₂ F.skipTable → ∃ M T, M.ComputesFunInTime (fun xs => F.serialize (F.decode xs)) T
CodeFormat.primrec_canonical : ∀ (F : CodeFormat), Primrec₂ F.skipTable → Primrec F.canonical
@actionBitsK : {k n : ℕ} → Action k Bool (Fin (n + 1)) → List Bool
codeReadActionK : (k n : ℕ) → List Bool → Option (Action k Bool (Fin (n + 1)) × List Bool)
@codeReadActionK_append : ∀ {k n : ℕ} (a : Action k Bool (Fin (n + 1))) (xs : List Bool),
