            else d.workTapes j q,
          workTapePos := d.workTapePos, output := d.output } ∧
      (∀ t < 2 * w₀.length + 2, (MultiTapeTM.runFrom d t).state ≠ some WritePhase.done) ∧
        ∀ (j : Fin k),
          ∀ t ≤ 2 * w₀.length + 2,
            if j = i then
              (MultiTapeTM.runFrom d t).workTapePos j ∈ Finset.Icc (d.workTapePos j) (d.workTapePos j + ↑w₀.length)
            else (MultiTapeTM.runFrom d t).workTapePos j = d.workTapePos j
@writeAdvTM_run_ofCfg : ∀ {Symbol : Type u_1} {k : ℕ} {x : List Symbol} (i : Fin k) (w₀ : List Symbol)
  (d : Cfg k Symbol (Fin (w₀.length + 1)) x),
  d.state = some 0 →
    MultiTapeTM.runFrom d (w₀.length + 1) =
        { state := some 0, inputPos := d.inputPos,
          workTapes := fun j q =>
            if j = i ∧ d.workTapePos j ≤ q ∧ q < d.workTapePos j + ↑w₀.length then
              FinTM.bufferTape w₀ (q - d.workTapePos j)
            else d.workTapes j q,
          workTapePos := Function.update d.workTapePos i (d.workTapePos i + ↑w₀.length), output := d.output } ∧
      (∀ (t : ℕ), 0 < t → t < w₀.length + 1 → (MultiTapeTM.runFrom d t).state ≠ some 0) ∧
        ∀ (j : Fin k),
          ∀ t ≤ w₀.length + 1,
            if j = i then
              (MultiTapeTM.runFrom d t).workTapePos j ∈ Finset.Icc (d.workTapePos j) (d.workTapePos j + ↑w₀.length)
            else (MultiTapeTM.runFrom d t).workTapePos j = d.workTapePos j
@tapeAction : {k : ℕ} →
  {Symbol : Type u_1} →
    {State : Type u_2} → Fin k → SignType → Option (Option Symbol) → SignType → State → Action k Symbol State
@inputMoveAction : {k : ℕ} → {Symbol : Type u_1} → {State : Type u_2} → SignType → State → Action k Symbol State
@step_of_inputMoveAction : ∀ {Symbol : Type u_1} {State : Type u_2} {k : ℕ} {x : List Symbol}
  (M : MultiTapeTM k Symbol State) (c : Cfg k Symbol State x) {q q' : State} (inp : SignType),
  c.state = some q →
    M.tr q c.inputSymbol c.workTapeSymbols = inputMoveAction inp q' →
      MultiTapeTM.step c =
        { state := some q', inputPos := moveInputPos c.inputPos inp, workTapes := c.workTapes,
          workTapePos := c.workTapePos, output := c.output }
@step_of_tapeAction_move : ∀ {Symbol : Type u_1} {State : Type u_2} {k : ℕ} {x : List Symbol}
  (M : MultiTapeTM k Symbol State) (c : Cfg k Symbol State x) {q q' : State} (i : Fin k) (inp m : SignType),
  c.state = some q →
    M.tr q c.inputSymbol c.workTapeSymbols = tapeAction i inp none m q' →
      MultiTapeTM.step c =
        { state := some q', inputPos := moveInputPos c.inputPos inp, workTapes := c.workTapes,
          workTapePos := Function.update c.workTapePos i (c.workTapePos i + ↑m), output := c.output }
@copyTM_run : ∀ {x : List Bool} (k : ℕ) (src dst : Fin k),
  src ≠ dst →
    ∀ (w : Fin k → List Bool),
      w dst = [] →
        ∃ T ≤ 3 * (w src).length + 3,
          (∀ t < T, (MultiTapeTM.runFrom (Cfg.ofWords SweepPhase.sweep w) t).state ≠ some SweepPhase.done) ∧
            MultiTapeTM.runFrom (Cfg.ofWords SweepPhase.sweep w) T =
              Cfg.ofWords SweepPhase.done (Function.update w dst (w src))
@transferTM_run : ∀ {x : List Bool} (k : ℕ) (src dst : Fin k),
  src ≠ dst →
    ∀ (w : Fin k → List Bool),
      w dst = [] →
        ∃ T ≤ 3 * (w src).length + 3,
          (∀ t < T, (MultiTapeTM.runFrom (Cfg.ofWords SweepPhase.sweep w) t).state ≠ some SweepPhase.done) ∧
            MultiTapeTM.runFrom (Cfg.ofWords SweepPhase.sweep w) T =
              Cfg.ofWords SweepPhase.done (Function.update (Function.update w src []) dst (w src))
@clearTM_run : ∀ {x : List Bool} (k : ℕ) (i : Fin k) (w : Fin k → List Bool),
  ∃ T ≤ 2 * (w i).length + 2,
    (∀ t < T, (MultiTapeTM.runFrom (Cfg.ofWords SweepPhase.sweep w) t).state ≠ some SweepPhase.done) ∧
      MultiTapeTM.runFrom (Cfg.ofWords SweepPhase.sweep w) T = Cfg.ofWords SweepPhase.done (Function.update w i [])
@compareTM_run : ∀ {x : List Bool} (k : ℕ) (fst snd : Fin k) (w : Fin k → List Bool),
  ∃ T ≤ 2 * min (w fst).length (w snd).length + 2,
    (∀ t < T, ∀ (v : Bool), (MultiTapeTM.runFrom (Cfg.ofWords FlagPhase.run w) t).state ≠ some (FlagPhase.done v)) ∧
      MultiTapeTM.runFrom (Cfg.ofWords FlagPhase.run w) T = Cfg.ofWords (FlagPhase.done (decide (w fst = w snd))) w
@incrementTM_run_succ : ∀ {x : List Bool} (k : ℕ) (i : Fin k) (w : Fin k → List Bool) (v : List Bool),
  incFixed (w i) = some v →
    ∃ T ≤ 2 * (w i).length + 2,
      (∀ t < T, ∀ (b : Bool), (MultiTapeTM.runFrom (Cfg.ofWords FlagPhase.run w) t).state ≠ some (FlagPhase.done b)) ∧
        MultiTapeTM.runFrom (Cfg.ofWords FlagPhase.run w) T = Cfg.ofWords (FlagPhase.done true) (Function.update w i v)
@incrementTM_run_overflow : ∀ {x : List Bool} (k : ℕ) (i : Fin k) (w : Fin k → List Bool),
  incFixed (w i) = none →
    ∃ T ≤ 2 * (w i).length + 2,
      (∀ t < T, ∀ (b : Bool), (MultiTapeTM.runFrom (Cfg.ofWords FlagPhase.run w) t).state ≠ some (FlagPhase.done b)) ∧
        MultiTapeTM.runFrom (Cfg.ofWords FlagPhase.run w) T =
          Cfg.ofWords (FlagPhase.done false) (Function.update w i (List.replicate (w i).length false))
@counterLoopBody_state : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} (a : S) (d : Cfg (k + 1) Γ (CounterLoopState S) x),
  (counterLoopBody a d).state = some a
@counterLoopBody_inputPos : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} (a : S) (d : Cfg (k + 1) Γ (CounterLoopState S) x),
  (counterLoopBody a d).inputPos = d.inputPos
@counterLoopBody_workTapes : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} (a : S) (d : Cfg (k + 1) Γ (CounterLoopState S) x)
  (j : Fin k) (a_1 : ℤ), (counterLoopBody a d).workTapes j a_1 = d.workTapes j.castSucc a_1
@counterLoopBody_workTapePos : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} (a : S) (d : Cfg (k + 1) Γ (CounterLoopState S) x)
  (j : Fin k), (counterLoopBody a d).workTapePos j = d.workTapePos j.castSucc
@counterLoopBody_output : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} (a : S) (d : Cfg (k + 1) Γ (CounterLoopState S) x),
  (counterLoopBody a d).output = d.output
stateWord_eq : ∀ (k : ℕ) (s : List Bool) (i : Fin k), stateWord k s i = if ↑i = 0 then s else []
decFixed_nil : decFixed [] = none
decFixed_true_cons : ∀ (w : List Bool), decFixed (true :: w) = some (false :: w)
decFixed_false_cons : ∀ (w : List Bool), decFixed (false :: w) = Option.map (fun x => true :: x) (decFixed w)
@round_iff : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} (M : MultiTapeTM k Γ S) (a : S) (E : Set (Option S))
  (P : (Fin k → ℤ) → Prop) (c c' : Cfg k Γ S x) (t : ℕ),
  Round M a E P c c' t ↔
    c.state = some a ∧
      0 < t ∧
        MultiTapeTM.runFrom c t = c' ∧
          c'.state ∈ insert (some a) E ∧
            (∀ (u : ℕ), 0 < u → u < t → (MultiTapeTM.runFrom c u).state ∉ roundStop a E) ∧
              ∀ u ≤ t, P (MultiTapeTM.runFrom c u).workTapePos
@segment_iff : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} (M : MultiTapeTM k Γ S) (F : Set (Option S)) (P : (Fin k → ℤ) → Prop)
  (a b : Cfg k Γ S x) (t : ℕ),
  Segment M F P a b t ↔
    MultiTapeTM.runFrom a t = b ∧
      (∀ u < t, (MultiTapeTM.runFrom a u).state ∉ F) ∧ ∀ u ≤ t, P (MultiTapeTM.runFrom a u).workTapePos
@headBox_iff : ∀ {k : ℕ} (lo hi p : Fin k → ℤ), HeadBox lo hi p ↔ ∀ (j : Fin k), p j ∈ Finset.Icc (lo j) (hi j)
@roundOrbit_zero : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} (M : MultiTapeTM k Γ S) (τ : Cfg k Γ S x → ℕ) (c : Cfg k Γ S x),
  roundOrbit M τ c 0 = c
@Contract.traj_iff : ∀ {k : ℕ} {Γ S : Type} {M : MultiTapeTM k Γ S} {entry : S} {exits : Set (Option S)} {ι : Type}
  {x : List Γ} (C : Contract M entry exits ι x) (R : ι → Cfg k Γ S x → (Fin k → ℤ) → Prop),
  C.Traj R ↔
    ∀ (i : ι) (d : Cfg k Γ S x),
      d.state = some entry → C.pre i d → ∀ u ≤ C.time i d, R i d (MultiTapeTM.runFrom d u).workTapePos
codeSkipRepeat_zero : ∀ (r : List Bool → Option (List Bool)) (xs : List Bool), codeSkipRepeat r 0 xs = some xs
codeSkipRepeat_succ : ∀ (r : List Bool → Option (List Bool)) (n : ℕ) (xs : List Bool),
  codeSkipRepeat r (n + 1) xs = (r xs).bind (codeSkipRepeat r n)
@RoundContract.counterLoopDone_pre : ∀ {k : ℕ} {Γ S : Type} [inst : DecidableEq S] [inst_1 : DecidableEq Γ]
  (e : Bool ↪ Γ) {M : MultiTapeTM k Γ S} {a : S} {exit : Option S} {ι : Type} {x : List Γ}
  (R : RoundContract M a {exit} ι x) (p : ι × List Bool) (d : Cfg (k + 1) Γ (CounterLoopState S) x),
  (RoundContract.counterLoopDone e R).pre p d =
    ((∀ (q : ℤ),
        -1 ≤ q →
          q ≤ ↑p.2.length →
            d.workTapes (Fin.last k) (d.workTapePos (Fin.last k) + q) = FinTM.bufferTape (List.map (⇑e) p.2) q) ∧
      ∀ r < counterValue p.2,
        R.pre p.1 (roundOrbit M (R.time p.1) (counterLoopBody a d) r) ∧
          (R.post p.1 (roundOrbit M (R.time p.1) (counterLoopBody a d) r)).state = some a)
@RoundContract.counterLoopDone_time : ∀ {k : ℕ} {Γ S : Type} [inst : DecidableEq S] [inst_1 : DecidableEq Γ]
  (e : Bool ↪ Γ) {M : MultiTapeTM k Γ S} {a : S} {exit : Option S} {ι : Type} {x : List Γ}
  (R : RoundContract M a {exit} ι x) (p : ι × List Bool) (d : Cfg (k + 1) Γ (CounterLoopState S) x),
  (RoundContract.counterLoopDone e R).time p d =
    ∑ r ∈ Finset.range (counterValue p.2), R.time p.1 (roundOrbit M (R.time p.1) (counterLoopBody a d) r) +
      counterOverhead p.2 (counterValue p.2 + 1)
@RoundContract.counterLoopDone_post : ∀ {k : ℕ} {Γ S : Type} [inst : DecidableEq S] [inst_1 : DecidableEq Γ]
  (e : Bool ↪ Γ) {M : MultiTapeTM k Γ S} {a : S} {exit : Option S} {ι : Type} {x : List Γ}
  (R : RoundContract M a {exit} ι x) (p : ι × List Bool) (d : Cfg (k + 1) Γ (CounterLoopState S) x),
  (RoundContract.counterLoopDone e R).post p d =
    counterLoopCfg (some CounterLoopState.done) (roundOrbit M (R.time p.1) (counterLoopBody a d) (counterValue p.2))
      (fun q =>
        if d.workTapePos (Fin.last k) ≤ q ∧ q < d.workTapePos (Fin.last k) + ↑p.2.length then some (e true)
        else d.workTapes (Fin.last k) q)
      (d.workTapePos (Fin.last k))
@RoundContract.counterLoopDone_lo : ∀ {k : ℕ} {Γ S : Type} [inst : DecidableEq S] [inst_1 : DecidableEq Γ]
  (e : Bool ↪ Γ) {M : MultiTapeTM k Γ S} {a : S} {exit : Option S} {ι : Type} {x : List Γ}
  (R : RoundContract M a {exit} ι x) (p : ι × List Bool) (d : Cfg (k + 1) Γ (CounterLoopState S) x) (i : Fin (k + 1)),
  (RoundContract.counterLoopDone e R).lo p d i =
    Fin.lastCases (d.workTapePos (Fin.last k) - 1) (R.hullLo p.1 (counterLoopBody a d) (counterValue p.2)) i
@RoundContract.counterLoopDone_hi : ∀ {k : ℕ} {Γ S : Type} [inst : DecidableEq S] [inst_1 : DecidableEq Γ]
  (e : Bool ↪ Γ) {M : MultiTapeTM k Γ S} {a : S} {exit : Option S} {ι : Type} {x : List Γ}
  (R : RoundContract M a {exit} ι x) (p : ι × List Bool) (d : Cfg (k + 1) Γ (CounterLoopState S) x) (i : Fin (k + 1)),
  (RoundContract.counterLoopDone e R).hi p d i =
    Fin.lastCases (d.workTapePos (Fin.last k) + ↑p.2.length) (R.hullHi p.1 (counterLoopBody a d) (counterValue p.2)) i
@RoundContract.counterLoopEscape_pre : ∀ {k : ℕ} {Γ S : Type} [inst : DecidableEq S] [inst_1 : DecidableEq Γ]
  (e : Bool ↪ Γ) {M : MultiTapeTM k Γ S} {a ex : S} (hea : ex ≠ a) {ι : Type} {x : List Γ}
  (R : RoundContract M a {some ex} ι x) (p : ι × List Bool × ℕ) (d : Cfg (k + 1) Γ (CounterLoopState S) x),
  (RoundContract.counterLoopEscape e hea R).pre p d =
    ((∀ (q : ℤ),
        -1 ≤ q →
          q ≤ ↑p.2.1.length →
            d.workTapes (Fin.last k) (d.workTapePos (Fin.last k) + q) = FinTM.bufferTape (List.map (⇑e) p.2.1) q) ∧
      p.2.2 < counterValue p.2.1 ∧
        (∀ r < p.2.2 + 1, R.pre p.1 (roundOrbit M (R.time p.1) (counterLoopBody a d) r)) ∧
          (∀ r < p.2.2, (R.post p.1 (roundOrbit M (R.time p.1) (counterLoopBody a d) r)).state = some a) ∧
            (R.post p.1 (roundOrbit M (R.time p.1) (counterLoopBody a d) p.2.2)).state = some ex)
@RoundContract.counterLoopEscape_time : ∀ {k : ℕ} {Γ S : Type} [inst : DecidableEq S] [inst_1 : DecidableEq Γ]
  (e : Bool ↪ Γ) {M : MultiTapeTM k Γ S} {a ex : S} (hea : ex ≠ a) {ι : Type} {x : List Γ}
  (R : RoundContract M a {some ex} ι x) (p : ι × List Bool × ℕ) (d : Cfg (k + 1) Γ (CounterLoopState S) x),
  (RoundContract.counterLoopEscape e hea R).time p d =
    ∑ r ∈ Finset.range (p.2.2 + 1), R.time p.1 (roundOrbit M (R.time p.1) (counterLoopBody a d) r) +
      counterOverhead p.2.1 (p.2.2 + 1)
@RoundContract.counterLoopEscape_post : ∀ {k : ℕ} {Γ S : Type} [inst : DecidableEq S] [inst_1 : DecidableEq Γ]
  (e : Bool ↪ Γ) {M : MultiTapeTM k Γ S} {a ex : S} (hea : ex ≠ a) {ι : Type} {x : List Γ}
  (R : RoundContract M a {some ex} ι x) (p : ι × List Bool × ℕ) (d : Cfg (k + 1) Γ (CounterLoopState S) x),
  (RoundContract.counterLoopEscape e hea R).post p d =
    counterLoopCfg (some CounterLoopState.escape) (roundOrbit M (R.time p.1) (counterLoopBody a d) (p.2.2 + 1))
      (fun q =>
        if d.workTapePos (Fin.last k) ≤ q ∧ q < d.workTapePos (Fin.last k) + ↑p.2.1.length then
          FinTM.bufferTape (List.map (⇑e) (counterWord p.2.1 (p.2.2 + 1))) (q - d.workTapePos (Fin.last k))
        else d.workTapes (Fin.last k) q)
      (d.workTapePos (Fin.last k))
@RoundContract.counterLoopEscape_lo : ∀ {k : ℕ} {Γ S : Type} [inst : DecidableEq S] [inst_1 : DecidableEq Γ]
  (e : Bool ↪ Γ) {M : MultiTapeTM k Γ S} {a ex : S} (hea : ex ≠ a) {ι : Type} {x : List Γ}
  (R : RoundContract M a {some ex} ι x) (p : ι × List Bool × ℕ) (d : Cfg (k + 1) Γ (CounterLoopState S) x)
