@tapeAction : {k : ℕ} →
  {Symbol : Type u_1} →
    {State : Type u_2} → Fin k → SignType → Option (Option Symbol) → SignType → State → Action k Symbol State
@inputMoveAction : {k : ℕ} → {Symbol : Type u_1} → {State : Type u_2} → SignType → State → Action k Symbol State
@step_of_inputMoveAction : ∀ {Symbol : Type u_1} {State : Type u_2} {k : ℕ} {x : List Symbol}
  (M : MultiTapeTM k Symbol State) (c : Cfg k Symbol State x) {q q' : State} (inp : SignType),
  c.state = some q →
    M.tr q c.inputSymbol c.workTapeSymbols = inputMoveAction inp q' →
      MultiTapeTM.step c =
        { state := some q', inputPos := moveInputPos c.inputPos inp, workTapes := c.workTapes,
          workTapePos := c.workTapePos, output := c.output }
@step_of_tapeAction_move : ∀ {Symbol : Type u_1} {State : Type u_2} {k : ℕ} {x : List Symbol}
  (M : MultiTapeTM k Symbol State) (c : Cfg k Symbol State x) {q q' : State} (i : Fin k) (inp m : SignType),
  c.state = some q →
    M.tr q c.inputSymbol c.workTapeSymbols = tapeAction i inp none m q' →
      MultiTapeTM.step c =
        { state := some q', inputPos := moveInputPos c.inputPos inp, workTapes := c.workTapes,
          workTapePos := Function.update c.workTapePos i (c.workTapePos i + ↑m), output := c.output }
@copyTM_run : ∀ {x : List Bool} (k : ℕ) (src dst : Fin k),
  src ≠ dst →
    ∀ (w : Fin k → List Bool),
      w dst = [] →
        ∃ T ≤ 3 * (w src).length + 3,
          (∀ t < T, (MultiTapeTM.runFrom (Cfg.ofWords SweepPhase.sweep w) t).state ≠ some SweepPhase.done) ∧
            MultiTapeTM.runFrom (Cfg.ofWords SweepPhase.sweep w) T =
              Cfg.ofWords SweepPhase.done (Function.update w dst (w src))
@transferTM_run : ∀ {x : List Bool} (k : ℕ) (src dst : Fin k),
  src ≠ dst →
    ∀ (w : Fin k → List Bool),
      w dst = [] →
        ∃ T ≤ 3 * (w src).length + 3,
          (∀ t < T, (MultiTapeTM.runFrom (Cfg.ofWords SweepPhase.sweep w) t).state ≠ some SweepPhase.done) ∧
            MultiTapeTM.runFrom (Cfg.ofWords SweepPhase.sweep w) T =
              Cfg.ofWords SweepPhase.done (Function.update (Function.update w src []) dst (w src))
@clearTM_run : ∀ {x : List Bool} (k : ℕ) (i : Fin k) (w : Fin k → List Bool),
  ∃ T ≤ 2 * (w i).length + 2,
    (∀ t < T, (MultiTapeTM.runFrom (Cfg.ofWords SweepPhase.sweep w) t).state ≠ some SweepPhase.done) ∧
      MultiTapeTM.runFrom (Cfg.ofWords SweepPhase.sweep w) T = Cfg.ofWords SweepPhase.done (Function.update w i [])
@compareTM_run : ∀ {x : List Bool} (k : ℕ) (fst snd : Fin k) (w : Fin k → List Bool),
  ∃ T ≤ 2 * min (w fst).length (w snd).length + 2,
    (∀ t < T, ∀ (v : Bool), (MultiTapeTM.runFrom (Cfg.ofWords FlagPhase.run w) t).state ≠ some (FlagPhase.done v)) ∧
      MultiTapeTM.runFrom (Cfg.ofWords FlagPhase.run w) T = Cfg.ofWords (FlagPhase.done (decide (w fst = w snd))) w
@incrementTM_run_succ : ∀ {x : List Bool} (k : ℕ) (i : Fin k) (w : Fin k → List Bool) (v : List Bool),
  incFixed (w i) = some v →
    ∃ T ≤ 2 * (w i).length + 2,
      (∀ t < T, ∀ (b : Bool), (MultiTapeTM.runFrom (Cfg.ofWords FlagPhase.run w) t).state ≠ some (FlagPhase.done b)) ∧
        MultiTapeTM.runFrom (Cfg.ofWords FlagPhase.run w) T = Cfg.ofWords (FlagPhase.done true) (Function.update w i v)
@incrementTM_run_overflow : ∀ {x : List Bool} (k : ℕ) (i : Fin k) (w : Fin k → List Bool),
  incFixed (w i) = none →
    ∃ T ≤ 2 * (w i).length + 2,
      (∀ t < T, ∀ (b : Bool), (MultiTapeTM.runFrom (Cfg.ofWords FlagPhase.run w) t).state ≠ some (FlagPhase.done b)) ∧
        MultiTapeTM.runFrom (Cfg.ofWords FlagPhase.run w) T =
          Cfg.ofWords (FlagPhase.done false) (Function.update w i (List.replicate (w i).length false))

