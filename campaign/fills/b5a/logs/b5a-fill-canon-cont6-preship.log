  (RoundContract.counterLoopEscape e hea R).lo p d i =
    Fin.lastCases (d.workTapePos (Fin.last k) - 1) (R.hullLo p.1 (counterLoopBody a d) (p.2.2 + 1)) i
@RoundContract.counterLoopEscape_hi : ∀ {k : ℕ} {Γ S : Type} [inst : DecidableEq S] [inst_1 : DecidableEq Γ]
  (e : Bool ↪ Γ) {M : MultiTapeTM k Γ S} {a ex : S} (hea : ex ≠ a) {ι : Type} {x : List Γ}
  (R : RoundContract M a {some ex} ι x) (p : ι × List Bool × ℕ) (d : Cfg (k + 1) Γ (CounterLoopState S) x)
  (i : Fin (k + 1)),
  (RoundContract.counterLoopEscape e hea R).hi p d i =
    Fin.lastCases (d.workTapePos (Fin.last k) + ↑p.2.1.length) (R.hullHi p.1 (counterLoopBody a d) (p.2.2 + 1)) i

