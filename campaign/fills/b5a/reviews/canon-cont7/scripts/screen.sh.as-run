#!/usr/bin/env bash
# usage: screen.sh <worktree> <out prefix>: the v3 screen on the brief's population, under the lock, niced.
S=/private/tmp/claude-501/-Users-seyoonr-phd-experiments-tcslib/8f0076bc-454a-4666-b8cf-f4c7ed13c549/scratchpad
W="$1"; OUT="$2"
P=campaign/fills/b5a/inputs/b5a-fill-canon-cont7/screen-population.txt
echo "waiting for lock $(date -u +%FT%TZ)" > "$OUT.status"
until mkdir $S/locks/screen.lock 2>/dev/null; do sleep 15; done
trap 'rmdir $S/locks/screen.lock' EXIT
echo "lock acquired $(date -u +%FT%TZ); worktree $W at $(git -C "$W" rev-parse HEAD); status: $(git -C "$W" status --porcelain | tr '\n' ' ')" >> "$OUT.status"
cd "$W" || exit 1
t0=$(date +%s)
nice -n 10 python3 -I scripts/copy-text-screen-v3.py . $(grep -v '^#' $P) > "$OUT.txt" 2> "$OUT.err"
st=$?
echo "exit=$st elapsed=$(( $(date +%s) - t0 ))s end $(date -u +%FT%TZ)" >> "$OUT.status"
