@Turing.exists_interpreterStartup : ∀ {k : ℕ} (n : List Bool → ℕ)
  (M : (α : List Bool) → Turing.MultiTapeTM k Bool (Fin (n α + 1))) (CI : Turing.FinTM Bool) (entryI doneI : CI.State)
  (costI : List Bool → ℕ),
  0 < CI.k →
    (∀ (x α : List Bool),
        ∃ T ≤ costI α,
          0 < T ∧
            (∀ (u : ℕ),
                0 < u →
                  u < T →
                    (Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords entryI (Turing.stateWord CI.k α)) u).state ≠
                      some doneI) ∧
              Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords entryI (Turing.stateWord CI.k α)) T =
                Turing.Cfg.ofWords doneI
                  (Turing.stateWord CI.k
                    (Turing.pairEncode (n α).bits (Turing.unaryFin (M α).q₀ ++ Turing.tableBitsK (M α).tr)))) →
      ∀ (p : ℕ),
        ∃ K Q x x U entry done ιP jctr jwin jtbl jsm A B,
          jctr ≠ jwin ∧
            jctr ≠ jtbl ∧
              jctr ≠ jsm ∧
                jwin ≠ jtbl ∧
                  jwin ≠ jsm ∧
                    jtbl ≠ jsm ∧
                      jctr ∉ Set.range ⇑ιP ∧
                        jwin ∉ Set.range ⇑ιP ∧
                          jtbl ∉ Set.range ⇑ιP ∧
                            jsm ∉ Set.range ⇑ιP ∧
                              ∀ (α x : List Bool) (t : ℕ) (tapes₀ : Fin K → ℤ → Option Bool),
                                (∀ j ∉ Set.range ⇑ιP, tapes₀ j = fun x => none) →
                                  ∃
                                    T ≤
                                      costI α +
                                          A *
                                            (α.length +
                                                (Turing.pairEncode (n α).bits
                                                    (Turing.unaryFin (M α).q₀ ++ Turing.tableBitsK (M α).tr)).length +
                                              1) +
                                        B * (t.bits.length + min t x.length + 1),
                                    (Turing.MultiTapeTM.runFrom
                                            { state := some entry, inputPos := 1, workTapes := tapes₀,
                                              workTapePos := fun x => 0, output := [] }
                                            T).state =
                                        some done ∧
                                      (∀ u < T,
                                          (Turing.MultiTapeTM.runFrom
                                                { state := some entry, inputPos := 1, workTapes := tapes₀,
                                                  workTapePos := fun x => 0, output := [] }
                                                u).state ≠
                                            some done) ∧
                                        have c :=
                                          Turing.MultiTapeTM.runFrom
                                            { state := some entry, inputPos := 1, workTapes := tapes₀,
                                              workTapePos := fun x => 0, output := [] }
                                            T;
                                        c.inputPos = 1 ∧
                                          c.output = [] ∧
                                            c.workTapes jctr = Turing.FinTM.bufferTape t.bits ∧
                                              c.workTapePos jctr = 0 ∧
                                                c.workTapes jwin = Turing.FinTM.bufferTape (List.take t x) ∧
                                                  c.workTapePos jwin = 0 ∧
                                                    c.workTapes jtbl =
                                                        Turing.FinTM.bufferTape (Turing.tableBitsK (M α).tr) ∧
                                                      c.workTapePos jtbl = 0 ∧ ⋯ ∧ ⋯
