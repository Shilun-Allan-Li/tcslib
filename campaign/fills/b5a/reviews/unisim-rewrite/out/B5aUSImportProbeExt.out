  {Symbol S : Type} →
    {x : List Symbol} →
      Turing.MultiTapeTM k Symbol S →
        (Turing.Cfg k Symbol S x → ℕ) → Turing.Cfg k Symbol S x → ℕ → Turing.Cfg k Symbol S x
