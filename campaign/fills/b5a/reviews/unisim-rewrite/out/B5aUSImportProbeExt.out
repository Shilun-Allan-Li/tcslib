Turing.MachineFormat.exists_uniformSimulator : ∀ (F : Turing.MachineFormat),
  ∃ S d,
    ∀ (α x : List Bool) (t : ℕ),
      ((F.toFinTM (F.decode α)).ComputesInTime x [true] t →
          S.ComputesInTime (Turing.pairEncode (Turing.pairEncode t.bits α) x) [true]
            (d * (α.length + x.length + t + 1) ^ d)) ∧
        (¬(F.toFinTM (F.decode α)).ComputesInTime x [true] t →
          S.ComputesInTime (Turing.pairEncode (Turing.pairEncode t.bits α) x) [false]
            (d * (α.length + x.length + t + 1) ^ d))
Turing.MachineFormat.exists_polyCanonizer : ∀ (F : Turing.MachineFormat),
  ∃ C d, C.ComputesFunInTime (fun α => F.serialize (F.decode α)) fun n => d * (n + 1) ^ d
Turing.MachineFormat : Type 1
Turing.MachineFormat.toFinTM : (F : Turing.MachineFormat) → F.Code → Turing.FinTM Bool
Turing.MachineFormat.machine : (self : Turing.MachineFormat) →
  (M : self.Code) → Turing.MultiTapeTM self.k Bool (Fin (self.numStates M + 1))
Turing.MachineFormat.serialize_eq : ∀ (self : Turing.MachineFormat) (M : self.Code),
  self.serialize M = Turing.serializeK (self.machine M)
Turing.MachineFormat.skipTable_eq : ∀ (self : Turing.MachineFormat) (n : ℕ) (xs : List Bool),
  self.skipTable n xs = Turing.codeSkipTableK self.k n xs
Turing.CodeFormat.decode : (F : Turing.CodeFormat) → List Bool → F.Code
Turing.CodeFormat.serialize_decode_length_le : ∀ (F : Turing.CodeFormat) (α : List Bool),
  (F.serialize (F.decode α)).length ≤ max α.length (F.serialize F.fallback).length
Turing.CodeFormat.numStates_decode_le : ∀ (F : Turing.CodeFormat) (α : List Bool),
  F.guard * (F.numStates (F.decode α) + 1) ≤ max α.length (F.serialize F.fallback).length
@Turing.serializeK : {k n : ℕ} → Turing.MultiTapeTM k Bool (Fin (n + 1)) → List Bool
@Turing.serializeK_eq : ∀ {k n : ℕ} (M : Turing.MultiTapeTM k Bool (Fin (n + 1))),
  Turing.serializeK M = Turing.pairEncode n.bits (Turing.unaryFin M.q₀ ++ Turing.tableBitsK M.tr)
Turing.prefixCanonTM : Turing.FinTM Bool → Turing.FinTM Bool
Turing.prefixCanonTM_eq : ∀ (F : Turing.FinTM Bool), Turing.prefixCanonTM F = Turing.universalPrefixTM.bufferedCompTM F
Turing.prefixCanon_complete : ∀ (F : Turing.FinTM Bool) (f : List Bool → List Bool) (τ : ℕ → ℕ),
  F.ComputesFunInTime f τ →
    ∀ (α x : List Bool),
      have cfg :=
        Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg (Turing.pairEncode α x)) (3 * α.length + 4 + τ α.length);
      cfg.state = none ∧ cfg.output = f α ∧ ↑cfg.inputPos = 2 * α.length + 3
Turing.FinTM.pairExtractTM : Bool → Bool → Turing.FinTM Bool
Turing.FinTM.pairExtractTM_fst : (Turing.FinTM.pairExtractTM true false).ComputesFunInTime
  (fun x => (Option.map Prod.fst (Turing.pairDecode x)).getD []) fun n => 5 * (n + 1)
Turing.FinTM.pairExtractTM_snd : (Turing.FinTM.pairExtractTM false true).ComputesFunInTime
  (fun x => (Option.map Prod.snd (Turing.pairDecode x)).getD []) fun n => 5 * (n + 1)
Turing.FinTM.pairExtractTM_fst_run : ∀ (a b : List Bool),
  Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg (Turing.pairEncode a b)) (4 * a.length + 5) =
      { state := none, inputPos := ⟨2 * a.length + 3, ⋯⟩, workTapes := fun x => Turing.FinTM.bufferTape a,
        workTapePos := fun x => ↑a.length, output := a } ∧
    ∀ u < 4 * a.length + 5,
      (Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg (Turing.pairEncode a b)) u).state ≠ none
Turing.pairEncode_eq : ∀ (x α : List Bool),
  Turing.pairEncode x α = List.flatMap (fun b => [b, b]) x ++ [false, true] ++ α
Turing.length_pairEncode : ∀ (x y : List Bool), (Turing.pairEncode x y).length = 2 * x.length + 2 + y.length
Turing.pairDecode_pairEncode : ∀ (x α : List Bool), Turing.pairDecode (Turing.pairEncode x α) = some (x, α)
@Turing.embedSilentRetTM : {m k : ℕ} →
  {S : Type u_1} →
    {Symbol : Type u_2} →
      (Fin m ↪ Fin k) → Fin k → Turing.MultiTapeTM m Symbol S → Turing.MultiTapeTM k Symbol (S ⊕ Unit)
@Turing.embedSilentRetTM_run : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol} (ι : Fin m ↪ Fin k),
  ∀ cap ∉ Set.range ⇑ι,
    ∀ (M : Turing.MultiTapeTM m Symbol S) (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ)
      (pre out₀ : List Symbol) (c : Turing.Cfg m Symbol S x) (T : ℕ),
      c.state ≠ none →
        (∀ t < T, (Turing.MultiTapeTM.runFrom c t).state ≠ none) →
          (Turing.MultiTapeTM.runFrom c T).state = none →
            (∀ t < T,
                Turing.MultiTapeTM.runFrom
                    (Turing.Cfg.mapState Sum.inl (Turing.embedSilentCfg ι cap tapes heads pre out₀ c)) t =
                  Turing.Cfg.mapState Sum.inl
                    (Turing.embedSilentCfg ι cap tapes heads pre out₀ (Turing.MultiTapeTM.runFrom c t))) ∧
              (Turing.MultiTapeTM.runFrom
                    (Turing.Cfg.mapState Sum.inl (Turing.embedSilentCfg ι cap tapes heads pre out₀ c)) T =
                  have __src := Turing.embedSilentCfg ι cap tapes heads pre out₀ (Turing.MultiTapeTM.runFrom c T);
                  { state := some (Sum.inr ()), inputPos := __src.inputPos, workTapes := __src.workTapes,
                    workTapePos := __src.workTapePos, output := __src.output }) ∧
                ∀ t < T,
                  (Turing.MultiTapeTM.runFrom
                        (Turing.Cfg.mapState Sum.inl (Turing.embedSilentCfg ι cap tapes heads pre out₀ c)) t).state ≠
                    some (Sum.inr ())
@Turing.embedSilentCfg : {m k : ℕ} →
  {S : Type u_1} →
    {Symbol : Type u_2} →
      {x : List Symbol} →
        (Fin m ↪ Fin k) →
          Fin k →
            (Fin k → ℤ → Option Symbol) →
              (Fin k → ℤ) → List Symbol → List Symbol → Turing.Cfg m Symbol S x → Turing.Cfg k Symbol S x
@Turing.embedSilentCfg_cap : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol} (ι : Fin m ↪ Fin k),
  ∀ cap ∉ Set.range ⇑ι,
    ∀ (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ) (pre out₀ : List Symbol) (c : Turing.Cfg m Symbol S x),
      (Turing.embedSilentCfg ι cap tapes heads pre out₀ c).workTapes cap = Turing.FinTM.bufferTape (pre ++ c.output) ∧
        (Turing.embedSilentCfg ι cap tapes heads pre out₀ c).workTapePos cap = ↑(pre ++ c.output).length
@Turing.embedSilentCfg_inputPos : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol} (ι : Fin m ↪ Fin k)
  (cap : Fin k) (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ) (pre out₀ : List Symbol)
  (c : Turing.Cfg m Symbol S x), (Turing.embedSilentCfg ι cap tapes heads pre out₀ c).inputPos = c.inputPos
@Turing.embedSilentCfg_output : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol} (ι : Fin m ↪ Fin k)
  (cap : Fin k) (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ) (pre out₀ : List Symbol)
  (c : Turing.Cfg m Symbol S x), (Turing.embedSilentCfg ι cap tapes heads pre out₀ c).output = out₀
@Turing.embedSilentCfg_unselected : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol} (ι : Fin m ↪ Fin k)
  (cap : Fin k) (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ) (pre out₀ : List Symbol)
  (c : Turing.Cfg m Symbol S x),
  ∀ j ∉ Set.range ⇑ι,
    j ≠ cap →
      (Turing.embedSilentCfg ι cap tapes heads pre out₀ c).workTapes j = tapes j ∧
        (Turing.embedSilentCfg ι cap tapes heads pre out₀ c).workTapePos j = heads j
@Turing.embedSilentCfg_selected_tape : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol}
  (ι : Fin m ↪ Fin k) (cap : Fin k) (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ) (pre out₀ : List Symbol)
  (c : Turing.Cfg m Symbol S x) (i : Fin m),
  (Turing.embedSilentCfg ι cap tapes heads pre out₀ c).workTapes (ι i) = c.workTapes i
@Turing.embedSilentCfg_selected_pos : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol}
  (ι : Fin m ↪ Fin k) (cap : Fin k) (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ) (pre out₀ : List Symbol)
  (c : Turing.Cfg m Symbol S x) (i : Fin m),
  (Turing.embedSilentCfg ι cap tapes heads pre out₀ c).workTapePos (ι i) = c.workTapePos i
@Turing.MultiTapeTM.exists_first_halt : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {input : List Symbol}
  (tm : Turing.MultiTapeTM k Symbol State) (cfg : Turing.Cfg k Symbol State input) {t : ℕ},
  (Turing.MultiTapeTM.runFrom cfg t).state = none →
    ∃ u ≤ t,
      (∀ v < u, ¬(Turing.MultiTapeTM.runFrom cfg v).Halted) ∧
        Turing.MultiTapeTM.runFrom cfg u = Turing.MultiTapeTM.runFrom cfg t
Turing.inputRewindTM : (k : ℕ) → Turing.MultiTapeTM k Bool Turing.InputRewindPhase
@Turing.inputRewindTM_run : ∀ {k : ℕ} {x : List Bool} (d : Turing.Cfg k Bool Turing.InputRewindPhase x),
  d.state = some Turing.InputRewindPhase.start →
    1 ≤ ↑d.inputPos →
      Turing.MultiTapeTM.runFrom d (↑d.inputPos + 1) =
          { state := some Turing.InputRewindPhase.done, inputPos := 1, workTapes := d.workTapes,
            workTapePos := d.workTapePos, output := d.output } ∧
        (∀ t < ↑d.inputPos + 1, (Turing.MultiTapeTM.runFrom d t).state ≠ some Turing.InputRewindPhase.done) ∧
          ∀ t ≤ ↑d.inputPos + 1,
            (Turing.MultiTapeTM.runFrom d t).workTapes = d.workTapes ∧
              (Turing.MultiTapeTM.runFrom d t).workTapePos = d.workTapePos ∧
                (Turing.MultiTapeTM.runFrom d t).output = d.output
Turing.InputRewindPhase : Type
@Turing.Cfg.mapState_mapState : ∀ {k : ℕ} {Symbol : Type u_1} {S₁ : Type u_2} {S₂ : Type u_3} {S₃ : Type u_4}
  {x : List Symbol} (c : Turing.Cfg k Symbol S₁ x) (f : S₁ → S₂) (g : S₂ → S₃),
  Turing.Cfg.mapState g (Turing.Cfg.mapState f c) = Turing.Cfg.mapState (g ∘ f) c
@Turing.rewindTM : {Symbol : Type u_1} → (k : ℕ) → Fin k → Turing.MultiTapeTM k Symbol Turing.RewindPhase
@Turing.rewindTM_run_ofCfg : ∀ {Symbol : Type u_1} {k : ℕ} {x : List Symbol} (i : Fin k) (u : List Symbol),
  ∀ n ≤ u.length,
    ∀ (d : Turing.Cfg k Symbol Turing.RewindPhase x),
      d.state = some Turing.RewindPhase.start →
        (∀ (p : ℤ), -1 ≤ p → p < ↑n → d.workTapes i (d.workTapePos i - ↑n + p) = Turing.FinTM.bufferTape u p) →
          Turing.MultiTapeTM.runFrom d (n + 2) =
              { state := some Turing.RewindPhase.done, inputPos := d.inputPos, workTapes := d.workTapes,
                workTapePos := Function.update d.workTapePos i (d.workTapePos i - ↑n), output := d.output } ∧
            (∀ t < n + 2, (Turing.MultiTapeTM.runFrom d t).state ≠ some Turing.RewindPhase.done) ∧
              ∀ (j : Fin k),
                ∀ t ≤ n + 2,
                  if j = i then
                    (Turing.MultiTapeTM.runFrom d t).workTapePos j ∈
                      Finset.Icc (d.workTapePos j - ↑n - 1) (d.workTapePos j)
                  else (Turing.MultiTapeTM.runFrom d t).workTapePos j = d.workTapePos j
@Turing.copyTM : {Symbol : Type u_1} → (k : ℕ) → Fin k → Fin k → Turing.MultiTapeTM k Symbol Turing.SweepPhase
@Turing.copyTM_run_ofCfg : ∀ {Symbol : Type u_1} {k : ℕ} {x : List Symbol} (src dst : Fin k),
  src ≠ dst →
    ∀ (w : List Symbol) (d : Turing.Cfg k Symbol Turing.SweepPhase x),
      d.state = some Turing.SweepPhase.sweep →
        (∀ (p : ℤ), -1 ≤ p → p ≤ ↑w.length → d.workTapes src (d.workTapePos src + p) = Turing.FinTM.bufferTape w p) →
          Turing.MultiTapeTM.runFrom d (2 * w.length + 2) =
              { state := some Turing.SweepPhase.done, inputPos := d.inputPos,
                workTapes := fun j q =>
                  if j = dst ∧ d.workTapePos j ≤ q ∧ q < d.workTapePos j + ↑w.length then
                    Turing.FinTM.bufferTape w (q - d.workTapePos j)
                  else d.workTapes j q,
                workTapePos := d.workTapePos, output := d.output } ∧
            (∀ t < 2 * w.length + 2, (Turing.MultiTapeTM.runFrom d t).state ≠ some Turing.SweepPhase.done) ∧
              ∀ (j : Fin k),
                ∀ t ≤ 2 * w.length + 2,
                  if j = src ∨ j = dst then
                    (Turing.MultiTapeTM.runFrom d t).workTapePos j ∈
                      Finset.Icc (d.workTapePos j - 1) (d.workTapePos j + ↑w.length)
                  else (Turing.MultiTapeTM.runFrom d t).workTapePos j = d.workTapePos j
Turing.exists_inputWindowCopyTM : ∀ (k : ℕ) (j dst : Fin k),
  j ≠ dst →
    ∃ Q x x W entry done C,
      ∀ {z : List Bool} (d : Turing.Cfg k Bool Q z) (p : ℕ) (w : List Bool),
        d.state = some entry →
          ↑d.inputPos = p + 1 →
            (∀ (q : ℤ), -1 ≤ q → q ≤ ↑w.length → d.workTapes j (d.workTapePos j + q) = Turing.FinTM.bufferTape w q) →
              have y := List.take (Nat.ofDigits 2 (List.map Bool.toNat w)) (List.drop p z);
              ∃ T ≤ C * (y.length + 1) + 2 * w.length,
                ∃ w',
                  w'.length = w.length ∧
                    (Turing.MultiTapeTM.runFrom d T).state = some done ∧
                      ↑(Turing.MultiTapeTM.runFrom d T).inputPos = p + 1 + y.length ∧
                        ((Turing.MultiTapeTM.runFrom d T).workTapes =
                            Function.update
                              (Function.update d.workTapes dst fun q =>
                                if d.workTapePos dst ≤ q ∧ q < d.workTapePos dst + ↑y.length then
                                  Turing.FinTM.bufferTape y (q - d.workTapePos dst)
                                else d.workTapes dst q)
                              j fun q =>
                              if d.workTapePos j ≤ q ∧ q < d.workTapePos j + ↑w.length then
                                Turing.FinTM.bufferTape w' (q - d.workTapePos j)
                              else d.workTapes j q) ∧
                          (Turing.MultiTapeTM.runFrom d T).workTapePos =
                              Function.update d.workTapePos dst (d.workTapePos dst + ↑y.length) ∧
                            (Turing.MultiTapeTM.runFrom d T).output = d.output ∧
                              ∀ u < T, (Turing.MultiTapeTM.runFrom d u).state ≠ some done
Turing.counterValue_eq : ∀ (w : List Bool), Turing.counterValue w = Nat.ofDigits 2 (List.map Bool.toNat w)
Turing.counterValue_bits : ∀ (t : ℕ), Turing.counterValue t.bits = t
@Turing.MultiTapeTM.toNDTM : {k : ℕ} →
  {State : Type u_1} → {Symbol : Type u_2} → Turing.MultiTapeTM k Symbol State → Turing.NDTM k Symbol State
@Turing.MultiTapeTM.toNDTM_runWith : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2}
  (tm : Turing.MultiTapeTM k Symbol State) {input : List Symbol} (w : List Bool)
  (cfg : Turing.Cfg k Symbol State input), Turing.NDTM.runWith w cfg = Turing.MultiTapeTM.runFrom cfg w.length
@Turing.MultiTapeTM.toNDTM_initCfg : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2}
  (tm : Turing.MultiTapeTM k Symbol State) (input : List Symbol),
  Turing.NDTM.initCfg input = Turing.MultiTapeTM.initCfg input
@Turing.NDTM.runWith_initCfg_take : ∀ {k : ℕ} {Γ : Type u_1} {S : Type u_2} (tm : Turing.NDTM k Γ S) (x : List Γ)
  (m : ℕ) (w : List Bool),
  w.length ≤ m →
    have c := Turing.NDTM.runWith w (Turing.NDTM.initCfg x);
    have c' := Turing.NDTM.runWith w (Turing.NDTM.initCfg (List.take m x));
    c'.state = c.state ∧
      ↑c'.inputPos = ↑c.inputPos ∧ c'.workTapes = c.workTapes ∧ c'.workTapePos = c.workTapePos ∧ c'.output = c.output
@Turing.FinTM.computesInTime_iff : ∀ {Symbol : Type} (M : Turing.FinTM Symbol) (x w : List Symbol) (t : ℕ),
  M.ComputesInTime x w t ↔
    (Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) t).state = none ∧
      (Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) t).output = w
Turing.FinTM.exists_installCallTM : ∀ (M : Turing.FinTM Bool) (f : List Bool → List Bool) (T : ℕ → ℕ),
  M.ComputesFunInTime f T →
    ∃ C entry exit c,
      0 < C.k ∧
        ∀ (x arg : List Bool),
          ∃ t ≤ c * (T arg.length + arg.length + (f arg).length + 1),
            0 < t ∧
              (∀ (t' : ℕ),
                  0 < t' →
                    t' < t →
                      (Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords entry (Turing.stateWord C.k arg)) t').state ≠
                        some exit) ∧
                Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords entry (Turing.stateWord C.k arg)) t =
                  Turing.Cfg.ofWords exit (Turing.stateWord C.k (f arg))
Turing.stateWord : (k : ℕ) → List Bool → Fin k → List Bool
@Turing.Cfg.ofWords : {k : ℕ} →
  {State : Type u_1} → {input : List Bool} → State → (Fin k → List Bool) → Turing.Cfg k Bool State input
@Turing.Cfg.ofWords_state : ∀ {k : ℕ} {State : Type u_1} {input : List Bool} (q : State) (w : Fin k → List Bool),
  (Turing.Cfg.ofWords q w).state = some q
@Turing.Cfg.ofWords_inputPos : ∀ {k : ℕ} {State : Type u_1} {input : List Bool} (q : State) (w : Fin k → List Bool),
  (Turing.Cfg.ofWords q w).inputPos = 1
@Turing.Cfg.ofWords_workTapes : ∀ {k : ℕ} {State : Type u_1} {input : List Bool} (q : State) (w : Fin k → List Bool)
  (i : Fin k), (Turing.Cfg.ofWords q w).workTapes i = Turing.FinTM.bufferTape (w i)
@Turing.Cfg.ofWords_workTapePos : ∀ {k : ℕ} {State : Type u_1} {input : List Bool} (q : State) (w : Fin k → List Bool)
  (i : Fin k), (Turing.Cfg.ofWords q w).workTapePos i = 0
@Turing.Cfg.ofWords_output : ∀ {k : ℕ} {State : Type u_1} {input : List Bool} (q : State) (w : Fin k → List Bool),
  (Turing.Cfg.ofWords q w).output = []
Turing.exists_seamLayoutTM : ∀ (k : ℕ) (src tbl sm : Fin k),
  src ≠ tbl →
    src ≠ sm →
      tbl ≠ sm →
        ∃ Q x x L entry done C,
          ∀ (a v : List Bool) (q r : ℕ),
            have s := Turing.pairEncode a (List.replicate q true ++ [false] ++ v);
            r ≤ s.length →
              ∃ T ≤ C * (s.length + 1),
                ∀ {z : List Bool} (d : Turing.Cfg k Bool Q z),
                  d.state = some entry →
                    d.workTapes src = Turing.FinTM.bufferTape s →
                      d.workTapePos src = ↑r →
                        (d.workTapes tbl = fun x => none) →
                          d.workTapePos tbl = 0 →
                            (d.workTapes sm = fun x => none) →
                              d.workTapePos sm = 0 →
                                (Turing.MultiTapeTM.runFrom d T).state = some done ∧
                                  (Turing.MultiTapeTM.runFrom d T).inputPos = d.inputPos ∧
                                    ((Turing.MultiTapeTM.runFrom d T).workTapes =
                                        Function.update
                                          (Function.update (Function.update d.workTapes src fun x => none) tbl
                                            (Turing.FinTM.bufferTape v))
                                          sm fun p =>
                                          Turing.FinTM.bufferTape (List.replicate q true ++ [false]) (p - 2)) ∧
                                      (Turing.MultiTapeTM.runFrom d T).workTapePos =
                                          Function.update (Function.update (Function.update d.workTapePos src 0) tbl 0)
                                            sm 0 ∧
                                        (∀ u ≤ T, (Turing.MultiTapeTM.runFrom d u).output = d.output) ∧
                                          ∀ u < T, (Turing.MultiTapeTM.runFrom d u).state ≠ some done
@Turing.unaryFin_eq : ∀ {n : ℕ} (s : Fin n), Turing.unaryFin s = List.replicate (↑s) true ++ [false]
@Turing.FinTM.bufferTape_of_neg : ∀ {Symbol : Type u_1} (w : List Symbol) {z : ℤ},
  z < 0 → Turing.FinTM.bufferTape w z = none
@Turing.FinTM.bufferTape_eq : ∀ {Symbol : Type u_1} (w : List Symbol) (z : ℤ),
  Turing.FinTM.bufferTape w z = if 0 ≤ z then w[z.toNat]? else none
Turing.StepBlock.summaryCells_eq : ∀ (summary : Option Bool) (word : List Bool) (z : ℤ),
  Turing.StepBlock.summaryCells summary word z = if z = 0 then summary else Turing.FinTM.bufferTape word (z - 2)
@Turing.StepBlock.Rep : {k n : ℕ} →
  {x : List Bool} →
    (Fin (n + 1) → Option Bool → (Fin k → Option Bool) → Turing.Action k Bool (Fin (n + 1))) →
      Turing.Cfg k Bool (Fin (n + 1)) x →
        Turing.Cfg (k + 2) Bool ((key : Turing.StepBlock.Key) × Turing.StepBlock.Ph k key) x → Prop
@Turing.StepBlock.Rep_iff : ∀ {k n : ℕ} {x : List Bool}
  {tr : Fin (n + 1) → Option Bool → (Fin k → Option Bool) → Turing.Action k Bool (Fin (n + 1))}
  {c : Turing.Cfg k Bool (Fin (n + 1)) x}
  {d : Turing.Cfg (k + 2) Bool ((key : Turing.StepBlock.Key) × Turing.StepBlock.Ph k key) x},
  Turing.StepBlock.Rep tr c d ↔
    d.inputPos = c.inputPos ∧
      (∀ (i : Fin k),
          d.workTapes (Fin.castAdd 2 i) = c.workTapes i ∧ d.workTapePos (Fin.castAdd 2 i) = c.workTapePos i) ∧
        d.workTapes (Turing.StepBlock.tableTape k) = Turing.FinTM.bufferTape (Turing.tableBitsK tr) ∧
          d.workTapes (Turing.StepBlock.summaryTape k) =
              Turing.StepBlock.summaryCells (Turing.StepBlock.outputSummary c.output)
                ((Option.map Turing.unaryFin c.state).getD []) ∧
            d.workTapePos (Turing.StepBlock.tableTape k) = 0 ∧ d.workTapePos (Turing.StepBlock.summaryTape k) = 0
Turing.StepBlock.hostedLoopTM : (k : ℕ) →
  Turing.MultiTapeTM (1 + (k + 2 + 1)) Bool
    (Turing.CounterLoopState ((key : Turing.StepBlock.Key) × Turing.StepBlock.Ph k key) × Bool)
@Turing.StepBlock.hostedLoopTM_run : ∀ {k n : ℕ} {x z : List Bool} (M : Turing.MultiTapeTM k Bool (Fin (n + 1)))
  (c : Turing.Cfg k Bool (Fin (n + 1)) x),
  c.state ≠ none →
    ∀ (d : Turing.Cfg (k + 2) Bool ((key : Turing.StepBlock.Key) × Turing.StepBlock.Ph k key) x),
      d.state = some (Turing.StepBlock.exit k true) →
        Turing.StepBlock.Rep M.tr c d →
          ∀ (w : List Bool) (ct : ℤ → Option Bool) (cp : ℤ),
            (∀ (p : ℤ), -1 ≤ p → p ≤ ↑w.length → ct (cp + p) = Turing.FinTM.bufferTape w p) →
              ∀ (t : ℕ),
                Nat.ofDigits 2 (List.map Bool.toNat w) = t →
                  ∀ (b : Bool),
                    Turing.FinTM.VirtualTag c.inputPos b →
                      ∀ (p : Fin (z.length + 2)) (pre : List Bool),
                        ∃ T e ct' b',
                          T ≤ t * (50 * ((Turing.tableBitsK M.tr).length + 1)) + 4 * t + 2 * w.length + 2 ∧
                            (∀ t' ≤ t,
                                (Turing.MultiTapeTM.runFrom c t').state = none →
                                  T ≤ t' * (50 * ((Turing.tableBitsK M.tr).length + 1)) + 4 * t' + 2 * w.length) ∧
                              Turing.StepBlock.Rep M.tr (Turing.MultiTapeTM.runFrom c t) e ∧
                                e.output = d.output ∧
                                  (∀ (q : ℤ), ¬(cp ≤ q ∧ q < cp + ↑w.length) → ct' q = ct q) ∧
                                    Turing.FinTM.VirtualTag e.inputPos b' ∧
                                      Turing.MultiTapeTM.runFrom
                                            (Turing.vhostCfg
                                              (Turing.counterLoopCfg
                                                (some (Turing.CounterLoopState.dec Turing.FlagPhase.run)) d ct cp)
                                              b p pre)
                                            T =
                                          Turing.vhostCfg
                                            (Turing.counterLoopCfg
                                              (some
                                                (if (Turing.MultiTapeTM.runFrom c t).state.isSome = true then
                                                  Turing.CounterLoopState.done
                                                else Turing.CounterLoopState.escape))
                                              e ct' cp)
                                            b' p pre ∧
                                        ∀ u < T,
                                          ∀ (tag : Bool),
                                            (Turing.MultiTapeTM.runFrom
                                                    (Turing.vhostCfg
                                                      (Turing.counterLoopCfg
                                                        (some (Turing.CounterLoopState.dec Turing.FlagPhase.run)) d ct
                                                        cp)
                                                      b p pre)
                                                    u).state ≠
                                                some (Turing.CounterLoopState.done, tag) ∧
                                              (Turing.MultiTapeTM.runFrom
                                                    (Turing.vhostCfg
                                                      (Turing.counterLoopCfg
                                                        (some (Turing.CounterLoopState.dec Turing.FlagPhase.run)) d ct
                                                        cp)
                                                      b p pre)
                                                    u).state ≠
                                                some (Turing.CounterLoopState.escape, tag)
@Turing.StepBlock.hostedLoop_read : ∀ {k n : ℕ} {x z : List Bool}
  (tr : Fin (n + 1) → Option Bool → (Fin k → Option Bool) → Turing.Action k Bool (Fin (n + 1)))
  (c' : Turing.Cfg k Bool (Fin (n + 1)) x)
  (e : Turing.Cfg (k + 2) Bool ((key : Turing.StepBlock.Key) × Turing.StepBlock.Ph k key) x),
  Turing.StepBlock.Rep tr c' e →
    ∀ (q : Turing.CounterLoopState ((key : Turing.StepBlock.Key) × Turing.StepBlock.Ph k key)) (ct : ℤ → Option Bool)
      (cp : ℤ) (b : Bool) (p : Fin (z.length + 2)) (pre : List Bool),
      (Turing.vhostCfg (Turing.counterLoopCfg (some q) e ct cp) b p pre).state = some (q, b) ∧
        (Turing.vhostCfg (Turing.counterLoopCfg (some q) e ct cp) b p pre).inputPos = p ∧
          (Turing.vhostCfg (Turing.counterLoopCfg (some q) e ct cp) b p pre).output = pre ++ e.output ∧
            (Turing.vhostCfg (Turing.counterLoopCfg (some q) e ct cp) b p pre).workTapeSymbols
                (Turing.vhostBank (Turing.StepBlock.summaryTape k).castSucc) =
              Turing.StepBlock.outputSummary c'.output
Turing.StepBlock.exit_true : ∀ (k : ℕ), Turing.StepBlock.exit k true = ⟨Turing.StepBlock.Key.entry, ()⟩
Turing.StepBlock.exit_false : ∀ (k : ℕ), Turing.StepBlock.exit k false = ⟨Turing.StepBlock.Key.halt, ()⟩
Turing.StepBlock.summaryTape_eq : ∀ (k : ℕ), Turing.StepBlock.summaryTape k = Fin.natAdd k 1
Turing.StepBlock.tableTape_eq : ∀ (k : ℕ), Turing.StepBlock.tableTape k = Fin.natAdd k 0
Turing.StepBlock.outputSummary_nil : Turing.StepBlock.outputSummary [] = none
Turing.StepBlock.outputSummary_true : ∀ (w : List Bool), Turing.StepBlock.outputSummary w = some true ↔ w = [true]
@Turing.vhostCfg : {m : ℕ} →
  {S : Type u_1} →
    {x y : List Bool} →
      Turing.Cfg m Bool S y → Bool → Fin (x.length + 2) → List Bool → Turing.Cfg (1 + m) Bool (S × Bool) x
@Turing.vhostCfg_state : ∀ {m : ℕ} {S : Type u_1} {x y : List Bool} (c : Turing.Cfg m Bool S y) (b : Bool)
  (p : Fin (x.length + 2)) (pre : List Bool), (Turing.vhostCfg c b p pre).state = Option.map (fun q => (q, b)) c.state
@Turing.vhostCfg_inputPos : ∀ {m : ℕ} {S : Type u_1} {x y : List Bool} (c : Turing.Cfg m Bool S y) (b : Bool)
  (p : Fin (x.length + 2)) (pre : List Bool), (Turing.vhostCfg c b p pre).inputPos = p
@Turing.vhostCfg_workTapes : ∀ {m : ℕ} {S : Type u_1} {x y : List Bool} (c : Turing.Cfg m Bool S y) (b : Bool)
  (p : Fin (x.length + 2)) (pre : List Bool) (i : Fin (1 + m)) (a : ℤ),
  (Turing.vhostCfg c b p pre).workTapes i a =
    Fin.addCases (motive := fun x => ℤ → Option Bool) (fun x => Turing.FinTM.bufferTape y) c.workTapes i a
@Turing.vhostCfg_workTapePos : ∀ {m : ℕ} {S : Type u_1} {x y : List Bool} (c : Turing.Cfg m Bool S y) (b : Bool)
  (p : Fin (x.length + 2)) (pre : List Bool) (i : Fin (1 + m)),
  (Turing.vhostCfg c b p pre).workTapePos i = Fin.addCases (fun x => ↑↑c.inputPos - 1) c.workTapePos i
@Turing.vhostCfg_output : ∀ {m : ℕ} {S : Type u_1} {x y : List Bool} (c : Turing.Cfg m Bool S y) (b : Bool)
  (p : Fin (x.length + 2)) (pre : List Bool), (Turing.vhostCfg c b p pre).output = pre ++ c.output
@Turing.vhostBank_eq : ∀ {m : ℕ} (i : Fin m), Turing.vhostBank i = Fin.natAdd 1 i
@Turing.counterLoopCfg : {k : ℕ} →
  {Symbol S : Type} →
    {x : List Symbol} →
      Option (Turing.CounterLoopState S) →
        Turing.Cfg k Symbol S x → (ℤ → Option Symbol) → ℤ → Turing.Cfg (k + 1) Symbol (Turing.CounterLoopState S) x
@Turing.counter_cfg_eq : ∀ {k : ℕ} {S : Type} {x : List Bool} (q : Option (Turing.CounterLoopState S))
  (c : Turing.Cfg k Bool S x) (ct : ℤ → Option Bool) (cp : ℤ),
  Turing.counterLoopCfg q c ct cp =
    { state := q, inputPos := c.inputPos,
      workTapes := fun i => Fin.lastCases (motive := fun x => ℤ → Option Bool) ct c.workTapes i,
      workTapePos := fun i => Fin.lastCases cp c.workTapePos i, output := c.output }
@Turing.FinTM.VirtualTag : {n : ℕ} → Fin (n + 2) → Bool → Prop
@Turing.seamCompTM : {k : ℕ} →
  {S₁ : Type u_1} →
    {S₂ : Type u_2} →
      {Symbol : Type u_3} →
        [DecidableEq S₁] →
          Turing.MultiTapeTM k Symbol S₁ →
            S₁ → Turing.MultiTapeTM k Symbol S₂ → S₂ → Turing.MultiTapeTM k Symbol (S₁ ⊕ S₂)
@Turing.seamCompTM_run_ofCfg : ∀ {k : ℕ} {S₁ : Type u_1} {S₂ : Type u_2} {Symbol : Type u_3} {x : List Symbol}
  [inst : DecidableEq S₁] (M₁ : Turing.MultiTapeTM k Symbol S₁) (exit : S₁) (M₂ : Turing.MultiTapeTM k Symbol S₂)
  (entry : S₂) {c₀ c₁ : Turing.Cfg k Symbol S₁ x} {c₃ : Turing.Cfg k Symbol S₂ x} {T₁ T₂ : ℕ},
  Turing.MultiTapeTM.runFrom c₀ T₁ = c₁ →
    c₁.state = some exit →
      (∀ t < T₁, (Turing.MultiTapeTM.runFrom c₀ t).state ≠ some exit) →
        Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState (fun x => entry) c₁) T₂ = c₃ →
          Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState Sum.inl c₀) (T₁ + 1 + T₂) = Turing.Cfg.mapState Sum.inr c₃
@Turing.seamCompTM_firstReturn_ofCfg : ∀ {k : ℕ} {S₁ : Type u_1} {S₂ : Type u_2} {Symbol : Type u_3} {x : List Symbol}
  [inst : DecidableEq S₁] (M₁ : Turing.MultiTapeTM k Symbol S₁) (exit : S₁) (M₂ : Turing.MultiTapeTM k Symbol S₂)
  (entry q₂ : S₂) {c₀ c₁ : Turing.Cfg k Symbol S₁ x} {c₃ : Turing.Cfg k Symbol S₂ x} {T₁ T₂ : ℕ},
  Turing.MultiTapeTM.runFrom c₀ T₁ = c₁ →
    c₁.state = some exit →
      (∀ t < T₁, (Turing.MultiTapeTM.runFrom c₀ t).state ≠ some exit) →
        Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState (fun x => entry) c₁) T₂ = c₃ →
          c₃.state = some q₂ →
            (∀ t < T₂, (Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState (fun x => entry) c₁) t).state ≠ some q₂) →
              ∀ t < T₁ + 1 + T₂,
                (Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState Sum.inl c₀) t).state ≠ some (Sum.inr q₂)
@Turing.seamCompTM_runFrom_left : ∀ {k : ℕ} {S₁ : Type u_1} {S₂ : Type u_2} {Symbol : Type u_3} {x : List Symbol}
  [inst : DecidableEq S₁] (M₁ : Turing.MultiTapeTM k Symbol S₁) (exit : S₁) (M₂ : Turing.MultiTapeTM k Symbol S₂)
  (entry : S₂) {c : Turing.Cfg k Symbol S₁ x} {T : ℕ},
  (∀ t < T, (Turing.MultiTapeTM.runFrom c t).state ≠ some exit) →
    ∀ t ≤ T,
      Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState Sum.inl c) t =
        Turing.Cfg.mapState Sum.inl (Turing.MultiTapeTM.runFrom c t)
@Turing.seamCompTM_runFrom_right : ∀ {k : ℕ} {S₁ : Type u_1} {S₂ : Type u_2} {Symbol : Type u_3} {x : List Symbol}
  [inst : DecidableEq S₁] (M₁ : Turing.MultiTapeTM k Symbol S₁) (exit : S₁) (M₂ : Turing.MultiTapeTM k Symbol S₂)
  (entry : S₂) {c₀ c₁ : Turing.Cfg k Symbol S₁ x} {T₁ : ℕ},
  Turing.MultiTapeTM.runFrom c₀ T₁ = c₁ →
    c₁.state = some exit →
      (∀ t < T₁, (Turing.MultiTapeTM.runFrom c₀ t).state ≠ some exit) →
        ∀ (t : ℕ),
          Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState Sum.inl c₀) (T₁ + 1 + t) =
            Turing.Cfg.mapState Sum.inr (Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState (fun x => entry) c₁) t)
@Turing.seamReleaseTM : {k : ℕ} →
  {S : Type u_1} → {Symbol : Type u_2} → Turing.MultiTapeTM k Symbol S → S → Turing.MultiTapeTM k Symbol (Unit ⊕ S)
@Turing.seamReleaseTM_firstReturn : ∀ {k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol}
  (M : Turing.MultiTapeTM k Symbol S) (anchor : S) {c c' : Turing.Cfg k Symbol S x} {T : ℕ},
  c.state = some anchor →
    0 < T →
      Turing.MultiTapeTM.runFrom c T = c' →
        c'.state = some anchor →
          (∀ (t : ℕ), 0 < t → t < T → (Turing.MultiTapeTM.runFrom c t).state ≠ some anchor) →
            Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState (fun x => Sum.inl ()) c) T =
                Turing.Cfg.mapState Sum.inr c' ∧
              ∀ t < T,
                (Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState (fun x => Sum.inl ()) c) t).state ≠
                  some (Sum.inr anchor)
@Turing.phaseHostTM : {k : ℕ} →
  {Γ I : Type} →
    {Ph : I → Type} →
      ((i : I) → Turing.MultiTapeTM k Γ (Ph i)) →
        (i : I) × Ph i → ((i : I) → Ph i → Option ((i : I) × Ph i)) → Turing.MultiTapeTM k Γ ((i : I) × Ph i)
@Turing.phaseHostTM_run : ∀ {k : ℕ} {Γ I : Type} {Ph : I → Type} (M : (i : I) → Turing.MultiTapeTM k Γ (Ph i))
  (q0 : (i : I) × Ph i) (red : (i : I) → Ph i → Option ((i : I) × Ph i)) (i : I) {x : List Γ}
  (c c' : Turing.Cfg k Γ (Ph i) x) (T : ℕ),
  Turing.MultiTapeTM.runFrom c T = c' →
    ∀ (s' : Ph i),
      c'.state = some s' →
        ∀ (q' : (i : I) × Ph i),
          red i s' = some q' →
            (∀ u < T, ∀ (s : Ph i), (Turing.MultiTapeTM.runFrom c u).state = some s → red i s = none) →
              (∀ u ≤ T,
                  Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState (Sigma.mk i) c) u =
                    Turing.Cfg.mapState (Sigma.mk i) (Turing.MultiTapeTM.runFrom c u)) ∧
                Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState (Sigma.mk i) c) (T + 1) =
                  Turing.Cfg.mapState (fun x => q') c'
@Turing.embedEmitTM : {m k : ℕ} →
  {S : Type u_1} → {Symbol : Type u_2} → (Fin m ↪ Fin k) → Turing.MultiTapeTM m Symbol S → Turing.MultiTapeTM k Symbol S
@Turing.embedEmitTM_runFrom : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol} (ι : Fin m ↪ Fin k)
  (M : Turing.MultiTapeTM m Symbol S) (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ) (pre : List Symbol)
  (c : Turing.Cfg m Symbol S x) (t : ℕ),
  Turing.MultiTapeTM.runFrom (Turing.embedEmitCfg ι tapes heads pre c) t =
    Turing.embedEmitCfg ι tapes heads pre (Turing.MultiTapeTM.runFrom c t)
@Turing.embedEmitCfg_eq : ∀ {k : ℕ} {Γ : Type u_1} {m : ℕ} {S : Type u_2} {x : List Γ} (σ : Fin m ↪ Fin k)
  (tapes : Fin k → ℤ → Option Γ) (heads : Fin k → ℤ) (pre : List Γ) (c : Turing.Cfg m Γ S x) (d : Turing.Cfg k Γ S x),
  c.state = d.state →
    c.inputPos = d.inputPos →
      pre ++ c.output = d.output →
        (∀ (i : Fin m), c.workTapes i = d.workTapes (σ i) ∧ c.workTapePos i = d.workTapePos (σ i)) →
          (∀ j ∉ Set.range ⇑σ, tapes j = d.workTapes j ∧ heads j = d.workTapePos j) →
            Turing.embedEmitCfg σ tapes heads pre c = d
@Turing.embedSilentTM : {m k : ℕ} →
  {S : Type u_1} →
    {Symbol : Type u_2} → (Fin m ↪ Fin k) → Fin k → Turing.MultiTapeTM m Symbol S → Turing.MultiTapeTM k Symbol S
@Turing.embedSilentTM_runFrom : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol} (ι : Fin m ↪ Fin k),
  ∀ cap ∉ Set.range ⇑ι,
    ∀ (M : Turing.MultiTapeTM m Symbol S) (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ)
      (pre out₀ : List Symbol) (c : Turing.Cfg m Symbol S x) (t : ℕ),
      Turing.MultiTapeTM.runFrom (Turing.embedSilentCfg ι cap tapes heads pre out₀ c) t =
        Turing.embedSilentCfg ι cap tapes heads pre out₀ (Turing.MultiTapeTM.runFrom c t)
@Turing.MultiTapeTM.runFrom_add : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  {tm : Turing.MultiTapeTM k Symbol State} (cfg : Turing.Cfg k Symbol State input) (a b : ℕ),
  Turing.MultiTapeTM.runFrom cfg (a + b) = Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.runFrom cfg a) b
@Turing.MultiTapeTM.runFrom_zero : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  {tm : Turing.MultiTapeTM k Symbol State} {cfg : Turing.Cfg k Symbol State input},
  Turing.MultiTapeTM.runFrom cfg 0 = cfg
@Turing.MultiTapeTM.runFrom_succ_eq_step : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  {tm : Turing.MultiTapeTM k Symbol State} {cfg : Turing.Cfg k Symbol State input} {t : ℕ},
  Turing.MultiTapeTM.runFrom cfg (t + 1) = Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.step cfg) t
@Turing.MultiTapeTM.output_prefix : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {input : List Symbol}
  (tm : Turing.MultiTapeTM k Symbol State) (cfg : Turing.Cfg k Symbol State input) {t t' : ℕ},
  t ≤ t' → (Turing.MultiTapeTM.runFrom cfg t).output <+: (Turing.MultiTapeTM.runFrom cfg t').output
@Turing.MultiTapeTM.initCfg_eq : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2}
  {tm : Turing.MultiTapeTM k Symbol State} (input : List Symbol),
  Turing.MultiTapeTM.initCfg input = Turing.Cfg.init tm.q₀ input
@Turing.Cfg.mapState_state : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {State' : Type u_3} {input : List Symbol}
  (f : State → State') (cfg : Turing.Cfg k Symbol State input),
  (Turing.Cfg.mapState f cfg).state = Option.map f cfg.state
@Turing.Cfg.mapState_inputPos : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {State' : Type u_3}
  {input : List Symbol} (f : State → State') (cfg : Turing.Cfg k Symbol State input),
  (Turing.Cfg.mapState f cfg).inputPos = cfg.inputPos
@Turing.Cfg.mapState_workTapes : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {State' : Type u_3}
  {input : List Symbol} (f : State → State') (cfg : Turing.Cfg k Symbol State input) (a : Fin k) (a_1 : ℤ),
  (Turing.Cfg.mapState f cfg).workTapes a a_1 = cfg.workTapes a a_1
@Turing.Cfg.mapState_workTapePos : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {State' : Type u_3}
  {input : List Symbol} (f : State → State') (cfg : Turing.Cfg k Symbol State input) (a : Fin k),
  (Turing.Cfg.mapState f cfg).workTapePos a = cfg.workTapePos a
@Turing.Cfg.mapState_output : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {State' : Type u_3} {input : List Symbol}
  (f : State → State') (cfg : Turing.Cfg k Symbol State input), (Turing.Cfg.mapState f cfg).output = cfg.output
@Turing.Cfg.ext : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {input : List Symbol}
  {x y : Turing.Cfg k Symbol State input},
  x.state = y.state →
    x.inputPos = y.inputPos → x.workTapes = y.workTapes → x.workTapePos = y.workTapePos → x.output = y.output → x = y
@Turing.FinTM.ComputesInTime.mono : ∀ {Symbol : Type} {M : Turing.FinTM Symbol} {input output : List Symbol} {t t' : ℕ},
  M.ComputesInTime input output t → t ≤ t' → M.ComputesInTime input output t'
Turing.length_bits_le_self : ∀ (m : ℕ), m.bits.length ≤ m
@Turing.MultiTapeTM.initCfg_with_q₀ : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2}
  (tm : Turing.MultiTapeTM k Symbol State) (q : State) (x : List Symbol),
  Turing.MultiTapeTM.initCfg x = Turing.Cfg.init q x
@Turing.MultiTapeTM.runFrom_with_q₀ : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {input : List Symbol}
  (tm : Turing.MultiTapeTM k Symbol State) (q : State) (cfg : Turing.Cfg k Symbol State input) (t : ℕ),
  Turing.MultiTapeTM.runFrom cfg t = Turing.MultiTapeTM.runFrom cfg t
@Turing.Cfg.init : {k : ℕ} →
  {State : Type u_1} → {Symbol : Type u_2} → State → (input : List Symbol) → Turing.Cfg k Symbol State input
@Turing.Cfg.init_state : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} (q₀ : State) (input : List Symbol),
  (Turing.Cfg.init q₀ input).state = some q₀
@Turing.Cfg.init_inputPos : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} (q₀ : State) (input : List Symbol),
  (Turing.Cfg.init q₀ input).inputPos = 1
@Turing.Cfg.init_workTapes : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} (q₀ : State) (input : List Symbol)
  (x : Fin k) (x_1 : ℤ), (Turing.Cfg.init q₀ input).workTapes x x_1 = none
@Turing.Cfg.init_workTapePos : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} (q₀ : State) (input : List Symbol)
  (x : Fin k), (Turing.Cfg.init q₀ input).workTapePos x = 0
@Turing.Cfg.init_output : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} (q₀ : State) (input : List Symbol),
  (Turing.Cfg.init q₀ input).output = []
@Turing.Cfg.mapState : {k : ℕ} →
  {Symbol : Type u_1} →
    {State : Type u_2} →
      {State' : Type u_3} →
        {input : List Symbol} → (State → State') → Turing.Cfg k Symbol State input → Turing.Cfg k Symbol State' input
Turing.stateWord_eq : ∀ (k : ℕ) (s : List Bool) (i : Fin k), Turing.stateWord k s i = if ↑i = 0 then s else []
@Turing.seamReleaseTM_runFrom_pos : ∀ {k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol}
  (M : Turing.MultiTapeTM k Symbol S) (anchor : S) (c : Turing.Cfg k Symbol S x),
  c.state = some anchor →
    ∀ (t : ℕ),
      0 < t →
        Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState (fun x => Sum.inl ()) c) t =
          Turing.Cfg.mapState Sum.inr (Turing.MultiTapeTM.runFrom c t)
@Turing.embedSilentCfg_state : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol} (ι : Fin m ↪ Fin k)
  (cap : Fin k) (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ) (pre out₀ : List Symbol)
  (c : Turing.Cfg m Symbol S x), (Turing.embedSilentCfg ι cap tapes heads pre out₀ c).state = c.state
@Turing.embedEmitCfg : {m k : ℕ} →
  {S : Type u_1} →
    {Symbol : Type u_2} →
      {x : List Symbol} →
        (Fin m ↪ Fin k) →
          (Fin k → ℤ → Option Symbol) → (Fin k → ℤ) → List Symbol → Turing.Cfg m Symbol S x → Turing.Cfg k Symbol S x
@Turing.embedEmitCfg_selected_tape : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol}
  (ι : Fin m ↪ Fin k) (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ) (pre : List Symbol)
  (c : Turing.Cfg m Symbol S x) (i : Fin m), (Turing.embedEmitCfg ι tapes heads pre c).workTapes (ι i) = c.workTapes i
@Turing.embedEmitCfg_selected_pos : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol} (ι : Fin m ↪ Fin k)
  (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ) (pre : List Symbol) (c : Turing.Cfg m Symbol S x) (i : Fin m),
  (Turing.embedEmitCfg ι tapes heads pre c).workTapePos (ι i) = c.workTapePos i
@Turing.embedEmitCfg_unselected : ∀ {k : ℕ} {Γ : Type u_1} {m : ℕ} {S : Type u_2} {x : List Γ} (σ : Fin m ↪ Fin k)
  (tapes : Fin k → ℤ → Option Γ) (heads : Fin k → ℤ) (pre : List Γ) (c : Turing.Cfg m Γ S x),
  ∀ j ∉ Set.range ⇑σ,
    (Turing.embedEmitCfg σ tapes heads pre c).workTapes j = tapes j ∧
      (Turing.embedEmitCfg σ tapes heads pre c).workTapePos j = heads j
@Turing.embedEmitTM_frame : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol} (ι : Fin m ↪ Fin k)
  (M : Turing.MultiTapeTM m Symbol S) (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ) (pre : List Symbol)
  (c : Turing.Cfg m Symbol S x) (t : ℕ),
  (∀ j ∉ Set.range ⇑ι,
      (Turing.MultiTapeTM.runFrom (Turing.embedEmitCfg ι tapes heads pre c) t).workTapes j = tapes j ∧
        (Turing.MultiTapeTM.runFrom (Turing.embedEmitCfg ι tapes heads pre c) t).workTapePos j = heads j) ∧
    (Turing.MultiTapeTM.runFrom (Turing.embedEmitCfg ι tapes heads pre c) t).inputPos =
        (Turing.MultiTapeTM.runFrom c t).inputPos ∧
      (Turing.MultiTapeTM.runFrom (Turing.embedEmitCfg ι tapes heads pre c) t).output =
        pre ++ (Turing.MultiTapeTM.runFrom c t).output
@Turing.FinTM.bufferTape : {Symbol : Type u_1} → List Symbol → ℤ → Option Symbol
@Turing.FinTM.bufferTape_nil : ∀ {Symbol : Type u_1}, Turing.FinTM.bufferTape [] = fun x => none
Turing.StepBlock.summaryCells : Option Bool → List Bool → ℤ → Option Bool
Turing.StepBlock.exit : (k : ℕ) → Bool → (key : Turing.StepBlock.Key) × Turing.StepBlock.Ph k key
Turing.StepBlock.summaryTape : (k : ℕ) → Fin (k + 2)
Turing.StepBlock.tableTape : (k : ℕ) → Fin (k + 2)
