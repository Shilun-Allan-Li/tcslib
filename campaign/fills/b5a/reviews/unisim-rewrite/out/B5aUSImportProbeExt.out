@Turing.seamCompTM_step : ∀ {k : ℕ} {S₁ S₂ : Type} [inst : DecidableEq S₁] {x : List Bool}
  (A : Turing.MultiTapeTM k Bool S₁) (exit₁ : S₁) (B : Turing.MultiTapeTM k Bool S₂) (entry₂ exit₂ : S₂)
  {c₀ c₁ : Turing.Cfg k Bool S₁ x} {c₂ : Turing.Cfg k Bool S₂ x} {T₁ T₂ : ℕ},
  Turing.MultiTapeTM.runFrom c₀ T₁ = c₁ →
    c₁.state = some exit₁ →
      (∀ t < T₁, (Turing.MultiTapeTM.runFrom c₀ t).state ≠ some exit₁) →
        Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState (fun x => entry₂) c₁) T₂ = c₂ →
          c₂.state = some exit₂ →
            (∀ t < T₂, (Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState (fun x => entry₂) c₁) t).state ≠ some exit₂) →
              Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState Sum.inl c₀) (T₁ + 1 + T₂) =
                  Turing.Cfg.mapState Sum.inr c₂ ∧
                (Turing.Cfg.mapState Sum.inr c₂).state = some (Sum.inr exit₂) ∧
                  ∀ t < T₁ + 1 + T₂,
                    (Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState Sum.inl c₀) t).state ≠ some (Sum.inr exit₂)
Turing.prefixCanon_pairExtract_halt : ∀ (first : Bool) (α x : List Bool) (t : ℕ),
  have F := if first = true then Turing.FinTM.pairExtractTM true false else Turing.FinTM.pairExtractTM false true;
  have M := Turing.prefixCanonTM F;
  have z := Turing.pairEncode (Turing.pairEncode t.bits α) x;
  have d := Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg z) (16 * t.bits.length + 8 * α.length + 25);
  d.state = none ∧ (d.output = if first = true then t.bits else α) ∧ ↑d.inputPos = 4 * t.bits.length + 2 * α.length + 7
Turing.headerCapture_run : ∀ (first : Bool) (K : ℕ) (α x : List Bool) (t : ℕ)
  (ι :
    Fin
        (Turing.prefixCanonTM
            (if first = true then Turing.FinTM.pairExtractTM true false else Turing.FinTM.pairExtractTM false true)).k ↪
      Fin K),
  ∀ cap ∉ Set.range ⇑ι,
    ∀ (tapes : Fin K → ℤ → Option Bool) (heads : Fin K → ℤ) (out : List Bool),
      let M :=
        Turing.prefixCanonTM
          (if first = true then Turing.FinTM.pairExtractTM true false else Turing.FinTM.pairExtractTM false true);
      have z := Turing.pairEncode (Turing.pairEncode t.bits α) x;
      have start :=
        Turing.Cfg.mapState Sum.inl (Turing.embedSilentCfg ι cap tapes heads [] out (Turing.MultiTapeTM.initCfg z));
      ∃ T ≤ 16 * t.bits.length + 8 * α.length + 25,
        have e := Turing.MultiTapeTM.runFrom start T;
        e.state = some (Sum.inr ()) ∧
          ↑e.inputPos = 4 * t.bits.length + 2 * α.length + 7 ∧
            e.workTapes cap = Turing.FinTM.bufferTape (if first = true then t.bits else α) ∧
              e.workTapePos cap = ↑(if first = true then t.bits else α).length ∧
                e.output = out ∧
                  (∀ j ∉ Set.range ⇑ι, j ≠ cap → e.workTapes j = tapes j ∧ e.workTapePos j = heads j) ∧
                    ∀ u < T, (Turing.MultiTapeTM.runFrom start u).state ≠ some (Sum.inr ())
@Turing.embedSilentRetTM_firstReturn : ∀ {k : ℕ} (M : Turing.FinTM Bool) (x : List Bool) (ι : Fin M.k ↪ Fin k),
  ∀ cap ∉ Set.range ⇑ι,
    ∀ (tapes : Fin k → ℤ → Option Bool) (heads : Fin k → ℤ) (out : List Bool) (T : ℕ),
      (Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) T).state = none →
        ∃ u ≤ T,
          (Turing.MultiTapeTM.runFrom
                (Turing.Cfg.mapState Sum.inl
                  (Turing.embedSilentCfg ι cap tapes heads [] out (Turing.MultiTapeTM.initCfg x)))
                u =
              have __src :=
                Turing.embedSilentCfg ι cap tapes heads [] out
                  (Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) T);
              { state := some (Sum.inr ()), inputPos := __src.inputPos, workTapes := __src.workTapes,
                workTapePos := __src.workTapePos, output := __src.output }) ∧
            ∀ v < u,
              (Turing.MultiTapeTM.runFrom
                    (Turing.Cfg.mapState Sum.inl
                      (Turing.embedSilentCfg ι cap tapes heads [] out (Turing.MultiTapeTM.initCfg x)))
                    v).state ≠
                some (Sum.inr ())
@Turing.embedSilentCfg_initCfg : ∀ {m n : ℕ} {S : Type} (M : Turing.MultiTapeTM m Bool S) (ι : Fin m ↪ Fin n),
  ∀ cap ∉ Set.range ⇑ι,
    ∀ (x : List Bool),
      Turing.Cfg.mapState Sum.inl
          (Turing.embedSilentCfg ι cap (fun x x_1 => none) (fun x => 0) [] [] (Turing.MultiTapeTM.initCfg x)) =
        Turing.Cfg.init (Sum.inl M.q₀) x
Turing.exists_windowCall : ∀ (K : ℕ) (j dst : Fin K),
  j ≠ dst →
    ∃ Q x x W entry done C,
      ∀ (α x : List Bool) (t : ℕ) (d : Turing.Cfg K Bool Q (Turing.pairEncode (Turing.pairEncode t.bits α) x)),
        d.state = some entry →
          ↑d.inputPos = 4 * t.bits.length + 2 * α.length + 7 →
            (∀ (q : ℤ),
                -1 ≤ q → q ≤ ↑t.bits.length → d.workTapes j (d.workTapePos j + q) = Turing.FinTM.bufferTape t.bits q) →
              (d.workTapes dst = fun x => none) →
                d.workTapePos dst = 0 →
                  ∃ T ≤ C * (min t x.length + 1) + 2 * t.bits.length,
                    (Turing.MultiTapeTM.runFrom d T).state = some done ∧
                      ↑(Turing.MultiTapeTM.runFrom d T).inputPos =
                          4 * t.bits.length + 2 * α.length + 7 + (List.take t x).length ∧
                        (Turing.MultiTapeTM.runFrom d T).workTapes dst = Turing.FinTM.bufferTape (List.take t x) ∧
                          (Turing.MultiTapeTM.runFrom d T).workTapePos dst = ↑(List.take t x).length ∧
                            (Turing.MultiTapeTM.runFrom d T).workTapePos j = d.workTapePos j ∧
                              (∀ (i : Fin K),
                                  i ≠ j →
                                    i ≠ dst →
                                      (Turing.MultiTapeTM.runFrom d T).workTapes i = d.workTapes i ∧
                                        (Turing.MultiTapeTM.runFrom d T).workTapePos i = d.workTapePos i) ∧
                                (Turing.MultiTapeTM.runFrom d T).output = d.output ∧
                                  ∀ u < T, (Turing.MultiTapeTM.runFrom d u).state ≠ some done
@Turing.installCall_releasePhase : ∀ {K : ℕ} (CI : Turing.FinTM Bool) (entryI doneI : CI.State) (ι : Fin CI.k ↪ Fin K),
  ∀ cap ∉ Set.range ⇑ι,
    ∀ {z : List Bool} (tapes : Fin K → ℤ → Option Bool) (heads : Fin K → ℤ) (α w' : List Bool) (T : ℕ),
      0 < T →
        Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords entryI (Turing.stateWord CI.k α)) T =
            Turing.Cfg.ofWords doneI (Turing.stateWord CI.k w') →
          (∀ (u : ℕ),
              0 < u →
                u < T →
                  (Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords entryI (Turing.stateWord CI.k α)) u).state ≠
                    some doneI) →
            Turing.MultiTapeTM.runFrom
                  (Turing.Cfg.mapState (fun x => Sum.inl ())
                    (Turing.embedSilentCfg ι cap tapes heads [] []
                      (Turing.Cfg.ofWords entryI (Turing.stateWord CI.k α))))
                  T =
                Turing.Cfg.mapState Sum.inr
                  (Turing.embedSilentCfg ι cap tapes heads [] []
                    (Turing.Cfg.ofWords doneI (Turing.stateWord CI.k w'))) ∧
              ∀ u < T,
                (Turing.MultiTapeTM.runFrom
                      (Turing.Cfg.mapState (fun x => Sum.inl ())
                        (Turing.embedSilentCfg ι cap tapes heads [] []
                          (Turing.Cfg.ofWords entryI (Turing.stateWord CI.k α))))
                      u).state ≠
                  some (Sum.inr doneI)
Turing.exists_layoutCall : ∀ (K : ℕ) (src tbl sm : Fin K),
  src ≠ tbl →
    src ≠ sm →
      tbl ≠ sm →
        ∃ Q x x L entry done C,
          ∀ {k n : ℕ} (M : Turing.MultiTapeTM k Bool (Fin (n + 1))),
            ∃ T ≤ C * ((Turing.pairEncode n.bits (Turing.unaryFin M.q₀ ++ Turing.tableBitsK M.tr)).length + 1),
              ∀ {z : List Bool} (d : Turing.Cfg K Bool Q z),
                d.state = some entry →
                  d.workTapes src =
                      Turing.FinTM.bufferTape
                        (Turing.pairEncode n.bits (Turing.unaryFin M.q₀ ++ Turing.tableBitsK M.tr)) →
                    d.workTapePos src = 0 →
                      (d.workTapes tbl = fun x => none) →
                        d.workTapePos tbl = 0 →
                          (d.workTapes sm = fun x => none) →
                            d.workTapePos sm = 0 →
                              (Turing.MultiTapeTM.runFrom d T).state = some done ∧
                                (Turing.MultiTapeTM.runFrom d T).inputPos = d.inputPos ∧
                                  (Turing.MultiTapeTM.runFrom d T).workTapes =
                                      Function.update
                                        (Function.update (Function.update d.workTapes src fun x => none) tbl
                                          (Turing.FinTM.bufferTape (Turing.tableBitsK M.tr)))
                                        sm (Turing.StepBlock.summaryCells none (Turing.unaryFin M.q₀)) ∧
                                    (Turing.MultiTapeTM.runFrom d T).workTapePos =
                                        Function.update (Function.update (Function.update d.workTapePos src 0) tbl 0) sm
                                          0 ∧
                                      (∀ u ≤ T, (Turing.MultiTapeTM.runFrom d u).output = d.output) ∧
                                        ∀ u < T, (Turing.MultiTapeTM.runFrom d u).state ≠ some done
@Turing.phaseHostTM_run_le : ∀ {k : ℕ} {Γ I : Type} {Ph : I → Type} (M : (i : I) → Turing.MultiTapeTM k Γ (Ph i))
  (q0 : (i : I) × Ph i) (red : (i : I) → Ph i → Option ((i : I) × Ph i)) (i : I) {x : List Γ}
  (c : Turing.Cfg k Γ (Ph i) x) (T : ℕ),
  (∀ u < T, ∀ (s : Ph i), (Turing.MultiTapeTM.runFrom c u).state = some s → red i s = none) →
    ∀ u ≤ T,
      Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState (Sigma.mk i) c) u =
        Turing.Cfg.mapState (Sigma.mk i) (Turing.MultiTapeTM.runFrom c u)
@Turing.phaseHostTM_tr_of_red_none : ∀ {k : ℕ} {Γ I : Type} {Ph : I → Type}
  (M : (i : I) → Turing.MultiTapeTM k Γ (Ph i)) (q0 : (i : I) × Ph i) (red : (i : I) → Ph i → Option ((i : I) × Ph i))
  (i : I) (s : Ph i),
  red i s = none →
    ∀ (inp : Option Γ) (w : Fin k → Option Γ),
      (Turing.phaseHostTM M q0 red).tr ⟨i, s⟩ inp w = Turing.Action.mapState (Sigma.mk i) ((M i).tr s inp w)
@Turing.phaseHostTM_q₀ : ∀ {k : ℕ} {Γ I : Type} {Ph : I → Type} (M : (i : I) → Turing.MultiTapeTM k Γ (Ph i))
  (q0 : (i : I) × Ph i) (red : (i : I) → Ph i → Option ((i : I) × Ph i)), (Turing.phaseHostTM M q0 red).q₀ = q0
@Turing.phaseHostTM_tr_of_red_some : ∀ {k : ℕ} {Γ I : Type} {Ph : I → Type}
  (M : (i : I) → Turing.MultiTapeTM k Γ (Ph i)) (q0 : (i : I) × Ph i) (red : (i : I) → Ph i → Option ((i : I) × Ph i))
  (i : I) (s : Ph i) {q' : (i : I) × Ph i},
  red i s = some q' →
    ∀ (inp : Option Γ) (w : Fin k → Option Γ),
      (Turing.phaseHostTM M q0 red).tr ⟨i, s⟩ inp w =
        { inputTape := 0, workTapes := fun x => (none, 0), output := none, state := some q' }
Turing.codeReadActionK : (k n : ℕ) → List Bool → Option (Turing.Action k Bool (Fin (n + 1)) × List Bool)
@Turing.codeReadActionK_append : ∀ {k n : ℕ} (a : Turing.Action k Bool (Fin (n + 1))) (xs : List Bool),
  Turing.codeReadActionK k n (Turing.actionBitsK a ++ xs) = some (a, xs)
@Turing.vhostEmitTM : {m : ℕ} →
  {S : Type u_1} → Turing.MultiTapeTM m Bool S → Turing.MultiTapeTM (1 + m) Bool (S × Bool)
@Turing.vhostEmitTM_runFrom : ∀ {m : ℕ} {S : Type u_1} {x y : List Bool} (M : Turing.MultiTapeTM m Bool S)
  (c : Turing.Cfg m Bool S y) (b : Bool),
  Turing.FinTM.VirtualTag c.inputPos b →
    ∀ (p : Fin (x.length + 2)) (pre : List Bool) (t : ℕ),
      ∃ b',
        Turing.FinTM.VirtualTag (Turing.MultiTapeTM.runFrom c t).inputPos b' ∧
          Turing.MultiTapeTM.runFrom (Turing.vhostCfg c b p pre) t =
            Turing.vhostCfg (Turing.MultiTapeTM.runFrom c t) b' p pre
@Turing.counterLoopTM : {k : ℕ} →
  {S : Type} →
    [DecidableEq S] →
      Turing.MultiTapeTM k Bool S → S → Option S → Turing.MultiTapeTM (k + 1) Bool (Turing.CounterLoopState S)
@Turing.counterLoopTM_run_done : ∀ {k : ℕ} {S : Type} [inst : DecidableEq S] {x : List Bool}
  (M : Turing.MultiTapeTM k Bool S) (a : S) (exit : Option S) (τ : Turing.Cfg k Bool S x → ℕ)
  (c : Turing.Cfg k Bool S x) (w : List Bool) (ct : ℤ → Option Bool) (cp : ℤ),
  (∀ (p : ℤ), -1 ≤ p → p ≤ ↑w.length → ct (cp + p) = Turing.FinTM.bufferTape w p) →
    ∀ (d : ℕ),
      Nat.ofDigits 2 (List.map Bool.toNat w) = d →
        (∀ r < d,
            (Turing.counterLoopOrbit M τ c r).state = some a ∧
              0 < τ (Turing.counterLoopOrbit M τ c r) ∧
                (∀ (u : ℕ),
                    0 < u →
                      u < τ (Turing.counterLoopOrbit M τ c r) →
                        ∃ s,
                          (Turing.MultiTapeTM.runFrom (Turing.counterLoopOrbit M τ c r) u).state = some s ∧
                            s ≠ a ∧ exit ≠ some s) ∧
                  (Turing.counterLoopOrbit M τ c (r + 1)).state = some a) →
          ∀ (T : ℕ),
            T = ∑ r ∈ Finset.range d, τ (Turing.counterLoopOrbit M τ c r) + Turing.counterOverhead w (d + 1) →
              Turing.MultiTapeTM.runFrom
                    (Turing.counterLoopCfg (some (Turing.CounterLoopState.dec Turing.FlagPhase.run)) c ct cp) T =
                  Turing.counterLoopCfg (some Turing.CounterLoopState.done) (Turing.counterLoopOrbit M τ c d)
                    (fun q => if cp ≤ q ∧ q < cp + ↑w.length then some true else ct q) cp ∧
                (∀ t < T,
                    (Turing.MultiTapeTM.runFrom
                            (Turing.counterLoopCfg (some (Turing.CounterLoopState.dec Turing.FlagPhase.run)) c ct cp)
                            t).state ≠
                        some Turing.CounterLoopState.done ∧
                      (Turing.MultiTapeTM.runFrom
                            (Turing.counterLoopCfg (some (Turing.CounterLoopState.dec Turing.FlagPhase.run)) c ct cp)
                            t).state ≠
                        some Turing.CounterLoopState.escape) ∧
                  (∀ t ≤ T,
                      (Turing.MultiTapeTM.runFrom
                              (Turing.counterLoopCfg (some (Turing.CounterLoopState.dec Turing.FlagPhase.run)) c ct cp)
                              t).workTapePos
                          (Fin.last k) ∈
                        Finset.Icc (cp - 1) (cp + ↑w.length)) ∧
                    ∀ t ≤ T,
                      ∃ r u,
                        (r < d ∧ u ≤ τ (Turing.counterLoopOrbit M τ c r) ∨ r = d ∧ u = 0) ∧
                          ∀ (j : Fin k),
                            (Turing.MultiTapeTM.runFrom
                                    (Turing.counterLoopCfg (some (Turing.CounterLoopState.dec Turing.FlagPhase.run)) c
                                      ct cp)
                                    t).workTapePos
                                j.castSucc =
                              (Turing.MultiTapeTM.runFrom (Turing.counterLoopOrbit M τ c r) u).workTapePos j
@Turing.counterLoopTM_run_escape : ∀ {k : ℕ} {S : Type} [inst : DecidableEq S] {x : List Bool}
  (M : Turing.MultiTapeTM k Bool S) (a e : S),
  e ≠ a →
    ∀ (τ : Turing.Cfg k Bool S x → ℕ) (c : Turing.Cfg k Bool S x) (w : List Bool) (ct : ℤ → Option Bool) (cp : ℤ),
      (∀ (p : ℤ), -1 ≤ p → p ≤ ↑w.length → ct (cp + p) = Turing.FinTM.bufferTape w p) →
        ∀ r₀ < Nat.ofDigits 2 (List.map Bool.toNat w),
          (∀ r ≤ r₀,
              (Turing.counterLoopOrbit M τ c r).state = some a ∧
                0 < τ (Turing.counterLoopOrbit M τ c r) ∧
                  ∀ (u : ℕ),
                    0 < u →
                      u < τ (Turing.counterLoopOrbit M τ c r) →
                        ∃ s,
                          (Turing.MultiTapeTM.runFrom (Turing.counterLoopOrbit M τ c r) u).state = some s ∧
                            s ≠ a ∧ s ≠ e) →
            (Turing.counterLoopOrbit M τ c (r₀ + 1)).state = some e →
              ∀ (T : ℕ),
                T =
                    ∑ r ∈ Finset.range (r₀ + 1), τ (Turing.counterLoopOrbit M τ c r) +
                      Turing.counterOverhead w (r₀ + 1) →
                  Turing.MultiTapeTM.runFrom
                        (Turing.counterLoopCfg (some (Turing.CounterLoopState.dec Turing.FlagPhase.run)) c ct cp) T =
                      Turing.counterLoopCfg (some Turing.CounterLoopState.escape)
                        (Turing.counterLoopOrbit M τ c (r₀ + 1))
                        (fun q =>
                          if cp ≤ q ∧ q < cp + ↑w.length then
                            Turing.FinTM.bufferTape (Turing.counterWord w (r₀ + 1)) (q - cp)
                          else ct q)
                        cp ∧
                    (∀ t < T,
                        (Turing.MultiTapeTM.runFrom
                                (Turing.counterLoopCfg (some (Turing.CounterLoopState.dec Turing.FlagPhase.run)) c ct
                                  cp)
                                t).state ≠
                            some Turing.CounterLoopState.done ∧
                          (Turing.MultiTapeTM.runFrom
                                (Turing.counterLoopCfg (some (Turing.CounterLoopState.dec Turing.FlagPhase.run)) c ct
                                  cp)
                                t).state ≠
                            some Turing.CounterLoopState.escape) ∧
                      (∀ t ≤ T,
                          (Turing.MultiTapeTM.runFrom
                                  (Turing.counterLoopCfg (some (Turing.CounterLoopState.dec Turing.FlagPhase.run)) c ct
                                    cp)
                                  t).workTapePos
                              (Fin.last k) ∈
                            Finset.Icc (cp - 1) (cp + ↑w.length)) ∧
                        ∀ t ≤ T,
                          ∃ r u,
                            (r ≤ r₀ ∧ u ≤ τ (Turing.counterLoopOrbit M τ c r) ∨ r = r₀ + 1 ∧ u = 0) ∧
                              ∀ (j : Fin k),
                                (Turing.MultiTapeTM.runFrom
                                        (Turing.counterLoopCfg (some (Turing.CounterLoopState.dec Turing.FlagPhase.run))
                                          c ct cp)
                                        t).workTapePos
                                    j.castSucc =
                                  (Turing.MultiTapeTM.runFrom (Turing.counterLoopOrbit M τ c r) u).workTapePos j
@Turing.counterLoop_time_le : ∀ {k : ℕ} {Symbol S : Type} {x : List Symbol} (M : Turing.MultiTapeTM k Symbol S)
  (τ : Turing.Cfg k Symbol S x → ℕ) (c : Turing.Cfg k Symbol S x) (w : List Bool) (d : ℕ),
  Nat.ofDigits 2 (List.map Bool.toNat w) = d →
    ∀ (B : ℕ),
      (∀ r < d, τ (Turing.counterLoopOrbit M τ c r) ≤ B) →
        ∑ r ∈ Finset.range d, τ (Turing.counterLoopOrbit M τ c r) + Turing.counterOverhead w (d + 1) ≤
          d * B + 4 * d + 2 * w.length + 2
