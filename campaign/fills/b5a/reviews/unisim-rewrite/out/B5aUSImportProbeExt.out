  (Fin (n + 1) → Option Bool → (Fin k → Option Bool) → Turing.Action k Bool (Fin (n + 1))) → List Bool
@Turing.unaryFin : {n : ℕ} → Fin n → List Bool
Turing.pairEncode : List Bool → List Bool → List Bool
@Turing.vhostBank : {m : ℕ} → Fin m → Fin (1 + m)
