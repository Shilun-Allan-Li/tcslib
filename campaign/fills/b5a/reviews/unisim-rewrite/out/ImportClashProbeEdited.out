Turing.MachineFormat.exists_uniformSimulator : ∀ (F : Turing.MachineFormat),
  ∃ S d,
    ∀ (α x : List Bool) (t : ℕ),
      ((F.toFinTM (F.decode α)).ComputesInTime x [true] t →
          S.ComputesInTime (Turing.pairEncode (Turing.pairEncode t.bits α) x) [true]
            (d * (α.length + x.length + t + 1) ^ d)) ∧
        (¬(F.toFinTM (F.decode α)).ComputesInTime x [true] t →
          S.ComputesInTime (Turing.pairEncode (Turing.pairEncode t.bits α) x) [false]
            (d * (α.length + x.length + t + 1) ^ d))
