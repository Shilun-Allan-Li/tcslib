-    · simp
-    · funext i; simp [Action.apply, sub_eq_add_neg]
-  | cons b bs =>
-    cases b <;> refine Cfg.ext rfl (moveInputPos_zero p) ?_ ?_ rfl
-    all_goals first
-      | (funext i; exact loopBuffer_write pre bs _ _)
-      | (funext i; simp [Action.apply, sub_eq_add_neg])
