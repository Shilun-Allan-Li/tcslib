  (i : ι) (d : Turing.Cfg k Γ S x), (C₁.trans C₂ link hlink hX).time i d = C₁.time i d + C₂.time (link i) (C₁.post i d)
@Turing.FinTM.bufferTape_append : ∀ {Symbol : Type u_1} (w : List Symbol) (b : Symbol),
  Turing.FinTM.bufferTape (w ++ [b]) = Function.update (Turing.FinTM.bufferTape w) (↑w.length) (some b)
@Turing.FinTM.bufferTape_inputSymbol : ∀ {k : ℕ} {S : Type} {w : List Bool} (c : Turing.Cfg k Bool S w),
  Turing.FinTM.bufferTape w (↑↑c.inputPos - 1) = c.inputSymbol
@Turing.FinTM.bufferTape_left : ∀ {Symbol : Type u_1} (w : List Symbol), Turing.FinTM.bufferTape w (-1) = none
@Turing.FinTM.bufferTape_map : ∀ {Γ : Type} (e : Bool ↪ Γ) (w : List Bool) (p : ℤ),
  Turing.FinTM.bufferTape (List.map (⇑e) w) p = Option.map (⇑e) (Turing.FinTM.bufferTape w p)
@Turing.FinTM.bufferTape_map_decode : ∀ {Γ : Type} [inst : DecidableEq Γ] (e : Bool ↪ Γ) (w : List Bool) (p : ℤ),
  (Turing.FinTM.bufferTape (List.map (⇑e) w) p).bind (Turing.decodeBool e) = Turing.FinTM.bufferTape w p
@Turing.FinTM.bufferTape_nat : ∀ {Symbol : Type u_1} (w : List Symbol) (i : ℕ), Turing.FinTM.bufferTape w ↑i = w[i]?
@Turing.FinTM.bufferTape_nil : ∀ {Symbol : Type u_1}, Turing.FinTM.bufferTape [] = fun x => none
@Turing.Segment.and : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} {M : Turing.MultiTapeTM k Γ S} {F : Set (Option S)}
  {P Q : (Fin k → ℤ) → Prop} {a b : Turing.Cfg k Γ S x} {t : ℕ},
  Turing.Segment M F P a b t → Turing.Segment M F Q a b t → Turing.Segment M F (fun p => P p ∧ Q p) a b t
@Turing.Segment.cons : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} {M : Turing.MultiTapeTM k Γ S} {F : Set (Option S)}
  {P : (Fin k → ℤ) → Prop} {a a₁ b : Turing.Cfg k Γ S x} {t : ℕ},
  Turing.MultiTapeTM.step a = a₁ →
    a.state ∉ F → P a.workTapePos → Turing.Segment M F P a₁ b t → Turing.Segment M F P a b (1 + t)
@Turing.Segment.drop : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} {M : Turing.MultiTapeTM k Γ S} {F : Set (Option S)}
  {P : (Fin k → ℤ) → Prop} {a b : Turing.Cfg k Γ S x} {t u : ℕ},
