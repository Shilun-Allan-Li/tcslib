                      else (Turing.MultiTapeTM.runFrom d t).workTapePos j = d.workTapePos j)
  (p : List Bool × List Bool) (d : Turing.Cfg k Bool Turing.FlagPhase x),
  (Turing.counterRowContract M i x fix lead hrun).post p d =
    { state := some (Turing.FlagPhase.done true), inputPos := d.inputPos,
      workTapes := fun j q =>
        if j = i ∧ d.workTapePos j ≤ q ∧ q < d.workTapePos j + ↑p.1.length then
          Turing.FinTM.bufferTape p.2 (q - d.workTapePos j)
        else d.workTapes j q,
      workTapePos := d.workTapePos, output := d.output }
