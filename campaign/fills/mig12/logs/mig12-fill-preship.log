@Turing.Segment.live : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} {M : Turing.MultiTapeTM k Γ S} {F : Set (Option S)}
  {P : (Fin k → ℤ) → Prop} {a b : Turing.Cfg k Γ S x} {t : ℕ},
  Turing.Segment M F P a b t → b.state ≠ none → Turing.Segment M (insert none F) P a b t
@Turing.Segment.one : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} {M : Turing.MultiTapeTM k Γ S} {F : Set (Option S)}
  {P : (Fin k → ℤ) → Prop} {a : Turing.Cfg k Γ S x},
  a.state ∉ F →
    P a.workTapePos → P (Turing.MultiTapeTM.step a).workTapePos → Turing.Segment M F P a (Turing.MultiTapeTM.step a) 1
@Turing.Segment.take : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} {M : Turing.MultiTapeTM k Γ S} {F : Set (Option S)}
  {P : (Fin k → ℤ) → Prop} {a b : Turing.Cfg k Γ S x} {t u : ℕ},
  Turing.Segment M F P a b t → u ≤ t → Turing.Segment M F P a (Turing.MultiTapeTM.runFrom a u) u
@Turing.Segment.time_eq : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} {M : Turing.MultiTapeTM k Γ S} {F : Set (Option S)}
  {P : (Fin k → ℤ) → Prop} {a b b' : Turing.Cfg k Γ S x} {t t' : ℕ} {P' : (Fin k → ℤ) → Prop},
  Turing.Segment M F P a b t → b.state ∈ F → Turing.Segment M F P' a b' t' → b'.state ∈ F → t = t'
@Turing.Segment.zero : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} {M : Turing.MultiTapeTM k Γ S} {F : Set (Option S)}
  {P : (Fin k → ℤ) → Prop} {a : Turing.Cfg k Γ S x}, P a.workTapePos → Turing.Segment M F P a a 0
@Turing.clearTM_contract_frames : ∀ {k : ℕ} {Γ : Type} (i : Fin k) (x : List Γ),
  (Turing.clearTM_contract i x).Frames fun w d j =>
    if j = i then Set.Ico (d.workTapePos j) (d.workTapePos j + ↑w.length) else ∅
@Turing.clearTM_contract_hi : ∀ {k : ℕ} {Γ : Type} (i : Fin k) (x i_1 : List Γ) (d : Turing.Cfg k Γ Turing.SweepPhase x)
  (j : Fin k),
  (Turing.clearTM_contract i x).hi i_1 d j = if j = i then d.workTapePos j + ↑i_1.length else d.workTapePos j
@Turing.clearTM_contract_lo : ∀ {k : ℕ} {Γ : Type} (i : Fin k) (x i_1 : List Γ) (d : Turing.Cfg k Γ Turing.SweepPhase x)
  (j : Fin k), (Turing.clearTM_contract i x).lo i_1 d j = if j = i then d.workTapePos j - 1 else d.workTapePos j
@Turing.clearTM_contract_post : ∀ {k : ℕ} {Γ : Type} (i : Fin k) (x w : List Γ)
  (d : Turing.Cfg k Γ Turing.SweepPhase x),
  (Turing.clearTM_contract i x).post w d = Turing.sweepPost Turing.SweepPhase.done i (fun x_1 x x_2 x_3 => none) w d
@Turing.clearTM_contract_pre : ∀ {k : ℕ} {Γ : Type} (i : Fin k) (x w : List Γ) (d : Turing.Cfg k Γ Turing.SweepPhase x),
  (Turing.clearTM_contract i x).pre w d =
    ∀ (p : ℤ), -1 ≤ p → p ≤ ↑w.length → d.workTapes i (d.workTapePos i + p) = Turing.FinTM.bufferTape w p
@Turing.clearTM_contract_time : ∀ {k : ℕ} {Γ : Type} (i : Fin k) (x w : List Γ)
  (x_1 : Turing.Cfg k Γ Turing.SweepPhase x), (Turing.clearTM_contract i x).time w x_1 = 2 * w.length + 2
@Turing.clearTM_contract_traj : ∀ {k : ℕ} {Γ : Type} (i : Fin k) (x : List Γ),
  (Turing.clearTM_contract i x).Traj fun x_1 d p => ∀ (j : Fin k), j ≠ i → p j = d.workTapePos j
@Turing.compareStop.congr_simp : ∀ {Symbol : Type u_1} {inst : DecidableEq Symbol} [inst_1 : DecidableEq Symbol]
  (u u_1 : List Symbol),
  u = u_1 → ∀ (v v_1 : List Symbol), v = v_1 → Turing.compareStop u v = Turing.compareStop u_1 v_1
@Turing.compareStop_cons_cons : ∀ {Symbol : Type u_1} [inst : DecidableEq Symbol] (a b : Symbol) (u v : List Symbol),
  Turing.compareStop (a :: u) (b :: v) = if a = b then Turing.compareStop u v + 1 else 0
@Turing.compareStop_eq : ∀ {Symbol : Type u_1} [inst : DecidableEq Symbol] (u v : List Symbol),
  Turing.compareStop u v = (List.takeWhile (fun p => decide (p.1 = p.2)) (u.zip v)).length
@Turing.compareStop_le : ∀ {Symbol : Type u_1} [inst : DecidableEq Symbol] (u v : List Symbol),
  Turing.compareStop u v ≤ min u.length v.length
@Turing.compareStop_spec : ∀ {Symbol : Type u_1} [inst : DecidableEq Symbol] (u v : List Symbol),
  (∀ r < Turing.compareStop u v, ∃ b, u[r]? = some b ∧ v[r]? = some b) ∧
    ¬∃ b, u[Turing.compareStop u v]? = some b ∧ v[Turing.compareStop u v]? = some b
@Turing.compareStop_unique : ∀ {Symbol : Type u_1} [inst : DecidableEq Symbol] {u v : List Symbol} {d : ℕ},
  (∀ r < d, ∃ b, u[r]? = some b ∧ v[r]? = some b) → (¬∃ b, u[d]? = some b ∧ v[d]? = some b) → d = Turing.compareStop u v
@Turing.compareTM_contract_hi : ∀ {k : ℕ} {Γ : Type} [inst : DecidableEq Γ] (fst snd : Fin k) (hne : fst ≠ snd)
  (x : List Γ) (p : List Γ × List Γ) (d : Turing.Cfg k Γ Turing.FlagPhase x) (j : Fin k),
  (Turing.compareTM_contract fst snd hne x).hi p d j =
    if j = fst ∨ j = snd then d.workTapePos j + ↑(Turing.compareStop p.1 p.2) else d.workTapePos j
@Turing.compareTM_contract_lo : ∀ {k : ℕ} {Γ : Type} [inst : DecidableEq Γ] (fst snd : Fin k) (hne : fst ≠ snd)
  (x : List Γ) (p : List Γ × List Γ) (d : Turing.Cfg k Γ Turing.FlagPhase x) (j : Fin k),
  (Turing.compareTM_contract fst snd hne x).lo p d j =
    if j = fst ∨ j = snd then d.workTapePos j - 1 else d.workTapePos j
@Turing.compareTM_contract_post : ∀ {k : ℕ} {Γ : Type} [inst : DecidableEq Γ] (fst snd : Fin k) (hne : fst ≠ snd)
  (x : List Γ) (p : List Γ × List Γ) (d : Turing.Cfg k Γ Turing.FlagPhase x),
  (Turing.compareTM_contract fst snd hne x).post p d =
    { state := some (Turing.FlagPhase.done (decide (p.1 = p.2))), inputPos := d.inputPos, workTapes := d.workTapes,
      workTapePos := d.workTapePos, output := d.output }
@Turing.compareTM_contract_pre : ∀ {k : ℕ} {Γ : Type} [inst : DecidableEq Γ] (fst snd : Fin k) (hne : fst ≠ snd)
  (x : List Γ) (p : List Γ × List Γ) (d : Turing.Cfg k Γ Turing.FlagPhase x),
  (Turing.compareTM_contract fst snd hne x).pre p d =
    ((∀ (q : ℤ), -1 ≤ q → q ≤ ↑p.1.length → d.workTapes fst (d.workTapePos fst + q) = Turing.FinTM.bufferTape p.1 q) ∧
      ∀ (q : ℤ), -1 ≤ q → q ≤ ↑p.2.length → d.workTapes snd (d.workTapePos snd + q) = Turing.FinTM.bufferTape p.2 q)
@Turing.compareTM_contract_time : ∀ {k : ℕ} {Γ : Type} [inst : DecidableEq Γ] (fst snd : Fin k) (hne : fst ≠ snd)
  (x : List Γ) (p : List Γ × List Γ) (x_1 : Turing.Cfg k Γ Turing.FlagPhase x),
  (Turing.compareTM_contract fst snd hne x).time p x_1 = 2 * Turing.compareStop p.1 p.2 + 2
@Turing.copyTM_contract_hi : ∀ {k : ℕ} {Γ : Type} (src dst : Fin k) (hne : src ≠ dst) (x i : List Γ)
  (d : Turing.Cfg k Γ Turing.SweepPhase x) (j : Fin k),
  (Turing.copyTM_contract src dst hne x).hi i d j =
    if j = src ∨ j = dst then d.workTapePos j + ↑i.length else d.workTapePos j
@Turing.copyTM_contract_lo : ∀ {k : ℕ} {Γ : Type} (src dst : Fin k) (hne : src ≠ dst) (x i : List Γ)
  (d : Turing.Cfg k Γ Turing.SweepPhase x) (j : Fin k),
  (Turing.copyTM_contract src dst hne x).lo i d j = if j = src ∨ j = dst then d.workTapePos j - 1 else d.workTapePos j
@Turing.copyTM_contract_post : ∀ {k : ℕ} {Γ : Type} (src dst : Fin k) (hne : src ≠ dst) (x w : List Γ)
  (d : Turing.Cfg k Γ Turing.SweepPhase x),
  (Turing.copyTM_contract src dst hne x).post w d =
    Turing.sweepPost Turing.SweepPhase.done dst (fun w d j q => Turing.FinTM.bufferTape w (q - d.workTapePos j)) w d
@Turing.copyTM_contract_pre : ∀ {k : ℕ} {Γ : Type} (src dst : Fin k) (hne : src ≠ dst) (x w : List Γ)
  (d : Turing.Cfg k Γ Turing.SweepPhase x),
  (Turing.copyTM_contract src dst hne x).pre w d =
    ∀ (p : ℤ), -1 ≤ p → p ≤ ↑w.length → d.workTapes src (d.workTapePos src + p) = Turing.FinTM.bufferTape w p
@Turing.copyTM_contract_time : ∀ {k : ℕ} {Γ : Type} (src dst : Fin k) (hne : src ≠ dst) (x w : List Γ)
  (x_1 : Turing.Cfg k Γ Turing.SweepPhase x), (Turing.copyTM_contract src dst hne x).time w x_1 = 2 * w.length + 2
@Turing.counterLoopTM_run_done : ∀ {k : ℕ} {S : Type} [inst : DecidableEq S] {x : List Bool}
  (M : Turing.MultiTapeTM k Bool S) (a : S) (exit : Option S) (τ : Turing.Cfg k Bool S x → ℕ)
  (c : Turing.Cfg k Bool S x) (w : List Bool) (ct : ℤ → Option Bool) (cp : ℤ),
  (∀ (p : ℤ), -1 ≤ p → p ≤ ↑w.length → ct (cp + p) = Turing.FinTM.bufferTape w p) →
    ∀ (d : ℕ),
      Nat.ofDigits 2 (List.map Bool.toNat w) = d →
        (∀ r < d,
            (Turing.counterLoopOrbit M τ c r).state = some a ∧
              0 < τ (Turing.counterLoopOrbit M τ c r) ∧
                (∀ (u : ℕ),
                    0 < u →
                      u < τ (Turing.counterLoopOrbit M τ c r) →
                        ∃ s,
                          (Turing.MultiTapeTM.runFrom (Turing.counterLoopOrbit M τ c r) u).state = some s ∧
                            s ≠ a ∧ exit ≠ some s) ∧
                  (Turing.counterLoopOrbit M τ c (r + 1)).state = some a) →
          ∀ (T : ℕ),
            T = ∑ r ∈ Finset.range d, τ (Turing.counterLoopOrbit M τ c r) + Turing.counterOverhead w (d + 1) →
              Turing.MultiTapeTM.runFrom
                    (Turing.counterLoopCfg (some (Turing.CounterLoopState.dec Turing.FlagPhase.run)) c ct cp) T =
                  Turing.counterLoopCfg (some Turing.CounterLoopState.done) (Turing.counterLoopOrbit M τ c d)
                    (fun q => if cp ≤ q ∧ q < cp + ↑w.length then some true else ct q) cp ∧
                (∀ t < T,
                    (Turing.MultiTapeTM.runFrom
                            (Turing.counterLoopCfg (some (Turing.CounterLoopState.dec Turing.FlagPhase.run)) c ct cp)
                            t).state ≠
                        some Turing.CounterLoopState.done ∧
                      (Turing.MultiTapeTM.runFrom
                            (Turing.counterLoopCfg (some (Turing.CounterLoopState.dec Turing.FlagPhase.run)) c ct cp)
                            t).state ≠
                        some Turing.CounterLoopState.escape) ∧
                  (∀ t ≤ T,
                      (Turing.MultiTapeTM.runFrom
                              (Turing.counterLoopCfg (some (Turing.CounterLoopState.dec Turing.FlagPhase.run)) c ct cp)
                              t).workTapePos
                          (Fin.last k) ∈
                        Finset.Icc (cp - 1) (cp + ↑w.length)) ∧
                    ∀ t ≤ T,
                      ∃ r u,
                        (r < d ∧ u ≤ τ (Turing.counterLoopOrbit M τ c r) ∨ r = d ∧ u = 0) ∧
                          ∀ (j : Fin k),
                            (Turing.MultiTapeTM.runFrom
                                    (Turing.counterLoopCfg (some (Turing.CounterLoopState.dec Turing.FlagPhase.run)) c
                                      ct cp)
                                    t).workTapePos
                                j.castSucc =
                              (Turing.MultiTapeTM.runFrom (Turing.counterLoopOrbit M τ c r) u).workTapePos j
@Turing.counterRowContract_hi : ∀ {k : ℕ} (M : Turing.MultiTapeTM k Bool Turing.FlagPhase) (i : Fin k) (x : List Bool)
  (fix : List Bool → Option (List Bool)) (lead : Bool → Bool)
  (hrun :
    ∀ (w v : List Bool),
      fix w = some v →
        ∀ (d : Turing.Cfg k Bool Turing.FlagPhase x),
          d.state = some Turing.FlagPhase.run →
            (∀ (q : ℤ), -1 ≤ q → q ≤ ↑w.length → d.workTapes i (d.workTapePos i + q) = Turing.FinTM.bufferTape w q) →
              Turing.MultiTapeTM.runFrom d (2 * (List.takeWhile lead w).length + 2) =
                  { state := some (Turing.FlagPhase.done true), inputPos := d.inputPos,
                    workTapes := fun j q =>
                      if j = i ∧ d.workTapePos j ≤ q ∧ q < d.workTapePos j + ↑w.length then
                        Turing.FinTM.bufferTape v (q - d.workTapePos j)
                      else d.workTapes j q,
                    workTapePos := d.workTapePos, output := d.output } ∧
                (∀ t < 2 * (List.takeWhile lead w).length + 2,
                    ∀ (b : Bool), (Turing.MultiTapeTM.runFrom d t).state ≠ some (Turing.FlagPhase.done b)) ∧
                  ∀ (j : Fin k),
                    ∀ t ≤ 2 * (List.takeWhile lead w).length + 2,
                      if j = i then
                        (Turing.MultiTapeTM.runFrom d t).workTapePos j ∈
                          Finset.Icc (d.workTapePos j - 1) (d.workTapePos j + ↑(List.takeWhile lead w).length)
                      else (Turing.MultiTapeTM.runFrom d t).workTapePos j = d.workTapePos j)
  (p : List Bool × List Bool) (d : Turing.Cfg k Bool Turing.FlagPhase x) (j : Fin k),
  (Turing.counterRowContract M i x fix lead hrun).hi p d j =
    if j = i then d.workTapePos j + ↑(List.takeWhile lead p.1).length else d.workTapePos j
