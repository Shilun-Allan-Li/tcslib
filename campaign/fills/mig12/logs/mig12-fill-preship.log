Turing.decFixed_false_cons : ∀ (w : List Bool),
  Turing.decFixed (false :: w) = Option.map (fun x => true :: x) (Turing.decFixed w)
Turing.decFixed_true_cons : ∀ (w : List Bool), Turing.decFixed (true :: w) = some (false :: w)
@Turing.decrementTM_contract_hi : ∀ {k : ℕ} (i : Fin k) (x : List Bool) (p : List Bool × List Bool)
  (d : Turing.Cfg k Bool Turing.FlagPhase x) (j : Fin k),
  (Turing.decrementTM_contract i x).hi p d j =
    if j = i then d.workTapePos j + ↑(List.takeWhile not p.1).length else d.workTapePos j
@Turing.decrementTM_contract_lo : ∀ {k : ℕ} (i : Fin k) (x : List Bool) (p : List Bool × List Bool)
  (d : Turing.Cfg k Bool Turing.FlagPhase x) (j : Fin k),
  (Turing.decrementTM_contract i x).lo p d j = if j = i then d.workTapePos j - 1 else d.workTapePos j
@Turing.decrementTM_contract_post : ∀ {k : ℕ} (i : Fin k) (x : List Bool) (p : List Bool × List Bool)
  (d : Turing.Cfg k Bool Turing.FlagPhase x),
  (Turing.decrementTM_contract i x).post p d =
    { state := some (Turing.FlagPhase.done true), inputPos := d.inputPos,
      workTapes := fun j q =>
        if j = i ∧ d.workTapePos j ≤ q ∧ q < d.workTapePos j + ↑p.1.length then
          Turing.FinTM.bufferTape p.2 (q - d.workTapePos j)
        else d.workTapes j q,
      workTapePos := d.workTapePos, output := d.output }
@Turing.decrementTM_contract_pre : ∀ {k : ℕ} (i : Fin k) (x : List Bool) (p : List Bool × List Bool)
  (d : Turing.Cfg k Bool Turing.FlagPhase x),
  (Turing.decrementTM_contract i x).pre p d =
    (Turing.decFixed p.1 = some p.2 ∧
      ∀ (q : ℤ), -1 ≤ q → q ≤ ↑p.1.length → d.workTapes i (d.workTapePos i + q) = Turing.FinTM.bufferTape p.1 q)
@Turing.decrementTM_contract_time : ∀ {k : ℕ} (i : Fin k) (x : List Bool) (p : List Bool × List Bool)
  (x_1 : Turing.Cfg k Bool Turing.FlagPhase x),
  (Turing.decrementTM_contract i x).time p x_1 = 2 * (List.takeWhile not p.1).length + 2
@Turing.embedEmitCfg_inputPos : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol} (ι : Fin m ↪ Fin k)
  (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ) (pre : List Symbol) (c : Turing.Cfg m Symbol S x),
  (Turing.embedEmitCfg ι tapes heads pre c).inputPos = c.inputPos
@Turing.embedEmitCfg_mapState_eq : ∀ {k : ℕ} {Γ : Type u_1} {m : ℕ} {S : Type u_2} {H : Type u_3} {x : List Γ}
  (σ : Fin m ↪ Fin k) (f : S → H) (tapes : Fin k → ℤ → Option Γ) (heads : Fin k → ℤ) (pre : List Γ)
  (c : Turing.Cfg m Γ S x) (d : Turing.Cfg k Γ H x),
  Option.map f c.state = d.state →
    c.inputPos = d.inputPos →
      pre ++ c.output = d.output →
        (∀ (i : Fin m), c.workTapes i = d.workTapes (σ i) ∧ c.workTapePos i = d.workTapePos (σ i)) →
          (∀ j ∉ Set.range ⇑σ, tapes j = d.workTapes j ∧ heads j = d.workTapePos j) →
            Turing.Cfg.mapState f (Turing.embedEmitCfg σ tapes heads pre c) = d
@Turing.embedEmitCfg_ofWords_eq : ∀ {k m : ℕ} {S : Type u_1} {x : List Bool} (σ : Fin m ↪ Fin k) (q : S)
  (v : Fin m → List Bool) (frame target : Fin k → List Bool),
  (∀ (i : Fin m), target (σ i) = v i) →
    (∀ j ∉ Set.range ⇑σ, frame j = target j) →
      Turing.embedEmitCfg σ (fun j => Turing.FinTM.bufferTape (frame j)) (fun x => 0) [] (Turing.Cfg.ofWords q v) =
        Turing.Cfg.ofWords q target
@Turing.embedEmitCfg_output : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol} (ι : Fin m ↪ Fin k)
  (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ) (pre : List Symbol) (c : Turing.Cfg m Symbol S x),
  (Turing.embedEmitCfg ι tapes heads pre c).output = pre ++ c.output
@Turing.embedEmitCfg_select : ∀ {k : ℕ} {Γ : Type u_1} {m : ℕ} {S : Type u_2} {x : List Γ} (σ : Fin m ↪ Fin k)
  (d : Turing.Cfg k Γ S x), Turing.embedEmitCfg σ d.workTapes d.workTapePos d.output (Turing.Cfg.select σ d) = d
@Turing.embedEmitCfg_selected_pos : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol} (ι : Fin m ↪ Fin k)
  (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ) (pre : List Symbol) (c : Turing.Cfg m Symbol S x) (i : Fin m),
  (Turing.embedEmitCfg ι tapes heads pre c).workTapePos (ι i) = c.workTapePos i
@Turing.embedEmitCfg_selected_tape : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol}
  (ι : Fin m ↪ Fin k) (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ) (pre : List Symbol)
  (c : Turing.Cfg m Symbol S x) (i : Fin m), (Turing.embedEmitCfg ι tapes heads pre c).workTapes (ι i) = c.workTapes i
@Turing.embedEmitCfg_state : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol} (ι : Fin m ↪ Fin k)
  (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ) (pre : List Symbol) (c : Turing.Cfg m Symbol S x),
  (Turing.embedEmitCfg ι tapes heads pre c).state = c.state
@Turing.embedEmitCfg_unselected : ∀ {k : ℕ} {Γ : Type u_1} {m : ℕ} {S : Type u_2} {x : List Γ} (σ : Fin m ↪ Fin k)
  (tapes : Fin k → ℤ → Option Γ) (heads : Fin k → ℤ) (pre : List Γ) (c : Turing.Cfg m Γ S x),
  ∀ j ∉ Set.range ⇑σ,
    (Turing.embedEmitCfg σ tapes heads pre c).workTapes j = tapes j ∧
      (Turing.embedEmitCfg σ tapes heads pre c).workTapePos j = heads j
@Turing.embedEmitTM_tr : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} (ι : Fin m ↪ Fin k)
  (M : Turing.MultiTapeTM m Symbol S) (q : S) (inp : Option Symbol) (w : Fin k → Option Symbol),
  ((Turing.embedEmitTM ι M).tr q inp w).inputTape = (M.tr q inp fun i => w (ι i)).inputTape ∧
    (∀ (i : Fin m), ((Turing.embedEmitTM ι M).tr q inp w).workTapes (ι i) = (M.tr q inp fun i => w (ι i)).workTapes i) ∧
      (∀ j ∉ Set.range ⇑ι, ((Turing.embedEmitTM ι M).tr q inp w).workTapes j = (none, 0)) ∧
        ((Turing.embedEmitTM ι M).tr q inp w).output = (M.tr q inp fun i => w (ι i)).output ∧
          ((Turing.embedEmitTM ι M).tr q inp w).state = (M.tr q inp fun i => w (ι i)).state
@Turing.embedEmitTM_visitedByTapeHead : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol}
  (ι : Fin m ↪ Fin k) (M : Turing.MultiTapeTM m Symbol S) (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ)
  (pre : List Symbol) (c : Turing.Cfg m Symbol S x) (t : ℕ) (i : Fin m),
  Turing.MultiTapeTM.visitedByTapeHead (Turing.embedEmitCfg ι tapes heads pre c) t (ι i) =
      Turing.MultiTapeTM.visitedByTapeHead c t i ∧
    Turing.MultiTapeTM.spaceUsedByTape (Turing.embedEmitCfg ι tapes heads pre c) t (ι i) =
      Turing.MultiTapeTM.spaceUsedByTape c t i
@Turing.embedEmitTM_visitedByTapeHead_frame : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol}
  (ι : Fin m ↪ Fin k) (M : Turing.MultiTapeTM m Symbol S) (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ)
  (pre : List Symbol) (c : Turing.Cfg m Symbol S x) (t : ℕ),
  ∀ j ∉ Set.range ⇑ι,
    Turing.MultiTapeTM.visitedByTapeHead (Turing.embedEmitCfg ι tapes heads pre c) t j = {heads j} ∧
      Turing.MultiTapeTM.spaceUsedByTape (Turing.embedEmitCfg ι tapes heads pre c) t j = 1
@Turing.fieldOffset_add_length_le : ∀ {Γ : Type u_1} (fs : List (List Γ)) (j : ℕ) (hj : j < fs.length),
  Turing.fieldOffset fs j + fs[j].length ≤ (Turing.joinFields fs).length
@Turing.fieldsTape_cons_shift : ∀ {Γ : Type u_1} (u v : List Γ) (fs : List (List Γ)) (z : ℤ),
  -1 ≤ z → Turing.fieldsTape (u :: v :: fs) (↑u.length + 1 + z) = Turing.fieldsTape (v :: fs) z
@Turing.fieldsTape_field : ∀ {Γ : Type u_1} (fs : List (List Γ)) (j : ℕ) (hj : j < fs.length) (p : ℤ),
  -1 ≤ p → p ≤ ↑fs[j].length → Turing.fieldsTape fs (↑(Turing.fieldOffset fs j) + p) = Turing.FinTM.bufferTape fs[j] p
@Turing.fieldsTape_nil : ∀ {Γ : Type u_1} (z : ℤ), Turing.fieldsTape [] z = none
@Turing.fieldsTape_of_length_le : ∀ {Γ : Type u_1} (fs : List (List Γ)) {z : ℤ},
  ↑(Turing.joinFields fs).length ≤ z → Turing.fieldsTape fs z = none
@Turing.fieldsTape_of_neg : ∀ {Γ : Type u_1} (fs : List (List Γ)) {z : ℤ}, z < 0 → Turing.fieldsTape fs z = none
@Turing.fieldsTape_of_nonneg : ∀ {Γ : Type u_1} (fs : List (List Γ)) {z : ℤ},
  0 ≤ z → Turing.fieldsTape fs z = (Turing.joinFields fs)[z.toNat]?.join
Turing.incFixed_eq_none_iff_replicate : ∀ (u : List Bool), Turing.incFixed u = none ↔ u = List.replicate u.length true
Turing.incFixed_false_cons : ∀ (w : List Bool), Turing.incFixed (false :: w) = some (true :: w)
Turing.incFixed_replicate_true_append : ∀ (n : ℕ) (w : List Bool),
  Turing.incFixed (List.replicate n true ++ w) = Option.map (fun x => List.replicate n false ++ x) (Turing.incFixed w)
Turing.incFixed_true_cons : ∀ (w : List Bool),
  Turing.incFixed (true :: w) = Option.map (fun x => false :: x) (Turing.incFixed w)
@Turing.incrementTM_contract_hi : ∀ {k : ℕ} (i : Fin k) (x : List Bool) (p : List Bool × List Bool)
  (d : Turing.Cfg k Bool Turing.FlagPhase x) (j : Fin k),
  (Turing.incrementTM_contract i x).hi p d j =
    if j = i then d.workTapePos j + ↑(List.takeWhile id p.1).length else d.workTapePos j
@Turing.incrementTM_contract_lo : ∀ {k : ℕ} (i : Fin k) (x : List Bool) (p : List Bool × List Bool)
  (d : Turing.Cfg k Bool Turing.FlagPhase x) (j : Fin k),
  (Turing.incrementTM_contract i x).lo p d j = if j = i then d.workTapePos j - 1 else d.workTapePos j
@Turing.incrementTM_contract_post : ∀ {k : ℕ} (i : Fin k) (x : List Bool) (p : List Bool × List Bool)
  (d : Turing.Cfg k Bool Turing.FlagPhase x),
  (Turing.incrementTM_contract i x).post p d =
    { state := some (Turing.FlagPhase.done true), inputPos := d.inputPos,
      workTapes := fun j q =>
        if j = i ∧ d.workTapePos j ≤ q ∧ q < d.workTapePos j + ↑p.1.length then
          Turing.FinTM.bufferTape p.2 (q - d.workTapePos j)
        else d.workTapes j q,
      workTapePos := d.workTapePos, output := d.output }
@Turing.incrementTM_contract_pre : ∀ {k : ℕ} (i : Fin k) (x : List Bool) (p : List Bool × List Bool)
  (d : Turing.Cfg k Bool Turing.FlagPhase x),
  (Turing.incrementTM_contract i x).pre p d =
    (Turing.incFixed p.1 = some p.2 ∧
      ∀ (q : ℤ), -1 ≤ q → q ≤ ↑p.1.length → d.workTapes i (d.workTapePos i + q) = Turing.FinTM.bufferTape p.1 q)
@Turing.incrementTM_contract_time : ∀ {k : ℕ} (i : Fin k) (x : List Bool) (p : List Bool × List Bool)
  (x_1 : Turing.Cfg k Bool Turing.FlagPhase x),
  (Turing.incrementTM_contract i x).time p x_1 = 2 * (List.takeWhile id p.1).length + 2
@Turing.joinFields_cons_cons : ∀ {Γ : Type u_1} (u v : List Γ) (fs : List (List Γ)),
  Turing.joinFields (u :: v :: fs) = List.map some u ++ none :: Turing.joinFields (v :: fs)
@Turing.joinFields_nil : ∀ {Γ : Type u_1}, Turing.joinFields [] = []
@Turing.joinFields_singleton : ∀ {Γ : Type u_1} (u : List Γ), Turing.joinFields [u] = List.map some u
@Turing.moveInputPos_leftBoundary : ∀ {n : ℕ}, Turing.moveInputPos 0 (-1) = 0
@Turing.moveInputPos_neg_of_ne_left : ∀ {n : ℕ} (p : Fin (n + 2)),
  p ≠ 0 → Turing.moveInputPos p SignType.neg = ⟨↑p - 1, ⋯⟩
@Turing.moveInputPos_pos_of_ne_right : ∀ {n : ℕ} (p : Fin (n + 2)) (h : ↑p ≠ n + 1),
  Turing.moveInputPos p SignType.pos = ⟨↑p + 1, ⋯⟩
@Turing.moveInputPos_rightBoundary : ∀ {n : ℕ}, Turing.moveInputPos ⟨n + 1, ⋯⟩ 1 = ⟨n + 1, ⋯⟩
@Turing.moveInputPos_zero : ∀ {n : ℕ} (pos : Fin (n + 2)), Turing.moveInputPos pos 0 = pos
@Turing.scanResult_carry : ∀ {Γ : Type u_1} (top : Γ → Bool) (next : Γ → Γ) (w : List Γ),
  Turing.scanResult (Turing.scanCarry top next) Turing.scanKeep true w =
    (w.all top,
      List.map next (List.takeWhile top w) ++ List.map next (List.take 1 (List.dropWhile top w)) ++
        List.drop 1 (List.dropWhile top w))
@Turing.scanResult_fold : ∀ {A : Type u_1} {Γ : Type u_2} (δ : A → Γ → A) (a₀ : A) (w : List Γ),
  Turing.scanResult (Turing.scanFold δ) Turing.scanKeep a₀ w = (List.foldl δ a₀ w, w)
@Turing.scanResult_map : ∀ {A : Type u_1} {Γ : Type u_2} (f : Γ → Γ) (a₀ : A) (w : List Γ),
  Turing.scanResult (Turing.scanMap f) Turing.scanKeep a₀ w = (a₀, List.map f w)
@Turing.scanResult_shiftLeft : ∀ {B : Type u_1} {Γ : Type u_2} (get : Γ → B) (set : Γ → B → Γ) (b₀ : B) (w : List Γ),
  Turing.scanResult Turing.scanKeep (Turing.scanShift get set) b₀ w =
    ((List.map get w).head?.getD b₀, List.zipWith set w (List.map get w.tail ++ [b₀]))
@Turing.scanResult_shiftRight : ∀ {B : Type u_1} {Γ : Type u_2} (get : Γ → B) (set : Γ → B → Γ) (b₀ : B) (w : List Γ),
  Turing.scanResult (Turing.scanShift get set) Turing.scanKeep b₀ w =
    ((List.map get w).getLast?.getD b₀, List.zipWith set w (b₀ :: List.map get w))
@Turing.scanTM_contract_hi : ∀ {k : ℕ} {Γ A : Type} (i : Fin k) (δf δb : A → Γ → A × Γ) (a₀ : A) (x w : List Γ)
  (d : Turing.Cfg k Γ (Turing.ScanPhase A) x) (j : Fin k),
  (Turing.scanTM_contract i δf δb a₀ x).hi w d j = if j = i then d.workTapePos j + ↑w.length else d.workTapePos j
@Turing.scanTM_contract_lo : ∀ {k : ℕ} {Γ A : Type} (i : Fin k) (δf δb : A → Γ → A × Γ) (a₀ : A) (x w : List Γ)
  (d : Turing.Cfg k Γ (Turing.ScanPhase A) x) (j : Fin k),
  (Turing.scanTM_contract i δf δb a₀ x).lo w d j = if j = i then d.workTapePos j - 1 else d.workTapePos j
@Turing.scanTM_contract_post : ∀ {k : ℕ} {Γ A : Type} (i : Fin k) (δf δb : A → Γ → A × Γ) (a₀ : A) (x w : List Γ)
  (d : Turing.Cfg k Γ (Turing.ScanPhase A) x),
  (Turing.scanTM_contract i δf δb a₀ x).post w d =
    { state := some (Turing.ScanPhase.done (Turing.scanResult δf δb a₀ w).1), inputPos := d.inputPos,
      workTapes := fun j q =>
        if j = i ∧ d.workTapePos j ≤ q ∧ q < d.workTapePos j + ↑w.length then
          Turing.FinTM.bufferTape (Turing.scanResult δf δb a₀ w).2 (q - d.workTapePos j)
        else d.workTapes j q,
      workTapePos := d.workTapePos, output := d.output }
@Turing.scanTM_contract_pre : ∀ {k : ℕ} {Γ A : Type} (i : Fin k) (δf δb : A → Γ → A × Γ) (a₀ : A) (x w : List Γ)
  (d : Turing.Cfg k Γ (Turing.ScanPhase A) x),
  (Turing.scanTM_contract i δf δb a₀ x).pre w d =
    ∀ (p : ℤ), -1 ≤ p → p ≤ ↑w.length → d.workTapes i (d.workTapePos i + p) = Turing.FinTM.bufferTape w p
@Turing.scanTM_contract_time : ∀ {k : ℕ} {Γ A : Type} (i : Fin k) (δf δb : A → Γ → A × Γ) (a₀ : A) (x w : List Γ)
  (x_1 : Turing.Cfg k Γ (Turing.ScanPhase A) x), (Turing.scanTM_contract i δf δb a₀ x).time w x_1 = 2 * w.length + 2
@Turing.skipBackTM_contract_hi : ∀ {k : ℕ} {Γ : Type} (i : Fin k) (x i_1 : List Γ)
  (d : Turing.Cfg k Γ Turing.SeekPhase x) (j : Fin k), (Turing.skipBackTM_contract i x).hi i_1 d j = d.workTapePos j
@Turing.skipBackTM_contract_lo : ∀ {k : ℕ} {Γ : Type} (i : Fin k) (x i_1 : List Γ)
  (d : Turing.Cfg k Γ Turing.SeekPhase x) (j : Fin k),
  (Turing.skipBackTM_contract i x).lo i_1 d j = if j = i then d.workTapePos j - ↑i_1.length - 2 else d.workTapePos j
@Turing.skipBackTM_contract_post : ∀ {k : ℕ} {Γ : Type} (i : Fin k) (x u : List Γ)
  (d : Turing.Cfg k Γ Turing.SeekPhase x),
  (Turing.skipBackTM_contract i x).post u d =
    Turing.seekPost Turing.SeekPhase.done i (d.workTapePos i - ↑u.length - 1) d
@Turing.skipBackTM_contract_pre : ∀ {k : ℕ} {Γ : Type} (i : Fin k) (x u : List Γ)
  (d : Turing.Cfg k Γ Turing.SeekPhase x),
  (Turing.skipBackTM_contract i x).pre u d =
    ∀ (p : ℤ),
      -1 ≤ p → p ≤ ↑u.length → d.workTapes i (d.workTapePos i - ↑u.length - 1 + p) = Turing.FinTM.bufferTape u p
@Turing.skipBackTM_contract_time : ∀ {k : ℕ} {Γ : Type} (i : Fin k) (x u : List Γ)
  (x_1 : Turing.Cfg k Γ Turing.SeekPhase x), (Turing.skipBackTM_contract i x).time u x_1 = u.length + 3
@Turing.skipTM_contract_hi : ∀ {k : ℕ} {Γ : Type} (i : Fin k) (x i_1 : List Γ) (d : Turing.Cfg k Γ Turing.SeekPhase x)
  (j : Fin k),
  (Turing.skipTM_contract i x).hi i_1 d j = if j = i then d.workTapePos j + ↑i_1.length + 1 else d.workTapePos j
@Turing.skipTM_contract_lo : ∀ {k : ℕ} {Γ : Type} (i : Fin k) (x i_1 : List Γ) (d : Turing.Cfg k Γ Turing.SeekPhase x)
  (j : Fin k), (Turing.skipTM_contract i x).lo i_1 d j = d.workTapePos j
@Turing.skipTM_contract_post : ∀ {k : ℕ} {Γ : Type} (i : Fin k) (x w : List Γ) (d : Turing.Cfg k Γ Turing.SeekPhase x),
  (Turing.skipTM_contract i x).post w d = Turing.seekPost Turing.SeekPhase.done i (d.workTapePos i + ↑w.length + 1) d
@Turing.skipTM_contract_pre : ∀ {k : ℕ} {Γ : Type} (i : Fin k) (x w : List Γ) (d : Turing.Cfg k Γ Turing.SeekPhase x),
  (Turing.skipTM_contract i x).pre w d =
    ∀ (p : ℤ), 0 ≤ p → p ≤ ↑w.length → d.workTapes i (d.workTapePos i + p) = Turing.FinTM.bufferTape w p
@Turing.skipTM_contract_time : ∀ {k : ℕ} {Γ : Type} (i : Fin k) (x w : List Γ)
  (x_1 : Turing.Cfg k Γ Turing.SeekPhase x), (Turing.skipTM_contract i x).time w x_1 = w.length + 1
@Turing.Action.apply_state : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  (action : Turing.Action k Symbol State) (cfg : Turing.Cfg k Symbol State input),
  (action.apply cfg).state = action.state
@Turing.Action.apply_inputPos : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  (action : Turing.Action k Symbol State) (cfg : Turing.Cfg k Symbol State input),
  (action.apply cfg).inputPos = Turing.moveInputPos cfg.inputPos action.inputTape
@Turing.Action.apply_workTapePos : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  (action : Turing.Action k Symbol State) (cfg : Turing.Cfg k Symbol State input) (i : Fin k),
  (action.apply cfg).workTapePos i = cfg.workTapePos i + ↑(action.workTapes i).2
@Turing.Action.apply_output : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  (action : Turing.Action k Symbol State) (cfg : Turing.Cfg k Symbol State input),
  (action.apply cfg).output = cfg.output ++ action.output.toList
@Turing.MultiTapeTM.step_of_some : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  {tm : Turing.MultiTapeTM k Symbol State} {cfg : Turing.Cfg k Symbol State input} {q : State},
  cfg.state = some q → Turing.MultiTapeTM.step cfg = (tm.tr q cfg.inputSymbol cfg.workTapeSymbols).apply cfg
@Turing.MultiTapeTM.outputSymbol_of_some : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  {tm : Turing.MultiTapeTM k Symbol State} {cfg : Turing.Cfg k Symbol State input} {q : State},
  cfg.state = some q → Turing.MultiTapeTM.outputSymbol cfg = (tm.tr q cfg.inputSymbol cfg.workTapeSymbols).output
Turing.counterWord_succ : ∀ (w : List Bool) (r : ℕ),
  Turing.counterWord w (r + 1) = (Turing.decFixed (Turing.counterWord w r)).getD (Turing.counterWord w r)
@Turing.scanResult_keep_keep : ∀ {A : Type u_1} {Γ : Type u_2} (a₀ : A) (w : List Γ),
  Turing.scanResult Turing.scanKeep Turing.scanKeep a₀ w = (a₀, w)
