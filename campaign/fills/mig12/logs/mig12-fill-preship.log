      Turing.MultiTapeTM k Γ S →
        Set (Option S) → ((Fin k → ℤ) → Prop) → Turing.Cfg k Γ S x → Turing.Cfg k Γ S x → ℕ → Prop
@Turing.Segment.mono : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} {M : Turing.MultiTapeTM k Γ S} {F : Set (Option S)}
  {P : (Fin k → ℤ) → Prop} {F' : Set (Option S)} {P' : (Fin k → ℤ) → Prop} {a b : Turing.Cfg k Γ S x} {t : ℕ},
  Turing.Segment M F P a b t → F' ⊆ F → (∀ (p : Fin k → ℤ), P p → P' p) → Turing.Segment M F' P' a b t
@Turing.Segment.trans : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} {M : Turing.MultiTapeTM k Γ S} {F : Set (Option S)}
  {P : (Fin k → ℤ) → Prop} {a b c : Turing.Cfg k Γ S x} {t v : ℕ},
  Turing.Segment M F P a b t → Turing.Segment M F P b c v → Turing.Segment M F P a c (t + v)
@Turing.clearTM_contract : {k : ℕ} →
  {Γ : Type} →
    (i : Fin k) →
      (x : List Γ) →
        Turing.Contract (Turing.clearTM k i) Turing.SweepPhase.sweep {some Turing.SweepPhase.done} (List Γ) x
@Turing.clearTM_run : ∀ {x : List Bool} (k : ℕ) (i : Fin k) (w : Fin k → List Bool),
  ∃ T ≤ 2 * (w i).length + 2,
    (∀ t < T,
        (Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords Turing.SweepPhase.sweep w) t).state ≠
          some Turing.SweepPhase.done) ∧
      Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords Turing.SweepPhase.sweep w) T =
        Turing.Cfg.ofWords Turing.SweepPhase.done (Function.update w i [])
@Turing.compareTM_contract : {k : ℕ} →
  {Γ : Type} →
    [inst : DecidableEq Γ] →
      (fst snd : Fin k) →
        fst ≠ snd →
          (x : List Γ) →
            Turing.Contract (Turing.compareTM k fst snd) Turing.FlagPhase.run
              (Set.range fun b => some (Turing.FlagPhase.done b)) (List Γ × List Γ) x
@Turing.compareTM_run : ∀ {x : List Bool} (k : ℕ) (fst snd : Fin k) (w : Fin k → List Bool),
  ∃ T ≤ 2 * min (w fst).length (w snd).length + 2,
    (∀ t < T,
        ∀ (v : Bool),
          (Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords Turing.FlagPhase.run w) t).state ≠
            some (Turing.FlagPhase.done v)) ∧
      Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords Turing.FlagPhase.run w) T =
        Turing.Cfg.ofWords (Turing.FlagPhase.done (decide (w fst = w snd))) w
@Turing.compareTM_run_ofCfg : ∀ {Symbol : Type u_1} [inst : DecidableEq Symbol] {k : ℕ} {x : List Symbol}
  (fst snd : Fin k),
  fst ≠ snd →
    ∀ (u v : List Symbol) (d : Turing.Cfg k Symbol Turing.FlagPhase x),
      d.state = some Turing.FlagPhase.run →
        (∀ (p : ℤ), -1 ≤ p → p ≤ ↑u.length → d.workTapes fst (d.workTapePos fst + p) = Turing.FinTM.bufferTape u p) →
          (∀ (p : ℤ), -1 ≤ p → p ≤ ↑v.length → d.workTapes snd (d.workTapePos snd + p) = Turing.FinTM.bufferTape v p) →
            ∃ δ ≤ min u.length v.length,
              Turing.MultiTapeTM.runFrom d (2 * δ + 2) =
                  { state := some (Turing.FlagPhase.done (decide (u = v))), inputPos := d.inputPos,
                    workTapes := d.workTapes, workTapePos := d.workTapePos, output := d.output } ∧
                (∀ t < 2 * δ + 2,
                    ∀ (b : Bool), (Turing.MultiTapeTM.runFrom d t).state ≠ some (Turing.FlagPhase.done b)) ∧
                  ∀ (j : Fin k),
                    ∀ t ≤ 2 * δ + 2,
                      if j = fst ∨ j = snd then
                        (Turing.MultiTapeTM.runFrom d t).workTapePos j ∈
                          Finset.Icc (d.workTapePos j - 1) (d.workTapePos j + ↑δ)
                      else (Turing.MultiTapeTM.runFrom d t).workTapePos j = d.workTapePos j
@Turing.copyTM_contract : {k : ℕ} →
  {Γ : Type} →
    (src dst : Fin k) →
      src ≠ dst →
        (x : List Γ) →
          Turing.Contract (Turing.copyTM k src dst) Turing.SweepPhase.sweep {some Turing.SweepPhase.done} (List Γ) x
@Turing.copyTM_contract_frames : ∀ {k : ℕ} {Γ : Type} (src dst : Fin k) (hne : src ≠ dst) (x : List Γ),
  (Turing.copyTM_contract src dst hne x).Frames fun w d j =>
    if j = dst then Set.Ico (d.workTapePos j) (d.workTapePos j + ↑w.length) else ∅
@Turing.copyTM_run : ∀ {x : List Bool} (k : ℕ) (src dst : Fin k),
  src ≠ dst →
    ∀ (w : Fin k → List Bool),
      w dst = [] →
        ∃ T ≤ 3 * (w src).length + 3,
          (∀ t < T,
              (Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords Turing.SweepPhase.sweep w) t).state ≠
                some Turing.SweepPhase.done) ∧
            Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords Turing.SweepPhase.sweep w) T =
              Turing.Cfg.ofWords Turing.SweepPhase.done (Function.update w dst (w src))
@Turing.counterLoopTM_run_escape : ∀ {k : ℕ} {S : Type} [inst : DecidableEq S] {x : List Bool}
  (M : Turing.MultiTapeTM k Bool S) (a e : S),
  e ≠ a →
    ∀ (τ : Turing.Cfg k Bool S x → ℕ) (c : Turing.Cfg k Bool S x) (w : List Bool) (ct : ℤ → Option Bool) (cp : ℤ),
      (∀ (p : ℤ), -1 ≤ p → p ≤ ↑w.length → ct (cp + p) = Turing.FinTM.bufferTape w p) →
        ∀ r₀ < Nat.ofDigits 2 (List.map Bool.toNat w),
          (∀ r ≤ r₀,
              (Turing.counterLoopOrbit M τ c r).state = some a ∧
                0 < τ (Turing.counterLoopOrbit M τ c r) ∧
                  ∀ (u : ℕ),
                    0 < u →
                      u < τ (Turing.counterLoopOrbit M τ c r) →
                        ∃ s,
                          (Turing.MultiTapeTM.runFrom (Turing.counterLoopOrbit M τ c r) u).state = some s ∧
                            s ≠ a ∧ s ≠ e) →
            (Turing.counterLoopOrbit M τ c (r₀ + 1)).state = some e →
              ∀ (T : ℕ),
                T =
                    ∑ r ∈ Finset.range (r₀ + 1), τ (Turing.counterLoopOrbit M τ c r) +
                      Turing.counterOverhead w (r₀ + 1) →
                  Turing.MultiTapeTM.runFrom
                        (Turing.counterLoopCfg (some (Turing.CounterLoopState.dec Turing.FlagPhase.run)) c ct cp) T =
                      Turing.counterLoopCfg (some Turing.CounterLoopState.escape)
                        (Turing.counterLoopOrbit M τ c (r₀ + 1))
                        (fun q =>
                          if cp ≤ q ∧ q < cp + ↑w.length then
                            Turing.FinTM.bufferTape (Turing.counterWord w (r₀ + 1)) (q - cp)
                          else ct q)
                        cp ∧
                    (∀ t < T,
                        (Turing.MultiTapeTM.runFrom
                                (Turing.counterLoopCfg (some (Turing.CounterLoopState.dec Turing.FlagPhase.run)) c ct
                                  cp)
                                t).state ≠
                            some Turing.CounterLoopState.done ∧
                          (Turing.MultiTapeTM.runFrom
                                (Turing.counterLoopCfg (some (Turing.CounterLoopState.dec Turing.FlagPhase.run)) c ct
                                  cp)
                                t).state ≠
                            some Turing.CounterLoopState.escape) ∧
                      (∀ t ≤ T,
                          (Turing.MultiTapeTM.runFrom
                                  (Turing.counterLoopCfg (some (Turing.CounterLoopState.dec Turing.FlagPhase.run)) c ct
                                    cp)
                                  t).workTapePos
                              (Fin.last k) ∈
                            Finset.Icc (cp - 1) (cp + ↑w.length)) ∧
                        ∀ t ≤ T,
                          ∃ r u,
                            (r ≤ r₀ ∧ u ≤ τ (Turing.counterLoopOrbit M τ c r) ∨ r = r₀ + 1 ∧ u = 0) ∧
                              ∀ (j : Fin k),
                                (Turing.MultiTapeTM.runFrom
                                        (Turing.counterLoopCfg (some (Turing.CounterLoopState.dec Turing.FlagPhase.run))
                                          c ct cp)
                                        t).workTapePos
                                    j.castSucc =
                                  (Turing.MultiTapeTM.runFrom (Turing.counterLoopOrbit M τ c r) u).workTapePos j
Turing.decFixed : List Bool → Option (List Bool)
@Turing.decFixed_length : ∀ {w v : List Bool}, Turing.decFixed w = some v → v.length = w.length
Turing.decFixed_nil : Turing.decFixed [] = none
@Turing.decrementTM_contract : {k : ℕ} →
  (i : Fin k) →
    (x : List Bool) →
      Turing.Contract (Turing.decrementTM k i) Turing.FlagPhase.run (Set.range fun b => some (Turing.FlagPhase.done b))
        (List Bool × List Bool) x
@Turing.embedEmitCfg : {m k : ℕ} →
  {S : Type u_1} →
    {Symbol : Type u_2} →
      {x : List Symbol} →
        (Fin m ↪ Fin k) →
          (Fin k → ℤ → Option Symbol) → (Fin k → ℤ) → List Symbol → Turing.Cfg m Symbol S x → Turing.Cfg k Symbol S x
@Turing.embedEmitCfg_eq : ∀ {k : ℕ} {Γ : Type u_1} {m : ℕ} {S : Type u_2} {x : List Γ} (σ : Fin m ↪ Fin k)
  (tapes : Fin k → ℤ → Option Γ) (heads : Fin k → ℤ) (pre : List Γ) (c : Turing.Cfg m Γ S x) (d : Turing.Cfg k Γ S x),
  c.state = d.state →
    c.inputPos = d.inputPos →
      pre ++ c.output = d.output →
        (∀ (i : Fin m), c.workTapes i = d.workTapes (σ i) ∧ c.workTapePos i = d.workTapePos (σ i)) →
          (∀ j ∉ Set.range ⇑σ, tapes j = d.workTapes j ∧ heads j = d.workTapePos j) →
            Turing.embedEmitCfg σ tapes heads pre c = d
@Turing.embedEmitTM_frame : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol} (ι : Fin m ↪ Fin k)
  (M : Turing.MultiTapeTM m Symbol S) (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ) (pre : List Symbol)
  (c : Turing.Cfg m Symbol S x) (t : ℕ),
  (∀ j ∉ Set.range ⇑ι,
      (Turing.MultiTapeTM.runFrom (Turing.embedEmitCfg ι tapes heads pre c) t).workTapes j = tapes j ∧
        (Turing.MultiTapeTM.runFrom (Turing.embedEmitCfg ι tapes heads pre c) t).workTapePos j = heads j) ∧
    (Turing.MultiTapeTM.runFrom (Turing.embedEmitCfg ι tapes heads pre c) t).inputPos =
        (Turing.MultiTapeTM.runFrom c t).inputPos ∧
      (Turing.MultiTapeTM.runFrom (Turing.embedEmitCfg ι tapes heads pre c) t).output =
        pre ++ (Turing.MultiTapeTM.runFrom c t).output
@Turing.embedEmitTM_runFrom : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol} (ι : Fin m ↪ Fin k)
  (M : Turing.MultiTapeTM m Symbol S) (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ) (pre : List Symbol)
  (c : Turing.Cfg m Symbol S x) (t : ℕ),
  Turing.MultiTapeTM.runFrom (Turing.embedEmitCfg ι tapes heads pre c) t =
    Turing.embedEmitCfg ι tapes heads pre (Turing.MultiTapeTM.runFrom c t)
@Turing.fieldOffset : {Γ : Type u_1} → List (List Γ) → ℕ → ℕ
@Turing.fieldOffset_cons_succ : ∀ {Γ : Type u_1} (u : List Γ) (fs : List (List Γ)) (j : ℕ),
  Turing.fieldOffset (u :: fs) (j + 1) = u.length + 1 + Turing.fieldOffset fs j
@Turing.fieldOffset_succ : ∀ {Γ : Type u_1} (fs : List (List Γ)) (j : ℕ) (hj : j < fs.length),
  Turing.fieldOffset fs (j + 1) = Turing.fieldOffset fs j + (fs[j].length + 1)
@Turing.fieldOffset_zero : ∀ {Γ : Type u_1} (fs : List (List Γ)), Turing.fieldOffset fs 0 = 0
@Turing.fieldsTape : {Γ : Type u_1} → List (List Γ) → ℤ → Option Γ
@Turing.headBox_iff : ∀ {k : ℕ} (lo hi p : Fin k → ℤ),
  Turing.HeadBox lo hi p ↔ ∀ (j : Fin k), p j ∈ Finset.Icc (lo j) (hi j)
Turing.incFixed : List Bool → Option (List Bool)
@Turing.incFixed_length : ∀ {w v : List Bool}, Turing.incFixed w = some v → v.length = w.length
Turing.incFixed_nil : Turing.incFixed [] = none
@Turing.incrementTM_contract : {k : ℕ} →
  (i : Fin k) →
    (x : List Bool) →
      Turing.Contract (Turing.incrementTM k i) Turing.FlagPhase.run (Set.range fun b => some (Turing.FlagPhase.done b))
        (List Bool × List Bool) x
@Turing.incrementTM_run_overflow : ∀ {x : List Bool} (k : ℕ) (i : Fin k) (w : Fin k → List Bool),
  Turing.incFixed (w i) = none →
    ∃ T ≤ 2 * (w i).length + 2,
      (∀ t < T,
          ∀ (b : Bool),
            (Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords Turing.FlagPhase.run w) t).state ≠
              some (Turing.FlagPhase.done b)) ∧
        Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords Turing.FlagPhase.run w) T =
          Turing.Cfg.ofWords (Turing.FlagPhase.done false) (Function.update w i (List.replicate (w i).length false))
@Turing.incrementTM_run_succ : ∀ {x : List Bool} (k : ℕ) (i : Fin k) (w : Fin k → List Bool) (v : List Bool),
  Turing.incFixed (w i) = some v →
    ∃ T ≤ 2 * (w i).length + 2,
      (∀ t < T,
          ∀ (b : Bool),
            (Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords Turing.FlagPhase.run w) t).state ≠
              some (Turing.FlagPhase.done b)) ∧
        Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords Turing.FlagPhase.run w) T =
          Turing.Cfg.ofWords (Turing.FlagPhase.done true) (Function.update w i v)
@Turing.inputSymbolInner : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  {cfg : Turing.Cfg k Symbol State input} (p : ℕ),
  ↑cfg.inputPos = 1 + p → ∀ (h₂ : p < input.length), cfg.inputSymbol = some input[p]
@Turing.moveInputPos : {n : ℕ} → Fin (n + 2) → SignType → Fin (n + 2)
@Turing.phaseHostTM : {k : ℕ} →
  {Γ I : Type} →
    {Ph : I → Type} →
      ((i : I) → Turing.MultiTapeTM k Γ (Ph i)) →
        (i : I) × Ph i → ((i : I) → Ph i → Option ((i : I) × Ph i)) → Turing.MultiTapeTM k Γ ((i : I) × Ph i)
@Turing.phaseHostTM_run : ∀ {k : ℕ} {Γ I : Type} {Ph : I → Type} (M : (i : I) → Turing.MultiTapeTM k Γ (Ph i))
  (q0 : (i : I) × Ph i) (red : (i : I) → Ph i → Option ((i : I) × Ph i)) (i : I) {x : List Γ}
  (c c' : Turing.Cfg k Γ (Ph i) x) (T : ℕ),
  Turing.MultiTapeTM.runFrom c T = c' →
    ∀ (s' : Ph i),
      c'.state = some s' →
        ∀ (q' : (i : I) × Ph i),
          red i s' = some q' →
            (∀ u < T, ∀ (s : Ph i), (Turing.MultiTapeTM.runFrom c u).state = some s → red i s = none) →
              (∀ u ≤ T,
                  Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState (Sigma.mk i) c) u =
                    Turing.Cfg.mapState (Sigma.mk i) (Turing.MultiTapeTM.runFrom c u)) ∧
                Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState (Sigma.mk i) c) (T + 1) =
                  Turing.Cfg.mapState (fun x => q') c'
@Turing.round_iff : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} (M : Turing.MultiTapeTM k Γ S) (a : S) (E : Set (Option S))
  (P : (Fin k → ℤ) → Prop) (c c' : Turing.Cfg k Γ S x) (t : ℕ),
  Turing.Round M a E P c c' t ↔
    c.state = some a ∧
      0 < t ∧
        Turing.MultiTapeTM.runFrom c t = c' ∧
          c'.state ∈ insert (some a) E ∧
            (∀ (u : ℕ), 0 < u → u < t → (Turing.MultiTapeTM.runFrom c u).state ∉ Turing.roundStop a E) ∧
              ∀ u ≤ t, P (Turing.MultiTapeTM.runFrom c u).workTapePos
@Turing.scanTM_contract : {k : ℕ} →
  {Γ A : Type} →
    (i : Fin k) →
      (δf δb : A → Γ → A × Γ) →
        (a₀ : A) →
          (x : List Γ) →
            Turing.Contract (Turing.scanTM k i δf δb a₀) (Turing.ScanPhase.fwd a₀)
              (Set.range fun a => some (Turing.ScanPhase.done a)) (List Γ) x
@Turing.segment_iff : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} (M : Turing.MultiTapeTM k Γ S) (F : Set (Option S))
  (P : (Fin k → ℤ) → Prop) (a b : Turing.Cfg k Γ S x) (t : ℕ),
  Turing.Segment M F P a b t ↔
    Turing.MultiTapeTM.runFrom a t = b ∧
      (∀ u < t, (Turing.MultiTapeTM.runFrom a u).state ∉ F) ∧ ∀ u ≤ t, P (Turing.MultiTapeTM.runFrom a u).workTapePos
@Turing.skipBackTM_contract : {k : ℕ} →
  {Γ : Type} →
    (i : Fin k) →
      (x : List Γ) →
        Turing.Contract (Turing.skipBackTM k i) Turing.SeekPhase.run {some Turing.SeekPhase.done} (List Γ) x
@Turing.skipTM_contract : {k : ℕ} →
  {Γ : Type} →
    (i : Fin k) →
      (x : List Γ) → Turing.Contract (Turing.skipTM k i) Turing.SeekPhase.run {some Turing.SeekPhase.done} (List Γ) x
@Turing.transferTM_run : ∀ {x : List Bool} (k : ℕ) (src dst : Fin k),
  src ≠ dst →
    ∀ (w : Fin k → List Bool),
      w dst = [] →
        ∃ T ≤ 3 * (w src).length + 3,
          (∀ t < T,
              (Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords Turing.SweepPhase.sweep w) t).state ≠
                some Turing.SweepPhase.done) ∧
            Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords Turing.SweepPhase.sweep w) T =
              Turing.Cfg.ofWords Turing.SweepPhase.done (Function.update (Function.update w src []) dst (w src))
@Turing.Action.liftSymbols_inputTape : ∀ {k : ℕ} {Γ : Type u_1} {State : Type u_2} (e : Bool ↪ Γ)
  (a : Turing.Action k Bool State), (Turing.Action.liftSymbols e a).inputTape = a.inputTape
@Turing.Action.liftSymbols_output : ∀ {k : ℕ} {Γ : Type u_1} {State : Type u_2} (e : Bool ↪ Γ)
  (a : Turing.Action k Bool State), (Turing.Action.liftSymbols e a).output = Option.map (⇑e) a.output
@Turing.Action.liftSymbols_state : ∀ {k : ℕ} {Γ : Type u_1} {State : Type u_2} (e : Bool ↪ Γ)
  (a : Turing.Action k Bool State), (Turing.Action.liftSymbols e a).state = a.state
@Turing.Action.liftSymbols_workTapes : ∀ {k : ℕ} {Γ : Type u_1} {State : Type u_2} (e : Bool ↪ Γ)
  (a : Turing.Action k Bool State) (j : Fin k),
  (Turing.Action.liftSymbols e a).workTapes j = (Option.map (Option.map ⇑e) (a.workTapes j).1, (a.workTapes j).2)
@Turing.Cfg.bindState_inputPos : ∀ {k : ℕ} {Γ S S' : Type} {x : List Γ} (d : Turing.Cfg k Γ S x) (f : S → Option S'),
  (d.bindState f).inputPos = d.inputPos
@Turing.Cfg.bindState_output : ∀ {k : ℕ} {Γ S S' : Type} {x : List Γ} (d : Turing.Cfg k Γ S x) (f : S → Option S'),
  (d.bindState f).output = d.output
@Turing.Cfg.bindState_state : ∀ {k : ℕ} {Γ S S' : Type} {x : List Γ} (d : Turing.Cfg k Γ S x) (f : S → Option S'),
  (d.bindState f).state = d.state.bind f
@Turing.Cfg.bindState_workTapePos : ∀ {k : ℕ} {Γ S S' : Type} {x : List Γ} (d : Turing.Cfg k Γ S x) (f : S → Option S')
  (a : Fin k), (d.bindState f).workTapePos a = d.workTapePos a
@Turing.Cfg.bindState_workTapes : ∀ {k : ℕ} {Γ S S' : Type} {x : List Γ} (d : Turing.Cfg k Γ S x) (f : S → Option S')
  (a : Fin k) (a_1 : ℤ), (d.bindState f).workTapes a a_1 = d.workTapes a a_1
@Turing.Cfg.inputSymbol_of_end : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  {cfg : Turing.Cfg k Symbol State input}, ↑cfg.inputPos = input.length + 1 → cfg.inputSymbol = none
@Turing.Cfg.liftSymbols_inputSymbol : ∀ {k : ℕ} {Γ : Type u_1} {State : Type u_2} (e : Bool ↪ Γ) {x : List Bool}
  (c : Turing.Cfg k Bool State x), (Turing.Cfg.liftSymbols e c).inputSymbol = Option.map (⇑e) c.inputSymbol
@Turing.Cfg.liftSymbols_output : ∀ {k : ℕ} {Γ : Type u_1} {State : Type u_2} (e : Bool ↪ Γ) {x : List Bool}
  (c : Turing.Cfg k Bool State x), (Turing.Cfg.liftSymbols e c).output = List.map (⇑e) c.output
@Turing.Cfg.liftSymbols_workTapePos : ∀ {k : ℕ} {Γ : Type u_1} {State : Type u_2} (e : Bool ↪ Γ) {x : List Bool}
  (c : Turing.Cfg k Bool State x), (Turing.Cfg.liftSymbols e c).workTapePos = c.workTapePos
@Turing.Cfg.liftSymbols_workTapes : ∀ {k : ℕ} {Γ : Type u_1} {State : Type u_2} (e : Bool ↪ Γ) {x : List Bool}
  (c : Turing.Cfg k Bool State x) (j : Fin k) (p : ℤ),
  (Turing.Cfg.liftSymbols e c).workTapes j p = Option.map (⇑e) (c.workTapes j p)
@Turing.Cfg.mapState_apply : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {State' : Type u_3} {input : List Symbol}
  (f : State → State') (a : Turing.Action k Symbol State) (cfg : Turing.Cfg k Symbol State input),
  (Turing.Action.mapState f a).apply (Turing.Cfg.mapState f cfg) = Turing.Cfg.mapState f (a.apply cfg)
@Turing.Cfg.mapState_inputPos : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {State' : Type u_3}
  {input : List Symbol} (f : State → State') (cfg : Turing.Cfg k Symbol State input),
