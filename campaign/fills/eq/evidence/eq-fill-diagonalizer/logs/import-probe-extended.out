counterOverhead : List Bool → ℕ → ℕ
counterOverhead_le : ∀ (w : List Bool),
  counterOverhead w (Nat.ofDigits 2 (List.map Bool.toNat w) + 1) ≤
    4 * Nat.ofDigits 2 (List.map Bool.toNat w) + 2 * w.length + 2
@embedEmitCfg : {m k : ℕ} →
  {S : Type u_1} →
    {Symbol : Type u_2} →
      {x : List Symbol} →
        (Fin m ↪ Fin k) → (Fin k → ℤ → Option Symbol) → (Fin k → ℤ) → List Symbol → Cfg m Symbol S x → Cfg k Symbol S x
@embedEmitCfg_inputPos : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol} (ι : Fin m ↪ Fin k)
  (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ) (pre : List Symbol) (c : Cfg m Symbol S x),
  (embedEmitCfg ι tapes heads pre c).inputPos = c.inputPos
@embedEmitCfg_output : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol} (ι : Fin m ↪ Fin k)
  (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ) (pre : List Symbol) (c : Cfg m Symbol S x),
  (embedEmitCfg ι tapes heads pre c).output = pre ++ c.output
@embedEmitCfg_selected_pos : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol} (ι : Fin m ↪ Fin k)
  (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ) (pre : List Symbol) (c : Cfg m Symbol S x) (i : Fin m),
  (embedEmitCfg ι tapes heads pre c).workTapePos (ι i) = c.workTapePos i
@embedEmitCfg_selected_tape : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol} (ι : Fin m ↪ Fin k)
  (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ) (pre : List Symbol) (c : Cfg m Symbol S x) (i : Fin m),
  (embedEmitCfg ι tapes heads pre c).workTapes (ι i) = c.workTapes i
@embedEmitCfg_state : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol} (ι : Fin m ↪ Fin k)
  (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ) (pre : List Symbol) (c : Cfg m Symbol S x),
  (embedEmitCfg ι tapes heads pre c).state = c.state
@embedEmitTM : {m k : ℕ} →
  {S : Type u_1} → {Symbol : Type u_2} → (Fin m ↪ Fin k) → MultiTapeTM m Symbol S → MultiTapeTM k Symbol S
@embedSilentCfg_inputPos : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol} (ι : Fin m ↪ Fin k)
  (cap : Fin k) (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ) (pre out₀ : List Symbol) (c : Cfg m Symbol S x),
  (embedSilentCfg ι cap tapes heads pre out₀ c).inputPos = c.inputPos
@embedSilentCfg_output : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol} (ι : Fin m ↪ Fin k)
  (cap : Fin k) (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ) (pre out₀ : List Symbol) (c : Cfg m Symbol S x),
  (embedSilentCfg ι cap tapes heads pre out₀ c).output = out₀
@embedSilentCfg_state : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol} (ι : Fin m ↪ Fin k)
  (cap : Fin k) (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ) (pre out₀ : List Symbol) (c : Cfg m Symbol S x),
  (embedSilentCfg ι cap tapes heads pre out₀ c).state = c.state
