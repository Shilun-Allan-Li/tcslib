@Segment.trans : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} {M : MultiTapeTM k Γ S} {F : Set (Option S)}
  {P : (Fin k → ℤ) → Prop} {a b c : Cfg k Γ S x} {t v : ℕ},
  Segment M F P a b t → Segment M F P b c v → Segment M F P a c (t + v)
