@Cfg.ofWords_inputPos : ∀ {k : ℕ} {State : Type u_1} {input : List Bool} (q : State) (w : Fin k → List Bool),
  (Cfg.ofWords q w).inputPos = 1
@Cfg.ofWords_output : ∀ {k : ℕ} {State : Type u_1} {input : List Bool} (q : State) (w : Fin k → List Bool),
  (Cfg.ofWords q w).output = []
@Cfg.ofWords_state : ∀ {k : ℕ} {State : Type u_1} {input : List Bool} (q : State) (w : Fin k → List Bool),
  (Cfg.ofWords q w).state = some q
@Cfg.ofWords_workTapePos : ∀ {k : ℕ} {State : Type u_1} {input : List Bool} (q : State) (w : Fin k → List Bool)
