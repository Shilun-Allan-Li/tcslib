@bufferTape_append_shift : ∀ {Symbol : Type u_1} (u w : List Symbol) {z : ℤ},
  0 ≤ z → bufferTape (u ++ w) (↑u.length + z) = bufferTape w z
@bufferTape_eq : ∀ {Symbol : Type u_1} (w : List Symbol) (z : ℤ), bufferTape w z = if 0 ≤ z then w[z.toNat]? else none
@bufferTape_eq_none_of_not_mem : ∀ {Symbol : Type u_1} (w : List Symbol) {z : ℤ},
  ¬(0 ≤ z ∧ z < ↑w.length) → bufferTape w z = none
@bufferTape_nil : ∀ {Symbol : Type u_1}, bufferTape [] = fun x => none
@bufferTape_of_neg : ∀ {Symbol : Type u_1} (w : List Symbol) {z : ℤ}, z < 0 → bufferTape w z = none
@computesFunInTime_comp : ∀ {M₁ M₂ : FinTM Bool} {f g : List Bool → List Bool} {T₁ T₂ : ℕ → ℕ},
  M₁.ComputesFunInTime f T₁ →
    M₂.ComputesFunInTime g T₂ → Monotone T₂ → ∃ M c, M.ComputesFunInTime (g ∘ f) fun n => c * (T₁ n + T₂ (T₁ n) + 1)
@computesFunInTime_iff : ∀ {Symbol : Type} (M : FinTM Symbol) (f : List Symbol → List Symbol) (T : ℕ → ℕ),
  M.ComputesFunInTime f T ↔ ∀ (input : List Symbol), M.ComputesInTime input (f input) (T input.length)
