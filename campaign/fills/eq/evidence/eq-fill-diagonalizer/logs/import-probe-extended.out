@runFrom_add : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol} {tm : MultiTapeTM k Symbol State}
  (cfg : Cfg k Symbol State input) (a b : ℕ), runFrom cfg (a + b) = runFrom (runFrom cfg a) b
@runFrom_of_halt : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  {tm : MultiTapeTM k Symbol State} (cfg : Cfg k Symbol State input), cfg.state = none → ∀ {n : ℕ}, runFrom cfg n = cfg
@runFrom_state_ne_none_of_le : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {input : List Symbol}
  (tm : MultiTapeTM k Symbol State) (cfg : Cfg k Symbol State input) (t : ℕ),
  (runFrom cfg t).state ≠ none → ∀ u ≤ t, (runFrom cfg u).state ≠ none
@runFrom_zero : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol} {tm : MultiTapeTM k Symbol State}
  {cfg : Cfg k Symbol State input}, runFrom cfg 0 = cfg
@step : {k : ℕ} →
  {State : Type u_1} →
