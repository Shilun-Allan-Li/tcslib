@computesInTime_iff : ∀ {Symbol : Type} (M : FinTM Symbol) (x w : List Symbol) (t : ℕ),
  M.ComputesInTime x w t ↔ (runFrom (initCfg x) t).state = none ∧ (runFrom (initCfg x) t).output = w
