@instInhabitedCfg.default._proof_1 : ∀ {a : Type u_1} {a_1 : List a}, NeZero (a_1.length + 2)
length_pairEncode : ∀ (x y : List Bool), (pairEncode x y).length = 2 * x.length + 2 + y.length
@moveInputPos : {n : ℕ} → Fin (n + 2) → SignType → Fin (n + 2)
@moveInputPos_zero : ∀ {n : ℕ} (pos : Fin (n + 2)), moveInputPos pos 0 = pos
pairDecode : List Bool → Option (List Bool × List Bool)
pairDecode_pairEncode : ∀ (x α : List Bool), pairDecode (pairEncode x α) = some (x, α)
pairEncode : List Bool → List Bool → List Bool
@rewindTM : {Symbol : Type u_1} → (k : ℕ) → Fin k → MultiTapeTM k Symbol RewindPhase
@segment_iff : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} (M : MultiTapeTM k Γ S) (F : Set (Option S)) (P : (Fin k → ℤ) → Prop)
  (a b : Cfg k Γ S x) (t : ℕ),
  Segment M F P a b t ↔ runFrom a t = b ∧ (∀ u < t, (runFrom a u).state ∉ F) ∧ ∀ u ≤ t, P (runFrom a u).workTapePos
@skipBackTM : {Symbol : Type u_1} → (k : ℕ) → Fin k → MultiTapeTM k Symbol SeekPhase
stateWord : (k : ℕ) → List Bool → Fin k → List Bool
streamStartCfg._proof_1 : ∀ (z : List Bool), NeZero (z.length + 2)
@streamStartCfg_inputPos : ∀ {K : ℕ} {S : Type} (z : List Bool) (j : Fin K) (q : S) (s : List Bool),
  (streamStartCfg z j q s).inputPos = 1
@streamStartCfg_output : ∀ {K : ℕ} {S : Type} (z : List Bool) (j : Fin K) (q : S) (s : List Bool),
  (streamStartCfg z j q s).output = []
@streamStartCfg_state : ∀ {K : ℕ} {S : Type} (z : List Bool) (j : Fin K) (q : S) (s : List Bool),
  (streamStartCfg z j q s).state = some q
@streamStartCfg_workTapePos : ∀ {K : ℕ} {S : Type} (z : List Bool) (j : Fin K) (q : S) (s : List Bool) (x : Fin K),
  (streamStartCfg z j q s).workTapePos x = 0
@streamStartCfg_workTapes : ∀ {K : ℕ} {S : Type} (z : List Bool) (j : Fin K) (q : S) (s : List Bool) (i : Fin K)
  (a : ℤ), (streamStartCfg z j q s).workTapes i a = (if i = j then bufferTape s else fun x => none) a
@transferMapTM : {Symbol : Type u_1} →
  {Δ : Type u_2} →
    (k : ℕ) →
      Fin k →
        Fin k → (Symbol → Δ) → (Option Symbol → Δ → Symbol) → (Symbol → Option Symbol) → MultiTapeTM k Symbol SweepPhase
vhostCap : (m : ℕ) → Fin (1 + m + 1)
@vhostCfg : {m : ℕ} →
  {S : Type u_1} →
    {x y : List Bool} → Cfg m Bool S y → Bool → Fin (x.length + 2) → List Bool → Cfg (1 + m) Bool (S × Bool) x
@vhostCfg_inputPos : ∀ {m : ℕ} {S : Type u_1} {x y : List Bool} (c : Cfg m Bool S y) (b : Bool) (p : Fin (x.length + 2))
  (pre : List Bool), (vhostCfg c b p pre).inputPos = p
@vhostCfg_output : ∀ {m : ℕ} {S : Type u_1} {x y : List Bool} (c : Cfg m Bool S y) (b : Bool) (p : Fin (x.length + 2))
  (pre : List Bool), (vhostCfg c b p pre).output = pre ++ c.output
@vhostCfg_state : ∀ {m : ℕ} {S : Type u_1} {x y : List Bool} (c : Cfg m Bool S y) (b : Bool) (p : Fin (x.length + 2))
  (pre : List Bool), (vhostCfg c b p pre).state = Option.map (fun q => (q, b)) c.state
@vhostCfg_workTapePos : ∀ {m : ℕ} {S : Type u_1} {x y : List Bool} (c : Cfg m Bool S y) (b : Bool)
  (p : Fin (x.length + 2)) (pre : List Bool) (i : Fin (1 + m)),
  (vhostCfg c b p pre).workTapePos i = Fin.addCases (fun x => ↑↑c.inputPos - 1) c.workTapePos i
@vhostCfg_workTapes : ∀ {m : ℕ} {S : Type u_1} {x y : List Bool} (c : Cfg m Bool S y) (b : Bool)
  (p : Fin (x.length + 2)) (pre : List Bool) (i : Fin (1 + m)) (a : ℤ),
  (vhostCfg c b p pre).workTapes i a =
    Fin.addCases (motive := fun x => ℤ → Option Bool) (fun x => bufferTape y) c.workTapes i a
@walkTM : {Symbol : Type u_1} →
  (k : ℕ) → Fin k → (moved : Fin k → Prop) → [DecidablePred moved] → SignType → MultiTapeTM k Symbol SeekPhase
@walkTM_run_ofCfg : ∀ {Symbol : Type u_1} {k : ℕ} {x : List Symbol} (src : Fin k) (moved : Fin k → Prop)
  [inst : DecidablePred moved],
  moved src →
    ∀ (dir : SignType) (w : List Symbol) (d : Cfg k Symbol SeekPhase x),
      d.state = some SeekPhase.run →
        (∀ p ≤ w.length, d.workTapes src (d.workTapePos src + ↑dir * ↑p) = bufferTape w ↑p) →
          runFrom d (w.length + 1) =
              { state := some SeekPhase.done, inputPos := d.inputPos, workTapes := d.workTapes,
                workTapePos := fun j => d.workTapePos j + if moved j then ↑dir * ↑(w.length + 1) else 0,
                output := d.output } ∧
            (∀ t < w.length + 1, (runFrom d t).state ≠ some SeekPhase.done) ∧
              ∀ (j : Fin k),
                ∀ t ≤ w.length + 1, (runFrom d t).workTapePos j = d.workTapePos j + if moved j then ↑dir * ↑t else 0
@wordPatch : {Γ : Type u_1} → (ℤ → Option Γ) → ℤ → List Γ → ℤ → Option Γ
@writeConstTM : {Symbol : Type u_1} → (k : ℕ) → Fin k → (w₀ : List Symbol) → MultiTapeTM k Symbol (WritePhase w₀.length)
