  {Symbol : Type u_1} → {State : Type u_2} → Turing.Action k Symbol State → Fin k → Option (Option Symbol) × SignType
Turing.Cfg : ℕ → (Symbol : Type u_1) → Type u_2 → List Symbol → Type (max u_1 u_2)
@Turing.Cfg.ext : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {input : List Symbol}
  {x y : Turing.Cfg k Symbol State input},
  x.state = y.state →
    x.inputPos = y.inputPos → x.workTapes = y.workTapes → x.workTapePos = y.workTapePos → x.output = y.output → x = y
@Turing.Cfg.inputPos : {k : ℕ} →
  {Symbol : Type u_1} →
    {State : Type u_2} → {input : List Symbol} → Turing.Cfg k Symbol State input → Fin (input.length + 2)
@Turing.Cfg.inputSymbol : {k : ℕ} →
  {State : Type u_1} → {Symbol : Type u_2} → {input : List Symbol} → Turing.Cfg k Symbol State input → Option Symbol
@Turing.Cfg.mapState : {k : ℕ} →
  {Symbol : Type u_1} →
    {State : Type u_2} →
      {State' : Type u_3} →
        {input : List Symbol} → (State → State') → Turing.Cfg k Symbol State input → Turing.Cfg k Symbol State' input
@Turing.Cfg.mk : {k : ℕ} →
  {Symbol : Type u_1} →
    {State : Type u_2} →
      {input : List Symbol} →
        Option State →
          Fin (input.length + 2) →
            (Fin k → ℤ → Option Symbol) → (Fin k → ℤ) → List Symbol → Turing.Cfg k Symbol State input
@Turing.Cfg.output : {k : ℕ} →
  {Symbol : Type u_1} → {State : Type u_2} → {input : List Symbol} → Turing.Cfg k Symbol State input → List Symbol
@Turing.Cfg.state : {k : ℕ} →
  {Symbol : Type u_1} → {State : Type u_2} → {input : List Symbol} → Turing.Cfg k Symbol State input → Option State
@Turing.Cfg.workTapePos : {k : ℕ} →
  {Symbol : Type u_1} → {State : Type u_2} → {input : List Symbol} → Turing.Cfg k Symbol State input → Fin k → ℤ
@Turing.Cfg.workTapeSymbols : {k : ℕ} →
  {State : Type u_1} →
    {Symbol : Type u_2} → {input : List Symbol} → Turing.Cfg k Symbol State input → Fin k → Option Symbol
@Turing.Cfg.workTapeSymbols_eq : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  (cfg : Turing.Cfg k Symbol State input) (i : Fin k), cfg.workTapeSymbols i = cfg.workTapes i (cfg.workTapePos i)
@Turing.Cfg.workTapes : {k : ℕ} →
  {Symbol : Type u_1} →
    {State : Type u_2} → {input : List Symbol} → Turing.Cfg k Symbol State input → Fin k → ℤ → Option Symbol
Turing.CounterLoopState : Type → Type
@Turing.CounterLoopState.dec : {S : Type} → Turing.FlagPhase → Turing.CounterLoopState S
@Turing.CounterLoopState.done : {S : Type} → Turing.CounterLoopState S
@Turing.CounterLoopState.escape : {S : Type} → Turing.CounterLoopState S
Turing.FinTM : Type → Type 1
@Turing.FinTM.ComputesFunInTime : {Symbol : Type} → Turing.FinTM Symbol → (List Symbol → List Symbol) → (ℕ → ℕ) → Prop
@Turing.FinTM.ComputesInTime : {Symbol : Type} → Turing.FinTM Symbol → List Symbol → List Symbol → ℕ → Prop
@Turing.FinTM.State : {Symbol : Type} → Turing.FinTM Symbol → Type
@Turing.FinTM.bufferTape : {Symbol : Type u_1} → List Symbol → ℤ → Option Symbol
@Turing.FinTM.bufferTape_left : ∀ {Symbol : Type u_1} (w : List Symbol), Turing.FinTM.bufferTape w (-1) = none
@Turing.FinTM.bufferTape_nat : ∀ {Symbol : Type u_1} (w : List Symbol) (i : ℕ), Turing.FinTM.bufferTape w ↑i = w[i]?
@Turing.FinTM.bufferTape_nil : ∀ {Symbol : Type u_1}, Turing.FinTM.bufferTape [] = fun x => none
Turing.FinTM.computesFunInTime_appendBit : ∀ (b : Bool),
  ∃ M c, M.ComputesFunInTime (fun x => x ++ [b]) fun n => c * (n + 1)
Turing.FinTM.computesFunInTime_polyBits : ∀ (C e : ℕ),
  ∃ M c, M.ComputesFunInTime (fun x => (C * (x.length + 1) ^ e).bits) fun n => c * (n + 1) ^ (e + 1)
Turing.FinTM.computesFunInTime_polyUnary : ∀ (C e : ℕ),
  ∃ M c, M.ComputesFunInTime (fun x => List.replicate (C * (x.length + 1) ^ e) true) fun n => c * (n + 1) ^ (e + 1)
@Turing.FinTM.decEqState : {Symbol : Type} → (self : Turing.FinTM Symbol) → DecidableEq self.State
@Turing.FinTM.fintypeState : {Symbol : Type} → (self : Turing.FinTM Symbol) → Fintype self.State
@Turing.FinTM.k : {Symbol : Type} → Turing.FinTM Symbol → ℕ
@Turing.FinTM.mk : {Symbol : Type} →
  (k : ℕ) →
    (State : Type) →
      [fintypeState : Fintype State] →
        [decEqState : DecidableEq State] → Turing.MultiTapeTM k Symbol State → Turing.FinTM Symbol
@Turing.FinTM.tm : {Symbol : Type} → (self : Turing.FinTM Symbol) → Turing.MultiTapeTM self.k Symbol self.State
Turing.FlagPhase.run : Turing.FlagPhase
Turing.MultiTapeTM : ℕ → Type u_1 → Type u_2 → Type (max u_1 u_2)
@Turing.MultiTapeTM.initCfg : {k : ℕ} →
  {State : Type u_1} →
    {Symbol : Type u_2} →
      {tm : Turing.MultiTapeTM k Symbol State} → (input : List Symbol) → Turing.Cfg k Symbol State input
@Turing.MultiTapeTM.mk : {k : ℕ} →
  {Symbol : Type u_1} →
    {State : Type u_2} →
      State →
        (State → Option Symbol → (Fin k → Option Symbol) → Turing.Action k Symbol State) →
          Turing.MultiTapeTM k Symbol State
@Turing.MultiTapeTM.q₀ : {k : ℕ} → {Symbol : Type u_1} → {State : Type u_2} → Turing.MultiTapeTM k Symbol State → State
@Turing.MultiTapeTM.runFrom : {k : ℕ} →
  {State : Type u_1} →
    {Symbol : Type u_2} →
      {input : List Symbol} →
        {tm : Turing.MultiTapeTM k Symbol State} → Turing.Cfg k Symbol State input → ℕ → Turing.Cfg k Symbol State input
@Turing.MultiTapeTM.runFrom_succ_eq_step' : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  {tm : Turing.MultiTapeTM k Symbol State} {cfg : Turing.Cfg k Symbol State input} {t : ℕ},
  Turing.MultiTapeTM.runFrom cfg (t + 1) = Turing.MultiTapeTM.step (Turing.MultiTapeTM.runFrom cfg t)
@Turing.MultiTapeTM.step : {k : ℕ} →
  {State : Type u_1} →
    {Symbol : Type u_2} →
      {input : List Symbol} →
        {tm : Turing.MultiTapeTM k Symbol State} → Turing.Cfg k Symbol State input → Turing.Cfg k Symbol State input
