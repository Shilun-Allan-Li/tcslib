Turing.SweepPhase.sweep : Turing.SweepPhase
Turing.WritePhase : ℕ → Type
@Turing.WritePhase.done : {n : ℕ} → Turing.WritePhase n
@Turing.WritePhase.wr : {n : ℕ} → Fin (n + 1) → Turing.WritePhase n
Turing.counterLoopStateFintype : (S : Type) → [Fintype S] → Fintype (Turing.CounterLoopState S)
Turing.counterOverhead : List Bool → ℕ → ℕ
Turing.counterOverhead_le : ∀ (w : List Bool),
  Turing.counterOverhead w (Nat.ofDigits 2 (List.map Bool.toNat w) + 1) ≤
    4 * Nat.ofDigits 2 (List.map Bool.toNat w) + 2 * w.length + 2
@Turing.instDecidableEqCounterLoopState : {S : Type} → [DecidableEq S] → DecidableEq (Turing.CounterLoopState S)
Turing.instDecidableEqRewindPhase : DecidableEq Turing.RewindPhase
Turing.instDecidableEqSweepPhase : DecidableEq Turing.SweepPhase
@Turing.instDecidableEqWritePhase : {n : ℕ} → DecidableEq (Turing.WritePhase n)
Turing.instFintypeRewindPhase : Fintype Turing.RewindPhase
Turing.instFintypeSweepPhase : Fintype Turing.SweepPhase
@Turing.instFintypeWritePhase : {n : ℕ} → Fintype (Turing.WritePhase n)
@Turing.moveInputPos : {n : ℕ} → Fin (n + 2) → SignType → Fin (n + 2)
@Turing.moveInputPos_zero : ∀ {n : ℕ} (pos : Fin (n + 2)), Turing.moveInputPos pos 0 = pos
@Turing.not_mem_roundStop : ∀ {S : Type} {a : S} {E : Set (Option S)} {q : Option S},
  q ∉ Turing.roundStop a E ↔ ∃ s, q = some s ∧ s ≠ a ∧ some s ∉ E
@Turing.roundStop : {S : Type} → S → Set (Option S) → Set (Option S)
@Turing.transferMapTM : {Symbol : Type u_1} →
  {Δ : Type u_2} →
    (k : ℕ) →
      Fin k →
        Fin k →
          (Symbol → Δ) →
            (Option Symbol → Δ → Symbol) → (Symbol → Option Symbol) → Turing.MultiTapeTM k Symbol Turing.SweepPhase
@Turing.transferMapTM_run_ofCfg : ∀ {Symbol : Type u_1} {Δ : Type u_2} {k : ℕ} {x : List Symbol} (src dst : Fin k),
  src ≠ dst →
    ∀ (extract : Symbol → Δ) (merge : Option Symbol → Δ → Symbol) (rest : Symbol → Option Symbol) (w : List Symbol)
      (d : Turing.Cfg k Symbol Turing.SweepPhase x),
      d.state = some Turing.SweepPhase.sweep →
        (∀ (p : ℤ), -1 ≤ p → p ≤ ↑w.length → d.workTapes src (d.workTapePos src + p) = Turing.FinTM.bufferTape w p) →
          Turing.MultiTapeTM.runFrom d (2 * w.length + 2) =
              { state := some Turing.SweepPhase.done, inputPos := d.inputPos,
                workTapes := fun j q =>
                  if j = src ∧ d.workTapePos j ≤ q ∧ q < d.workTapePos j + ↑w.length then
                    (Turing.FinTM.bufferTape w (q - d.workTapePos j)).bind rest
                  else
                    if j = dst ∧ d.workTapePos j ≤ q ∧ q < d.workTapePos j + ↑w.length then
                      Option.map (fun γ => merge (d.workTapes j q) (extract γ))
                        (Turing.FinTM.bufferTape w (q - d.workTapePos j))
                    else d.workTapes j q,
                workTapePos := d.workTapePos, output := d.output } ∧
            (∀ t < 2 * w.length + 2, (Turing.MultiTapeTM.runFrom d t).state ≠ some Turing.SweepPhase.done) ∧
              ∀ (j : Fin k),
                ∀ t ≤ 2 * w.length + 2,
                  if j = src ∨ j = dst then
                    (Turing.MultiTapeTM.runFrom d t).workTapePos j ∈
                      Finset.Icc (d.workTapePos j - 1) (d.workTapePos j + ↑w.length)
                  else (Turing.MultiTapeTM.runFrom d t).workTapePos j = d.workTapePos j
@Turing.writeConstTM : {Symbol : Type u_1} →
  (k : ℕ) → Fin k → (w₀ : List Symbol) → Turing.MultiTapeTM k Symbol (Turing.WritePhase w₀.length)
@Turing.writeConstTM_run_ofCfg : ∀ {Symbol : Type u_1} {k : ℕ} {x : List Symbol} (i : Fin k) (w₀ : List Symbol)
  (d : Turing.Cfg k Symbol (Turing.WritePhase w₀.length) x),
  d.state = some (Turing.WritePhase.wr 0) →
    Turing.MultiTapeTM.runFrom d (2 * w₀.length + 2) =
        { state := some Turing.WritePhase.done, inputPos := d.inputPos,
          workTapes := fun j q =>
            if j = i ∧ d.workTapePos j ≤ q ∧ q < d.workTapePos j + ↑w₀.length then
              Turing.FinTM.bufferTape w₀ (q - d.workTapePos j)
            else d.workTapes j q,
          workTapePos := d.workTapePos, output := d.output } ∧
      (∀ t < 2 * w₀.length + 2, (Turing.MultiTapeTM.runFrom d t).state ≠ some Turing.WritePhase.done) ∧
        ∀ (j : Fin k),
          ∀ t ≤ 2 * w₀.length + 2,
            if j = i then
              (Turing.MultiTapeTM.runFrom d t).workTapePos j ∈
                Finset.Icc (d.workTapePos j) (d.workTapePos j + ↑w₀.length)
            else (Turing.MultiTapeTM.runFrom d t).workTapePos j = d.workTapePos j
