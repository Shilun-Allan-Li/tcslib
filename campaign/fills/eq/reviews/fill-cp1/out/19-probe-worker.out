  (e : Fin (w.length + 1) → S),
  (∀ (i : Fin (w.length + 1)) (inp : Option Bool) (work : Fin k → Option Bool),
      tm.tr (e i) inp work = Turing.FinTM.emitAction w e i) →
    ∀ (cfg : Turing.Cfg k Bool S x),
      cfg.state = some (e 0) →
        ∀ (t : ℕ) (ht : t ≤ w.length),
          (Turing.MultiTapeTM.runFrom cfg t).state = some (e ⟨t, ⋯⟩) ∧
            (Turing.MultiTapeTM.runFrom cfg t).output = cfg.output ++ List.take t w
