  {A : Type} → (k : ℕ) → (A → Γ → A) → A → Turing.MultiTapeTM k Γ (Turing.ScanPhase A)
@Turing.inputFoldTM_run_ofCfg : ∀ {Γ : Type u_1} {A : Type} {k : ℕ} {x : List Γ} (δ : A → Γ → A) (a₀ : A)
  (d : Turing.Cfg k Γ (Turing.ScanPhase A) x),
  d.state = some (Turing.ScanPhase.fwd a₀) →
    d.inputPos = 1 →
      Turing.MultiTapeTM.runFrom d (2 * x.length + 2) =
          { state := some (Turing.ScanPhase.done (List.foldl δ a₀ x)), inputPos := d.inputPos, workTapes := d.workTapes,
            workTapePos := d.workTapePos, output := d.output } ∧
        (∀ t < 2 * x.length + 2, ∀ (a : A), (Turing.MultiTapeTM.runFrom d t).state ≠ some (Turing.ScanPhase.done a)) ∧
          ∀ (j : Fin k), ∀ t ≤ 2 * x.length + 2, (Turing.MultiTapeTM.runFrom d t).workTapePos j = d.workTapePos j
