  (e : Fin (w.length + 1) → S),
  (∀ (i : Fin (w.length + 1)) (inp : Option Bool) (work : Fin k → Option Bool),
      tm.tr (e i) inp work = Turing.FinTM.emitAction w e i) →
    ∀ (cfg : Turing.Cfg k Bool S x),
      cfg.state = some (e 0) →
        (Turing.MultiTapeTM.runFrom cfg (w.length + 1)).state = none ∧
          (Turing.MultiTapeTM.runFrom cfg (w.length + 1)).output = cfg.output ++ w
