@Turing.NTimeDiag.exists_queryTM : ∀ {f g : ℕ → ℕ},
  Complexity.TimeConstructible f →
    Complexity.TimeConstructible g → ∃ G C, G.ComputesFunInTime (Turing.NTimeDiag.query f g) fun n => C * (g n + 1)
Turing.NTimeDiag.query : (ℕ → ℕ) → (ℕ → ℕ) → List Bool → List Bool
Turing.NTimeDiag.query_eq : ∀ (f g : ℕ → ℕ) {n : ℕ},
  3 ≤ n →
    Turing.NTimeDiag.query f g (List.replicate n true) =
      if n = Turing.NTimeDiag.ladder f (Turing.NTimeDiag.stage f n + 1) then
        true ::
          Turing.pairEncode
            (Turing.pairEncode (Turing.NTimeDiag.budget f (Turing.NTimeDiag.ladder f (Turing.NTimeDiag.stage f n))).bits
              (Turing.NTimeDiag.stageCode (Turing.NTimeDiag.stage f n)))
            (List.replicate (Turing.NTimeDiag.ladder f (Turing.NTimeDiag.stage f n) + 1) true)
      else
        false ::
          Turing.pairEncode (Turing.pairEncode (g n).bits (Turing.NTimeDiag.stageCode (Turing.NTimeDiag.stage f n)))
            (List.replicate (n + 1) true)
Turing.NTimeDiag.query_of_not_guard : ∀ (f g : ℕ → ℕ) {x : List Bool},
  ¬(x = List.replicate x.length true ∧ 3 ≤ x.length) → Turing.NTimeDiag.query f g x = []
Turing.NTimeDiag.budget_eq : ∀ (f : ℕ → ℕ) (ℓ : ℕ), Turing.NTimeDiag.budget f ℓ = (f (ℓ + 1) + (ℓ + 1) + 1) ^ 2
Turing.NTimeDiag.ladder_zero : ∀ (f : ℕ → ℕ), Turing.NTimeDiag.ladder f 0 = 2
Turing.NTimeDiag.ladder_succ : ∀ (f : ℕ → ℕ) (i : ℕ),
  Turing.NTimeDiag.ladder f (i + 1) = 2 ^ Turing.NTimeDiag.budget f (Turing.NTimeDiag.ladder f i) ^ 2
Turing.NTimeDiag.two_mul_lt_ladder_succ : ∀ (f : ℕ → ℕ) (i : ℕ),
  2 * Turing.NTimeDiag.ladder f i < Turing.NTimeDiag.ladder f (i + 1)
Turing.NTimeDiag.le_ladder : ∀ (f : ℕ → ℕ) (i : ℕ), i + 2 ≤ Turing.NTimeDiag.ladder f i
Turing.NTimeDiag.ladder_strictMono : ∀ (f : ℕ → ℕ), StrictMono (Turing.NTimeDiag.ladder f)
Turing.NTimeDiag.stage_spec : ∀ (f : ℕ → ℕ) {n : ℕ},
  3 ≤ n →
    Turing.NTimeDiag.ladder f (Turing.NTimeDiag.stage f n) < n ∧
      n ≤ Turing.NTimeDiag.ladder f (Turing.NTimeDiag.stage f n + 1)
Turing.NTimeDiag.stage_eq : ∀ (f : ℕ → ℕ) {n i : ℕ},
  Turing.NTimeDiag.ladder f i < n → n ≤ Turing.NTimeDiag.ladder f (i + 1) → Turing.NTimeDiag.stage f n = i
Turing.NTimeDiag.stage_of_le_two : ∀ (f : ℕ → ℕ) {n : ℕ}, n ≤ 2 → Turing.NTimeDiag.stage f n = 0
Turing.NTimeDiag.stageCode_eq : ∀ (i : ℕ), Turing.NTimeDiag.stageCode i = ((Nat.unpair i).1 + 1).bits.dropLast
Complexity.TimeConstructible : (ℕ → ℕ) → Prop
@Turing.FinTM.computesFunInTime_iff : ∀ {Symbol : Type} (M : Turing.FinTM Symbol) (f : List Symbol → List Symbol)
  (T : ℕ → ℕ), M.ComputesFunInTime f T ↔ ∀ (input : List Symbol), M.ComputesInTime input (f input) (T input.length)
@Turing.FinTM.computesInTime_iff : ∀ {Symbol : Type} (M : Turing.FinTM Symbol) (x w : List Symbol) (t : ℕ),
  M.ComputesInTime x w t ↔
    (Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) t).state = none ∧
      (Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) t).output = w
@Turing.FinTM.ComputesInTime.mono : ∀ {Symbol : Type} {M : Turing.FinTM Symbol} {input output : List Symbol} {t t' : ℕ},
  M.ComputesInTime input output t → t ≤ t' → M.ComputesInTime input output t'
@Turing.FinTM.computesFunInTime_comp : ∀ {M₁ M₂ : Turing.FinTM Bool} {f g : List Bool → List Bool} {T₁ T₂ : ℕ → ℕ},
  M₁.ComputesFunInTime f T₁ →
    M₂.ComputesFunInTime g T₂ → Monotone T₂ → ∃ M c, M.ComputesFunInTime (g ∘ f) fun n => c * (T₁ n + T₂ (T₁ n) + 1)
Turing.FinTM.bufferedCompTM_computesInTime : ∀ (M₁ M₂ : Turing.FinTM Bool) {x y o : List Bool} {t₁ t₂ : ℕ},
  M₁.ComputesInTime x y t₁ →
    M₂.ComputesInTime y o t₂ → (M₁.bufferedCompTM M₂).ComputesInTime x o (t₁ + y.length + 2 + t₂)
Turing.FinTM.computesFunInTime_const : ∀ (w : List Bool), ∃ M c, M.ComputesFunInTime (fun x => w) fun n => c * (n + 1)
@Turing.FinTM.computesFunInTime_cond : ∀ {D M₁ M₂ : Turing.FinTM Bool} {p : List Bool → Bool}
  {f₁ f₂ : List Bool → List Bool} {T₀ T₁ T₂ : ℕ → ℕ},
  D.ComputesFunInTime (fun x => [p x]) T₀ →
    M₁.ComputesFunInTime f₁ T₁ →
      M₂.ComputesFunInTime f₂ T₂ →
        ∃ M c,
          M.ComputesFunInTime (fun x => if p x = true then f₁ x else f₂ x) fun n => c * (T₀ n + max (T₁ n) (T₂ n) + 1)
Turing.FinTM.computesFunInTime_lengthBits : ∃ M c, M.ComputesFunInTime (fun x => x.length.bits) fun n => c * (n + 1)
Turing.FinTM.computesFunInTime_prepend : ∀ (w : List Bool),
  ∃ M c, M.ComputesFunInTime (fun x => w ++ x) fun n => c * (n + 1)
Turing.FinTM.computesFunInTime_pairEncodeFixed : ∀ (α : List Bool),
  ∃ M c, M.ComputesFunInTime (fun x => Turing.pairEncode α x) fun n => c * (n + 1)
Turing.FinTM.computesFunInTime_pairConcat : ∃ M c,
  M.ComputesFunInTime
    (fun z =>
      match Turing.pairDecode z with
      | some (a, b) => a ++ b
      | none => [])
    fun n => c * (n + 1)
Turing.FinTM.exists_comp_on_image : ∀ (M U : Turing.FinTM Bool) (f g : List Bool → List Bool) (T₁ T₂ : ℕ → ℕ),
  M.ComputesFunInTime f T₁ →
    (∀ (x : List Bool), U.ComputesInTime (f x) (g x) (T₂ x.length)) →
      ∃ N, N.ComputesFunInTime g fun n => 2 * T₁ n + T₂ n + 2
Turing.FinTM.exists_installCallTM : ∀ (M : Turing.FinTM Bool) (f : List Bool → List Bool) (T : ℕ → ℕ),
  M.ComputesFunInTime f T →
    ∃ C entry exit c,
      0 < C.k ∧
        ∀ (x arg : List Bool),
          ∃ t ≤ c * (T arg.length + arg.length + (f arg).length + 1),
            0 < t ∧
              (∀ (t' : ℕ),
                  0 < t' →
                    t' < t →
                      (Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords entry (Turing.stateWord C.k arg)) t').state ≠
                        some exit) ∧
                Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords entry (Turing.stateWord C.k arg)) t =
                  Turing.Cfg.ofWords exit (Turing.stateWord C.k (f arg))
Turing.FinTM.exists_emitCallTM : ∀ (M : Turing.FinTM Bool) (f : List Bool → List Bool) (T : ℕ → ℕ),
  M.ComputesFunInTime f T →
    ∃ C entry exit c,
      0 < C.k ∧
        ∀ (x arg : List Bool),
          ∃ t ≤ c * (T arg.length + arg.length + (f arg).length + 1),
            0 < t ∧
              (∀ (t' : ℕ),
                  0 < t' →
                    t' < t →
                      (Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords entry (Turing.stateWord C.k arg)) t').state ≠
                        some exit) ∧
                Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords entry (Turing.stateWord C.k arg)) t =
                  have __src := Turing.Cfg.ofWords exit (Turing.stateWord C.k arg);
                  { state := __src.state, inputPos := __src.inputPos, workTapes := __src.workTapes,
                    workTapePos := __src.workTapePos, output := f arg }
Turing.FinTM.exists_inputCallTM : ∀ (M : Turing.FinTM Bool) (f : List Bool → List Bool) (T : ℕ → ℕ),
  M.ComputesFunInTime f T →
    ∃ C entry exit c,
      0 < C.k ∧
        ∀ (x : List Bool),
          ∃ t ≤ c * (T x.length + x.length + (f x).length + 1),
            0 < t ∧
              (∀ (t' : ℕ),
                  0 < t' →
                    t' < t → (Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords entry fun x => []) t').state ≠ some exit) ∧
                Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords entry fun x => []) t =
                  Turing.Cfg.ofWords exit (Turing.stateWord C.k (f x))
@Turing.Cfg.ofWords : {k : ℕ} →
  {State : Type u_1} → {input : List Bool} → State → (Fin k → List Bool) → Turing.Cfg k Bool State input
Turing.stateWord : (k : ℕ) → List Bool → Fin k → List Bool
@Turing.exists_stepClockTMVia : ∀ {k : ℕ} {Γ S : Type} [Fintype S] [DecidableEq S] [DecidableEq Γ] (e : Bool ↪ Γ)
  (M : Turing.MultiTapeTM k Γ S) (stopAt : S → Bool),
  ∃ Q x x H inj finish timeout,
    Function.Injective finish ∧
      Function.Injective timeout ∧
        (∀ (a b : Option S), finish a ≠ timeout b) ∧
          (∀ (s : S) (r : Option S), inj s ≠ finish r ∧ inj s ≠ timeout r) ∧
            ∀ {x : List Γ} (c : Turing.Cfg k Γ S x) (q : S),
              c.state = some q →
                ∀ (w : List Bool) (ct : ℤ → Option Γ) (cp : ℤ),
                  (∀ (p : ℤ), -1 ≤ p → p ≤ ↑w.length → ct (cp + p) = Turing.FinTM.bufferTape (List.map (⇑e) w) p) →
                    (∀ τ ≤ Nat.ofDigits 2 (List.map Bool.toNat w),
                        Turing.Cfg.Stopped stopAt (Turing.MultiTapeTM.runFrom c τ) →
                          (∀ u < τ, ¬Turing.Cfg.Stopped stopAt (Turing.MultiTapeTM.runFrom c u)) →
                            ∃ T ≤ 5 * τ + 2 * w.length + 2,
                              ∃ w',
                                w'.length = w.length ∧
                                  Turing.MultiTapeTM.runFrom (Turing.clockCfg (some (inj q)) c ct cp) T =
                                      Turing.clockCfg (some (finish (Turing.MultiTapeTM.runFrom c τ).state))
                                        (Turing.MultiTapeTM.runFrom c τ) (Turing.wordPatch ct cp (List.map (⇑e) w'))
                                        cp ∧
                                    (∀ u < T,
                                        ∀ (r : Option S),
                                          (Turing.MultiTapeTM.runFrom (Turing.clockCfg (some (inj q)) c ct cp)
                                                  u).state ≠
                                              some (finish r) ∧
                                            (Turing.MultiTapeTM.runFrom (Turing.clockCfg (some (inj q)) c ct cp)
                                                  u).state ≠
                                              some (timeout r)) ∧
                                      ∀ u ≤ T,
                                        ∃ v ≤ τ,
                                          (∀ (j : Fin k),
                                              (Turing.MultiTapeTM.runFrom (Turing.clockCfg (some (inj q)) c ct cp)
                                                        u).workTapes
                                                    j.castSucc =
                                                  (Turing.MultiTapeTM.runFrom c v).workTapes j ∧
                                                (Turing.MultiTapeTM.runFrom (Turing.clockCfg (some (inj q)) c ct cp)
                                                        u).workTapePos
                                                    j.castSucc =
                                                  (Turing.MultiTapeTM.runFrom c v).workTapePos j) ∧
                                            (Turing.MultiTapeTM.runFrom (Turing.clockCfg (some (inj q)) c ct cp)
                                                    u).inputPos =
                                                (Turing.MultiTapeTM.runFrom c v).inputPos ∧
                                              (Turing.MultiTapeTM.runFrom (Turing.clockCfg (some (inj q)) c ct cp)
                                                      u).output =
                                                  (Turing.MultiTapeTM.runFrom c v).output ∧
                                                (Turing.MultiTapeTM.runFrom (Turing.clockCfg (some (inj q)) c ct cp)
                                                        u).workTapePos
                                                    (Fin.last k) ∈
                                                  Finset.Icc (cp - 1) (cp + ↑w.length)) ∧
                      ((∀ u ≤ Nat.ofDigits 2 (List.map Bool.toNat w),
                          ¬Turing.Cfg.Stopped stopAt (Turing.MultiTapeTM.runFrom c u)) →
                        ∃ T ≤ 5 * Nat.ofDigits 2 (List.map Bool.toNat w) + 2 * w.length + 2,
                          ∃ w',
                            w'.length = w.length ∧
                              Turing.MultiTapeTM.runFrom (Turing.clockCfg (some (inj q)) c ct cp) T =
                                  Turing.clockCfg
                                    (some
                                      (timeout
                                        (Turing.MultiTapeTM.runFrom c (Nat.ofDigits 2 (List.map Bool.toNat w))).state))
                                    (Turing.MultiTapeTM.runFrom c (Nat.ofDigits 2 (List.map Bool.toNat w)))
                                    (Turing.wordPatch ct cp (List.map (⇑e) w')) cp ∧
                                (∀ u < T,
                                    ∀ (r : Option S),
                                      (Turing.MultiTapeTM.runFrom (Turing.clockCfg (some (inj q)) c ct cp) u).state ≠
                                          some (finish r) ∧
                                        (Turing.MultiTapeTM.runFrom (Turing.clockCfg (some (inj q)) c ct cp) u).state ≠
                                          some (timeout r)) ∧
                                  ∀ u ≤ T,
                                    ∃ v ≤ Nat.ofDigits 2 (List.map Bool.toNat w),
                                      (∀ (j : Fin k),
                                          (Turing.MultiTapeTM.runFrom (Turing.clockCfg (some (inj q)) c ct cp)
                                                    u).workTapes
                                                j.castSucc =
                                              (Turing.MultiTapeTM.runFrom c v).workTapes j ∧
                                            (Turing.MultiTapeTM.runFrom (Turing.clockCfg (some (inj q)) c ct cp)
                                                    u).workTapePos
                                                j.castSucc =
                                              (Turing.MultiTapeTM.runFrom c v).workTapePos j) ∧
                                        (Turing.MultiTapeTM.runFrom (Turing.clockCfg (some (inj q)) c ct cp)
                                                u).inputPos =
                                            (Turing.MultiTapeTM.runFrom c v).inputPos ∧
                                          (Turing.MultiTapeTM.runFrom (Turing.clockCfg (some (inj q)) c ct cp)
                                                  u).output =
                                              (Turing.MultiTapeTM.runFrom c v).output ∧
                                            (Turing.MultiTapeTM.runFrom (Turing.clockCfg (some (inj q)) c ct cp)
                                                    u).workTapePos
                                                (Fin.last k) ∈
                                              Finset.Icc (cp - 1) (cp + ↑w.length))
@Turing.exists_stepClockTM : ∀ {k : ℕ} {S : Type} [Fintype S] [DecidableEq S] (M : Turing.MultiTapeTM k Bool S)
  (stopAt : S → Bool),
  ∃ Q x x H inj finish timeout,
    ∀ {x : List Bool} (c : Turing.Cfg k Bool S x) (q : S),
      c.state = some q →
        ∀ (w : List Bool) (ct : ℤ → Option Bool) (cp : ℤ),
          (∀ (p : ℤ), -1 ≤ p → p ≤ ↑w.length → ct (cp + p) = Turing.FinTM.bufferTape w p) →
            have d := Nat.ofDigits 2 (List.map Bool.toNat w);
            have stopped := fun e => e.state = none ∨ ∃ s, e.state = some s ∧ stopAt s = true;
            (∀ τ ≤ d,
                stopped (Turing.MultiTapeTM.runFrom c τ) →
                  (∀ u < τ, ¬stopped (Turing.MultiTapeTM.runFrom c u)) →
                    ∃ T ≤ 5 * τ + 2 * w.length + 2,
                      ∃ ct',
                        Turing.MultiTapeTM.runFrom (Turing.clockCfg (some (inj q)) c ct cp) T =
                            Turing.clockCfg (some (finish (Turing.MultiTapeTM.runFrom c τ).state))
                              (Turing.MultiTapeTM.runFrom c τ) ct' cp ∧
                          ∀ u < T,
                            ∀ (r : Option S),
                              (Turing.MultiTapeTM.runFrom (Turing.clockCfg (some (inj q)) c ct cp) u).state ≠
                                  some (finish r) ∧
                                (Turing.MultiTapeTM.runFrom (Turing.clockCfg (some (inj q)) c ct cp) u).state ≠
                                  some (timeout r)) ∧
              ((∀ u ≤ d, ¬stopped (Turing.MultiTapeTM.runFrom c u)) →
                ∃ T ≤ 5 * d + 2 * w.length + 2,
                  ∃ ct',
                    Turing.MultiTapeTM.runFrom (Turing.clockCfg (some (inj q)) c ct cp) T =
                        Turing.clockCfg (some (timeout (Turing.MultiTapeTM.runFrom c d).state))
                          (Turing.MultiTapeTM.runFrom c d) ct' cp ∧
                      ∀ u < T,
                        ∀ (r : Option S),
                          (Turing.MultiTapeTM.runFrom (Turing.clockCfg (some (inj q)) c ct cp) u).state ≠
                              some (finish r) ∧
                            (Turing.MultiTapeTM.runFrom (Turing.clockCfg (some (inj q)) c ct cp) u).state ≠
                              some (timeout r))
@Turing.clockCfg : {k : ℕ} →
  {Γ S Q : Type} → {x : List Γ} → Option Q → Turing.Cfg k Γ S x → (ℤ → Option Γ) → ℤ → Turing.Cfg (k + 1) Γ Q x
Turing.expandTM : (k : ℕ) →
  Fin k → (pat : List Bool) → Turing.MultiTapeTM (k + 1) Bool (Turing.CounterLoopState (Fin (pat.length + 1)))
@Turing.expandTM_run_ofCfg : ∀ {k : ℕ} {x : List Bool} (i : Fin k) (pat : List Bool)
  (c : Turing.Cfg k Bool (Fin (pat.length + 1)) x),
  c.state = some 0 →
    ∀ (w : List Bool) (ct : ℤ → Option Bool) (cp : ℤ),
      (∀ (p : ℤ), -1 ≤ p → p ≤ ↑w.length → ct (cp + p) = Turing.FinTM.bufferTape w p) →
        ∀ (d : ℕ),
          Nat.ofDigits 2 (List.map Bool.toNat w) = d →
            Turing.MultiTapeTM.runFrom
                  (Turing.counterLoopCfg (some (Turing.CounterLoopState.dec Turing.FlagPhase.run)) c ct cp)
                  (d * (pat.length + 1) + Turing.counterOverhead w (d + 1)) =
                Turing.counterLoopCfg (some Turing.CounterLoopState.done)
                  { state := c.state, inputPos := c.inputPos,
                    workTapes := fun j q =>
                      if j = i ∧ c.workTapePos j ≤ q ∧ q < c.workTapePos j + ↑(d * pat.length) then
                        Turing.FinTM.bufferTape (List.replicate d pat).flatten (q - c.workTapePos j)
                      else c.workTapes j q,
                    workTapePos := Function.update c.workTapePos i (c.workTapePos i + ↑(d * pat.length)),
                    output := c.output }
                  (fun q => if cp ≤ q ∧ q < cp + ↑w.length then some true else ct q) cp ∧
              (∀ t < d * (pat.length + 1) + Turing.counterOverhead w (d + 1),
                  (Turing.MultiTapeTM.runFrom
                          (Turing.counterLoopCfg (some (Turing.CounterLoopState.dec Turing.FlagPhase.run)) c ct cp)
                          t).state ≠
                      some Turing.CounterLoopState.done ∧
                    (Turing.MultiTapeTM.runFrom
                          (Turing.counterLoopCfg (some (Turing.CounterLoopState.dec Turing.FlagPhase.run)) c ct cp)
                          t).state ≠
                      some Turing.CounterLoopState.escape) ∧
                (∀ t ≤ d * (pat.length + 1) + Turing.counterOverhead w (d + 1),
                    (Turing.MultiTapeTM.runFrom
                            (Turing.counterLoopCfg (some (Turing.CounterLoopState.dec Turing.FlagPhase.run)) c ct cp)
                            t).workTapePos
                        (Fin.last k) ∈
                      Finset.Icc (cp - 1) (cp + ↑w.length)) ∧
                  ∀ t ≤ d * (pat.length + 1) + Turing.counterOverhead w (d + 1),
                    ∀ (j : Fin k),
                      if j = i then
                        (Turing.MultiTapeTM.runFrom
                                (Turing.counterLoopCfg (some (Turing.CounterLoopState.dec Turing.FlagPhase.run)) c ct
                                  cp)
                                t).workTapePos
                            j.castSucc ∈
                          Finset.Icc (c.workTapePos j) (c.workTapePos j + ↑(d * pat.length))
                      else
                        (Turing.MultiTapeTM.runFrom
                                (Turing.counterLoopCfg (some (Turing.CounterLoopState.dec Turing.FlagPhase.run)) c ct
                                  cp)
                                t).workTapePos
                            j.castSucc =
                          c.workTapePos j
Turing.counterValue_bits : ∀ (t : ℕ), Turing.counterValue t.bits = t
@Turing.skipTM_run_ofCfg : ∀ {Symbol : Type u_1} {k : ℕ} {x : List Symbol} (i : Fin k) (w : List Symbol)
  (d : Turing.Cfg k Symbol Turing.SeekPhase x),
  d.state = some Turing.SeekPhase.run →
    (∀ (p : ℤ), 0 ≤ p → p ≤ ↑w.length → d.workTapes i (d.workTapePos i + p) = Turing.FinTM.bufferTape w p) →
      Turing.MultiTapeTM.runFrom d (w.length + 1) =
          { state := some Turing.SeekPhase.done, inputPos := d.inputPos, workTapes := d.workTapes,
            workTapePos := Function.update d.workTapePos i (d.workTapePos i + ↑w.length + 1), output := d.output } ∧
        (∀ t < w.length + 1, (Turing.MultiTapeTM.runFrom d t).state ≠ some Turing.SeekPhase.done) ∧
          ∀ (j : Fin k),
            ∀ t ≤ w.length + 1,
              if j = i then
                (Turing.MultiTapeTM.runFrom d t).workTapePos j ∈
                  Finset.Icc (d.workTapePos j) (d.workTapePos j + ↑w.length + 1)
              else (Turing.MultiTapeTM.runFrom d t).workTapePos j = d.workTapePos j
@Turing.skipBackTM_run_ofCfg : ∀ {Symbol : Type u_1} {k : ℕ} {x : List Symbol} (i : Fin k) (u : List Symbol)
  (d : Turing.Cfg k Symbol Turing.SeekPhase x),
  d.state = some Turing.SeekPhase.run →
    (∀ (p : ℤ),
        -1 ≤ p → p ≤ ↑u.length → d.workTapes i (d.workTapePos i - ↑u.length - 1 + p) = Turing.FinTM.bufferTape u p) →
      Turing.MultiTapeTM.runFrom d (u.length + 3) =
          { state := some Turing.SeekPhase.done, inputPos := d.inputPos, workTapes := d.workTapes,
            workTapePos := Function.update d.workTapePos i (d.workTapePos i - ↑u.length - 1), output := d.output } ∧
        (∀ t < u.length + 3, (Turing.MultiTapeTM.runFrom d t).state ≠ some Turing.SeekPhase.done) ∧
          ∀ (j : Fin k),
            ∀ t ≤ u.length + 3,
              if j = i then
                (Turing.MultiTapeTM.runFrom d t).workTapePos j ∈
                  Finset.Icc (d.workTapePos j - ↑u.length - 2) (d.workTapePos j)
              else (Turing.MultiTapeTM.runFrom d t).workTapePos j = d.workTapePos j
@Turing.clearTM_run_ofCfg : ∀ {Symbol : Type u_1} {k : ℕ} {x : List Symbol} (i : Fin k) (w : List Symbol)
  (d : Turing.Cfg k Symbol Turing.SweepPhase x),
  d.state = some Turing.SweepPhase.sweep →
    (∀ (p : ℤ), -1 ≤ p → p ≤ ↑w.length → d.workTapes i (d.workTapePos i + p) = Turing.FinTM.bufferTape w p) →
      Turing.MultiTapeTM.runFrom d (2 * w.length + 2) =
          { state := some Turing.SweepPhase.done, inputPos := d.inputPos,
            workTapes := fun j q =>
              if j = i ∧ d.workTapePos j ≤ q ∧ q < d.workTapePos j + ↑w.length then none else d.workTapes j q,
            workTapePos := d.workTapePos, output := d.output } ∧
        (∀ t < 2 * w.length + 2, (Turing.MultiTapeTM.runFrom d t).state ≠ some Turing.SweepPhase.done) ∧
          ∀ (j : Fin k),
            ∀ t ≤ 2 * w.length + 2,
              if j = i then
                (Turing.MultiTapeTM.runFrom d t).workTapePos j ∈
                  Finset.Icc (d.workTapePos j - 1) (d.workTapePos j + ↑w.length)
              else (Turing.MultiTapeTM.runFrom d t).workTapePos j = d.workTapePos j
@Turing.copyMapTM_run_ofCfg : ∀ {Symbol : Type u_1} {Δ : Type u_2} {k : ℕ} {x : List Symbol} (src dst : Fin k),
  src ≠ dst →
    ∀ (extract : Symbol → Δ) (merge : Option Symbol → Δ → Symbol) (w : List Symbol)
      (d : Turing.Cfg k Symbol Turing.SweepPhase x),
      d.state = some Turing.SweepPhase.sweep →
        (∀ (p : ℤ), -1 ≤ p → p ≤ ↑w.length → d.workTapes src (d.workTapePos src + p) = Turing.FinTM.bufferTape w p) →
          Turing.MultiTapeTM.runFrom d (2 * w.length + 2) =
              { state := some Turing.SweepPhase.done, inputPos := d.inputPos,
                workTapes := fun j q =>
                  if j = dst ∧ d.workTapePos j ≤ q ∧ q < d.workTapePos j + ↑w.length then
                    Option.map (fun γ => merge (d.workTapes j q) (extract γ))
                      (Turing.FinTM.bufferTape w (q - d.workTapePos j))
                  else d.workTapes j q,
                workTapePos := d.workTapePos, output := d.output } ∧
            (∀ t < 2 * w.length + 2, (Turing.MultiTapeTM.runFrom d t).state ≠ some Turing.SweepPhase.done) ∧
              ∀ (j : Fin k),
                ∀ t ≤ 2 * w.length + 2,
                  if j = src ∨ j = dst then
                    (Turing.MultiTapeTM.runFrom d t).workTapePos j ∈
                      Finset.Icc (d.workTapePos j - 1) (d.workTapePos j + ↑w.length)
                  else (Turing.MultiTapeTM.runFrom d t).workTapePos j = d.workTapePos j
@Turing.rewindTM_run_ofCfg : ∀ {Symbol : Type u_1} {k : ℕ} {x : List Symbol} (i : Fin k) (u : List Symbol),
  ∀ n ≤ u.length,
    ∀ (d : Turing.Cfg k Symbol Turing.RewindPhase x),
      d.state = some Turing.RewindPhase.start →
        (∀ (p : ℤ), -1 ≤ p → p < ↑n → d.workTapes i (d.workTapePos i - ↑n + p) = Turing.FinTM.bufferTape u p) →
          Turing.MultiTapeTM.runFrom d (n + 2) =
              { state := some Turing.RewindPhase.done, inputPos := d.inputPos, workTapes := d.workTapes,
                workTapePos := Function.update d.workTapePos i (d.workTapePos i - ↑n), output := d.output } ∧
            (∀ t < n + 2, (Turing.MultiTapeTM.runFrom d t).state ≠ some Turing.RewindPhase.done) ∧
              ∀ (j : Fin k),
                ∀ t ≤ n + 2,
                  if j = i then
                    (Turing.MultiTapeTM.runFrom d t).workTapePos j ∈
                      Finset.Icc (d.workTapePos j - ↑n - 1) (d.workTapePos j)
                  else (Turing.MultiTapeTM.runFrom d t).workTapePos j = d.workTapePos j
@Turing.Contract : {k : ℕ} → {Γ S : Type} → Turing.MultiTapeTM k Γ S → S → Set (Option S) → Type → List Γ → Type
@Turing.Contract.ofSegment : {k : ℕ} →
  {Γ S : Type} →
    {M : Turing.MultiTapeTM k Γ S} →
      {entry : S} →
        {exits : Set (Option S)} →
          {ι : Type} →
            {x : List Γ} →
              (pre : ι → Turing.Cfg k Γ S x → Prop) →
                (time : ι → Turing.Cfg k Γ S x → ℕ) →
                  (post : ι → Turing.Cfg k Γ S x → Turing.Cfg k Γ S x) →
                    (lo hi : ι → Turing.Cfg k Γ S x → Fin k → ℤ) →
                      (∀ (i : ι) (d : Turing.Cfg k Γ S x),
                          d.state = some entry →
                            pre i d →
                              Turing.Segment M exits (Turing.HeadBox (lo i d) (hi i d)) d (post i d) (time i d)) →
                        (∀ (i : ι) (d : Turing.Cfg k Γ S x),
                            d.state = some entry → pre i d → (post i d).state ∈ exits) →
                          Turing.Contract M entry exits ι x
@Turing.Contract.seq : {k : ℕ} →
  {Γ S₁ S₂ : Type} →
    [inst : DecidableEq S₁] →
      {M₁ : Turing.MultiTapeTM k Γ S₁} →
        {M₂ : Turing.MultiTapeTM k Γ S₂} →
          {entry₁ exit₁ : S₁} →
            {entry₂ : S₂} →
              {X₂ : Set (Option S₂)} →
                {ι κ : Type} →
                  {x : List Γ} →
                    (C₁ : Turing.Contract M₁ entry₁ {some exit₁} ι x) →
                      (C₂ : Turing.Contract M₂ entry₂ X₂ κ x) →
                        (link : ι → κ) →
                          (∀ (i : ι) (d : Turing.Cfg k Γ S₁ x),
                              d.state = some entry₁ →
                                C₁.pre i d → C₂.pre (link i) (Turing.Cfg.mapState (fun x => entry₂) (C₁.post i d))) →
                            Turing.Contract (Turing.seamCompTM M₁ exit₁ M₂ entry₂) (Sum.inl entry₁)
                              (Option.map Sum.inr '' X₂) ι x
@Turing.Contract.inPhase : {k : ℕ} →
  {Γ I : Type} →
    {Ph : I → Type} →
      (Mf : (i : I) → Turing.MultiTapeTM k Γ (Ph i)) →
        (q0 : (i : I) × Ph i) →
          (red : (i : I) → Ph i → Option ((i : I) × Ph i)) →
            (p : I) →
              {s₀ : Ph p} →
                {X : Set (Option (Ph p))} →
                  {ι : Type} →
                    {x : List Γ} →
                      Turing.Contract (Mf p) s₀ X ι x →
                        none ∉ X →
                          (∀ (s : Ph p), some s ∉ X → red p s = none) →
                            (∀ (s : Ph p), some s ∈ X → ∃ q, red p s = some q ∧ q.fst ≠ p) →
                              Turing.Contract (Turing.phaseHostTM Mf q0 red) ⟨p, s₀⟩ {q | ∃ s, some s ∈ X ∧ q = red p s}
                                ι x
@Turing.Contract.branch : {k : ℕ} →
  {Γ S₀ S₁ S₂ : Type} →
    [inst : DecidableEq S₀] →
      [inst_1 : DecidableEq S₁] →
        {M₀ : Turing.MultiTapeTM k Γ S₀} →
          {M₁ : Turing.MultiTapeTM k Γ S₁} →
            {M₂ : Turing.MultiTapeTM k Γ S₂} →
              {entry₀ e₁ e₂ : S₀} →
                {entry₁ : S₁} →
                  {entry₂ : S₂} →
                    {X₁ : Set (Option S₁)} →
                      {X₂ : Set (Option S₂)} →
                        {ι κ₁ κ₂ : Type} →
                          {x : List Γ} →
                            e₁ ≠ e₂ →
                              (C₀ : Turing.Contract M₀ entry₀ {some e₁, some e₂} ι x) →
                                (C₁ : Turing.Contract M₁ entry₁ X₁ κ₁ x) →
                                  (C₂ : Turing.Contract M₂ entry₂ X₂ κ₂ x) →
                                    (l₁ : ι → κ₁) →
                                      (l₂ : ι → κ₂) →
                                        (∀ (i : ι) (d : Turing.Cfg k Γ S₀ x),
                                            d.state = some entry₀ →
                                              C₀.pre i d →
                                                (C₀.post i d).state = some e₁ →
                                                  C₁.pre (l₁ i) (Turing.Cfg.mapState (fun x => entry₁) (C₀.post i d))) →
                                          (∀ (i : ι) (d : Turing.Cfg k Γ S₀ x),
                                              d.state = some entry₀ →
                                                C₀.pre i d →
                                                  (C₀.post i d).state = some e₂ →
                                                    C₂.pre (l₂ i)
                                                      (Turing.Cfg.mapState (fun x => entry₂) (C₀.post i d))) →
                                            Turing.Contract (Turing.seamCompTM₂ M₀ e₁ e₂ M₁ entry₁ M₂ entry₂)
                                              (Sum.inl (Sum.inl entry₀))
                                              (Option.map (Sum.inl ∘ Sum.inr) '' X₁ ∪ Option.map Sum.inr '' X₂) ι x
@Turing.Contract.segment : ∀ {k : ℕ} {Γ S : Type} {M : Turing.MultiTapeTM k Γ S} {entry : S} {exits : Set (Option S)}
  {ι : Type} {x : List Γ} (C : Turing.Contract M entry exits ι x) (i : ι) (d : Turing.Cfg k Γ S x),
  d.state = some entry →
    C.pre i d → Turing.Segment M exits (Turing.HeadBox (C.lo i d) (C.hi i d)) d (C.post i d) (C.time i d)
@Turing.Segment : {k : ℕ} →
  {Γ S : Type} →
    {x : List Γ} →
      Turing.MultiTapeTM k Γ S →
        Set (Option S) → ((Fin k → ℤ) → Prop) → Turing.Cfg k Γ S x → Turing.Cfg k Γ S x → ℕ → Prop
@Turing.segment_iff : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} (M : Turing.MultiTapeTM k Γ S) (F : Set (Option S))
  (P : (Fin k → ℤ) → Prop) (a b : Turing.Cfg k Γ S x) (t : ℕ),
  Turing.Segment M F P a b t ↔
    Turing.MultiTapeTM.runFrom a t = b ∧
      (∀ u < t, (Turing.MultiTapeTM.runFrom a u).state ∉ F) ∧ ∀ u ≤ t, P (Turing.MultiTapeTM.runFrom a u).workTapePos
@Turing.Segment.trans : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} {M : Turing.MultiTapeTM k Γ S} {F : Set (Option S)}
  {P : (Fin k → ℤ) → Prop} {a b c : Turing.Cfg k Γ S x} {t v : ℕ},
  Turing.Segment M F P a b t → Turing.Segment M F P b c v → Turing.Segment M F P a c (t + v)
@Turing.Segment.mono : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} {M : Turing.MultiTapeTM k Γ S} {F : Set (Option S)}
  {P : (Fin k → ℤ) → Prop} {F' : Set (Option S)} {P' : (Fin k → ℤ) → Prop} {a b : Turing.Cfg k Γ S x} {t : ℕ},
  Turing.Segment M F P a b t → F' ⊆ F → (∀ (p : Fin k → ℤ), P p → P' p) → Turing.Segment M F' P' a b t
@Turing.Round : {k : ℕ} →
  {Γ S : Type} →
    {x : List Γ} →
      Turing.MultiTapeTM k Γ S →
        S → Set (Option S) → ((Fin k → ℤ) → Prop) → Turing.Cfg k Γ S x → Turing.Cfg k Γ S x → ℕ → Prop
@Turing.round_iff : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} (M : Turing.MultiTapeTM k Γ S) (a : S) (E : Set (Option S))
  (P : (Fin k → ℤ) → Prop) (c c' : Turing.Cfg k Γ S x) (t : ℕ),
  Turing.Round M a E P c c' t ↔
    c.state = some a ∧
      0 < t ∧
        Turing.MultiTapeTM.runFrom c t = c' ∧
          c'.state ∈ insert (some a) E ∧
            (∀ (u : ℕ), 0 < u → u < t → (Turing.MultiTapeTM.runFrom c u).state ∉ Turing.roundStop a E) ∧
              ∀ u ≤ t, P (Turing.MultiTapeTM.runFrom c u).workTapePos
@Turing.Round.iterate : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} {M : Turing.MultiTapeTM k Γ S} {a : S} {E : Set (Option S)}
  {P : (Fin k → ℤ) → Prop} (τ : Turing.Cfg k Γ S x → ℕ) (c : Turing.Cfg k Γ S x),
  some a ∉ E →
    P c.workTapePos →
      ∀ (n : ℕ),
        (∀ r < n,
            Turing.Round M a E P (Turing.roundOrbit M τ c r) (Turing.roundOrbit M τ c (r + 1))
              (τ (Turing.roundOrbit M τ c r))) →
          Turing.Segment M E P c (Turing.roundOrbit M τ c n) (∑ r ∈ Finset.range n, τ (Turing.roundOrbit M τ c r))
@Turing.roundOrbit_zero : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} (M : Turing.MultiTapeTM k Γ S)
  (τ : Turing.Cfg k Γ S x → ℕ) (c : Turing.Cfg k Γ S x), Turing.roundOrbit M τ c 0 = c
@Turing.roundOrbit_succ : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} (M : Turing.MultiTapeTM k Γ S)
  (τ : Turing.Cfg k Γ S x → ℕ) (c : Turing.Cfg k Γ S x) (r : ℕ),
  Turing.roundOrbit M τ c (r + 1) =
    Turing.MultiTapeTM.runFrom (Turing.roundOrbit M τ c r) (τ (Turing.roundOrbit M τ c r))
@Turing.headBox_iff : ∀ {k : ℕ} (lo hi p : Fin k → ℤ),
  Turing.HeadBox lo hi p ↔ ∀ (j : Fin k), p j ∈ Finset.Icc (lo j) (hi j)
@Turing.skipTM_contract : {k : ℕ} →
  {Γ : Type} →
    (i : Fin k) →
      (x : List Γ) → Turing.Contract (Turing.skipTM k i) Turing.SeekPhase.run {some Turing.SeekPhase.done} (List Γ) x
@Turing.skipBackTM_contract : {k : ℕ} →
  {Γ : Type} →
    (i : Fin k) →
      (x : List Γ) →
        Turing.Contract (Turing.skipBackTM k i) Turing.SeekPhase.run {some Turing.SeekPhase.done} (List Γ) x
@Turing.clearTM_contract : {k : ℕ} →
  {Γ : Type} →
    (i : Fin k) →
      (x : List Γ) →
        Turing.Contract (Turing.clearTM k i) Turing.SweepPhase.sweep {some Turing.SweepPhase.done} (List Γ) x
@Turing.copyMapTM_contract : {k : ℕ} →
  {Γ Δ : Type} →
    (src dst : Fin k) →
      src ≠ dst →
        (extract : Γ → Δ) →
          (merge : Option Γ → Δ → Γ) →
            (x : List Γ) →
              Turing.Contract (Turing.copyMapTM k src dst extract merge) Turing.SweepPhase.sweep
                {some Turing.SweepPhase.done} (List Γ) x
@Turing.seamCompTM_run_ofCfg : ∀ {k : ℕ} {S₁ : Type u_1} {S₂ : Type u_2} {Symbol : Type u_3} {x : List Symbol}
  [inst : DecidableEq S₁] (M₁ : Turing.MultiTapeTM k Symbol S₁) (exit : S₁) (M₂ : Turing.MultiTapeTM k Symbol S₂)
  (entry : S₂) {c₀ c₁ : Turing.Cfg k Symbol S₁ x} {c₃ : Turing.Cfg k Symbol S₂ x} {T₁ T₂ : ℕ},
  Turing.MultiTapeTM.runFrom c₀ T₁ = c₁ →
    c₁.state = some exit →
      (∀ t < T₁, (Turing.MultiTapeTM.runFrom c₀ t).state ≠ some exit) →
        Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState (fun x => entry) c₁) T₂ = c₃ →
          Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState Sum.inl c₀) (T₁ + 1 + T₂) = Turing.Cfg.mapState Sum.inr c₃
@Turing.seamCompTM_firstReturn_ofCfg : ∀ {k : ℕ} {S₁ : Type u_1} {S₂ : Type u_2} {Symbol : Type u_3} {x : List Symbol}
  [inst : DecidableEq S₁] (M₁ : Turing.MultiTapeTM k Symbol S₁) (exit : S₁) (M₂ : Turing.MultiTapeTM k Symbol S₂)
  (entry q₂ : S₂) {c₀ c₁ : Turing.Cfg k Symbol S₁ x} {c₃ : Turing.Cfg k Symbol S₂ x} {T₁ T₂ : ℕ},
  Turing.MultiTapeTM.runFrom c₀ T₁ = c₁ →
    c₁.state = some exit →
      (∀ t < T₁, (Turing.MultiTapeTM.runFrom c₀ t).state ≠ some exit) →
        Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState (fun x => entry) c₁) T₂ = c₃ →
          c₃.state = some q₂ →
            (∀ t < T₂, (Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState (fun x => entry) c₁) t).state ≠ some q₂) →
              ∀ t < T₁ + 1 + T₂,
                (Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState Sum.inl c₀) t).state ≠ some (Sum.inr q₂)
@Turing.phaseHostTM : {k : ℕ} →
  {Γ I : Type} →
    {Ph : I → Type} →
      ((i : I) → Turing.MultiTapeTM k Γ (Ph i)) →
        (i : I) × Ph i → ((i : I) → Ph i → Option ((i : I) × Ph i)) → Turing.MultiTapeTM k Γ ((i : I) × Ph i)
@Turing.phaseHostTM_run : ∀ {k : ℕ} {Γ I : Type} {Ph : I → Type} (M : (i : I) → Turing.MultiTapeTM k Γ (Ph i))
  (q0 : (i : I) × Ph i) (red : (i : I) → Ph i → Option ((i : I) × Ph i)) (i : I) {x : List Γ}
  (c c' : Turing.Cfg k Γ (Ph i) x) (T : ℕ),
  Turing.MultiTapeTM.runFrom c T = c' →
    ∀ (s' : Ph i),
      c'.state = some s' →
        ∀ (q' : (i : I) × Ph i),
          red i s' = some q' →
            (∀ u < T, ∀ (s : Ph i), (Turing.MultiTapeTM.runFrom c u).state = some s → red i s = none) →
              (∀ u ≤ T,
                  Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState (Sigma.mk i) c) u =
                    Turing.Cfg.mapState (Sigma.mk i) (Turing.MultiTapeTM.runFrom c u)) ∧
                Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState (Sigma.mk i) c) (T + 1) =
                  Turing.Cfg.mapState (fun x => q') c'
@Turing.phaseHostTM_run_le : ∀ {k : ℕ} {Γ I : Type} {Ph : I → Type} (M : (i : I) → Turing.MultiTapeTM k Γ (Ph i))
  (q0 : (i : I) × Ph i) (red : (i : I) → Ph i → Option ((i : I) × Ph i)) (i : I) {x : List Γ}
  (c : Turing.Cfg k Γ (Ph i) x) (T : ℕ),
  (∀ u < T, ∀ (s : Ph i), (Turing.MultiTapeTM.runFrom c u).state = some s → red i s = none) →
    ∀ u ≤ T,
      Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState (Sigma.mk i) c) u =
        Turing.Cfg.mapState (Sigma.mk i) (Turing.MultiTapeTM.runFrom c u)
Turing.pairEncode_eq : ∀ (x α : List Bool),
  Turing.pairEncode x α = List.flatMap (fun b => [b, b]) x ++ [false, true] ++ α
Turing.length_pairEncode : ∀ (x y : List Bool), (Turing.pairEncode x y).length = 2 * x.length + 2 + y.length
Turing.length_bits_le_self : ∀ (m : ℕ), m.bits.length ≤ m
Nat.bits_append_bit : ∀ (n : ℕ) (b : Bool), (n = 0 → b = true) → (Nat.bit b n).bits = b :: n.bits
Nat.unpair : ℕ → ℕ × ℕ
Nat.log : ℕ → ℕ → ℕ
Nat.pow_log_le_self : ∀ (b : ℕ) {x : ℕ}, x ≠ 0 → b ^ Nat.log b x ≤ x
@Nat.lt_pow_succ_log_self : ∀ {b : ℕ}, 1 < b → ∀ (x : ℕ), x < b ^ (Nat.log b x).succ
Turing.NTimeDiag.stage : (ℕ → ℕ) → ℕ → ℕ
Turing.NTimeDiag.stageCode : ℕ → List Bool
Turing.NTimeDiag.ladder : (ℕ → ℕ) → ℕ → ℕ
Turing.NTimeDiag.budget : (ℕ → ℕ) → ℕ → ℕ
@Turing.counterLoopCfg : {k : ℕ} →
  {Symbol S : Type} →
    {x : List Symbol} →
      Option (Turing.CounterLoopState S) →
        Turing.Cfg k Symbol S x → (ℤ → Option Symbol) → ℤ → Turing.Cfg (k + 1) Symbol (Turing.CounterLoopState S) x
Turing.counterValue : List Bool → ℕ
Turing.counterValue_eq : ∀ (w : List Bool), Turing.counterValue w = Nat.ofDigits 2 (List.map Bool.toNat w)
@Turing.copyMapTM : {Symbol : Type u_1} →
  {Δ : Type u_2} →
    (k : ℕ) →
      Fin k → Fin k → (Symbol → Δ) → (Option Symbol → Δ → Symbol) → Turing.MultiTapeTM k Symbol Turing.SweepPhase
@Turing.writeAdvTM : {Symbol : Type u_1} →
  (k : ℕ) → Fin k → (w₀ : List Symbol) → Turing.MultiTapeTM k Symbol (Fin (w₀.length + 1))
@Turing.writeAdvTM_run_ofCfg : ∀ {Symbol : Type u_1} {k : ℕ} {x : List Symbol} (i : Fin k) (w₀ : List Symbol)
  (d : Turing.Cfg k Symbol (Fin (w₀.length + 1)) x),
  d.state = some 0 →
    Turing.MultiTapeTM.runFrom d (w₀.length + 1) =
        { state := some 0, inputPos := d.inputPos,
          workTapes := fun j q =>
            if j = i ∧ d.workTapePos j ≤ q ∧ q < d.workTapePos j + ↑w₀.length then
              Turing.FinTM.bufferTape w₀ (q - d.workTapePos j)
            else d.workTapes j q,
          workTapePos := Function.update d.workTapePos i (d.workTapePos i + ↑w₀.length), output := d.output } ∧
      (∀ (t : ℕ), 0 < t → t < w₀.length + 1 → (Turing.MultiTapeTM.runFrom d t).state ≠ some 0) ∧
        ∀ (j : Fin k),
          ∀ t ≤ w₀.length + 1,
            if j = i then
              (Turing.MultiTapeTM.runFrom d t).workTapePos j ∈
                Finset.Icc (d.workTapePos j) (d.workTapePos j + ↑w₀.length)
            else (Turing.MultiTapeTM.runFrom d t).workTapePos j = d.workTapePos j
@Turing.clearTM : {Symbol : Type u_1} → (k : ℕ) → Fin k → Turing.MultiTapeTM k Symbol Turing.SweepPhase
@Turing.rewindTM : {Symbol : Type u_1} → (k : ℕ) → Fin k → Turing.MultiTapeTM k Symbol Turing.RewindPhase
@Turing.skipTM : {Symbol : Type u_1} → (k : ℕ) → Fin k → Turing.MultiTapeTM k Symbol Turing.SeekPhase
@Turing.clockCfg_state : ∀ {k : ℕ} {Γ S Q : Type} {x : List Γ} (q : Option Q) (c : Turing.Cfg k Γ S x)
  (ct : ℤ → Option Γ) (cp : ℤ), (Turing.clockCfg q c ct cp).state = q
@Turing.clockCfg_workTapes : ∀ {k : ℕ} {Γ S Q : Type} {x : List Γ} (q : Option Q) (c : Turing.Cfg k Γ S x)
  (ct : ℤ → Option Γ) (cp : ℤ) (i : Fin (k + 1)) (a : ℤ),
  (Turing.clockCfg q c ct cp).workTapes i a = Fin.lastCases (motive := fun x => ℤ → Option Γ) ct c.workTapes i a
@Turing.clockCfg_workTapePos : ∀ {k : ℕ} {Γ S Q : Type} {x : List Γ} (q : Option Q) (c : Turing.Cfg k Γ S x)
  (ct : ℤ → Option Γ) (cp : ℤ) (i : Fin (k + 1)),
  (Turing.clockCfg q c ct cp).workTapePos i = Fin.lastCases cp c.workTapePos i
@Turing.clockCfg_inputPos : ∀ {k : ℕ} {Γ S Q : Type} {x : List Γ} (q : Option Q) (c : Turing.Cfg k Γ S x)
  (ct : ℤ → Option Γ) (cp : ℤ), (Turing.clockCfg q c ct cp).inputPos = c.inputPos
@Turing.clockCfg_output : ∀ {k : ℕ} {Γ S Q : Type} {x : List Γ} (q : Option Q) (c : Turing.Cfg k Γ S x)
  (ct : ℤ → Option Γ) (cp : ℤ), (Turing.clockCfg q c ct cp).output = c.output
@Turing.Cfg.Stopped : {k : ℕ} → {Γ : Type u_1} → {S : Type u_2} → {x : List Γ} → (S → Bool) → Turing.Cfg k Γ S x → Prop
@Turing.Cfg.stopped_iff : ∀ {k : ℕ} {Γ : Type u_1} {S : Type u_2} {x : List Γ} {stopAt : S → Bool}
  {c : Turing.Cfg k Γ S x}, Turing.Cfg.Stopped stopAt c ↔ c.state = none ∨ ∃ s, c.state = some s ∧ stopAt s = true
@Turing.wordPatch : {Γ : Type u_1} → (ℤ → Option Γ) → ℤ → List Γ → ℤ → Option Γ
@Turing.wordPatch_of_mem : ∀ {Γ : Type u_1} (ct : ℤ → Option Γ) (cp : ℤ) (u : List Γ) {q : ℤ},
  cp ≤ q → q < cp + ↑u.length → Turing.wordPatch ct cp u q = Turing.FinTM.bufferTape u (q - cp)
@Turing.wordPatch_of_not_mem : ∀ {Γ : Type u_1} (ct : ℤ → Option Γ) (cp : ℤ) (u : List Γ) {q : ℤ},
  ¬(cp ≤ q ∧ q < cp + ↑u.length) → Turing.wordPatch ct cp u q = ct q
@Turing.seamCompTM : {k : ℕ} →
  {S₁ : Type u_1} →
    {S₂ : Type u_2} →
      {Symbol : Type u_3} →
        [DecidableEq S₁] →
          Turing.MultiTapeTM k Symbol S₁ →
            S₁ → Turing.MultiTapeTM k Symbol S₂ → S₂ → Turing.MultiTapeTM k Symbol (S₁ ⊕ S₂)
@Turing.seamCompTM_runFrom_left : ∀ {k : ℕ} {S₁ : Type u_1} {S₂ : Type u_2} {Symbol : Type u_3} {x : List Symbol}
  [inst : DecidableEq S₁] (M₁ : Turing.MultiTapeTM k Symbol S₁) (exit : S₁) (M₂ : Turing.MultiTapeTM k Symbol S₂)
  (entry : S₂) {c : Turing.Cfg k Symbol S₁ x} {T : ℕ},
  (∀ t < T, (Turing.MultiTapeTM.runFrom c t).state ≠ some exit) →
    ∀ t ≤ T,
      Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState Sum.inl c) t =
        Turing.Cfg.mapState Sum.inl (Turing.MultiTapeTM.runFrom c t)
@Turing.seamCompTM_runFrom_right : ∀ {k : ℕ} {S₁ : Type u_1} {S₂ : Type u_2} {Symbol : Type u_3} {x : List Symbol}
  [inst : DecidableEq S₁] (M₁ : Turing.MultiTapeTM k Symbol S₁) (exit : S₁) (M₂ : Turing.MultiTapeTM k Symbol S₂)
  (entry : S₂) {c₀ c₁ : Turing.Cfg k Symbol S₁ x} {T₁ : ℕ},
  Turing.MultiTapeTM.runFrom c₀ T₁ = c₁ →
    c₁.state = some exit →
      (∀ t < T₁, (Turing.MultiTapeTM.runFrom c₀ t).state ≠ some exit) →
        ∀ (t : ℕ),
          Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState Sum.inl c₀) (T₁ + 1 + t) =
            Turing.Cfg.mapState Sum.inr (Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState (fun x => entry) c₁) t)
@Turing.embedEmitTM : {m k : ℕ} →
  {S : Type u_1} → {Symbol : Type u_2} → (Fin m ↪ Fin k) → Turing.MultiTapeTM m Symbol S → Turing.MultiTapeTM k Symbol S
@Turing.embedSilentTM : {m k : ℕ} →
  {S : Type u_1} →
    {Symbol : Type u_2} → (Fin m ↪ Fin k) → Fin k → Turing.MultiTapeTM m Symbol S → Turing.MultiTapeTM k Symbol S
@Turing.embedEmitCfg_eq : ∀ {k : ℕ} {Γ : Type u_1} {m : ℕ} {S : Type u_2} {x : List Γ} (σ : Fin m ↪ Fin k)
  (tapes : Fin k → ℤ → Option Γ) (heads : Fin k → ℤ) (pre : List Γ) (c : Turing.Cfg m Γ S x) (d : Turing.Cfg k Γ S x),
  c.state = d.state →
    c.inputPos = d.inputPos →
      pre ++ c.output = d.output →
        (∀ (i : Fin m), c.workTapes i = d.workTapes (σ i) ∧ c.workTapePos i = d.workTapePos (σ i)) →
          (∀ j ∉ Set.range ⇑σ, tapes j = d.workTapes j ∧ heads j = d.workTapePos j) →
            Turing.embedEmitCfg σ tapes heads pre c = d
@Turing.Round.segment : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} {M : Turing.MultiTapeTM k Γ S} {a : S} {E : Set (Option S)}
  {P : (Fin k → ℤ) → Prop} {c c' : Turing.Cfg k Γ S x} {t : ℕ},
  Turing.Round M a E P c c' t → some a ∉ E → Turing.Segment M E P c c' t
@Turing.Segment.take : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} {M : Turing.MultiTapeTM k Γ S} {F : Set (Option S)}
  {P : (Fin k → ℤ) → Prop} {a b : Turing.Cfg k Γ S x} {t u : ℕ},
  Turing.Segment M F P a b t → u ≤ t → Turing.Segment M F P a (Turing.MultiTapeTM.runFrom a u) u
@Turing.MultiTapeTM.runFrom_add : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  {tm : Turing.MultiTapeTM k Symbol State} (cfg : Turing.Cfg k Symbol State input) (a b : ℕ),
  Turing.MultiTapeTM.runFrom cfg (a + b) = Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.runFrom cfg a) b
@Turing.MultiTapeTM.runFrom_of_halt : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  {tm : Turing.MultiTapeTM k Symbol State} (cfg : Turing.Cfg k Symbol State input),
  cfg.state = none → ∀ {n : ℕ}, Turing.MultiTapeTM.runFrom cfg n = cfg
@Turing.MultiTapeTM.initCfg_with_q₀ : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2}
  (tm : Turing.MultiTapeTM k Symbol State) (q : State) (x : List Symbol),
  Turing.MultiTapeTM.initCfg x = Turing.Cfg.init q x
@Turing.MultiTapeTM.runFrom_with_q₀ : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {input : List Symbol}
  (tm : Turing.MultiTapeTM k Symbol State) (q : State) (cfg : Turing.Cfg k Symbol State input) (t : ℕ),
  Turing.MultiTapeTM.runFrom cfg t = Turing.MultiTapeTM.runFrom cfg t
Turing.pairEncode : List Bool → List Bool → List Bool
Turing.bits_two_pow_eq_replicate : ∀ (n : ℕ), (2 ^ n).bits = List.replicate n false ++ [true]
Nat.size_eq_bits_len : ∀ (n : ℕ), n.bits.length = n.size
Nat.lt_size_self : ∀ (n : ℕ), n < 2 ^ n.size
@Nat.size_le : ∀ {m n : ℕ}, m.size ≤ n ↔ m < 2 ^ n
@Nat.le_log_of_pow_le : ∀ {b x y : ℕ}, 1 < b → b ^ x ≤ y → x ≤ Nat.log b y
@Nat.ofDigits_cons : ∀ {b hd : ℕ} {tl : List ℕ}, Nat.ofDigits b (hd :: tl) = hd + b * Nat.ofDigits b tl
Nat.unpair_pair : ∀ (a b : ℕ), Nat.unpair (Nat.pair a b) = (a, b)
Complexity.timeConstructible_iff : ∀ (T : ℕ → ℕ),
  Complexity.TimeConstructible T ↔
    (∀ (n : ℕ), n ≤ T n) ∧
      ∃ c, 0 < c ∧ ∃ M, ∀ (x : List Bool), M.ComputesInTime x (T x.length).bits (c * (T x.length + 1))
@Turing.Round.iterate_seq : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} {M : Turing.MultiTapeTM k Γ S} {a : S}
  {E : Set (Option S)} {P : (Fin k → ℤ) → Prop} (cs : ℕ → Turing.Cfg k Γ S x) (τ : ℕ → ℕ),
  some a ∉ E →
    P (cs 0).workTapePos →
      ∀ (n : ℕ),
        (∀ r < n, Turing.Round M a E P (cs r) (cs (r + 1)) (τ r)) →
          Turing.Segment M E P (cs 0) (cs n) (∑ r ∈ Finset.range n, τ r)
@Turing.seamReleaseTM : {k : ℕ} →
  {S : Type u_1} → {Symbol : Type u_2} → Turing.MultiTapeTM k Symbol S → S → Turing.MultiTapeTM k Symbol (Unit ⊕ S)
@Turing.seamReleaseTM_runFrom_pos : ∀ {k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol}
  (M : Turing.MultiTapeTM k Symbol S) (anchor : S) (c : Turing.Cfg k Symbol S x),
  c.state = some anchor →
    ∀ (t : ℕ),
      0 < t →
        Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState (fun x => Sum.inl ()) c) t =
          Turing.Cfg.mapState Sum.inr (Turing.MultiTapeTM.runFrom c t)
@Turing.seamReleaseTM_firstReturn : ∀ {k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol}
  (M : Turing.MultiTapeTM k Symbol S) (anchor : S) {c c' : Turing.Cfg k Symbol S x} {T : ℕ},
  c.state = some anchor →
    0 < T →
      Turing.MultiTapeTM.runFrom c T = c' →
        c'.state = some anchor →
          (∀ (t : ℕ), 0 < t → t < T → (Turing.MultiTapeTM.runFrom c t).state ≠ some anchor) →
            Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState (fun x => Sum.inl ()) c) T =
                Turing.Cfg.mapState Sum.inr c' ∧
              ∀ t < T,
                (Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState (fun x => Sum.inl ()) c) t).state ≠
                  some (Sum.inr anchor)
@Turing.ReturnContract.release : {k : ℕ} →
  {Γ S : Type} →
    {M : Turing.MultiTapeTM k Γ S} →
      {anchor : S} →
        {ι : Type} →
          {x : List Γ} →
            Turing.ReturnContract M anchor ι x →
              Turing.Contract (Turing.seamReleaseTM M anchor) (Sum.inl ()) {some (Sum.inr anchor)} ι x
Turing.exists_inputSeekTM : ∃ S x x R entry exit C,
  ∀ {x : List Bool} (p : ℕ) (w : List Bool),
    Nat.ofDigits 2 (List.map Bool.toNat w) = p →
      p ≤ x.length + 1 →
        ∀ (d : Turing.Cfg 2 Bool S x),
          d.state = some entry →
            (∀ (q : ℤ), -1 ≤ q → q ≤ ↑w.length → d.workTapes 0 (d.workTapePos 0 + q) = Turing.FinTM.bufferTape w q) →
              (∀ (q : ℤ), d.workTapes 1 q = none) →
                ∃ t ≤ C * (w.length + ↑d.inputPos + p + 1),
                  (∀ u < t, (Turing.MultiTapeTM.runFrom d u).state ≠ some exit) ∧
                    (∀ u ≤ t,
                        ∀ (j : Fin 2),
                          |(Turing.MultiTapeTM.runFrom d u).workTapePos j - d.workTapePos j| ≤ ↑(C * (w.length + 1))) ∧
                      (Turing.MultiTapeTM.runFrom d t).state = some exit ∧
                        ↑(Turing.MultiTapeTM.runFrom d t).inputPos = p ∧
                          (Turing.MultiTapeTM.runFrom d t).workTapes = d.workTapes ∧
                            (Turing.MultiTapeTM.runFrom d t).workTapePos = d.workTapePos ∧
                              (Turing.MultiTapeTM.runFrom d t).output = d.output
@Turing.MultiTapeTM.output_prefix : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {input : List Symbol}
  (tm : Turing.MultiTapeTM k Symbol State) (cfg : Turing.Cfg k Symbol State input) {t t' : ℕ},
  t ≤ t' → (Turing.MultiTapeTM.runFrom cfg t).output <+: (Turing.MultiTapeTM.runFrom cfg t').output
@Turing.MultiTapeTM.runFrom_state_ne_none_of_le : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {input : List Symbol}
  (tm : Turing.MultiTapeTM k Symbol State) (cfg : Turing.Cfg k Symbol State input) (t : ℕ),
  (Turing.MultiTapeTM.runFrom cfg t).state ≠ none → ∀ u ≤ t, (Turing.MultiTapeTM.runFrom cfg u).state ≠ none
@Turing.MultiTapeTM.runFrom_zero : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  {tm : Turing.MultiTapeTM k Symbol State} {cfg : Turing.Cfg k Symbol State input},
  Turing.MultiTapeTM.runFrom cfg 0 = cfg
@Turing.Cfg.ofWords_state : ∀ {k : ℕ} {State : Type u_1} {input : List Bool} (q : State) (w : Fin k → List Bool),
  (Turing.Cfg.ofWords q w).state = some q
@Turing.Cfg.ofWords_inputPos : ∀ {k : ℕ} {State : Type u_1} {input : List Bool} (q : State) (w : Fin k → List Bool),
  (Turing.Cfg.ofWords q w).inputPos = 1
@Turing.Cfg.ofWords_workTapes : ∀ {k : ℕ} {State : Type u_1} {input : List Bool} (q : State) (w : Fin k → List Bool)
  (i : Fin k), (Turing.Cfg.ofWords q w).workTapes i = Turing.FinTM.bufferTape (w i)
@Turing.Cfg.ofWords_workTapePos : ∀ {k : ℕ} {State : Type u_1} {input : List Bool} (q : State) (w : Fin k → List Bool)
  (i : Fin k), (Turing.Cfg.ofWords q w).workTapePos i = 0
@Turing.Cfg.ofWords_output : ∀ {k : ℕ} {State : Type u_1} {input : List Bool} (q : State) (w : Fin k → List Bool),
  (Turing.Cfg.ofWords q w).output = []
Turing.stateWord_eq : ∀ (k : ℕ) (s : List Bool) (i : Fin k), Turing.stateWord k s i = if ↑i = 0 then s else []
@Turing.initCfg_ofWords : ∀ {k : ℕ} {State : Type u_1} (tm : Turing.MultiTapeTM k Bool State) (x : List Bool),
  Turing.MultiTapeTM.initCfg x = Turing.Cfg.ofWords tm.q₀ fun x => []
@Turing.Cfg.mapState_state : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {State' : Type u_3} {input : List Symbol}
  (f : State → State') (cfg : Turing.Cfg k Symbol State input),
  (Turing.Cfg.mapState f cfg).state = Option.map f cfg.state
@Turing.Cfg.mapState_inputPos : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {State' : Type u_3}
  {input : List Symbol} (f : State → State') (cfg : Turing.Cfg k Symbol State input),
  (Turing.Cfg.mapState f cfg).inputPos = cfg.inputPos
@Turing.Cfg.mapState_workTapes : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {State' : Type u_3}
  {input : List Symbol} (f : State → State') (cfg : Turing.Cfg k Symbol State input) (a : Fin k) (a_1 : ℤ),
  (Turing.Cfg.mapState f cfg).workTapes a a_1 = cfg.workTapes a a_1
@Turing.Cfg.mapState_workTapePos : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {State' : Type u_3}
  {input : List Symbol} (f : State → State') (cfg : Turing.Cfg k Symbol State input) (a : Fin k),
  (Turing.Cfg.mapState f cfg).workTapePos a = cfg.workTapePos a
@Turing.Cfg.mapState_output : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {State' : Type u_3} {input : List Symbol}
  (f : State → State') (cfg : Turing.Cfg k Symbol State input), (Turing.Cfg.mapState f cfg).output = cfg.output
@Turing.counter_cfg_eq : ∀ {k : ℕ} {S : Type} {x : List Bool} (q : Option (Turing.CounterLoopState S))
  (c : Turing.Cfg k Bool S x) (ct : ℤ → Option Bool) (cp : ℤ),
  Turing.counterLoopCfg q c ct cp =
    { state := q, inputPos := c.inputPos,
      workTapes := fun i => Fin.lastCases (motive := fun x => ℤ → Option Bool) ct c.workTapes i,
      workTapePos := fun i => Fin.lastCases cp c.workTapePos i, output := c.output }
@Turing.counterLoopCfg_body : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} (a : S)
  (d : Turing.Cfg (k + 1) Γ (Turing.CounterLoopState S) x),
  Turing.counterLoopCfg d.state (Turing.counterLoopBody a d) (d.workTapes (Fin.last k)) (d.workTapePos (Fin.last k)) = d
@Turing.phaseHostTM_q₀ : ∀ {k : ℕ} {Γ I : Type} {Ph : I → Type} (M : (i : I) → Turing.MultiTapeTM k Γ (Ph i))
  (q0 : (i : I) × Ph i) (red : (i : I) → Ph i → Option ((i : I) × Ph i)), (Turing.phaseHostTM M q0 red).q₀ = q0
@Turing.phaseHostTM_tr_of_red_none : ∀ {k : ℕ} {Γ I : Type} {Ph : I → Type}
  (M : (i : I) → Turing.MultiTapeTM k Γ (Ph i)) (q0 : (i : I) × Ph i) (red : (i : I) → Ph i → Option ((i : I) × Ph i))
  (i : I) (s : Ph i),
  red i s = none →
    ∀ (inp : Option Γ) (w : Fin k → Option Γ),
      (Turing.phaseHostTM M q0 red).tr ⟨i, s⟩ inp w = Turing.Action.mapState (Sigma.mk i) ((M i).tr s inp w)
@Turing.phaseHostTM_tr_of_red_some : ∀ {k : ℕ} {Γ I : Type} {Ph : I → Type}
  (M : (i : I) → Turing.MultiTapeTM k Γ (Ph i)) (q0 : (i : I) × Ph i) (red : (i : I) → Ph i → Option ((i : I) × Ph i))
  (i : I) (s : Ph i) {q' : (i : I) × Ph i},
  red i s = some q' →
    ∀ (inp : Option Γ) (w : Fin k → Option Γ),
      (Turing.phaseHostTM M q0 red).tr ⟨i, s⟩ inp w =
        { inputTape := 0, workTapes := fun x => (none, 0), output := none, state := some q' }
@Turing.embedEmitTM_runFrom : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol} (ι : Fin m ↪ Fin k)
  (M : Turing.MultiTapeTM m Symbol S) (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ) (pre : List Symbol)
  (c : Turing.Cfg m Symbol S x) (t : ℕ),
  Turing.MultiTapeTM.runFrom (Turing.embedEmitCfg ι tapes heads pre c) t =
    Turing.embedEmitCfg ι tapes heads pre (Turing.MultiTapeTM.runFrom c t)
@Turing.embedSilentTM_runFrom : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol} (ι : Fin m ↪ Fin k),
  ∀ cap ∉ Set.range ⇑ι,
    ∀ (M : Turing.MultiTapeTM m Symbol S) (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ)
      (pre out₀ : List Symbol) (c : Turing.Cfg m Symbol S x) (t : ℕ),
      Turing.MultiTapeTM.runFrom (Turing.embedSilentCfg ι cap tapes heads pre out₀ c) t =
        Turing.embedSilentCfg ι cap tapes heads pre out₀ (Turing.MultiTapeTM.runFrom c t)
@Turing.embedEmitTM_frame : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol} (ι : Fin m ↪ Fin k)
  (M : Turing.MultiTapeTM m Symbol S) (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ) (pre : List Symbol)
  (c : Turing.Cfg m Symbol S x) (t : ℕ),
  (∀ j ∉ Set.range ⇑ι,
      (Turing.MultiTapeTM.runFrom (Turing.embedEmitCfg ι tapes heads pre c) t).workTapes j = tapes j ∧
        (Turing.MultiTapeTM.runFrom (Turing.embedEmitCfg ι tapes heads pre c) t).workTapePos j = heads j) ∧
    (Turing.MultiTapeTM.runFrom (Turing.embedEmitCfg ι tapes heads pre c) t).inputPos =
        (Turing.MultiTapeTM.runFrom c t).inputPos ∧
      (Turing.MultiTapeTM.runFrom (Turing.embedEmitCfg ι tapes heads pre c) t).output =
        pre ++ (Turing.MultiTapeTM.runFrom c t).output
@Turing.embedEmitCfg_ofWords_eq : ∀ {k m : ℕ} {S : Type u_1} {x : List Bool} (σ : Fin m ↪ Fin k) (q : S)
  (v : Fin m → List Bool) (frame target : Fin k → List Bool),
  (∀ (i : Fin m), target (σ i) = v i) →
    (∀ j ∉ Set.range ⇑σ, frame j = target j) →
      Turing.embedEmitCfg σ (fun j => Turing.FinTM.bufferTape (frame j)) (fun x => 0) [] (Turing.Cfg.ofWords q v) =
        Turing.Cfg.ofWords q target
@Turing.embedEmitCfg_mapState_eq : ∀ {k : ℕ} {Γ : Type u_1} {m : ℕ} {S : Type u_2} {H : Type u_3} {x : List Γ}
  (σ : Fin m ↪ Fin k) (f : S → H) (tapes : Fin k → ℤ → Option Γ) (heads : Fin k → ℤ) (pre : List Γ)
  (c : Turing.Cfg m Γ S x) (d : Turing.Cfg k Γ H x),
  Option.map f c.state = d.state →
    c.inputPos = d.inputPos →
      pre ++ c.output = d.output →
        (∀ (i : Fin m), c.workTapes i = d.workTapes (σ i) ∧ c.workTapePos i = d.workTapePos (σ i)) →
          (∀ j ∉ Set.range ⇑σ, tapes j = d.workTapes j ∧ heads j = d.workTapePos j) →
            Turing.Cfg.mapState f (Turing.embedEmitCfg σ tapes heads pre c) = d
@Turing.scanTM : {Γ : Type u_1} →
  {A : Type} → (k : ℕ) → Fin k → (A → Γ → A × Γ) → (A → Γ → A × Γ) → A → Turing.MultiTapeTM k Γ (Turing.ScanPhase A)
@Turing.scanTM_run_ofCfg : ∀ {Γ : Type u_1} {A : Type} {k : ℕ} {x : List Γ} (i : Fin k) (δf δb : A → Γ → A × Γ) (a₀ : A)
  (w : List Γ) (d : Turing.Cfg k Γ (Turing.ScanPhase A) x),
  d.state = some (Turing.ScanPhase.fwd a₀) →
    (∀ (p : ℤ), -1 ≤ p → p ≤ ↑w.length → d.workTapes i (d.workTapePos i + p) = Turing.FinTM.bufferTape w p) →
      Turing.MultiTapeTM.runFrom d (2 * w.length + 2) =
          { state := some (Turing.ScanPhase.done (Turing.scanResult δf δb a₀ w).1), inputPos := d.inputPos,
            workTapes := fun j q =>
              if j = i ∧ d.workTapePos j ≤ q ∧ q < d.workTapePos j + ↑w.length then
                Turing.FinTM.bufferTape (Turing.scanResult δf δb a₀ w).2 (q - d.workTapePos j)
              else d.workTapes j q,
            workTapePos := d.workTapePos, output := d.output } ∧
        (∀ t < 2 * w.length + 2, ∀ (a : A), (Turing.MultiTapeTM.runFrom d t).state ≠ some (Turing.ScanPhase.done a)) ∧
          ∀ (j : Fin k),
            ∀ t ≤ 2 * w.length + 2,
              if j = i then
                (Turing.MultiTapeTM.runFrom d t).workTapePos j ∈
                  Finset.Icc (d.workTapePos j - 1) (d.workTapePos j + ↑w.length)
              else (Turing.MultiTapeTM.runFrom d t).workTapePos j = d.workTapePos j
