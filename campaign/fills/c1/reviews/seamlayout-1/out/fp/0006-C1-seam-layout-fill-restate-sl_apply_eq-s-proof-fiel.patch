From 09773a665e5409a66ddc71a42f566efe74e690d8 Mon Sep 17 00:00:00 2001
From: Fill agent <ragavanbsco@mit.edu>
Date: Thu, 22 Oct 2026 03:39:39 +0000
Subject: [PATCH 6/6] C1 seam-layout fill: restate sl_apply_eq's proof
 fieldwise

The applied-action normal form now assembles Cfg.ext from named field
equations instead of the bulleted rewrite shape, removing the screen's
one cross-file text pair against the pre-existing pair-extractor run.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01GaMrc1FMKDFT2ueePohJHP
---
 .../TuringMachine/Build/SeamLayout.lean        | 18 ++++++++++--------
 1 file changed, 10 insertions(+), 8 deletions(-)

diff --git a/TCSlib/Complexity/TuringMachine/Build/SeamLayout.lean b/TCSlib/Complexity/TuringMachine/Build/SeamLayout.lean
index 9c324c7d..483be51b 100644
--- a/TCSlib/Complexity/TuringMachine/Build/SeamLayout.lean
+++ b/TCSlib/Complexity/TuringMachine/Build/SeamLayout.lean
@@ -117,14 +117,16 @@ private lemma sl_apply_eq {k : ℕ} {x : List Bool} {S : Type} (a : Action k Boo
         workTapes := fun j => Function.update (c.workTapes j) (c.workTapePos j)
           ((a.workTapes j).1.getD (c.workTapes j (c.workTapePos j)))
         workTapePos := fun j => c.workTapePos j + ((a.workTapes j).2 : ℤ) } := by
-  apply Cfg.ext
-  · rw [Action.apply_state]
-  · rw [Action.apply_inputPos, h0, moveInputPos_zero]
-  · funext j
-    rw [Action.apply_workTapes, Cfg.workTapeSymbols_eq]
-  · funext j
-    rw [Action.apply_workTapePos]
-  · rw [Action.apply_output, hout, Option.toList_none, List.append_nil]
+  have hi : (a.apply c).inputPos = c.inputPos := by
+    rw [Action.apply_inputPos, h0, moveInputPos_zero]
+  have hwt : (a.apply c).workTapes = fun j => Function.update (c.workTapes j)
+      (c.workTapePos j) ((a.workTapes j).1.getD (c.workTapes j (c.workTapePos j))) :=
+    funext fun j => by rw [Action.apply_workTapes, Cfg.workTapeSymbols_eq]
+  have hwp : (a.apply c).workTapePos = fun j => c.workTapePos j + ((a.workTapes j).2 : ℤ) :=
+    funext fun j => Action.apply_workTapePos a c j
+  have ho : (a.apply c).output = c.output := by
+    rw [Action.apply_output, hout, Option.toList_none, List.append_nil]
+  exact Cfg.ext (Action.apply_state a c) hi hwt hwp ho
 
 /-- A leaf step that only moves the head of tape `i` one cell right: the control changes, the
 head advances, and everything else stays. -/
