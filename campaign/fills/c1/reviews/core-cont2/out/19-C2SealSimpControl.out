    RewindPhase) :=
  seamCompTM S₇ (Sum.inr 2) A₈ RewindPhase.start
S₉ : MultiTapeTM K Bool
  ((((((((((prefixCanonTM (FinTM.pairExtractTM true false)).State ⊕ Unit) ⊕ Fin 3) ⊕
                (prefixCanonTM (FinTM.pairExtractTM false true)).State ⊕ Unit) ⊕
              RewindPhase) ⊕
            SweepPhase) ⊕
          QW) ⊕
        Fin 3) ⊕
      RewindPhase) ⊕
    Unit ⊕ CI.State) :=
  seamCompTM S₈ (Sum.inr RewindPhase.done) A₉ (Sum.inl ())
S₁₀ : MultiTapeTM K Bool
  (((((((((((prefixCanonTM (FinTM.pairExtractTM true false)).State ⊕ Unit) ⊕ Fin 3) ⊕
