                RewindPhase) ⊕
              SweepPhase) ⊕
            QW) ⊕
          Fin 3) ⊕
        RewindPhase) ⊕
      Unit ⊕ CI.State) ⊕
    QL) :=
  seamCompTM S₉ (Sum.inr (Sum.inr doneI)) L entryL
S₁₁ : MultiTapeTM K Bool
  ((((((((((((prefixCanonTM (FinTM.pairExtractTM true false)).State ⊕ Unit) ⊕ Fin 3) ⊕
