hd₆dstpos : (Cfg.mapState (fun x => entryW) (Cfg.mapState Sum.inr e₅)).workTapePos jwin = 0
T₆ : ℕ
hT₆ : T₆ ≤ CW * (min t x.length + 1) + 2 * t.bits.length
h₆cut : ∀ u < T₆, (MultiTapeTM.runFrom (Cfg.mapState (fun x => entryW) (Cfg.mapState Sum.inr e₅)) u).state ≠ some doneW
e₆ : Cfg K Bool QW (pairEncode (pairEncode t.bits α) x) :=
