    RewindPhase) :=
  seamCompTM S₁₀ (Sum.inr doneL) A₁₁ RewindPhase.start
R : MultiTapeTM K Bool
  (((((((((((((prefixCanonTM (FinTM.pairExtractTM true false)).State ⊕ Unit) ⊕ Fin 3) ⊕
                      (prefixCanonTM (FinTM.pairExtractTM false true)).State ⊕ Unit) ⊕
                    RewindPhase) ⊕
                  SweepPhase) ⊕
                QW) ⊕
              Fin 3) ⊕
            RewindPhase) ⊕
          Unit ⊕ CI.State) ⊕
        QL) ⊕
      RewindPhase) ⊕
    (i : Bool) × ic_loopPh i) :=
  seamCompTM S₁₁ (Sum.inr RewindPhase.done) A₁₂ ⟨false, (CounterLoopState.dec FlagPhase.run, true)⟩
