h₆st : e₆.state = some doneW
h₆pos : ↑e₆.inputPos = 4 * t.bits.length + 2 * α.length + 7 + (List.take t x).length
h₆win : e₆.workTapes jwin = FinTM.bufferTape (List.take t x)
h₆winhd : e₆.workTapePos jwin = ↑(List.take t x).length
