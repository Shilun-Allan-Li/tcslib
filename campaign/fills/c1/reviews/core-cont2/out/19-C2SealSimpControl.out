          Finset.Icc ((Cfg.mapState (fun x => SweepPhase.sweep) (Cfg.mapState Sum.inr e₄)).workTapePos j - 1)
            ((Cfg.mapState (fun x => SweepPhase.sweep) (Cfg.mapState Sum.inr e₄)).workTapePos j + ↑t.bits.length)
      else
        (MultiTapeTM.runFrom (Cfg.mapState (fun x => SweepPhase.sweep) (Cfg.mapState Sum.inr e₄)) t_1).workTapePos j =
          (Cfg.mapState (fun x => SweepPhase.sweep) (Cfg.mapState Sum.inr e₄)).workTapePos j
s5cut :
  ∀
