e₅ : Cfg K Bool SweepPhase (pairEncode (pairEncode t.bits α) x) :=
  let __src := Cfg.mapState (fun x => SweepPhase.sweep) (Cfg.mapState Sum.inr e₄);
  { state := some SweepPhase.done, inputPos := __src.inputPos,
