+        ∀ u ≤ j, ((ic_rewindLeafTM k).runFrom cfg u).state = some 1 := by
+  intro j
+  induction j with
+  | zero =>
+    intro cfg hs hj _
+    have hz : cfg.inputPos = 0 := Fin.ext hj
+    have hstep : (ic_rewindLeafTM k).step cfg =
