                               (Turing.FinTM.bufferTape (Turing.tableBitsK (c.decode α).tm.replayTM.tr)))
                             jsm (Turing.StepBlock.summaryCells none (Turing.unaryFin (c.decode α).tm.replayTM.q₀)) ∧
                         (Turing.MultiTapeTM.runFrom d TL).workTapePos =
                             Function.update (Function.update (Function.update d.workTapePos jal 0) jtbl 0) jsm 0 ∧
                           (∀ u ≤ TL, (Turing.MultiTapeTM.runFrom d u).output = d.output) ∧
