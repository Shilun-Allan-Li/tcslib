   dstep =
     { state := some (Turing.StepBlock.exit 3 true), inputPos := 1,
       workTapes := fun i =>
         if ↑i = 2 then Turing.FinTM.bufferTape s
         else
           if ↑i = 3 then Turing.FinTM.bufferTape (Turing.tableBitsK (c.decode α).tm.replayTM.tr)
           else
             if ↑i = 4 then Turing.StepBlock.summaryCells none (Turing.unaryFin (c.decode α).tm.q₀) else fun x => none,
       workTapePos := fun x => 0, output := [] }
