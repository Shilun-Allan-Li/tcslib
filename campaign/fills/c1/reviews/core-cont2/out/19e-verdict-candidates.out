 TLoop : ℕ
 hTLoopFull :
   TLoop ≤ t * (50 * ((Turing.tableBitsK (c.decode α).tm.replayTM.tr).length + 1)) + 4 * t + 2 * t.bits.length + 4
 hTLoopEarly :
   ∀ r ≤ t,
     (Turing.NDTM.runWith (List.take r s) (Turing.NDTM.initCfg x)).state = none →
       TLoop ≤ r * (50 * ((Turing.tableBitsK (c.decode α).tm.replayTM.tr).length + 1)) + 4 * r + 2 * t.bits.length + 2
