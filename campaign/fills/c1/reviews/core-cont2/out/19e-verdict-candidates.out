                     j +
                   ↑t.bits.length then
         Turing.FinTM.bufferTape t.bits
           (q - (Turing.Cfg.mapState (fun x => Turing.SweepPhase.sweep) (Turing.Cfg.mapState Sum.inr e₄)).workTapePos j)
       else (Turing.Cfg.mapState (fun x => Turing.SweepPhase.sweep) (Turing.Cfg.mapState Sum.inr e₄)).workTapes j q,
