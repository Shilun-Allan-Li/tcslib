   (Turing.MultiTapeTM.runFrom
         (Turing.Cfg.mapState (Sigma.mk false)
           (Turing.vhostCfg
             (Turing.counterLoopCfg (some (Turing.CounterLoopState.dec Turing.FlagPhase.run)) dstep
               (Turing.FinTM.bufferTape t.bits) 0)
             true e₁₁.inputPos []))
         TLoop).state =
     some
       ⟨true,
         Sum.inr
           (decide
             ((Turing.NDTM.runWith (List.take t s) (Turing.NDTM.initCfg x)).state = none ∧
               (Turing.NDTM.runWith (List.take t s) (Turing.NDTM.initCfg x)).output = [true]))⟩
