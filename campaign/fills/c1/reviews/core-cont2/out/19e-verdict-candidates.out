 W : Turing.MultiTapeTM K Bool QW
 entryW doneW : QW
 CW : ℕ
 windows :
   ∀ (α x : List Bool) (t : ℕ) (d : Turing.Cfg K Bool QW (Turing.pairEncode (Turing.pairEncode t.bits α) x)),
     d.state = some entryW →
       ↑d.inputPos = 4 * t.bits.length + 2 * α.length + 7 →
         (∀ (q : ℤ),
