 e₅ : Turing.Cfg K Bool Turing.SweepPhase (Turing.pairEncode (Turing.pairEncode t.bits α) x) :=
   let __src := Turing.Cfg.mapState (fun x => Turing.SweepPhase.sweep) (Turing.Cfg.mapState Sum.inr e₄);
   { state := some Turing.SweepPhase.done, inputPos := __src.inputPos,
     workTapes := fun j q =>
