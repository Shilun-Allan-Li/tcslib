                 d.workTapePos jsm = 0 →
                   (Turing.MultiTapeTM.runFrom d TL).state = some doneL ∧
                     (Turing.MultiTapeTM.runFrom d TL).inputPos = d.inputPos ∧
                       (Turing.MultiTapeTM.runFrom d TL).workTapes =
                           Function.update
