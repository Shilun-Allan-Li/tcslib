  cfg.state = some q → Turing.NDTM.stepWith b cfg = (tm.tr b q cfg.inputSymbol cfg.workTapeSymbols).apply cfg
@Turing.NDTM.stepWith_of_halt : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  {tm : Turing.NDTM k Symbol State} {b : Bool} {cfg : Turing.Cfg k Symbol State input},
  cfg.state = none → Turing.NDTM.stepWith b cfg = cfg
