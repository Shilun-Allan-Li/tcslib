Turing.counterOverhead_le : ∀ (w : List Bool),
  Turing.counterOverhead w (Nat.ofDigits 2 (List.map Bool.toNat w) + 1) ≤
    4 * Nat.ofDigits 2 (List.map Bool.toNat w) + 2 * w.length + 2
