Turing.FinNDTM : Type → Type 1
Turing.FinNDTM.AcceptsWithin : Turing.FinNDTM Bool → List Bool → ℕ → Prop
@Turing.copyTM : {Symbol : Type u_1} → (k : ℕ) → Fin k → Fin k → Turing.MultiTapeTM k Symbol Turing.SweepPhase
@Turing.copyTM_run_ofCfg : ∀ {Symbol : Type u_1} {k : ℕ} {x : List Symbol} (src dst : Fin k),
  src ≠ dst →
    ∀ (w : List Symbol) (d : Turing.Cfg k Symbol Turing.SweepPhase x),
      d.state = some Turing.SweepPhase.sweep →
        (∀ (p : ℤ), -1 ≤ p → p ≤ ↑w.length → d.workTapes src (d.workTapePos src + p) = Turing.FinTM.bufferTape w p) →
          Turing.MultiTapeTM.runFrom d (2 * w.length + 2) =
              { state := some Turing.SweepPhase.done, inputPos := d.inputPos,
                workTapes := fun j q =>
                  if j = dst ∧ d.workTapePos j ≤ q ∧ q < d.workTapePos j + ↑w.length then
                    Turing.FinTM.bufferTape w (q - d.workTapePos j)
                  else d.workTapes j q,
                workTapePos := d.workTapePos, output := d.output } ∧
            (∀ t < 2 * w.length + 2, (Turing.MultiTapeTM.runFrom d t).state ≠ some Turing.SweepPhase.done) ∧
              ∀ (j : Fin k),
                ∀ t ≤ 2 * w.length + 2,
                  if j = src ∨ j = dst then
                    (Turing.MultiTapeTM.runFrom d t).workTapePos j ∈
                      Finset.Icc (d.workTapePos j - 1) (d.workTapePos j + ↑w.length)
                  else (Turing.MultiTapeTM.runFrom d t).workTapePos j = d.workTapePos j
Turing.incrementTM : (k : ℕ) → Fin k → Turing.MultiTapeTM k Bool Turing.FlagPhase
Turing.incFixed : List Bool → Option (List Bool)
Turing.incFixed_eq_none_iff_replicate : ∀ (u : List Bool), Turing.incFixed u = none ↔ u = List.replicate u.length true
Turing.incFixed_false_cons : ∀ (w : List Bool), Turing.incFixed (false :: w) = some (true :: w)
@Turing.incFixed_length : ∀ {w v : List Bool}, Turing.incFixed w = some v → v.length = w.length
Turing.incFixed_nil : Turing.incFixed [] = none
Turing.incFixed_true_cons : ∀ (w : List Bool),
  Turing.incFixed (true :: w) = Option.map (fun x => false :: x) (Turing.incFixed w)
@Turing.embedSilentCfg : {m k : ℕ} →
  {S : Type u_1} →
    {Symbol : Type u_2} →
      {x : List Symbol} →
        (Fin m ↪ Fin k) →
          Fin k →
            (Fin k → ℤ → Option Symbol) →
              (Fin k → ℤ) → List Symbol → List Symbol → Turing.Cfg m Symbol S x → Turing.Cfg k Symbol S x
