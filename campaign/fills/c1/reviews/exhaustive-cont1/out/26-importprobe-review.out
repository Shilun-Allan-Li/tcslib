            (c₁.state = some e₂ →
              ∀ (t : ℕ),
                Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState Sum.inl (Turing.Cfg.mapState Sum.inl c₀)) (T₀ + 1 + t) =
                  Turing.Cfg.mapState Sum.inr (Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState (fun x => entry₂) c₁) t))
