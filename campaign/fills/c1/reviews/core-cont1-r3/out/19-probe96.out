Turing.exists_inputWindowCopyTM : ∀ (k : ℕ) (j dst : Fin k),
  j ≠ dst →
    ∃ Q x x W entry done C,
      ∀ {z : List Bool} (d : Turing.Cfg k Bool Q z) (p : ℕ) (w : List Bool),
        d.state = some entry →
          ↑d.inputPos = p + 1 →
            (∀ (q : ℤ), -1 ≤ q → q ≤ ↑w.length → d.workTapes j (d.workTapePos j + q) = Turing.FinTM.bufferTape w q) →
              have y := List.take (Nat.ofDigits 2 (List.map Bool.toNat w)) (List.drop p z);
              ∃ T ≤ C * (y.length + 1) + 2 * w.length,
                ∃ w',
                  w'.length = w.length ∧
                    (Turing.MultiTapeTM.runFrom d T).state = some done ∧
                      ↑(Turing.MultiTapeTM.runFrom d T).inputPos = p + 1 + y.length ∧
                        ((Turing.MultiTapeTM.runFrom d T).workTapes =
                            Function.update
                              (Function.update d.workTapes dst fun q =>
                                if d.workTapePos dst ≤ q ∧ q < d.workTapePos dst + ↑y.length then
                                  Turing.FinTM.bufferTape y (q - d.workTapePos dst)
                                else d.workTapes dst q)
                              j fun q =>
                              if d.workTapePos j ≤ q ∧ q < d.workTapePos j + ↑w.length then
                                Turing.FinTM.bufferTape w' (q - d.workTapePos j)
                              else d.workTapes j q) ∧
                          (Turing.MultiTapeTM.runFrom d T).workTapePos =
                              Function.update d.workTapePos dst (d.workTapePos dst + ↑y.length) ∧
                            (Turing.MultiTapeTM.runFrom d T).output = d.output ∧
                              ∀ u < T, (Turing.MultiTapeTM.runFrom d u).state ≠ some done
Turing.prefixCanonTM : Turing.FinTM Bool → Turing.FinTM Bool
Turing.prefixCanonTM_eq : ∀ (F : Turing.FinTM Bool), Turing.prefixCanonTM F = Turing.universalPrefixTM.bufferedCompTM F
Turing.prefixCanon_complete : ∀ (F : Turing.FinTM Bool) (f : List Bool → List Bool) (τ : ℕ → ℕ),
  F.ComputesFunInTime f τ →
    ∀ (α x : List Bool),
      have cfg :=
        Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg (Turing.pairEncode α x)) (3 * α.length + 4 + τ α.length);
      cfg.state = none ∧ cfg.output = f α ∧ ↑cfg.inputPos = 2 * α.length + 3
Turing.FinTM.pairExtractTM_fst : (Turing.FinTM.pairExtractTM true false).ComputesFunInTime
  (fun x => (Option.map Prod.fst (Turing.pairDecode x)).getD []) fun n => 5 * (n + 1)
Turing.FinTM.pairExtractTM_snd : (Turing.FinTM.pairExtractTM false true).ComputesFunInTime
  (fun x => (Option.map Prod.snd (Turing.pairDecode x)).getD []) fun n => 5 * (n + 1)
@Turing.FinTM.timed_rewind : ∀ {k : ℕ} {S : Type} {x : List Bool} (tm : Turing.MultiTapeTM k Bool S) (start scan : S)
  (dest : Option S),
  (∀ (inp : Option Bool) (work : Fin k → Option Bool),
      tm.tr start inp work = Turing.FinTM.controlAction SignType.neg (some scan)) →
    (∀ (inp : Option Bool) (work : Fin k → Option Bool),
        tm.tr scan inp work =
          match inp with
          | some val => Turing.FinTM.controlAction SignType.neg (some scan)
          | none => Turing.FinTM.controlAction SignType.pos dest) →
      ∀ (c : Turing.Cfg k Bool S x),
        c.state = some start →
          ∃ r ≤ ↑c.inputPos + 2,
            Turing.MultiTapeTM.runFrom c r =
              { state := dest, inputPos := 1, workTapes := c.workTapes, workTapePos := c.workTapePos,
                output := c.output }
Turing.FinTM.exists_installCallTM : ∀ (M : Turing.FinTM Bool) (f : List Bool → List Bool) (T : ℕ → ℕ),
  M.ComputesFunInTime f T →
    ∃ C entry exit c,
      0 < C.k ∧
        ∀ (x arg : List Bool),
          ∃ t ≤ c * (T arg.length + arg.length + (f arg).length + 1),
            0 < t ∧
              (∀ (t' : ℕ),
                  0 < t' →
                    t' < t →
                      (Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords entry (Turing.stateWord C.k arg)) t').state ≠
                        some exit) ∧
                Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords entry (Turing.stateWord C.k arg)) t =
                  Turing.Cfg.ofWords exit (Turing.stateWord C.k (f arg))
@Turing.Cfg.ofWords : {k : ℕ} →
  {State : Type u_1} → {input : List Bool} → State → (Fin k → List Bool) → Turing.Cfg k Bool State input
@Turing.Cfg.ofWords_state : ∀ {k : ℕ} {State : Type u_1} {input : List Bool} (q : State) (w : Fin k → List Bool),
  (Turing.Cfg.ofWords q w).state = some q
@Turing.Cfg.ofWords_inputPos : ∀ {k : ℕ} {State : Type u_1} {input : List Bool} (q : State) (w : Fin k → List Bool),
  (Turing.Cfg.ofWords q w).inputPos = 1
@Turing.Cfg.ofWords_workTapes : ∀ {k : ℕ} {State : Type u_1} {input : List Bool} (q : State) (w : Fin k → List Bool)
  (i : Fin k), (Turing.Cfg.ofWords q w).workTapes i = Turing.FinTM.bufferTape (w i)
@Turing.Cfg.ofWords_workTapePos : ∀ {k : ℕ} {State : Type u_1} {input : List Bool} (q : State) (w : Fin k → List Bool)
  (i : Fin k), (Turing.Cfg.ofWords q w).workTapePos i = 0
@Turing.Cfg.ofWords_output : ∀ {k : ℕ} {State : Type u_1} {input : List Bool} (q : State) (w : Fin k → List Bool),
  (Turing.Cfg.ofWords q w).output = []
Turing.counterValue_bits : ∀ (t : ℕ), Turing.counterValue t.bits = t
Turing.StepBlock.hostedLoopTM : (k : ℕ) →
  Turing.MultiTapeTM (1 + (k + 2 + 1)) Bool
    (Turing.CounterLoopState ((key : Turing.StepBlock.Key) × Turing.StepBlock.Ph k key) × Bool)
@Turing.StepBlock.hostedLoopTM_run : ∀ {k n : ℕ} {x z : List Bool} (M : Turing.MultiTapeTM k Bool (Fin (n + 1)))
  (c : Turing.Cfg k Bool (Fin (n + 1)) x),
  c.state ≠ none →
    ∀ (d : Turing.Cfg (k + 2) Bool ((key : Turing.StepBlock.Key) × Turing.StepBlock.Ph k key) x),
      d.state = some (Turing.StepBlock.exit k true) →
        Turing.StepBlock.Rep M.tr c d →
          ∀ (w : List Bool) (ct : ℤ → Option Bool) (cp : ℤ),
            (∀ (p : ℤ), -1 ≤ p → p ≤ ↑w.length → ct (cp + p) = Turing.FinTM.bufferTape w p) →
              ∀ (t : ℕ),
                Nat.ofDigits 2 (List.map Bool.toNat w) = t →
                  ∀ (b : Bool),
                    Turing.FinTM.VirtualTag c.inputPos b →
                      ∀ (p : Fin (z.length + 2)) (pre : List Bool),
                        ∃ T e ct' b',
                          T ≤ t * (50 * ((Turing.tableBitsK M.tr).length + 1)) + 4 * t + 2 * w.length + 2 ∧
                            (∀ t' ≤ t,
                                (Turing.MultiTapeTM.runFrom c t').state = none →
                                  T ≤ t' * (50 * ((Turing.tableBitsK M.tr).length + 1)) + 4 * t' + 2 * w.length) ∧
                              Turing.StepBlock.Rep M.tr (Turing.MultiTapeTM.runFrom c t) e ∧
                                e.output = d.output ∧
                                  (∀ (q : ℤ), ¬(cp ≤ q ∧ q < cp + ↑w.length) → ct' q = ct q) ∧
                                    Turing.FinTM.VirtualTag e.inputPos b' ∧
                                      Turing.MultiTapeTM.runFrom
                                            (Turing.vhostCfg
                                              (Turing.counterLoopCfg
                                                (some (Turing.CounterLoopState.dec Turing.FlagPhase.run)) d ct cp)
                                              b p pre)
                                            T =
                                          Turing.vhostCfg
                                            (Turing.counterLoopCfg
                                              (some
                                                (if (Turing.MultiTapeTM.runFrom c t).state.isSome = true then
                                                  Turing.CounterLoopState.done
                                                else Turing.CounterLoopState.escape))
                                              e ct' cp)
                                            b' p pre ∧
                                        ∀ u < T,
                                          ∀ (tag : Bool),
                                            (Turing.MultiTapeTM.runFrom
                                                    (Turing.vhostCfg
                                                      (Turing.counterLoopCfg
                                                        (some (Turing.CounterLoopState.dec Turing.FlagPhase.run)) d ct
                                                        cp)
                                                      b p pre)
                                                    u).state ≠
                                                some (Turing.CounterLoopState.done, tag) ∧
                                              (Turing.MultiTapeTM.runFrom
                                                    (Turing.vhostCfg
                                                      (Turing.counterLoopCfg
                                                        (some (Turing.CounterLoopState.dec Turing.FlagPhase.run)) d ct
                                                        cp)
                                                      b p pre)
                                                    u).state ≠
                                                some (Turing.CounterLoopState.escape, tag)
@Turing.StepBlock.hostedLoop_read : ∀ {k n : ℕ} {x z : List Bool}
  (tr : Fin (n + 1) → Option Bool → (Fin k → Option Bool) → Turing.Action k Bool (Fin (n + 1)))
  (c' : Turing.Cfg k Bool (Fin (n + 1)) x)
  (e : Turing.Cfg (k + 2) Bool ((key : Turing.StepBlock.Key) × Turing.StepBlock.Ph k key) x),
  Turing.StepBlock.Rep tr c' e →
    ∀ (q : Turing.CounterLoopState ((key : Turing.StepBlock.Key) × Turing.StepBlock.Ph k key)) (ct : ℤ → Option Bool)
      (cp : ℤ) (b : Bool) (p : Fin (z.length + 2)) (pre : List Bool),
      (Turing.vhostCfg (Turing.counterLoopCfg (some q) e ct cp) b p pre).state = some (q, b) ∧
        (Turing.vhostCfg (Turing.counterLoopCfg (some q) e ct cp) b p pre).inputPos = p ∧
          (Turing.vhostCfg (Turing.counterLoopCfg (some q) e ct cp) b p pre).output = pre ++ e.output ∧
            (Turing.vhostCfg (Turing.counterLoopCfg (some q) e ct cp) b p pre).workTapeSymbols
                (Turing.vhostBank (Turing.StepBlock.summaryTape k).castSucc) =
              Turing.StepBlock.outputSummary c'.output
@Turing.StepBlock.Rep_iff : ∀ {k n : ℕ} {x : List Bool}
  {tr : Fin (n + 1) → Option Bool → (Fin k → Option Bool) → Turing.Action k Bool (Fin (n + 1))}
  {c : Turing.Cfg k Bool (Fin (n + 1)) x}
  {d : Turing.Cfg (k + 2) Bool ((key : Turing.StepBlock.Key) × Turing.StepBlock.Ph k key) x},
  Turing.StepBlock.Rep tr c d ↔
    d.inputPos = c.inputPos ∧
      (∀ (i : Fin k),
          d.workTapes (Fin.castAdd 2 i) = c.workTapes i ∧ d.workTapePos (Fin.castAdd 2 i) = c.workTapePos i) ∧
        d.workTapes (Turing.StepBlock.tableTape k) = Turing.FinTM.bufferTape (Turing.tableBitsK tr) ∧
          d.workTapes (Turing.StepBlock.summaryTape k) =
              Turing.StepBlock.summaryCells (Turing.StepBlock.outputSummary c.output)
                ((Option.map Turing.unaryFin c.state).getD []) ∧
            d.workTapePos (Turing.StepBlock.tableTape k) = 0 ∧ d.workTapePos (Turing.StepBlock.summaryTape k) = 0
Turing.StepBlock.exit_true : ∀ (k : ℕ), Turing.StepBlock.exit k true = ⟨Turing.StepBlock.Key.entry, ()⟩
Turing.StepBlock.exit_false : ∀ (k : ℕ), Turing.StepBlock.exit k false = ⟨Turing.StepBlock.Key.halt, ()⟩
Turing.StepBlock.summaryTape_eq : ∀ (k : ℕ), Turing.StepBlock.summaryTape k = Fin.natAdd k 1
Turing.StepBlock.tableTape_eq : ∀ (k : ℕ), Turing.StepBlock.tableTape k = Fin.natAdd k 0
Turing.StepBlock.outputSummary_nil : Turing.StepBlock.outputSummary [] = none
Turing.StepBlock.summaryCells_eq : ∀ (summary : Option Bool) (word : List Bool) (z : ℤ),
  Turing.StepBlock.summaryCells summary word z = if z = 0 then summary else Turing.FinTM.bufferTape word (z - 2)
@Turing.vhostCfg_state : ∀ {m : ℕ} {S : Type u_1} {x y : List Bool} (c : Turing.Cfg m Bool S y) (b : Bool)
  (p : Fin (x.length + 2)) (pre : List Bool), (Turing.vhostCfg c b p pre).state = Option.map (fun q => (q, b)) c.state
@Turing.vhostCfg_inputPos : ∀ {m : ℕ} {S : Type u_1} {x y : List Bool} (c : Turing.Cfg m Bool S y) (b : Bool)
  (p : Fin (x.length + 2)) (pre : List Bool), (Turing.vhostCfg c b p pre).inputPos = p
@Turing.vhostCfg_workTapes : ∀ {m : ℕ} {S : Type u_1} {x y : List Bool} (c : Turing.Cfg m Bool S y) (b : Bool)
  (p : Fin (x.length + 2)) (pre : List Bool) (i : Fin (1 + m)) (a : ℤ),
  (Turing.vhostCfg c b p pre).workTapes i a =
    Fin.addCases (motive := fun x => ℤ → Option Bool) (fun x => Turing.FinTM.bufferTape y) c.workTapes i a
@Turing.vhostCfg_workTapePos : ∀ {m : ℕ} {S : Type u_1} {x y : List Bool} (c : Turing.Cfg m Bool S y) (b : Bool)
  (p : Fin (x.length + 2)) (pre : List Bool) (i : Fin (1 + m)),
  (Turing.vhostCfg c b p pre).workTapePos i = Fin.addCases (fun x => ↑↑c.inputPos - 1) c.workTapePos i
@Turing.vhostCfg_output : ∀ {m : ℕ} {S : Type u_1} {x y : List Bool} (c : Turing.Cfg m Bool S y) (b : Bool)
  (p : Fin (x.length + 2)) (pre : List Bool), (Turing.vhostCfg c b p pre).output = pre ++ c.output
@Turing.vhostBank_eq : ∀ {m : ℕ} (i : Fin m), Turing.vhostBank i = Fin.natAdd 1 i
@Turing.counter_cfg_eq : ∀ {k : ℕ} {S : Type} {x : List Bool} (q : Option (Turing.CounterLoopState S))
  (c : Turing.Cfg k Bool S x) (ct : ℤ → Option Bool) (cp : ℤ),
  Turing.counterLoopCfg q c ct cp =
    { state := q, inputPos := c.inputPos,
      workTapes := fun i => Fin.lastCases (motive := fun x => ℤ → Option Bool) ct c.workTapes i,
      workTapePos := fun i => Fin.lastCases cp c.workTapePos i, output := c.output }
@Turing.serializeK_eq : ∀ {k n : ℕ} (M : Turing.MultiTapeTM k Bool (Fin (n + 1))),
  Turing.serializeK M = Turing.pairEncode n.bits (Turing.unaryFin M.q₀ ++ Turing.tableBitsK M.tr)
Turing.CodeNDTM.toFinNDTM_k : ∀ (M : Turing.CodeNDTM), M.toFinNDTM.k = 2
Turing.CodeNDTM.toFinNDTM_State : ∀ (M : Turing.CodeNDTM), M.toFinNDTM.State = Fin (M.numStates + 1)
Turing.CodeNDTM.toFinNDTM_tm : ∀ (M : Turing.CodeNDTM), M.toFinNDTM.tm = M.tm
@Turing.NDTM.replayTM_runFrom : ∀ {k : ℕ} {S : Type u_1} {x : List Bool} (N : Turing.NDTM k Bool S)
  (c : Turing.Cfg k Bool S x) (s : List Bool),
  ∀ t ≤ s.length,
    ∃ p ≤ t,
      ((Turing.NDTM.runWith (List.take t s) c).state ≠ none → p = t) ∧
        Turing.MultiTapeTM.runFrom (Turing.NDTM.withChoiceTape c (Turing.FinTM.bufferTape s) 0) t =
          Turing.NDTM.withChoiceTape (Turing.NDTM.runWith (List.take t s) c) (Turing.FinTM.bufferTape s) ↑p
@Turing.NDTM.replayTM_q₀ : ∀ {k : ℕ} {S : Type u_1} (N : Turing.NDTM k Bool S), N.replayTM.q₀ = N.q₀
@Turing.NDTM.replayTM_tr : ∀ {k : ℕ} {S : Type u_1} (N : Turing.NDTM k Bool S) (q : S) (inp : Option Bool)
  (w : Fin (k + 1) → Option Bool),
  N.replayTM.tr q inp w =
    have a := N.tr ((w (Fin.last k)).getD false) q inp fun i => w i.castSucc;
    { inputTape := a.inputTape, workTapes := fun i => Fin.lastCases (none, 1) a.workTapes i, output := a.output,
      state := a.state }
@Turing.NDTM.withChoiceTape_state : ∀ {k : ℕ} {S : Type u_1} {x : List Bool} (c : Turing.Cfg k Bool S x)
  (ct : ℤ → Option Bool) (cp : ℤ), (Turing.NDTM.withChoiceTape c ct cp).state = c.state
@Turing.NDTM.withChoiceTape_inputPos : ∀ {k : ℕ} {S : Type u_1} {x : List Bool} (c : Turing.Cfg k Bool S x)
  (ct : ℤ → Option Bool) (cp : ℤ), (Turing.NDTM.withChoiceTape c ct cp).inputPos = c.inputPos
@Turing.NDTM.withChoiceTape_workTapes : ∀ {k : ℕ} {S : Type u_1} {x : List Bool} (c : Turing.Cfg k Bool S x)
  (ct : ℤ → Option Bool) (cp : ℤ) (i : Fin (k + 1)) (a : ℤ),
  (Turing.NDTM.withChoiceTape c ct cp).workTapes i a =
    Fin.lastCases (motive := fun x => ℤ → Option Bool) ct c.workTapes i a
@Turing.NDTM.withChoiceTape_workTapePos : ∀ {k : ℕ} {S : Type u_1} {x : List Bool} (c : Turing.Cfg k Bool S x)
  (ct : ℤ → Option Bool) (cp : ℤ) (i : Fin (k + 1)),
  (Turing.NDTM.withChoiceTape c ct cp).workTapePos i = Fin.lastCases cp c.workTapePos i
@Turing.NDTM.withChoiceTape_output : ∀ {k : ℕ} {S : Type u_1} {x : List Bool} (c : Turing.Cfg k Bool S x)
  (ct : ℤ → Option Bool) (cp : ℤ), (Turing.NDTM.withChoiceTape c ct cp).output = c.output
@Turing.NDTM.runWith_initCfg_take : ∀ {k : ℕ} {Γ : Type u_1} {S : Type u_2} (tm : Turing.NDTM k Γ S) (x : List Γ)
  (m : ℕ) (w : List Bool),
  w.length ≤ m →
    have c := Turing.NDTM.runWith w (Turing.NDTM.initCfg x);
    have c' := Turing.NDTM.runWith w (Turing.NDTM.initCfg (List.take m x));
    c'.state = c.state ∧
      ↑c'.inputPos = ↑c.inputPos ∧ c'.workTapes = c.workTapes ∧ c'.workTapePos = c.workTapePos ∧ c'.output = c.output
@Turing.NDTM.initCfg_eq : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {tm : Turing.NDTM k Symbol State}
  (input : List Symbol), Turing.NDTM.initCfg input = Turing.Cfg.init tm.q₀ input
@Turing.Cfg.init_state : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} (q₀ : State) (input : List Symbol),
  (Turing.Cfg.init q₀ input).state = some q₀
@Turing.Cfg.init_inputPos : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} (q₀ : State) (input : List Symbol),
  (Turing.Cfg.init q₀ input).inputPos = 1
@Turing.Cfg.init_workTapes : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} (q₀ : State) (input : List Symbol)
  (x : Fin k) (x_1 : ℤ), (Turing.Cfg.init q₀ input).workTapes x x_1 = none
@Turing.Cfg.init_workTapePos : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} (q₀ : State) (input : List Symbol)
  (x : Fin k), (Turing.Cfg.init q₀ input).workTapePos x = 0
@Turing.Cfg.init_output : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} (q₀ : State) (input : List Symbol),
  (Turing.Cfg.init q₀ input).output = []
@Turing.seamCompTM_run_ofCfg : ∀ {k : ℕ} {S₁ : Type u_1} {S₂ : Type u_2} {Symbol : Type u_3} {x : List Symbol}
  [inst : DecidableEq S₁] (M₁ : Turing.MultiTapeTM k Symbol S₁) (exit : S₁) (M₂ : Turing.MultiTapeTM k Symbol S₂)
  (entry : S₂) {c₀ c₁ : Turing.Cfg k Symbol S₁ x} {c₃ : Turing.Cfg k Symbol S₂ x} {T₁ T₂ : ℕ},
  Turing.MultiTapeTM.runFrom c₀ T₁ = c₁ →
    c₁.state = some exit →
      (∀ t < T₁, (Turing.MultiTapeTM.runFrom c₀ t).state ≠ some exit) →
        Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState (fun x => entry) c₁) T₂ = c₃ →
          Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState Sum.inl c₀) (T₁ + 1 + T₂) = Turing.Cfg.mapState Sum.inr c₃
@Turing.seamReleaseTM_firstReturn : ∀ {k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol}
  (M : Turing.MultiTapeTM k Symbol S) (anchor : S) {c c' : Turing.Cfg k Symbol S x} {T : ℕ},
  c.state = some anchor →
    0 < T →
      Turing.MultiTapeTM.runFrom c T = c' →
        c'.state = some anchor →
          (∀ (t : ℕ), 0 < t → t < T → (Turing.MultiTapeTM.runFrom c t).state ≠ some anchor) →
            Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState (fun x => Sum.inl ()) c) T =
                Turing.Cfg.mapState Sum.inr c' ∧
              ∀ t < T,
                (Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState (fun x => Sum.inl ()) c) t).state ≠
                  some (Sum.inr anchor)
@Turing.phaseHostTM_run : ∀ {k : ℕ} {Γ I : Type} {Ph : I → Type} (M : (i : I) → Turing.MultiTapeTM k Γ (Ph i))
  (q0 : (i : I) × Ph i) (red : (i : I) → Ph i → Option ((i : I) × Ph i)) (i : I) {x : List Γ}
  (c c' : Turing.Cfg k Γ (Ph i) x) (T : ℕ),
  Turing.MultiTapeTM.runFrom c T = c' →
    ∀ (s' : Ph i),
      c'.state = some s' →
        ∀ (q' : (i : I) × Ph i),
          red i s' = some q' →
            (∀ u < T, ∀ (s : Ph i), (Turing.MultiTapeTM.runFrom c u).state = some s → red i s = none) →
              (∀ u ≤ T,
                  Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState (Sigma.mk i) c) u =
                    Turing.Cfg.mapState (Sigma.mk i) (Turing.MultiTapeTM.runFrom c u)) ∧
                Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState (Sigma.mk i) c) (T + 1) =
                  Turing.Cfg.mapState (fun x => q') c'
@Turing.embedSilentTM : {m k : ℕ} →
  {S : Type u_1} →
    {Symbol : Type u_2} → (Fin m ↪ Fin k) → Fin k → Turing.MultiTapeTM m Symbol S → Turing.MultiTapeTM k Symbol S
@Turing.embedSilentTM_runFrom : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol} (ι : Fin m ↪ Fin k),
  ∀ cap ∉ Set.range ⇑ι,
    ∀ (M : Turing.MultiTapeTM m Symbol S) (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ)
      (pre out₀ : List Symbol) (c : Turing.Cfg m Symbol S x) (t : ℕ),
      Turing.MultiTapeTM.runFrom (Turing.embedSilentCfg ι cap tapes heads pre out₀ c) t =
        Turing.embedSilentCfg ι cap tapes heads pre out₀ (Turing.MultiTapeTM.runFrom c t)
@Turing.embedSilentTM_frame : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol} (ι : Fin m ↪ Fin k),
  ∀ cap ∉ Set.range ⇑ι,
    ∀ (M : Turing.MultiTapeTM m Symbol S) (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ)
      (pre out₀ : List Symbol) (c : Turing.Cfg m Symbol S x) (t : ℕ),
      (∀ j ∉ Set.range ⇑ι,
          j ≠ cap →
