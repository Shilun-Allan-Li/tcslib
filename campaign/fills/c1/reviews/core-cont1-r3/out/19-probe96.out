Turing.length_bits_le_self : ∀ (m : ℕ), m.bits.length ≤ m
Turing.counterValue_eq : ∀ (w : List Bool), Turing.counterValue w = Nat.ofDigits 2 (List.map Bool.toNat w)
Turing.codeBitsNat_eq : ∀ (xs : List Bool), Turing.codeBitsNat xs = List.foldr Nat.bit 0 xs
Turing.exists_seamLayoutTM : ∀ (k : ℕ) (src tbl sm : Fin k),
  src ≠ tbl →
    src ≠ sm →
      tbl ≠ sm →
        ∃ Q x x L entry done C,
          ∀ (a v : List Bool) (q r : ℕ),
            have s := Turing.pairEncode a (List.replicate q true ++ [false] ++ v);
            r ≤ s.length →
              ∃ T ≤ C * (s.length + 1),
                ∀ {z : List Bool} (d : Turing.Cfg k Bool Q z),
                  d.state = some entry →
                    d.workTapes src = Turing.FinTM.bufferTape s →
                      d.workTapePos src = ↑r →
                        (d.workTapes tbl = fun x => none) →
                          d.workTapePos tbl = 0 →
                            (d.workTapes sm = fun x => none) →
                              d.workTapePos sm = 0 →
                                (Turing.MultiTapeTM.runFrom d T).state = some done ∧
                                  (Turing.MultiTapeTM.runFrom d T).inputPos = d.inputPos ∧
                                    ((Turing.MultiTapeTM.runFrom d T).workTapes =
                                        Function.update
                                          (Function.update (Function.update d.workTapes src fun x => none) tbl
                                            (Turing.FinTM.bufferTape v))
                                          sm fun p =>
                                          Turing.FinTM.bufferTape (List.replicate q true ++ [false]) (p - 2)) ∧
                                      (Turing.MultiTapeTM.runFrom d T).workTapePos =
                                          Function.update (Function.update (Function.update d.workTapePos src 0) tbl 0)
                                            sm 0 ∧
                                        (∀ u ≤ T, (Turing.MultiTapeTM.runFrom d u).output = d.output) ∧
                                          ∀ u < T, (Turing.MultiTapeTM.runFrom d u).state ≠ some done
