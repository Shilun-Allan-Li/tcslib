      (ℓ : ℕ) →
        z.length = ℓ + y.length → Option Q → Turing.Cfg m Bool S y → (ℤ → Option Bool) → ℤ → Turing.Cfg (m + 1) Bool Q z
@Turing.inputCell : {Γ : Type u_1} → List Γ → ℕ → Option Γ
@Turing.inputCell_sub_eq_none_iff : ∀ {z : List Bool} {ℓ p : ℕ},
  0 < ℓ → ℓ ≤ p → p ≤ z.length + 1 → (Turing.inputCell z (p - ℓ) = none ↔ p = ℓ)
@Turing.inputCell_of_drop : ∀ {z y : List Bool} {ℓ : ℕ},
  List.drop ℓ z = y → ∀ {i : ℕ}, i ≠ 0 → Turing.inputCell y i = Turing.inputCell z (ℓ + i)
@Turing.Cfg.inputSymbol_eq_inputCell : ∀ {k : ℕ} {Γ : Type u_1} {S : Type u_2} {y : List Γ} (c : Turing.Cfg k Γ S y),
  c.inputSymbol = Turing.inputCell y ↑c.inputPos
@Turing.NativeAt : {K : ℕ} →
  {Γ : Type u_1} → {S : Type u_2} → {y : List Γ} → Turing.Cfg K Γ S y → Fin (y.length + 2) → Prop
@Turing.moveInputPos : {n : ℕ} → Fin (n + 2) → SignType → Fin (n + 2)
@Turing.Lockstep : {k : ℕ} →
  {Γ : Type} →
    {k' : ℕ} →
      {Γ' S S' : Type} →
        {x : List Γ} →
          {x' : List Γ'} →
            Turing.MultiTapeTM k Γ S →
              Turing.MultiTapeTM k' Γ' S' →
                (Turing.Cfg k Γ S x → Turing.Cfg k' Γ' S' x') →
                  (Turing.Cfg k Γ S x → ℕ) → Set (Option S) → Set (Option S') → Prop
@Turing.Lockstep.runFrom : ∀ {k : ℕ} {Γ : Type} {k' : ℕ} {Γ' S S' : Type} {x : List Γ} {x' : List Γ'}
  {M : Turing.MultiTapeTM k Γ S} {N : Turing.MultiTapeTM k' Γ' S'} {enc : Turing.Cfg k Γ S x → Turing.Cfg k' Γ' S' x'}
  {cost : Turing.Cfg k Γ S x → ℕ} {X : Set (Option S)} {X' : Set (Option S')},
  Turing.Lockstep M N enc cost X X' →
    ∀ (d : Turing.Cfg k Γ S x) (t : ℕ),
      (∀ u < t, (Turing.MultiTapeTM.runFrom d u).state ∉ X) →
        Turing.MultiTapeTM.runFrom (enc d) (∑ u ∈ Finset.range t, cost (Turing.MultiTapeTM.runFrom d u)) =
          enc (Turing.MultiTapeTM.runFrom d t)
@Turing.Lockstep.cut : ∀ {k : ℕ} {Γ : Type} {k' : ℕ} {Γ' S S' : Type} {x : List Γ} {x' : List Γ'}
  {M : Turing.MultiTapeTM k Γ S} {N : Turing.MultiTapeTM k' Γ' S'} {enc : Turing.Cfg k Γ S x → Turing.Cfg k' Γ' S' x'}
  {cost : Turing.Cfg k Γ S x → ℕ} {X : Set (Option S)} {X' : Set (Option S')},
  Turing.Lockstep M N enc cost X X' →
    ∀ (d : Turing.Cfg k Γ S x) (t : ℕ),
      (∀ u < t, (Turing.MultiTapeTM.runFrom d u).state ∉ X) →
        ∀ v < ∑ u ∈ Finset.range t, cost (Turing.MultiTapeTM.runFrom d u),
          (Turing.MultiTapeTM.runFrom (enc d) v).state ∉ X'
@Turing.Lockstep.locate : ∀ {k : ℕ} {Γ : Type} {k' : ℕ} {Γ' S S' : Type} {x : List Γ} {x' : List Γ'}
  {M : Turing.MultiTapeTM k Γ S} {N : Turing.MultiTapeTM k' Γ' S'} {enc : Turing.Cfg k Γ S x → Turing.Cfg k' Γ' S' x'}
  {cost : Turing.Cfg k Γ S x → ℕ} {X : Set (Option S)} {X' : Set (Option S')},
  Turing.Lockstep M N enc cost X X' →
    ∀ (d : Turing.Cfg k Γ S x) (t : ℕ),
      (∀ u < t, (Turing.MultiTapeTM.runFrom d u).state ∉ X) →
        ∀ v ≤ ∑ u ∈ Finset.range t, cost (Turing.MultiTapeTM.runFrom d u),
          ∃ u ≤ t,
            ∃ w,
              (w = 0 ∨ (Turing.MultiTapeTM.runFrom d u).state ∉ X ∧ w ≤ cost (Turing.MultiTapeTM.runFrom d u)) ∧
                Turing.MultiTapeTM.runFrom (enc d) v =
                  Turing.MultiTapeTM.runFrom (enc (Turing.MultiTapeTM.runFrom d u)) w
@Turing.MultiTapeTM.runFrom_add : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  {tm : Turing.MultiTapeTM k Symbol State} (cfg : Turing.Cfg k Symbol State input) (a b : ℕ),
  Turing.MultiTapeTM.runFrom cfg (a + b) = Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.runFrom cfg a) b
@Turing.MultiTapeTM.runFrom_succ_eq_step' : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  {tm : Turing.MultiTapeTM k Symbol State} {cfg : Turing.Cfg k Symbol State input} {t : ℕ},
