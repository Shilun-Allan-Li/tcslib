Turing.exists_rulerTestTM : ∃ P x x R entry yes no C,
  yes ≠ no ∧
    ∀ {z : List Bool} (ℓ : ℕ) (d : Turing.Cfg 1 Bool P z),
      d.state = some entry →
        0 < ℓ →
          ℓ ≤ ↑d.inputPos →
            (∀ (p : ℤ),
                -1 ≤ p →
                  p ≤ ↑ℓ → d.workTapes 0 (d.workTapePos 0 + p) = Turing.FinTM.bufferTape (List.replicate ℓ true) p) →
              ∃ t ≤ C * (ℓ + 1),
                (∀ u < t,
                    (Turing.MultiTapeTM.runFrom d u).state ≠ some yes ∧
                      (Turing.MultiTapeTM.runFrom d u).state ≠ some no) ∧
                  (∀ u ≤ t, |(Turing.MultiTapeTM.runFrom d u).workTapePos 0 - d.workTapePos 0| ≤ ↑(ℓ + 1)) ∧
                    Turing.MultiTapeTM.runFrom d t =
                      { state := some (if ↑d.inputPos = ℓ then yes else no), inputPos := d.inputPos,
                        workTapes := d.workTapes, workTapePos := d.workTapePos, output := d.output }
Turing.exists_rulerDeviceTM : ∃ P x x R readEntry readExit moveEntry moveExit C,
  Function.Injective readExit ∧
    (∀ (v : Option Bool), readExit v ≠ moveExit) ∧
      ∀ {y z : List Bool} (ℓ : ℕ) (d : Turing.Cfg 1 Bool P z) (i : Fin (y.length + 2)),
        Turing.RulerAt ℓ 0 d i →
          (d.state = some readEntry →
              ∃ t ≤ C * (ℓ + 1),
                (∀ u < t, ∀ (v : Option Bool), (Turing.MultiTapeTM.runFrom d u).state ≠ some (readExit v)) ∧
                  (∀ u ≤ t, |(Turing.MultiTapeTM.runFrom d u).workTapePos 0 - d.workTapePos 0| ≤ ↑(ℓ + 1)) ∧
                    Turing.MultiTapeTM.runFrom d t =
                      { state := some (readExit (Turing.inputCell y ↑i)), inputPos := d.inputPos,
                        workTapes := d.workTapes, workTapePos := d.workTapePos, output := d.output }) ∧
            ∀ (m : SignType),
              d.state = some (moveEntry m) →
                ∃ t ≤ C * (ℓ + 1),
                  (∀ u < t, (Turing.MultiTapeTM.runFrom d u).state ≠ some moveExit) ∧
                    (∀ u ≤ t, |(Turing.MultiTapeTM.runFrom d u).workTapePos 0 - d.workTapePos 0| ≤ ↑(ℓ + 1)) ∧
                      (Turing.MultiTapeTM.runFrom d t).state = some moveExit ∧
                        ↑(Turing.MultiTapeTM.runFrom d t).inputPos = ℓ + ↑(Turing.moveInputPos i m) ∧
                          (Turing.MultiTapeTM.runFrom d t).workTapes = d.workTapes ∧
                            (Turing.MultiTapeTM.runFrom d t).workTapePos = d.workTapePos ∧
                              (Turing.MultiTapeTM.runFrom d t).output = d.output
@Turing.exists_rulerHostTM : ∀ {m : ℕ} {S : Type} [Fintype S] [DecidableEq S] (M : Turing.MultiTapeTM m Bool S),
  ∃ Q x x H inj C,
    0 < C ∧
      ∀ {y z : List Bool} (ℓ : ℕ) (hz : z.length = ℓ + y.length),
        0 < ℓ →
          List.drop ℓ z = y →
            ∀ (rt : ℤ → Option Bool) (rp : ℤ),
              (∀ (p : ℤ), -1 ≤ p → p ≤ ↑ℓ → rt (rp + p) = Turing.FinTM.bufferTape (List.replicate ℓ true) p) →
                ∀ (c : Turing.Cfg m Bool S y) (b : Bool),
                  (b = true ↔ ↑c.inputPos = 0) →
                    ∀ (t : ℕ),
                      have d := Turing.rulerHostCfg ℓ hz (Option.map (fun q => inj q b) c.state) c rt rp;
                      ∃ t',
                        t ≤ t' ∧
                          t' ≤ C * (ℓ + 1) * t ∧
                            (∃ b',
                                (b' = true ↔ ↑(Turing.MultiTapeTM.runFrom c t).inputPos = 0) ∧
                                  Turing.MultiTapeTM.runFrom d t' =
                                    Turing.rulerHostCfg ℓ hz
                                      (Option.map (fun q => inj q b') (Turing.MultiTapeTM.runFrom c t).state)
                                      (Turing.MultiTapeTM.runFrom c t) rt rp) ∧
                              ((∀ u < t, (Turing.MultiTapeTM.runFrom c u).state ≠ none) →
                                  ∀ u < t', (Turing.MultiTapeTM.runFrom d u).state ≠ none) ∧
                                (∀ u ≤ t',
                                    ∃ v ≤ t,
                                      (∀ (i : Fin m),
                                          (Turing.MultiTapeTM.runFrom d u).workTapes i.castSucc =
                                              (Turing.MultiTapeTM.runFrom c v).workTapes i ∧
                                            (Turing.MultiTapeTM.runFrom d u).workTapePos i.castSucc =
                                              (Turing.MultiTapeTM.runFrom c v).workTapePos i) ∧
                                        (Turing.MultiTapeTM.runFrom d u).output =
                                            (Turing.MultiTapeTM.runFrom c v).output ∧
                                          (Turing.MultiTapeTM.runFrom d u).workTapes (Fin.last m) = rt ∧
                                            (Turing.MultiTapeTM.runFrom d u).workTapePos (Fin.last m) ∈
                                              Finset.Icc (rp - 1) (rp + ↑ℓ)) ∧
                                  (∀ (i : Fin m),
                                      Turing.MultiTapeTM.visitedByTapeHead d t' i.castSucc =
                                        Turing.MultiTapeTM.visitedByTapeHead c t i) ∧
                                    Turing.MultiTapeTM.visitedByTapeHead d t' (Fin.last m) ⊆
                                      Finset.Icc (rp - 1) (rp + ↑ℓ)
