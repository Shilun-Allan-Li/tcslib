@Turing.FinTM.VirtualTag_iff : ∀ {n : ℕ} (p : Fin (n + 2)) (b : Bool),
  Turing.FinTM.VirtualTag p b ↔ (↑p = 0 → b = false) ∧ (↑p = n + 1 → b = true)
Turing.vhostBuffer_eq : ∀ (m : ℕ), Turing.vhostBuffer m = Fin.castAdd m 0
@Turing.vhostBank_eq : ∀ {m : ℕ} (i : Fin m), Turing.vhostBank i = Fin.natAdd 1 i
@Turing.Action.mapState_inputTape : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {State' : Type u_3}
  (f : State → State') (a : Turing.Action k Symbol State), (Turing.Action.mapState f a).inputTape = a.inputTape
@Turing.Action.mapState_workTapes : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {State' : Type u_3}
  (f : State → State') (a : Turing.Action k Symbol State) (a_1 : Fin k),
  (Turing.Action.mapState f a).workTapes a_1 = a.workTapes a_1
@Turing.Action.mapState_output : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {State' : Type u_3}
  (f : State → State') (a : Turing.Action k Symbol State), (Turing.Action.mapState f a).output = a.output
@Turing.Action.mapState_state : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {State' : Type u_3}
  (f : State → State') (a : Turing.Action k Symbol State), (Turing.Action.mapState f a).state = Option.map f a.state
@Turing.Cfg.mapState_state : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {State' : Type u_3} {input : List Symbol}
  (f : State → State') (cfg : Turing.Cfg k Symbol State input),
  (Turing.Cfg.mapState f cfg).state = Option.map f cfg.state
@Turing.Cfg.mapState_inputPos : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {State' : Type u_3}
  {input : List Symbol} (f : State → State') (cfg : Turing.Cfg k Symbol State input),
  (Turing.Cfg.mapState f cfg).inputPos = cfg.inputPos
@Turing.Cfg.mapState_workTapes : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {State' : Type u_3}
  {input : List Symbol} (f : State → State') (cfg : Turing.Cfg k Symbol State input) (a : Fin k) (a_1 : ℤ),
  (Turing.Cfg.mapState f cfg).workTapes a a_1 = cfg.workTapes a a_1
@Turing.Cfg.mapState_workTapePos : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {State' : Type u_3}
  {input : List Symbol} (f : State → State') (cfg : Turing.Cfg k Symbol State input) (a : Fin k),
  (Turing.Cfg.mapState f cfg).workTapePos a = cfg.workTapePos a
@Turing.Cfg.mapState_output : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {State' : Type u_3} {input : List Symbol}
  (f : State → State') (cfg : Turing.Cfg k Symbol State input), (Turing.Cfg.mapState f cfg).output = cfg.output
@Turing.Action.apply_state : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  (action : Turing.Action k Symbol State) (cfg : Turing.Cfg k Symbol State input),
  (action.apply cfg).state = action.state
@Turing.Action.apply_inputPos : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  (action : Turing.Action k Symbol State) (cfg : Turing.Cfg k Symbol State input),
  (action.apply cfg).inputPos = Turing.moveInputPos cfg.inputPos action.inputTape
@Turing.Action.apply_workTapePos : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  (action : Turing.Action k Symbol State) (cfg : Turing.Cfg k Symbol State input) (i : Fin k),
  (action.apply cfg).workTapePos i = cfg.workTapePos i + ↑(action.workTapes i).2
@Turing.Action.apply_output : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  (action : Turing.Action k Symbol State) (cfg : Turing.Cfg k Symbol State input),
  (action.apply cfg).output = cfg.output ++ action.output.toList
@Turing.MultiTapeTM.step_of_some : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  {tm : Turing.MultiTapeTM k Symbol State} {cfg : Turing.Cfg k Symbol State input} {q : State},
  cfg.state = some q → Turing.MultiTapeTM.step cfg = (tm.tr q cfg.inputSymbol cfg.workTapeSymbols).apply cfg
@Turing.MultiTapeTM.outputSymbol_of_some : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  {tm : Turing.MultiTapeTM k Symbol State} {cfg : Turing.Cfg k Symbol State input} {q : State},
  cfg.state = some q → Turing.MultiTapeTM.outputSymbol cfg = (tm.tr q cfg.inputSymbol cfg.workTapeSymbols).output
@Turing.Action.apply : {k : ℕ} →
  {State : Type u_1} →
    {Symbol : Type u_2} →
      {input : List Symbol} →
        Turing.Action k Symbol State → Turing.Cfg k Symbol State input → Turing.Cfg k Symbol State input
@Turing.Action.apply_workTapes : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {input : List Symbol}
  (a : Turing.Action k Symbol State) (c : Turing.Cfg k Symbol State input) (i : Fin k),
  (a.apply c).workTapes i =
    Function.update (c.workTapes i) (c.workTapePos i) ((a.workTapes i).1.getD (c.workTapeSymbols i))
@Turing.Cfg.ext : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {input : List Symbol}
  {x y : Turing.Cfg k Symbol State input},
  x.state = y.state →
    x.inputPos = y.inputPos → x.workTapes = y.workTapes → x.workTapePos = y.workTapePos → x.output = y.output → x = y
@Turing.Cfg.workTapeSymbols_eq : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  (cfg : Turing.Cfg k Symbol State input) (i : Fin k), cfg.workTapeSymbols i = cfg.workTapes i (cfg.workTapePos i)
@Turing.Cfg.inputSymbol : {k : ℕ} →
  {State : Type u_1} → {Symbol : Type u_2} → {input : List Symbol} → Turing.Cfg k Symbol State input → Option Symbol
@Turing.Cfg.workTapeSymbols : {k : ℕ} →
  {State : Type u_1} →
    {Symbol : Type u_2} → {input : List Symbol} → Turing.Cfg k Symbol State input → Fin k → Option Symbol
@Turing.FinTM.bufferTape : {Symbol : Type u_1} → List Symbol → ℤ → Option Symbol
@Turing.FinTM.bufferTape_left : ∀ {Symbol : Type u_1} (w : List Symbol), Turing.FinTM.bufferTape w (-1) = none
@Turing.FinTM.bufferTape_nat : ∀ {Symbol : Type u_1} (w : List Symbol) (i : ℕ), Turing.FinTM.bufferTape w ↑i = w[i]?
@Turing.MultiTapeTM.runFrom : {k : ℕ} →
  {State : Type u_1} →
    {Symbol : Type u_2} →
      {input : List Symbol} →
        {tm : Turing.MultiTapeTM k Symbol State} → Turing.Cfg k Symbol State input → ℕ → Turing.Cfg k Symbol State input
@Turing.MultiTapeTM.runFrom_zero : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  {tm : Turing.MultiTapeTM k Symbol State} {cfg : Turing.Cfg k Symbol State input},
  Turing.MultiTapeTM.runFrom cfg 0 = cfg
@Turing.MultiTapeTM.step : {k : ℕ} →
  {State : Type u_1} →
    {Symbol : Type u_2} →
      {input : List Symbol} →
        {tm : Turing.MultiTapeTM k Symbol State} → Turing.Cfg k Symbol State input → Turing.Cfg k Symbol State input
@Turing.inputSymbolInner : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  {cfg : Turing.Cfg k Symbol State input} (p : ℕ),
  ↑cfg.inputPos = 1 + p → ∀ (h₂ : p < input.length), cfg.inputSymbol = some input[p]
@Turing.moveInputPos_neg_of_ne_left : ∀ {n : ℕ} (p : Fin (n + 2)),
  p ≠ 0 → Turing.moveInputPos p SignType.neg = ⟨↑p - 1, ⋯⟩
@Turing.moveInputPos_pos_of_ne_right : ∀ {n : ℕ} (p : Fin (n + 2)) (h : ↑p ≠ n + 1),
  Turing.moveInputPos p SignType.pos = ⟨↑p + 1, ⋯⟩
@Turing.moveInputPos_zero : ∀ {n : ℕ} (pos : Fin (n + 2)), Turing.moveInputPos pos 0 = pos
@Bool.eq_iff_iff : ∀ {a b : Bool}, a = b ↔ (a = true ↔ b = true)
Bool.false_ne_true : false ≠ true
@Fin.ext : ∀ {n : ℕ} {a b : Fin n}, ↑a = ↑b → a = b
Fin.val_zero : ∀ (n : ℕ) [inst : NeZero n], ↑0 = 0
@Function.update_eq_self : ∀ {α : Sort u_1} {β : α → Sort u_2} [inst : DecidableEq α] (a : α) (f : (a : α) → β a),
  Function.update f a (f a) = f
@List.append_nil : ∀ {α : Type u_1} (as : List α), as ++ [] = as
@List.getElem?_replicate : ∀ {n : ℕ} {α : Type u_1} {a : α} {i : ℕ},
  (List.replicate n a)[i]? = if i < n then some a else none
@Nat.cast_zero : ∀ {R : Type u_1} [inst : AddMonoidWithOne R], ↑0 = 0
Nat.sub_self : ∀ (n : ℕ), n - n = 0
Nat.sub_zero : ∀ (n : ℕ), n - 0 = n
Nat.zero_le : ∀ (n : ℕ), 0 ≤ n
@Option.getD_none : ∀ {α : Type u_1} {a : α}, none.getD a = a
@Option.isNone_iff_eq_none : ∀ {α : Type u_1} {o : Option α}, o.isNone = true ↔ o = none
@Option.some.inj : ∀ {α : Type u_1} {val val_1 : α}, some val = some val_1 → val = val_1
Option.toList_none : ∀ (α : Type u_1), none.toList = []
@SignType.coe_neg_one : ∀ {α : Type u_1} [inst : Zero α] [inst_1 : One α] [inst_2 : Neg α], ↑(-1) = -1
@SignType.coe_one : ∀ {α : Type u_1} [inst : Zero α] [inst_1 : One α] [inst_2 : Neg α], ↑1 = 1
SignType.neg_eq_neg_one : SignType.neg = -1
SignType.pos_eq_one : SignType.pos = 1
@Sum.inr.inj : ∀ {α : Type u_1} {β : Type u_2} {val val_1 : β}, Sum.inr val = Sum.inr val_1 → val = val_1
@abs_le : ∀ {G : Type u_1} [inst : AddCommGroup G] [inst_1 : LinearOrder G] [IsOrderedAddMonoid G] {a b : G},
  |a| ≤ b ↔ -b ≤ a ∧ a ≤ b
@abs_zero : ∀ {α : Type u_1} [inst : Lattice α] [inst_1 : AddGroup α] [AddLeftMono α], |0| = 0
@add_assoc : ∀ {G : Type u_1} [inst : AddSemigroup G] (a b c : G), a + b + c = a + (b + c)
@add_sub_cancel_left : ∀ {G : Type u_1} [inst : AddCommGroup G] (a b : G), a + b - a = b
@add_zero : ∀ {M : Type u_1} [inst : AddZeroClass M] (a : M), a + 0 = a
@decide_eq_true_eq : ∀ {p : Prop} [inst : Decidable p], (decide p = true) = p
decide_false : ∀ (h : Decidable False), decide False = false
decide_true : ∀ (h : Decidable True), decide True = true
@if_false : ∀ {α : Sort u_1} {x : Decidable False} (t e : α), (if False then t else e) = e
@if_neg : ∀ {c : Prop} {h : Decidable c}, ¬c → ∀ {α : Sort u_1} {t e : α}, (if c then t else e) = e
@if_pos : ∀ {c : Prop} {h : Decidable c}, c → ∀ {α : Sort u_1} {t e : α}, (if c then t else e) = t
@if_true : ∀ {α : Sort u_1} {x : Decidable True} (t e : α), (if True then t else e) = t
@le_refl : ∀ {α : Type u_1} [inst : Preorder α] (a : α), a ≤ a
@le_rfl : ∀ {α : Type u_1} [inst : Preorder α] {a : α}, a ≤ a
@lt_self_iff_false : ∀ {α : Type u_1} [inst : Preorder α] (x : α), x < x ↔ False
@sub_self : ∀ {G : Type u_1} [inst : AddGroup G] (a : G), a - a = 0
@zero_sub : ∀ {G : Type u_1} [inst : SubNegMonoid G] (a : G), 0 - a = -a
exit 0
