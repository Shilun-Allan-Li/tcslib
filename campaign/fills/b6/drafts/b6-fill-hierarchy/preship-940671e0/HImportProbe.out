space_hierarchy : ∀ (f g : ℕ → ℕ),
  SpaceConstructible f → SpaceConstructible g → (∀ (A : ℕ), ∃ N, ∀ n ≥ N, A * f n ≤ g n) → SPACE f ⊂ SPACE g
LOGSPACE_ssubset_PSPACE : LOGSPACE ⊂ PSPACE
SPACE_linear_ne_NP : (SPACE fun n => n + 1) ≠ NP
SPACE : (ℕ → ℕ) → Set (Language Bool)
@mem_SPACE_iff : ∀ {s : ℕ → ℕ} {L : Language Bool}, L ∈ SPACE s ↔ ∃ c M, M.DecidesInSpace L fun n => c * s n
@SPACE.mono : ∀ {s₁ s₂ : ℕ → ℕ}, (∀ (n : ℕ), s₁ n ≤ s₂ n) → SPACE s₁ ⊆ SPACE s₂
@SPACE.mono_const : ∀ {s₁ s₂ : ℕ → ℕ} {a : ℕ}, (∀ (n : ℕ), s₁ n ≤ a * s₂ n) → SPACE s₁ ⊆ SPACE s₂
FinTM.DecidesInSpace : FinTM Bool → Language Bool → (ℕ → ℕ) → Prop
FinTM.decidesInSpace_iff : ∀ (M : FinTM Bool) (L : Language Bool) (s : ℕ → ℕ),
  M.DecidesInSpace L s ↔ M.ComputesInSpace (fun x => [MultiTapeTM.indicator L x]) s
FinTM.ComputesInSpace : FinTM Bool → (List Bool → List Bool) → (ℕ → ℕ) → Prop
FinTM.computesInSpace_iff : ∀ (M : FinTM Bool) (f : List Bool → List Bool) (s : ℕ → ℕ),
  M.ComputesInSpace f s ↔
    ∀ (x : List Bool), ∃ t, M.ComputesInTime x (f x) t ∧ MultiTapeTM.spaceUsed (MultiTapeTM.initCfg x) t ≤ s x.length
SpaceConstructible : (ℕ → ℕ) → Prop
spaceConstructible_iff : ∀ (S : ℕ → ℕ),
  SpaceConstructible S ↔
    (∀ (n : ℕ), logSpace n ≤ S n) ∧ ∃ c, 0 < c ∧ ∃ M, M.ComputesInSpace (fun x => (S x.length).bits) fun n => c * S n
spaceConstructible_logSpace : SpaceConstructible logSpace
spaceConstructible_linear : SpaceConstructible fun n => n + 1
logSpace : ℕ → ℕ
logSpace_eq : ∀ (n : ℕ), logSpace n = Nat.log 2 n + 1
LOGSPACE : Set (Language Bool)
LOGSPACE_eq : LOGSPACE = SPACE logSpace
PSPACE : Set (Language Bool)
space_poly_subset_PSPACE : ∀ (c : ℕ), (SPACE fun n => n ^ c + 1) ⊆ PSPACE
exists_selfUniversal : ∀ (c : EffectiveMachineCode),
  ∃ U₀,
    ∀ (α : List Bool),
      ∃ C,
        0 < C ∧
          ∀ (w output : List Bool) (t s : ℕ),
            (c.decode α).toFinTM.ComputesInTime (pairEncode α w) output t →
              MultiTapeTM.spaceUsed (MultiTapeTM.initCfg (pairEncode α w)) t ≤ s →
                ∃ t',
                  U₀.ComputesInTime (pairEncode α w) output t' ∧
                    MultiTapeTM.spaceUsed (MultiTapeTM.initCfg (pairEncode α w)) t' ≤ C * (s + 1)
TimeHierarchy.code : EffectiveMachineCode
exists_configWindowRunnerTM : ∀ (M : FinTM Bool) {T : Type} [Fintype T] [DecidableEq T] (upd : T → Option Bool → T),
  (∀ (τ : T), upd τ none = τ) →
    ∃ K P x x R entry exit C,
      (∀ (e : WindowExit), exit e ≠ entry) ∧
        Function.Injective exit ∧
          ∀ {x : List Bool} (s : ℕ) (c : Cfg M.k Bool M.State x) (τ : T),
            Cfg.InWindow s c →
              ∀ (d : Cfg (K + 1) (RecSym M.State T) P (List.map (⇑(RecSym.digitEmb M.State T)) x)),
                d.state = some entry →
                  RecordAt d 0 (cfgRecord s c τ) →
                    (∀ (j : Fin (K + 1)), j ≠ 0 → ∀ (p : ℤ), d.workTapes j p = none) →
                      ∃ t out,
                        t ≤ C * 2 ^ (C * (recordLength M.k x.length s + 1)) ∧
                          (MultiTapeTM.runFrom d t).state = some (exit out) ∧
                            (∀ u < t, ∀ (e : WindowExit), (MultiTapeTM.runFrom d u).state ≠ some (exit e)) ∧
                              (∀ u ≤ t,
                                  ∀ (j : Fin (K + 1)),
                                    |(MultiTapeTM.runFrom d u).workTapePos j - d.workTapePos j| ≤
                                      ↑(C * (recordLength M.k x.length s + 1))) ∧
                                (∀ u ≤ t, (MultiTapeTM.runFrom d u).output = d.output) ∧
                                  MultiTapeTM.spaceUsed d t ≤
                                      (K + 1) * (2 * C * (recordLength M.k x.length s + 1) + 1) ∧
                                    (∀ N ≤ M.configBound x.length s + 1,
                                        (windowRun M.tm s upd N c τ).1 ≠ WindowExit.exhausted →
                                          out = (windowRun M.tm s upd N c τ).1) ∧
                                      (out ≠ WindowExit.exhausted →
                                        ∃ N,
                                          (windowRun M.tm s upd N c τ).1 = out ∧
                                            MultiTapeTM.runFrom d t =
                                              { state := some (exit out), inputPos := d.inputPos,
                                                workTapes := fun j q =>
                                                  if
                                                      j = 0 ∧
                                                        d.workTapePos 0 ≤ q ∧
                                                          q < d.workTapePos 0 + ↑(recordLength M.k x.length s) then
                                                    fieldsTape
                                                      (cfgRecord s (windowRun M.tm s upd N c τ).2.1
                                                        (windowRun M.tm s upd N c τ).2.2)
                                                      (q - d.workTapePos 0)
                                                  else d.workTapes j q,
                                                workTapePos := d.workTapePos, output := d.output })
exists_windowRunnerTM : ∀ (M : FinTM Bool) {T : Type} [Fintype T] [DecidableEq T] (upd : T → Option Bool → T),
  (∀ (τ : T), upd τ none = τ) →
    ∃ K P x x R entry exit C,
      (∀ (e : WindowExit), exit e ≠ entry) ∧
        Function.Injective exit ∧
          ∀ {x : List Bool} (s : ℕ) (c : Cfg M.k Bool M.State x) (τ : T),
            Cfg.InWindow s c →
              ∀ (w : List Bool) (d : Cfg (K + 2) (RecSym M.State T) P (List.map (⇑(RecSym.digitEmb M.State T)) x)),
                d.state = some entry →
                  RecordAt d 0 (cfgRecord s c τ) →
                    (∀ (p : ℤ),
                        -1 ≤ p →
                          p ≤ ↑w.length →
                            d.workTapes (Fin.last (K + 1)) (d.workTapePos (Fin.last (K + 1)) + p) =
                              FinTM.bufferTape (List.map (⇑(RecSym.digitEmb M.State T)) w) p) →
                      (∀ (j : Fin (K + 2)), j ≠ 0 → j ≠ Fin.last (K + 1) → ∀ (p : ℤ), d.workTapes j p = none) →
                        ∃ t out,
                          t ≤ 5 * Nat.ofDigits 2 (List.map Bool.toNat w) + 2 * w.length + 3 ∧
                            (MultiTapeTM.runFrom d t).state = some (exit out) ∧
                              (∀ u < t, ∀ (e : WindowExit), (MultiTapeTM.runFrom d u).state ≠ some (exit e)) ∧
                                (∀ u ≤ t,
                                    ∀ (j : Fin (K + 2)),
                                      |(MultiTapeTM.runFrom d u).workTapePos j - d.workTapePos j| ≤
                                        ↑(C * (recordLength M.k x.length s + w.length + 1))) ∧
                                  (∀ u ≤ t, (MultiTapeTM.runFrom d u).output = d.output) ∧
                                    MultiTapeTM.spaceUsed d t ≤
                                        (K + 2) * (2 * C * (recordLength M.k x.length s + w.length + 1) + 1) ∧
                                      (∀ (N : ℕ),
                                          (windowRun M.tm s upd N c τ).1 ≠ WindowExit.exhausted →
                                            C * N * (recordLength M.k x.length s + x.length + 1) ≤
                                                Nat.ofDigits 2 (List.map Bool.toNat w) →
                                              out = (windowRun M.tm s upd N c τ).1) ∧
                                        (out ≠ WindowExit.exhausted →
                                          ∃ N,
                                            (windowRun M.tm s upd N c τ).1 = out ∧
                                              ∃ w',
                                                w'.length = w.length ∧
                                                  MultiTapeTM.runFrom d t =
                                                    { state := some (exit out), inputPos := d.inputPos,
                                                      workTapes := fun j q =>
                                                        if
                                                            j = 0 ∧
                                                              d.workTapePos 0 ≤ q ∧
                                                                q <
                                                                  d.workTapePos 0 + ↑(recordLength M.k x.length s) then
                                                          fieldsTape
                                                            (cfgRecord s (windowRun M.tm s upd N c τ).2.1
                                                              (windowRun M.tm s upd N c τ).2.2)
                                                            (q - d.workTapePos 0)
                                                        else
                                                          if j = Fin.last (K + 1) then
                                                            wordPatch (d.workTapes j) (d.workTapePos j)
                                                              (List.map (⇑(RecSym.digitEmb M.State T)) w') q
                                                          else d.workTapes j q,
                                                      workTapePos := d.workTapePos, output := d.output })
@windowRun : {k : ℕ} →
  {Q T : Type} →
    {x : List Bool} →
      MultiTapeTM k Bool Q → ℕ → (T → Option Bool → T) → ℕ → Cfg k Bool Q x → T → WindowExit × Cfg k Bool Q x × T
WindowExit : Type
@cfgRecord : {k : ℕ} → {Q T : Type} → {x : List Bool} → ℕ → Cfg k Bool Q x → T → List (List (RecSym Q T))
@RecordAt : {K : ℕ} → {Γ : Type u_1} → {S : Type u_2} → {x : List Γ} → Cfg K Γ S x → Fin K → List (List Γ) → Prop
recordLength : ℕ → ℕ → ℕ → ℕ
posWidth : ℕ → ℕ
RecSym : Type → Type → Type
RecSym.digitEmb : (Q T : Type) → Bool ↪ RecSym Q T
@fieldsTape : {Γ : Type u_1} → List (List Γ) → ℤ → Option Γ
@Cfg.InWindow : {k : ℕ} → {Symbol State : Type} → {x : List Symbol} → ℕ → Cfg k Symbol State x → Prop
FinTM.inWindow_of_spaceUsed_le : ∀ (M : FinTM Bool) (x : List Bool) {t s : ℕ},
  MultiTapeTM.spaceUsed (MultiTapeTM.initCfg x) t ≤ s →
    ∀ u ≤ t, Cfg.InWindow s (MultiTapeTM.runFrom (MultiTapeTM.initCfg x) u)
windowRun_summary_of_halts : ∀ (M : FinTM Bool) (x : List Bool) {w : List Bool} {t s N : ℕ},
  M.ComputesInTime x w t →
    MultiTapeTM.spaceUsed (MultiTapeTM.initCfg x) t ≤ s →
      t < N →
        windowRun M.tm s summaryTag N (MultiTapeTM.initCfg x) 0 =
          (WindowExit.halted, MultiTapeTM.runFrom (MultiTapeTM.initCfg x) t, outSummaryCode (outSummary w))
FinTM.configBound_le_two_pow : ∀ (M : FinTM Bool) (n s : ℕ),
  M.configBound n s ≤ 2 ^ (Fintype.card M.State + posWidth n + 3 * M.k * (2 * s + 1))
exists_recordInitTM : ∀ (k : ℕ) {Q T : Type} [Fintype Q] [DecidableEq Q] [Fintype T] [DecidableEq T] (q₀ : Q) (τ₀ : T),
  ∃ K P x x R entry exit C,
    ∀ {x : List Bool} (s : ℕ) (ws : List Bool),
      Nat.ofDigits 2 (List.map Bool.toNat ws) = s →
        ∀ (d : Cfg (K + 2) (RecSym Q T) P (List.map (⇑(RecSym.digitEmb Q T)) x)),
          d.state = some entry →
            d.inputPos = 1 →
              (∀ (p : ℤ),
                  -1 ≤ p →
                    p ≤ ↑ws.length →
                      d.workTapes 1 (d.workTapePos 1 + p) = FinTM.bufferTape (List.map RecSym.digit ws) p) →
                (∀ (p : ℤ), -1 ≤ p → p ≤ ↑(recordLength k x.length s) → d.workTapes 0 (d.workTapePos 0 + p) = none) →
                  (∀ (j : Fin (K + 2)), 2 ≤ ↑j → ∀ (p : ℤ), d.workTapes j p = none) →
                    ∃ t ≤ C * (recordLength k x.length s + ws.length + s + x.length + 1),
                      (∀ u < t, (MultiTapeTM.runFrom d u).state ≠ some exit) ∧
                        (∀ u ≤ t,
                            ∀ (j : Fin (K + 2)),
                              |(MultiTapeTM.runFrom d u).workTapePos j - d.workTapePos j| ≤
                                ↑(C * (recordLength k x.length s + ws.length + s + 1))) ∧
                          MultiTapeTM.runFrom d t =
                            { state := some exit, inputPos := d.inputPos,
                              workTapes := fun j q =>
                                if j = 0 ∧ d.workTapePos j ≤ q ∧ q < d.workTapePos j + ↑(recordLength k x.length s) then
                                  fieldsTape (cfgRecord s (Cfg.init q₀ x) τ₀) (q - d.workTapePos j)
                                else d.workTapes j q,
                              workTapePos := d.workTapePos, output := d.output }
outSummary : List Bool → OutSummary
@outSummary_append_congr : ∀ {u v : List Bool},
  outSummary u = outSummary v → ∀ (e : List Bool), outSummary (u ++ e) = outSummary (v ++ e)
outSummary_eq_accept_iff : ∀ (u : List Bool), outSummary u = OutSummary.accept ↔ u = [true]
@FinTM.alphabet_reduction_spaceUsed : ∀ {Γ : Type} [Fintype Γ] [DecidableEq Γ] (e : Bool ↪ Γ) (M : FinTM Γ)
  (f : List Bool → List Bool) (T S : ℕ → ℕ),
  M.ComputesFunInTimeVia e f T →
    (∀ (x : List Γ) (t : ℕ), MultiTapeTM.spaceUsed (MultiTapeTM.initCfg x) t ≤ S x.length) →
      ∃ c M',
        M'.k = M.k ∧
          (M'.ComputesFunInTime f fun n => c * (T n + 1)) ∧
            ∀ (x : List Bool) (t : ℕ), MultiTapeTM.spaceUsed (MultiTapeTM.initCfg x) t ≤ c * (S x.length + 1)
@FinTM.decidesInSpace_of_alphabetReduction : ∀ {Γ : Type} [Fintype Γ] [DecidableEq Γ] (e : Bool ↪ Γ) (D : FinTM Γ)
  (L : Language Bool) (S : ℕ → ℕ),
  (∀ (x : List Bool), ∃ t, D.ComputesInTime (List.map (⇑e) x) (List.map ⇑e [MultiTapeTM.indicator L x]) t) →
    (∀ (x : List Γ) (t : ℕ), MultiTapeTM.spaceUsed (MultiTapeTM.initCfg x) t ≤ S x.length) →
      ∃ c M, M.DecidesInSpace L fun n => c * (S n + 1)
@inputFoldTM : {Γ : Type u_1} → {A : Type} → (k : ℕ) → (A → Γ → A) → A → MultiTapeTM k Γ (ScanPhase A)
@inputFoldTM_run_ofCfg : ∀ {Γ : Type u_1} {A : Type} {k : ℕ} {x : List Γ} (δ : A → Γ → A) (a₀ : A)
  (d : Cfg k Γ (ScanPhase A) x),
  d.state = some (ScanPhase.fwd a₀) →
    d.inputPos = 1 →
      MultiTapeTM.runFrom d (2 * x.length + 2) =
          { state := some (ScanPhase.done (List.foldl δ a₀ x)), inputPos := d.inputPos, workTapes := d.workTapes,
            workTapePos := d.workTapePos, output := d.output } ∧
        (∀ t < 2 * x.length + 2, ∀ (a : A), (MultiTapeTM.runFrom d t).state ≠ some (ScanPhase.done a)) ∧
          ∀ (j : Fin k), ∀ t ≤ 2 * x.length + 2, (MultiTapeTM.runFrom d t).workTapePos j = d.workTapePos j
@MultiTapeTM.liftSymbols : {k : ℕ} →
  {Γ : Type u_1} → {State : Type u_2} → [DecidableEq Γ] → MultiTapeTM k Bool State → (Bool ↪ Γ) → MultiTapeTM k Γ State
@MultiTapeTM.liftSymbols_runFrom : ∀ {k : ℕ} {Γ : Type u_1} {State : Type u_2} [inst : DecidableEq Γ]
  (M : MultiTapeTM k Bool State) (e : Bool ↪ Γ) {x : List Bool} (c : Cfg k Bool State x) (t : ℕ),
  MultiTapeTM.runFrom (Cfg.liftSymbols e c) t = Cfg.liftSymbols e (MultiTapeTM.runFrom c t)
@MultiTapeTM.liftSymbols_initCfg : ∀ {k : ℕ} {Γ : Type u_1} {State : Type u_2} [inst : DecidableEq Γ]
  (M : MultiTapeTM k Bool State) (e : Bool ↪ Γ) (x : List Bool),
  MultiTapeTM.initCfg (List.map (⇑e) x) = Cfg.liftSymbols e (MultiTapeTM.initCfg x)
@capture_run : ∀ {k : ℕ} {S : Type u_1} {H : Type u_2} {input : List Bool} (tm : MultiTapeTM k Bool S)
  (host : MultiTapeTM (k + 1) Bool H) (emb : S → H) (ret : H),
  (∀ (s : S) (inp : Option Bool) (w : Fin (k + 1) → Option Bool),
      host.tr (emb s) inp w = captureAction emb ret (tm.tr s inp fun i => w i.castSucc)) →
    ∀ (pre out₀ : List Bool) (c₀ : Cfg k Bool S input) (t : ℕ),
      (∀ t' < t, ¬(MultiTapeTM.runFrom c₀ t').Halted) →
        MultiTapeTM.runFrom (captureCfg emb ret pre out₀ c₀) t = captureCfg emb ret pre out₀ (MultiTapeTM.runFrom c₀ t)
@capture_visitedByTapeHead : ∀ {k : ℕ} {S : Type u_1} {H : Type u_2} {x : List Bool} (tm : MultiTapeTM k Bool S)
  (host : MultiTapeTM (k + 1) Bool H) (emb : S → H) (ret : H),
  (∀ (s : S) (inp : Option Bool) (w : Fin (k + 1) → Option Bool),
      host.tr (emb s) inp w = captureAction emb ret (tm.tr s inp fun i => w i.castSucc)) →
    ∀ (pre out₀ : List Bool) (c₀ : Cfg k Bool S x) (t : ℕ),
      (∀ t' < t, ¬(MultiTapeTM.runFrom c₀ t').Halted) →
        (∀ (i : Fin k),
            MultiTapeTM.visitedByTapeHead (captureCfg emb ret pre out₀ c₀) t i.castSucc =
                MultiTapeTM.visitedByTapeHead c₀ t i ∧
              MultiTapeTM.spaceUsedByTape (captureCfg emb ret pre out₀ c₀) t i.castSucc =
                MultiTapeTM.spaceUsedByTape c₀ t i) ∧
          MultiTapeTM.spaceUsedByTape (captureCfg emb ret pre out₀ c₀) t (Fin.last k) ≤
            (MultiTapeTM.runFrom c₀ t).output.length - c₀.output.length + 1
@seamCompTM_spaceUsed_le_add : ∀ {k : ℕ} {S₁ : Type u_1} {S₂ : Type u_2} {x : List Bool} [inst : DecidableEq S₁]
  (M₁ : MultiTapeTM k Bool S₁) (exit : S₁) (M₂ : MultiTapeTM k Bool S₂) (entry : S₂) (start : S₁) (q₂ : S₂)
  (w₀ w₁ w₂ : Fin k → List Bool) (T₁ T₂ : ℕ),
  MultiTapeTM.runFrom (Cfg.ofWords start w₀) T₁ = Cfg.ofWords exit w₁ →
    (∀ t < T₁, (MultiTapeTM.runFrom (Cfg.ofWords start w₀) t).state ≠ some exit) →
      MultiTapeTM.runFrom (Cfg.ofWords entry w₁) T₂ = Cfg.ofWords q₂ w₂ →
        MultiTapeTM.spaceUsed (Cfg.ofWords (Sum.inl start) w₀) (T₁ + 1 + T₂) ≤
          MultiTapeTM.spaceUsed (Cfg.ofWords start w₀) T₁ + MultiTapeTM.spaceUsed (Cfg.ofWords entry w₁) T₂
@seamCompTM_spaceUsedByTape_le_max : ∀ {k : ℕ} {S₁ : Type u_1} {S₂ : Type u_2} {x : List Bool} [inst : DecidableEq S₁]
  (M₁ : MultiTapeTM k Bool S₁) (exit : S₁) (M₂ : MultiTapeTM k Bool S₂) (entry : S₂) (start : S₁) (q₂ : S₂)
  (w₀ w₁ w₂ : Fin k → List Bool) (T₁ T₂ : ℕ),
  MultiTapeTM.runFrom (Cfg.ofWords start w₀) T₁ = Cfg.ofWords exit w₁ →
    (∀ t < T₁, (MultiTapeTM.runFrom (Cfg.ofWords start w₀) t).state ≠ some exit) →
      MultiTapeTM.runFrom (Cfg.ofWords entry w₁) T₂ = Cfg.ofWords q₂ w₂ →
        ∀ (i : Fin k),
          MultiTapeTM.visitedByTapeHead (Cfg.ofWords start w₀) T₁ i = {0} ∨
              MultiTapeTM.visitedByTapeHead (Cfg.ofWords entry w₁) T₂ i = {0} →
            MultiTapeTM.spaceUsedByTape (Cfg.ofWords (Sum.inl start) w₀) (T₁ + 1 + T₂) i ≤
              max (MultiTapeTM.spaceUsedByTape (Cfg.ofWords start w₀) T₁ i)
                (MultiTapeTM.spaceUsedByTape (Cfg.ofWords entry w₁) T₂ i)
@seamCompTM_spaceUsedByTape_le_add : ∀ {k : ℕ} {S₁ : Type u_1} {S₂ : Type u_2} {x : List Bool} [inst : DecidableEq S₁]
  (M₁ : MultiTapeTM k Bool S₁) (exit : S₁) (M₂ : MultiTapeTM k Bool S₂) (entry : S₂) (start : S₁) (q₂ : S₂)
  (w₀ w₁ w₂ : Fin k → List Bool) (T₁ T₂ : ℕ),
  MultiTapeTM.runFrom (Cfg.ofWords start w₀) T₁ = Cfg.ofWords exit w₁ →
    (∀ t < T₁, (MultiTapeTM.runFrom (Cfg.ofWords start w₀) t).state ≠ some exit) →
      MultiTapeTM.runFrom (Cfg.ofWords entry w₁) T₂ = Cfg.ofWords q₂ w₂ →
        ∀ (i : Fin k),
          MultiTapeTM.spaceUsedByTape (Cfg.ofWords (Sum.inl start) w₀) (T₁ + 1 + T₂) i ≤
            MultiTapeTM.spaceUsedByTape (Cfg.ofWords start w₀) T₁ i +
              MultiTapeTM.spaceUsedByTape (Cfg.ofWords entry w₁) T₂ i
@FinTM.ComputesInTime.of_spaceUsed_le : ∀ {M : FinTM Bool} {x w : List Bool} {t s : ℕ},
  M.ComputesInTime x w t →
    MultiTapeTM.spaceUsed (MultiTapeTM.initCfg x) t ≤ s → M.ComputesInTime x w (M.configBound x.length s)
@MultiTapeTM.spaceUsed_mono : ∀ {k : ℕ} {S : Type} {x : List Bool} (tm : MultiTapeTM k Bool S) (c : Cfg k Bool S x)
  {t t' : ℕ}, t ≤ t' → MultiTapeTM.spaceUsed c t ≤ MultiTapeTM.spaceUsed c t'
FinTM.one_work_tape_binary_spaceUsed : ∀ (M : FinTM Bool) (f : List Bool → List Bool) (T S : ℕ → ℕ),
  M.ComputesFunInTime f T →
    (∀ (x : List Bool) (t : ℕ), MultiTapeTM.spaceUsed (MultiTapeTM.initCfg x) t ≤ S x.length) →
      ∃ M' c,
        M'.k = 1 ∧
          (M'.ComputesFunInTime f fun n => c * (T n + 1) ^ 2) ∧
            ∀ (x : List Bool) (t : ℕ), MultiTapeTM.spaceUsed (MultiTapeTM.initCfg x) t ≤ c * (S x.length + 1)
exists_codeTM : ∀ (M : FinTM Bool),
  M.k = 1 → ∃ M', ∀ (x output : List Bool) (t : ℕ), M'.toFinTM.ComputesInTime x output t ↔ M.ComputesInTime x output t
@MultiTapeTM.relabelState_runFrom_init : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {State' : Type u_3}
  (tm : MultiTapeTM k Symbol State) (e : State ≃ State') (input : List Symbol) (t : ℕ),
  MultiTapeTM.runFrom (MultiTapeTM.initCfg input) t =
    Cfg.mapState (⇑e) (MultiTapeTM.runFrom (MultiTapeTM.initCfg input) t)
@MultiTapeTM.abs_pos_lt_card_visited : ∀ {k : ℕ} {S : Type} (tm : MultiTapeTM k Bool S) (x : List Bool) (t : ℕ)
  (i : Fin k) {z : ℤ},
  z ∈ MultiTapeTM.visitedByTapeHead (MultiTapeTM.initCfg x) t i →
    |z| < ↑(MultiTapeTM.visitedByTapeHead (MultiTapeTM.initCfg x) t i).card
@MultiTapeTM.mem_visited_of_ne_none : ∀ {k : ℕ} {S : Type} (tm : MultiTapeTM k Bool S) (x : List Bool) (t : ℕ)
  (i : Fin k) (z : ℤ),
  (MultiTapeTM.runFrom (MultiTapeTM.initCfg x) t).workTapes i z ≠ none →
    z ∈ MultiTapeTM.visitedByTapeHead (MultiTapeTM.initCfg x) t i
@FinTM.ComputesInSpace.computesFunInTime_and_forall_spaceUsed_le : ∀ {M : FinTM Bool} {f : List Bool → List Bool}
  {s : ℕ → ℕ},
  M.ComputesInSpace f s →
    (M.ComputesFunInTime f fun n => M.configBound n (s n)) ∧
      ∀ (x : List Bool) (t : ℕ), MultiTapeTM.spaceUsed (MultiTapeTM.initCfg x) t ≤ s x.length
counterValue : List Bool → ℕ
counterValue_eq : ∀ (w : List Bool), counterValue w = Nat.ofDigits 2 (List.map Bool.toNat w)
counterValue_bits : ∀ (t : ℕ), counterValue t.bits = t
