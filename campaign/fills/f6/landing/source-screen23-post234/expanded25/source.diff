+      (∀ u < T, (A.runFrom (A.initCfg z) u).state ≠ some finish) →
+      (A.spaceUsed (A.initCfg z) T ≤ B) →
+      (1 ≤ S) →
+      (∀ i, H.spaceUsedByTape c t i ≤ S) →
