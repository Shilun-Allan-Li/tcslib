@Turing.StepBlock.forwardLoopCfg_workTapes : ∀ {k n : ℕ} {Q : Type} {x : List Bool} (entry : Q)
  (M : Turing.MultiTapeTM k Bool (Fin (n + 1))) (c : Turing.Cfg k Bool (Fin (n + 1)) x) (i : Fin (k + 2)) (a : ℤ),
  (Turing.StepBlock.forwardLoopCfg entry M c).workTapes i a =
