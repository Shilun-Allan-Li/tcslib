@Turing.Contract.ofSegment_lo : ∀ {k : ℕ} {Γ S : Type} {M : Turing.MultiTapeTM k Γ S} {entry : S}
  {exits : Set (Option S)} {ι : Type} {x : List Γ} (pre : ι → Turing.Cfg k Γ S x → Prop)
  (time : ι → Turing.Cfg k Γ S x → ℕ) (post : ι → Turing.Cfg k Γ S x → Turing.Cfg k Γ S x)
  (lo hi : ι → Turing.Cfg k Γ S x → Fin k → ℤ)
  (seg :
    ∀ (i : ι) (d : Turing.Cfg k Γ S x),
      d.state = some entry →
        pre i d → Turing.Segment M exits (Turing.HeadBox (lo i d) (hi i d)) d (post i d) (time i d))
  (exit_mem : ∀ (i : ι) (d : Turing.Cfg k Γ S x), d.state = some entry → pre i d → (post i d).state ∈ exits) (a : ι)
  (a_1 : Turing.Cfg k Γ S x) (a_2 : Fin k),
  (Turing.Contract.ofSegment pre time post lo hi seg exit_mem).lo a a_1 a_2 = lo a a_1 a_2
@Turing.Contract.ofSegment_hi : ∀ {k : ℕ} {Γ S : Type} {M : Turing.MultiTapeTM k Γ S} {entry : S}
  {exits : Set (Option S)} {ι : Type} {x : List Γ} (pre : ι → Turing.Cfg k Γ S x → Prop)
  (time : ι → Turing.Cfg k Γ S x → ℕ) (post : ι → Turing.Cfg k Γ S x → Turing.Cfg k Γ S x)
  (lo hi : ι → Turing.Cfg k Γ S x → Fin k → ℤ)
  (seg :
    ∀ (i : ι) (d : Turing.Cfg k Γ S x),
      d.state = some entry →
        pre i d → Turing.Segment M exits (Turing.HeadBox (lo i d) (hi i d)) d (post i d) (time i d))
  (exit_mem : ∀ (i : ι) (d : Turing.Cfg k Γ S x), d.state = some entry → pre i d → (post i d).state ∈ exits) (a : ι)
  (a_1 : Turing.Cfg k Γ S x) (a_2 : Fin k),
  (Turing.Contract.ofSegment pre time post lo hi seg exit_mem).hi a a_1 a_2 = hi a a_1 a_2
@Turing.Contract.zero : {k : ℕ} →
  {Γ S : Type} → (M : Turing.MultiTapeTM k Γ S) → (e : S) → (ι : Type) → (x : List Γ) → Turing.Contract M e {some e} ι x
@Turing.Contract.zero_pre : ∀ {k : ℕ} {Γ S : Type} (M : Turing.MultiTapeTM k Γ S) (e : S) (ι : Type) (x : List Γ)
  (i : ι) (d : Turing.Cfg k Γ S x), (Turing.Contract.zero M e ι x).pre i d = True
@Turing.Contract.zero_time : ∀ {k : ℕ} {Γ S : Type} (M : Turing.MultiTapeTM k Γ S) (e : S) (ι : Type) (x : List Γ)
  (i : ι) (d : Turing.Cfg k Γ S x), (Turing.Contract.zero M e ι x).time i d = 0
@Turing.Contract.zero_post : ∀ {k : ℕ} {Γ S : Type} (M : Turing.MultiTapeTM k Γ S) (e : S) (ι : Type) (x : List Γ)
  (i : ι) (d : Turing.Cfg k Γ S x), (Turing.Contract.zero M e ι x).post i d = d
@Turing.Contract.zero_lo : ∀ {k : ℕ} {Γ S : Type} (M : Turing.MultiTapeTM k Γ S) (e : S) (ι : Type) (x : List Γ) (i : ι)
  (d : Turing.Cfg k Γ S x), (Turing.Contract.zero M e ι x).lo i d = d.workTapePos
@Turing.Contract.zero_hi : ∀ {k : ℕ} {Γ S : Type} (M : Turing.MultiTapeTM k Γ S) (e : S) (ι : Type) (x : List Γ) (i : ι)
  (d : Turing.Cfg k Γ S x), (Turing.Contract.zero M e ι x).hi i d = d.workTapePos
@Turing.Contract.time_envelope : ∀ {k : ℕ} {Γ S : Type} {M : Turing.MultiTapeTM k Γ S} {entry : S}
  {exits : Set (Option S)} {ι : Type} {x : List Γ} (C : Turing.Contract M entry exits ι x) (i : ι)
  (d : Turing.Cfg k Γ S x),
  ∀ u ≤ C.time i d,
    ∀ (j : Fin k),
      (Turing.MultiTapeTM.runFrom d u).workTapePos j ∈
        Finset.Icc (d.workTapePos j - ↑(C.time i d)) (d.workTapePos j + ↑(C.time i d))
@Turing.Contract.trans : {k : ℕ} →
  {Γ S : Type} →
    {M : Turing.MultiTapeTM k Γ S} →
      {e₁ e₂ : S} →
        {X : Set (Option S)} →
          {ι κ : Type} →
            {x : List Γ} →
              (C₁ : Turing.Contract M e₁ {some e₂} ι x) →
                (C₂ : Turing.Contract M e₂ X κ x) →
                  (link : ι → κ) →
                    (∀ (i : ι) (d : Turing.Cfg k Γ S x),
                        d.state = some e₁ → C₁.pre i d → C₂.pre (link i) (C₁.post i d)) →
                      (∀ (i : ι) (d : Turing.Cfg k Γ S x),
                          d.state = some e₁ →
                            C₁.pre i d → ∀ u < C₁.time i d, (Turing.MultiTapeTM.runFrom d u).state ∉ X) →
                        Turing.Contract M e₁ X ι x
@Turing.Contract.trans_pre : ∀ {k : ℕ} {Γ S : Type} {M : Turing.MultiTapeTM k Γ S} {e₁ e₂ : S} {X : Set (Option S)}
  {ι κ : Type} {x : List Γ} (C₁ : Turing.Contract M e₁ {some e₂} ι x) (C₂ : Turing.Contract M e₂ X κ x) (link : ι → κ)
  (hlink : ∀ (i : ι) (d : Turing.Cfg k Γ S x), d.state = some e₁ → C₁.pre i d → C₂.pre (link i) (C₁.post i d))
  (hX :
    ∀ (i : ι) (d : Turing.Cfg k Γ S x),
      d.state = some e₁ → C₁.pre i d → ∀ u < C₁.time i d, (Turing.MultiTapeTM.runFrom d u).state ∉ X)
  (a : ι) (a_1 : Turing.Cfg k Γ S x), (C₁.trans C₂ link hlink hX).pre a a_1 = C₁.pre a a_1
@Turing.Contract.trans_time : ∀ {k : ℕ} {Γ S : Type} {M : Turing.MultiTapeTM k Γ S} {e₁ e₂ : S} {X : Set (Option S)}
  {ι κ : Type} {x : List Γ} (C₁ : Turing.Contract M e₁ {some e₂} ι x) (C₂ : Turing.Contract M e₂ X κ x) (link : ι → κ)
  (hlink : ∀ (i : ι) (d : Turing.Cfg k Γ S x), d.state = some e₁ → C₁.pre i d → C₂.pre (link i) (C₁.post i d))
  (hX :
    ∀ (i : ι) (d : Turing.Cfg k Γ S x),
      d.state = some e₁ → C₁.pre i d → ∀ u < C₁.time i d, (Turing.MultiTapeTM.runFrom d u).state ∉ X)
  (i : ι) (d : Turing.Cfg k Γ S x), (C₁.trans C₂ link hlink hX).time i d = C₁.time i d + C₂.time (link i) (C₁.post i d)
@Turing.Contract.trans_post : ∀ {k : ℕ} {Γ S : Type} {M : Turing.MultiTapeTM k Γ S} {e₁ e₂ : S} {X : Set (Option S)}
  {ι κ : Type} {x : List Γ} (C₁ : Turing.Contract M e₁ {some e₂} ι x) (C₂ : Turing.Contract M e₂ X κ x) (link : ι → κ)
  (hlink : ∀ (i : ι) (d : Turing.Cfg k Γ S x), d.state = some e₁ → C₁.pre i d → C₂.pre (link i) (C₁.post i d))
  (hX :
    ∀ (i : ι) (d : Turing.Cfg k Γ S x),
      d.state = some e₁ → C₁.pre i d → ∀ u < C₁.time i d, (Turing.MultiTapeTM.runFrom d u).state ∉ X)
  (i : ι) (d : Turing.Cfg k Γ S x), (C₁.trans C₂ link hlink hX).post i d = C₂.post (link i) (C₁.post i d)
@Turing.Contract.trans_lo : ∀ {k : ℕ} {Γ S : Type} {M : Turing.MultiTapeTM k Γ S} {e₁ e₂ : S} {X : Set (Option S)}
  {ι κ : Type} {x : List Γ} (C₁ : Turing.Contract M e₁ {some e₂} ι x) (C₂ : Turing.Contract M e₂ X κ x) (link : ι → κ)
  (hlink : ∀ (i : ι) (d : Turing.Cfg k Γ S x), d.state = some e₁ → C₁.pre i d → C₂.pre (link i) (C₁.post i d))
  (hX :
    ∀ (i : ι) (d : Turing.Cfg k Γ S x),
      d.state = some e₁ → C₁.pre i d → ∀ u < C₁.time i d, (Turing.MultiTapeTM.runFrom d u).state ∉ X)
  (i : ι) (d : Turing.Cfg k Γ S x) (j : Fin k),
  (C₁.trans C₂ link hlink hX).lo i d j = min (C₁.lo i d j) (C₂.lo (link i) (C₁.post i d) j)
@Turing.Contract.trans_hi : ∀ {k : ℕ} {Γ S : Type} {M : Turing.MultiTapeTM k Γ S} {e₁ e₂ : S} {X : Set (Option S)}
  {ι κ : Type} {x : List Γ} (C₁ : Turing.Contract M e₁ {some e₂} ι x) (C₂ : Turing.Contract M e₂ X κ x) (link : ι → κ)
  (hlink : ∀ (i : ι) (d : Turing.Cfg k Γ S x), d.state = some e₁ → C₁.pre i d → C₂.pre (link i) (C₁.post i d))
  (hX :
    ∀ (i : ι) (d : Turing.Cfg k Γ S x),
      d.state = some e₁ → C₁.pre i d → ∀ u < C₁.time i d, (Turing.MultiTapeTM.runFrom d u).state ∉ X)
  (i : ι) (d : Turing.Cfg k Γ S x) (j : Fin k),
  (C₁.trans C₂ link hlink hX).hi i d j = max (C₁.hi i d j) (C₂.hi (link i) (C₁.post i d) j)
@Turing.Segment : {k : ℕ} →
  {Γ S : Type} →
    {x : List Γ} →
      Turing.MultiTapeTM k Γ S →
        Set (Option S) → ((Fin k → ℤ) → Prop) → Turing.Cfg k Γ S x → Turing.Cfg k Γ S x → ℕ → Prop
@Turing.segment_iff : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} (M : Turing.MultiTapeTM k Γ S) (F : Set (Option S))
  (P : (Fin k → ℤ) → Prop) (a b : Turing.Cfg k Γ S x) (t : ℕ),
  Turing.Segment M F P a b t ↔
    Turing.MultiTapeTM.runFrom a t = b ∧
      (∀ u < t, (Turing.MultiTapeTM.runFrom a u).state ∉ F) ∧ ∀ u ≤ t, P (Turing.MultiTapeTM.runFrom a u).workTapePos
@Turing.Segment.one : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} {M : Turing.MultiTapeTM k Γ S} {F : Set (Option S)}
  {P : (Fin k → ℤ) → Prop} {a : Turing.Cfg k Γ S x},
  a.state ∉ F →
    P a.workTapePos → P (Turing.MultiTapeTM.step a).workTapePos → Turing.Segment M F P a (Turing.MultiTapeTM.step a) 1
@Turing.Segment.trans : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} {M : Turing.MultiTapeTM k Γ S} {F : Set (Option S)}
  {P : (Fin k → ℤ) → Prop} {a b c : Turing.Cfg k Γ S x} {t v : ℕ},
  Turing.Segment M F P a b t → Turing.Segment M F P b c v → Turing.Segment M F P a c (t + v)
@Turing.Segment.mono : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} {M : Turing.MultiTapeTM k Γ S} {F : Set (Option S)}
  {P : (Fin k → ℤ) → Prop} {F' : Set (Option S)} {P' : (Fin k → ℤ) → Prop} {a b : Turing.Cfg k Γ S x} {t : ℕ},
  Turing.Segment M F P a b t → F' ⊆ F → (∀ (p : Fin k → ℤ), P p → P' p) → Turing.Segment M F' P' a b t
@Turing.Segment.cons : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} {M : Turing.MultiTapeTM k Γ S} {F : Set (Option S)}
  {P : (Fin k → ℤ) → Prop} {a a₁ b : Turing.Cfg k Γ S x} {t : ℕ},
  Turing.MultiTapeTM.step a = a₁ →
    a.state ∉ F → P a.workTapePos → Turing.Segment M F P a₁ b t → Turing.Segment M F P a b (1 + t)
@Turing.Segment.live : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} {M : Turing.MultiTapeTM k Γ S} {F : Set (Option S)}
  {P : (Fin k → ℤ) → Prop} {a b : Turing.Cfg k Γ S x} {t : ℕ},
  Turing.Segment M F P a b t → b.state ≠ none → Turing.Segment M (insert none F) P a b t
@Turing.Round : {k : ℕ} →
  {Γ S : Type} →
    {x : List Γ} →
      Turing.MultiTapeTM k Γ S →
        S → Set (Option S) → ((Fin k → ℤ) → Prop) → Turing.Cfg k Γ S x → Turing.Cfg k Γ S x → ℕ → Prop
@Turing.Round.iterate_seq : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} {M : Turing.MultiTapeTM k Γ S} {a : S}
  {E : Set (Option S)} {P : (Fin k → ℤ) → Prop} (cs : ℕ → Turing.Cfg k Γ S x) (τ : ℕ → ℕ),
  some a ∉ E →
    P (cs 0).workTapePos →
      ∀ (n : ℕ),
        (∀ r < n, Turing.Round M a E P (cs r) (cs (r + 1)) (τ r)) →
          Turing.Segment M E P (cs 0) (cs n) (∑ r ∈ Finset.range n, τ r)
@Turing.RoundContract : {k : ℕ} → {Γ S : Type} → Turing.MultiTapeTM k Γ S → S → Set (Option S) → Type → List Γ → Type
@Turing.Lockstep : {k : ℕ} →
  {Γ : Type} →
    {k' : ℕ} →
      {Γ' S S' : Type} →
        {x : List Γ} →
          {x' : List Γ'} →
            Turing.MultiTapeTM k Γ S →
              Turing.MultiTapeTM k' Γ' S' →
                (Turing.Cfg k Γ S x → Turing.Cfg k' Γ' S' x') →
                  (Turing.Cfg k Γ S x → ℕ) → Set (Option S) → Set (Option S') → Prop
@Turing.Lockstep.runFrom : ∀ {k : ℕ} {Γ : Type} {k' : ℕ} {Γ' S S' : Type} {x : List Γ} {x' : List Γ'}
  {M : Turing.MultiTapeTM k Γ S} {N : Turing.MultiTapeTM k' Γ' S'} {enc : Turing.Cfg k Γ S x → Turing.Cfg k' Γ' S' x'}
  {cost : Turing.Cfg k Γ S x → ℕ} {X : Set (Option S)} {X' : Set (Option S')},
  Turing.Lockstep M N enc cost X X' →
    ∀ (d : Turing.Cfg k Γ S x) (t : ℕ),
      (∀ u < t, (Turing.MultiTapeTM.runFrom d u).state ∉ X) →
        Turing.MultiTapeTM.runFrom (enc d) (∑ u ∈ Finset.range t, cost (Turing.MultiTapeTM.runFrom d u)) =
          enc (Turing.MultiTapeTM.runFrom d t)
@Turing.Contract.seq : {k : ℕ} →
  {Γ S₁ S₂ : Type} →
    [inst : DecidableEq S₁] →
      {M₁ : Turing.MultiTapeTM k Γ S₁} →
        {M₂ : Turing.MultiTapeTM k Γ S₂} →
          {entry₁ exit₁ : S₁} →
            {entry₂ : S₂} →
              {X₂ : Set (Option S₂)} →
                {ι κ : Type} →
                  {x : List Γ} →
                    (C₁ : Turing.Contract M₁ entry₁ {some exit₁} ι x) →
                      (C₂ : Turing.Contract M₂ entry₂ X₂ κ x) →
                        (link : ι → κ) →
                          (∀ (i : ι) (d : Turing.Cfg k Γ S₁ x),
                              d.state = some entry₁ →
                                C₁.pre i d → C₂.pre (link i) (Turing.Cfg.mapState (fun x => entry₂) (C₁.post i d))) →
                            Turing.Contract (Turing.seamCompTM M₁ exit₁ M₂ entry₂) (Sum.inl entry₁)
                              (Option.map Sum.inr '' X₂) ι x
@Turing.Contract.inPhase : {k : ℕ} →
  {Γ I : Type} →
    {Ph : I → Type} →
      (Mf : (i : I) → Turing.MultiTapeTM k Γ (Ph i)) →
        (q0 : (i : I) × Ph i) →
          (red : (i : I) → Ph i → Option ((i : I) × Ph i)) →
            (p : I) →
              {s₀ : Ph p} →
                {X : Set (Option (Ph p))} →
                  {ι : Type} →
                    {x : List Γ} →
                      Turing.Contract (Mf p) s₀ X ι x →
                        none ∉ X →
                          (∀ (s : Ph p), some s ∉ X → red p s = none) →
                            (∀ (s : Ph p), some s ∈ X → ∃ q, red p s = some q ∧ q.fst ≠ p) →
                              Turing.Contract (Turing.phaseHostTM Mf q0 red) ⟨p, s₀⟩ {q | ∃ s, some s ∈ X ∧ q = red p s}
                                ι x
@Turing.Contract.branch : {k : ℕ} →
  {Γ S₀ S₁ S₂ : Type} →
    [inst : DecidableEq S₀] →
      [inst_1 : DecidableEq S₁] →
        {M₀ : Turing.MultiTapeTM k Γ S₀} →
          {M₁ : Turing.MultiTapeTM k Γ S₁} →
            {M₂ : Turing.MultiTapeTM k Γ S₂} →
              {entry₀ e₁ e₂ : S₀} →
                {entry₁ : S₁} →
                  {entry₂ : S₂} →
                    {X₁ : Set (Option S₁)} →
                      {X₂ : Set (Option S₂)} →
                        {ι κ₁ κ₂ : Type} →
                          {x : List Γ} →
                            e₁ ≠ e₂ →
                              (C₀ : Turing.Contract M₀ entry₀ {some e₁, some e₂} ι x) →
                                (C₁ : Turing.Contract M₁ entry₁ X₁ κ₁ x) →
                                  (C₂ : Turing.Contract M₂ entry₂ X₂ κ₂ x) →
                                    (l₁ : ι → κ₁) →
                                      (l₂ : ι → κ₂) →
                                        (∀ (i : ι) (d : Turing.Cfg k Γ S₀ x),
                                            d.state = some entry₀ →
                                              C₀.pre i d →
                                                (C₀.post i d).state = some e₁ →
                                                  C₁.pre (l₁ i) (Turing.Cfg.mapState (fun x => entry₁) (C₀.post i d))) →
                                          (∀ (i : ι) (d : Turing.Cfg k Γ S₀ x),
                                              d.state = some entry₀ →
                                                C₀.pre i d →
                                                  (C₀.post i d).state = some e₂ →
                                                    C₂.pre (l₂ i)
                                                      (Turing.Cfg.mapState (fun x => entry₂) (C₀.post i d))) →
                                            Turing.Contract (Turing.seamCompTM₂ M₀ e₁ e₂ M₁ entry₁ M₂ entry₂)
                                              (Sum.inl (Sum.inl entry₀))
                                              (Option.map (Sum.inl ∘ Sum.inr) '' X₁ ∪ Option.map Sum.inr '' X₂) ι x
@Turing.Contract.seq_pre : ∀ {k : ℕ} {Γ S₁ S₂ : Type} [inst : DecidableEq S₁] {M₁ : Turing.MultiTapeTM k Γ S₁}
  {M₂ : Turing.MultiTapeTM k Γ S₂} {entry₁ exit₁ : S₁} {entry₂ : S₂} {X₂ : Set (Option S₂)} {ι κ : Type} {x : List Γ}
  (C₁ : Turing.Contract M₁ entry₁ {some exit₁} ι x) (C₂ : Turing.Contract M₂ entry₂ X₂ κ x) (link : ι → κ)
  (hlink :
    ∀ (i : ι) (d : Turing.Cfg k Γ S₁ x),
      d.state = some entry₁ → C₁.pre i d → C₂.pre (link i) (Turing.Cfg.mapState (fun x => entry₂) (C₁.post i d)))
  (i : ι) (d : Turing.Cfg k Γ (S₁ ⊕ S₂) x),
  (C₁.seq C₂ link hlink).pre i d = C₁.pre i (Turing.Cfg.mapState (fun x => entry₁) d)
@Turing.Contract.seq_time : ∀ {k : ℕ} {Γ S₁ S₂ : Type} [inst : DecidableEq S₁] {M₁ : Turing.MultiTapeTM k Γ S₁}
  {M₂ : Turing.MultiTapeTM k Γ S₂} {entry₁ exit₁ : S₁} {entry₂ : S₂} {X₂ : Set (Option S₂)} {ι κ : Type} {x : List Γ}
  (C₁ : Turing.Contract M₁ entry₁ {some exit₁} ι x) (C₂ : Turing.Contract M₂ entry₂ X₂ κ x) (link : ι → κ)
  (hlink :
    ∀ (i : ι) (d : Turing.Cfg k Γ S₁ x),
      d.state = some entry₁ → C₁.pre i d → C₂.pre (link i) (Turing.Cfg.mapState (fun x => entry₂) (C₁.post i d)))
  (i : ι) (d : Turing.Cfg k Γ (S₁ ⊕ S₂) x),
  (C₁.seq C₂ link hlink).time i d =
    C₁.time i (Turing.Cfg.mapState (fun x => entry₁) d) + 1 +
      C₂.time (link i) (Turing.Cfg.mapState (fun x => entry₂) (C₁.post i (Turing.Cfg.mapState (fun x => entry₁) d)))
@Turing.Contract.seq_post : ∀ {k : ℕ} {Γ S₁ S₂ : Type} [inst : DecidableEq S₁] {M₁ : Turing.MultiTapeTM k Γ S₁}
  {M₂ : Turing.MultiTapeTM k Γ S₂} {entry₁ exit₁ : S₁} {entry₂ : S₂} {X₂ : Set (Option S₂)} {ι κ : Type} {x : List Γ}
  (C₁ : Turing.Contract M₁ entry₁ {some exit₁} ι x) (C₂ : Turing.Contract M₂ entry₂ X₂ κ x) (link : ι → κ)
  (hlink :
    ∀ (i : ι) (d : Turing.Cfg k Γ S₁ x),
      d.state = some entry₁ → C₁.pre i d → C₂.pre (link i) (Turing.Cfg.mapState (fun x => entry₂) (C₁.post i d)))
  (i : ι) (d : Turing.Cfg k Γ (S₁ ⊕ S₂) x),
  (C₁.seq C₂ link hlink).post i d =
    Turing.Cfg.mapState Sum.inr
      (C₂.post (link i) (Turing.Cfg.mapState (fun x => entry₂) (C₁.post i (Turing.Cfg.mapState (fun x => entry₁) d))))
@Turing.Contract.seq_lo : ∀ {k : ℕ} {Γ S₁ S₂ : Type} [inst : DecidableEq S₁] {M₁ : Turing.MultiTapeTM k Γ S₁}
  {M₂ : Turing.MultiTapeTM k Γ S₂} {entry₁ exit₁ : S₁} {entry₂ : S₂} {X₂ : Set (Option S₂)} {ι κ : Type} {x : List Γ}
  (C₁ : Turing.Contract M₁ entry₁ {some exit₁} ι x) (C₂ : Turing.Contract M₂ entry₂ X₂ κ x) (link : ι → κ)
  (hlink :
    ∀ (i : ι) (d : Turing.Cfg k Γ S₁ x),
      d.state = some entry₁ → C₁.pre i d → C₂.pre (link i) (Turing.Cfg.mapState (fun x => entry₂) (C₁.post i d)))
  (i : ι) (d : Turing.Cfg k Γ (S₁ ⊕ S₂) x) (j : Fin k),
  (C₁.seq C₂ link hlink).lo i d j =
    min (C₁.lo i (Turing.Cfg.mapState (fun x => entry₁) d) j)
      (C₂.lo (link i) (Turing.Cfg.mapState (fun x => entry₂) (C₁.post i (Turing.Cfg.mapState (fun x => entry₁) d))) j)
@Turing.Contract.seq_hi : ∀ {k : ℕ} {Γ S₁ S₂ : Type} [inst : DecidableEq S₁] {M₁ : Turing.MultiTapeTM k Γ S₁}
  {M₂ : Turing.MultiTapeTM k Γ S₂} {entry₁ exit₁ : S₁} {entry₂ : S₂} {X₂ : Set (Option S₂)} {ι κ : Type} {x : List Γ}
  (C₁ : Turing.Contract M₁ entry₁ {some exit₁} ι x) (C₂ : Turing.Contract M₂ entry₂ X₂ κ x) (link : ι → κ)
  (hlink :
    ∀ (i : ι) (d : Turing.Cfg k Γ S₁ x),
      d.state = some entry₁ → C₁.pre i d → C₂.pre (link i) (Turing.Cfg.mapState (fun x => entry₂) (C₁.post i d)))
  (i : ι) (d : Turing.Cfg k Γ (S₁ ⊕ S₂) x) (j : Fin k),
  (C₁.seq C₂ link hlink).hi i d j =
    max (C₁.hi i (Turing.Cfg.mapState (fun x => entry₁) d) j)
      (C₂.hi (link i) (Turing.Cfg.mapState (fun x => entry₂) (C₁.post i (Turing.Cfg.mapState (fun x => entry₁) d))) j)
@Turing.Contract.inPhase_pre : ∀ {k : ℕ} {Γ I : Type} {Ph : I → Type} (Mf : (i : I) → Turing.MultiTapeTM k Γ (Ph i))
  (q0 : (i : I) × Ph i) (red : (i : I) → Ph i → Option ((i : I) × Ph i)) (p : I) {s₀ : Ph p} {X : Set (Option (Ph p))}
  {ι : Type} {x : List Γ} (C : Turing.Contract (Mf p) s₀ X ι x) (hnone : none ∉ X)
