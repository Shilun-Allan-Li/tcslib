  {ι : Type} {x : List Γ} (C : Turing.Contract (Mf p) s₀ X ι x) (hnone : none ∉ X)
  (hred : ∀ (s : Ph p), some s ∉ X → red p s = none)
  (hsome : ∀ (s : Ph p), some s ∈ X → ∃ q, red p s = some q ∧ q.fst ≠ p) (i : ι)
