+/-- The initialized simulation bank and header ruler, ready for the suffix host. -/
+private def uk_suffixCfg {k K n : ℕ} {P : Type} (q : P)
+    (M : MultiTapeTM k Bool (Fin (n + 1))) (z : List Bool) (ℓ : ℕ)
+    (hℓ : ℓ + 1 < z.length + 2) : Cfg (K + (k + 3)) Bool P z :=
+  ⟨some q, ⟨ℓ + 1, hℓ⟩,
