+/-- The header scan followed by the public work-tape rewind. -/
+private def uk_headerTM {k : ℕ} (i : Fin k) :
+    MultiTapeTM k Bool (Fin 4 ⊕ RewindPhase) :=
+  { seamCompTM (uk_scanTM i) 3 (rewindTM k i) .start with q₀ := Sum.inl 0 }
