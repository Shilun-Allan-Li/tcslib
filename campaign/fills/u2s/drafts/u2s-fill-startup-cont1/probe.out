Turing.exists_selfStartupTMK : ∀ (k : ℕ) (E : Turing.EffectiveCodeK k),
  ∃ K P x x R exit,
    ∀ (α : List Bool),
      ∃ T B,
        ∀ (w : List Bool),
          Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg (Turing.pairEncode α w)) T =
              { state := some exit, inputPos := 1,
                workTapes := fun j =>
                  if ↑j = k then Turing.FinTM.bufferTape (Turing.tableBitsK (E.machine α).tr)
                  else
                    if ↑j = k + 1 then fun p => Turing.FinTM.bufferTape (Turing.unaryFin (E.machine α).q₀) (p - 2)
                    else fun x => none,
                workTapePos := fun x => 0, output := [] } ∧
            (∀ u < T,
                (Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg (Turing.pairEncode α w)) u).state ≠ some exit) ∧
              (∀ u ≤ T,
                  (Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg (Turing.pairEncode α w)) u).output = []) ∧
                Turing.MultiTapeTM.spaceUsed (Turing.MultiTapeTM.initCfg (Turing.pairEncode α w)) T ≤ B
Turing.EffectiveCodeK : ℕ → Type 1
@Turing.EffectiveCodeK.toFinTM : {k : ℕ} → Turing.EffectiveCodeK k → List Bool → Turing.FinTM Bool
@Turing.EffectiveCodeK.canonizer_computes : ∀ {k : ℕ} (self : Turing.EffectiveCodeK k),
  self.canonizer.ComputesFunInTime (fun α => Turing.serializeK (self.machine α)) self.canonizerTime
@Turing.serializeK : {k n : ℕ} → Turing.MultiTapeTM k Bool (Fin (n + 1)) → List Bool
@Turing.tableBitsK : {k n : ℕ} →
  (Fin (n + 1) → Option Bool → (Fin k → Option Bool) → Turing.Action k Bool (Fin (n + 1))) → List Bool
@Turing.unaryFin : {n : ℕ} → Fin n → List Bool
Turing.pairEncode : List Bool → List Bool → List Bool
@Turing.FinTM.bufferTape : {Symbol : Type u_1} → List Symbol → ℤ → Option Symbol
@Turing.FinTM.ComputesFunInTime : {Symbol : Type} → Turing.FinTM Symbol → (List Symbol → List Symbol) → (ℕ → ℕ) → Prop
@Turing.FinTM.computesInTime_iff : ∀ {Symbol : Type} (M : Turing.FinTM Symbol) (x w : List Symbol) (t : ℕ),
  M.ComputesInTime x w t ↔
    (Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) t).state = none ∧
      (Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg x) t).output = w
Turing.prefixCanonTM : Turing.FinTM Bool → Turing.FinTM Bool
Turing.prefixCanon_start : ∀ (F : Turing.FinTM Bool) (α x : List Bool),
  Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg (Turing.pairEncode α x)) (3 * α.length + 4) =
    Turing.universalPrefixTM.bufferedSecondCfg F (Turing.MultiTapeTM.initCfg α) true ⟨2 * α.length + 3, ⋯⟩
      (fun i => i.elim0) fun i => i.elim0
Turing.prefixCanon_run : ∀ (F : Turing.FinTM Bool) (α x : List Bool) (t : ℕ),
  ∃ b,
    Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg (Turing.pairEncode α x)) (3 * α.length + 4 + t) =
      Turing.universalPrefixTM.bufferedSecondCfg F (Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg α) t) b
        ⟨2 * α.length + 3, ⋯⟩ (fun i => i.elim0) fun i => i.elim0
Turing.prefixCanon_complete : ∀ (F : Turing.FinTM Bool) (f : List Bool → List Bool) (τ : ℕ → ℕ),
  F.ComputesFunInTime f τ →
    ∀ (α x : List Bool),
      have cfg :=
        Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg (Turing.pairEncode α x)) (3 * α.length + 4 + τ α.length);
      cfg.state = none ∧ cfg.output = f α ∧ ↑cfg.inputPos = 2 * α.length + 3
Turing.universalPrefixTM : Turing.FinTM Bool
Turing.FinTM.bufferedCompTM : Turing.FinTM Bool → Turing.FinTM Bool → Turing.FinTM Bool
Turing.FinTM.bufferedSecondCfg : (M₁ M₂ : Turing.FinTM Bool) →
  {x y : List Bool} →
    Turing.Cfg M₂.k Bool M₂.State y →
      Bool →
        Fin (x.length + 2) →
          (Fin M₁.k → ℤ → Option Bool) →
            (Fin M₁.k → ℤ) → Turing.Cfg (M₁.bufferedCompTM M₂).k Bool (M₁.bufferedCompTM M₂).State x
Turing.FinTM.bufferedSecondCfg_run : ∀ (M₁ M₂ : Turing.FinTM Bool) {x y : List Bool}
  (c : Turing.Cfg M₂.k Bool M₂.State y) (b : Bool),
  Turing.FinTM.VirtualTag c.inputPos b →
    ∀ (p : Fin (x.length + 2)) (tapes : Fin M₁.k → ℤ → Option Bool) (heads : Fin M₁.k → ℤ) (t : ℕ),
      ∃ b',
        Turing.FinTM.VirtualTag (Turing.MultiTapeTM.runFrom c t).inputPos b' ∧
          Turing.MultiTapeTM.runFrom (M₁.bufferedSecondCfg M₂ c b p tapes heads) t =
            M₁.bufferedSecondCfg M₂ (Turing.MultiTapeTM.runFrom c t) b' p tapes heads
Turing.universal_pair_length : ∀ (α x : List Bool), (Turing.pairEncode α x).length = 2 * α.length + 2 + x.length
@Complexity.LogProg.cleanTM : {k : ℕ} →
  {S : Type} → Turing.MultiTapeTM k Bool S → S → Turing.MultiTapeTM (k + k) Bool (Complexity.LogProg.CleanSt S k)
Complexity.LogProg.CleanSt : Type → ℕ → Type
@Complexity.LogProg.cleanTM_run : ∀ {k : ℕ} {S : Type} (M : Turing.MultiTapeTM k Bool S) (q₁ q : S) (V : List Bool)
  (T : ℕ),
  (Turing.MultiTapeTM.runFrom (Turing.Cfg.init q V) T).state = none →
    ∀ (s : ℕ),
      (∀ (i : Fin k), (Turing.MultiTapeTM.visitedByTapeHead (Turing.Cfg.init q V) T i).card ≤ s) →
        ∃ T',
          (Turing.MultiTapeTM.runFrom (Turing.Cfg.init (Complexity.LogProg.CleanSt.init q) V) T').state = none ∧
            (Turing.MultiTapeTM.runFrom (Turing.Cfg.init (Complexity.LogProg.CleanSt.init q) V) T').output =
                (Turing.MultiTapeTM.runFrom (Turing.Cfg.init q V) T).output ∧
              ((Turing.MultiTapeTM.runFrom (Turing.Cfg.init (Complexity.LogProg.CleanSt.init q) V) T').workTapes =
                  fun x x_1 => none) ∧
                ((Turing.MultiTapeTM.runFrom (Turing.Cfg.init (Complexity.LogProg.CleanSt.init q) V) T').workTapePos =
                    fun x => 0) ∧
                  ∀ t ≤ T',
                    ∀ (j : Fin (k + k)),
                      |(Turing.MultiTapeTM.runFrom (Turing.Cfg.init (Complexity.LogProg.CleanSt.init q) V)
                                t).workTapePos
                            j| ≤
                        ↑s
@Complexity.LogProg.sim_step_clean : ∀ {k : ℕ} {S : Type} (M : Turing.MultiTapeTM k Bool S) (q₁ q : S) (V : List Bool)
  (t : ℕ),
  (Turing.MultiTapeTM.runFrom (Turing.Cfg.init q V) t).state ≠ none →
    Turing.MultiTapeTM.step (Complexity.LogProg.simCfg M q V t) = Complexity.LogProg.simCfg M q V (t + 1)
@Complexity.LogProg.simCfg : {k : ℕ} →
  {S : Type} →
    Turing.MultiTapeTM k Bool S → S → (V : List Bool) → ℕ → Turing.Cfg (k + k) Bool (Complexity.LogProg.CleanSt S k) V
@Complexity.LogProg.stages_run : ∀ {k : ℕ} {S : Type} (M : Turing.MultiTapeTM k Bool S) (q₁ : S) {x : List Bool}
  (ip : Fin (x.length + 2)) (Dt Mt : Fin k → ℤ → Option Bool) (Dp : Fin k → ℤ) (out : List Bool) (B : ℤ),
  (∀ (j : Fin k),
      ∃ a b,
        a ≤ 0 ∧
          0 ≤ b ∧
            -B ≤ a - 1 ∧
              b + 1 ≤ B ∧
                a ≤ Dp j ∧
                  Dp j ≤ b ∧
                    Complexity.LogProg.wr (if Mt j (Dp j) = some true then none else some (some false)) (Mt j) (Dp j) =
                        Complexity.LogProg.markI a b ∧
                      ∀ (z : ℤ), Dt j z ≠ none → a ≤ z ∧ z ≤ b) →
    0 ≤ B →
      ∀ (n i : ℕ),
        i + n = k →
          ∃ T,
            (∀ t ≤ T,
                Complexity.LogProg.PB B (Turing.MultiTapeTM.runFrom (Complexity.LogProg.stg i ip Dt Mt Dp out) t)) ∧
              Turing.MultiTapeTM.runFrom (Complexity.LogProg.stg i ip Dt Mt Dp out) T =
                Complexity.LogProg.stg k ip Dt Mt Dp out
@Complexity.LogProg.stg : {k : ℕ} →
  {S : Type} →
    {x : List Bool} →
      ℕ →
        Fin (x.length + 2) →
          (Fin k → ℤ → Option Bool) →
            (Fin k → ℤ → Option Bool) →
              (Fin k → ℤ) → List Bool → Turing.Cfg (k + k) Bool (Complexity.LogProg.CleanSt S k) x
@Turing.embedSilentRetTM : {m k : ℕ} →
  {S : Type u_1} →
    {Symbol : Type u_2} →
      (Fin m ↪ Fin k) → Fin k → Turing.MultiTapeTM m Symbol S → Turing.MultiTapeTM k Symbol (S ⊕ Unit)
@Turing.embedSilentRetTM_run : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol} (ι : Fin m ↪ Fin k),
  ∀ cap ∉ Set.range ⇑ι,
    ∀ (M : Turing.MultiTapeTM m Symbol S) (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ)
      (pre out₀ : List Symbol) (c : Turing.Cfg m Symbol S x) (T : ℕ),
      c.state ≠ none →
        (∀ t < T, (Turing.MultiTapeTM.runFrom c t).state ≠ none) →
          (Turing.MultiTapeTM.runFrom c T).state = none →
            (∀ t < T,
                Turing.MultiTapeTM.runFrom
                    (Turing.Cfg.mapState Sum.inl (Turing.embedSilentCfg ι cap tapes heads pre out₀ c)) t =
                  Turing.Cfg.mapState Sum.inl
                    (Turing.embedSilentCfg ι cap tapes heads pre out₀ (Turing.MultiTapeTM.runFrom c t))) ∧
              (Turing.MultiTapeTM.runFrom
                    (Turing.Cfg.mapState Sum.inl (Turing.embedSilentCfg ι cap tapes heads pre out₀ c)) T =
                  have __src := Turing.embedSilentCfg ι cap tapes heads pre out₀ (Turing.MultiTapeTM.runFrom c T);
                  { state := some (Sum.inr ()), inputPos := __src.inputPos, workTapes := __src.workTapes,
                    workTapePos := __src.workTapePos, output := __src.output }) ∧
                ∀ t < T,
                  (Turing.MultiTapeTM.runFrom
                        (Turing.Cfg.mapState Sum.inl (Turing.embedSilentCfg ι cap tapes heads pre out₀ c)) t).state ≠
                    some (Sum.inr ())
@Turing.embedSilentRetTM_visitedByTapeHead : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol}
  (ι : Fin m ↪ Fin k) (cap : Fin k) (M : Turing.MultiTapeTM m Symbol S) (tapes : Fin k → ℤ → Option Symbol)
  (heads : Fin k → ℤ) (pre out₀ : List Symbol) (c : Turing.Cfg m Symbol S x) (t : ℕ) (j : Fin k),
  Turing.MultiTapeTM.visitedByTapeHead
      (Turing.Cfg.mapState Sum.inl (Turing.embedSilentCfg ι cap tapes heads pre out₀ c)) t j =
    Turing.MultiTapeTM.visitedByTapeHead (Turing.embedSilentCfg ι cap tapes heads pre out₀ c) t j
@Turing.embedSilentCfg : {m k : ℕ} →
  {S : Type u_1} →
    {Symbol : Type u_2} →
      {x : List Symbol} →
        (Fin m ↪ Fin k) →
          Fin k →
            (Fin k → ℤ → Option Symbol) →
              (Fin k → ℤ) → List Symbol → List Symbol → Turing.Cfg m Symbol S x → Turing.Cfg k Symbol S x
@Turing.embedSilentCfg_selected_tape : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol}
  (ι : Fin m ↪ Fin k) (cap : Fin k) (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ) (pre out₀ : List Symbol)
  (c : Turing.Cfg m Symbol S x) (i : Fin m),
  (Turing.embedSilentCfg ι cap tapes heads pre out₀ c).workTapes (ι i) = c.workTapes i
@Turing.embedSilentCfg_selected_pos : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol}
  (ι : Fin m ↪ Fin k) (cap : Fin k) (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ) (pre out₀ : List Symbol)
  (c : Turing.Cfg m Symbol S x) (i : Fin m),
  (Turing.embedSilentCfg ι cap tapes heads pre out₀ c).workTapePos (ι i) = c.workTapePos i
@Turing.embedSilentCfg_cap : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol} (ι : Fin m ↪ Fin k),
  ∀ cap ∉ Set.range ⇑ι,
    ∀ (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ) (pre out₀ : List Symbol) (c : Turing.Cfg m Symbol S x),
      (Turing.embedSilentCfg ι cap tapes heads pre out₀ c).workTapes cap = Turing.FinTM.bufferTape (pre ++ c.output) ∧
        (Turing.embedSilentCfg ι cap tapes heads pre out₀ c).workTapePos cap = ↑(pre ++ c.output).length
@Turing.phaseHostTM : {k : ℕ} →
  {Γ I : Type} →
    {Ph : I → Type} →
      ((i : I) → Turing.MultiTapeTM k Γ (Ph i)) →
        (i : I) × Ph i → ((i : I) → Ph i → Option ((i : I) × Ph i)) → Turing.MultiTapeTM k Γ ((i : I) × Ph i)
@Turing.phaseHostTM_run : ∀ {k : ℕ} {Γ I : Type} {Ph : I → Type} (M : (i : I) → Turing.MultiTapeTM k Γ (Ph i))
  (q0 : (i : I) × Ph i) (red : (i : I) → Ph i → Option ((i : I) × Ph i)) (i : I) {x : List Γ}
  (c c' : Turing.Cfg k Γ (Ph i) x) (T : ℕ),
  Turing.MultiTapeTM.runFrom c T = c' →
    ∀ (s' : Ph i),
      c'.state = some s' →
        ∀ (q' : (i : I) × Ph i),
          red i s' = some q' →
            (∀ u < T, ∀ (s : Ph i), (Turing.MultiTapeTM.runFrom c u).state = some s → red i s = none) →
              (∀ u ≤ T,
                  Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState (Sigma.mk i) c) u =
                    Turing.Cfg.mapState (Sigma.mk i) (Turing.MultiTapeTM.runFrom c u)) ∧
                Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState (Sigma.mk i) c) (T + 1) =
                  Turing.Cfg.mapState (fun x => q') c'
@Turing.seamCompTM : {k : ℕ} →
  {S₁ : Type u_1} →
    {S₂ : Type u_2} →
      {Symbol : Type u_3} →
        [DecidableEq S₁] →
          Turing.MultiTapeTM k Symbol S₁ →
            S₁ → Turing.MultiTapeTM k Symbol S₂ → S₂ → Turing.MultiTapeTM k Symbol (S₁ ⊕ S₂)
@Turing.seamReleaseTM : {k : ℕ} →
  {S : Type u_1} → {Symbol : Type u_2} → Turing.MultiTapeTM k Symbol S → S → Turing.MultiTapeTM k Symbol (Unit ⊕ S)
@Turing.seamReleaseTM_runFrom_pos : ∀ {k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol}
  (M : Turing.MultiTapeTM k Symbol S) (anchor : S) (c : Turing.Cfg k Symbol S x),
  c.state = some anchor →
    ∀ (t : ℕ),
      0 < t →
        Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState (fun x => Sum.inl ()) c) t =
          Turing.Cfg.mapState Sum.inr (Turing.MultiTapeTM.runFrom c t)
@Turing.Cfg.mapState : {k : ℕ} →
  {Symbol : Type u_1} →
    {State : Type u_2} →
      {State' : Type u_3} →
        {input : List Symbol} → (State → State') → Turing.Cfg k Symbol State input → Turing.Cfg k Symbol State' input
@Turing.MultiTapeTM.runFrom_mapState_of_agreeOn : ∀ {Symbol : Type u_1} {k : ℕ} {S H : Type} {x : List Symbol}
  (src : Turing.MultiTapeTM k Symbol S) (host : Turing.MultiTapeTM k Symbol H) (emb : S ↪ H) (good : S → Prop),
  (∀ (q : S),
      good q →
        ∀ (inp : Option Symbol) (work : Fin k → Option Symbol),
          host.tr (emb q) inp work = Turing.Action.mapState (⇑emb) (src.tr q inp work)) →
    ∀ (c : Turing.Cfg k Symbol S x) (t : ℕ),
      (∀ u < t, ∀ (q : S), (Turing.MultiTapeTM.runFrom c u).state = some q → good q) →
        Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState (⇑emb) c) t =
          Turing.Cfg.mapState (⇑emb) (Turing.MultiTapeTM.runFrom c t)
@Turing.copyTM_run_ofCfg : ∀ {Symbol : Type u_1} {k : ℕ} {x : List Symbol} (src dst : Fin k),
  src ≠ dst →
    ∀ (w : List Symbol) (d : Turing.Cfg k Symbol Turing.SweepPhase x),
      d.state = some Turing.SweepPhase.sweep →
        (∀ (p : ℤ), -1 ≤ p → p ≤ ↑w.length → d.workTapes src (d.workTapePos src + p) = Turing.FinTM.bufferTape w p) →
          Turing.MultiTapeTM.runFrom d (2 * w.length + 2) =
              { state := some Turing.SweepPhase.done, inputPos := d.inputPos,
                workTapes := fun j q =>
                  if j = dst ∧ d.workTapePos j ≤ q ∧ q < d.workTapePos j + ↑w.length then
                    Turing.FinTM.bufferTape w (q - d.workTapePos j)
                  else d.workTapes j q,
                workTapePos := d.workTapePos, output := d.output } ∧
            (∀ t < 2 * w.length + 2, (Turing.MultiTapeTM.runFrom d t).state ≠ some Turing.SweepPhase.done) ∧
              ∀ (j : Fin k),
                ∀ t ≤ 2 * w.length + 2,
                  if j = src ∨ j = dst then
                    (Turing.MultiTapeTM.runFrom d t).workTapePos j ∈
                      Finset.Icc (d.workTapePos j - 1) (d.workTapePos j + ↑w.length)
                  else (Turing.MultiTapeTM.runFrom d t).workTapePos j = d.workTapePos j
@Turing.copyMapTM_run_ofCfg : ∀ {Symbol : Type u_1} {Δ : Type u_2} {k : ℕ} {x : List Symbol} (src dst : Fin k),
  src ≠ dst →
    ∀ (extract : Symbol → Δ) (merge : Option Symbol → Δ → Symbol) (w : List Symbol)
      (d : Turing.Cfg k Symbol Turing.SweepPhase x),
      d.state = some Turing.SweepPhase.sweep →
        (∀ (p : ℤ), -1 ≤ p → p ≤ ↑w.length → d.workTapes src (d.workTapePos src + p) = Turing.FinTM.bufferTape w p) →
          Turing.MultiTapeTM.runFrom d (2 * w.length + 2) =
              { state := some Turing.SweepPhase.done, inputPos := d.inputPos,
                workTapes := fun j q =>
                  if j = dst ∧ d.workTapePos j ≤ q ∧ q < d.workTapePos j + ↑w.length then
                    Option.map (fun γ => merge (d.workTapes j q) (extract γ))
                      (Turing.FinTM.bufferTape w (q - d.workTapePos j))
                  else d.workTapes j q,
                workTapePos := d.workTapePos, output := d.output } ∧
            (∀ t < 2 * w.length + 2, (Turing.MultiTapeTM.runFrom d t).state ≠ some Turing.SweepPhase.done) ∧
              ∀ (j : Fin k),
                ∀ t ≤ 2 * w.length + 2,
                  if j = src ∨ j = dst then
                    (Turing.MultiTapeTM.runFrom d t).workTapePos j ∈
                      Finset.Icc (d.workTapePos j - 1) (d.workTapePos j + ↑w.length)
                  else (Turing.MultiTapeTM.runFrom d t).workTapePos j = d.workTapePos j
@Turing.clearTM_run_ofCfg : ∀ {Symbol : Type u_1} {k : ℕ} {x : List Symbol} (i : Fin k) (w : List Symbol)
  (d : Turing.Cfg k Symbol Turing.SweepPhase x),
  d.state = some Turing.SweepPhase.sweep →
    (∀ (p : ℤ), -1 ≤ p → p ≤ ↑w.length → d.workTapes i (d.workTapePos i + p) = Turing.FinTM.bufferTape w p) →
      Turing.MultiTapeTM.runFrom d (2 * w.length + 2) =
          { state := some Turing.SweepPhase.done, inputPos := d.inputPos,
            workTapes := fun j q =>
              if j = i ∧ d.workTapePos j ≤ q ∧ q < d.workTapePos j + ↑w.length then none else d.workTapes j q,
            workTapePos := d.workTapePos, output := d.output } ∧
        (∀ t < 2 * w.length + 2, (Turing.MultiTapeTM.runFrom d t).state ≠ some Turing.SweepPhase.done) ∧
          ∀ (j : Fin k),
            ∀ t ≤ 2 * w.length + 2,
              if j = i then
                (Turing.MultiTapeTM.runFrom d t).workTapePos j ∈
                  Finset.Icc (d.workTapePos j - 1) (d.workTapePos j + ↑w.length)
              else (Turing.MultiTapeTM.runFrom d t).workTapePos j = d.workTapePos j
@Turing.skipTM_run_ofCfg : ∀ {Symbol : Type u_1} {k : ℕ} {x : List Symbol} (i : Fin k) (w : List Symbol)
  (d : Turing.Cfg k Symbol Turing.SeekPhase x),
  d.state = some Turing.SeekPhase.run →
    (∀ (p : ℤ), 0 ≤ p → p ≤ ↑w.length → d.workTapes i (d.workTapePos i + p) = Turing.FinTM.bufferTape w p) →
      Turing.MultiTapeTM.runFrom d (w.length + 1) =
          { state := some Turing.SeekPhase.done, inputPos := d.inputPos, workTapes := d.workTapes,
            workTapePos := Function.update d.workTapePos i (d.workTapePos i + ↑w.length + 1), output := d.output } ∧
        (∀ t < w.length + 1, (Turing.MultiTapeTM.runFrom d t).state ≠ some Turing.SeekPhase.done) ∧
          ∀ (j : Fin k),
            ∀ t ≤ w.length + 1,
              if j = i then
                (Turing.MultiTapeTM.runFrom d t).workTapePos j ∈
                  Finset.Icc (d.workTapePos j) (d.workTapePos j + ↑w.length + 1)
              else (Turing.MultiTapeTM.runFrom d t).workTapePos j = d.workTapePos j
@Turing.skipBackTM_run_ofCfg : ∀ {Symbol : Type u_1} {k : ℕ} {x : List Symbol} (i : Fin k) (u : List Symbol)
  (d : Turing.Cfg k Symbol Turing.SeekPhase x),
  d.state = some Turing.SeekPhase.run →
    (∀ (p : ℤ),
        -1 ≤ p → p ≤ ↑u.length → d.workTapes i (d.workTapePos i - ↑u.length - 1 + p) = Turing.FinTM.bufferTape u p) →
      Turing.MultiTapeTM.runFrom d (u.length + 3) =
          { state := some Turing.SeekPhase.done, inputPos := d.inputPos, workTapes := d.workTapes,
            workTapePos := Function.update d.workTapePos i (d.workTapePos i - ↑u.length - 1), output := d.output } ∧
        (∀ t < u.length + 3, (Turing.MultiTapeTM.runFrom d t).state ≠ some Turing.SeekPhase.done) ∧
          ∀ (j : Fin k),
            ∀ t ≤ u.length + 3,
              if j = i then
                (Turing.MultiTapeTM.runFrom d t).workTapePos j ∈
                  Finset.Icc (d.workTapePos j - ↑u.length - 2) (d.workTapePos j)
              else (Turing.MultiTapeTM.runFrom d t).workTapePos j = d.workTapePos j
@Turing.seekEndTM_run_ofCfg : ∀ {Symbol : Type u_1} {k : ℕ} {x : List Symbol} (i : Fin k) (ws : List (List Symbol)),
  ws ≠ [] →
    (∀ u ∈ ws, u ≠ []) →
      ∀ (d : Turing.Cfg k Symbol Turing.SeekPhase x),
        d.state = some Turing.SeekPhase.run →
          (∀ (p : ℤ),
              0 ≤ p →
                p ≤ ↑(Turing.fieldOffset ws ws.length) → d.workTapes i (d.workTapePos i + p) = Turing.fieldsTape ws p) →
            Turing.MultiTapeTM.runFrom d (Turing.fieldOffset ws ws.length + 1) =
                { state := some Turing.SeekPhase.done, inputPos := d.inputPos, workTapes := d.workTapes,
                  workTapePos := Function.update d.workTapePos i (d.workTapePos i + ↑(Turing.fieldOffset ws ws.length)),
                  output := d.output } ∧
              (∀ t < Turing.fieldOffset ws ws.length + 1,
                  (Turing.MultiTapeTM.runFrom d t).state ≠ some Turing.SeekPhase.done) ∧
                ∀ (j : Fin k),
                  ∀ t ≤ Turing.fieldOffset ws ws.length + 1,
                    if j = i then
                      (Turing.MultiTapeTM.runFrom d t).workTapePos j ∈
                        Finset.Icc (d.workTapePos j) (d.workTapePos j + ↑(Turing.fieldOffset ws ws.length))
                    else (Turing.MultiTapeTM.runFrom d t).workTapePos j = d.workTapePos j
@Turing.walkTM_run_ofCfg : ∀ {Symbol : Type u_1} {k : ℕ} {x : List Symbol} (src : Fin k) (moved : Fin k → Prop)
  [inst : DecidablePred moved],
  moved src →
    ∀ (dir : SignType) (w : List Symbol) (d : Turing.Cfg k Symbol Turing.SeekPhase x),
      d.state = some Turing.SeekPhase.run →
        (∀ p ≤ w.length, d.workTapes src (d.workTapePos src + ↑dir * ↑p) = Turing.FinTM.bufferTape w ↑p) →
          Turing.MultiTapeTM.runFrom d (w.length + 1) =
              { state := some Turing.SeekPhase.done, inputPos := d.inputPos, workTapes := d.workTapes,
                workTapePos := fun j => d.workTapePos j + if moved j then ↑dir * ↑(w.length + 1) else 0,
                output := d.output } ∧
            (∀ t < w.length + 1, (Turing.MultiTapeTM.runFrom d t).state ≠ some Turing.SeekPhase.done) ∧
              ∀ (j : Fin k),
                ∀ t ≤ w.length + 1,
                  (Turing.MultiTapeTM.runFrom d t).workTapePos j = d.workTapePos j + if moved j then ↑dir * ↑t else 0
@Turing.FinTM.timed_rewind : ∀ {k : ℕ} {S : Type} {x : List Bool} (tm : Turing.MultiTapeTM k Bool S) (start scan : S)
  (dest : Option S),
  (∀ (inp : Option Bool) (work : Fin k → Option Bool),
      tm.tr start inp work = Turing.FinTM.controlAction SignType.neg (some scan)) →
    (∀ (inp : Option Bool) (work : Fin k → Option Bool),
        tm.tr scan inp work =
          match inp with
          | some val => Turing.FinTM.controlAction SignType.neg (some scan)
          | none => Turing.FinTM.controlAction SignType.pos dest) →
      ∀ (c : Turing.Cfg k Bool S x),
        c.state = some start →
          ∃ r ≤ ↑c.inputPos + 2,
            Turing.MultiTapeTM.runFrom c r =
              { state := dest, inputPos := 1, workTapes := c.workTapes, workTapePos := c.workTapePos,
                output := c.output }
@Turing.MultiTapeTM.spaceUsed_le_mul_succ : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {input : List Symbol}
  (tm : Turing.MultiTapeTM k Symbol State) (cfg : Turing.Cfg k Symbol State input) (t : ℕ),
  Turing.MultiTapeTM.spaceUsed cfg t ≤ k * (t + 1)
@Turing.tapeAction : {k : ℕ} →
  {Symbol : Type u_1} →
    {State : Type u_2} → Fin k → SignType → Option (Option Symbol) → SignType → State → Turing.Action k Symbol State
@Turing.inputMoveAction : {k : ℕ} →
  {Symbol : Type u_1} → {State : Type u_2} → SignType → State → Turing.Action k Symbol State
@Turing.step_of_tapeAction_move : ∀ {Symbol : Type u_1} {State : Type u_2} {k : ℕ} {x : List Symbol}
  (M : Turing.MultiTapeTM k Symbol State) (c : Turing.Cfg k Symbol State x) {q q' : State} (i : Fin k)
  (inp m : SignType),
  c.state = some q →
    M.tr q c.inputSymbol c.workTapeSymbols = Turing.tapeAction i inp none m q' →
      Turing.MultiTapeTM.step c =
        { state := some q', inputPos := Turing.moveInputPos c.inputPos inp, workTapes := c.workTapes,
          workTapePos := Function.update c.workTapePos i (c.workTapePos i + ↑m), output := c.output }
@Turing.step_of_tapeAction_write : ∀ {Symbol : Type u_1} {State : Type u_2} {k : ℕ} {x : List Symbol}
  (M : Turing.MultiTapeTM k Symbol State) (c : Turing.Cfg k Symbol State x) {q q' : State} (i : Fin k) (inp : SignType)
  (s : Option Symbol) (m : SignType),
  c.state = some q →
    M.tr q c.inputSymbol c.workTapeSymbols = Turing.tapeAction i inp (some s) m q' →
      Turing.MultiTapeTM.step c =
        { state := some q', inputPos := Turing.moveInputPos c.inputPos inp,
          workTapes := Function.update c.workTapes i (Function.update (c.workTapes i) (c.workTapePos i) s),
          workTapePos := Function.update c.workTapePos i (c.workTapePos i + ↑m), output := c.output }
@Turing.step_of_inputMoveAction : ∀ {Symbol : Type u_1} {State : Type u_2} {k : ℕ} {x : List Symbol}
  (M : Turing.MultiTapeTM k Symbol State) (c : Turing.Cfg k Symbol State x) {q q' : State} (inp : SignType),
  c.state = some q →
    M.tr q c.inputSymbol c.workTapeSymbols = Turing.inputMoveAction inp q' →
      Turing.MultiTapeTM.step c =
        { state := some q', inputPos := Turing.moveInputPos c.inputPos inp, workTapes := c.workTapes,
          workTapePos := c.workTapePos, output := c.output }
@Turing.MultiTapeTM.runFrom_add : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  {tm : Turing.MultiTapeTM k Symbol State} (cfg : Turing.Cfg k Symbol State input) (a b : ℕ),
  Turing.MultiTapeTM.runFrom cfg (a + b) = Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.runFrom cfg a) b
@Turing.MultiTapeTM.runFrom_succ_eq_step' : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  {tm : Turing.MultiTapeTM k Symbol State} {cfg : Turing.Cfg k Symbol State input} {t : ℕ},
  Turing.MultiTapeTM.runFrom cfg (t + 1) = Turing.MultiTapeTM.step (Turing.MultiTapeTM.runFrom cfg t)
@Turing.serializeK_eq : ∀ {k n : ℕ} (M : Turing.MultiTapeTM k Bool (Fin (n + 1))),
  Turing.serializeK M = Turing.pairEncode n.bits (Turing.unaryFin M.q₀ ++ Turing.tableBitsK M.tr)
Turing.pairEncode_eq : ∀ (x α : List Bool),
  Turing.pairEncode x α = List.flatMap (fun b => [b, b]) x ++ [false, true] ++ α
@Turing.unaryFin_eq : ∀ {n : ℕ} (s : Fin n), Turing.unaryFin s = List.replicate (↑s) true ++ [false]
@Turing.MultiTapeTM.initCfg_eq : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2}
  {tm : Turing.MultiTapeTM k Symbol State} (input : List Symbol),
  Turing.MultiTapeTM.initCfg input = Turing.Cfg.init tm.q₀ input
@Turing.Cfg.init_state : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} (q₀ : State) (input : List Symbol),
  (Turing.Cfg.init q₀ input).state = some q₀
@Turing.Cfg.init_inputPos : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} (q₀ : State) (input : List Symbol),
  (Turing.Cfg.init q₀ input).inputPos = 1
@Turing.Cfg.init_workTapes : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} (q₀ : State) (input : List Symbol)
  (x : Fin k) (x_1 : ℤ), (Turing.Cfg.init q₀ input).workTapes x x_1 = none
@Turing.Cfg.init_workTapePos : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} (q₀ : State) (input : List Symbol)
  (x : Fin k), (Turing.Cfg.init q₀ input).workTapePos x = 0
@Turing.Cfg.init_output : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} (q₀ : State) (input : List Symbol),
  (Turing.Cfg.init q₀ input).output = []
@Turing.MultiTapeTM.initCfg_with_q₀ : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2}
  (tm : Turing.MultiTapeTM k Symbol State) (q : State) (x : List Symbol),
  Turing.MultiTapeTM.initCfg x = Turing.Cfg.init q x
@Turing.MultiTapeTM.runFrom_with_q₀ : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {input : List Symbol}
  (tm : Turing.MultiTapeTM k Symbol State) (q : State) (cfg : Turing.Cfg k Symbol State input) (t : ℕ),
  Turing.MultiTapeTM.runFrom cfg t = Turing.MultiTapeTM.runFrom cfg t
@Turing.FinTM.computesFunInTime_iff : ∀ {Symbol : Type} (M : Turing.FinTM Symbol) (f : List Symbol → List Symbol)
  (T : ℕ → ℕ), M.ComputesFunInTime f T ↔ ∀ (input : List Symbol), M.ComputesInTime input (f input) (T input.length)
Turing.FinTM.bufferedSecondCfg_state : ∀ (M₁ M₂ : Turing.FinTM Bool) {x y : List Bool}
  (c : Turing.Cfg M₂.k Bool M₂.State y) (b : Bool) (p : Fin (x.length + 2)) (tapes : Fin M₁.k → ℤ → Option Bool)
  (heads : Fin M₁.k → ℤ),
  (M₁.bufferedSecondCfg M₂ c b p tapes heads).state = Option.map (fun q => Sum.inr (Sum.inr (q, b))) c.state
Turing.FinTM.bufferedSecondCfg_inputPos : ∀ (M₁ M₂ : Turing.FinTM Bool) {x y : List Bool}
  (c : Turing.Cfg M₂.k Bool M₂.State y) (b : Bool) (p : Fin (x.length + 2)) (tapes : Fin M₁.k → ℤ → Option Bool)
  (heads : Fin M₁.k → ℤ), (M₁.bufferedSecondCfg M₂ c b p tapes heads).inputPos = p
Turing.FinTM.bufferedSecondCfg_workTapes : ∀ (M₁ M₂ : Turing.FinTM Bool) {x y : List Bool}
  (c : Turing.Cfg M₂.k Bool M₂.State y) (b : Bool) (p : Fin (x.length + 2)) (tapes : Fin M₁.k → ℤ → Option Bool)
  (heads : Fin M₁.k → ℤ) (a : Fin (M₁.k + (1 + M₂.k))) (a_1 : ℤ),
  (M₁.bufferedSecondCfg M₂ c b p tapes heads).workTapes a a_1 =
    Turing.FinTM.tapeBlocks tapes (Turing.FinTM.bufferTape y) c.workTapes a a_1
Turing.FinTM.bufferedSecondCfg_workTapePos : ∀ (M₁ M₂ : Turing.FinTM Bool) {x y : List Bool}
  (c : Turing.Cfg M₂.k Bool M₂.State y) (b : Bool) (p : Fin (x.length + 2)) (tapes : Fin M₁.k → ℤ → Option Bool)
  (heads : Fin M₁.k → ℤ) (a : Fin (M₁.k + (1 + M₂.k))),
  (M₁.bufferedSecondCfg M₂ c b p tapes heads).workTapePos a =
    Turing.FinTM.tapeBlocks heads (↑↑c.inputPos - 1) c.workTapePos a
Turing.FinTM.bufferedSecondCfg_output : ∀ (M₁ M₂ : Turing.FinTM Bool) {x y : List Bool}
  (c : Turing.Cfg M₂.k Bool M₂.State y) (b : Bool) (p : Fin (x.length + 2)) (tapes : Fin M₁.k → ℤ → Option Bool)
  (heads : Fin M₁.k → ℤ), (M₁.bufferedSecondCfg M₂ c b p tapes heads).output = c.output
@Turing.embedSilentCfg_unselected : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol} (ι : Fin m ↪ Fin k)
  (cap : Fin k) (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ) (pre out₀ : List Symbol)
  (c : Turing.Cfg m Symbol S x),
  ∀ j ∉ Set.range ⇑ι,
    j ≠ cap →
      (Turing.embedSilentCfg ι cap tapes heads pre out₀ c).workTapes j = tapes j ∧
        (Turing.embedSilentCfg ι cap tapes heads pre out₀ c).workTapePos j = heads j
@Turing.embedSilentCfg_state : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol} (ι : Fin m ↪ Fin k)
  (cap : Fin k) (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ) (pre out₀ : List Symbol)
  (c : Turing.Cfg m Symbol S x), (Turing.embedSilentCfg ι cap tapes heads pre out₀ c).state = c.state
@Turing.embedSilentCfg_inputPos : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol} (ι : Fin m ↪ Fin k)
  (cap : Fin k) (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ) (pre out₀ : List Symbol)
  (c : Turing.Cfg m Symbol S x), (Turing.embedSilentCfg ι cap tapes heads pre out₀ c).inputPos = c.inputPos
@Turing.embedSilentCfg_output : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol} (ι : Fin m ↪ Fin k)
  (cap : Fin k) (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ) (pre out₀ : List Symbol)
  (c : Turing.Cfg m Symbol S x), (Turing.embedSilentCfg ι cap tapes heads pre out₀ c).output = out₀
@Turing.Cfg.inputSymbol_of_zero : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  {cfg : Turing.Cfg k Symbol State input}, cfg.inputPos = 0 → cfg.inputSymbol = none
@Turing.Cfg.inputSymbol_of_end : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  {cfg : Turing.Cfg k Symbol State input}, ↑cfg.inputPos = input.length + 1 → cfg.inputSymbol = none
@Turing.Cfg.workTapeSymbols_eq : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  (cfg : Turing.Cfg k Symbol State input) (i : Fin k), cfg.workTapeSymbols i = cfg.workTapes i (cfg.workTapePos i)
@Turing.FinTM.rewind_scan : ∀ {k : ℕ} {S : Type} {x : List Bool} (tm : Turing.MultiTapeTM k Bool S) (scan : S)
  (dest : Option S),
  (∀ (inp : Option Bool) (work : Fin k → Option Bool),
      tm.tr scan inp work =
        match inp with
        | some val => Turing.FinTM.controlAction SignType.neg (some scan)
        | none => Turing.FinTM.controlAction SignType.pos dest) →
    ∀ (cfg : Turing.Cfg k Bool S x),
      cfg.state = some scan →
        ↑cfg.inputPos ≤ x.length →
          Turing.MultiTapeTM.runFrom cfg (↑cfg.inputPos + 1) =
            { state := dest, inputPos := 1, workTapes := cfg.workTapes, workTapePos := cfg.workTapePos,
              output := cfg.output }
@Turing.FinTM.controlAction_apply : ∀ {k : ℕ} {S : Type} {x : List Bool} (cfg : Turing.Cfg k Bool S x) (m : SignType)
  (q : Option S),
  (Turing.FinTM.controlAction m q).apply cfg =
    { state := q, inputPos := Turing.moveInputPos cfg.inputPos m, workTapes := cfg.workTapes,
      workTapePos := cfg.workTapePos, output := cfg.output }
@Turing.fieldOffset_zero : ∀ {Γ : Type u_1} (fs : List (List Γ)), Turing.fieldOffset fs 0 = 0
@Turing.fieldsTape_of_nonneg : ∀ {Γ : Type u_1} (fs : List (List Γ)) {z : ℤ},
  0 ≤ z → Turing.fieldsTape fs z = (Turing.joinFields fs)[z.toNat]?.join
Turing.FinTM.bufferedCompTM_k : ∀ (M₁ M₂ : Turing.FinTM Bool), (M₁.bufferedCompTM M₂).k = M₁.k + (1 + M₂.k)
Turing.FinTM.bufferedCompTM_State : ∀ (M₁ M₂ : Turing.FinTM Bool),
  (M₁.bufferedCompTM M₂).State = (Option M₁.State ⊕ Unit ⊕ M₂.State × Bool)
Turing.universalPrefixTM_k : Turing.universalPrefixTM.k = 0
Turing.universalPrefixTM_State : Turing.universalPrefixTM.State = Option Bool
Turing.prefixCanonTM_eq : ∀ (F : Turing.FinTM Bool), Turing.prefixCanonTM F = Turing.universalPrefixTM.bufferedCompTM F
@Turing.FinTM.VirtualTag_iff : ∀ {n : ℕ} (p : Fin (n + 2)) (b : Bool),
  Turing.FinTM.VirtualTag p b ↔ (↑p = 0 → b = false) ∧ (↑p = n + 1 → b = true)
@Turing.Action.mapState_inputTape : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {State' : Type u_3}
  (f : State → State') (a : Turing.Action k Symbol State), (Turing.Action.mapState f a).inputTape = a.inputTape
@Turing.Action.mapState_workTapes : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {State' : Type u_3}
  (f : State → State') (a : Turing.Action k Symbol State) (a_1 : Fin k),
  (Turing.Action.mapState f a).workTapes a_1 = a.workTapes a_1
@Turing.Action.mapState_output : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {State' : Type u_3}
  (f : State → State') (a : Turing.Action k Symbol State), (Turing.Action.mapState f a).output = a.output
@Turing.Action.mapState_state : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {State' : Type u_3}
  (f : State → State') (a : Turing.Action k Symbol State), (Turing.Action.mapState f a).state = Option.map f a.state
@Turing.Cfg.mapState_state : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {State' : Type u_3} {input : List Symbol}
  (f : State → State') (cfg : Turing.Cfg k Symbol State input),
  (Turing.Cfg.mapState f cfg).state = Option.map f cfg.state
@Turing.Cfg.mapState_inputPos : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {State' : Type u_3}
  {input : List Symbol} (f : State → State') (cfg : Turing.Cfg k Symbol State input),
  (Turing.Cfg.mapState f cfg).inputPos = cfg.inputPos
@Turing.Cfg.mapState_workTapes : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {State' : Type u_3}
  {input : List Symbol} (f : State → State') (cfg : Turing.Cfg k Symbol State input) (a : Fin k) (a_1 : ℤ),
  (Turing.Cfg.mapState f cfg).workTapes a a_1 = cfg.workTapes a a_1
@Turing.Cfg.mapState_workTapePos : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {State' : Type u_3}
  {input : List Symbol} (f : State → State') (cfg : Turing.Cfg k Symbol State input) (a : Fin k),
  (Turing.Cfg.mapState f cfg).workTapePos a = cfg.workTapePos a
@Turing.Cfg.mapState_output : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {State' : Type u_3} {input : List Symbol}
  (f : State → State') (cfg : Turing.Cfg k Symbol State input), (Turing.Cfg.mapState f cfg).output = cfg.output
Turing.FinTM.bufferedSecondCfg_workTapes_cast : ∀ (M₁ M₂ : Turing.FinTM Bool) {x y : List Bool}
  (c : Turing.Cfg M₂.k Bool M₂.State y) (b : Bool) (p : Fin (x.length + 2)) (tapes : Fin M₁.k → ℤ → Option Bool)
  (heads : Fin M₁.k → ℤ) (i : Fin (M₁.bufferedCompTM M₂).k),
  (M₁.bufferedSecondCfg M₂ c b p tapes heads).workTapes i =
    Turing.FinTM.tapeBlocks tapes (Turing.FinTM.bufferTape y) c.workTapes (Fin.cast ⋯ i)
Turing.FinTM.bufferedSecondCfg_workTapePos_cast : ∀ (M₁ M₂ : Turing.FinTM Bool) {x y : List Bool}
  (c : Turing.Cfg M₂.k Bool M₂.State y) (b : Bool) (p : Fin (x.length + 2)) (tapes : Fin M₁.k → ℤ → Option Bool)
  (heads : Fin M₁.k → ℤ) (i : Fin (M₁.bufferedCompTM M₂).k),
  (M₁.bufferedSecondCfg M₂ c b p tapes heads).workTapePos i =
    Turing.FinTM.tapeBlocks heads (↑↑c.inputPos - 1) c.workTapePos (Fin.cast ⋯ i)
@Turing.FinTM.tapeBlocks_left : ∀ {α : Type} {k l : ℕ} (a : Fin k → α) (b : α) (c : Fin l → α) (i : Fin k),
  Turing.FinTM.tapeBlocks a b c (Fin.castAdd (1 + l) i) = a i
@Turing.FinTM.tapeBlocks_buffer : ∀ {α : Type} {k l : ℕ} (a : Fin k → α) (b : α) (c : Fin l → α) (i : Fin 1),
  Turing.FinTM.tapeBlocks a b c (Fin.natAdd k (Fin.castAdd l i)) = b
@Turing.FinTM.tapeBlocks_right : ∀ {α : Type} {k l : ℕ} (a : Fin k → α) (b : α) (c : Fin l → α) (i : Fin l),
  Turing.FinTM.tapeBlocks a b c (Fin.natAdd k (Fin.natAdd 1 i)) = c i
Turing.exists_seamLayoutTM : ∀ (k : ℕ) (src tbl sm : Fin k),
  src ≠ tbl →
    src ≠ sm →
      tbl ≠ sm →
        ∃ Q x x L entry done C,
          ∀ (a v : List Bool) (q r : ℕ),
            have s := Turing.pairEncode a (List.replicate q true ++ [false] ++ v);
            r ≤ s.length →
              ∃ T ≤ C * (s.length + 1),
                ∀ {z : List Bool} (d : Turing.Cfg k Bool Q z),
                  d.state = some entry →
                    d.workTapes src = Turing.FinTM.bufferTape s →
                      d.workTapePos src = ↑r →
                        (d.workTapes tbl = fun x => none) →
                          d.workTapePos tbl = 0 →
                            (d.workTapes sm = fun x => none) →
                              d.workTapePos sm = 0 →
                                (Turing.MultiTapeTM.runFrom d T).state = some done ∧
                                  (Turing.MultiTapeTM.runFrom d T).inputPos = d.inputPos ∧
                                    ((Turing.MultiTapeTM.runFrom d T).workTapes =
                                        Function.update
                                          (Function.update (Function.update d.workTapes src fun x => none) tbl
                                            (Turing.FinTM.bufferTape v))
                                          sm fun p =>
                                          Turing.FinTM.bufferTape (List.replicate q true ++ [false]) (p - 2)) ∧
                                      (Turing.MultiTapeTM.runFrom d T).workTapePos =
                                          Function.update (Function.update (Function.update d.workTapePos src 0) tbl 0)
                                            sm 0 ∧
                                        (∀ u ≤ T, (Turing.MultiTapeTM.runFrom d u).output = d.output) ∧
                                          ∀ u < T, (Turing.MultiTapeTM.runFrom d u).state ≠ some done
Turing.StepBlock.summaryCells_eq : ∀ (summary : Option Bool) (word : List Bool) (z : ℤ),
  Turing.StepBlock.summaryCells summary word z = if z = 0 then summary else Turing.FinTM.bufferTape word (z - 2)
@Turing.FinTM.bufferTape_of_neg : ∀ {Symbol : Type u_1} (w : List Symbol) {z : ℤ},
  z < 0 → Turing.FinTM.bufferTape w z = none
@Turing.FinTM.bufferTape_eq : ∀ {Symbol : Type u_1} (w : List Symbol) (z : ℤ),
  Turing.FinTM.bufferTape w z = if 0 ≤ z then w[z.toNat]? else none
@Turing.FinTM.rewind_heads : ∀ {k : ℕ} {S : Type} {x : List Bool} (tm : Turing.MultiTapeTM k Bool S) (start scan : S)
  (dest : Option S),
  (∀ (inp : Option Bool) (work : Fin k → Option Bool),
      tm.tr start inp work = Turing.FinTM.controlAction SignType.neg (some scan)) →
    (∀ (inp : Option Bool) (work : Fin k → Option Bool),
        tm.tr scan inp work =
          match inp with
          | some val => Turing.FinTM.controlAction SignType.neg (some scan)
          | none => Turing.FinTM.controlAction SignType.pos dest) →
      ∀ (c : Turing.Cfg k Bool S x),
        c.state = some start →
          ∃ r ≤ ↑c.inputPos + 2,
            Turing.MultiTapeTM.runFrom c r =
                { state := dest, inputPos := 1, workTapes := c.workTapes, workTapePos := c.workTapePos,
                  output := c.output } ∧
              ∀ u ≤ r, (Turing.MultiTapeTM.runFrom c u).workTapePos = c.workTapePos
@Turing.FinTM.controlAction : {k : ℕ} → {S : Type} → SignType → Option S → Turing.Action k Bool S
