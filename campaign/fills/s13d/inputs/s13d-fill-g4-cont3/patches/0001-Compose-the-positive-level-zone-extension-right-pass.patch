+  intro p hleft hright
+  simp only [Cfg.mapState_workTapes, Cfg.mapState_workTapePos,
+    zr_adjustedWalk_post w d hp, if_true]
+  have he : d.workTapePos 1 + (w.length : ℤ) + 1 - w.length - 1 + p =
