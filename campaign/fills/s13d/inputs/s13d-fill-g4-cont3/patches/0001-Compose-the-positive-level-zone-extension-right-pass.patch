+      { d with
+        state := some (Sum.inr (Sum.inr SeekPhase.done))
+        workTapes := fun j q =>
+          if j = 1 ∧ d.workTapePos j ≤ q ∧ q < d.workTapePos j + (zoneCapacity D.1 : ℤ)
