+private lemma zr_sum_desc_eq (a b N n : ℕ) (hn : n ≤ N) :
+    ∑ m ∈ Finset.range (n + 1), (a * 2 ^ (N - m) + b) + a * 2 ^ (N - n) =
+      a * 2 ^ (N + 1) + b * (n + 1) := by
