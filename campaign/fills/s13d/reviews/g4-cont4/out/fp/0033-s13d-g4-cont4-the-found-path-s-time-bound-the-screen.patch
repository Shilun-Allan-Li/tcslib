+    (h₀ : zr_PinStep (zr_pinPeekContract x V i δ choose T₁ p₁) V T₁ T₁ p₁ p₁ τ₀ L U)
+    (h₂ : zr_PinStep C₂ (fun j => V j ∧ v j = false) T₁ T₂ p₁ p₂ τ₂ L U)
+    (hv : ∀ j, v j = choose (T₁ j i (p₁ j i + δ))) :=
+  zr_anchBranch zr_peekNe h₀ (zr_peek_verdict hv) h₂
+
