+    ∑ m ∈ Finset.range (n + 1), (a * 2 ^ (m + c) + b) + a * 2 ^ c =
+      a * 2 ^ (n + 1 + c) + b * (n + 1) := by
+  induction n with
+  | zero =>
+    rw [zero_add, Finset.sum_range_one, zero_add, pow_add, pow_one]
+    ring
+  | succ n ih =>
+    have e : 2 ^ (n + 1 + 1 + c) = 2 * 2 ^ (n + 1 + c) := by
+      rw [show n + 1 + 1 + c = n + 1 + c + 1 by ring, pow_succ]
+      ring
+    rw [Finset.sum_range_succ, e]
+    linarith
