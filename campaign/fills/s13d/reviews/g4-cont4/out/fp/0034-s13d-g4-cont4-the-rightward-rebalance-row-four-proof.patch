+  zr_tapes (zonedTape I.1.2) fun _ => none
+
+/-- The rightward row's endpoint pin: the zoned tape of the rebalanced data, scratch blank. -/
+private abbrev zr_rowT2 {k : ℕ} (t : Fin k) (I : ZoneData k × ℤ) :
