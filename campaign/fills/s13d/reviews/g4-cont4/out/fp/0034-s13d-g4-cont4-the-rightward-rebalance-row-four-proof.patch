+    rw [zr_rulerTape, if_neg (by omega)]
+  · show zr_rulerTape _ _ (I.2 + zoneRebalanceIndex true t I.1 + 2 - 1) = none
+    rw [zr_rulerTape, if_neg (by omega)]
