          {ι : Type} → {x : List Γ} → Turing.Contract M entry exits ι x → ι → Turing.Cfg k Γ S x → Fin k → ℤ
@Turing.Contract.lo : {k : ℕ} →
  {Γ S : Type} →
    {M : Turing.MultiTapeTM k Γ S} →
      {entry : S} →
        {exits : Set (Option S)} →
          {ι : Type} → {x : List Γ} → Turing.Contract M entry exits ι x → ι → Turing.Cfg k Γ S x → Fin k → ℤ
@Turing.Contract.mk : {k : ℕ} →
  {Γ S : Type} →
    {M : Turing.MultiTapeTM k Γ S} →
      {entry : S} →
        {exits : Set (Option S)} →
          {ι : Type} →
            {x : List Γ} →
              (pre : ι → Turing.Cfg k Γ S x → Prop) →
                (time : ι → Turing.Cfg k Γ S x → ℕ) →
                  (post : ι → Turing.Cfg k Γ S x → Turing.Cfg k Γ S x) →
                    (lo hi : ι → Turing.Cfg k Γ S x → Fin k → ℤ) →
                      (∀ (i : ι) (d : Turing.Cfg k Γ S x),
                          d.state = some entry → pre i d → Turing.MultiTapeTM.runFrom d (time i d) = post i d) →
                        (∀ (i : ι) (d : Turing.Cfg k Γ S x),
                            d.state = some entry → pre i d → (post i d).state ∈ exits) →
                          (∀ (i : ι) (d : Turing.Cfg k Γ S x),
                              d.state = some entry →
                                pre i d → ∀ u < time i d, (Turing.MultiTapeTM.runFrom d u).state ∉ exits) →
                            (∀ (i : ι) (d : Turing.Cfg k Γ S x),
                                d.state = some entry →
                                  pre i d →
                                    ∀ u ≤ time i d,
                                      ∀ (j : Fin k),
                                        (Turing.MultiTapeTM.runFrom d u).workTapePos j ∈
                                          Finset.Icc (lo i d j) (hi i d j)) →
                              Turing.Contract M entry exits ι x
