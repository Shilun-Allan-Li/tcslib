@Turing.Contract.inPhase_time : ∀ {k : ℕ} {Γ I : Type} {Ph : I → Type} (Mf : (i : I) → Turing.MultiTapeTM k Γ (Ph i))
  (q0 : (i : I) × Ph i) (red : (i : I) → Ph i → Option ((i : I) × Ph i)) (p : I) {s₀ : Ph p} {X : Set (Option (Ph p))}
  {ι : Type} {x : List Γ} (C : Turing.Contract (Mf p) s₀ X ι x) (hnone : none ∉ X)
  (hred : ∀ (s : Ph p), some s ∉ X → red p s = none)
  (hsome : ∀ (s : Ph p), some s ∈ X → ∃ q, red p s = some q ∧ q.fst ≠ p) (i : ι)
  (d : Turing.Cfg k Γ ((i : I) × Ph i) x),
  (Turing.Contract.inPhase Mf q0 red p C hnone hred hsome).time i d = C.time i (Turing.Cfg.mapState (fun x => s₀) d) + 1
@Turing.Contract.seq_hi : ∀ {k : ℕ} {Γ S₁ S₂ : Type} [inst : DecidableEq S₁] {M₁ : Turing.MultiTapeTM k Γ S₁}
  {M₂ : Turing.MultiTapeTM k Γ S₂} {entry₁ exit₁ : S₁} {entry₂ : S₂} {X₂ : Set (Option S₂)} {ι κ : Type} {x : List Γ}
  (C₁ : Turing.Contract M₁ entry₁ {some exit₁} ι x) (C₂ : Turing.Contract M₂ entry₂ X₂ κ x) (link : ι → κ)
  (hlink :
    ∀ (i : ι) (d : Turing.Cfg k Γ S₁ x),
      d.state = some entry₁ → C₁.pre i d → C₂.pre (link i) (Turing.Cfg.mapState (fun x => entry₂) (C₁.post i d)))
  (i : ι) (d : Turing.Cfg k Γ (S₁ ⊕ S₂) x) (j : Fin k),
  (C₁.seq C₂ link hlink).hi i d j =
    max (C₁.hi i (Turing.Cfg.mapState (fun x => entry₁) d) j)
      (C₂.hi (link i) (Turing.Cfg.mapState (fun x => entry₂) (C₁.post i (Turing.Cfg.mapState (fun x => entry₁) d))) j)
@Turing.Contract.seq_lo : ∀ {k : ℕ} {Γ S₁ S₂ : Type} [inst : DecidableEq S₁] {M₁ : Turing.MultiTapeTM k Γ S₁}
  {M₂ : Turing.MultiTapeTM k Γ S₂} {entry₁ exit₁ : S₁} {entry₂ : S₂} {X₂ : Set (Option S₂)} {ι κ : Type} {x : List Γ}
  (C₁ : Turing.Contract M₁ entry₁ {some exit₁} ι x) (C₂ : Turing.Contract M₂ entry₂ X₂ κ x) (link : ι → κ)
  (hlink :
    ∀ (i : ι) (d : Turing.Cfg k Γ S₁ x),
      d.state = some entry₁ → C₁.pre i d → C₂.pre (link i) (Turing.Cfg.mapState (fun x => entry₂) (C₁.post i d)))
  (i : ι) (d : Turing.Cfg k Γ (S₁ ⊕ S₂) x) (j : Fin k),
  (C₁.seq C₂ link hlink).lo i d j =
    min (C₁.lo i (Turing.Cfg.mapState (fun x => entry₁) d) j)
      (C₂.lo (link i) (Turing.Cfg.mapState (fun x => entry₂) (C₁.post i (Turing.Cfg.mapState (fun x => entry₁) d))) j)
@Turing.Contract.seq_positive : ∀ {k : ℕ} {Γ S₁ S₂ : Type} [inst : DecidableEq S₁] {M₁ : Turing.MultiTapeTM k Γ S₁}
  {M₂ : Turing.MultiTapeTM k Γ S₂} {entry₁ exit₁ : S₁} {entry₂ : S₂} {X₂ : Set (Option S₂)} {ι κ : Type} {x : List Γ}
  (C₁ : Turing.Contract M₁ entry₁ {some exit₁} ι x) (C₂ : Turing.Contract M₂ entry₂ X₂ κ x) (link : ι → κ)
  (hlink :
    ∀ (i : ι) (d : Turing.Cfg k Γ S₁ x),
      d.state = some entry₁ → C₁.pre i d → C₂.pre (link i) (Turing.Cfg.mapState (fun x => entry₂) (C₁.post i d))),
  (C₁.seq C₂ link hlink).Positive
@Turing.Contract.seq_post : ∀ {k : ℕ} {Γ S₁ S₂ : Type} [inst : DecidableEq S₁] {M₁ : Turing.MultiTapeTM k Γ S₁}
  {M₂ : Turing.MultiTapeTM k Γ S₂} {entry₁ exit₁ : S₁} {entry₂ : S₂} {X₂ : Set (Option S₂)} {ι κ : Type} {x : List Γ}
  (C₁ : Turing.Contract M₁ entry₁ {some exit₁} ι x) (C₂ : Turing.Contract M₂ entry₂ X₂ κ x) (link : ι → κ)
  (hlink :
    ∀ (i : ι) (d : Turing.Cfg k Γ S₁ x),
      d.state = some entry₁ → C₁.pre i d → C₂.pre (link i) (Turing.Cfg.mapState (fun x => entry₂) (C₁.post i d)))
  (i : ι) (d : Turing.Cfg k Γ (S₁ ⊕ S₂) x),
  (C₁.seq C₂ link hlink).post i d =
    Turing.Cfg.mapState Sum.inr
      (C₂.post (link i) (Turing.Cfg.mapState (fun x => entry₂) (C₁.post i (Turing.Cfg.mapState (fun x => entry₁) d))))
@Turing.Contract.seq_pre : ∀ {k : ℕ} {Γ S₁ S₂ : Type} [inst : DecidableEq S₁] {M₁ : Turing.MultiTapeTM k Γ S₁}
  {M₂ : Turing.MultiTapeTM k Γ S₂} {entry₁ exit₁ : S₁} {entry₂ : S₂} {X₂ : Set (Option S₂)} {ι κ : Type} {x : List Γ}
  (C₁ : Turing.Contract M₁ entry₁ {some exit₁} ι x) (C₂ : Turing.Contract M₂ entry₂ X₂ κ x) (link : ι → κ)
  (hlink :
    ∀ (i : ι) (d : Turing.Cfg k Γ S₁ x),
      d.state = some entry₁ → C₁.pre i d → C₂.pre (link i) (Turing.Cfg.mapState (fun x => entry₂) (C₁.post i d)))
  (i : ι) (d : Turing.Cfg k Γ (S₁ ⊕ S₂) x),
  (C₁.seq C₂ link hlink).pre i d = C₁.pre i (Turing.Cfg.mapState (fun x => entry₁) d)
@Turing.Contract.seq_time : ∀ {k : ℕ} {Γ S₁ S₂ : Type} [inst : DecidableEq S₁] {M₁ : Turing.MultiTapeTM k Γ S₁}
  {M₂ : Turing.MultiTapeTM k Γ S₂} {entry₁ exit₁ : S₁} {entry₂ : S₂} {X₂ : Set (Option S₂)} {ι κ : Type} {x : List Γ}
  (C₁ : Turing.Contract M₁ entry₁ {some exit₁} ι x) (C₂ : Turing.Contract M₂ entry₂ X₂ κ x) (link : ι → κ)
  (hlink :
    ∀ (i : ι) (d : Turing.Cfg k Γ S₁ x),
      d.state = some entry₁ → C₁.pre i d → C₂.pre (link i) (Turing.Cfg.mapState (fun x => entry₂) (C₁.post i d)))
  (i : ι) (d : Turing.Cfg k Γ (S₁ ⊕ S₂) x),
  (C₁.seq C₂ link hlink).time i d =
    C₁.time i (Turing.Cfg.mapState (fun x => entry₁) d) + 1 +
      C₂.time (link i) (Turing.Cfg.mapState (fun x => entry₂) (C₁.post i (Turing.Cfg.mapState (fun x => entry₁) d)))
@Turing.Contract.trans_hi : ∀ {k : ℕ} {Γ S : Type} {M : Turing.MultiTapeTM k Γ S} {e₁ e₂ : S} {X : Set (Option S)}
  {ι κ : Type} {x : List Γ} (C₁ : Turing.Contract M e₁ {some e₂} ι x) (C₂ : Turing.Contract M e₂ X κ x) (link : ι → κ)
  (hlink : ∀ (i : ι) (d : Turing.Cfg k Γ S x), d.state = some e₁ → C₁.pre i d → C₂.pre (link i) (C₁.post i d))
  (hX :
    ∀ (i : ι) (d : Turing.Cfg k Γ S x),
      d.state = some e₁ → C₁.pre i d → ∀ u < C₁.time i d, (Turing.MultiTapeTM.runFrom d u).state ∉ X)
  (i : ι) (d : Turing.Cfg k Γ S x) (j : Fin k),
  (C₁.trans C₂ link hlink hX).hi i d j = max (C₁.hi i d j) (C₂.hi (link i) (C₁.post i d) j)
@Turing.Contract.trans_lo : ∀ {k : ℕ} {Γ S : Type} {M : Turing.MultiTapeTM k Γ S} {e₁ e₂ : S} {X : Set (Option S)}
  {ι κ : Type} {x : List Γ} (C₁ : Turing.Contract M e₁ {some e₂} ι x) (C₂ : Turing.Contract M e₂ X κ x) (link : ι → κ)
  (hlink : ∀ (i : ι) (d : Turing.Cfg k Γ S x), d.state = some e₁ → C₁.pre i d → C₂.pre (link i) (C₁.post i d))
  (hX :
    ∀ (i : ι) (d : Turing.Cfg k Γ S x),
      d.state = some e₁ → C₁.pre i d → ∀ u < C₁.time i d, (Turing.MultiTapeTM.runFrom d u).state ∉ X)
  (i : ι) (d : Turing.Cfg k Γ S x) (j : Fin k),
  (C₁.trans C₂ link hlink hX).lo i d j = min (C₁.lo i d j) (C₂.lo (link i) (C₁.post i d) j)
@Turing.Contract.trans_positive : ∀ {k : ℕ} {Γ S : Type} {M : Turing.MultiTapeTM k Γ S} {ι : Type} {x : List Γ}
  {e₁ e₂ : S} {X : Set (Option S)} {κ : Type} (C₁ : Turing.Contract M e₁ {some e₂} ι x)
  (C₂ : Turing.Contract M e₂ X κ x) (link : ι → κ)
  (hlink : ∀ (i : ι) (d : Turing.Cfg k Γ S x), d.state = some e₁ → C₁.pre i d → C₂.pre (link i) (C₁.post i d))
  (hX :
    ∀ (i : ι) (d : Turing.Cfg k Γ S x),
      d.state = some e₁ → C₁.pre i d → ∀ u < C₁.time i d, (Turing.MultiTapeTM.runFrom d u).state ∉ X),
  C₁.Positive → (C₁.trans C₂ link hlink hX).Positive
@Turing.Contract.trans_post : ∀ {k : ℕ} {Γ S : Type} {M : Turing.MultiTapeTM k Γ S} {e₁ e₂ : S} {X : Set (Option S)}
  {ι κ : Type} {x : List Γ} (C₁ : Turing.Contract M e₁ {some e₂} ι x) (C₂ : Turing.Contract M e₂ X κ x) (link : ι → κ)
  (hlink : ∀ (i : ι) (d : Turing.Cfg k Γ S x), d.state = some e₁ → C₁.pre i d → C₂.pre (link i) (C₁.post i d))
  (hX :
    ∀ (i : ι) (d : Turing.Cfg k Γ S x),
      d.state = some e₁ → C₁.pre i d → ∀ u < C₁.time i d, (Turing.MultiTapeTM.runFrom d u).state ∉ X)
  (i : ι) (d : Turing.Cfg k Γ S x), (C₁.trans C₂ link hlink hX).post i d = C₂.post (link i) (C₁.post i d)
@Turing.Contract.trans_pre : ∀ {k : ℕ} {Γ S : Type} {M : Turing.MultiTapeTM k Γ S} {e₁ e₂ : S} {X : Set (Option S)}
  {ι κ : Type} {x : List Γ} (C₁ : Turing.Contract M e₁ {some e₂} ι x) (C₂ : Turing.Contract M e₂ X κ x) (link : ι → κ)
  (hlink : ∀ (i : ι) (d : Turing.Cfg k Γ S x), d.state = some e₁ → C₁.pre i d → C₂.pre (link i) (C₁.post i d))
  (hX :
    ∀ (i : ι) (d : Turing.Cfg k Γ S x),
      d.state = some e₁ → C₁.pre i d → ∀ u < C₁.time i d, (Turing.MultiTapeTM.runFrom d u).state ∉ X)
  (a : ι) (a_1 : Turing.Cfg k Γ S x), (C₁.trans C₂ link hlink hX).pre a a_1 = C₁.pre a a_1
@Turing.Contract.trans_time : ∀ {k : ℕ} {Γ S : Type} {M : Turing.MultiTapeTM k Γ S} {e₁ e₂ : S} {X : Set (Option S)}
  {ι κ : Type} {x : List Γ} (C₁ : Turing.Contract M e₁ {some e₂} ι x) (C₂ : Turing.Contract M e₂ X κ x) (link : ι → κ)
  (hlink : ∀ (i : ι) (d : Turing.Cfg k Γ S x), d.state = some e₁ → C₁.pre i d → C₂.pre (link i) (C₁.post i d))
  (hX :
    ∀ (i : ι) (d : Turing.Cfg k Γ S x),
      d.state = some e₁ → C₁.pre i d → ∀ u < C₁.time i d, (Turing.MultiTapeTM.runFrom d u).state ∉ X)
  (i : ι) (d : Turing.Cfg k Γ S x), (C₁.trans C₂ link hlink hX).time i d = C₁.time i d + C₂.time (link i) (C₁.post i d)
@Turing.ReturnContract.release_hi : ∀ {k : ℕ} {Γ S : Type} {M : Turing.MultiTapeTM k Γ S} {anchor : S} {ι : Type}
  {x : List Γ} (C : Turing.ReturnContract M anchor ι x) (i : ι) (d : Turing.Cfg k Γ (Unit ⊕ S) x) (a : Fin k),
  C.release.hi i d a = C.hi i (Turing.Cfg.mapState (fun x => anchor) d) a
@Turing.ReturnContract.release_lo : ∀ {k : ℕ} {Γ S : Type} {M : Turing.MultiTapeTM k Γ S} {anchor : S} {ι : Type}
  {x : List Γ} (C : Turing.ReturnContract M anchor ι x) (i : ι) (d : Turing.Cfg k Γ (Unit ⊕ S) x) (a : Fin k),
  C.release.lo i d a = C.lo i (Turing.Cfg.mapState (fun x => anchor) d) a
@Turing.ReturnContract.release_positive : ∀ {k : ℕ} {Γ S : Type} {M : Turing.MultiTapeTM k Γ S} {anchor : S} {ι : Type}
  {x : List Γ} (C : Turing.ReturnContract M anchor ι x), C.release.Positive
@Turing.ReturnContract.release_post : ∀ {k : ℕ} {Γ S : Type} {M : Turing.MultiTapeTM k Γ S} {anchor : S} {ι : Type}
  {x : List Γ} (C : Turing.ReturnContract M anchor ι x) (i : ι) (d : Turing.Cfg k Γ (Unit ⊕ S) x),
  C.release.post i d = Turing.Cfg.mapState Sum.inr (C.post i (Turing.Cfg.mapState (fun x => anchor) d))
@Turing.ReturnContract.release_pre : ∀ {k : ℕ} {Γ S : Type} {M : Turing.MultiTapeTM k Γ S} {anchor : S} {ι : Type}
  {x : List Γ} (C : Turing.ReturnContract M anchor ι x) (i : ι) (d : Turing.Cfg k Γ (Unit ⊕ S) x),
  C.release.pre i d = C.pre i (Turing.Cfg.mapState (fun x => anchor) d)
@Turing.ReturnContract.release_time : ∀ {k : ℕ} {Γ S : Type} {M : Turing.MultiTapeTM k Γ S} {anchor : S} {ι : Type}
  {x : List Γ} (C : Turing.ReturnContract M anchor ι x) (i : ι) (d : Turing.Cfg k Γ (Unit ⊕ S) x),
  C.release.time i d = C.time i (Turing.Cfg.mapState (fun x => anchor) d)
@Turing.Round.cut_some : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} {M : Turing.MultiTapeTM k Γ S} {a : S} {E : Set (Option S)}
  {P : (Fin k → ℤ) → Prop} {c c' : Turing.Cfg k Γ S x} {t : ℕ},
  Turing.Round M a E P c c' t →
    ∀ (u : ℕ), 0 < u → u < t → ∃ s, (Turing.MultiTapeTM.runFrom c u).state = some s ∧ s ≠ a ∧ some s ∉ E
@Turing.Round.segment : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} {M : Turing.MultiTapeTM k Γ S} {a : S} {E : Set (Option S)}
  {P : (Fin k → ℤ) → Prop} {c c' : Turing.Cfg k Γ S x} {t : ℕ},
  Turing.Round M a E P c c' t → some a ∉ E → Turing.Segment M E P c c' t
@Turing.Round.time_box : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} {M : Turing.MultiTapeTM k Γ S} {a : S} {E : Set (Option S)}
  {P : (Fin k → ℤ) → Prop} {c c' : Turing.Cfg k Γ S x} {t : ℕ},
  Turing.Round M a E P c c' t →
    Turing.Round M a E (Turing.HeadBox (fun j => c.workTapePos j - ↑t) fun j => c.workTapePos j + ↑t) c c' t
@Turing.RoundContract.release_hi : ∀ {k : ℕ} {Γ S : Type} {M : Turing.MultiTapeTM k Γ S} {anchor : S}
  {escape : Set (Option S)} {ι : Type} {x : List Γ} (R : Turing.RoundContract M anchor escape ι x) (i : ι)
  (d : Turing.Cfg k Γ (Unit ⊕ S) x) (a : Fin k), R.release.hi i d a = R.hi i (Turing.Cfg.mapState (fun x => anchor) d) a
@Turing.RoundContract.release_lo : ∀ {k : ℕ} {Γ S : Type} {M : Turing.MultiTapeTM k Γ S} {anchor : S}
  {escape : Set (Option S)} {ι : Type} {x : List Γ} (R : Turing.RoundContract M anchor escape ι x) (i : ι)
  (d : Turing.Cfg k Γ (Unit ⊕ S) x) (a : Fin k), R.release.lo i d a = R.lo i (Turing.Cfg.mapState (fun x => anchor) d) a
@Turing.RoundContract.release_positive : ∀ {k : ℕ} {Γ S : Type} {M : Turing.MultiTapeTM k Γ S} {anchor : S}
  {escape : Set (Option S)} {ι : Type} {x : List Γ} (R : Turing.RoundContract M anchor escape ι x), R.release.Positive
@Turing.RoundContract.release_post : ∀ {k : ℕ} {Γ S : Type} {M : Turing.MultiTapeTM k Γ S} {anchor : S}
  {escape : Set (Option S)} {ι : Type} {x : List Γ} (R : Turing.RoundContract M anchor escape ι x) (i : ι)
  (d : Turing.Cfg k Γ (Unit ⊕ S) x),
  R.release.post i d = Turing.Cfg.mapState Sum.inr (R.post i (Turing.Cfg.mapState (fun x => anchor) d))
@Turing.RoundContract.release_pre : ∀ {k : ℕ} {Γ S : Type} {M : Turing.MultiTapeTM k Γ S} {anchor : S}
  {escape : Set (Option S)} {ι : Type} {x : List Γ} (R : Turing.RoundContract M anchor escape ι x) (i : ι)
  (d : Turing.Cfg k Γ (Unit ⊕ S) x), R.release.pre i d = R.pre i (Turing.Cfg.mapState (fun x => anchor) d)
@Turing.RoundContract.release_time : ∀ {k : ℕ} {Γ S : Type} {M : Turing.MultiTapeTM k Γ S} {anchor : S}
  {escape : Set (Option S)} {ι : Type} {x : List Γ} (R : Turing.RoundContract M anchor escape ι x) (i : ι)
  (d : Turing.Cfg k Γ (Unit ⊕ S) x), R.release.time i d = R.time i (Turing.Cfg.mapState (fun x => anchor) d)
@Turing.Segment.and : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} {M : Turing.MultiTapeTM k Γ S} {F : Set (Option S)}
  {P Q : (Fin k → ℤ) → Prop} {a b : Turing.Cfg k Γ S x} {t : ℕ},
  Turing.Segment M F P a b t → Turing.Segment M F Q a b t → Turing.Segment M F (fun p => P p ∧ Q p) a b t
@Turing.Segment.cons : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} {M : Turing.MultiTapeTM k Γ S} {F : Set (Option S)}
  {P : (Fin k → ℤ) → Prop} {a a₁ b : Turing.Cfg k Γ S x} {t : ℕ},
  Turing.MultiTapeTM.step a = a₁ →
    a.state ∉ F → P a.workTapePos → Turing.Segment M F P a₁ b t → Turing.Segment M F P a b (1 + t)
@Turing.Segment.drop : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} {M : Turing.MultiTapeTM k Γ S} {F : Set (Option S)}
  {P : (Fin k → ℤ) → Prop} {a b : Turing.Cfg k Γ S x} {t u : ℕ},
  Turing.Segment M F P a b t → u ≤ t → Turing.Segment M F P (Turing.MultiTapeTM.runFrom a u) b (t - u)
@Turing.Segment.live : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} {M : Turing.MultiTapeTM k Γ S} {F : Set (Option S)}
  {P : (Fin k → ℤ) → Prop} {a b : Turing.Cfg k Γ S x} {t : ℕ},
  Turing.Segment M F P a b t → b.state ≠ none → Turing.Segment M (insert none F) P a b t
@Turing.Segment.one : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} {M : Turing.MultiTapeTM k Γ S} {F : Set (Option S)}
  {P : (Fin k → ℤ) → Prop} {a : Turing.Cfg k Γ S x},
  a.state ∉ F →
    P a.workTapePos → P (Turing.MultiTapeTM.step a).workTapePos → Turing.Segment M F P a (Turing.MultiTapeTM.step a) 1
@Turing.Segment.take : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} {M : Turing.MultiTapeTM k Γ S} {F : Set (Option S)}
  {P : (Fin k → ℤ) → Prop} {a b : Turing.Cfg k Γ S x} {t u : ℕ},
  Turing.Segment M F P a b t → u ≤ t → Turing.Segment M F P a (Turing.MultiTapeTM.runFrom a u) u
@Turing.Segment.time_eq : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} {M : Turing.MultiTapeTM k Γ S} {F : Set (Option S)}
  {P : (Fin k → ℤ) → Prop} {a b b' : Turing.Cfg k Γ S x} {t t' : ℕ} {P' : (Fin k → ℤ) → Prop},
  Turing.Segment M F P a b t → b.state ∈ F → Turing.Segment M F P' a b' t' → b'.state ∈ F → t = t'
@Turing.Segment.zero : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} {M : Turing.MultiTapeTM k Γ S} {F : Set (Option S)}
  {P : (Fin k → ℤ) → Prop} {a : Turing.Cfg k Γ S x}, P a.workTapePos → Turing.Segment M F P a a 0
@Turing.ZoneContents.extend_home : ∀ {ℓ : ℕ} (z : Turing.ZoneContents ℓ), z.extend.home = z.home
@Turing.ZoneContents.extend_left : ∀ {ℓ : ℕ} (z : Turing.ZoneContents ℓ) (i : Fin (ℓ + 1)),
  z.extend.left i = Fin.lastCases (List.replicate (2 ^ ℓ) none) z.left i
@Turing.ZoneContents.extend_right : ∀ {ℓ : ℕ} (z : Turing.ZoneContents ℓ) (i : Fin (ℓ + 1)),
  z.extend.right i = Fin.lastCases (List.replicate (2 ^ ℓ) none) z.right i
@Turing.ZoneContents.extend_words_castSucc : ∀ {ℓ : ℕ} (side : Bool) (z : Turing.ZoneContents ℓ) (i : Fin ℓ),
  Turing.ZoneContents.words side z.extend i.castSucc = Turing.ZoneContents.words side z i
@Turing.ZoneContents.extend_words_last : ∀ {ℓ : ℕ} (side : Bool) (z : Turing.ZoneContents ℓ),
  Turing.ZoneContents.words side z.extend (Fin.last ℓ) = List.replicate (2 ^ ℓ) none
@Turing.ZoneContents.swap_home : ∀ {ℓ : ℕ} (z : Turing.ZoneContents ℓ), z.swap.home = z.home
@Turing.ZoneContents.swap_right : ∀ {ℓ : ℕ} (z : Turing.ZoneContents ℓ) (a : Fin ℓ), z.swap.right a = z.left a
@Turing.ZoneContents.swap_swap : ∀ {ℓ : ℕ} (z : Turing.ZoneContents ℓ), z.swap.swap = z
@Turing.ZoneContents.words_false : ∀ {ℓ : ℕ} (z : Turing.ZoneContents ℓ), Turing.ZoneContents.words false z = z.left
@Turing.ZoneContents.words_le : ∀ {ℓ : ℕ} (side : Bool) (z : Turing.ZoneContents ℓ) (i : Fin ℓ),
  (Turing.ZoneContents.words side z i).length ≤ Turing.zoneCapacity ↑i
@Turing.ZoneContents.words_true : ∀ {ℓ : ℕ} (z : Turing.ZoneContents ℓ), Turing.ZoneContents.words true z = z.right
@Turing.clearTM_contract_frames : ∀ {k : ℕ} {Γ : Type} (i : Fin k) (x : List Γ),
  (Turing.clearTM_contract i x).Frames fun w d j =>
    if j = i then Set.Ico (d.workTapePos j) (d.workTapePos j + ↑w.length) else ∅
@Turing.clearTM_contract_hi : ∀ {k : ℕ} {Γ : Type} (i : Fin k) (x i_1 : List Γ) (d : Turing.Cfg k Γ Turing.SweepPhase x)
  (j : Fin k),
  (Turing.clearTM_contract i x).hi i_1 d j = if j = i then d.workTapePos j + ↑i_1.length else d.workTapePos j
@Turing.clearTM_contract_lo : ∀ {k : ℕ} {Γ : Type} (i : Fin k) (x i_1 : List Γ) (d : Turing.Cfg k Γ Turing.SweepPhase x)
  (j : Fin k), (Turing.clearTM_contract i x).lo i_1 d j = if j = i then d.workTapePos j - 1 else d.workTapePos j
@Turing.clearTM_contract_post : ∀ {k : ℕ} {Γ : Type} (i : Fin k) (x w : List Γ)
  (d : Turing.Cfg k Γ Turing.SweepPhase x),
  (Turing.clearTM_contract i x).post w d = Turing.sweepPost Turing.SweepPhase.done i (fun x_1 x x_2 x_3 => none) w d
@Turing.clearTM_contract_pre : ∀ {k : ℕ} {Γ : Type} (i : Fin k) (x w : List Γ) (d : Turing.Cfg k Γ Turing.SweepPhase x),
  (Turing.clearTM_contract i x).pre w d =
    ∀ (p : ℤ), -1 ≤ p → p ≤ ↑w.length → d.workTapes i (d.workTapePos i + p) = Turing.FinTM.bufferTape w p
@Turing.clearTM_contract_time : ∀ {k : ℕ} {Γ : Type} (i : Fin k) (x w : List Γ)
  (x_1 : Turing.Cfg k Γ Turing.SweepPhase x), (Turing.clearTM_contract i x).time w x_1 = 2 * w.length + 2
@Turing.clearTM_contract_traj : ∀ {k : ℕ} {Γ : Type} (i : Fin k) (x : List Γ),
  (Turing.clearTM_contract i x).Traj fun x_1 d p => ∀ (j : Fin k), j ≠ i → p j = d.workTapePos j
@Turing.copyMapTM_contract_frames : ∀ {k : ℕ} {Γ Δ : Type} (src dst : Fin k) (hne : src ≠ dst) (extract : Γ → Δ)
  (merge : Option Γ → Δ → Γ) (x : List Γ),
  (Turing.copyMapTM_contract src dst hne extract merge x).Frames fun w d j =>
    if j = dst then Set.Ico (d.workTapePos j) (d.workTapePos j + ↑w.length) else ∅
@Turing.copyMapTM_contract_hi : ∀ {k : ℕ} {Γ Δ : Type} (src dst : Fin k) (hne : src ≠ dst) (extract : Γ → Δ)
  (merge : Option Γ → Δ → Γ) (x i : List Γ) (d : Turing.Cfg k Γ Turing.SweepPhase x) (j : Fin k),
  (Turing.copyMapTM_contract src dst hne extract merge x).hi i d j =
    if j = src ∨ j = dst then d.workTapePos j + ↑i.length else d.workTapePos j
@Turing.copyMapTM_contract_lo : ∀ {k : ℕ} {Γ Δ : Type} (src dst : Fin k) (hne : src ≠ dst) (extract : Γ → Δ)
  (merge : Option Γ → Δ → Γ) (x i : List Γ) (d : Turing.Cfg k Γ Turing.SweepPhase x) (j : Fin k),
  (Turing.copyMapTM_contract src dst hne extract merge x).lo i d j =
    if j = src ∨ j = dst then d.workTapePos j - 1 else d.workTapePos j
@Turing.copyMapTM_contract_post : ∀ {k : ℕ} {Γ Δ : Type} (src dst : Fin k) (hne : src ≠ dst) (extract : Γ → Δ)
  (merge : Option Γ → Δ → Γ) (x w : List Γ) (d : Turing.Cfg k Γ Turing.SweepPhase x),
  (Turing.copyMapTM_contract src dst hne extract merge x).post w d =
    Turing.sweepPost Turing.SweepPhase.done dst (Turing.sweepMapWrite extract merge) w d
@Turing.copyMapTM_contract_post_workTapes : ∀ {k : ℕ} {Γ Δ : Type} (src dst : Fin k) (hne : src ≠ dst) (extract : Γ → Δ)
  (merge : Option Γ → Δ → Γ) (x w : List Γ) (d : Turing.Cfg k Γ Turing.SweepPhase x) (j : Fin k) (q : ℤ),
  ((Turing.copyMapTM_contract src dst hne extract merge x).post w d).workTapes j q =
    if j = dst ∧ d.workTapePos j ≤ q ∧ q < d.workTapePos j + ↑w.length then
      Option.map (fun γ => merge (d.workTapes j q) (extract γ)) (Turing.FinTM.bufferTape w (q - d.workTapePos j))
    else d.workTapes j q
@Turing.copyMapTM_contract_pre : ∀ {k : ℕ} {Γ Δ : Type} (src dst : Fin k) (hne : src ≠ dst) (extract : Γ → Δ)
  (merge : Option Γ → Δ → Γ) (x w : List Γ) (d : Turing.Cfg k Γ Turing.SweepPhase x),
  (Turing.copyMapTM_contract src dst hne extract merge x).pre w d =
    ∀ (p : ℤ), -1 ≤ p → p ≤ ↑w.length → d.workTapes src (d.workTapePos src + p) = Turing.FinTM.bufferTape w p
@Turing.copyMapTM_contract_time : ∀ {k : ℕ} {Γ Δ : Type} (src dst : Fin k) (hne : src ≠ dst) (extract : Γ → Δ)
  (merge : Option Γ → Δ → Γ) (x w : List Γ) (x_1 : Turing.Cfg k Γ Turing.SweepPhase x),
  (Turing.copyMapTM_contract src dst hne extract merge x).time w x_1 = 2 * w.length + 2
@Turing.copyMapTM_contract_traj : ∀ {k : ℕ} {Γ Δ : Type} (src dst : Fin k) (hne : src ≠ dst) (extract : Γ → Δ)
  (merge : Option Γ → Δ → Γ) (x : List Γ),
  (Turing.copyMapTM_contract src dst hne extract merge x).Traj fun x_1 d p =>
    ∀ (j : Fin k), j ≠ src → j ≠ dst → p j = d.workTapePos j
@Turing.fieldOffset_add_length_le : ∀ {Γ : Type u_1} (fs : List (List Γ)) (j : ℕ) (hj : j < fs.length),
  Turing.fieldOffset fs j + fs[j].length ≤ (Turing.joinFields fs).length
@Turing.fieldOffset_cons_succ : ∀ {Γ : Type u_1} (u : List Γ) (fs : List (List Γ)) (j : ℕ),
  Turing.fieldOffset (u :: fs) (j + 1) = u.length + 1 + Turing.fieldOffset fs j
@Turing.fieldsTape_field : ∀ {Γ : Type u_1} (fs : List (List Γ)) (j : ℕ) (hj : j < fs.length) (p : ℤ),
  -1 ≤ p → p ≤ ↑fs[j].length → Turing.fieldsTape fs (↑(Turing.fieldOffset fs j) + p) = Turing.FinTM.bufferTape fs[j] p
@Turing.fieldsTape_nil : ∀ {Γ : Type u_1} (z : ℤ), Turing.fieldsTape [] z = none
@Turing.fieldsTape_of_length_le : ∀ {Γ : Type u_1} (fs : List (List Γ)) {z : ℤ},
  ↑(Turing.joinFields fs).length ≤ z → Turing.fieldsTape fs z = none
@Turing.fieldsTape_of_neg : ∀ {Γ : Type u_1} (fs : List (List Γ)) {z : ℤ}, z < 0 → Turing.fieldsTape fs z = none
@Turing.fieldsTape_of_nonneg : ∀ {Γ : Type u_1} (fs : List (List Γ)) {z : ℤ},
  0 ≤ z → Turing.fieldsTape fs z = (Turing.joinFields fs)[z.toNat]?.join
@Turing.framedContract_hi : ∀ {k : ℕ} {Γ S ι : Type} (M : Turing.MultiTapeTM k Γ S) (entry done : S) (x : List Γ)
  (pre : ι → Turing.Cfg k Γ S x → Prop) (time : ι → Turing.Cfg k Γ S x → ℕ)
  (post : ι → Turing.Cfg k Γ S x → Turing.Cfg k Γ S x) (touched : Fin k → Prop) [inst : DecidablePred touched]
  (lo hi : ι → Turing.Cfg k Γ S x → Fin k → ℤ)
  (hpost : ∀ (i : ι) (d : Turing.Cfg k Γ S x), (post i d).state = some done)
  (hrun :
    ∀ (i : ι) (d : Turing.Cfg k Γ S x),
      d.state = some entry →
        pre i d →
          Turing.MultiTapeTM.runFrom d (time i d) = post i d ∧
            (∀ t < time i d, (Turing.MultiTapeTM.runFrom d t).state ≠ some done) ∧
              ∀ (j : Fin k),
                ∀ t ≤ time i d,
                  if touched j then (Turing.MultiTapeTM.runFrom d t).workTapePos j ∈ Finset.Icc (lo i d j) (hi i d j)
                  else (Turing.MultiTapeTM.runFrom d t).workTapePos j = d.workTapePos j)
  (i : ι) (d : Turing.Cfg k Γ S x) (j : Fin k),
  (Turing.framedContract M entry done x pre time post touched lo hi hpost hrun).hi i d j =
    if touched j then hi i d j else d.workTapePos j
@Turing.framedContract_lo : ∀ {k : ℕ} {Γ S ι : Type} (M : Turing.MultiTapeTM k Γ S) (entry done : S) (x : List Γ)
  (pre : ι → Turing.Cfg k Γ S x → Prop) (time : ι → Turing.Cfg k Γ S x → ℕ)
  (post : ι → Turing.Cfg k Γ S x → Turing.Cfg k Γ S x) (touched : Fin k → Prop) [inst : DecidablePred touched]
  (lo hi : ι → Turing.Cfg k Γ S x → Fin k → ℤ)
  (hpost : ∀ (i : ι) (d : Turing.Cfg k Γ S x), (post i d).state = some done)
  (hrun :
    ∀ (i : ι) (d : Turing.Cfg k Γ S x),
      d.state = some entry →
        pre i d →
          Turing.MultiTapeTM.runFrom d (time i d) = post i d ∧
            (∀ t < time i d, (Turing.MultiTapeTM.runFrom d t).state ≠ some done) ∧
              ∀ (j : Fin k),
                ∀ t ≤ time i d,
                  if touched j then (Turing.MultiTapeTM.runFrom d t).workTapePos j ∈ Finset.Icc (lo i d j) (hi i d j)
                  else (Turing.MultiTapeTM.runFrom d t).workTapePos j = d.workTapePos j)
  (i : ι) (d : Turing.Cfg k Γ S x) (j : Fin k),
  (Turing.framedContract M entry done x pre time post touched lo hi hpost hrun).lo i d j =
    if touched j then lo i d j else d.workTapePos j
@Turing.framedContract_post : ∀ {k : ℕ} {Γ S ι : Type} (M : Turing.MultiTapeTM k Γ S) (entry done : S) (x : List Γ)
  (pre : ι → Turing.Cfg k Γ S x → Prop) (time : ι → Turing.Cfg k Γ S x → ℕ)
  (post : ι → Turing.Cfg k Γ S x → Turing.Cfg k Γ S x) (touched : Fin k → Prop) [inst : DecidablePred touched]
  (lo hi : ι → Turing.Cfg k Γ S x → Fin k → ℤ)
  (hpost : ∀ (i : ι) (d : Turing.Cfg k Γ S x), (post i d).state = some done)
  (hrun :
    ∀ (i : ι) (d : Turing.Cfg k Γ S x),
      d.state = some entry →
        pre i d →
          Turing.MultiTapeTM.runFrom d (time i d) = post i d ∧
            (∀ t < time i d, (Turing.MultiTapeTM.runFrom d t).state ≠ some done) ∧
              ∀ (j : Fin k),
                ∀ t ≤ time i d,
                  if touched j then (Turing.MultiTapeTM.runFrom d t).workTapePos j ∈ Finset.Icc (lo i d j) (hi i d j)
                  else (Turing.MultiTapeTM.runFrom d t).workTapePos j = d.workTapePos j)
  (a : ι) (a_1 : Turing.Cfg k Γ S x),
  (Turing.framedContract M entry done x pre time post touched lo hi hpost hrun).post a a_1 = post a a_1
@Turing.framedContract_pre : ∀ {k : ℕ} {Γ S ι : Type} (M : Turing.MultiTapeTM k Γ S) (entry done : S) (x : List Γ)
  (pre : ι → Turing.Cfg k Γ S x → Prop) (time : ι → Turing.Cfg k Γ S x → ℕ)
  (post : ι → Turing.Cfg k Γ S x → Turing.Cfg k Γ S x) (touched : Fin k → Prop) [inst : DecidablePred touched]
  (lo hi : ι → Turing.Cfg k Γ S x → Fin k → ℤ)
  (hpost : ∀ (i : ι) (d : Turing.Cfg k Γ S x), (post i d).state = some done)
  (hrun :
    ∀ (i : ι) (d : Turing.Cfg k Γ S x),
      d.state = some entry →
        pre i d →
          Turing.MultiTapeTM.runFrom d (time i d) = post i d ∧
            (∀ t < time i d, (Turing.MultiTapeTM.runFrom d t).state ≠ some done) ∧
              ∀ (j : Fin k),
                ∀ t ≤ time i d,
                  if touched j then (Turing.MultiTapeTM.runFrom d t).workTapePos j ∈ Finset.Icc (lo i d j) (hi i d j)
                  else (Turing.MultiTapeTM.runFrom d t).workTapePos j = d.workTapePos j)
  (a : ι) (a_1 : Turing.Cfg k Γ S x),
  (Turing.framedContract M entry done x pre time post touched lo hi hpost hrun).pre a a_1 = pre a a_1
@Turing.framedContract_time : ∀ {k : ℕ} {Γ S ι : Type} (M : Turing.MultiTapeTM k Γ S) (entry done : S) (x : List Γ)
  (pre : ι → Turing.Cfg k Γ S x → Prop) (time : ι → Turing.Cfg k Γ S x → ℕ)
  (post : ι → Turing.Cfg k Γ S x → Turing.Cfg k Γ S x) (touched : Fin k → Prop) [inst : DecidablePred touched]
  (lo hi : ι → Turing.Cfg k Γ S x → Fin k → ℤ)
  (hpost : ∀ (i : ι) (d : Turing.Cfg k Γ S x), (post i d).state = some done)
  (hrun :
    ∀ (i : ι) (d : Turing.Cfg k Γ S x),
      d.state = some entry →
        pre i d →
          Turing.MultiTapeTM.runFrom d (time i d) = post i d ∧
            (∀ t < time i d, (Turing.MultiTapeTM.runFrom d t).state ≠ some done) ∧
              ∀ (j : Fin k),
                ∀ t ≤ time i d,
                  if touched j then (Turing.MultiTapeTM.runFrom d t).workTapePos j ∈ Finset.Icc (lo i d j) (hi i d j)
                  else (Turing.MultiTapeTM.runFrom d t).workTapePos j = d.workTapePos j)
  (a : ι) (a_1 : Turing.Cfg k Γ S x),
  (Turing.framedContract M entry done x pre time post touched lo hi hpost hrun).time a a_1 = time a a_1
@Turing.joinFields_cons_cons : ∀ {Γ : Type u_1} (u v : List Γ) (fs : List (List Γ)),
  Turing.joinFields (u :: v :: fs) = List.map some u ++ none :: Turing.joinFields (v :: fs)
@Turing.joinFields_nil : ∀ {Γ : Type u_1}, Turing.joinFields [] = []
@Turing.joinFields_singleton : ∀ {Γ : Type u_1} (u : List Γ), Turing.joinFields [u] = List.map some u
@Turing.scanTM_contract_hi : ∀ {k : ℕ} {Γ A : Type} (i : Fin k) (δf δb : A → Γ → A × Γ) (a₀ : A) (x w : List Γ)
  (d : Turing.Cfg k Γ (Turing.ScanPhase A) x) (j : Fin k),
  (Turing.scanTM_contract i δf δb a₀ x).hi w d j = if j = i then d.workTapePos j + ↑w.length else d.workTapePos j
@Turing.scanTM_contract_lo : ∀ {k : ℕ} {Γ A : Type} (i : Fin k) (δf δb : A → Γ → A × Γ) (a₀ : A) (x w : List Γ)
  (d : Turing.Cfg k Γ (Turing.ScanPhase A) x) (j : Fin k),
  (Turing.scanTM_contract i δf δb a₀ x).lo w d j = if j = i then d.workTapePos j - 1 else d.workTapePos j
@Turing.scanTM_contract_post : ∀ {k : ℕ} {Γ A : Type} (i : Fin k) (δf δb : A → Γ → A × Γ) (a₀ : A) (x w : List Γ)
  (d : Turing.Cfg k Γ (Turing.ScanPhase A) x),
  (Turing.scanTM_contract i δf δb a₀ x).post w d =
    { state := some (Turing.ScanPhase.done (Turing.scanResult δf δb a₀ w).1), inputPos := d.inputPos,
      workTapes := fun j q =>
        if j = i ∧ d.workTapePos j ≤ q ∧ q < d.workTapePos j + ↑w.length then
          Turing.FinTM.bufferTape (Turing.scanResult δf δb a₀ w).2 (q - d.workTapePos j)
        else d.workTapes j q,
      workTapePos := d.workTapePos, output := d.output }
@Turing.scanTM_contract_pre : ∀ {k : ℕ} {Γ A : Type} (i : Fin k) (δf δb : A → Γ → A × Γ) (a₀ : A) (x w : List Γ)
  (d : Turing.Cfg k Γ (Turing.ScanPhase A) x),
  (Turing.scanTM_contract i δf δb a₀ x).pre w d =
    ∀ (p : ℤ), -1 ≤ p → p ≤ ↑w.length → d.workTapes i (d.workTapePos i + p) = Turing.FinTM.bufferTape w p
@Turing.scanTM_contract_time : ∀ {k : ℕ} {Γ A : Type} (i : Fin k) (δf δb : A → Γ → A × Γ) (a₀ : A) (x w : List Γ)
  (x_1 : Turing.Cfg k Γ (Turing.ScanPhase A) x), (Turing.scanTM_contract i δf δb a₀ x).time w x_1 = 2 * w.length + 2
@Turing.seekEndTM_contract_hi : ∀ {k : ℕ} {Γ : Type} (i : Fin k) (x : List Γ) (i_1 : List (List Γ))
  (d : Turing.Cfg k Γ Turing.SeekPhase x) (j : Fin k),
  (Turing.seekEndTM_contract i x).hi i_1 d j =
    if j = i then d.workTapePos j + ↑(Turing.fieldOffset i_1 i_1.length) else d.workTapePos j
@Turing.seekEndTM_contract_lo : ∀ {k : ℕ} {Γ : Type} (i : Fin k) (x : List Γ) (i_1 : List (List Γ))
  (d : Turing.Cfg k Γ Turing.SeekPhase x) (j : Fin k), (Turing.seekEndTM_contract i x).lo i_1 d j = d.workTapePos j
@Turing.seekEndTM_contract_post : ∀ {k : ℕ} {Γ : Type} (i : Fin k) (x : List Γ) (ws : List (List Γ))
  (d : Turing.Cfg k Γ Turing.SeekPhase x),
  (Turing.seekEndTM_contract i x).post ws d =
    Turing.seekPost Turing.SeekPhase.done i (d.workTapePos i + ↑(Turing.fieldOffset ws ws.length)) d
@Turing.seekEndTM_contract_pre : ∀ {k : ℕ} {Γ : Type} (i : Fin k) (x : List Γ) (ws : List (List Γ))
  (d : Turing.Cfg k Γ Turing.SeekPhase x),
  (Turing.seekEndTM_contract i x).pre ws d =
    (¬ws = [] ∧
      (∀ u ∈ ws, ¬u = []) ∧
        ∀ (p : ℤ),
          0 ≤ p → p ≤ ↑(Turing.fieldOffset ws ws.length) → d.workTapes i (d.workTapePos i + p) = Turing.fieldsTape ws p)
@Turing.seekEndTM_contract_time : ∀ {k : ℕ} {Γ : Type} (i : Fin k) (x : List Γ) (ws : List (List Γ))
  (x_1 : Turing.Cfg k Γ Turing.SeekPhase x),
  (Turing.seekEndTM_contract i x).time ws x_1 = Turing.fieldOffset ws ws.length + 1
@Turing.seekPost_inputPos : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} (done : S) (i : Fin k) (p : ℤ) (d : Turing.Cfg k Γ S x),
  (Turing.seekPost done i p d).inputPos = d.inputPos
@Turing.seekPost_output : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} (done : S) (i : Fin k) (p : ℤ) (d : Turing.Cfg k Γ S x),
  (Turing.seekPost done i p d).output = d.output
@Turing.seekPost_state : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} (done : S) (i : Fin k) (p : ℤ) (d : Turing.Cfg k Γ S x),
  (Turing.seekPost done i p d).state = some done
@Turing.seekPost_workTapePos : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} (done : S) (i : Fin k) (p : ℤ)
  (d : Turing.Cfg k Γ S x) (a : Fin k), (Turing.seekPost done i p d).workTapePos a = Function.update d.workTapePos i p a
@Turing.seekPost_workTapes : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} (done : S) (i : Fin k) (p : ℤ) (d : Turing.Cfg k Γ S x)
  (a : Fin k) (a_1 : ℤ), (Turing.seekPost done i p d).workTapes a a_1 = d.workTapes a a_1
@Turing.seekStartTM_contract_hi : ∀ {k : ℕ} {Γ : Type} (i : Fin k) (x : List Γ) (i_1 : List (List Γ))
  (d : Turing.Cfg k Γ Turing.SeekPhase x) (j : Fin k), (Turing.seekStartTM_contract i x).hi i_1 d j = d.workTapePos j
@Turing.seekStartTM_contract_lo : ∀ {k : ℕ} {Γ : Type} (i : Fin k) (x : List Γ) (i_1 : List (List Γ))
  (d : Turing.Cfg k Γ Turing.SeekPhase x) (j : Fin k),
  (Turing.seekStartTM_contract i x).lo i_1 d j =
    if j = i then d.workTapePos j - ↑(Turing.fieldOffset i_1 i_1.length) - 2 else d.workTapePos j
@Turing.seekStartTM_contract_post : ∀ {k : ℕ} {Γ : Type} (i : Fin k) (x : List Γ) (ws : List (List Γ))
  (d : Turing.Cfg k Γ Turing.SeekPhase x),
  (Turing.seekStartTM_contract i x).post ws d =
    Turing.seekPost Turing.SeekPhase.done i (d.workTapePos i - ↑(Turing.fieldOffset ws ws.length)) d
@Turing.seekStartTM_contract_pre : ∀ {k : ℕ} {Γ : Type} (i : Fin k) (x : List Γ) (ws : List (List Γ))
  (d : Turing.Cfg k Γ Turing.SeekPhase x),
  (Turing.seekStartTM_contract i x).pre ws d =
    ((∀ u ∈ ws, ¬u = []) ∧
      ¬d.workTapes i (d.workTapePos i) = none ∧
        ∀ (p : ℤ),
          -2 ≤ p →
            p < ↑(Turing.fieldOffset ws ws.length) →
              d.workTapes i (d.workTapePos i - ↑(Turing.fieldOffset ws ws.length) + p) = Turing.fieldsTape ws p)
@Turing.seekStartTM_contract_time : ∀ {k : ℕ} {Γ : Type} (i : Fin k) (x : List Γ) (ws : List (List Γ))
  (x_1 : Turing.Cfg k Γ Turing.SeekPhase x),
  (Turing.seekStartTM_contract i x).time ws x_1 = Turing.fieldOffset ws ws.length + 4
@Turing.skipBackTM_contract_hi : ∀ {k : ℕ} {Γ : Type} (i : Fin k) (x i_1 : List Γ)
  (d : Turing.Cfg k Γ Turing.SeekPhase x) (j : Fin k), (Turing.skipBackTM_contract i x).hi i_1 d j = d.workTapePos j
@Turing.skipBackTM_contract_lo : ∀ {k : ℕ} {Γ : Type} (i : Fin k) (x i_1 : List Γ)
  (d : Turing.Cfg k Γ Turing.SeekPhase x) (j : Fin k),
  (Turing.skipBackTM_contract i x).lo i_1 d j = if j = i then d.workTapePos j - ↑i_1.length - 2 else d.workTapePos j
@Turing.skipBackTM_contract_post : ∀ {k : ℕ} {Γ : Type} (i : Fin k) (x u : List Γ)
  (d : Turing.Cfg k Γ Turing.SeekPhase x),
  (Turing.skipBackTM_contract i x).post u d =
    Turing.seekPost Turing.SeekPhase.done i (d.workTapePos i - ↑u.length - 1) d
@Turing.skipBackTM_contract_pre : ∀ {k : ℕ} {Γ : Type} (i : Fin k) (x u : List Γ)
  (d : Turing.Cfg k Γ Turing.SeekPhase x),
  (Turing.skipBackTM_contract i x).pre u d =
    ∀ (p : ℤ),
      -1 ≤ p → p ≤ ↑u.length → d.workTapes i (d.workTapePos i - ↑u.length - 1 + p) = Turing.FinTM.bufferTape u p
@Turing.skipBackTM_contract_time : ∀ {k : ℕ} {Γ : Type} (i : Fin k) (x u : List Γ)
  (x_1 : Turing.Cfg k Γ Turing.SeekPhase x), (Turing.skipBackTM_contract i x).time u x_1 = u.length + 3
@Turing.skipTM_contract_hi : ∀ {k : ℕ} {Γ : Type} (i : Fin k) (x i_1 : List Γ) (d : Turing.Cfg k Γ Turing.SeekPhase x)
  (j : Fin k),
  (Turing.skipTM_contract i x).hi i_1 d j = if j = i then d.workTapePos j + ↑i_1.length + 1 else d.workTapePos j
@Turing.skipTM_contract_lo : ∀ {k : ℕ} {Γ : Type} (i : Fin k) (x i_1 : List Γ) (d : Turing.Cfg k Γ Turing.SeekPhase x)
  (j : Fin k), (Turing.skipTM_contract i x).lo i_1 d j = d.workTapePos j
@Turing.skipTM_contract_post : ∀ {k : ℕ} {Γ : Type} (i : Fin k) (x w : List Γ) (d : Turing.Cfg k Γ Turing.SeekPhase x),
  (Turing.skipTM_contract i x).post w d = Turing.seekPost Turing.SeekPhase.done i (d.workTapePos i + ↑w.length + 1) d
@Turing.skipTM_contract_pre : ∀ {k : ℕ} {Γ : Type} (i : Fin k) (x w : List Γ) (d : Turing.Cfg k Γ Turing.SeekPhase x),
  (Turing.skipTM_contract i x).pre w d =
    ∀ (p : ℤ), 0 ≤ p → p ≤ ↑w.length → d.workTapes i (d.workTapePos i + p) = Turing.FinTM.bufferTape w p
@Turing.skipTM_contract_time : ∀ {k : ℕ} {Γ : Type} (i : Fin k) (x w : List Γ)
  (x_1 : Turing.Cfg k Γ Turing.SeekPhase x), (Turing.skipTM_contract i x).time w x_1 = w.length + 1
@Turing.sweepPost_inputPos : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} (done : S) (a : Fin k)
  (v : List Γ → Turing.Cfg k Γ S x → Fin k → ℤ → Option Γ) (w : List Γ) (d : Turing.Cfg k Γ S x),
  (Turing.sweepPost done a v w d).inputPos = d.inputPos
@Turing.sweepPost_output : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} (done : S) (a : Fin k)
  (v : List Γ → Turing.Cfg k Γ S x → Fin k → ℤ → Option Γ) (w : List Γ) (d : Turing.Cfg k Γ S x),
  (Turing.sweepPost done a v w d).output = d.output
@Turing.sweepPost_state : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} (done : S) (a : Fin k)
  (v : List Γ → Turing.Cfg k Γ S x → Fin k → ℤ → Option Γ) (w : List Γ) (d : Turing.Cfg k Γ S x),
  (Turing.sweepPost done a v w d).state = some done
@Turing.sweepPost_workTapePos : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} (done : S) (a : Fin k)
  (v : List Γ → Turing.Cfg k Γ S x → Fin k → ℤ → Option Γ) (w : List Γ) (d : Turing.Cfg k Γ S x) (a_1 : Fin k),
  (Turing.sweepPost done a v w d).workTapePos a_1 = d.workTapePos a_1
@Turing.sweepPost_workTapes : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} (done : S) (a : Fin k)
  (v : List Γ → Turing.Cfg k Γ S x → Fin k → ℤ → Option Γ) (w : List Γ) (d : Turing.Cfg k Γ S x) (j : Fin k) (q : ℤ),
  (Turing.sweepPost done a v w d).workTapes j q =
    if j = a ∧ d.workTapePos j ≤ q ∧ q < d.workTapePos j + ↑w.length then v w d j q else d.workTapes j q
@Turing.transferMapTM_contract_frames : ∀ {k : ℕ} {Γ Δ : Type} (src dst : Fin k) (hne : src ≠ dst) (extract : Γ → Δ)
  (merge : Option Γ → Δ → Γ) (rest : Γ → Option Γ) (x : List Γ),
  (Turing.transferMapTM_contract src dst hne extract merge rest x).Frames fun w d j =>
    if j = src ∨ j = dst then Set.Ico (d.workTapePos j) (d.workTapePos j + ↑w.length) else ∅
@Turing.transferMapTM_contract_hi : ∀ {k : ℕ} {Γ Δ : Type} (src dst : Fin k) (hne : src ≠ dst) (extract : Γ → Δ)
  (merge : Option Γ → Δ → Γ) (rest : Γ → Option Γ) (x i : List Γ) (d : Turing.Cfg k Γ Turing.SweepPhase x) (j : Fin k),
  (Turing.transferMapTM_contract src dst hne extract merge rest x).hi i d j =
    if j = src ∨ j = dst then d.workTapePos j + ↑i.length else d.workTapePos j
@Turing.transferMapTM_contract_lo : ∀ {k : ℕ} {Γ Δ : Type} (src dst : Fin k) (hne : src ≠ dst) (extract : Γ → Δ)
  (merge : Option Γ → Δ → Γ) (rest : Γ → Option Γ) (x i : List Γ) (d : Turing.Cfg k Γ Turing.SweepPhase x) (j : Fin k),
  (Turing.transferMapTM_contract src dst hne extract merge rest x).lo i d j =
    if j = src ∨ j = dst then d.workTapePos j - 1 else d.workTapePos j
@Turing.transferMapTM_contract_post : ∀ {k : ℕ} {Γ Δ : Type} (src dst : Fin k) (hne : src ≠ dst) (extract : Γ → Δ)
  (merge : Option Γ → Δ → Γ) (rest : Γ → Option Γ) (x w : List Γ) (d : Turing.Cfg k Γ Turing.SweepPhase x),
  (Turing.transferMapTM_contract src dst hne extract merge rest x).post w d =
    Turing.sweepPost Turing.SweepPhase.done src
      (fun w d j q => (Turing.FinTM.bufferTape w (q - d.workTapePos j)).bind rest) w
      (Turing.sweepPost Turing.SweepPhase.done dst (Turing.sweepMapWrite extract merge) w d)
@Turing.transferMapTM_contract_post_workTapes : ∀ {k : ℕ} {Γ Δ : Type} (src dst : Fin k) (hne : src ≠ dst)
  (extract : Γ → Δ) (merge : Option Γ → Δ → Γ) (rest : Γ → Option Γ) (x w : List Γ)
  (d : Turing.Cfg k Γ Turing.SweepPhase x) (j : Fin k) (q : ℤ),
  ((Turing.transferMapTM_contract src dst hne extract merge rest x).post w d).workTapes j q =
    if j = src ∧ d.workTapePos j ≤ q ∧ q < d.workTapePos j + ↑w.length then
      (Turing.FinTM.bufferTape w (q - d.workTapePos j)).bind rest
    else
      if j = dst ∧ d.workTapePos j ≤ q ∧ q < d.workTapePos j + ↑w.length then
        Option.map (fun γ => merge (d.workTapes j q) (extract γ)) (Turing.FinTM.bufferTape w (q - d.workTapePos j))
      else d.workTapes j q
@Turing.transferMapTM_contract_pre : ∀ {k : ℕ} {Γ Δ : Type} (src dst : Fin k) (hne : src ≠ dst) (extract : Γ → Δ)
  (merge : Option Γ → Δ → Γ) (rest : Γ → Option Γ) (x w : List Γ) (d : Turing.Cfg k Γ Turing.SweepPhase x),
  (Turing.transferMapTM_contract src dst hne extract merge rest x).pre w d =
    ∀ (p : ℤ), -1 ≤ p → p ≤ ↑w.length → d.workTapes src (d.workTapePos src + p) = Turing.FinTM.bufferTape w p
@Turing.transferMapTM_contract_time : ∀ {k : ℕ} {Γ Δ : Type} (src dst : Fin k) (hne : src ≠ dst) (extract : Γ → Δ)
  (merge : Option Γ → Δ → Γ) (rest : Γ → Option Γ) (x w : List Γ) (x_1 : Turing.Cfg k Γ Turing.SweepPhase x),
  (Turing.transferMapTM_contract src dst hne extract merge rest x).time w x_1 = 2 * w.length + 2
@Turing.walkTM_contract_hi : ∀ {k : ℕ} {Γ : Type} (src : Fin k) (moved : Fin k → Prop) [inst : DecidablePred moved]
  (hsrc : moved src) (dir : SignType) (x i : List Γ) (d : Turing.Cfg k Γ Turing.SeekPhase x) (j : Fin k),
  (Turing.walkTM_contract src moved hsrc dir x).hi i d j =
    if moved j then d.workTapePos j + max 0 (↑dir * (↑i.length + 1)) else d.workTapePos j
@Turing.walkTM_contract_lo : ∀ {k : ℕ} {Γ : Type} (src : Fin k) (moved : Fin k → Prop) [inst : DecidablePred moved]
  (hsrc : moved src) (dir : SignType) (x i : List Γ) (d : Turing.Cfg k Γ Turing.SeekPhase x) (j : Fin k),
  (Turing.walkTM_contract src moved hsrc dir x).lo i d j =
    if moved j then d.workTapePos j + min 0 (↑dir * (↑i.length + 1)) else d.workTapePos j
@Turing.walkTM_contract_post : ∀ {k : ℕ} {Γ : Type} (src : Fin k) (moved : Fin k → Prop) [inst : DecidablePred moved]
  (hsrc : moved src) (dir : SignType) (x w : List Γ) (d : Turing.Cfg k Γ Turing.SeekPhase x),
  (Turing.walkTM_contract src moved hsrc dir x).post w d =
    { state := some Turing.SeekPhase.done, inputPos := d.inputPos, workTapes := d.workTapes,
      workTapePos := fun j => d.workTapePos j + if moved j then ↑dir * (↑w.length + 1) else 0, output := d.output }
@Turing.walkTM_contract_pre : ∀ {k : ℕ} {Γ : Type} (src : Fin k) (moved : Fin k → Prop) [inst : DecidablePred moved]
  (hsrc : moved src) (dir : SignType) (x w : List Γ) (d : Turing.Cfg k Γ Turing.SeekPhase x),
  (Turing.walkTM_contract src moved hsrc dir x).pre w d =
    ∀ p ≤ w.length, d.workTapes src (d.workTapePos src + ↑dir * ↑p) = w[p]?
@Turing.walkTM_contract_time : ∀ {k : ℕ} {Γ : Type} (src : Fin k) (moved : Fin k → Prop) [inst : DecidablePred moved]
  (hsrc : moved src) (dir : SignType) (x w : List Γ) (x_1 : Turing.Cfg k Γ Turing.SeekPhase x),
  (Turing.walkTM_contract src moved hsrc dir x).time w x_1 = w.length + 1
@Turing.zoneCascadeLeft_eq : ∀ {ℓ : ℕ} (j : ℕ) (z : Turing.ZoneContents ℓ),
  Turing.zoneCascadeLeft j z = (Turing.zoneCascadeRight j z.swap).swap
@Turing.zoneCascadeLeft_lengths : ∀ {ℓ : ℕ} (j : ℕ) (hj : j < ℓ) (z : Turing.ZoneContents ℓ),
  (∀ (k : ℕ) (hk : k < j), z.left ⟨k, ⋯⟩ = []) →
    (∀ (k : ℕ) (hk : k < j), (z.right ⟨k, ⋯⟩).length = Turing.zoneCapacity k) →
      2 ^ j ≤ (z.left ⟨j, hj⟩).length →
        (z.right ⟨j, hj⟩).length + 2 ^ j ≤ Turing.zoneCapacity j →
          (∀ (k : ℕ) (hk : k < j),
              ((Turing.zoneCascadeLeft j z).left ⟨k, ⋯⟩).length = 2 ^ k ∧
                ((Turing.zoneCascadeLeft j z).right ⟨k, ⋯⟩).length = 2 ^ k) ∧
            ((Turing.zoneCascadeLeft j z).left ⟨j, hj⟩).length = (z.left ⟨j, hj⟩).length - 2 ^ j ∧
              ((Turing.zoneCascadeLeft j z).right ⟨j, hj⟩).length = (z.right ⟨j, hj⟩).length + 2 ^ j
@Turing.zoneCascadeRight_blocked : ∀ {ℓ : ℕ} (j : ℕ) (hj : j < ℓ) (z : Turing.ZoneContents ℓ),
  (∀ (k : ℕ) (hk : k < j), (z.left ⟨k, ⋯⟩).length = Turing.zoneCapacity k) →
    (z.left ⟨j, hj⟩).length = Turing.zoneCapacity j →
      Turing.zoneSide (Turing.zoneCascadeRight j z).left = Turing.zoneSide z.left ∧
        Turing.zoneSide (Turing.zoneCascadeRight j z).right = Turing.zoneSide z.right
@Turing.zoneCascadeRight_frame : ∀ {ℓ : ℕ} (j : ℕ) (z : Turing.ZoneContents ℓ) (k : Fin ℓ),
  j < ↑k → (Turing.zoneCascadeRight j z).left k = z.left k ∧ (Turing.zoneCascadeRight j z).right k = z.right k
@Turing.zoneCascadeRight_home : ∀ {ℓ : ℕ} (j : ℕ) (hj : j < ℓ) (z : Turing.ZoneContents ℓ),
  (∀ (k : ℕ) (hk : k < j), z.right ⟨k, ⋯⟩ = []) →
    (∀ (k : ℕ) (hk : k < j), (z.left ⟨k, ⋯⟩).length = Turing.zoneCapacity k) →
      z.right ⟨j, hj⟩ ≠ [] →
        (z.left ⟨j, hj⟩).length + 2 ^ (j - 1) ≤ Turing.zoneCapacity j →
          (Turing.zoneCascadeRight j z).home = (Turing.zoneSide z.right).headI
@Turing.zoneCascadeRight_lengths : ∀ {ℓ : ℕ} (j : ℕ) (hj : j < ℓ) (z : Turing.ZoneContents ℓ),
  (∀ (k : ℕ) (hk : k < j), z.right ⟨k, ⋯⟩ = []) →
    (∀ (k : ℕ) (hk : k < j), (z.left ⟨k, ⋯⟩).length = Turing.zoneCapacity k) →
      2 ^ j ≤ (z.right ⟨j, hj⟩).length →
        (z.left ⟨j, hj⟩).length + 2 ^ j ≤ Turing.zoneCapacity j →
          (∀ (k : ℕ) (hk : k < j),
              ((Turing.zoneCascadeRight j z).right ⟨k, ⋯⟩).length = 2 ^ k ∧
                ((Turing.zoneCascadeRight j z).left ⟨k, ⋯⟩).length = 2 ^ k) ∧
            ((Turing.zoneCascadeRight j z).right ⟨j, hj⟩).length = (z.right ⟨j, hj⟩).length - 2 ^ j ∧
              ((Turing.zoneCascadeRight j z).left ⟨j, hj⟩).length = (z.left ⟨j, hj⟩).length + 2 ^ j
@Turing.zoneCascadeRight_zero : ∀ {ℓ : ℕ} (hℓ : 0 < ℓ) (z : Turing.ZoneContents ℓ),
  z.right ⟨0, hℓ⟩ ≠ [] →
    (z.left ⟨0, hℓ⟩).length + 1 ≤ Turing.zoneCapacity 0 →
      Turing.zoneSide (Turing.zoneCascadeRight 0 z).left = z.home :: Turing.zoneSide z.left ∧
        Turing.zoneSide (Turing.zoneCascadeRight 0 z).right = (Turing.zoneSide z.right).tail
@Turing.zoneCascade_false : ∀ {ℓ : ℕ} (j : ℕ) (z : Turing.ZoneContents ℓ),
  Turing.zoneCascade false j z = Turing.zoneCascadeLeft j z
@Turing.zoneCascade_true : ∀ {ℓ : ℕ} (j : ℕ) (z : Turing.ZoneContents ℓ),
  Turing.zoneCascade true j z = Turing.zoneCascadeRight j z
@Turing.zoneCells_length : ∀ {k ℓ : ℕ} (side : Bool) (z : Fin k → Turing.ZoneContents ℓ) (i : Fin ℓ),
  (Turing.zoneCells side z i).length = Turing.zoneCapacity ↑i
@Turing.zoneHomeWrite_home : ∀ {ℓ : ℕ} (z : Turing.ZoneContents ℓ) (v : Option Bool),
  (Turing.zoneHomeWrite z v).home = v
@Turing.zoneHomeWrite_left : ∀ {ℓ : ℕ} (z : Turing.ZoneContents ℓ) (v : Option Bool) (a : Fin ℓ),
  (Turing.zoneHomeWrite z v).left a = z.left a
@Turing.zoneHomeWrite_right : ∀ {ℓ : ℕ} (z : Turing.ZoneContents ℓ) (v : Option Bool) (a : Fin ℓ),
  (Turing.zoneHomeWrite z v).right a = z.right a
@Turing.zoneMoveLeft_home : ∀ {ℓ : ℕ} (hℓ : 0 < ℓ) (z : Turing.ZoneContents ℓ)
  (hroom : (z.right ⟨0, hℓ⟩).length + 1 ≤ Turing.zoneCapacity 0),
  (Turing.zoneMoveLeft hℓ z hroom).home = (z.left ⟨0, hℓ⟩).headI
@Turing.zoneMoveLeft_left : ∀ {ℓ : ℕ} (hℓ : 0 < ℓ) (z : Turing.ZoneContents ℓ)
  (hroom : (z.right ⟨0, hℓ⟩).length + 1 ≤ Turing.zoneCapacity 0) (j : Fin ℓ),
  (Turing.zoneMoveLeft hℓ z hroom).left j = if ↑j = 0 then (z.left j).tail else z.left j
@Turing.zoneMoveLeft_right : ∀ {ℓ : ℕ} (hℓ : 0 < ℓ) (z : Turing.ZoneContents ℓ)
  (hroom : (z.right ⟨0, hℓ⟩).length + 1 ≤ Turing.zoneCapacity 0) (j : Fin ℓ),
  (Turing.zoneMoveLeft hℓ z hroom).right j = if ↑j = 0 then z.home :: z.right j else z.right j
@Turing.zoneMoveRight_home : ∀ {ℓ : ℕ} (hℓ : 0 < ℓ) (z : Turing.ZoneContents ℓ)
  (hroom : (z.left ⟨0, hℓ⟩).length + 1 ≤ Turing.zoneCapacity 0),
  (Turing.zoneMoveRight hℓ z hroom).home = (z.right ⟨0, hℓ⟩).headI
@Turing.zoneMoveRight_left : ∀ {ℓ : ℕ} (hℓ : 0 < ℓ) (z : Turing.ZoneContents ℓ)
  (hroom : (z.left ⟨0, hℓ⟩).length + 1 ≤ Turing.zoneCapacity 0) (j : Fin ℓ),
  (Turing.zoneMoveRight hℓ z hroom).left j = if ↑j = 0 then z.home :: z.left j else z.left j
@Turing.zoneMoveRight_right : ∀ {ℓ : ℕ} (hℓ : 0 < ℓ) (z : Turing.ZoneContents ℓ)
  (hroom : (z.left ⟨0, hℓ⟩).length + 1 ≤ Turing.zoneCapacity 0) (j : Fin ℓ),
  (Turing.zoneMoveRight hℓ z hroom).right j = if ↑j = 0 then (z.right j).tail else z.right j
@Turing.zoneMove_false : ∀ {ℓ : ℕ} (z : Turing.ZoneContents ℓ),
  Turing.zoneMove false z =
    if hℓ : 0 < ℓ then
      if h : (z.right ⟨0, hℓ⟩).length + 1 ≤ Turing.zoneCapacity 0 then Turing.zoneMoveLeft hℓ z h else z
    else z
@Turing.zoneOwner_beyond : ∀ {ℓ n : ℕ}, Turing.zoneStart ℓ - 1 ≤ n → Turing.zoneOwner ℓ n = none
Turing.zoneOwner_eq : ∀ (ℓ n : ℕ),
  Turing.zoneOwner ℓ n = Fin.find fun i => Turing.zoneStart ↑i ≤ n ∧ n < Turing.zoneStart ↑i + Turing.zoneCapacity ↑i
@Turing.zoneOwner_of_mem : ∀ {ℓ : ℕ} (i : Fin ℓ) {n : ℕ},
  Turing.zoneStart ↑i ≤ n → n < Turing.zoneStart ↑i + Turing.zoneCapacity ↑i → Turing.zoneOwner ℓ n = some i
@Turing.zoneOwner_of_not_mem : ∀ {ℓ n : ℕ},
  (∀ (i : Fin ℓ), ¬(Turing.zoneStart ↑i ≤ n ∧ n < Turing.zoneStart ↑i + Turing.zoneCapacity ↑i)) →
    Turing.zoneOwner ℓ n = none
Turing.zoneOwner_sep : ∀ (ℓ i : ℕ), Turing.zoneOwner ℓ (Turing.zoneStart i - 1) = none
Turing.zoneOwner_succ : ∀ (ℓ n : ℕ),
  Turing.zoneOwner (ℓ + 1) n =
    if Turing.zoneStart ℓ ≤ n ∧ n < Turing.zoneStart ℓ + Turing.zoneCapacity ℓ then some (Fin.last ℓ)
    else Option.map Fin.castSucc (Turing.zoneOwner ℓ n)
@Turing.zoneRebalance_false : ∀ {ℓ : ℕ} (z : Turing.ZoneContents ℓ),
  Turing.zoneRebalance false z = (Turing.zoneRebalance true z.swap).swap
@Turing.zoneRebalance_of_le : ∀ {ℓ : ℕ} (dir : Bool) (z : Turing.ZoneContents ℓ),
  ℓ ≤ Turing.zoneShiftIndex dir z → Turing.zoneRebalance dir z = z
@Turing.zoneRebalance_of_lt : ∀ {ℓ : ℕ} (dir : Bool) (z : Turing.ZoneContents ℓ),
  Turing.zoneShiftIndex dir z < ℓ → Turing.zoneRebalance dir z = Turing.zoneCascade dir (Turing.zoneShiftIndex dir z) z
@Turing.zoneShiftIn_home : ∀ {ℓ : ℕ} (side : Bool) (i : ℕ) (z : Turing.ZoneContents ℓ),
  (Turing.zoneShiftIn side i z).home = z.home
@Turing.zoneShiftIn_left : ∀ {ℓ : ℕ} (side : Bool) (i : ℕ) (z : Turing.ZoneContents ℓ) (a : Fin ℓ),
  (Turing.zoneShiftIn side i z).left a = (if side = true then z.left else Turing.zoneShiftInW i z.left) a
@Turing.zoneShiftIn_right : ∀ {ℓ : ℕ} (side : Bool) (i : ℕ) (z : Turing.ZoneContents ℓ) (a : Fin ℓ),
  (Turing.zoneShiftIn side i z).right a = (if side = true then Turing.zoneShiftInW i z.right else z.right) a
@Turing.zoneShiftIndex_empty : ∀ {ℓ : ℕ} (dir : Bool) (z : Turing.ZoneContents ℓ) (i : Fin ℓ),
  ↑i < Turing.zoneShiftIndex dir z → Turing.ZoneContents.words dir z i = []
@Turing.zoneShiftIndex_eq : ∀ {ℓ : ℕ} (dir : Bool) (z : Turing.ZoneContents ℓ) (j : ℕ) (hj : j < ℓ),
  (∀ (i : Fin ℓ), ↑i < j → Turing.ZoneContents.words dir z i = []) →
    Turing.ZoneContents.words dir z ⟨j, hj⟩ ≠ [] → Turing.zoneShiftIndex dir z = j
@Turing.zoneShiftIndex_eq_findIdx : ∀ {ℓ : ℕ} (dir : Bool) (z : Turing.ZoneContents ℓ),
  Turing.zoneShiftIndex dir z = List.findIdx (fun i => !(Turing.ZoneContents.words dir z i).isEmpty) (List.finRange ℓ)
@Turing.zoneShiftIndex_eq_length_iff : ∀ {ℓ : ℕ} (dir : Bool) (z : Turing.ZoneContents ℓ),
  Turing.zoneShiftIndex dir z = ℓ ↔ ∀ (i : Fin ℓ), Turing.ZoneContents.words dir z i = []
@Turing.zoneShiftIndex_extend : ∀ {ℓ : ℕ} (dir : Bool) (z : Turing.ZoneContents ℓ),
  Turing.zoneShiftIndex dir z = ℓ → Turing.zoneShiftIndex dir z.extend = ℓ
@Turing.zoneShiftIndex_extend_of_lt : ∀ {ℓ : ℕ} (dir : Bool) (z : Turing.ZoneContents ℓ),
  Turing.zoneShiftIndex dir z < ℓ → Turing.zoneShiftIndex dir z.extend = Turing.zoneShiftIndex dir z
@Turing.zoneShiftIndex_le : ∀ {ℓ : ℕ} (dir : Bool) (z : Turing.ZoneContents ℓ), Turing.zoneShiftIndex dir z ≤ ℓ
@Turing.zoneShiftIndex_nonempty : ∀ {ℓ : ℕ} (dir : Bool) (z : Turing.ZoneContents ℓ)
  (h : Turing.zoneShiftIndex dir z < ℓ), Turing.ZoneContents.words dir z ⟨Turing.zoneShiftIndex dir z, h⟩ ≠ []
@Turing.zoneShiftOut_home : ∀ {ℓ : ℕ} (side : Bool) (i : ℕ) (z : Turing.ZoneContents ℓ),
  (Turing.zoneShiftOut side i z).home = z.home
@Turing.zoneShiftOut_left : ∀ {ℓ : ℕ} (side : Bool) (i : ℕ) (z : Turing.ZoneContents ℓ) (a : Fin ℓ),
  (Turing.zoneShiftOut side i z).left a = (if side = true then z.left else Turing.zoneShiftOutW i z.left) a
@Turing.zoneShiftOut_right : ∀ {ℓ : ℕ} (side : Bool) (i : ℕ) (z : Turing.ZoneContents ℓ) (a : Fin ℓ),
  (Turing.zoneShiftOut side i z).right a = (if side = true then Turing.zoneShiftOutW i z.right else z.right) a
@Turing.zoneSlotOf_inl : ∀ {k : ℕ} (t : Fin k) (b : Bool), Turing.zoneSlotOf t (Sum.inl b) = none
@Turing.zoneSlotOf_slotSet_ne : ∀ {k : ℕ} {s t : Fin k},
  s ≠ t →
    ∀ (c : Turing.ZoneCell k) (v : Option (Option Bool)),
      Turing.zoneSlotOf s (Turing.zoneSlotSet t (some (Sum.inr c)) v) = c s
@Turing.zoneSlotSet_eq : ∀ {k : ℕ} (t : Fin k) (cell : Option (Turing.ZoneSym k)) (s : Option (Option Bool)),
  Turing.zoneSlotSet t cell s = Sum.inr (Function.update (Turing.zoneCellOfCell cell) t s)
@Turing.zoneStart_add_lt : ∀ {i j : ℕ}, i < j → Turing.zoneStart i + Turing.zoneCapacity i < Turing.zoneStart j
@Turing.zoneStart_mono : ∀ {i j : ℕ}, i ≤ j → Turing.zoneStart i ≤ Turing.zoneStart j
@Turing.zonedTape_homeWrite : ∀ {k ℓ : ℕ} (z : Fin k → Turing.ZoneContents ℓ) (v : Fin k → Option Bool),
  Function.update (Turing.zonedTape z) 0 (some (Sum.inr fun t => some (v t))) =
    Turing.zonedTape fun t => Turing.zoneHomeWrite (z t) (v t)
@Turing.zonedTape_injective : ∀ {k ℓ : ℕ} {z z' : Fin k → Turing.ZoneContents ℓ},
  Turing.zonedTape z = Turing.zonedTape z' → z = z'
@Turing.zonedTape_of_neg : ∀ {k ℓ : ℕ} (z : Fin k → Turing.ZoneContents ℓ) {c : ℤ},
  c < 0 → Turing.zonedTape z c = Turing.zoneCellAt false z (-c).toNat
@Turing.RoundContract.hullLo_eq : ∀ {k : ℕ} {Γ S : Type} {M : Turing.MultiTapeTM k Γ S} {a : S} {E : Set (Option S)}
  {ι : Type} {x : List Γ} (R : Turing.RoundContract M a E ι x) (i : ι) (c : Turing.Cfg k Γ S x) (n : ℕ) (j : Fin k),
  R.hullLo i c n j =
    (Finset.range (n + 1)).inf' ⋯ fun r =>
      if r < n then R.lo i (Turing.roundOrbit M (R.time i) c r) j
      else (Turing.roundOrbit M (R.time i) c r).workTapePos j
@Turing.RoundContract.hullHi_eq : ∀ {k : ℕ} {Γ S : Type} {M : Turing.MultiTapeTM k Γ S} {a : S} {E : Set (Option S)}
  {ι : Type} {x : List Γ} (R : Turing.RoundContract M a E ι x) (i : ι) (c : Turing.Cfg k Γ S x) (n : ℕ) (j : Fin k),
  R.hullHi i c n j =
    (Finset.range (n + 1)).sup' ⋯ fun r =>
      if r < n then R.hi i (Turing.roundOrbit M (R.time i) c r) j
      else (Turing.roundOrbit M (R.time i) c r).workTapePos j
@Turing.Cfg.bindState_inputPos : ∀ {k : ℕ} {Γ S S' : Type} {x : List Γ} (d : Turing.Cfg k Γ S x) (f : S → Option S'),
  (d.bindState f).inputPos = d.inputPos
@Turing.Cfg.bindState_workTapes : ∀ {k : ℕ} {Γ S S' : Type} {x : List Γ} (d : Turing.Cfg k Γ S x) (f : S → Option S')
  (a : Fin k) (a_1 : ℤ), (d.bindState f).workTapes a a_1 = d.workTapes a a_1
@Turing.Cfg.bindState_workTapePos : ∀ {k : ℕ} {Γ S S' : Type} {x : List Γ} (d : Turing.Cfg k Γ S x) (f : S → Option S')
  (a : Fin k), (d.bindState f).workTapePos a = d.workTapePos a
@Turing.Cfg.bindState_output : ∀ {k : ℕ} {Γ S S' : Type} {x : List Γ} (d : Turing.Cfg k Γ S x) (f : S → Option S'),
  (d.bindState f).output = d.output
@Turing.Contract.ofSegment_pre : ∀ {k : ℕ} {Γ S : Type} {M : Turing.MultiTapeTM k Γ S} {entry : S}
  {exits : Set (Option S)} {ι : Type} {x : List Γ} (pre : ι → Turing.Cfg k Γ S x → Prop)
  (time : ι → Turing.Cfg k Γ S x → ℕ) (post : ι → Turing.Cfg k Γ S x → Turing.Cfg k Γ S x)
  (lo hi : ι → Turing.Cfg k Γ S x → Fin k → ℤ)
  (seg :
    ∀ (i : ι) (d : Turing.Cfg k Γ S x),
      d.state = some entry →
        pre i d → Turing.Segment M exits (Turing.HeadBox (lo i d) (hi i d)) d (post i d) (time i d))
