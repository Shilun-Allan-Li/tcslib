Turing.exists_zoneRebalanceTM : ∀ (k : ℕ),
  ∃ C,
    ∀ (dir : Bool) (t : Fin k),
      ∃ S x x M entry done short,
        done ≠ short ∧
          ∀ (x : List (Turing.ZoneSym k)),
            ∃ R,
              R.pre = Turing.zoneRowPre ∧
                R.post = Turing.zoneRebalancePost dir t done short ∧
                  R.lo = Turing.zoneRowLo (Turing.zoneRebalanceIndex dir t) C ∧
                    R.hi = Turing.zoneRowHi (Turing.zoneRebalanceIndex dir t) C ∧
                      ∀ (D : Turing.ZoneData k) (d : Turing.Cfg 2 (Turing.ZoneSym k) S x),
                        d.state = some entry → R.pre D d → R.time D d ≤ C * (2 ^ Turing.zoneRebalanceIndex dir t D + 1)
Turing.exists_zoneExtendTM : ∀ (k : ℕ),
  ∃ C S x x M entry done,
    ∀ (x : List (Turing.ZoneSym k)),
      ∃ R,
        R.pre = Turing.zoneRowPre ∧
          R.post = Turing.zoneExtendPost done ∧
            R.lo = Turing.zoneRowLo (fun D => D.fst) C ∧
              R.hi = Turing.zoneRowHi (fun D => D.fst) C ∧
                ∀ (D : Turing.ZoneData k) (d : Turing.Cfg 2 (Turing.ZoneSym k) S x),
                  d.state = some entry → R.pre D d → R.time D d ≤ C * (2 ^ D.fst + 1)
Turing.ZoneData : ℕ → Type
@Turing.zoneRowPre : {k : ℕ} →
  {S : Type} → {x : List (Turing.ZoneSym k)} → Turing.ZoneData k → Turing.Cfg 2 (Turing.ZoneSym k) S x → Prop
@Turing.zoneRebalanceIndex : {k : ℕ} → Bool → Fin k → Turing.ZoneData k → ℕ
@Turing.zoneRebalanceData : {k : ℕ} → Bool → Fin k → Turing.ZoneData k → Turing.ZoneData k
@Turing.zoneExtendData : {k : ℕ} → Turing.ZoneData k → Turing.ZoneData k
@Turing.zoneRebalancePost : {k : ℕ} →
  Bool →
    Fin k →
      {S : Type} →
        {x : List (Turing.ZoneSym k)} →
          S → S → Turing.ZoneData k → Turing.Cfg 2 (Turing.ZoneSym k) S x → Turing.Cfg 2 (Turing.ZoneSym k) S x
@Turing.zoneExtendPost : {k : ℕ} →
  {S : Type} →
    {x : List (Turing.ZoneSym k)} →
      S → Turing.ZoneData k → Turing.Cfg 2 (Turing.ZoneSym k) S x → Turing.Cfg 2 (Turing.ZoneSym k) S x
@Turing.zoneRowLo : {k : ℕ} →
  {S : Type} →
    {x : List (Turing.ZoneSym k)} →
      (Turing.ZoneData k → ℕ) → ℕ → Turing.ZoneData k → Turing.Cfg 2 (Turing.ZoneSym k) S x → Fin 2 → ℤ
@Turing.zoneRowHi : {k : ℕ} →
  {S : Type} →
    {x : List (Turing.ZoneSym k)} →
      (Turing.ZoneData k → ℕ) → ℕ → Turing.ZoneData k → Turing.Cfg 2 (Turing.ZoneSym k) S x → Fin 2 → ℤ
@Turing.zoneRowPre_rebalancePost : ∀ {k : ℕ} (dir : Bool) (t : Fin k) {S S' : Type} {x : List (Turing.ZoneSym k)}
  (done short : S) (D : Turing.ZoneData k) (d : Turing.Cfg 2 (Turing.ZoneSym k) S x),
  Turing.zoneRowPre D d →
    ∀ (f : S → S'),
      Turing.zoneRowPre (Turing.zoneRebalanceData dir t D)
        (Turing.Cfg.mapState f (Turing.zoneRebalancePost dir t done short D d))
@Turing.zoneRowPre_extendPost : ∀ {k : ℕ} {S S' : Type} {x : List (Turing.ZoneSym k)} (done : S) (D : Turing.ZoneData k)
  (d : Turing.Cfg 2 (Turing.ZoneSym k) S x),
  Turing.zoneRowPre D d →
    ∀ (f : S → S'), Turing.zoneRowPre (Turing.zoneExtendData D) (Turing.Cfg.mapState f (Turing.zoneExtendPost done D d))
@Turing.zoneRebalancePost_state_done : ∀ {k : ℕ} (dir : Bool) (t : Fin k) {S : Type} {x : List (Turing.ZoneSym k)}
  {done short : S},
  done ≠ short →
    ∀ (D : Turing.ZoneData k) (d : Turing.Cfg 2 (Turing.ZoneSym k) S x),
      (Turing.zoneRebalancePost dir t done short D d).state = some done ↔ Turing.zoneRebalanceIndex dir t D < D.fst
@Turing.zoneRebalanceData_of_short : ∀ {k : ℕ} (dir : Bool) (t : Fin k) (D : Turing.ZoneData k),
  ¬Turing.zoneRebalanceIndex dir t D < D.fst → Turing.zoneRebalanceData dir t D = D
@Turing.zoneRebalanceIndex_extend_of_short : ∀ {k : ℕ} (dir : Bool) (t : Fin k) (D : Turing.ZoneData k),
  ¬Turing.zoneRebalanceIndex dir t D < D.fst → Turing.zoneRebalanceIndex dir t (Turing.zoneExtendData D) = D.fst
@Turing.zoneRebalancePost_frames : ∀ {k : ℕ} (dir : Bool) (t : Fin k) {S : Type} {x : List (Turing.ZoneSym k)}
  (done short : S) (D : Turing.ZoneData k) (d : Turing.Cfg 2 (Turing.ZoneSym k) S x),
  Turing.zoneRowPre D d →
    Turing.Cfg.SameOutside
      (fun j =>
        if j = 0 then
          Set.Icc (-↑(Turing.zoneStart (Turing.zoneRebalanceIndex dir t D + 1)))
            ↑(Turing.zoneStart (Turing.zoneRebalanceIndex dir t D + 1))
        else ∅)
      d (Turing.zoneRebalancePost dir t done short D d)
@Turing.zoneExtendPost_frames : ∀ {k : ℕ} {S : Type} {x : List (Turing.ZoneSym k)} (done : S) (D : Turing.ZoneData k)
  (d : Turing.Cfg 2 (Turing.ZoneSym k) S x),
  Turing.zoneRowPre D d →
    Turing.Cfg.SameOutside
      (fun j =>
        if j = 0 then
          {c | ↑(Turing.zoneStart D.fst) ≤ |c| ∧ |c| < ↑(Turing.zoneStart D.fst) + ↑(Turing.zoneCapacity D.fst)}
        else ∅)
      d (Turing.zoneExtendPost done D d)
Turing.ZoneContents : ℕ → Type
@Turing.ZoneContents.extend : {ℓ : ℕ} → Turing.ZoneContents ℓ → Turing.ZoneContents (ℓ + 1)
Turing.zoneCapacity : ℕ → ℕ
@Turing.zoneShiftIndex : {ℓ : ℕ} → Bool → Turing.ZoneContents ℓ → ℕ
@Turing.zoneRebalance : {ℓ : ℕ} → Bool → Turing.ZoneContents ℓ → Turing.ZoneContents ℓ
@Turing.zoneCascade : {ℓ : ℕ} → Bool → ℕ → Turing.ZoneContents ℓ → Turing.ZoneContents ℓ
@Turing.zoneCascadeRight : {ℓ : ℕ} → ℕ → Turing.ZoneContents ℓ → Turing.ZoneContents ℓ
@Turing.zoneCascadeLeft : {ℓ : ℕ} → ℕ → Turing.ZoneContents ℓ → Turing.ZoneContents ℓ
@Turing.zoneMove : {ℓ : ℕ} → Bool → Turing.ZoneContents ℓ → Turing.ZoneContents ℓ
@Turing.zoneShiftInW : {ℓ : ℕ} → ℕ → (Fin ℓ → List (Option Bool)) → Fin ℓ → List (Option Bool)
@Turing.zoneShiftOutW : {ℓ : ℕ} → ℕ → (Fin ℓ → List (Option Bool)) → Fin ℓ → List (Option Bool)
@Turing.zoneSide_rebalance_right : ∀ {ℓ : ℕ} (z : Turing.ZoneContents ℓ) (h : Turing.zoneShiftIndex true z < ℓ),
  (∀ (k : ℕ) (hk : k < Turing.zoneShiftIndex true z), (z.left ⟨k, ⋯⟩).length = Turing.zoneCapacity k) →
    (z.left ⟨Turing.zoneShiftIndex true z, h⟩).length + 2 ^ (Turing.zoneShiftIndex true z - 1) ≤
        Turing.zoneCapacity (Turing.zoneShiftIndex true z) →
      Turing.zoneSide (Turing.zoneRebalance true z).left = z.home :: Turing.zoneSide z.left ∧
        Turing.zoneSide (Turing.zoneRebalance true z).right = (Turing.zoneSide z.right).tail
Turing.zoneCascade_cost_le : ∀ (j : ℕ), ∑ i ∈ Finset.range j, 4 * (2 ^ (i + 1) + (i + 1) + 1) ≤ 16 * 2 ^ j
@Turing.zoneRebalance_frame : ∀ {ℓ : ℕ} (dir : Bool) (z : Turing.ZoneContents ℓ) (k : Fin ℓ),
  Turing.zoneShiftIndex dir z < ↑k →
    (Turing.zoneRebalance dir z).left k = z.left k ∧ (Turing.zoneRebalance dir z).right k = z.right k
Turing.ZoneSym : ℕ → Type
Turing.ZoneCell : ℕ → Type
@Turing.zoneSlotOf : {k : ℕ} → Fin k → Turing.ZoneSym k → Option (Option Bool)
@Turing.zoneSlotSet : {k : ℕ} → Fin k → Option (Turing.ZoneSym k) → Option (Option Bool) → Turing.ZoneSym k
Turing.zoneStart : ℕ → ℕ
Turing.zoneStart_succ : ∀ (i : ℕ), Turing.zoneStart (i + 1) = Turing.zoneStart i + Turing.zoneCapacity i + 1
Turing.zoneStart_eq : ∀ (i : ℕ), Turing.zoneStart i = 2 ^ (i + 1) + i
Turing.zoneOwner : (ℓ : ℕ) → ℕ → Option (Fin ℓ)
@Turing.zoneCells : {k ℓ : ℕ} → Bool → (Fin k → Turing.ZoneContents ℓ) → Fin ℓ → List (Turing.ZoneSym k)
@Turing.zonedTape : {k ℓ : ℕ} → (Fin k → Turing.ZoneContents ℓ) → ℤ → Option (Turing.ZoneSym k)
@Turing.zonedTape_zero : ∀ {k ℓ : ℕ} (z : Fin k → Turing.ZoneContents ℓ),
  Turing.zonedTape z 0 = some (Sum.inr fun t => some (z t).home)
@Turing.zonedTape_right : ∀ {k ℓ : ℕ} (z : Fin k → Turing.ZoneContents ℓ) (i : Fin ℓ),
  ∀ p < Turing.zoneCapacity ↑i,
    Turing.zonedTape z ↑(Turing.zoneStart ↑i + p) = some (Sum.inr fun t => (Turing.ZoneContents.words true (z t) i)[p]?)
@Turing.zonedTape_left : ∀ {k ℓ : ℕ} (z : Fin k → Turing.ZoneContents ℓ) (i : Fin ℓ),
  ∀ p < Turing.zoneCapacity ↑i,
    Turing.zonedTape z (-↑(Turing.zoneStart ↑i + p)) =
      some (Sum.inr fun t => (Turing.ZoneContents.words false (z t) i)[p]?)
@Turing.zonedTape_right_sep : ∀ {k ℓ : ℕ} (z : Fin k → Turing.ZoneContents ℓ) (i : ℕ),
  Turing.zonedTape z (↑(Turing.zoneStart i) - 1) = none
@Turing.zonedTape_left_sep : ∀ {k ℓ : ℕ} (z : Fin k → Turing.ZoneContents ℓ) (i : ℕ),
  Turing.zonedTape z (-↑(Turing.zoneStart i) + 1) = none
@Turing.zonedTape_blank_outside : ∀ {k ℓ : ℕ} (z : Fin k → Turing.ZoneContents ℓ) (c : ℤ),
  ↑(Turing.zoneStart ℓ) - 1 ≤ |c| → Turing.zonedTape z c = none
@Turing.zonedTape_right_word : ∀ {k ℓ : ℕ} (z : Fin k → Turing.ZoneContents ℓ) (i : Fin ℓ) (p : ℤ),
  -1 ≤ p →
    p ≤ ↑(Turing.zoneCapacity ↑i) →
      Turing.zonedTape z (↑(Turing.zoneStart ↑i) + p) = Turing.FinTM.bufferTape (Turing.zoneCells true z i) p
@Turing.zonedTape_left_word : ∀ {k ℓ : ℕ} (z : Fin k → Turing.ZoneContents ℓ) (i : Fin ℓ) (p : ℤ),
  -1 ≤ p →
    p ≤ ↑(Turing.zoneCapacity ↑i) →
      Turing.zonedTape z (-(↑(Turing.zoneStart ↑i) + ↑(Turing.zoneCapacity ↑i) - 1) + p) =
        Turing.FinTM.bufferTape (Turing.zoneCells false z i).reverse p
@Turing.zonedTape_update_slot : ∀ {k ℓ : ℕ} (z : Fin k → Turing.ZoneContents ℓ) {s t : Fin k},
  s ≠ t →
    ∀ (w : Turing.ZoneContents ℓ) (c : ℤ),
      Option.map (Turing.zoneSlotOf s) (Turing.zonedTape (Function.update z t w) c) =
        Option.map (Turing.zoneSlotOf s) (Turing.zonedTape z c)
@Turing.zonedTape_isSome : ∀ {k ℓ : ℕ} (z z' : Fin k → Turing.ZoneContents ℓ) (c : ℤ),
  (Turing.zonedTape z c).isSome = (Turing.zonedTape z' c).isSome
@Turing.zonedTape_extend : ∀ {k ℓ : ℕ} (z : Fin k → Turing.ZoneContents ℓ) (c : ℤ),
  Turing.zonedTape (fun t => (z t).extend) c =
    if ↑(Turing.zoneStart ℓ) ≤ |c| ∧ |c| < ↑(Turing.zoneStart ℓ) + ↑(Turing.zoneCapacity ℓ) then
      some (Sum.inr fun x => if |c|.toNat - Turing.zoneStart ℓ < 2 ^ ℓ then some none else none)
    else Turing.zonedTape z c
@Turing.framedContract : {k : ℕ} →
  {Γ S ι : Type} →
    (M : Turing.MultiTapeTM k Γ S) →
      (entry done : S) →
        (x : List Γ) →
          (pre : ι → Turing.Cfg k Γ S x → Prop) →
            (time : ι → Turing.Cfg k Γ S x → ℕ) →
              (post : ι → Turing.Cfg k Γ S x → Turing.Cfg k Γ S x) →
                (touched : Fin k → Prop) →
                  [inst : DecidablePred touched] →
                    (lo hi : ι → Turing.Cfg k Γ S x → Fin k → ℤ) →
                      (∀ (i : ι) (d : Turing.Cfg k Γ S x), (post i d).state = some done) →
                        (∀ (i : ι) (d : Turing.Cfg k Γ S x),
                            d.state = some entry →
                              pre i d →
                                Turing.MultiTapeTM.runFrom d (time i d) = post i d ∧
                                  (∀ t < time i d, (Turing.MultiTapeTM.runFrom d t).state ≠ some done) ∧
                                    ∀ (j : Fin k),
                                      ∀ t ≤ time i d,
                                        if touched j then
                                          (Turing.MultiTapeTM.runFrom d t).workTapePos j ∈
                                            Finset.Icc (lo i d j) (hi i d j)
                                        else (Turing.MultiTapeTM.runFrom d t).workTapePos j = d.workTapePos j) →
                          Turing.Contract M entry {some done} ι x
@Turing.sweepContract : {k : ℕ} →
  {Γ S : Type} →
    (M : Turing.MultiTapeTM k Γ S) →
      (entry done : S) →
        (src : Fin k) →
          (touched : Fin k → Prop) →
            [inst : DecidablePred touched] →
              (x : List Γ) →
                (post : List Γ → Turing.Cfg k Γ S x → Turing.Cfg k Γ S x) →
                  (∀ (w : List Γ) (d : Turing.Cfg k Γ S x), (post w d).state = some done) →
                    (∀ (w : List Γ) (d : Turing.Cfg k Γ S x),
                        d.state = some entry →
                          (∀ (p : ℤ),
                              -1 ≤ p →
                                p ≤ ↑w.length → d.workTapes src (d.workTapePos src + p) = Turing.FinTM.bufferTape w p) →
                            Turing.MultiTapeTM.runFrom d (2 * w.length + 2) = post w d ∧
                              (∀ t < 2 * w.length + 2, (Turing.MultiTapeTM.runFrom d t).state ≠ some done) ∧
                                ∀ (j : Fin k),
                                  ∀ t ≤ 2 * w.length + 2,
                                    if touched j then
                                      (Turing.MultiTapeTM.runFrom d t).workTapePos j ∈
                                        Finset.Icc (d.workTapePos j - 1) (d.workTapePos j + ↑w.length)
                                    else (Turing.MultiTapeTM.runFrom d t).workTapePos j = d.workTapePos j) →
                      Turing.Contract M entry {some done} (List Γ) x
@Turing.seekPost : {k : ℕ} → {Γ S : Type} → {x : List Γ} → S → Fin k → ℤ → Turing.Cfg k Γ S x → Turing.Cfg k Γ S x
@Turing.walkTM : {Symbol : Type u_1} →
  (k : ℕ) →
    Fin k → (moved : Fin k → Prop) → [DecidablePred moved] → SignType → Turing.MultiTapeTM k Symbol Turing.SeekPhase
@Turing.walkTM_run_ofCfg : ∀ {Symbol : Type u_1} {k : ℕ} {x : List Symbol} (src : Fin k) (moved : Fin k → Prop)
  [inst : DecidablePred moved],
  moved src →
    ∀ (dir : SignType) (w : List Symbol) (d : Turing.Cfg k Symbol Turing.SeekPhase x),
      d.state = some Turing.SeekPhase.run →
        (∀ p ≤ w.length, d.workTapes src (d.workTapePos src + ↑dir * ↑p) = Turing.FinTM.bufferTape w ↑p) →
          Turing.MultiTapeTM.runFrom d (w.length + 1) =
              { state := some Turing.SeekPhase.done, inputPos := d.inputPos, workTapes := d.workTapes,
                workTapePos := fun j => d.workTapePos j + if moved j then ↑dir * ↑(w.length + 1) else 0,
                output := d.output } ∧
            (∀ t < w.length + 1, (Turing.MultiTapeTM.runFrom d t).state ≠ some Turing.SeekPhase.done) ∧
              ∀ (j : Fin k),
                ∀ t ≤ w.length + 1,
                  (Turing.MultiTapeTM.runFrom d t).workTapePos j = d.workTapePos j + if moved j then ↑dir * ↑t else 0
@Turing.walkTM_contract : {k : ℕ} →
  {Γ : Type} →
    (src : Fin k) →
      (moved : Fin k → Prop) →
        [inst : DecidablePred moved] →
          moved src →
            (dir : SignType) →
              (x : List Γ) →
                Turing.Contract (Turing.walkTM k src moved dir) Turing.SeekPhase.run {some Turing.SeekPhase.done}
                  (List Γ) x
@Turing.skipTM_contract : {k : ℕ} →
  {Γ : Type} →
    (i : Fin k) →
      (x : List Γ) → Turing.Contract (Turing.skipTM k i) Turing.SeekPhase.run {some Turing.SeekPhase.done} (List Γ) x
@Turing.skipBackTM_contract : {k : ℕ} →
  {Γ : Type} →
    (i : Fin k) →
      (x : List Γ) →
        Turing.Contract (Turing.skipBackTM k i) Turing.SeekPhase.run {some Turing.SeekPhase.done} (List Γ) x
@Turing.seekEndTM_contract : {k : ℕ} →
  {Γ : Type} →
    (i : Fin k) →
      (x : List Γ) →
        Turing.Contract (Turing.seekEndTM k i) Turing.SeekPhase.run {some Turing.SeekPhase.done} (List (List Γ)) x
@Turing.seekStartTM_contract : {k : ℕ} →
  {Γ : Type} →
    (i : Fin k) →
      (x : List Γ) →
        Turing.Contract (Turing.seekStartTM k i) Turing.SeekPhase.run {some Turing.SeekPhase.done} (List (List Γ)) x
@Turing.scanTM_contract : {k : ℕ} →
  {Γ A : Type} →
    (i : Fin k) →
      (δf δb : A → Γ → A × Γ) →
        (a₀ : A) →
          (x : List Γ) →
            Turing.Contract (Turing.scanTM k i δf δb a₀) (Turing.ScanPhase.fwd a₀)
              (Set.range fun a => some (Turing.ScanPhase.done a)) (List Γ) x
@Turing.scanResult : {A : Type u_1} → {Γ : Type u_2} → (A → Γ → A × Γ) → (A → Γ → A × Γ) → A → List Γ → A × List Γ
@Turing.scanMap : {A : Type u_1} → {Γ : Type u_2} → (Γ → Γ) → A → Γ → A × Γ
@Turing.scanShift : {B : Type u_1} → {Γ : Type u_2} → (Γ → B) → (Γ → B → Γ) → B → Γ → B × Γ
@Turing.copyMapTM_contract : {k : ℕ} →
  {Γ Δ : Type} →
    (src dst : Fin k) →
      src ≠ dst →
        (extract : Γ → Δ) →
          (merge : Option Γ → Δ → Γ) →
            (x : List Γ) →
              Turing.Contract (Turing.copyMapTM k src dst extract merge) Turing.SweepPhase.sweep
                {some Turing.SweepPhase.done} (List Γ) x
@Turing.transferMapTM_contract : {k : ℕ} →
  {Γ Δ : Type} →
    (src dst : Fin k) →
      src ≠ dst →
        (extract : Γ → Δ) →
          (merge : Option Γ → Δ → Γ) →
            (rest : Γ → Option Γ) →
              (x : List Γ) →
                Turing.Contract (Turing.transferMapTM k src dst extract merge rest) Turing.SweepPhase.sweep
                  {some Turing.SweepPhase.done} (List Γ) x
@Turing.clearTM_contract : {k : ℕ} →
  {Γ : Type} →
    (i : Fin k) →
      (x : List Γ) →
        Turing.Contract (Turing.clearTM k i) Turing.SweepPhase.sweep {some Turing.SweepPhase.done} (List Γ) x
@Turing.fieldsTape : {Γ : Type u_1} → List (List Γ) → ℤ → Option Γ
@Turing.fieldOffset : {Γ : Type u_1} → List (List Γ) → ℕ → ℕ
@Turing.fieldsTape_cons_shift : ∀ {Γ : Type u_1} (u v : List Γ) (fs : List (List Γ)) (z : ℤ),
  -1 ≤ z → Turing.fieldsTape (u :: v :: fs) (↑u.length + 1 + z) = Turing.fieldsTape (v :: fs) z
@Turing.fieldOffset_succ : ∀ {Γ : Type u_1} (fs : List (List Γ)) (j : ℕ) (hj : j < fs.length),
  Turing.fieldOffset fs (j + 1) = Turing.fieldOffset fs j + (fs[j].length + 1)
@Turing.joinFields : {Γ : Type u_1} → List (List Γ) → List (Option Γ)
@Turing.Contract : {k : ℕ} → {Γ S : Type} → Turing.MultiTapeTM k Γ S → S → Set (Option S) → Type → List Γ → Type
@Turing.Contract.seq : {k : ℕ} →
  {Γ S₁ S₂ : Type} →
    [inst : DecidableEq S₁] →
      {M₁ : Turing.MultiTapeTM k Γ S₁} →
        {M₂ : Turing.MultiTapeTM k Γ S₂} →
          {entry₁ exit₁ : S₁} →
            {entry₂ : S₂} →
              {X₂ : Set (Option S₂)} →
                {ι κ : Type} →
                  {x : List Γ} →
                    (C₁ : Turing.Contract M₁ entry₁ {some exit₁} ι x) →
                      (C₂ : Turing.Contract M₂ entry₂ X₂ κ x) →
                        (link : ι → κ) →
                          (∀ (i : ι) (d : Turing.Cfg k Γ S₁ x),
                              d.state = some entry₁ →
                                C₁.pre i d → C₂.pre (link i) (Turing.Cfg.mapState (fun x => entry₂) (C₁.post i d))) →
                            Turing.Contract (Turing.seamCompTM M₁ exit₁ M₂ entry₂) (Sum.inl entry₁)
                              (Option.map Sum.inr '' X₂) ι x
@Turing.Contract.inPhase : {k : ℕ} →
  {Γ I : Type} →
    {Ph : I → Type} →
      (Mf : (i : I) → Turing.MultiTapeTM k Γ (Ph i)) →
        (q0 : (i : I) × Ph i) →
          (red : (i : I) → Ph i → Option ((i : I) × Ph i)) →
            (p : I) →
              {s₀ : Ph p} →
                {X : Set (Option (Ph p))} →
                  {ι : Type} →
                    {x : List Γ} →
                      Turing.Contract (Mf p) s₀ X ι x →
                        none ∉ X →
                          (∀ (s : Ph p), some s ∉ X → red p s = none) →
                            (∀ (s : Ph p), some s ∈ X → ∃ q, red p s = some q ∧ q.fst ≠ p) →
                              Turing.Contract (Turing.phaseHostTM Mf q0 red) ⟨p, s₀⟩ {q | ∃ s, some s ∈ X ∧ q = red p s}
                                ι x
@Turing.Contract.branch : {k : ℕ} →
  {Γ S₀ S₁ S₂ : Type} →
    [inst : DecidableEq S₀] →
      [inst_1 : DecidableEq S₁] →
        {M₀ : Turing.MultiTapeTM k Γ S₀} →
          {M₁ : Turing.MultiTapeTM k Γ S₁} →
            {M₂ : Turing.MultiTapeTM k Γ S₂} →
              {entry₀ e₁ e₂ : S₀} →
                {entry₁ : S₁} →
                  {entry₂ : S₂} →
                    {X₁ : Set (Option S₁)} →
                      {X₂ : Set (Option S₂)} →
                        {ι κ₁ κ₂ : Type} →
                          {x : List Γ} →
                            e₁ ≠ e₂ →
                              (C₀ : Turing.Contract M₀ entry₀ {some e₁, some e₂} ι x) →
                                (C₁ : Turing.Contract M₁ entry₁ X₁ κ₁ x) →
                                  (C₂ : Turing.Contract M₂ entry₂ X₂ κ₂ x) →
                                    (l₁ : ι → κ₁) →
                                      (l₂ : ι → κ₂) →
                                        (∀ (i : ι) (d : Turing.Cfg k Γ S₀ x),
                                            d.state = some entry₀ →
                                              C₀.pre i d →
                                                (C₀.post i d).state = some e₁ →
                                                  C₁.pre (l₁ i) (Turing.Cfg.mapState (fun x => entry₁) (C₀.post i d))) →
                                          (∀ (i : ι) (d : Turing.Cfg k Γ S₀ x),
                                              d.state = some entry₀ →
                                                C₀.pre i d →
                                                  (C₀.post i d).state = some e₂ →
                                                    C₂.pre (l₂ i)
                                                      (Turing.Cfg.mapState (fun x => entry₂) (C₀.post i d))) →
                                            Turing.Contract (Turing.seamCompTM₂ M₀ e₁ e₂ M₁ entry₁ M₂ entry₂)
                                              (Sum.inl (Sum.inl entry₀))
                                              (Option.map (Sum.inl ∘ Sum.inr) '' X₁ ∪ Option.map Sum.inr '' X₂) ι x
@Turing.Contract.trans : {k : ℕ} →
  {Γ S : Type} →
    {M : Turing.MultiTapeTM k Γ S} →
      {e₁ e₂ : S} →
        {X : Set (Option S)} →
          {ι κ : Type} →
            {x : List Γ} →
              (C₁ : Turing.Contract M e₁ {some e₂} ι x) →
                (C₂ : Turing.Contract M e₂ X κ x) →
                  (link : ι → κ) →
                    (∀ (i : ι) (d : Turing.Cfg k Γ S x),
                        d.state = some e₁ → C₁.pre i d → C₂.pre (link i) (C₁.post i d)) →
                      (∀ (i : ι) (d : Turing.Cfg k Γ S x),
                          d.state = some e₁ →
                            C₁.pre i d → ∀ u < C₁.time i d, (Turing.MultiTapeTM.runFrom d u).state ∉ X) →
                        Turing.Contract M e₁ X ι x
@Turing.Contract.Traj : {k : ℕ} →
  {Γ S : Type} →
    {M : Turing.MultiTapeTM k Γ S} →
      {entry : S} →
        {exits : Set (Option S)} →
          {ι : Type} →
            {x : List Γ} → Turing.Contract M entry exits ι x → (ι → Turing.Cfg k Γ S x → (Fin k → ℤ) → Prop) → Prop
@Turing.Contract.Frames : {k : ℕ} →
  {Γ S : Type} →
    {M : Turing.MultiTapeTM k Γ S} →
      {entry : S} →
        {exits : Set (Option S)} →
          {ι : Type} →
            {x : List Γ} → Turing.Contract M entry exits ι x → (ι → Turing.Cfg k Γ S x → Fin k → Set ℤ) → Prop
@Turing.Contract.Traj.seq : ∀ {k : ℕ} {Γ S₁ S₂ : Type} [inst : DecidableEq S₁] {M₁ : Turing.MultiTapeTM k Γ S₁}
  {M₂ : Turing.MultiTapeTM k Γ S₂} {entry₁ exit₁ : S₁} {entry₂ : S₂} {X₂ : Set (Option S₂)} {ι κ : Type} {x : List Γ}
  {C₁ : Turing.Contract M₁ entry₁ {some exit₁} ι x} {C₂ : Turing.Contract M₂ entry₂ X₂ κ x} {link : ι → κ}
  {hlink :
    ∀ (i : ι) (d : Turing.Cfg k Γ S₁ x),
      d.state = some entry₁ → C₁.pre i d → C₂.pre (link i) (Turing.Cfg.mapState (fun x => entry₂) (C₁.post i d))}
  {R₁ : ι → Turing.Cfg k Γ S₁ x → (Fin k → ℤ) → Prop} {R₂ : κ → Turing.Cfg k Γ S₂ x → (Fin k → ℤ) → Prop},
  C₁.Traj R₁ →
    C₂.Traj R₂ →
      (C₁.seq C₂ link hlink).Traj fun i d p =>
        R₁ i (Turing.Cfg.mapState (fun x => entry₁) d) p ∨
          R₂ (link i) (Turing.Cfg.mapState (fun x => entry₂) (C₁.post i (Turing.Cfg.mapState (fun x => entry₁) d))) p
@Turing.Contract.Frames.seq : ∀ {k : ℕ} {Γ S₁ S₂ : Type} [inst : DecidableEq S₁] {M₁ : Turing.MultiTapeTM k Γ S₁}
  {M₂ : Turing.MultiTapeTM k Γ S₂} {entry₁ exit₁ : S₁} {entry₂ : S₂} {X₂ : Set (Option S₂)} {ι κ : Type} {x : List Γ}
  {C₁ : Turing.Contract M₁ entry₁ {some exit₁} ι x} {C₂ : Turing.Contract M₂ entry₂ X₂ κ x} {link : ι → κ}
  {hlink :
    ∀ (i : ι) (d : Turing.Cfg k Γ S₁ x),
      d.state = some entry₁ → C₁.pre i d → C₂.pre (link i) (Turing.Cfg.mapState (fun x => entry₂) (C₁.post i d))}
  {fp₁ : ι → Turing.Cfg k Γ S₁ x → Fin k → Set ℤ} {fp₂ : κ → Turing.Cfg k Γ S₂ x → Fin k → Set ℤ},
  C₁.Frames fp₁ →
    C₂.Frames fp₂ →
      (C₁.seq C₂ link hlink).Frames fun i d j =>
        fp₁ i (Turing.Cfg.mapState (fun x => entry₁) d) j ∪
          fp₂ (link i) (Turing.Cfg.mapState (fun x => entry₂) (C₁.post i (Turing.Cfg.mapState (fun x => entry₁) d))) j
@Turing.Round : {k : ℕ} →
  {Γ S : Type} →
    {x : List Γ} →
      Turing.MultiTapeTM k Γ S →
        S → Set (Option S) → ((Fin k → ℤ) → Prop) → Turing.Cfg k Γ S x → Turing.Cfg k Γ S x → ℕ → Prop
@Turing.Round.iterate : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} {M : Turing.MultiTapeTM k Γ S} {a : S} {E : Set (Option S)}
  {P : (Fin k → ℤ) → Prop} (τ : Turing.Cfg k Γ S x → ℕ) (c : Turing.Cfg k Γ S x),
  some a ∉ E →
    P c.workTapePos →
      ∀ (n : ℕ),
        (∀ r < n,
            Turing.Round M a E P (Turing.roundOrbit M τ c r) (Turing.roundOrbit M τ c (r + 1))
              (τ (Turing.roundOrbit M τ c r))) →
          Turing.Segment M E P c (Turing.roundOrbit M τ c n) (∑ r ∈ Finset.range n, τ (Turing.roundOrbit M τ c r))
@Turing.roundOrbit : {k : ℕ} →
  {Γ S : Type} →
    {x : List Γ} → Turing.MultiTapeTM k Γ S → (Turing.Cfg k Γ S x → ℕ) → Turing.Cfg k Γ S x → ℕ → Turing.Cfg k Γ S x
@Turing.RoundContract : {k : ℕ} → {Γ S : Type} → Turing.MultiTapeTM k Γ S → S → Set (Option S) → Type → List Γ → Type
@Turing.RoundContract.release : {k : ℕ} →
  {Γ S : Type} →
    {M : Turing.MultiTapeTM k Γ S} →
      {anchor : S} →
        {escape : Set (Option S)} →
          {ι : Type} →
            {x : List Γ} →
              Turing.RoundContract M anchor escape ι x →
                Turing.Contract (Turing.seamReleaseTM M anchor) (Sum.inl ())
                  (Option.map Sum.inr '' insert (some anchor) escape) ι x
@Turing.ReturnContract.release : {k : ℕ} →
  {Γ S : Type} →
    {M : Turing.MultiTapeTM k Γ S} →
      {anchor : S} →
        {ι : Type} →
          {x : List Γ} →
            Turing.ReturnContract M anchor ι x →
              Turing.Contract (Turing.seamReleaseTM M anchor) (Sum.inl ()) {some (Sum.inr anchor)} ι x
@Turing.tapeAction : {k : ℕ} →
  {Symbol : Type u_1} →
    {State : Type u_2} → Fin k → SignType → Option (Option Symbol) → SignType → State → Turing.Action k Symbol State
@Turing.inputMoveAction : {k : ℕ} →
  {Symbol : Type u_1} → {State : Type u_2} → SignType → State → Turing.Action k Symbol State
@Turing.step_of_tapeAction_move : ∀ {Symbol : Type u_1} {State : Type u_2} {k : ℕ} {x : List Symbol}
  (M : Turing.MultiTapeTM k Symbol State) (c : Turing.Cfg k Symbol State x) {q q' : State} (i : Fin k)
  (inp m : SignType),
  c.state = some q →
    M.tr q c.inputSymbol c.workTapeSymbols = Turing.tapeAction i inp none m q' →
      Turing.MultiTapeTM.step c =
        { state := some q', inputPos := Turing.moveInputPos c.inputPos inp, workTapes := c.workTapes,
          workTapePos := Function.update c.workTapePos i (c.workTapePos i + ↑m), output := c.output }
@Turing.step_of_inputMoveAction : ∀ {Symbol : Type u_1} {State : Type u_2} {k : ℕ} {x : List Symbol}
  (M : Turing.MultiTapeTM k Symbol State) (c : Turing.Cfg k Symbol State x) {q q' : State} (inp : SignType),
  c.state = some q →
    M.tr q c.inputSymbol c.workTapeSymbols = Turing.inputMoveAction inp q' →
      Turing.MultiTapeTM.step c =
        { state := some q', inputPos := Turing.moveInputPos c.inputPos inp, workTapes := c.workTapes,
          workTapePos := c.workTapePos, output := c.output }
@Turing.Action.apply : {k : ℕ} →
  {State : Type u_1} →
    {Symbol : Type u_2} →
      {input : List Symbol} →
        Turing.Action k Symbol State → Turing.Cfg k Symbol State input → Turing.Cfg k Symbol State input
@Turing.Cfg.bindState : {k : ℕ} →
  {Γ S S' : Type} → {x : List Γ} → Turing.Cfg k Γ S x → (S → Option S') → Turing.Cfg k Γ S' x
@Turing.Cfg.bindState_state : ∀ {k : ℕ} {Γ S S' : Type} {x : List Γ} (d : Turing.Cfg k Γ S x) (f : S → Option S'),
  (d.bindState f).state = d.state.bind f
@Turing.Cfg.mapState : {k : ℕ} →
  {Symbol : Type u_1} →
    {State : Type u_2} →
      {State' : Type u_3} →
        {input : List Symbol} → (State → State') → Turing.Cfg k Symbol State input → Turing.Cfg k Symbol State' input
@Turing.Cfg.sameOutside_iff : ∀ {k : ℕ} {Γ S S' : Type} {x : List Γ} (fp : Fin k → Set ℤ) (d : Turing.Cfg k Γ S x)
  (d' : Turing.Cfg k Γ S' x),
  Turing.Cfg.SameOutside fp d d' ↔ ∀ (j : Fin k), ∀ q ∉ fp j, d'.workTapes j q = d.workTapes j q
@Turing.Contract.ofSegment : {k : ℕ} →
  {Γ S : Type} →
    {M : Turing.MultiTapeTM k Γ S} →
      {entry : S} →
        {exits : Set (Option S)} →
          {ι : Type} →
            {x : List Γ} →
              (pre : ι → Turing.Cfg k Γ S x → Prop) →
                (time : ι → Turing.Cfg k Γ S x → ℕ) →
                  (post : ι → Turing.Cfg k Γ S x → Turing.Cfg k Γ S x) →
                    (lo hi : ι → Turing.Cfg k Γ S x → Fin k → ℤ) →
                      (∀ (i : ι) (d : Turing.Cfg k Γ S x),
                          d.state = some entry →
                            pre i d →
                              Turing.Segment M exits (Turing.HeadBox (lo i d) (hi i d)) d (post i d) (time i d)) →
                        (∀ (i : ι) (d : Turing.Cfg k Γ S x),
                            d.state = some entry → pre i d → (post i d).state ∈ exits) →
                          Turing.Contract M entry exits ι x
@Turing.Contract.segment : ∀ {k : ℕ} {Γ S : Type} {M : Turing.MultiTapeTM k Γ S} {entry : S} {exits : Set (Option S)}
  {ι : Type} {x : List Γ} (C : Turing.Contract M entry exits ι x) (i : ι) (d : Turing.Cfg k Γ S x),
  d.state = some entry →
    C.pre i d → Turing.Segment M exits (Turing.HeadBox (C.lo i d) (C.hi i d)) d (C.post i d) (C.time i d)
@Turing.Contract.traj_iff : ∀ {k : ℕ} {Γ S : Type} {M : Turing.MultiTapeTM k Γ S} {entry : S} {exits : Set (Option S)}
  {ι : Type} {x : List Γ} (C : Turing.Contract M entry exits ι x) (R : ι → Turing.Cfg k Γ S x → (Fin k → ℤ) → Prop),
  C.Traj R ↔
    ∀ (i : ι) (d : Turing.Cfg k Γ S x),
      d.state = some entry → C.pre i d → ∀ u ≤ C.time i d, R i d (Turing.MultiTapeTM.runFrom d u).workTapePos
@Turing.HeadBox : {k : ℕ} → (Fin k → ℤ) → (Fin k → ℤ) → (Fin k → ℤ) → Prop
@Turing.MultiTapeTM.step : {k : ℕ} →
  {State : Type u_1} →
    {Symbol : Type u_2} →
      {input : List Symbol} →
        {tm : Turing.MultiTapeTM k Symbol State} → Turing.Cfg k Symbol State input → Turing.Cfg k Symbol State input
@Turing.Round.of_cut : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} {M : Turing.MultiTapeTM k Γ S} {a e : S}
  {c : Turing.Cfg k Γ S x} {t : ℕ},
  c.state = some a →
    0 < t →
      (∀ (u : ℕ), 0 < u → u < t → ∃ s, (Turing.MultiTapeTM.runFrom c u).state = some s ∧ s ≠ a ∧ s ≠ e) →
        (Turing.MultiTapeTM.runFrom c t).state = some a ∨ (Turing.MultiTapeTM.runFrom c t).state = some e →
          Turing.Round M a {some e} (fun x => True) c (Turing.MultiTapeTM.runFrom c t) t
@Turing.Segment : {k : ℕ} →
  {Γ S : Type} →
    {x : List Γ} →
      Turing.MultiTapeTM k Γ S →
        Set (Option S) → ((Fin k → ℤ) → Prop) → Turing.Cfg k Γ S x → Turing.Cfg k Γ S x → ℕ → Prop
@Turing.Segment.mono : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} {M : Turing.MultiTapeTM k Γ S} {F : Set (Option S)}
  {P : (Fin k → ℤ) → Prop} {F' : Set (Option S)} {P' : (Fin k → ℤ) → Prop} {a b : Turing.Cfg k Γ S x} {t : ℕ},
  Turing.Segment M F P a b t → F' ⊆ F → (∀ (p : Fin k → ℤ), P p → P' p) → Turing.Segment M F' P' a b t
@Turing.Segment.trans : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} {M : Turing.MultiTapeTM k Γ S} {F : Set (Option S)}
  {P : (Fin k → ℤ) → Prop} {a b c : Turing.Cfg k Γ S x} {t v : ℕ},
  Turing.Segment M F P a b t → Turing.Segment M F P b c v → Turing.Segment M F P a c (t + v)
@Turing.ZoneContents.swap : {ℓ : ℕ} → Turing.ZoneContents ℓ → Turing.ZoneContents ℓ
@Turing.ZoneContents.swap_left : ∀ {ℓ : ℕ} (z : Turing.ZoneContents ℓ) (a : Fin ℓ), z.swap.left a = z.right a
@Turing.fieldOffset_zero : ∀ {Γ : Type u_1} (fs : List (List Γ)), Turing.fieldOffset fs 0 = 0
@Turing.headBox_iff : ∀ {k : ℕ} (lo hi p : Fin k → ℤ),
  Turing.HeadBox lo hi p ↔ ∀ (j : Fin k), p j ∈ Finset.Icc (lo j) (hi j)
@Turing.roundOrbit_succ : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} (M : Turing.MultiTapeTM k Γ S)
  (τ : Turing.Cfg k Γ S x → ℕ) (c : Turing.Cfg k Γ S x) (r : ℕ),
  Turing.roundOrbit M τ c (r + 1) =
    Turing.MultiTapeTM.runFrom (Turing.roundOrbit M τ c r) (τ (Turing.roundOrbit M τ c r))
@Turing.roundOrbit_zero : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} (M : Turing.MultiTapeTM k Γ S)
  (τ : Turing.Cfg k Γ S x → ℕ) (c : Turing.Cfg k Γ S x), Turing.roundOrbit M τ c 0 = c
@Turing.round_iff : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} (M : Turing.MultiTapeTM k Γ S) (a : S) (E : Set (Option S))
  (P : (Fin k → ℤ) → Prop) (c c' : Turing.Cfg k Γ S x) (t : ℕ),
  Turing.Round M a E P c c' t ↔
    c.state = some a ∧
      0 < t ∧
        Turing.MultiTapeTM.runFrom c t = c' ∧
          c'.state ∈ insert (some a) E ∧
            (∀ (u : ℕ), 0 < u → u < t → (Turing.MultiTapeTM.runFrom c u).state ∉ Turing.roundStop a E) ∧
              ∀ u ≤ t, P (Turing.MultiTapeTM.runFrom c u).workTapePos
@Turing.scanResult_map : ∀ {A : Type u_1} {Γ : Type u_2} (f : Γ → Γ) (a₀ : A) (w : List Γ),
  Turing.scanResult (Turing.scanMap f) Turing.scanKeep a₀ w = (a₀, List.map f w)
@Turing.scanResult_shiftLeft : ∀ {B : Type u_1} {Γ : Type u_2} (get : Γ → B) (set : Γ → B → Γ) (b₀ : B) (w : List Γ),
  Turing.scanResult Turing.scanKeep (Turing.scanShift get set) b₀ w =
    ((List.map get w).head?.getD b₀, List.zipWith set w (List.map get w.tail ++ [b₀]))
@Turing.scanResult_shiftRight : ∀ {B : Type u_1} {Γ : Type u_2} (get : Γ → B) (set : Γ → B → Γ) (b₀ : B) (w : List Γ),
  Turing.scanResult (Turing.scanShift get set) Turing.scanKeep b₀ w =
    ((List.map get w).getLast?.getD b₀, List.zipWith set w (b₀ :: List.map get w))
@Turing.seekEndTM : {Symbol : Type u_1} → (k : ℕ) → Fin k → Turing.MultiTapeTM k Symbol Turing.SeekPhase
@Turing.seekStartTM : {Symbol : Type u_1} → (k : ℕ) → Fin k → Turing.MultiTapeTM k Symbol Turing.SeekPhase
@Turing.segment_iff : ∀ {k : ℕ} {Γ S : Type} {x : List Γ} (M : Turing.MultiTapeTM k Γ S) (F : Set (Option S))
  (P : (Fin k → ℤ) → Prop) (a b : Turing.Cfg k Γ S x) (t : ℕ),
  Turing.Segment M F P a b t ↔
    Turing.MultiTapeTM.runFrom a t = b ∧
      (∀ u < t, (Turing.MultiTapeTM.runFrom a u).state ∉ F) ∧ ∀ u ≤ t, P (Turing.MultiTapeTM.runFrom a u).workTapePos
@Turing.skipBackTM : {Symbol : Type u_1} → (k : ℕ) → Fin k → Turing.MultiTapeTM k Symbol Turing.SeekPhase
@Turing.skipTM : {Symbol : Type u_1} → (k : ℕ) → Fin k → Turing.MultiTapeTM k Symbol Turing.SeekPhase
Turing.zoneCapacity_eq : ∀ (i : ℕ), Turing.zoneCapacity i = 2 * 2 ^ i
@Turing.zoneCascadeRight_eq : ∀ {ℓ : ℕ} (j : ℕ) (z : Turing.ZoneContents ℓ),
  Turing.zoneCascadeRight j z =
    List.foldl (fun z i => Turing.zoneStepPair (i + 1) z)
      (Turing.zoneMove true (List.foldl (fun z i => Turing.zoneStepPair (i + 1) z) z (List.range j).reverse))
      (List.range j)
@Turing.zoneCellAt_eq : ∀ {k ℓ : ℕ} (side : Bool) (z : Fin k → Turing.ZoneContents ℓ) (n : ℕ),
  Turing.zoneCellAt side z n =
    Option.map (fun i => Sum.inr fun t => (Turing.ZoneContents.words side (z t) i)[n - Turing.zoneStart ↑i]?)
      (Turing.zoneOwner ℓ n)
@Turing.zoneCells_eq : ∀ {k ℓ : ℕ} (side : Bool) (z : Fin k → Turing.ZoneContents ℓ) (i : Fin ℓ),
  Turing.zoneCells side z i =
    List.map (fun p => Sum.inr fun t => (Turing.ZoneContents.words side (z t) i)[p]?)
      (List.range (Turing.zoneCapacity ↑i))
@Turing.zoneMove_true : ∀ {ℓ : ℕ} (z : Turing.ZoneContents ℓ),
  Turing.zoneMove true z =
    if hℓ : 0 < ℓ then
      if h : (z.left ⟨0, hℓ⟩).length + 1 ≤ Turing.zoneCapacity 0 then Turing.zoneMoveRight hℓ z h else z
    else z
@Turing.zoneShiftIn : {ℓ : ℕ} → Bool → ℕ → Turing.ZoneContents ℓ → Turing.ZoneContents ℓ
@Turing.zoneShiftInW_eq : ∀ {ℓ : ℕ} (i : ℕ) (w : Fin ℓ → List (Option Bool)) (j : Fin ℓ),
  Turing.zoneShiftInW i w j =
    if hi : 1 ≤ i ∧ i < ℓ then
      if w ⟨i - 1, ⋯⟩ = [] then
        if ↑j = i - 1 then List.take (2 ^ (i - 1)) (w ⟨i, ⋯⟩)
        else if ↑j = i then List.drop (2 ^ (i - 1)) (w ⟨i, ⋯⟩) else w j
      else w j
    else w j
@Turing.zoneShiftOut : {ℓ : ℕ} → Bool → ℕ → Turing.ZoneContents ℓ → Turing.ZoneContents ℓ
@Turing.zoneShiftOutW_eq : ∀ {ℓ : ℕ} (i : ℕ) (w : Fin ℓ → List (Option Bool)) (j : Fin ℓ),
  Turing.zoneShiftOutW i w j =
    if hi : 1 ≤ i ∧ i < ℓ then
      if
          (w ⟨i - 1, ⋯⟩).length = Turing.zoneCapacity (i - 1) ∧
            (w ⟨i, ⋯⟩).length + 2 ^ (i - 1) ≤ Turing.zoneCapacity i then
        if ↑j = i - 1 then List.take (2 ^ (i - 1)) (w ⟨i - 1, ⋯⟩)
        else if ↑j = i then List.drop (2 ^ (i - 1)) (w ⟨i - 1, ⋯⟩) ++ w ⟨i, ⋯⟩ else w j
      else w j
    else w j
@Turing.zoneSide_cascadeRight : ∀ {ℓ : ℕ} (j : ℕ) (hj : j < ℓ) (z : Turing.ZoneContents ℓ),
  (∀ (k : ℕ) (hk : k < j), z.right ⟨k, ⋯⟩ = []) →
    (∀ (k : ℕ) (hk : k < j), (z.left ⟨k, ⋯⟩).length = Turing.zoneCapacity k) →
      z.right ⟨j, hj⟩ ≠ [] →
        (z.left ⟨j, hj⟩).length + 2 ^ (j - 1) ≤ Turing.zoneCapacity j →
          Turing.zoneSide (Turing.zoneCascadeRight j z).left = z.home :: Turing.zoneSide z.left ∧
            Turing.zoneSide (Turing.zoneCascadeRight j z).right = (Turing.zoneSide z.right).tail
@Turing.zoneSlotOf_inr : ∀ {k : ℕ} (t : Fin k) (c : Turing.ZoneCell k), Turing.zoneSlotOf t (Sum.inr c) = c t
@Turing.zoneSlotOf_slotSet_self : ∀ {k : ℕ} (t : Fin k) (cell : Option (Turing.ZoneSym k)) (s : Option (Option Bool)),
  Turing.zoneSlotOf t (Turing.zoneSlotSet t cell s) = s
@Turing.zoneStepPair_eq : ∀ {ℓ : ℕ} (i : ℕ) (z : Turing.ZoneContents ℓ),
  Turing.zoneStepPair i z = Turing.zoneShiftOut false i (Turing.zoneShiftIn true i z)
@Turing.zonedTape_of_pos : ∀ {k ℓ : ℕ} (z : Fin k → Turing.ZoneContents ℓ) {c : ℤ},
  0 < c → Turing.zonedTape z c = Turing.zoneCellAt true z c.toNat
@Turing.Contract.branch_hi : ∀ {k : ℕ} {Γ S₀ S₁ S₂ : Type} [inst : DecidableEq S₀] [inst_1 : DecidableEq S₁]
  {M₀ : Turing.MultiTapeTM k Γ S₀} {M₁ : Turing.MultiTapeTM k Γ S₁} {M₂ : Turing.MultiTapeTM k Γ S₂} {entry₀ e₁ e₂ : S₀}
  {entry₁ : S₁} {entry₂ : S₂} {X₁ : Set (Option S₁)} {X₂ : Set (Option S₂)} {ι κ₁ κ₂ : Type} {x : List Γ} (he : e₁ ≠ e₂)
  (C₀ : Turing.Contract M₀ entry₀ {some e₁, some e₂} ι x) (C₁ : Turing.Contract M₁ entry₁ X₁ κ₁ x)
  (C₂ : Turing.Contract M₂ entry₂ X₂ κ₂ x) (l₁ : ι → κ₁) (l₂ : ι → κ₂)
  (h₁ :
    ∀ (i : ι) (d : Turing.Cfg k Γ S₀ x),
      d.state = some entry₀ →
        C₀.pre i d →
          (C₀.post i d).state = some e₁ → C₁.pre (l₁ i) (Turing.Cfg.mapState (fun x => entry₁) (C₀.post i d)))
  (h₂ :
    ∀ (i : ι) (d : Turing.Cfg k Γ S₀ x),
      d.state = some entry₀ →
        C₀.pre i d →
          (C₀.post i d).state = some e₂ → C₂.pre (l₂ i) (Turing.Cfg.mapState (fun x => entry₂) (C₀.post i d)))
  (i : ι) (d : Turing.Cfg k Γ ((S₀ ⊕ S₁) ⊕ S₂) x) (j : Fin k),
  (Turing.Contract.branch he C₀ C₁ C₂ l₁ l₂ h₁ h₂).hi i d j =
    max (C₀.hi i (Turing.Cfg.mapState (fun x => entry₀) d) j)
      (if (C₀.post i (Turing.Cfg.mapState (fun x => entry₀) d)).state = some e₁ then
        C₁.hi (l₁ i) (Turing.Cfg.mapState (fun x => entry₁) (C₀.post i (Turing.Cfg.mapState (fun x => entry₀) d))) j
      else C₂.hi (l₂ i) (Turing.Cfg.mapState (fun x => entry₂) (C₀.post i (Turing.Cfg.mapState (fun x => entry₀) d))) j)
@Turing.Contract.branch_lo : ∀ {k : ℕ} {Γ S₀ S₁ S₂ : Type} [inst : DecidableEq S₀] [inst_1 : DecidableEq S₁]
  {M₀ : Turing.MultiTapeTM k Γ S₀} {M₁ : Turing.MultiTapeTM k Γ S₁} {M₂ : Turing.MultiTapeTM k Γ S₂} {entry₀ e₁ e₂ : S₀}
  {entry₁ : S₁} {entry₂ : S₂} {X₁ : Set (Option S₁)} {X₂ : Set (Option S₂)} {ι κ₁ κ₂ : Type} {x : List Γ} (he : e₁ ≠ e₂)
  (C₀ : Turing.Contract M₀ entry₀ {some e₁, some e₂} ι x) (C₁ : Turing.Contract M₁ entry₁ X₁ κ₁ x)
  (C₂ : Turing.Contract M₂ entry₂ X₂ κ₂ x) (l₁ : ι → κ₁) (l₂ : ι → κ₂)
  (h₁ :
    ∀ (i : ι) (d : Turing.Cfg k Γ S₀ x),
      d.state = some entry₀ →
        C₀.pre i d →
          (C₀.post i d).state = some e₁ → C₁.pre (l₁ i) (Turing.Cfg.mapState (fun x => entry₁) (C₀.post i d)))
  (h₂ :
    ∀ (i : ι) (d : Turing.Cfg k Γ S₀ x),
      d.state = some entry₀ →
        C₀.pre i d →
          (C₀.post i d).state = some e₂ → C₂.pre (l₂ i) (Turing.Cfg.mapState (fun x => entry₂) (C₀.post i d)))
  (i : ι) (d : Turing.Cfg k Γ ((S₀ ⊕ S₁) ⊕ S₂) x) (j : Fin k),
  (Turing.Contract.branch he C₀ C₁ C₂ l₁ l₂ h₁ h₂).lo i d j =
    min (C₀.lo i (Turing.Cfg.mapState (fun x => entry₀) d) j)
      (if (C₀.post i (Turing.Cfg.mapState (fun x => entry₀) d)).state = some e₁ then
        C₁.lo (l₁ i) (Turing.Cfg.mapState (fun x => entry₁) (C₀.post i (Turing.Cfg.mapState (fun x => entry₀) d))) j
      else C₂.lo (l₂ i) (Turing.Cfg.mapState (fun x => entry₂) (C₀.post i (Turing.Cfg.mapState (fun x => entry₀) d))) j)
@Turing.Contract.branch_positive : ∀ {k : ℕ} {Γ S₀ S₁ S₂ : Type} [inst : DecidableEq S₀] [inst_1 : DecidableEq S₁]
  {M₀ : Turing.MultiTapeTM k Γ S₀} {M₁ : Turing.MultiTapeTM k Γ S₁} {M₂ : Turing.MultiTapeTM k Γ S₂} {entry₀ e₁ e₂ : S₀}
  {entry₁ : S₁} {entry₂ : S₂} {X₁ : Set (Option S₁)} {X₂ : Set (Option S₂)} {ι κ₁ κ₂ : Type} {x : List Γ} (he : e₁ ≠ e₂)
  (C₀ : Turing.Contract M₀ entry₀ {some e₁, some e₂} ι x) (C₁ : Turing.Contract M₁ entry₁ X₁ κ₁ x)
  (C₂ : Turing.Contract M₂ entry₂ X₂ κ₂ x) (l₁ : ι → κ₁) (l₂ : ι → κ₂)
  (h₁ :
    ∀ (i : ι) (d : Turing.Cfg k Γ S₀ x),
      d.state = some entry₀ →
        C₀.pre i d →
          (C₀.post i d).state = some e₁ → C₁.pre (l₁ i) (Turing.Cfg.mapState (fun x => entry₁) (C₀.post i d)))
  (h₂ :
    ∀ (i : ι) (d : Turing.Cfg k Γ S₀ x),
      d.state = some entry₀ →
        C₀.pre i d →
          (C₀.post i d).state = some e₂ → C₂.pre (l₂ i) (Turing.Cfg.mapState (fun x => entry₂) (C₀.post i d))),
  (Turing.Contract.branch he C₀ C₁ C₂ l₁ l₂ h₁ h₂).Positive
@Turing.Contract.branch_post : ∀ {k : ℕ} {Γ S₀ S₁ S₂ : Type} [inst : DecidableEq S₀] [inst_1 : DecidableEq S₁]
  {M₀ : Turing.MultiTapeTM k Γ S₀} {M₁ : Turing.MultiTapeTM k Γ S₁} {M₂ : Turing.MultiTapeTM k Γ S₂} {entry₀ e₁ e₂ : S₀}
  {entry₁ : S₁} {entry₂ : S₂} {X₁ : Set (Option S₁)} {X₂ : Set (Option S₂)} {ι κ₁ κ₂ : Type} {x : List Γ} (he : e₁ ≠ e₂)
  (C₀ : Turing.Contract M₀ entry₀ {some e₁, some e₂} ι x) (C₁ : Turing.Contract M₁ entry₁ X₁ κ₁ x)
  (C₂ : Turing.Contract M₂ entry₂ X₂ κ₂ x) (l₁ : ι → κ₁) (l₂ : ι → κ₂)
  (h₁ :
    ∀ (i : ι) (d : Turing.Cfg k Γ S₀ x),
      d.state = some entry₀ →
        C₀.pre i d →
          (C₀.post i d).state = some e₁ → C₁.pre (l₁ i) (Turing.Cfg.mapState (fun x => entry₁) (C₀.post i d)))
  (h₂ :
    ∀ (i : ι) (d : Turing.Cfg k Γ S₀ x),
      d.state = some entry₀ →
        C₀.pre i d →
          (C₀.post i d).state = some e₂ → C₂.pre (l₂ i) (Turing.Cfg.mapState (fun x => entry₂) (C₀.post i d)))
  (i : ι) (d : Turing.Cfg k Γ ((S₀ ⊕ S₁) ⊕ S₂) x),
  (Turing.Contract.branch he C₀ C₁ C₂ l₁ l₂ h₁ h₂).post i d =
    if (C₀.post i (Turing.Cfg.mapState (fun x => entry₀) d)).state = some e₁ then
      Turing.Cfg.mapState Sum.inl
        (Turing.Cfg.mapState Sum.inr
          (C₁.post (l₁ i)
            (Turing.Cfg.mapState (fun x => entry₁) (C₀.post i (Turing.Cfg.mapState (fun x => entry₀) d)))))
    else
      Turing.Cfg.mapState Sum.inr
        (C₂.post (l₂ i) (Turing.Cfg.mapState (fun x => entry₂) (C₀.post i (Turing.Cfg.mapState (fun x => entry₀) d))))
@Turing.Contract.branch_pre : ∀ {k : ℕ} {Γ S₀ S₁ S₂ : Type} [inst : DecidableEq S₀] [inst_1 : DecidableEq S₁]
  {M₀ : Turing.MultiTapeTM k Γ S₀} {M₁ : Turing.MultiTapeTM k Γ S₁} {M₂ : Turing.MultiTapeTM k Γ S₂} {entry₀ e₁ e₂ : S₀}
  {entry₁ : S₁} {entry₂ : S₂} {X₁ : Set (Option S₁)} {X₂ : Set (Option S₂)} {ι κ₁ κ₂ : Type} {x : List Γ} (he : e₁ ≠ e₂)
  (C₀ : Turing.Contract M₀ entry₀ {some e₁, some e₂} ι x) (C₁ : Turing.Contract M₁ entry₁ X₁ κ₁ x)
  (C₂ : Turing.Contract M₂ entry₂ X₂ κ₂ x) (l₁ : ι → κ₁) (l₂ : ι → κ₂)
  (h₁ :
    ∀ (i : ι) (d : Turing.Cfg k Γ S₀ x),
      d.state = some entry₀ →
        C₀.pre i d →
          (C₀.post i d).state = some e₁ → C₁.pre (l₁ i) (Turing.Cfg.mapState (fun x => entry₁) (C₀.post i d)))
  (h₂ :
    ∀ (i : ι) (d : Turing.Cfg k Γ S₀ x),
      d.state = some entry₀ →
        C₀.pre i d →
          (C₀.post i d).state = some e₂ → C₂.pre (l₂ i) (Turing.Cfg.mapState (fun x => entry₂) (C₀.post i d)))
  (i : ι) (d : Turing.Cfg k Γ ((S₀ ⊕ S₁) ⊕ S₂) x),
  (Turing.Contract.branch he C₀ C₁ C₂ l₁ l₂ h₁ h₂).pre i d = C₀.pre i (Turing.Cfg.mapState (fun x => entry₀) d)
@Turing.Contract.branch_time : ∀ {k : ℕ} {Γ S₀ S₁ S₂ : Type} [inst : DecidableEq S₀] [inst_1 : DecidableEq S₁]
  {M₀ : Turing.MultiTapeTM k Γ S₀} {M₁ : Turing.MultiTapeTM k Γ S₁} {M₂ : Turing.MultiTapeTM k Γ S₂} {entry₀ e₁ e₂ : S₀}
  {entry₁ : S₁} {entry₂ : S₂} {X₁ : Set (Option S₁)} {X₂ : Set (Option S₂)} {ι κ₁ κ₂ : Type} {x : List Γ} (he : e₁ ≠ e₂)
  (C₀ : Turing.Contract M₀ entry₀ {some e₁, some e₂} ι x) (C₁ : Turing.Contract M₁ entry₁ X₁ κ₁ x)
  (C₂ : Turing.Contract M₂ entry₂ X₂ κ₂ x) (l₁ : ι → κ₁) (l₂ : ι → κ₂)
  (h₁ :
    ∀ (i : ι) (d : Turing.Cfg k Γ S₀ x),
      d.state = some entry₀ →
        C₀.pre i d →
          (C₀.post i d).state = some e₁ → C₁.pre (l₁ i) (Turing.Cfg.mapState (fun x => entry₁) (C₀.post i d)))
  (h₂ :
    ∀ (i : ι) (d : Turing.Cfg k Γ S₀ x),
      d.state = some entry₀ →
        C₀.pre i d →
          (C₀.post i d).state = some e₂ → C₂.pre (l₂ i) (Turing.Cfg.mapState (fun x => entry₂) (C₀.post i d)))
  (i : ι) (d : Turing.Cfg k Γ ((S₀ ⊕ S₁) ⊕ S₂) x),
  (Turing.Contract.branch he C₀ C₁ C₂ l₁ l₂ h₁ h₂).time i d =
    C₀.time i (Turing.Cfg.mapState (fun x => entry₀) d) + 1 +
      if (C₀.post i (Turing.Cfg.mapState (fun x => entry₀) d)).state = some e₁ then
        C₁.time (l₁ i) (Turing.Cfg.mapState (fun x => entry₁) (C₀.post i (Turing.Cfg.mapState (fun x => entry₀) d)))
      else C₂.time (l₂ i) (Turing.Cfg.mapState (fun x => entry₂) (C₀.post i (Turing.Cfg.mapState (fun x => entry₀) d)))
@Turing.Contract.inPhase_hi : ∀ {k : ℕ} {Γ I : Type} {Ph : I → Type} (Mf : (i : I) → Turing.MultiTapeTM k Γ (Ph i))
  (q0 : (i : I) × Ph i) (red : (i : I) → Ph i → Option ((i : I) × Ph i)) (p : I) {s₀ : Ph p} {X : Set (Option (Ph p))}
  {ι : Type} {x : List Γ} (C : Turing.Contract (Mf p) s₀ X ι x) (hnone : none ∉ X)
  (hred : ∀ (s : Ph p), some s ∉ X → red p s = none)
  (hsome : ∀ (s : Ph p), some s ∈ X → ∃ q, red p s = some q ∧ q.fst ≠ p) (i : ι) (d : Turing.Cfg k Γ ((i : I) × Ph i) x)
  (a : Fin k),
  (Turing.Contract.inPhase Mf q0 red p C hnone hred hsome).hi i d a = C.hi i (Turing.Cfg.mapState (fun x => s₀) d) a
@Turing.Contract.inPhase_lo : ∀ {k : ℕ} {Γ I : Type} {Ph : I → Type} (Mf : (i : I) → Turing.MultiTapeTM k Γ (Ph i))
  (q0 : (i : I) × Ph i) (red : (i : I) → Ph i → Option ((i : I) × Ph i)) (p : I) {s₀ : Ph p} {X : Set (Option (Ph p))}
  {ι : Type} {x : List Γ} (C : Turing.Contract (Mf p) s₀ X ι x) (hnone : none ∉ X)
  (hred : ∀ (s : Ph p), some s ∉ X → red p s = none)
  (hsome : ∀ (s : Ph p), some s ∈ X → ∃ q, red p s = some q ∧ q.fst ≠ p) (i : ι) (d : Turing.Cfg k Γ ((i : I) × Ph i) x)
  (a : Fin k),
  (Turing.Contract.inPhase Mf q0 red p C hnone hred hsome).lo i d a = C.lo i (Turing.Cfg.mapState (fun x => s₀) d) a
@Turing.Contract.inPhase_positive : ∀ {k : ℕ} {Γ I : Type} {Ph : I → Type}
  (Mf : (i : I) → Turing.MultiTapeTM k Γ (Ph i)) (q0 : (i : I) × Ph i) (red : (i : I) → Ph i → Option ((i : I) × Ph i))
  (p : I) {s₀ : Ph p} {X : Set (Option (Ph p))} {ι : Type} {x : List Γ} (C : Turing.Contract (Mf p) s₀ X ι x)
  (hnone : none ∉ X) (hred : ∀ (s : Ph p), some s ∉ X → red p s = none)
  (hsome : ∀ (s : Ph p), some s ∈ X → ∃ q, red p s = some q ∧ q.fst ≠ p),
  (Turing.Contract.inPhase Mf q0 red p C hnone hred hsome).Positive
@Turing.Contract.inPhase_post : ∀ {k : ℕ} {Γ I : Type} {Ph : I → Type} (Mf : (i : I) → Turing.MultiTapeTM k Γ (Ph i))
  (q0 : (i : I) × Ph i) (red : (i : I) → Ph i → Option ((i : I) × Ph i)) (p : I) {s₀ : Ph p} {X : Set (Option (Ph p))}
  {ι : Type} {x : List Γ} (C : Turing.Contract (Mf p) s₀ X ι x) (hnone : none ∉ X)
  (hred : ∀ (s : Ph p), some s ∉ X → red p s = none)
  (hsome : ∀ (s : Ph p), some s ∈ X → ∃ q, red p s = some q ∧ q.fst ≠ p) (i : ι)
  (d : Turing.Cfg k Γ ((i : I) × Ph i) x),
  (Turing.Contract.inPhase Mf q0 red p C hnone hred hsome).post i d =
    (C.post i (Turing.Cfg.mapState (fun x => s₀) d)).bindState (red p)
@Turing.Contract.inPhase_pre : ∀ {k : ℕ} {Γ I : Type} {Ph : I → Type} (Mf : (i : I) → Turing.MultiTapeTM k Γ (Ph i))
  (q0 : (i : I) × Ph i) (red : (i : I) → Ph i → Option ((i : I) × Ph i)) (p : I) {s₀ : Ph p} {X : Set (Option (Ph p))}
  {ι : Type} {x : List Γ} (C : Turing.Contract (Mf p) s₀ X ι x) (hnone : none ∉ X)
  (hred : ∀ (s : Ph p), some s ∉ X → red p s = none)
  (hsome : ∀ (s : Ph p), some s ∈ X → ∃ q, red p s = some q ∧ q.fst ≠ p) (i : ι)
  (d : Turing.Cfg k Γ ((i : I) × Ph i) x),
