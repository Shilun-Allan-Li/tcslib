@zr_rightPass_bounds : ∀ {k : ℕ} {x : List (ZoneSym k)} (D : zr_RightData k)
  (d :
    Cfg 2 (ZoneSym k)
      (((SeekPhase ⊕ SeekPhase) ⊕ SweepPhase ⊕ SeekPhase) ⊕
        SweepPhase ⊕ ((Option Bool ⊕ SeekPhase) ⊕ SeekPhase) ⊕ SweepPhase)
      x),
  (zr_rightPassContract x).pre D d →
