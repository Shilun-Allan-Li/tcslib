+  rw [← hDt, (zr_hostDispatchContract MB e back x).run () c hc hD0, zr_hostDispatchContract,
+    Contract.inPhase_post, zr_anchorContract, Contract.ofSegment_post]
+  refine zr_bindState_eq _ _ _ ?_ (Cfg.mapState_inputPos _ _)
