-/-- **A pinned step**: from every start pinned at `(T₁ j, p₁ j)`, the contract's precondition
-holds, and its endpoint is pinned at `(T₂ j, p₂ j)`, with the input head and the output kept,
-after `τ j` steps, its heads within `[L j, U j]`. -/
+/-- **A pinned step**: from every start pinned at `(T₁ j, p₁ j)` at a valid index `j`, the
+contract's precondition holds, and its endpoint is pinned at `(T₂ j, p₂ j)`, with the input head
+and the output kept, after `τ j` steps, its heads within `[L j, U j]`. -/
 private def zr_PinStep {k : ℕ} {S J : Type} {x : List (ZoneSym k)}
     {M : MultiTapeTM 2 (ZoneSym k) S} {e : S} {X : Set (Option S)} (C : Contract M e X J x)
-    (T₁ T₂ : J → Fin 2 → ℤ → Option (ZoneSym k)) (p₁ p₂ : J → Fin 2 → ℤ) (τ : J → ℕ)
-    (L U : J → Fin 2 → ℤ) : Prop :=
-  ∀ j (d : Cfg 2 (ZoneSym k) S x), zr_pinned (T₁ j) (p₁ j) d →
+    (V : J → Prop) (T₁ T₂ : J → Fin 2 → ℤ → Option (ZoneSym k)) (p₁ p₂ : J → Fin 2 → ℤ)
+    (τ : J → ℕ) (L U : J → Fin 2 → ℤ) : Prop :=
+  ∀ j (d : Cfg 2 (ZoneSym k) S x), V j → zr_pinned (T₁ j) (p₁ j) d →
     C.pre j d ∧ zr_pinned (T₂ j) (p₂ j) (C.post j d) ∧
       (C.post j d).inputPos = d.inputPos ∧ (C.post j d).output = d.output ∧
       C.time j d = τ j ∧ ∀ i, L j i ≤ C.lo j d i ∧ C.hi j d i ≤ U j i
 
