+/-- The donor's new slots up to its last `2^(i-1)`: its column from offset `2^(i-1)` on. -/
+private abbrev zr_V {k : ℕ} (t : Fin k) (J : zr_Ix k) : List (ZoneSym k) :=
+  (zr_cD t J).drop (zr_hh J)
