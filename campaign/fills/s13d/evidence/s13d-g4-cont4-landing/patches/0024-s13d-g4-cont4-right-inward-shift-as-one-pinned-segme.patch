+    (J.D.2 t).right ⟨J.i - 1, by have := hV.2.1; omega⟩ = [] := by
+  have h := (zr_inner_empty_iff true J.D.2 ⟨J.i - 1, by have := hV.2.1; omega⟩ t).mp
+  rw [zr_zonePos, if_pos rfl, Nat.add_zero] at h
+  exact h hV.2.2.1
