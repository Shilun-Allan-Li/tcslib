+  (zr_cD t J).drop (zr_hh J + 1)
+
+/-- The scratch pieces the two cuts leave behind. -/
+private abbrev zr_J2 {k : ℕ} (t : Fin k) (J : zr_Ix k) : List (ZoneSym k) :=
+  (zr_cD t J).take (zr_hh J - 1)
