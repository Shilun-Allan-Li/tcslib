+/-- The descending right pass's home test verdict, one cell after field `P.i - 1`'s start. -/
+private abbrev zr_p1Home {k : ℕ} (P : zr_Px k) : Bool :=
+  Option.isNone (zr_aT (zr_p1G P) 0 (zr_rA (zr_p1G P) 0 + ((1 : SignType) : ℤ)))
