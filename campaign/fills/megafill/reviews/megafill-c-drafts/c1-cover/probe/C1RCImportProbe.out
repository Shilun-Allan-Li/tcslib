Turing.exists_replayCanonizer : ∀ (c : Turing.EffectiveNDMachineCode),
  ∃ M T, M.ComputesFunInTime (fun α => Turing.serializeK (c.decode α).tm.replayTM) T
Turing.CodeNDTM.serialize_eq_tableBitsK : ∀ (M : Turing.CodeNDTM),
  M.serialize =
    Turing.pairEncode M.numStates.bits
      (Turing.unaryFin M.tm.q₀ ++
        (Turing.tableBitsK (M.tm.fixChoice false).tr ++ Turing.tableBitsK (M.tm.fixChoice true).tr))
