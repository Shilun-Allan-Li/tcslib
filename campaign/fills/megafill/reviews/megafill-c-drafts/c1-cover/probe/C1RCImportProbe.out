Turing.EffectiveNDMachineCode.canonizerTime : Turing.EffectiveNDMachineCode → ℕ → ℕ
Turing.EffectiveNDMachineCode.canonizer_computes : ∀ (self : Turing.EffectiveNDMachineCode),
  self.canonizer.ComputesFunInTime (fun α => (self.decode α).serialize) self.canonizerTime
Turing.NDMachineCode.decode : Turing.NDMachineCode → List Bool → Turing.CodeNDTM
Turing.CodeNDTM.serialize : Turing.CodeNDTM → List Bool
Turing.CodeNDTM.numStates : Turing.CodeNDTM → ℕ
Turing.CodeNDTM.tm : (self : Turing.CodeNDTM) → Turing.NDTM 2 Bool (Fin (self.numStates + 1))
Turing.codePrim_machine : ∀ (f : List Bool → List Bool), Primrec f → ∃ M T, M.ComputesFunInTime f T
@Turing.FinTM.ComputesFunInTime : {Symbol : Type} → Turing.FinTM Symbol → (List Symbol → List Symbol) → (ℕ → ℕ) → Prop
@Turing.FinTM.computesFunInTime_iff : ∀ {Symbol : Type} (M : Turing.FinTM Symbol) (f : List Symbol → List Symbol)
  (T : ℕ → ℕ), M.ComputesFunInTime f T ↔ ∀ (input : List Symbol), M.ComputesInTime input (f input) (T input.length)
@Turing.FinTM.ComputesInTime.mono : ∀ {Symbol : Type} {M : Turing.FinTM Symbol} {input output : List Symbol} {t t' : ℕ},
  M.ComputesInTime input output t → t ≤ t' → M.ComputesInTime input output t'
@Turing.FinTM.computesFunInTime_comp : ∀ {M₁ M₂ : Turing.FinTM Bool} {f g : List Bool → List Bool} {T₁ T₂ : ℕ → ℕ},
  M₁.ComputesFunInTime f T₁ →
    M₂.ComputesFunInTime g T₂ → Monotone T₂ → ∃ M c, M.ComputesFunInTime (g ∘ f) fun n => c * (T₁ n + T₂ (T₁ n) + 1)
@Finset.le_sup : ∀ {α : Type u_1} {β : Type u_2} [inst : SemilatticeSup α] [inst_1 : OrderBot α] {s : Finset β}
  {f : β → α} {b : β}, b ∈ s → f b ≤ s.sup f
@Finset.sup_mono : ∀ {α : Type u_1} {β : Type u_2} [inst : SemilatticeSup α] [inst_1 : OrderBot α] {s₁ s₂ : Finset β}
  {f : β → α}, s₁ ⊆ s₂ → s₁.sup f ≤ s₂.sup f
@Finset.range_subset_range : ∀ {n m : ℕ}, Finset.range n ⊆ Finset.range m ↔ n ≤ m
@Finset.mem_range : ∀ {n m : ℕ}, m ∈ Finset.range n ↔ m < n
@Function.comp_apply : ∀ {β : Sort u_1} {δ : Sort u_2} {α : Sort u_3} {f : β → δ} {g : α → β} {x : α},
  (f ∘ g) x = f (g x)
@Turing.serializeK : {k n : ℕ} → Turing.MultiTapeTM k Bool (Fin (n + 1)) → List Bool
@Turing.serializeK_eq : ∀ {k n : ℕ} (M : Turing.MultiTapeTM k Bool (Fin (n + 1))),
  Turing.serializeK M = Turing.pairEncode n.bits (Turing.unaryFin M.q₀ ++ Turing.tableBitsK M.tr)
@Turing.NDTM.replayTM : {k : ℕ} → {S : Type u_1} → Turing.NDTM k Bool S → Turing.MultiTapeTM (k + 1) Bool S
@Turing.NDTM.replayTM_q₀ : ∀ {k : ℕ} {S : Type u_1} (N : Turing.NDTM k Bool S), N.replayTM.q₀ = N.q₀
@Turing.NDTM.replayTM_tr : ∀ {k : ℕ} {S : Type u_1} (N : Turing.NDTM k Bool S) (q : S) (inp : Option Bool)
  (w : Fin (k + 1) → Option Bool),
  N.replayTM.tr q inp w =
    have a := N.tr ((w (Fin.last k)).getD false) q inp fun i => w i.castSucc;
    { inputTape := a.inputTape, workTapes := fun i => Fin.lastCases (none, 1) a.workTapes i, output := a.output,
      state := a.state }
@Turing.NDTM.fixChoice : {k : ℕ} →
  {State : Type u_1} → {Symbol : Type u_2} → Turing.NDTM k Symbol State → Bool → Turing.MultiTapeTM k Symbol State
@Turing.NDTM.fixChoice_q₀ : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} (tm : Turing.NDTM k Symbol State)
  (b : Bool), (tm.fixChoice b).q₀ = tm.q₀
@Turing.NDTM.fixChoice_tr : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} (tm : Turing.NDTM k Symbol State)
  (b : Bool) (q : State) (input : Option Symbol) (work : Fin k → Option Symbol),
  (tm.fixChoice b).tr q input work = tm.tr b q input work
@Turing.tableBitsK : {k n : ℕ} →
  (Fin (n + 1) → Option Bool → (Fin k → Option Bool) → Turing.Action k Bool (Fin (n + 1))) → List Bool
@Turing.tableBitsK_eq : ∀ {k n : ℕ}
  (tr : Fin (n + 1) → Option Bool → (Fin k → Option Bool) → Turing.Action k Bool (Fin (n + 1))),
  Turing.tableBitsK tr =
    List.flatMap
      (fun q =>
        List.flatMap (fun inp => List.flatMap (fun w => Turing.actionBitsK (tr q inp w)) (Turing.workReadsK k))
          [none, some false, some true])
      (List.finRange (n + 1))
Turing.workReadsK : (k : ℕ) → List (Fin k → Option Bool)
Turing.workReadsK_zero : Turing.workReadsK 0 = [Fin.elim0]
Turing.workReadsK_succ : ∀ (k : ℕ),
  Turing.workReadsK (k + 1) =
    List.flatMap (fun w => List.map (fun r => Fin.cons w r) (Turing.workReadsK k)) [none, some false, some true]
@Turing.actionBitsK : {k n : ℕ} → Turing.Action k Bool (Fin (n + 1)) → List Bool
@Turing.actionBitsK_eq : ∀ {k n : ℕ} (a : Turing.Action k Bool (Fin (n + 1))),
  Turing.actionBitsK a =
    Turing.signBits a.inputTape ++
          List.flatMap (fun i => Turing.optOptBoolBits (a.workTapes i).1 ++ Turing.signBits (a.workTapes i).2)
            (List.finRange k) ++
        Turing.optBoolBits a.output ++
      Turing.optStateBits a.state
Turing.signBits : SignType → List Bool
Turing.signBits_zero : Turing.signBits SignType.zero = [false, false]
Turing.signBits_neg : Turing.signBits SignType.neg = [true, true]
Turing.signBits_pos : Turing.signBits SignType.pos = [true, false]
Turing.optOptBoolBits : Option (Option Bool) → List Bool
Turing.optOptBoolBits_none : Turing.optOptBoolBits none = [false, false]
Turing.optOptBoolBits_some_none : Turing.optOptBoolBits (some none) = [false, true]
Turing.optOptBoolBits_some_false : Turing.optOptBoolBits (some (some false)) = [true, false]
Turing.optOptBoolBits_some_true : Turing.optOptBoolBits (some (some true)) = [true, true]
SignType.pos_eq_one : SignType.pos = 1
Turing.pairEncode : List Bool → List Bool → List Bool
Turing.pairEncode_eq : ∀ (x α : List Bool),
  Turing.pairEncode x α = List.flatMap (fun b => [b, b]) x ++ [false, true] ++ α
Turing.length_pairEncode : ∀ (x y : List Bool), (Turing.pairEncode x y).length = 2 * x.length + 2 + y.length
Turing.pairDecode : List Bool → Option (List Bool × List Bool)
Turing.pairDecode_pairEncode : ∀ (x α : List Bool), Turing.pairDecode (Turing.pairEncode x α) = some (x, α)
@Turing.unaryFin : {n : ℕ} → Fin n → List Bool
@Turing.unaryFin_eq : ∀ {n : ℕ} (s : Fin n), Turing.unaryFin s = List.replicate (↑s) true ++ [false]
Turing.codeReadUnary : List Bool → Option (ℕ × List Bool)
Turing.codeReadUnary_append : ∀ (n : ℕ) (xs : List Bool),
  Turing.codeReadUnary (List.replicate n true ++ false :: xs) = some (n, xs)
Turing.codeBitsNat : List Bool → ℕ
Turing.codeBitsNat_bits : ∀ (n : ℕ), Turing.codeBitsNat n.bits = n
Turing.codeSkipActionK : ℕ → ℕ → List Bool → Option (List Bool)
@Turing.codeSkipActionK_append : ∀ {k n : ℕ} (a : Turing.Action k Bool (Fin (n + 1))) (xs : List Bool),
  Turing.codeSkipActionK k n (Turing.actionBitsK a ++ xs) = some xs
@Turing.codeActionK_length : ∀ {k n : ℕ} (a : Turing.Action k Bool (Fin (n + 1))),
  4 * k + 5 ≤ (Turing.actionBitsK a).length
Turing.codeSkipRepeat : (List Bool → Option (List Bool)) → ℕ → List Bool → Option (List Bool)
Turing.codeSkipRepeat_zero : ∀ (r : List Bool → Option (List Bool)) (xs : List Bool),
