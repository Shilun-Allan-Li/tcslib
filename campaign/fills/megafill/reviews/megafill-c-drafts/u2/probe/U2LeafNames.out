@Turing.step_of_tapeAction_write : ∀ {Symbol : Type u_1} {State : Type u_2} {k : ℕ} {x : List Symbol}
  (M : Turing.MultiTapeTM k Symbol State) (c : Turing.Cfg k Symbol State x) {q q' : State} (i : Fin k) (inp : SignType)
  (s : Option Symbol) (m : SignType),
  c.state = some q →
    M.tr q c.inputSymbol c.workTapeSymbols = Turing.tapeAction i inp (some s) m q' →
      Turing.MultiTapeTM.step c =
        { state := some q', inputPos := Turing.moveInputPos c.inputPos inp,
          workTapes := Function.update c.workTapes i (Function.update (c.workTapes i) (c.workTapePos i) s),
          workTapePos := Function.update c.workTapePos i (c.workTapePos i + ↑m), output := c.output }
@Turing.moveInputPos_pos_of_ne_right : ∀ {n : ℕ} (p : Fin (n + 2)) (h : ↑p ≠ n + 1),
  Turing.moveInputPos p SignType.pos = ⟨↑p + 1, ⋯⟩
@Turing.moveInputPos_zero : ∀ {n : ℕ} (pos : Fin (n + 2)), Turing.moveInputPos pos 0 = pos
@Turing.Action.apply_workTapes : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {input : List Symbol}
  (a : Turing.Action k Symbol State) (c : Turing.Cfg k Symbol State input) (i : Fin k),
  (a.apply c).workTapes i =
    Function.update (c.workTapes i) (c.workTapePos i) ((a.workTapes i).1.getD (c.workTapeSymbols i))
@List.getElem_drop : ∀ {α : Type u_1} {xs : List α} {i j : ℕ} {h : j < (List.drop i xs).length},
  (List.drop i xs)[j] = xs[i + j]
Turing.inputRewindTM : (k : ℕ) → Turing.MultiTapeTM k Bool Turing.InputRewindPhase
@Turing.inputRewindTM_run : ∀ {k : ℕ} {x : List Bool} (d : Turing.Cfg k Bool Turing.InputRewindPhase x),
  d.state = some Turing.InputRewindPhase.start →
    1 ≤ ↑d.inputPos →
      Turing.MultiTapeTM.runFrom d (↑d.inputPos + 1) =
          { state := some Turing.InputRewindPhase.done, inputPos := 1, workTapes := d.workTapes,
            workTapePos := d.workTapePos, output := d.output } ∧
        (∀ t < ↑d.inputPos + 1, (Turing.MultiTapeTM.runFrom d t).state ≠ some Turing.InputRewindPhase.done) ∧
          ∀ t ≤ ↑d.inputPos + 1,
            (Turing.MultiTapeTM.runFrom d t).workTapes = d.workTapes ∧
              (Turing.MultiTapeTM.runFrom d t).workTapePos = d.workTapePos ∧
                (Turing.MultiTapeTM.runFrom d t).output = d.output
exit 0
