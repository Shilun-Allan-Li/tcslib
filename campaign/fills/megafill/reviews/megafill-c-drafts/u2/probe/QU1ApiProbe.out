Turing.pairEncode_drop : ∀ (u x : List Bool), List.drop (2 * u.length + 2) (Turing.pairEncode u x) = x
Turing.pairEncode_pairEncode_drop : ∀ (u α x : List Bool),
  List.drop (2 * u.length + 2 * α.length + 4) (Turing.pairEncode u (Turing.pairEncode α x)) = x
@Turing.rulerAt_iff : ∀ {K : ℕ} {S : Type u_1} {y z : List Bool} {ℓ : ℕ} {r : Fin K} {d : Turing.Cfg K Bool S z}
  {i : Fin (y.length + 2)},
  Turing.RulerAt ℓ r d i ↔
    0 < ℓ ∧
      ℓ ≤ z.length ∧
        List.drop ℓ z = y ∧
          ↑d.inputPos = ℓ + ↑i ∧
            ∀ (p : ℤ),
              -1 ≤ p → p ≤ ↑ℓ → d.workTapes r (d.workTapePos r + p) = Turing.FinTM.bufferTape (List.replicate ℓ true) p
