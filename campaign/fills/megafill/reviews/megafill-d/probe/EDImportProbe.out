@Turing.NTimeDiag.exists_diagonalizer : ∀ {f g : ℕ → ℕ},
  Complexity.TimeConstructible f →
    Complexity.TimeConstructible g →
      ∀ (c : Turing.EffectiveNDMachineCode),
        (∃ BF,
            ∀ (α : List Bool),
              ∃ C,
                ∀ (x : List Bool) (t : ℕ),
                  ((c.decode α).toFinNDTM.AcceptsWithin x t →
                      BF.ComputesInTime (Turing.pairEncode (Turing.pairEncode t.bits α) x) [true]
                        (C * 2 ^ (C * (t + 1)))) ∧
                    (¬(c.decode α).toFinNDTM.AcceptsWithin x t →
                      BF.ComputesInTime (Turing.pairEncode (Turing.pairEncode t.bits α) x) [false]
                        (C * 2 ^ (C * (t + 1))))) →
          ∃ D K,
            (∀ (x : List Bool), D.tm.HaltsWithin x (K * (g x.length + 1))) ∧
              ∀ (α : List Bool),
                ∃ C,
                  ∀ (n : ℕ),
                    3 ≤ n →
                      Turing.NTimeDiag.stageCode (Turing.NTimeDiag.stage f n) = α →
                        (n ≠ Turing.NTimeDiag.ladder f (Turing.NTimeDiag.stage f n + 1) →
                            (D.AcceptsWithin (List.replicate n true) (K * (g n + 1)) →
                                (c.decode α).toFinNDTM.AcceptsWithin (List.replicate (n + 1) true) (g n)) ∧
                              ∀ (t' : ℕ),
                                (c.decode α).toFinNDTM.AcceptsWithin (List.replicate (n + 1) true) t' →
                                  C * (t' + 1) ≤ g n → D.AcceptsWithin (List.replicate n true) (K * (g n + 1))) ∧
                          (n = Turing.NTimeDiag.ladder f (Turing.NTimeDiag.stage f n + 1) →
                            C *
                                  2 ^
                                    (C *
                                      (Turing.NTimeDiag.budget f
                                          (Turing.NTimeDiag.ladder f (Turing.NTimeDiag.stage f n)) +
                                        1)) ≤
                                n →
                              (D.AcceptsWithin (List.replicate n true) (K * (g n + 1)) ↔
                                ¬(c.decode α).toFinNDTM.AcceptsWithin
                                    (List.replicate (Turing.NTimeDiag.ladder f (Turing.NTimeDiag.stage f n) + 1) true)
                                    (Turing.NTimeDiag.budget f
                                      (Turing.NTimeDiag.ladder f (Turing.NTimeDiag.stage f n)))))
