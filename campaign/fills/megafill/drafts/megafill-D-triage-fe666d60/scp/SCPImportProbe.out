Complexity.logSpace : ℕ → ℕ
@Complexity.transduce : {σ : Type} → (σ → Bool → σ) → (σ → Bool → Option Bool) → σ → List Bool → List Bool
@Complexity.transducerTM : {σ : Type} →
  [Fintype σ] → [DecidableEq σ] → (σ → Bool → σ) → (σ → Bool → Option Bool) → σ → Turing.FinTM Bool
@Complexity.transducerTM_computes : ∀ {σ : Type} [inst : Fintype σ] [inst_1 : DecidableEq σ] (δ : σ → Bool → σ)
  (o : σ → Bool → Option Bool) (q₀ : σ),
  (Complexity.transducerTM δ o q₀).ComputesFunInTime (Complexity.transduce δ o q₀) fun n => n + 1
Turing.FinTM.polyUnaryTM : ℕ → ℕ → Turing.FinTM Bool
Turing.FinTM.polyUnaryTM_computes : ∀ (C e : ℕ),
  (Turing.FinTM.polyUnaryTM C e).ComputesFunInTime (fun x => List.replicate (C * (x.length + 1) ^ e) true) fun n =>
