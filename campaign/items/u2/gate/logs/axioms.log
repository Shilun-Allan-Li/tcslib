  {Γ : Type} →
    {k' : ℕ} →
      {Γ' S S' : Type} →
        {x : List Γ} →
          {x' : List Γ'} →
            Turing.MultiTapeTM k Γ S →
              Turing.MultiTapeTM k' Γ' S' →
                (Turing.Cfg k Γ S x → Turing.Cfg k' Γ' S' x') →
                  (Turing.Cfg k Γ S x → ℕ) → Set (Option S) → Set (Option S') → Prop
@Turing.Lockstep.runFrom : ∀ {k : ℕ} {Γ : Type} {k' : ℕ} {Γ' S S' : Type} {x : List Γ} {x' : List Γ'}
  {M : Turing.MultiTapeTM k Γ S} {N : Turing.MultiTapeTM k' Γ' S'} {enc : Turing.Cfg k Γ S x → Turing.Cfg k' Γ' S' x'}
  {cost : Turing.Cfg k Γ S x → ℕ} {X : Set (Option S)} {X' : Set (Option S')},
  Turing.Lockstep M N enc cost X X' →
    ∀ (d : Turing.Cfg k Γ S x) (t : ℕ),
      (∀ u < t, (Turing.MultiTapeTM.runFrom d u).state ∉ X) →
        Turing.MultiTapeTM.runFrom (enc d) (∑ u ∈ Finset.range t, cost (Turing.MultiTapeTM.runFrom d u)) =
          enc (Turing.MultiTapeTM.runFrom d t)
@Turing.Lockstep.cut : ∀ {k : ℕ} {Γ : Type} {k' : ℕ} {Γ' S S' : Type} {x : List Γ} {x' : List Γ'}
  {M : Turing.MultiTapeTM k Γ S} {N : Turing.MultiTapeTM k' Γ' S'} {enc : Turing.Cfg k Γ S x → Turing.Cfg k' Γ' S' x'}
  {cost : Turing.Cfg k Γ S x → ℕ} {X : Set (Option S)} {X' : Set (Option S')},
  Turing.Lockstep M N enc cost X X' →
    ∀ (d : Turing.Cfg k Γ S x) (t : ℕ),
      (∀ u < t, (Turing.MultiTapeTM.runFrom d u).state ∉ X) →
        ∀ v < ∑ u ∈ Finset.range t, cost (Turing.MultiTapeTM.runFrom d u),
          (Turing.MultiTapeTM.runFrom (enc d) v).state ∉ X'
@Turing.StepBlock.Rep : {k n : ℕ} →
  {x : List Bool} →
    (Fin (n + 1) → Option Bool → (Fin k → Option Bool) → Turing.Action k Bool (Fin (n + 1))) →
      Turing.Cfg k Bool (Fin (n + 1)) x →
        Turing.Cfg (k + 2) Bool ((key : Turing.StepBlock.Key) × Turing.StepBlock.Ph k key) x → Prop
@Turing.StepBlock.roundTM_effect : ∀ {k n : ℕ} {x : List Bool}
  (tr : Fin (n + 1) → Option Bool → (Fin k → Option Bool) → Turing.Action k Bool (Fin (n + 1)))
  (c : Turing.Cfg k Bool (Fin (n + 1)) x) (q : Fin (n + 1)),
  c.state = some q →
    ∀ (d : Turing.Cfg (k + 2) Bool ((key : Turing.StepBlock.Key) × Turing.StepBlock.Ph k key) x),
      d.state = some ⟨Turing.StepBlock.Key.entry, ()⟩ →
        Turing.StepBlock.Rep tr c d →
          have a := tr q c.inputSymbol c.workTapeSymbols;
          ∃ T,
            0 < T ∧
              T ≤ 50 * ((Turing.tableBitsK tr).length + 1) ∧
                have e := Turing.MultiTapeTM.runFrom d T;
                e.state = some (Turing.StepBlock.exit k a.state.isSome) ∧
                  Turing.StepBlock.Rep tr (a.apply c) e ∧
                    e.workTapeSymbols (Turing.StepBlock.summaryTape k) =
                        Turing.StepBlock.summaryEmit (d.workTapeSymbols (Turing.StepBlock.summaryTape k)) a.output ∧
                      (∀ (u : ℕ),
                          0 < u →
                            u < T →
                              ∃ s,
                                (Turing.MultiTapeTM.runFrom d u).state = some s ∧
                                  s ≠ ⟨Turing.StepBlock.Key.entry, ()⟩ ∧ s ≠ ⟨Turing.StepBlock.Key.halt, ()⟩) ∧
                        (∀ u ≤ T, (Turing.MultiTapeTM.runFrom d u).output = d.output) ∧
                          (∀ u ≤ T,
                              have f := Turing.MultiTapeTM.runFrom d u;
                              (f.inputPos = d.inputPos ∨ f.inputPos = e.inputPos) ∧
                                |↑↑f.inputPos - ↑↑d.inputPos| ≤ 1 ∧
                                  (∀ (i : Fin k),
                                      f.workTapePos (Fin.castAdd 2 i) = d.workTapePos (Fin.castAdd 2 i) ∨
                                        f.workTapePos (Fin.castAdd 2 i) = e.workTapePos (Fin.castAdd 2 i)) ∧
                                    ∀ (j : Fin (k + 2)),
                                      |f.workTapePos j - d.workTapePos j| ≤
                                        ↑(if ↑j < k then 1 else 50 * ((Turing.tableBitsK tr).length + 1))) ∧
                            ∀ (j : Fin (k + 2)), k ≤ ↑j → d.workTapePos j = 0 ∧ e.workTapePos j = 0
@Turing.StepBlock.roundTM_firstExit_unique : ∀ {k n : ℕ} {x : List Bool}
  (tr : Fin (n + 1) → Option Bool → (Fin k → Option Bool) → Turing.Action k Bool (Fin (n + 1)))
  (c : Turing.Cfg k Bool (Fin (n + 1)) x) (q : Fin (n + 1)),
  c.state = some q →
    ∀ (d : Turing.Cfg (k + 2) Bool ((key : Turing.StepBlock.Key) × Turing.StepBlock.Ph k key) x),
      d.state = some ⟨Turing.StepBlock.Key.entry, ()⟩ →
        Turing.StepBlock.Rep tr c d →
          ∃! T,
            0 < T ∧
              ((Turing.MultiTapeTM.runFrom d T).state = some ⟨Turing.StepBlock.Key.entry, ()⟩ ∨
                  (Turing.MultiTapeTM.runFrom d T).state = some ⟨Turing.StepBlock.Key.halt, ()⟩) ∧
                ∀ (u : ℕ),
                  0 < u →
                    u < T →
                      (Turing.MultiTapeTM.runFrom d u).state ≠ some ⟨Turing.StepBlock.Key.entry, ()⟩ ∧
                        (Turing.MultiTapeTM.runFrom d u).state ≠ some ⟨Turing.StepBlock.Key.halt, ()⟩
@Turing.StepBlock.roundTM_visited : ∀ {k n : ℕ} {x : List Bool}
  (tr : Fin (n + 1) → Option Bool → (Fin k → Option Bool) → Turing.Action k Bool (Fin (n + 1)))
  (c : Turing.Cfg k Bool (Fin (n + 1)) x) (q : Fin (n + 1)),
  c.state = some q →
    ∀ (d : Turing.Cfg (k + 2) Bool ((key : Turing.StepBlock.Key) × Turing.StepBlock.Ph k key) x),
      d.state = some ⟨Turing.StepBlock.Key.entry, ()⟩ →
        Turing.StepBlock.Rep tr c d →
          have a := tr q c.inputSymbol c.workTapeSymbols;
          ∃ T,
            0 < T ∧
              T ≤ 50 * ((Turing.tableBitsK tr).length + 1) ∧
                (Turing.MultiTapeTM.runFrom d T).state = some (Turing.StepBlock.exit k a.state.isSome) ∧
                  Turing.StepBlock.Rep tr (a.apply c) (Turing.MultiTapeTM.runFrom d T) ∧
                    (∀ (u : ℕ),
                        0 < u →
                          u < T →
                            ∃ s,
                              (Turing.MultiTapeTM.runFrom d u).state = some s ∧
                                s ≠ ⟨Turing.StepBlock.Key.entry, ()⟩ ∧ s ≠ ⟨Turing.StepBlock.Key.halt, ()⟩) ∧
                      (∀ u ≤ T, (Turing.MultiTapeTM.runFrom d u).output = d.output) ∧
                        (∀ (i : Fin k),
                            Turing.MultiTapeTM.visitedByTapeHead d T (Fin.castAdd 2 i) ⊆
                              {c.workTapePos i, (a.apply c).workTapePos i}) ∧
                          ∀ (j : Fin (k + 2)),
                            k ≤ ↑j →
                              Turing.MultiTapeTM.visitedByTapeHead d T j ⊆
                                Finset.Icc (-↑(50 * ((Turing.tableBitsK tr).length + 1)))
                                  ↑(50 * ((Turing.tableBitsK tr).length + 1))
Turing.StepBlock.summaryEmit_none : ∀ (b : Option Bool), Turing.StepBlock.summaryEmit none b = b
@Turing.MultiTapeTM.visitedByTapeHead_add_subset : ∀ {m : ℕ} {S : Type} {x : List Bool}
  (M : Turing.MultiTapeTM m Bool S) (d : Turing.Cfg m Bool S x) (T₁ T₂ : ℕ) (j : Fin m),
  Turing.MultiTapeTM.visitedByTapeHead d (T₁ + T₂) j ⊆
