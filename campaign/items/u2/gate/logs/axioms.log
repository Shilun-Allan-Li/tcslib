Turing.universalCanonTM : Turing.EffectiveMachineCode → Turing.FinTM Bool
@Turing.universalCaptureTM : {S : Type} →
  [Fintype S] → [DecidableEq S] → Turing.FinTM Bool → Turing.MultiTapeTM 4 Bool S → Turing.FinTM Bool
Turing.universalCanon_complete : ∀ (c : Turing.EffectiveMachineCode) (α x : List Bool),
  have cfg :=
    Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg (Turing.pairEncode α x))
      (3 * α.length + 4 + c.canonizerTime α.length);
  cfg.state = none ∧ cfg.output = (c.decode α).serialize ∧ ↑cfg.inputPos = 2 * α.length + 3
@Turing.FinTM.timed_rewind : ∀ {k : ℕ} {S : Type} {x : List Bool} (tm : Turing.MultiTapeTM k Bool S) (start scan : S)
  (dest : Option S),
  (∀ (inp : Option Bool) (work : Fin k → Option Bool),
      tm.tr start inp work = Turing.FinTM.controlAction SignType.neg (some scan)) →
    (∀ (inp : Option Bool) (work : Fin k → Option Bool),
        tm.tr scan inp work =
          match inp with
          | some val => Turing.FinTM.controlAction SignType.neg (some scan)
          | none => Turing.FinTM.controlAction SignType.pos dest) →
      ∀ (c : Turing.Cfg k Bool S x),
        c.state = some start →
          ∃ r ≤ ↑c.inputPos + 2,
            Turing.MultiTapeTM.runFrom c r =
              { state := dest, inputPos := 1, workTapes := c.workTapes, workTapePos := c.workTapePos,
                output := c.output }
@Turing.MultiTapeTM.spaceUsed_le_mul_succ : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {input : List Symbol}
  (tm : Turing.MultiTapeTM k Symbol State) (cfg : Turing.Cfg k Symbol State input) (t : ℕ),
  Turing.MultiTapeTM.spaceUsed cfg t ≤ k * (t + 1)
Turing.universal_pair_length : ∀ (α x : List Bool), (Turing.pairEncode α x).length = 2 * α.length + 2 + x.length
@Turing.exists_rulerHostTM : ∀ {m : ℕ} {S : Type} [Fintype S] [DecidableEq S] (M : Turing.MultiTapeTM m Bool S),
  ∃ Q x x H inj C,
    0 < C ∧
      ∀ {y z : List Bool} (ℓ : ℕ) (hz : z.length = ℓ + y.length),
        0 < ℓ →
          List.drop ℓ z = y →
            ∀ (rt : ℤ → Option Bool) (rp : ℤ),
              (∀ (p : ℤ), -1 ≤ p → p ≤ ↑ℓ → rt (rp + p) = Turing.FinTM.bufferTape (List.replicate ℓ true) p) →
                ∀ (c : Turing.Cfg m Bool S y) (b : Bool),
                  (b = true ↔ ↑c.inputPos = 0) →
                    ∀ (t : ℕ),
                      have d := Turing.rulerHostCfg ℓ hz (Option.map (fun q => inj q b) c.state) c rt rp;
                      ∃ t',
                        t ≤ t' ∧
                          t' ≤ C * (ℓ + 1) * t ∧
                            (∃ b',
                                (b' = true ↔ ↑(Turing.MultiTapeTM.runFrom c t).inputPos = 0) ∧
                                  Turing.MultiTapeTM.runFrom d t' =
                                    Turing.rulerHostCfg ℓ hz
                                      (Option.map (fun q => inj q b') (Turing.MultiTapeTM.runFrom c t).state)
                                      (Turing.MultiTapeTM.runFrom c t) rt rp) ∧
                              ((∀ u < t, (Turing.MultiTapeTM.runFrom c u).state ≠ none) →
                                  ∀ u < t', (Turing.MultiTapeTM.runFrom d u).state ≠ none) ∧
                                (∀ u ≤ t',
                                    ∃ v ≤ t,
                                      (∀ (i : Fin m),
                                          (Turing.MultiTapeTM.runFrom d u).workTapes i.castSucc =
                                              (Turing.MultiTapeTM.runFrom c v).workTapes i ∧
                                            (Turing.MultiTapeTM.runFrom d u).workTapePos i.castSucc =
                                              (Turing.MultiTapeTM.runFrom c v).workTapePos i) ∧
                                        (Turing.MultiTapeTM.runFrom d u).output =
                                            (Turing.MultiTapeTM.runFrom c v).output ∧
                                          (Turing.MultiTapeTM.runFrom d u).workTapes (Fin.last m) = rt ∧
                                            (Turing.MultiTapeTM.runFrom d u).workTapePos (Fin.last m) ∈
                                              Finset.Icc (rp - 1) (rp + ↑ℓ)) ∧
                                  (∀ (i : Fin m),
                                      Turing.MultiTapeTM.visitedByTapeHead d t' i.castSucc =
                                        Turing.MultiTapeTM.visitedByTapeHead c t i) ∧
                                    Turing.MultiTapeTM.visitedByTapeHead d t' (Fin.last m) ⊆
                                      Finset.Icc (rp - 1) (rp + ↑ℓ)
