.BinderInfo.default)))\n        (Lean.BinderInfo.default)))\n    (Lean.BinderInfo.default))","type_pretty":"∃ K S x x R entry exit C,\n  ∀ {x : List Bool} (d : Turing.Cfg (K + 1) Bool S x),\n    d.state = some entry →\n      d.inputPos = 1 →\n        (∀ (p : ℤ), -1 ≤ p → p ≤ ↑x.length.bits.length → d.workTapes 0 (d.workTapePos 0 + p) = none) →\n          (∀ (j : Fin (K + 1)), j ≠ 0 → ∀ (p : ℤ), d.workTapes j p = none) →\n            ∃ t ≤ C * (x.length + 1),\n              (∀ u < t, (Turing.MultiTapeTM.runFrom d u).state ≠ some exit) ∧\n                (∀ u ≤ t,\n                    ∀ (j : Fin (K + 1)),\n                      |(Turing.MultiTapeTM.runFrom d u).workTapePos j - d.workTapePos j| ≤\n                        ↑(C * (x.length.bits.length + 1))) ∧\n                  Turing.MultiTapeTM.runFrom d t =\n                    { state := some exit, inputPos := d.inputPos,\n                      workTapes := fun j q =>\n                        if j = 0 ∧ d.workTapePos j ≤ q ∧ q < d.workTapePos j + ↑x.length.bits.length then\n                          Turing.FinTM.bufferTape x.length.bits (q - d.workTapePos j)\n                        else d.workTapes j q,\n                      workTapePos := d.workTapePos, output := d.output }","unfold":false,"universes":[]}
CONSUMER_COMPLETE|1|11
