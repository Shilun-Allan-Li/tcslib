apes := Fin.append (Complexity.LogProg.regMove r 1) Complexity.LogProg.dIdle,\n            output := none, state := some (Complexity.LogProg.nextRet cs l s dir res (↑a + 1)) }\n      else\n        match rd with\n        | none =>\n          if leftSide = true then\n            { inputTape := 0, workTapes := Fin.append (Complexity.LogProg.regMove r 1) Complexity.LogProg.dIdle,\n              output := none, state := some (Complexity.LogProg.nextRet cs l s dir res (↑a + 1)) }\n          else\n            { inputTape := 0, workTapes := Fin.append (Complexity.LogProg.regMove r (-1)) Complexity.LogProg.dIdle,\n              output := none, state := some (Complexity.LogProg.CSt.retR l s dir res a true) }\n        | some val =>\n          { inputTape := 0, workTapes := Fin.append (Complexity.LogProg.regMove r (-1)) Complexity.LogProg.dIdle,\n            output := none, state := some (Complexity.LogProg.CSt.retR l s dir res a true) }"}
