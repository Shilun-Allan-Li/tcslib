             (Lean.Expr.bvar 1))\n                                                              (Lean.Expr.const `Bool.false [])))\n                                                          (Lean.BinderInfo.default)))))\n                                                  true)\n                                                true)\n                                              true)\n                                            true)\n                                          true)\n                                        true)\n                                      (Lean.BinderInfo.default))))\n                                (Lean.BinderInfo.default))\n                              (Lean.BinderInfo.default))\n                            (Lean.BinderInfo.default))\n                          (Lean.BinderInfo.default))\n                        (Lean.BinderInfo.default))\n                      (Lean.BinderInfo.default))\n                    (Lean.BinderInfo.default))\n                  (Lean.BinderInfo.default))\n                (Lean.BinderInfo.default))\n              (Lean.BinderInfo.default))\n            (Lean.BinderInfo.default))\n          (Lean.BinderInfo.implicit))\n        (Lean.BinderInfo.implicit))\n      (Lean.BinderInfo.implicit))\n    (Lean.BinderInfo.implicit))\n  (Lean.BinderInfo.implicit)","typePretty":"∀ {m d kD : ℕ} {Λ SD : Type} (P : Complexity.LogProg.RProg m d Λ) (D : Turing.MultiTapeTM kD Bool SD) (q0 : Fin d → SD)\n  (x : Option Bool) (x_1 : Fin (m + kD) → Option Bool) (l : Λ) (q : SD) (s : Fin (m + 1)) (par dir : Bool)\n  (res : Option Bool),\n  Complexity.LogProg.ctr P D q0 (Complexity.LogProg.CSt.sim l q s par dir res) x x_1 =\n    match P.call l with\n    | none => { inputTape := 0, workTapes := fun x => (none, 0), output := none, state := none }\n    | some cs =>\n      have rd :=\n        if ↑s = 0 then x else if hm : 0 < m then x_1 (Fin.castAdd kD (Complexity.LogProg.segReg cs (↑s) hm)) else none;\n      have ic := Complexity.LogProg.isCharRead cs.mode (↑s) rd;\n      have vs := Complexity.LogProg.virtSym cs.mode (↑s) (cs.args.length + 1) dir rd;\n      have a := D.tr q vs fun i => x_1 (Fin.natAdd m i);\n      have g :=\n        Complexity.LogProg.gstep (Complexity.LogProg.segDbl cs ↑s) (decide (↑s + 1 = cs.args.length + 1))\n          (decide (↑s = 0)) (↑s) par dir ic a.inputTape;\n      have res' := res <|> a.output;\n      { inputTape := if ↑s = 0 then g.2.2.2 else 0,\n        workTapes :=\n          Fin.append\n            (fun r =>\n              (none, if h : 0 < m then if ↑s ≠ 0 ∧ r = Complexity.LogProg.segReg cs (↑s) h then g.2.2.2 else 0 else 0))\n            a.workTapes,\n        output := none,\n        state :=\n          some\n            (match a.state with\n            | some q' => Complexity.LogProg.CSt.sim l q' (Complexity.LogProg.toFin m g.1) g.2.1 g.2.2.1 res'\n            | none => Complexity.LogProg.CSt.ret1 l (Complexity.LogProg.toFin m g.1) g.2.2.1 (res'.getD false)) }"}
