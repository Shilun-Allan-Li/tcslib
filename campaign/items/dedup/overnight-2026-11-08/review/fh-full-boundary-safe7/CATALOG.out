one x =\n    match P.call l with\n    | none => { inputTape := 0, workTapes := fun x => (none, 0), output := none, state := none }\n    | some cs =>\n      { inputTape := 1, workTapes := fun x => (none, 0), output := none,\n        state := some (Complexity.LogProg.nextRet cs l s dir res 0) }"}
