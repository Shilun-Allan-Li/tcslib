else Complexity.OblSymbol.inside;\n            match q with\n            | Complexity.OblPhase.init =>\n              act (Complexity.OblPhase.clock W.tm.q₀) 0 (put Complexity.OblSymbol.origin SignType.pos)\n                (put Complexity.OblSymbol.origin SignType.pos) stay\n            | Complexity.OblPhase.clock s =>\n              have action :=\n                W.tm.tr s (Option.map (fun x => false) inp) fun i => Complexity.clockBit (ws (Fin.castAdd 3 i));\n              { inputTape := action.inputTape,\n                workTapes := fun i =>\n                  Fin.addCases\n                    (fun i =>\n                      (Option.map (Option.map Complexity.OblSymbol.bit) (action.workTapes i).1, (action.workTapes i).2))\n                    (fun j =>\n                      if ↑j = 0 then\n                        match action.output with\n                        | none => stay\n                        | some b => put (Complexity.OblSymbol.bit b) SignType.pos\n                      else stay)\n                    i,\n                output := none,\n                state :=\n                  some ((Option.map Complexity.OblPhase.clock action.state).getD Complexity.OblPhase.resetStart) }\n            | Complexity.OblPhase.resetStart => act Complexity.OblPhase.resetScan SignType.neg stay stay stay\n            | Complexity.OblPhase.resetScan =>\n              match inp with\n              | none => act Complexity.OblPhase.copyLeft SignType.pos stay stay stay\n              | some val => act Complexity.OblPhase.resetScan SignType.neg stay stay stay\n            | Complexity.OblPhase.copyLeft => act Complexity.OblPhase.copyLeftWrite 0 stay stay (move SignType.neg)\n            | Complexity.OblPhase.copyLeftWrite =>\n              act Complexity.OblPhase.copyFirst 0 stay stay (put Complexity.OblSymbol.inside SignType.pos)\n            | Complexity.OblPhase.copyFirst =>\n              match inp with\n              | none => act Complexity.OblPhase.copyReturn 0 stay stay (put Complexity.OblSymbol.origin 0)\n              | some val =>\n                act Complexity.OblPhase.copyMore SignType.pos stay stay (put Complexity.OblSymbol.origin SignType.pos)\n            | Complexity.OblPhase.copyMore =>\n              match inp with\n              | none => act Complexity.OblPhase.copyReturn 0 stay stay (put Complexity.OblSymbol.inside 0)\n              | some val =>\n                act Complexity.OblPhase.copyMore SignType.pos stay stay (put Complexity.OblSymbol.inside SignType.pos)\n            | Complexity.OblPhase.copyReturn =>\n              if guide = some Complexity.OblSymbol.origin then act Complexity.OblPhase.budgetStart 0 stay stay stay\n              else act Complexity.OblPhase.copyReturn 0 stay stay (move SignType.neg)\n            | Complexity.OblPhase.budgetStart => act Complexity.OblPhase.budgetBack 0 (move SignType.neg) stay stay\n            | Complexity.OblPhase.budgetBack =>\n              if bit = some Complexity.OblSymbol.origin then\n                act (Complexity.OblPhase.append 0) 0 (move SignType.pos) stay stay\n              else act Complexity.OblPhase.budgetBack 0 (move SignType.neg) stay stay\n            | Complexity.OblPhase.append i =>\n              if h : ↑i < a + 1 then\n                act (Complexity.OblPhase.append ⟨↑i + 1, ⋯⟩) 0 stay (put Complexity.OblSymbol.unit SignType.pos) stay\n              else act (Complexity.OblPhase.borrow true) 0 stay stay stay\n            | Complexity.OblPhase.borrow carry =>\n              match bit with\n              | some (Complexity.OblSymbol.bit b) =>\n                act (Complexity.OblPhase.borrow (carry && !b)) 0\n                  (put (Complexity.OblSymbol.bit (b ^^ carry)) SignType.pos) stay stay\n              | x =>\n                if carry = true then act Complexity.OblPhase.unaryStart 0 stay stay stay\n                else act Complexity.OblPhase.budgetStart 0 stay stay stay\n            | Complexity.OblPhase.unaryStart => act Complexity.OblPhase.unaryBack 0 stay (move SignType.neg) stay\n            | Complexity.OblPhase.unaryBack =>\n              if unary = some Complexity.OblSymbol.origin then\n                act (Complexity.OblPhase.layoutRight 0) 0 stay (move SignType.pos) stay\n              else act Complexity.OblPhase.unaryBack 0 stay (move SignType.neg) stay\n            | Complexity.OblPhase.layoutRight i =>\n              if unary = some Complexity.OblSymbol.unit then\n                act (Complexity.OblPhase.layoutRight (Complexity.nextThird i)) 0 stay\n                  (move (if ↑i = 2 then SignType.pos else 0)) (put interior SignType.pos)\n              else act Complexity.OblPhase.rightEdge 0 stay stay (put Complexity.OblSymbol.inside SignType.pos)\n            | Complexity.OblPhase.rightEdge =>\n              act (Complexity.OblPhase.layoutReturn 0) 0 stay (move SignType.neg)\n                (put (Complexity.OblSymbol.edge true) SignType.neg)\n            | Complexity.OblPhase.layoutReturn i =>\n              if unary = some Complexity.OblSymbol.origin then\n                act (Complexity.OblPhase.layoutLeft 0) 0 stay (move SignType.pos) stay\n              else\n                act (Complexity.OblPhase.layoutReturn (Complexity.nextThird i)) 0 stay\n                  (move (if ↑i = 2 then SignType.neg else 0)) (move SignType.neg)\n            | Complexity.OblPhase.layoutLeft i =>\n              if unary = some Complexity.OblSymbol.unit then\n                act (Complexity.OblPhase.layoutLeft (Complexity.nextThird i)) 0 stay\n                  (move (if ↑i = 2 then SignType.pos else 0)) (put interior SignType.neg)\n              else act Complexity.OblPhase.leftEdge 0 stay stay (put Complexity.OblSymbol.inside SignType.neg)\n            | Complexity.OblPhase.leftEdge =>\n              act Complexity.OblPhase.unaryReset 0 stay (move SignType.neg) (put (Complexity.OblSymbol.edge false) 0)\n            | Complexity.OblPhase.unaryReset =>\n              if unary = some Complexity.OblSymbol.origin then\n                act Complexity.OblPhase.startCenter 0 stay (move SignType.pos) stay\n              else act Complexity.OblPhase.unaryReset 0 stay (move SignType.neg) stay\n            | Complexity.OblPhase.startCenter =>\n              if guide = some Complexity.OblSymbol.origin then act Complexity.OblPhase.macroCheck 0 stay stay stay\n              else act Complexity.OblPhase.startCenter 0 stay stay (move SignType.pos)\n            | Complexity.OblPhase.macroCheck =>\n              if unary = some Complexity.OblSymbol.unit then act Complexity.OblPhase.seekLeft 0 stay stay stay\n              else Complexity.oblAction none 0 stay stay stay\n            | Complexity.OblPhase.seekLeft =>\n              if guide = some (Complexity.OblSymbol.edge false) then\n                act Complexity.OblPhase.forward 0 stay stay (move SignType.pos)\n              else act Complexity.OblPhase.seekLeft 0 stay stay (move SignType.neg)\n            | Complexity.OblPhase.forward =>\n              if guide = some (Complexity.OblSymbol.edge true) then\n                act Complexity.OblPhase.backward 0 stay stay (move SignType.neg)\n              else act Complexity.OblPhase.forward 0 stay stay (move SignType.pos)\n            | Complexity.OblPhase.backward =>\n              if guide = some (Complexity.OblSymbol.edge false) then\n                act Complexity.OblPhase.returnCenter 0 stay stay (move SignType.pos)\n              else act Complexity.OblPhase.backward 0 stay stay (move SignType.neg)\n            | Complexity.OblPhase.returnCenter =>\n              if guide = some Complexity.OblSymbol.origin then\n                act Complexity.OblPhase.macroCheck 0 stay (move SignType.pos) stay\n              else act Complexity.OblPhase.returnCenter 0 stay stay (move SignType.pos) } }"}
