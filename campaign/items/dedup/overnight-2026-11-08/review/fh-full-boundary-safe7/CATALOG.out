[Lean.Level.zero]) (Lean.Expr.const `Bool []))))\n                      (Lean.Expr.const `SignType []))\n                    (Lean.Expr.app\n                      (Lean.Expr.const `Option.none [Lean.Level.zero])\n                      (Lean.Expr.app (Lean.Expr.const `Option [Lean.Level.zero]) (Lean.Expr.const `Bool []))))\n                  (Lean.Expr.app\n                    (Lean.Expr.app\n                      (Lean.Expr.app (Lean.Expr.const `OfNat.ofNat [Lean.Level.zero]) (Lean.Expr.const `SignType []))\n                      (Lean.Expr.lit (Lean.Literal.natVal 0)))\n                    (Lean.Expr.app\n                      (Lean.Expr.app (Lean.Expr.const `Zero.toOfNat0 [Lean.Level.zero]) (Lean.Expr.const `SignType []))\n                      (Lean.Expr.const `SignType.instZero [])))))\n              (Lean.BinderInfo.default)))\n          (Lean.BinderInfo.default))\n        (Lean.BinderInfo.default))\n      (Lean.BinderInfo.default)))","typePretty":"Turing.universalInterpreter =\n  { q₀ := Turing.UniversalControl.start,\n    tr := fun q inp work =>\n      match q with\n      | Turing.UniversalControl.start =>\n        { inputTape := 0,\n          workTapes :=\n            Turing.universalFour (none, SignType.neg) (some (some false), SignType.pos) (none, 0)\n              (some (some true), SignType.pos),\n          output := none, state := some (Turing.UniversalControl.rewindTable true 0) }\n      | Turing.UniversalControl.rewindTable initial index =>\n        if work 0 = none then Turing.universalAdmin (Turing.UniversalControl.countFirst initial index) SignType.pos\n        else Turing.universalAdmin (Turing.UniversalControl.rewindTable initial index) SignType.neg\n      | Turing.UniversalControl.countFirst initial index =>\n        match work 0 with\n        | some b => Turing.universalAdmin (Turing.UniversalControl.countSecond initial index b) SignType.pos\n        | none => Turing.universalAdmin Turing.UniversalControl.invalid\n      | Turing.UniversalControl.countSecond initial index b =>\n        match work 0 with\n        | some v =>\n          if b = v then Turing.universalAdmin (Turing.UniversalControl.countFirst initial index) SignType.pos\n          else\n            if b = false ∧ v = true then\n              Turing.universalAdmin\n                (if initial = true then Turing.UniversalControl.initialCopy\n                else Turing.UniversalControl.initialSkip index)\n                SignType.pos\n            else Turing.universalAdmin Turing.UniversalControl.invalid\n        | none => Turing.universalAdmin Turing.UniversalControl.invalid\n      | Turing.UniversalControl.initialCopy =>\n        match work 0 with\n        | some true =>\n          Turing.universalAdmin Turing.UniversalControl.initialCopy SignType.pos (some (some true), SignType.pos)\n        | some false => Turing.universalAdmin (Turing.UniversalControl.rewindState none) SignType.pos\n        | none => Turing.universalAdmin Turing.UniversalControl.invalid\n      | Turing.UniversalControl.initialSkip index =>\n        match work 0 with\n        | some true => Turing.universalAdmin (Turing.UniversalControl.initialSkip index) SignType.pos\n        | some false => Turing.universalAdmin (Turing.UniversalControl.group index) SignType.pos\n        | none => Turing.universalAdmin Turing.UniversalControl.invalid\n      | Turing.UniversalControl.rewindState index =>\n        if work 1 = some false then\n          have next :=\n            match index with\n            | none => Turing.UniversalControl.main\n            | some i =>\n              if h : ↑i = 0 then Turing.UniversalControl.readAction 0 fun x => false\n              else Turing.UniversalControl.skipFixed none ⟨↑i - 1, ⋯⟩ 0;\n          Turing.universalAdmin next 0 (none, SignType.pos)\n        else Turing.universalAdmin (Turing.UniversalControl.rewindState index) 0 (none, SignType.neg)\n      | Turing.UniversalControl.main =>\n        have v := if work 3 = some true then none else inp;\n        Turing.universalAdmin (Turing.UniversalControl.rewindTable false (Turing.universalRecordIndex v (work 2)))\n          SignType.neg\n      | Turing.UniversalControl.group index =>\n        match work 1 with\n        | some true =>\n          Turing.universalAdmin (Turing.UniversalControl.skipFixed (some index) 8 0) 0 (some none, SignType.pos)\n        | none => Turing.universalAdmin (Turing.UniversalControl.rewindState (some index))\n        | some false => Turing.universalAdmin Turing.UniversalControl.invalid\n      | Turing.UniversalControl.skipFixed dest remaining field =>\n        if h : ↑field = 7 then Turing.universalAdmin (Turing.UniversalControl.skipUnary dest remaining) SignType.pos\n        else Turing.universalAdmin (Turing.UniversalControl.skipFixed dest remaining ⟨↑field + 1, ⋯⟩) SignType.pos\n      | Turing.UniversalControl.skipUnary dest remaining =>\n        match work 0 with\n        | some true => Turing.universalAdmin (Turing.UniversalControl.skipUnary dest remaining) SignType.pos\n        | some false =>\n          if h : ↑remaining = 0 then\n            Turing.universalAdmin\n              (match dest with\n              | none => Turing.UniversalControl.readAction 0 fun x => false\n              | some i => Turing.UniversalControl.group i)\n              SignType.pos\n          else Turing.universalAdmin (Turing.UniversalControl.skipFixed dest ⟨↑remaining - 1, ⋯⟩ 0) SignType.pos\n        | none => Turing.universalAdmin Turing.UniversalControl.invalid\n      | Turing.UniversalControl.readAction field bits =>\n        match work 0 with\n        | some b =>\n          have bs := Function.update bits field b;\n          if h : ↑field = 7 then Turing.universalAdmin (Turing.UniversalControl.nextState bs) SignType.pos\n          else Turing.universalAdmin (Turing.UniversalControl.readAction ⟨↑field + 1, ⋯⟩ bs) SignType.pos\n        | none => Turing.universalAdmin Turing.UniversalControl.invalid\n      | Turing.UniversalControl.nextState bits =>\n        match work 0 with\n        | some false => Turing.universalAdmin (Turing.UniversalControl.applyRecord bits true)\n        | some true => Turing.universalAdmin (Turing.UniversalControl.copyState bits) SignType.pos\n        | none => Turing.universalAdmin Turing.UniversalControl.invalid\n      | Turing.UniversalControl.copyState bits =>\n        match work 0 with\n        | some true =>\n          Turing.universalAdmin (Turing.UniversalControl.copyState bits) SignType.pos (some (some true), SignType.pos)\n        | some false => Turing.universalAdmin (Turing.UniversalControl.rewindNext bits)\n        | none => Turing.universalAdmin Turing.UniversalControl.invalid\n      | Turing.UniversalControl.rewindNext bits =>\n        if work 1 = some false then\n          Turing.universalAdmin (Turing.UniversalControl.applyRecord bits false) 0 (none, SignType.pos)\n        else Turing.universalAdmin (Turing.UniversalControl.rewindNext bits) 0 (none, SignType.neg)\n      | Turing.UniversalControl.applyRecord bits halt =>\n        have v := if work 3 = some true then none else inp;\n        have d := Turing.FinTM.virtualMove (decide (work 3 ≠ some true)) v (Turing.universalSign (bits 0) (bits 1));\n        { inputTape := d,\n          workTapes :=\n            Turing.universalFour (none, 0) (none, 0)\n              (Turing.universalWrite (bits 2) (bits 3), Turing.universalSign (bits 4) (bits 5)) (none, d),\n          output := if bits 6 = true then some (bits 7) else none,\n          state := if halt = true then none else some Turing.UniversalControl.main }\n      | Turing.UniversalControl.invalid => Turing.universalAdmin Turing.UniversalControl.invalid }"}
