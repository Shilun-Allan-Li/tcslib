i none none 1 (some (Complexity.LogProg.CleanSt.cl i Complexity.LogProg.CPh.goR))\n          else\n            Complexity.LogProg.clAct i none none (-1)\n              (some (Complexity.LogProg.CleanSt.cl i Complexity.LogProg.CPh.erase))\n        | Complexity.LogProg.CleanSt.cl i Complexity.LogProg.CPh.erase, x, w =>\n          match w (Fin.natAdd k i) with\n          | some true =>\n            Complexity.LogProg.clAct i (some none) none (-1)\n              (some (Complexity.LogProg.CleanSt.cl i Complexity.LogProg.CPh.erase))\n          | some false =>\n            Complexity.LogProg.clAct i (some none) (some none) (-1)\n              (some (Complexity.LogProg.CleanSt.cl i Complexity.LogProg.CPh.erase))\n          | none =>\n            Complexity.LogProg.clAct i none none 1 (some (Complexity.LogProg.CleanSt.cl i Complexity.LogProg.CPh.back))\n        | Complexity.LogProg.CleanSt.cl i Complexity.LogProg.CPh.back, x, w =>\n          match w (Fin.natAdd k i) with\n          | some true => Complexity.LogProg.clAct i none (some none) 0 (Complexity.LogProg.clNext i)\n          | x =>\n            Complexity.LogProg.clAct i none none 1\n              (some (Complexity.LogProg.CleanSt.cl i Complexity.LogProg.CPh.back)) }"}
