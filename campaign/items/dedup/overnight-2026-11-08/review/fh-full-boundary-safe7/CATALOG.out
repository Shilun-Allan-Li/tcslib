G1 = s ∧\n                Complexity.LogProg.trackPos (Complexity.LogProg.callSegs cs x W) s T2 =\n                  Complexity.LogProg.trackPos (Complexity.LogProg.callSegs cs x W) s tp + ↑mv ∨\n              mv = 0 ∧\n                (G1 = s + 1 ∧ tp = Complexity.LogProg.TPos.right ∧ T2 = Complexity.LogProg.TPos.left ∨\n                  G1 + 1 = s ∧ tp = Complexity.LogProg.TPos.left ∧ T2 = Complexity.LogProg.TPos.right) →\n            ∀ (p : Fin (x.length + 2)),\n              ↑p = Complexity.LogProg.inPos cs x W s tp →\n                ↑(Turing.moveInputPos p (if s = 0 then mv else 0)) = Complexity.LogProg.inPos cs x W G1 T2"}
