 theorem SPACE_subset_NSPACE (s : ℕ → ℕ) : SPACE s ⊆ NSPACE s := by
-  sorry
+  classical
+  rintro L ⟨c, M, hM⟩
+  refine ⟨c, M.toFinNDTM, ?_⟩
+  intro x
+  obtain ⟨t, hcomp, hsp⟩ := hM x
