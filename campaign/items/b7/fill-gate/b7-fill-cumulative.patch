+private lemma mult_bad_decode (x : List Bool)
+    (bad : (pairDecode x).bind (fun p => pairDecode p.2) = none) : x ∉ multLang := by
+  rintro ⟨u, v, rfl⟩
+  simp only [pairDecode_pairEncode, Option.bind_some, reduceCtorEq] at bad
