+/-- Canonicality is decided from emptiness and the last bit, without storing the value. -/
+private lemma mult_canonical_last (w : List Bool) :
+    Canon w ↔ w.length = 0 ∨ w.getD (w.length - 1) false = true := by
+  by_cases hw : w = []
