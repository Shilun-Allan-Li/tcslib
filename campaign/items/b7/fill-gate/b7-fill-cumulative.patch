+    Finset.single_le_sum (f := fun j => (M.tm.visitedByTapeHead (M.tm.initCfg v) t j).card)
+      (fun j _ => Nat.zero_le _) (Finset.mem_univ r)
+  exact abs_le.mp (habs.le.trans (by exact_mod_cast hcard))
