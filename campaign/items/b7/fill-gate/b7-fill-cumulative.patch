+private lemma mult_acceptance (a b c : List Bool) :
+    pairEncode a (pairEncode b c) ∈ multLang ↔
+      Canon a ∧ Canon b ∧ Canon c ∧ c.length ≤ a.length + b.length ∧
+      multCarry a b (a.length + b.length) = 0 ∧
+      ∀ j < a.length + b.length,
