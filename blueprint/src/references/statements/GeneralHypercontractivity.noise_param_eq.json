 "title": "Noise-parameter identity",
 "statement": "Let $p, u \\in \\bbr$ with $u > 1$. Then\n\\[\n  \\Bigl(\\frac{u}{u-1} - 1\\Bigr)(p-1) \\;=\\; \\frac{p-1}{u-1}.\n\\]",
 "hypotheses_covered": [
  "$0 < u - 1$, i.e. $u > 1$ (so $u-1$ is a nonzero denominator)"
 ],
 "confidence": "high",
 "caveat": "",
 "rubric": [],
 "replaced": "If $u - 1 > 0$, then\n\\[\n  \\Bigl(\\frac{u}{u-1} - 1\\Bigr)(p-1) \\;=\\; \\frac{p-1}{u-1}.\n\\]"
}
