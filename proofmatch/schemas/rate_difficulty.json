{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["ratings"],
  "properties": {
    "ratings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lean_name", "difficulty", "reason"],
        "properties": {
          "lean_name": {"type": "string", "minLength": 1},
          "difficulty": {"type": "integer", "minimum": 0, "maximum": 7},
          "reason": {"type": "string", "minLength": 3, "maxLength": 400}
        }
      }
    }
  }
}
