{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["assignments"],
  "properties": {
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lean_name",
          "relation",
          "document_blocks",
          "rationale"
        ],
        "properties": {
          "lean_name": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "type": "string",
            "enum": ["direct", "context"]
          },
          "document_blocks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^pdf-[0-9a-f]{12}-p[0-9]{3}-b[0-9]{3}$"
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
