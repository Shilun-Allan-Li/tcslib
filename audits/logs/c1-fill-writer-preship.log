@Turing.ndWriterTM_run_block : ∀ {k : ℕ} (j : Fin k) {x : List Bool}
  (c : Turing.Cfg k Bool (Turing.NDWriterState Unit) x),
  c.state = some (Turing.NDWriterState.run ()) →
    ∀ (m : ℕ),
      (∀ p < m, c.workTapes j (c.workTapePos j + ↑p) ≠ none) →
        c.workTapes j (c.workTapePos j + ↑m) = none →
          ∀ (w : List Bool),
            w.length = m + 1 →
              Turing.NDTM.runWith w c =
                  { state := some Turing.NDWriterState.done, inputPos := c.inputPos,
                    workTapes :=
                      Function.update c.workTapes j fun p =>
                        if c.workTapePos j ≤ p ∧ p < c.workTapePos j + ↑m then
                          Turing.FinTM.bufferTape (List.take m w) (p - c.workTapePos j)
                        else c.workTapes j p,
                    workTapePos := Function.update c.workTapePos j (c.workTapePos j + ↑m), output := c.output } ∧
                ∀ (w' : List Bool),
                  w'.length < m + 1 → (Turing.NDTM.runWith w' c).state ≠ some Turing.NDWriterState.done
Turing.ndWriterTM : (k : ℕ) →
  Fin k → {Q : Type} → Q → (Q → Bool → Q) → (Q → Bool) → Bool → Turing.NDTM k Bool (Turing.NDWriterState Q)
Turing.NDWriterState : Type → Type
@Turing.guessRunTM_runWith_handoff : ∀ {k : ℕ} {SP SQ : Type} [inst : DecidableEq SP] [inst_1 : DecidableEq SQ]
  (P : Turing.MultiTapeTM k Bool SP) (pexit : SP) (j : Fin k) (Q : Turing.MultiTapeTM k Bool SQ) (qentry acc rej : SQ)
  {z : List Bool} (TP : ℕ) (cP : Turing.Cfg k Bool SP z),
  Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg z) TP = cP →
    cP.state = some pexit →
      (∀ u < TP, (Turing.MultiTapeTM.runFrom (Turing.MultiTapeTM.initCfg z) u).state ≠ some pexit) →
        ∀ (m : ℕ),
          (∀ p < m, cP.workTapes j (cP.workTapePos j + ↑p) ≠ none) →
            cP.workTapes j (cP.workTapePos j + ↑m) = none →
              cP.workTapes j (cP.workTapePos j - 1) = none →
                ∀ (w : List Bool),
                  w.length = TP + 2 * m + 9 →
                    Turing.NDTM.runWith w (Turing.NDTM.initCfg z) =
                      Turing.Cfg.mapState (Sigma.mk Turing.GuessRunPhase.run)
                        (Turing.guessRunCfg cP j (List.take m (List.drop (TP + 1) w)) qentry)
@Turing.NDTM.runWith_nil : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  {tm : Turing.NDTM k Symbol State} {cfg : Turing.Cfg k Symbol State input}, Turing.NDTM.runWith [] cfg = cfg
@Turing.NDTM.runWith_cons : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  {tm : Turing.NDTM k Symbol State} {b : Bool} {w : List Bool} {cfg : Turing.Cfg k Symbol State input},
  Turing.NDTM.runWith (b :: w) cfg = Turing.NDTM.runWith w (Turing.NDTM.stepWith b cfg)
@Turing.NDTM.runWith_append : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  {tm : Turing.NDTM k Symbol State} (w w' : List Bool) (cfg : Turing.Cfg k Symbol State input),
  Turing.NDTM.runWith (w ++ w') cfg = Turing.NDTM.runWith w' (Turing.NDTM.runWith w cfg)
@Turing.NDTM.stepWith_of_some : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  {tm : Turing.NDTM k Symbol State} {b : Bool} {cfg : Turing.Cfg k Symbol State input} {q : State},
  cfg.state = some q → Turing.NDTM.stepWith b cfg = (tm.tr b q cfg.inputSymbol cfg.workTapeSymbols).apply cfg
@Turing.NDTM.stepWith_of_halt : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  {tm : Turing.NDTM k Symbol State} {b : Bool} {cfg : Turing.Cfg k Symbol State input},
  cfg.state = none → Turing.NDTM.stepWith b cfg = cfg
@Turing.Action.apply_state : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  (action : Turing.Action k Symbol State) (cfg : Turing.Cfg k Symbol State input),
  (action.apply cfg).state = action.state
@Turing.Action.apply_inputPos : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  (action : Turing.Action k Symbol State) (cfg : Turing.Cfg k Symbol State input),
  (action.apply cfg).inputPos = Turing.moveInputPos cfg.inputPos action.inputTape
@Turing.Action.apply_workTapePos : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  (action : Turing.Action k Symbol State) (cfg : Turing.Cfg k Symbol State input) (i : Fin k),
  (action.apply cfg).workTapePos i = cfg.workTapePos i + ↑(action.workTapes i).2
@Turing.Action.apply_output : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  (action : Turing.Action k Symbol State) (cfg : Turing.Cfg k Symbol State input),
  (action.apply cfg).output = cfg.output ++ action.output.toList
@Turing.Action.apply_workTapes : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {input : List Symbol}
  (a : Turing.Action k Symbol State) (c : Turing.Cfg k Symbol State input) (i : Fin k),
  (a.apply c).workTapes i =
    Function.update (c.workTapes i) (c.workTapePos i) ((a.workTapes i).1.getD (c.workTapeSymbols i))
@Turing.Cfg.workTapeSymbols_eq : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  (cfg : Turing.Cfg k Symbol State input) (i : Fin k), cfg.workTapeSymbols i = cfg.workTapes i (cfg.workTapePos i)
@Turing.FinTM.bufferTape : {Symbol : Type u_1} → List Symbol → ℤ → Option Symbol
@Turing.FinTM.bufferTape_nil : ∀ {Symbol : Type u_1}, Turing.FinTM.bufferTape [] = fun x => none
@Turing.FinTM.bufferTape_nat : ∀ {Symbol : Type u_1} (w : List Symbol) (i : ℕ), Turing.FinTM.bufferTape w ↑i = w[i]?
@Turing.FinTM.bufferTape_left : ∀ {Symbol : Type u_1} (w : List Symbol), Turing.FinTM.bufferTape w (-1) = none
@Turing.FinTM.bufferTape_append : ∀ {Symbol : Type u_1} (w : List Symbol) (b : Symbol),
  Turing.FinTM.bufferTape (w ++ [b]) = Function.update (Turing.FinTM.bufferTape w) (↑w.length) (some b)

