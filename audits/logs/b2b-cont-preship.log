Meyer.ctrVal_lt : ∀ (w : List Bool), TimeHierarchy.ctrVal w < 2 ^ w.length
TimeHierarchy.ctrVal : List Bool → ℕ
exists_proj_decider : ∀ (C c : ℕ) (V : Language Bool) (Tv : ℕ → ℕ) (MV : FinTM Bool),
  MV.DecidesInTime V Tv →
    ∃ b E,
      E.DecidesInTime {x | ∃ u, u.length = C * (x.length + 1) ^ c ∧ x ++ u ∈ V} fun n =>
        b * 2 ^ (C * (n + 1) ^ c) * (Tv (n + C * (n + 1) ^ c) + (n + C * (n + 1) ^ c + 1) ^ (c + 1))
NP_subset_EXP : NP ⊆ EXP
FinTM.bufferedCompTM : FinTM Bool → FinTM Bool → FinTM Bool
FinTM.redirectTM : FinTM Bool → Bool → FinTM Bool
FinTM.exists_installCallTM : ∀ (M : FinTM Bool) (f : List Bool → List Bool) (T : ℕ → ℕ),
  M.ComputesFunInTime f T →
    ∃ C entry exit c,
      0 < C.k ∧
        ∀ (x arg : List Bool),
          ∃ t ≤ c * (T arg.length + arg.length + (f arg).length + 1),
            0 < t ∧
              (∀ (t' : ℕ),
                  0 < t' →
                    t' < t → (MultiTapeTM.runFrom (Cfg.ofWords entry (stateWord C.k arg)) t').state ≠ some exit) ∧
                MultiTapeTM.runFrom (Cfg.ofWords entry (stateWord C.k arg)) t = Cfg.ofWords exit (stateWord C.k (f arg))
FinTM.exists_loopTM_spaceUsed : ∀ (body F : FinTM Bool) (anchor : body.State) (Inv : List Bool → List Bool → Prop)
  (stepF : List Bool → List Bool → List Bool) (acceptF : List Bool → List Bool → Bool) (s0 : List Bool → List Bool)
  (R T S : ℕ → ℕ),
  F.ComputesFunInTime (fun x => (R x.length).bits) T →
    (∀ (x : List Bool), Inv x (s0 x)) →
      (∀ (x s : List Bool), Inv x s → Inv x (stepF x s)) →
        (∀ (x : List Bool),
            ∃ t ≤ T x.length,
              (∀ t' < t, (MultiTapeTM.runFrom (MultiTapeTM.initCfg x) t').state ≠ some anchor) ∧
                MultiTapeTM.runFrom (MultiTapeTM.initCfg x) t = Cfg.ofWords anchor (stateWord body.k (s0 x))) →
          (∀ (x s : List Bool),
              Inv x s →
                ∃ t,
                  0 < t ∧
                    t ≤ T x.length ∧
                      (∀ (t' : ℕ),
                          0 < t' →
                            t' < t →
                              (MultiTapeTM.runFrom (Cfg.ofWords anchor (stateWord body.k s)) t').state ≠ some anchor) ∧
                        if acceptF x s = true then
                          (MultiTapeTM.runFrom (Cfg.ofWords anchor (stateWord body.k s)) t).state = none ∧
                            (MultiTapeTM.runFrom (Cfg.ofWords anchor (stateWord body.k s)) t).output = [true]
                        else
                          MultiTapeTM.runFrom (Cfg.ofWords anchor (stateWord body.k s)) t =
                            Cfg.ofWords anchor (stateWord body.k (stepF x s))) →
            (∀ (x : List Bool) (t : ℕ), MultiTapeTM.spaceUsed (MultiTapeTM.initCfg x) t ≤ S x.length) →
              (∀ (x : List Bool), ∀ t ≤ T x.length, MultiTapeTM.spaceUsed (MultiTapeTM.initCfg x) t ≤ S x.length) →
                (∀ (x s : List Bool),
                    Inv x s →
                      ∀ t ≤ T x.length,
                        MultiTapeTM.spaceUsed (Cfg.ofWords anchor (stateWord body.k s)) t ≤ S x.length) →
                  ∃ E c,
                    (E.ComputesFunInTime
                        (fun x => [(List.range (R x.length + 1)).any fun i => acceptF x ((stepF x)^[i] (s0 x))])
                        fun n => c * (T n + 1) * (R n + 2)) ∧
                      ∀ (x : List Bool) (t : ℕ),
                        MultiTapeTM.spaceUsed (MultiTapeTM.initCfg x) t ≤ c * (S x.length + T x.length + 1)
universalInputPos : (α x : List Bool) → Fin (x.length + 2) → Fin ((pairEncode α x).length + 2)
@universalInput_read : ∀ {k : ℕ} {S : Type} (α : List Bool) {x : List Bool} (cfg : Cfg k Bool S x),
  (if FinTM.bufferTape [true] ↑↑cfg.inputPos = some true then none else (Turing.universalInputCfg✝ α cfg).inputSymbol) =
    cfg.inputSymbol
@universalInput_move : ∀ {k : ℕ} {S : Type} (α : List Bool) {x : List Bool} (cfg : Cfg k Bool S x) (d : SignType),
  have b := decide (FinTM.bufferTape [true] ↑↑cfg.inputPos ≠ some true);
  have m := FinTM.virtualMove b cfg.inputSymbol d;
  moveInputPos (universalInputPos α x cfg.inputPos) m = universalInputPos α x (moveInputPos cfg.inputPos d) ∧
    ↑↑cfg.inputPos + ↑m = ↑↑(moveInputPos cfg.inputPos d)
NP_eq_iUnion_NTIME : NP = ⋃ c, NTIME fun n => n ^ c + 1
PSPACE_eq_NPSPACE : PSPACE = NPSPACE
