  theorem exists_zoneRebalanceTM (k : ℕ) : ∃ C : ℕ, ∀ (dir : Bool) (t : Fin k), ∃ (S : Type) (_ : Fintype S) (_ : DecidableEq S) (M : MultiTapeTM 2 (ZoneSym k) S) (entry done short : S), done ≠ short ∧ ∀ x : List (ZoneSym k), ∃ R : Contract M entry {some done, some short} (ZoneData k) x, R.pre = zoneRowPre ∧ R.post = zoneRebalancePost dir t done short ∧ R.lo = zoneRowLo (zoneRebalanceIndex dir t) C ∧ R.hi = zoneRowHi (zoneRebalanceIndex dir t) C ∧ ∀ D d, d.state = some entry → R.pre D d → R.time D d ≤ C * (2 ^ zoneRebalanceIndex dir t D + 1)

exists_zoneExtendTM:
  theorem exists_zoneExtendTM (k : ℕ) : ∃ (C : ℕ) (S : Type) (_ : Fintype S) (_ : DecidableEq S) (M : MultiTapeTM 2 (ZoneSym k) S) (entry done : S), ∀ x : List (ZoneSym k), ∃ R : Contract M entry {some done} (ZoneData k) x, R.pre = zoneRowPre ∧ R.post = zoneExtendPost done ∧ R.lo = zoneRowLo (fun D => D.1) C ∧ R.hi = zoneRowHi (fun D => D.1) C ∧ ∀ D d, d.state = some entry → R.pre D d → R.time D d ≤ C * (2 ^ D.1 + 1)

