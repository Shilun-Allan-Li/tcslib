exists_adjacency_codec_cnf : ∀ (M : FinTM Bool),
  ∃ C,
    0 < C ∧
      ∀ (n s : ℕ),
        ∃ code φv φa φacc,
          (∀ (x : List Bool) (c : Cfg M.k Bool M.State x), (code x c).length = C * (s + n + 1)) ∧
            (∀ (x x' : List Bool),
                x.length = n →
                  x'.length = n →
                    ∀ (c : Cfg M.k Bool M.State x) (c' : Cfg M.k Bool M.State x'),
                      Cfg.InWindow s c → Cfg.InWindow s c' → code x c = code x' c' → x = x') ∧
              (∀ (x : List Bool),
                  x.length = n →
                    ∀ (c d : Cfg M.k Bool M.State x),
                      Cfg.InWindow s c → Cfg.InWindow s d → (code x c = code x d ↔ NDTM.coreSum c = NDTM.coreSum d)) ∧
                (∀ (w : List Bool),
                    w.length = C * (s + n + 1) →
                      (Std.Sat.CNF.eval (fun v => w.getD v false) φv = true ↔
                        ∃ x, x.length = n ∧ ∃ c, Cfg.InWindow s c ∧ w = code x c)) ∧
                  (∀ (x : List Bool),
                      x.length = n →
                        ∀ (c d : Cfg M.k Bool M.State x),
                          Cfg.InWindow s c →
                            Cfg.InWindow s d →
                              (Std.Sat.CNF.eval (fun v => (code x c ++ code x d).getD v false) φa = true ↔
                                NDTM.coreSum (MultiTapeTM.step c) = NDTM.coreSum d)) ∧
                    (∀ (x x' : List Bool),
                        x.length = n →
                          x'.length = n →
                            x ≠ x' →
                              ∀ (c : Cfg M.k Bool M.State x) (c' : Cfg M.k Bool M.State x'),
                                Cfg.InWindow s c →
                                  Cfg.InWindow s c' →
                                    Std.Sat.CNF.eval (fun v => (code x c ++ code x' c').getD v false) φa = false) ∧
                      (∀ (x : List Bool),
                          x.length = n →
                            ∀ (c : Cfg M.k Bool M.State x),
                              Cfg.InWindow s c →
                                (Std.Sat.CNF.eval (fun v => (code x c).getD v false) φacc = true ↔
                                  c.state = none ∧ outSummary c.output = OutSummary.accept)) ∧
                        φv.numVars ≤ C * (s + n + 1) ∧
                          φacc.numVars ≤ C * (s + n + 1) ∧
                            φa.numVars ≤ 2 * (C * (s + n + 1)) ∧
                              φv.serialize.length ≤ C * (s + n + 2) ^ C ∧
                                φa.serialize.length ≤ C * (s + n + 2) ^ C ∧ φacc.serialize.length ≤ C * (s + n + 2) ^ C
@MultiTapeTM.ConfigCount.coreCode_inj : ∀ {k : ℕ} {S : Type} {x : List Bool} (B : ℕ) {c d : Cfg k Bool S x},
  (∀ (i : Fin k), |c.workTapePos i| ≤ ↑B ∧ ∀ (z : ℤ), c.workTapes i z ≠ none → |z| ≤ ↑B) →
    (∀ (i : Fin k), |d.workTapePos i| ≤ ↑B ∧ ∀ (z : ℤ), d.workTapes i z ≠ none → |z| ≤ ↑B) →
      MultiTapeTM.ConfigCount.coreCode B c = MultiTapeTM.ConfigCount.coreCode B d →
        MultiTapeTM.ConfigCount.core c = MultiTapeTM.ConfigCount.core d
@NDTM.coreSum : {k : ℕ} →
  {S : Type} →
    {x : List Bool} →
      Cfg k Bool S x → (Option S × Fin (x.length + 2) × (Fin k → ℤ → Option Bool) × (Fin k → ℤ)) × OutSummary
@NDTM.coreSum_stepWith : ∀ {k : ℕ} {S : Type} {x : List Bool} (tm : NDTM k Bool S) (b : Bool) {c d : Cfg k Bool S x},
  NDTM.coreSum c = NDTM.coreSum d → NDTM.coreSum (NDTM.stepWith b c) = NDTM.coreSum (NDTM.stepWith b d)
outSummary : List Bool → OutSummary
exists_cnf_boolFun : ∀ (ℓ : ℕ) (f : (Fin ℓ → Bool) → Bool),
  ∃ φ,
    φ.numVars ≤ ℓ ∧ List.length φ ≤ 2 ^ ℓ ∧ φ.WidthAtMost ℓ ∧ ∀ (a : ℕ → Bool), Std.Sat.CNF.eval a φ = f fun i => a ↑i
Std.Sat.CNF.serialize : Std.Sat.CNF ℕ → List Bool
Std.Sat.CNF.serializeClause : Std.Sat.CNF.Clause ℕ → List Bool
@Cfg.InWindow : {k : ℕ} → {Symbol State : Type} → {x : List Symbol} → ℕ → Cfg k Symbol State x → Prop
