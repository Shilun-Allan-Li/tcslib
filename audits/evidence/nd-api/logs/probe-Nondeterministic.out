@Turing.NDTM.relabelState_q₀ : ∀ {k : ℕ} {Γ : Type u_1} {S : Type u_2} {S' : Type u_3} (tm : Turing.NDTM k Γ S)
  (e : S ≃ S'), (tm.relabelState e).q₀ = e tm.q₀
'Turing.NDTM.relabelState_q₀' depends on axioms: [Quot.sound]
@Turing.NDTM.relabelState_tr : ∀ {k : ℕ} {Γ : Type u_1} {S : Type u_2} {S' : Type u_3} (tm : Turing.NDTM k Γ S)
  (e : S ≃ S') (b : Bool) (q : S') (inp : Option Γ) (w : Fin k → Option Γ),
  (tm.relabelState e).tr b q inp w = Turing.Action.mapState (⇑e) (tm.tr b (e.symm q) inp w)
'Turing.NDTM.relabelState_tr' depends on axioms: [Quot.sound]
