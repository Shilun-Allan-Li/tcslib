@Turing.NDTM.stepWith_of_some : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {input : List Symbol}
  {tm : Turing.NDTM k Symbol State} {b : Bool} {cfg : Turing.Cfg k Symbol State input} {q : State},
  cfg.state = some q → Turing.NDTM.stepWith b cfg = (tm.tr b q cfg.inputSymbol cfg.workTapeSymbols).apply cfg
'Turing.NDTM.stepWith_of_some' depends on axioms: [propext, Quot.sound]
@Turing.NDTM.initCfg_eq : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {tm : Turing.NDTM k Symbol State}
  (input : List Symbol), Turing.NDTM.initCfg input = Turing.Cfg.init tm.q₀ input
'Turing.NDTM.initCfg_eq' depends on axioms: [propext]
@Turing.NDTM.haltsWithin_iff : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} {tm : Turing.NDTM k Symbol State}
  {input : List Symbol} {t : ℕ},
  tm.HaltsWithin input t ↔
    ∀ (w : List Bool), w.length = t → (Turing.NDTM.runWith w (Turing.NDTM.initCfg input)).state = none
'Turing.NDTM.haltsWithin_iff' depends on axioms: [propext, Quot.sound]
@Turing.NDTM.fixChoice_q₀ : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2} (tm : Turing.NDTM k Symbol State)
  (b : Bool), (tm.fixChoice b).q₀ = tm.q₀
