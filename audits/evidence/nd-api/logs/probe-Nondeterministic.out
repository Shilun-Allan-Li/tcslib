  (tm : Turing.MultiTapeTM k Symbol State), tm.toNDTM.q₀ = tm.q₀
'Turing.MultiTapeTM.toNDTM_q₀' does not depend on any axioms
@Turing.MultiTapeTM.toNDTM_tr : ∀ {k : ℕ} {State : Type u_1} {Symbol : Type u_2}
  (tm : Turing.MultiTapeTM k Symbol State) (x : Bool) (q : State) (input : Option Symbol)
  (work : Fin k → Option Symbol), tm.toNDTM.tr x q input work = tm.tr q input work
