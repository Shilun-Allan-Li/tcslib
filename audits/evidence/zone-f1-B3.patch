diff --git a/TCSlib/Complexity/TuringMachine/Codes2Tape.lean b/TCSlib/Complexity/TuringMachine/Codes2Tape.lean
index 18dacd5e..9792925b 100644
--- a/TCSlib/Complexity/TuringMachine/Codes2Tape.lean
+++ b/TCSlib/Complexity/TuringMachine/Codes2Tape.lean
@@ -7,6 +7,8 @@ import TCSlib.Complexity.TuringMachine.Encoding
 import TCSlib.Complexity.TuringMachine.NDCodes
 import TCSlib.Complexity.TuringMachine.MathlibBridge
 import Mathlib.Tactic.FinCases
+import TCSlib.Complexity.TuringMachine.Build.VirtualInput
