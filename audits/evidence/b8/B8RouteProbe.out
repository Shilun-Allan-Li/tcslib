Complexity.exists_not_timeConstructible : ∃ T, (∀ (n : ℕ), n ≤ T n) ∧ ¬Complexity.TimeConstructible T
Complexity.TimeConstructible : (ℕ → ℕ) → Prop
Complexity.Computable : (List Bool → List Bool) → Prop
Complexity.HALT : MachineCode → List Bool → Bool
Complexity.HALT_not_computable : ∀ (c : EffectiveMachineCode),
  ¬Complexity.Computable fun s => [Complexity.HALT c.toMachineCode s]
Complexity.UC_computable_of_HALT_computable : ∀ (c : EffectiveMachineCode),
  (Complexity.Computable fun s => [Complexity.HALT c.toMachineCode s]) →
    Complexity.Computable fun α => [Complexity.UC c.toMachineCode α]
Complexity.TimeHierarchy.code : EffectiveMachineCode
EffectiveMachineCode.toMachineCode : EffectiveMachineCode → MachineCode
@FinTM.Computes : {Symbol : Type} → FinTM Symbol → (List Symbol → List Symbol) → Prop
@FinTM.ComputesInTime : {Symbol : Type} → FinTM Symbol → List Symbol → List Symbol → ℕ → Prop
@FinTM.ComputesFunInTime : {Symbol : Type} → FinTM Symbol → (List Symbol → List Symbol) → (ℕ → ℕ) → Prop
@FinTM.ComputesFunInTime.computes : ∀ {Symbol : Type} {M : FinTM Symbol} {f : List Symbol → List Symbol} {T : ℕ → ℕ},
  M.ComputesFunInTime f T → M.Computes f
@FinTM.Computes.exists_computesInTime_iff : ∀ {Symbol : Type} {M : FinTM Symbol} {g : List Symbol → List Symbol},
  M.Computes g → ∀ (x w : List Symbol), (∃ t, M.ComputesInTime x w t) ↔ w = g x
@FinTM.ComputesInTime.output_unique : ∀ {Symbol : Type} {M : FinTM Symbol} {input w w' : List Symbol} {t t' : ℕ},
  M.ComputesInTime input w t → M.ComputesInTime input w' t' → w = w'
@FinTM.ComputesInTime.mono : ∀ {Symbol : Type} {M : FinTM Symbol} {input output : List Symbol} {t t' : ℕ},
  M.ComputesInTime input output t → t ≤ t' → M.ComputesInTime input output t'
@FinTM.computesInTime_iff : ∀ {Symbol : Type} (M : FinTM Symbol) (x w : List Symbol) (t : ℕ),
  M.ComputesInTime x w t ↔
    (MultiTapeTM.runFrom (MultiTapeTM.initCfg x) t).state = none ∧
      (MultiTapeTM.runFrom (MultiTapeTM.initCfg x) t).output = w
FinTM.exists_comp_partial : ∀ (M₁ M₂ : FinTM Bool),
  ∃ M,
    ∀ (x w : List Bool),
      (∃ t, M.ComputesInTime x w t) ↔ ∃ y, (∃ t, M₁.ComputesInTime x y t) ∧ ∃ t, M₂.ComputesInTime y w t
FinTM.exists_cond : ∀ (D M₁ M₂ : FinTM Bool) (p : List Bool → Bool),
  (D.Computes fun x => [p x]) →
    ∃ M, ∀ (x w : List Bool), (∃ t, M.ComputesInTime x w t) ↔ ∃ t, (bif p x then M₁ else M₂).ComputesInTime x w t
FinTM.computesFunInTime_ifEq : ∀ (w₀ u v : List Bool),
  ∃ M c, M.ComputesFunInTime (fun w => if w = w₀ then u else v) fun n => c * (n + 1)
FinTM.computesFunInTime_const : ∀ (w : List Bool), ∃ M c, M.ComputesFunInTime (fun x => w) fun n => c * (n + 1)
codePrim_machine : ∀ (f : List Bool → List Bool), Primrec f → ∃ M T, M.ComputesFunInTime f T
codeBitsNat : List Bool → ℕ
codeBitsNat_bits : ∀ (n : ℕ), codeBitsNat n.bits = n
codePrimBitsNat : Primrec codeBitsNat
codePrimBits : Primrec Nat.bits
codePrimPair : Primrec pairDecode
codePrimBit : Primrec₂ Nat.bit
Nat.bits_append_bit : ∀ (n : ℕ) (b : Bool), (n = 0 → b = true) → (Nat.bit b n).bits = b :: n.bits
Nat.one_bits : Nat.bits 1 = [true]
Nat.bodd_eq_bits_head : ∀ (n : ℕ), n.bodd = n.bits.headI
Nat.bodd_add : ∀ (m n : ℕ), (m + n).bodd = (m.bodd ^^ n.bodd)
Nat.bodd_succ : ∀ (n : ℕ), n.succ.bodd = !n.bodd
@List.dropLast_concat : ∀ {α : Type u_1} {l₁ : List α} {b : α}, (l₁ ++ [b]).dropLast = l₁
@Primrec.list_concat : ∀ {α : Type u_1} [inst : Primcodable α], Primrec₂ fun l a => l ++ [a]
Primrec.pred : Primrec Nat.pred
Primrec.nat_sub : Primrec₂ fun x1 x2 => x1 - x2
@Primrec.list_map : ∀ {α : Type u_1} {β : Type u_2} {σ : Type u_3} [inst : Primcodable α] [inst_1 : Primcodable β]
  [inst_2 : Primcodable σ] {f : α → List β} {g : α → β → σ},
  Primrec f → Primrec₂ g → Primrec fun a => List.map (g a) (f a)
Primrec.list_range : Primrec List.range
Primrec.nat_bodd : Primrec Nat.bodd
@Primrec.list_headI : ∀ {α : Type u_1} [inst : Primcodable α] [inst_1 : Inhabited α], Primrec List.headI
@Primrec.list_cons : ∀ {α : Type u_1} [inst : Primcodable α], Primrec₂ List.cons
@Primrec.const : ∀ {α : Type u_1} {σ : Type u_2} [inst : Primcodable α] [inst_1 : Primcodable σ] (x : σ),
  Primrec fun x_1 => x
Primrec.not : Primrec not
@Primrec.of_eq : ∀ {α : Type u_1} {σ : Type u_2} [inst : Primcodable α] [inst_1 : Primcodable σ] {f g : α → σ},
  Primrec f → (∀ (n : α), f n = g n) → Primrec g
@Primrec.comp : ∀ {α : Type u_1} {β : Type u_2} {σ : Type u_3} [inst : Primcodable α] [inst_1 : Primcodable β]
  [inst_2 : Primcodable σ] {f : β → σ} {g : α → β}, Primrec f → Primrec g → Primrec fun a => f (g a)
@FinTM.computesFunInTime_comp : ∀ {M₁ M₂ : FinTM Bool} {f g : List Bool → List Bool} {T₁ T₂ : ℕ → ℕ},
  M₁.ComputesFunInTime f T₁ →
    M₂.ComputesFunInTime g T₂ → Monotone T₂ → ∃ M c, M.ComputesFunInTime (g ∘ f) fun n => c * (T₁ n + T₂ (T₁ n) + 1)
FinTM.computesFunInTime_id : ∃ M c, M.ComputesFunInTime id fun n => c * (n + 1)
FinTM.exists_comp_on_image : ∀ (M U : FinTM Bool) (f g : List Bool → List Bool) (T₁ T₂ : ℕ → ℕ),
  M.ComputesFunInTime f T₁ →
    (∀ (x : List Bool), U.ComputesInTime (f x) (g x) (T₂ x.length)) →
      ∃ N, N.ComputesFunInTime g fun n => 2 * T₁ n + T₂ n + 2
Complexity.TimeHierarchy.ctrVal : List Bool → ℕ
Complexity.TimeHierarchy.ctrVal_bits : ∀ (n : ℕ), Complexity.TimeHierarchy.ctrVal n.bits = n
Complexity.timeConstructible_id : Complexity.TimeConstructible id
'F6Probe.route_check' depends on axioms: [propext, Classical.choice, Quot.sound]
