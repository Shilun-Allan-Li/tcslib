+    Cfg (1 + (1 + M.k)) Bool (a2_MapState M.State) x where
+  state := q
+  inputPos := p
+  workTapes := tapeBlocks (fun _ => bufferTape a) (bufferTape b) (fun _ _ => none)
+  workTapePos := tapeBlocks (fun _ => ha) hb (fun _ => 0)
+  output := out
