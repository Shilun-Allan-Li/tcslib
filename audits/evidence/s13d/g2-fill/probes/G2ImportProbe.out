@copyMapTM : {Symbol : Type u_1} →
  {Δ : Type u_2} →
    (k : ℕ) → Fin k → Fin k → (Symbol → Δ) → (Option Symbol → Δ → Symbol) → MultiTapeTM k Symbol SweepPhase
@transferMapTM : {Symbol : Type u_1} →
  {Δ : Type u_2} →
    (k : ℕ) →
      Fin k →
        Fin k → (Symbol → Δ) → (Option Symbol → Δ → Symbol) → (Symbol → Option Symbol) → MultiTapeTM k Symbol SweepPhase
@copyTM : {Symbol : Type u_1} → (k : ℕ) → Fin k → Fin k → MultiTapeTM k Symbol SweepPhase
@transferTM : {Symbol : Type u_1} → (k : ℕ) → Fin k → Fin k → MultiTapeTM k Symbol SweepPhase
@copyMapTM_plain : ∀ {Symbol : Type u_1} (k : ℕ) (src dst : Fin k),
  (copyMapTM k src dst id fun x s => s) = copyTM k src dst
@transferMapTM_plain : ∀ {Symbol : Type u_1} (k : ℕ) (src dst : Fin k),
  (transferMapTM k src dst id (fun x s => s) fun x => none) = transferTM k src dst
@catalogTrace : {k : ℕ} →
  {Symbol : Type u_1} →
    {x : List Symbol} →
      {S : Type u_2} → (ℕ → Cfg k Symbol S x) → (ℕ → Cfg k Symbol S x) → Cfg k Symbol S x → ℕ → ℕ → Cfg k Symbol S x
@catalog_trace_run : ∀ {k : ℕ} {Symbol : Type u_1} {x : List Symbol} {S : Type u_2} (M : MultiTapeTM k Symbol S)
  (F R : ℕ → Cfg k Symbol S x) (D : Cfg k Symbol S x) (L : ℕ),
  (∀ r < L, MultiTapeTM.step (F r) = F (r + 1)) →
    MultiTapeTM.step (F L) = R L →
      (∀ r < L, MultiTapeTM.step (R (r + 1)) = R r) →
        MultiTapeTM.step (R 0) = D →
          MultiTapeTM.step D = D → ∀ (t : ℕ), MultiTapeTM.runFrom (F 0) t = catalogTrace F R D L t
@catalog_write_take : ∀ {Symbol : Type u_1} (f : ℤ → Option Symbol) (a : ℤ) (w : List Symbol) (r : ℕ)
  (hr : r < w.length),
  Function.update (fun q => if a ≤ q ∧ q < a + ↑r then FinTM.bufferTape w (q - a) else f q) (a + ↑r) (some w[r]) =
    fun q => if a ≤ q ∧ q < a + ↑(r + 1) then FinTM.bufferTape w (q - a) else f q
@copyTM_run_ofCfg : ∀ {Symbol : Type u_1} {k : ℕ} {x : List Symbol} (src dst : Fin k),
  src ≠ dst →
    ∀ (w : List Symbol) (d : Cfg k Symbol SweepPhase x),
      d.state = some SweepPhase.sweep →
        (∀ (p : ℤ), -1 ≤ p → p ≤ ↑w.length → d.workTapes src (d.workTapePos src + p) = FinTM.bufferTape w p) →
          MultiTapeTM.runFrom d (2 * w.length + 2) =
              { state := some SweepPhase.done, inputPos := d.inputPos,
                workTapes := fun j q =>
                  if j = dst ∧ d.workTapePos j ≤ q ∧ q < d.workTapePos j + ↑w.length then
                    FinTM.bufferTape w (q - d.workTapePos j)
                  else d.workTapes j q,
                workTapePos := d.workTapePos, output := d.output } ∧
            (∀ t < 2 * w.length + 2, (MultiTapeTM.runFrom d t).state ≠ some SweepPhase.done) ∧
              ∀ (j : Fin k),
                ∀ t ≤ 2 * w.length + 2,
                  if j = src ∨ j = dst then
                    (MultiTapeTM.runFrom d t).workTapePos j ∈
                      Finset.Icc (d.workTapePos j - 1) (d.workTapePos j + ↑w.length)
                  else (MultiTapeTM.runFrom d t).workTapePos j = d.workTapePos j
@transferTM_run_ofCfg : ∀ {Symbol : Type u_1} {k : ℕ} {x : List Symbol} (src dst : Fin k),
  src ≠ dst →
    ∀ (w : List Symbol) (d : Cfg k Symbol SweepPhase x),
      d.state = some SweepPhase.sweep →
        (∀ (p : ℤ), -1 ≤ p → p ≤ ↑w.length → d.workTapes src (d.workTapePos src + p) = FinTM.bufferTape w p) →
          MultiTapeTM.runFrom d (2 * w.length + 2) =
              { state := some SweepPhase.done, inputPos := d.inputPos,
                workTapes := fun j q =>
                  if j = src ∧ d.workTapePos j ≤ q ∧ q < d.workTapePos j + ↑w.length then none
                  else
                    if j = dst ∧ d.workTapePos j ≤ q ∧ q < d.workTapePos j + ↑w.length then
                      FinTM.bufferTape w (q - d.workTapePos j)
                    else d.workTapes j q,
                workTapePos := d.workTapePos, output := d.output } ∧
            (∀ t < 2 * w.length + 2, (MultiTapeTM.runFrom d t).state ≠ some SweepPhase.done) ∧
              ∀ (j : Fin k),
                ∀ t ≤ 2 * w.length + 2,
                  if j = src ∨ j = dst then
                    (MultiTapeTM.runFrom d t).workTapePos j ∈
                      Finset.Icc (d.workTapePos j - 1) (d.workTapePos j + ↑w.length)
                  else (MultiTapeTM.runFrom d t).workTapePos j = d.workTapePos j
@copyMapTM_run_ofCfg : ∀ {Symbol : Type u_1} {Δ : Type u_2} {k : ℕ} {x : List Symbol} (src dst : Fin k),
  src ≠ dst →
    ∀ (extract : Symbol → Δ) (merge : Option Symbol → Δ → Symbol) (w : List Symbol) (d : Cfg k Symbol SweepPhase x),
      d.state = some SweepPhase.sweep →
        (∀ (p : ℤ), -1 ≤ p → p ≤ ↑w.length → d.workTapes src (d.workTapePos src + p) = FinTM.bufferTape w p) →
          MultiTapeTM.runFrom d (2 * w.length + 2) =
              { state := some SweepPhase.done, inputPos := d.inputPos,
                workTapes := fun j q =>
                  if j = dst ∧ d.workTapePos j ≤ q ∧ q < d.workTapePos j + ↑w.length then
                    Option.map (fun γ => merge (d.workTapes j q) (extract γ)) (FinTM.bufferTape w (q - d.workTapePos j))
                  else d.workTapes j q,
                workTapePos := d.workTapePos, output := d.output } ∧
            (∀ t < 2 * w.length + 2, (MultiTapeTM.runFrom d t).state ≠ some SweepPhase.done) ∧
              ∀ (j : Fin k),
                ∀ t ≤ 2 * w.length + 2,
                  if j = src ∨ j = dst then
                    (MultiTapeTM.runFrom d t).workTapePos j ∈
                      Finset.Icc (d.workTapePos j - 1) (d.workTapePos j + ↑w.length)
                  else (MultiTapeTM.runFrom d t).workTapePos j = d.workTapePos j
@transferMapTM_run_ofCfg : ∀ {Symbol : Type u_1} {Δ : Type u_2} {k : ℕ} {x : List Symbol} (src dst : Fin k),
  src ≠ dst →
    ∀ (extract : Symbol → Δ) (merge : Option Symbol → Δ → Symbol) (rest : Symbol → Option Symbol) (w : List Symbol)
      (d : Cfg k Symbol SweepPhase x),
      d.state = some SweepPhase.sweep →
        (∀ (p : ℤ), -1 ≤ p → p ≤ ↑w.length → d.workTapes src (d.workTapePos src + p) = FinTM.bufferTape w p) →
          MultiTapeTM.runFrom d (2 * w.length + 2) =
              { state := some SweepPhase.done, inputPos := d.inputPos,
                workTapes := fun j q =>
                  if j = src ∧ d.workTapePos j ≤ q ∧ q < d.workTapePos j + ↑w.length then
                    (FinTM.bufferTape w (q - d.workTapePos j)).bind rest
                  else
                    if j = dst ∧ d.workTapePos j ≤ q ∧ q < d.workTapePos j + ↑w.length then
                      Option.map (fun γ => merge (d.workTapes j q) (extract γ))
                        (FinTM.bufferTape w (q - d.workTapePos j))
                    else d.workTapes j q,
                workTapePos := d.workTapePos, output := d.output } ∧
            (∀ t < 2 * w.length + 2, (MultiTapeTM.runFrom d t).state ≠ some SweepPhase.done) ∧
              ∀ (j : Fin k),
                ∀ t ≤ 2 * w.length + 2,
                  if j = src ∨ j = dst then
                    (MultiTapeTM.runFrom d t).workTapePos j ∈
                      Finset.Icc (d.workTapePos j - 1) (d.workTapePos j + ↑w.length)
                  else (MultiTapeTM.runFrom d t).workTapePos j = d.workTapePos j
@copyTM_spaceUsedByTape : ∀ {x : List Bool} (k : ℕ) (src dst : Fin k),
  src ≠ dst →
    ∀ (w : Fin k → List Bool),
      w dst = [] →
        ∀ (t : ℕ),
          MultiTapeTM.spaceUsedByTape (Cfg.ofWords SweepPhase.sweep w) t src ≤ (w src).length + 2 ∧
            MultiTapeTM.spaceUsedByTape (Cfg.ofWords SweepPhase.sweep w) t dst ≤ (w src).length + 2 ∧
              ∀ (j : Fin k), j ≠ src → j ≠ dst → MultiTapeTM.spaceUsedByTape (Cfg.ofWords SweepPhase.sweep w) t j = 1
@transferTM_spaceUsedByTape : ∀ {x : List Bool} (k : ℕ) (src dst : Fin k),
  src ≠ dst →
    ∀ (w : Fin k → List Bool),
      w dst = [] →
        ∀ (t : ℕ),
          MultiTapeTM.spaceUsedByTape (Cfg.ofWords SweepPhase.sweep w) t src ≤ (w src).length + 2 ∧
            MultiTapeTM.spaceUsedByTape (Cfg.ofWords SweepPhase.sweep w) t dst ≤ (w src).length + 2 ∧
              ∀ (j : Fin k), j ≠ src → j ≠ dst → MultiTapeTM.spaceUsedByTape (Cfg.ofWords SweepPhase.sweep w) t j = 1
@copyTM_run : ∀ {x : List Bool} (k : ℕ) (src dst : Fin k),
  src ≠ dst →
    ∀ (w : Fin k → List Bool),
      w dst = [] →
        ∃ T ≤ 3 * (w src).length + 3,
          (∀ t < T, (MultiTapeTM.runFrom (Cfg.ofWords SweepPhase.sweep w) t).state ≠ some SweepPhase.done) ∧
            MultiTapeTM.runFrom (Cfg.ofWords SweepPhase.sweep w) T =
              Cfg.ofWords SweepPhase.done (Function.update w dst (w src))
@transferTM_run : ∀ {x : List Bool} (k : ℕ) (src dst : Fin k),
  src ≠ dst →
    ∀ (w : Fin k → List Bool),
      w dst = [] →
        ∃ T ≤ 3 * (w src).length + 3,
          (∀ t < T, (MultiTapeTM.runFrom (Cfg.ofWords SweepPhase.sweep w) t).state ≠ some SweepPhase.done) ∧
            MultiTapeTM.runFrom (Cfg.ofWords SweepPhase.sweep w) T =
              Cfg.ofWords SweepPhase.done (Function.update (Function.update w src []) dst (w src))
@Cfg.ofWords_copy_endpoint : ∀ {k : ℕ} {S : Type u_1} {x : List Bool} (q q' : S) (w : Fin k → List Bool)
  (src dst : Fin k),
  w dst = [] →
    (have __src := Cfg.ofWords q w;
      { state := some q', inputPos := __src.inputPos,
        workTapes := fun j p =>
          if j = dst ∧ (Cfg.ofWords q w).workTapePos j ≤ p ∧ p < (Cfg.ofWords q w).workTapePos j + ↑(w src).length then
            FinTM.bufferTape (w src) (p - (Cfg.ofWords q w).workTapePos j)
          else (Cfg.ofWords q w).workTapes j p,
        workTapePos := __src.workTapePos, output := __src.output }) =
      Cfg.ofWords q' (Function.update w dst (w src))
@Cfg.ofWords_transfer_endpoint : ∀ {k : ℕ} {S : Type u_1} {x : List Bool} (q q' : S) (w : Fin k → List Bool)
  (src dst : Fin k),
  src ≠ dst →
    w dst = [] →
      (have __src := Cfg.ofWords q w;
        { state := some q', inputPos := __src.inputPos,
          workTapes := fun j p =>
            if
                j = src ∧
                  (Cfg.ofWords q w).workTapePos j ≤ p ∧ p < (Cfg.ofWords q w).workTapePos j + ↑(w src).length then
              none
            else
              if
                  j = dst ∧
                    (Cfg.ofWords q w).workTapePos j ≤ p ∧ p < (Cfg.ofWords q w).workTapePos j + ↑(w src).length then
                FinTM.bufferTape (w src) (p - (Cfg.ofWords q w).workTapePos j)
              else (Cfg.ofWords q w).workTapes j p,
          workTapePos := __src.workTapePos, output := __src.output }) =
        Cfg.ofWords q' (Function.update (Function.update w src []) dst (w src))
SweepPhase.sweep : SweepPhase
@Cfg.ext : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {input : List Symbol} {x y : Cfg k Symbol State input},
  x.state = y.state →
    x.inputPos = y.inputPos → x.workTapes = y.workTapes → x.workTapePos = y.workTapePos → x.output = y.output → x = y
@Cfg.ofWords : {k : ℕ} → {State : Type u_1} → {input : List Bool} → State → (Fin k → List Bool) → Cfg k Bool State input
@Cfg.workTapeSymbols : {k : ℕ} →
  {State : Type u_1} → {Symbol : Type u_2} → {input : List Symbol} → Cfg k Symbol State input → Fin k → Option Symbol
@MultiTapeTM.step : {k : ℕ} →
  {State : Type u_1} →
    {Symbol : Type u_2} →
      {input : List Symbol} → {tm : MultiTapeTM k Symbol State} → Cfg k Symbol State input → Cfg k Symbol State input
@MultiTapeTM.runFrom : {k : ℕ} →
  {State : Type u_1} →
    {Symbol : Type u_2} →
      {input : List Symbol} →
        {tm : MultiTapeTM k Symbol State} → Cfg k Symbol State input → ℕ → Cfg k Symbol State input
@MultiTapeTM.spaceUsedByTape : {k : ℕ} →
  {State : Type u_1} →
    {Symbol : Type u_2} →
      {input : List Symbol} → {tm : MultiTapeTM k Symbol State} → Cfg k Symbol State input → ℕ → Fin k → ℕ
@Action.apply : {k : ℕ} →
  {State : Type u_1} →
    {Symbol : Type u_2} →
      {input : List Symbol} → Action k Symbol State → Cfg k Symbol State input → Cfg k Symbol State input
@FinTM.bufferTape : {Symbol : Type u_1} → List Symbol → ℤ → Option Symbol
@FinTM.bufferTape_nil : ∀ {Symbol : Type u_1}, FinTM.bufferTape [] = fun x => none
ZoneContents : ℕ → Type
zoneCapacity : ℕ → ℕ
@zoneSide : {ℓ : ℕ} → (Fin ℓ → List (Option Bool)) → List (Option Bool)
@zoneShiftIn : {ℓ : ℕ} → Bool → ℕ → ZoneContents ℓ → ZoneContents ℓ
@zoneShiftOut : {ℓ : ℕ} → Bool → ℕ → ZoneContents ℓ → ZoneContents ℓ
@zoneShiftInW : {ℓ : ℕ} → ℕ → (Fin ℓ → List (Option Bool)) → Fin ℓ → List (Option Bool)
@zoneSide_shiftInW : ∀ {ℓ : ℕ} (i : ℕ) (w : Fin ℓ → List (Option Bool)), zoneSide (zoneShiftInW i w) = zoneSide w
@zoneSide_shiftOutW : ∀ {ℓ : ℕ} (i : ℕ) (w : Fin ℓ → List (Option Bool)), zoneSide (zoneShiftOutW i w) = zoneSide w
@zoneMove : {ℓ : ℕ} → Bool → ZoneContents ℓ → ZoneContents ℓ
@zoneMoveRight : {ℓ : ℕ} →
  (hℓ : 0 < ℓ) → (z : ZoneContents ℓ) → (z.left ⟨0, hℓ⟩).length + 1 ≤ zoneCapacity 0 → ZoneContents ℓ
@zoneSide_moveRight : ∀ {ℓ : ℕ} (hℓ : 0 < ℓ) (z : ZoneContents ℓ)
  (hroom : (z.left ⟨0, hℓ⟩).length + 1 ≤ zoneCapacity 0),
  z.right ⟨0, hℓ⟩ ≠ [] →
    zoneSide (zoneMoveRight hℓ z hroom).left = z.home :: zoneSide z.left ∧
      zoneSide (zoneMoveRight hℓ z hroom).right = (zoneSide z.right).tail
@zoneStepPair : {ℓ : ℕ} → ℕ → ZoneContents ℓ → ZoneContents ℓ
@zoneCascadeRight : {ℓ : ℕ} → ℕ → ZoneContents ℓ → ZoneContents ℓ
@zoneCascadeRight_frame : ∀ {ℓ : ℕ} (j : ℕ) (z : ZoneContents ℓ) (k : Fin ℓ),
  j < ↑k → (zoneCascadeRight j z).left k = z.left k ∧ (zoneCascadeRight j z).right k = z.right k
@zoneSide_cascadeRight : ∀ {ℓ : ℕ} (j : ℕ) (hj : j < ℓ) (z : ZoneContents ℓ),
  (∀ (k : ℕ) (hk : k < j), z.right ⟨k, ⋯⟩ = []) →
    (∀ (k : ℕ) (hk : k < j), (z.left ⟨k, ⋯⟩).length = zoneCapacity k) →
      z.right ⟨j, hj⟩ ≠ [] →
        (z.left ⟨j, hj⟩).length + 2 ^ (j - 1) ≤ zoneCapacity j →
          zoneSide (zoneCascadeRight j z).left = z.home :: zoneSide z.left ∧
            zoneSide (zoneCascadeRight j z).right = (zoneSide z.right).tail
@zoneCascadeRight_home : ∀ {ℓ : ℕ} (j : ℕ) (hj : j < ℓ) (z : ZoneContents ℓ),
  (∀ (k : ℕ) (hk : k < j), z.right ⟨k, ⋯⟩ = []) →
    (∀ (k : ℕ) (hk : k < j), (z.left ⟨k, ⋯⟩).length = zoneCapacity k) →
      z.right ⟨j, hj⟩ ≠ [] →
        (z.left ⟨j, hj⟩).length + 2 ^ (j - 1) ≤ zoneCapacity j → (zoneCascadeRight j z).home = (zoneSide z.right).headI
@zoneTrackTape_cascadeRight : ∀ {ℓ : ℕ} (j : ℕ) (hj : j < ℓ) (z : ZoneContents ℓ),
  (∀ (k : ℕ) (hk : k < j), z.right ⟨k, ⋯⟩ = []) →
    (∀ (k : ℕ) (hk : k < j), (z.left ⟨k, ⋯⟩).length = zoneCapacity k) →
      z.right ⟨j, hj⟩ ≠ [] →
        (z.left ⟨j, hj⟩).length + 2 ^ (j - 1) ≤ zoneCapacity j →
          ∀ (p : ℤ), zoneTrackTape (zoneCascadeRight j z) p = zoneTrackTape z (p + 1)
@List.headI : {α : Type u_1} → [Inhabited α] → List α → α
@List.exists_cons_of_ne_nil : ∀ {α : Type u_1} {l : List α}, l ≠ [] → ∃ b l', l = b :: l'
@List.getElem?_eq_getElem : ∀ {α : Type u_1} {l : List α} {i : ℕ} (h : i < l.length), l[i]? = some l[i]
@Function.update_apply : ∀ {α : Sort u_1} [inst : DecidableEq α] {β : Sort u_2} (f : α → β) (a' : α) (b : β) (a : α),
  Function.update f a' b a = if a = a' then b else f a
@Option.map_id' : ∀ {α : Type u_1} {x : Option α}, Option.map (fun a => a) x = x
@Finset.mem_Icc : ∀ {α : Type u_1} [inst : Preorder α] [inst_1 : LocallyFiniteOrder α] {a b x : α},
  x ∈ Finset.Icc a b ↔ a ≤ x ∧ x ≤ b
