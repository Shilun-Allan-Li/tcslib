/-! ════════════════════════════════════════════════════════════════════════════════════════════
# Fit probe (evidence only; not landing material)

From the two G4 rows **taken as given** (`Turing.exists_zoneRebalanceTM`,
`Turing.exists_zoneExtendTM`), derive what the Hennie–Stearns assembly G5 needs of one simulated
step: a per-track rebalance that extends the layout when the feeding side is exhausted, built
with the landed compositions `Turing.Contract.branch` and `Turing.Contract.seq`, whose
endpoint chains into the next track's precondition and whose time is `O(2^{i₀} + 1)`; and the
amortized sum over a run, `O(T log T)`. G5-internal facts enter as **hypotheses**, listed in the
pack (no `sorry` here): the zero-time stop continuation is defined below; the classical count
bound and the level bound are hypotheses of the last two theorems. -/

namespace Turing.G24Fit

open Turing

/-- G5 glue: the zero-time contract of a machine started in a state that is its own exit. -/
def stopContract {k : ℕ} {Γ S : Type} (M : MultiTapeTM k Γ S) (e : S) (ι : Type)
    (x : List Γ) : Contract M e {some e} ι x where
  pre _ _ := True
  time _ _ := 0
  post _ d := d
  lo _ d := d.workTapePos
  hi _ d := d.workTapePos
  run _ d _ _ := MultiTapeTM.runFrom_zero
  exit_mem _ d hd _ := by rw [hd]; rfl
  cut _ _ _ _ u hu := absurd hu (Nat.not_lt_zero u)
  env _ d _ _ u hu j := by
    obtain rfl : u = 0 := by omega
    rw [MultiTapeTM.runFrom_zero]
    exact Finset.mem_Icc.mpr ⟨le_rfl, le_rfl⟩

/-- The data after one track's step: the rebalance when its scanned index is below `ℓ`, else
the extension followed by the rebalance of the extended data. -/
def zoneTrackStepData {k : ℕ} (dir : Bool) (t : Fin k) (D : ZoneData k) : ZoneData k :=
  if zoneRebalanceIndex dir t D < D.1 then zoneRebalanceData dir t D
  else zoneRebalanceData dir t (zoneExtendData D)

/-- **The per-track step, composed from the G4 contracts** (the fit): run the rebalance row
for `(dir, t)`; on `done` stop; on `short` run the extension and then the rebalance row again.
The result is a contract (built by `Turing.Contract.branch` and `Turing.Contract.seq` from the
landed MIG-0b library) whose endpoint satisfies the row precondition at the new data and whose
time is at most `(2C + C' + 2) · (2^{i₀} + 1)` for the scanned index `i₀`. -/
theorem trackStep_fit (k : ℕ) (dir : Bool) (t : Fin k) :
    ∃ (A : ℕ) (S : Type) (_ : DecidableEq S) (M : MultiTapeTM 2 (ZoneSym k) S) (entry : S)
      (X : Set (Option S)), ∀ x : List (ZoneSym k),
      ∃ R : Contract M entry X (ZoneData k) x,
        (∀ D d, d.state = some entry → (R.pre D d ↔ zoneRowPre D d)) ∧
        (∀ D d, d.state = some entry → zoneRowPre D d →
          R.time D d ≤ A * (2 ^ zoneRebalanceIndex dir t D + 1)) ∧
        (∀ D d, d.state = some entry → zoneRowPre D d →
          zoneRowPre (zoneTrackStepData dir t D) (R.post D d)) := by
  obtain ⟨C, hC⟩ := exists_zoneRebalanceTM k
  obtain ⟨S, _, _, M, entry, done, short, hds, hR⟩ := hC dir t
  obtain ⟨C', S', _, _, M', e', d', hE⟩ := exists_zoneExtendTM k
  refine ⟨2 * C + C' + 2, _, inferInstance, seamCompTM₂ M done short M done
    (seamCompTM M' d' M entry) (Sum.inl e'), Sum.inl (Sum.inl entry),
    (Option.map (Sum.inl ∘ Sum.inr) '' {some done}) ∪
      (Option.map Sum.inr '' (Option.map Sum.inr '' {some done, some short})), fun x => ?_⟩
  obtain ⟨R, hpre, hpost, -, -, htime⟩ := hR x
  obtain ⟨E, hEpre, hEpost, -, -, hEtime⟩ := hE x
  -- the retry: the extension, a seam, the rebalance row again at the extended data
  have hlink : ∀ D d, d.state = some e' → E.pre D d →
      R.pre (zoneExtendData D) ((E.post D d).mapState fun _ => entry) := by
    intro D d _ hp
    rw [hpre]
    rw [hEpost]
    exact zoneRowPre_extendPost d' D d (by rw [← hEpre]; exact hp) _
  let retry := Contract.seq E R zoneExtendData hlink
  let stop := stopContract M done (ZoneData k) x
  have h₁ : ∀ D d, d.state = some entry → R.pre D d → (R.post D d).state = some done →
      stop.pre (id D) ((R.post D d).mapState fun _ => done) := fun _ _ _ _ _ => trivial
  have h₂ : ∀ D d, d.state = some entry → R.pre D d → (R.post D d).state = some short →
      retry.pre (zoneRebalanceData dir t D) ((R.post D d).mapState fun _ => Sum.inl e') := by
    intro D d _ hp _
    show E.pre _ (((R.post D d).mapState fun _ => Sum.inl e').mapState fun _ => e')
    rw [hEpre, hpost]
    rw [hpre] at hp
    exact ⟨rfl, hp.2.1, hp.2.2⟩
  refine ⟨Contract.branch hds R stop retry id (zoneRebalanceData dir t) h₁ h₂, ?_, ?_, ?_⟩
  · intro D d _
    show R.pre D (d.mapState fun _ => entry) ↔ _
    rw [hpre]
    exact ⟨fun h => h, fun h => h⟩
  · intro D d hd hp
    have hd₀ : (d.mapState fun _ => entry).state = some entry := by simp [Cfg.mapState, hd]
    have hp₀ : R.pre D (d.mapState fun _ => entry) := by rw [hpre]; exact hp
    have ht₀ := htime D _ hd₀ hp₀
    show R.time D (d.mapState fun _ => entry) + 1 +
      (if (R.post D (d.mapState fun _ => entry)).state = some done then
        stop.time (id D) ((R.post D (d.mapState fun _ => entry)).mapState fun _ => done)
      else retry.time (zoneRebalanceData dir t D)
        ((R.post D (d.mapState fun _ => entry)).mapState fun _ => Sum.inl e')) ≤ _
    split_ifs with hdone
    · show R.time D _ + 1 + 0 ≤ _
      nlinarith [Nat.one_le_two_pow (n := zoneRebalanceIndex dir t D)]
    · -- the short path: the scanned index is `ℓ`, and the retry scans to `ℓ` again
      have hshort : ¬ zoneRebalanceIndex dir t D < D.1 := by
        intro h
        apply hdone
        rw [hpost]
        exact (zoneRebalancePost_state_done dir t hds D _).mpr h
      have hidx : zoneRebalanceIndex dir t D = D.1 := by
        have := zoneShiftIndex_le dir (D.2 t)
        unfold zoneRebalanceIndex at hshort ⊢
        omega
      have hD : zoneRebalanceData dir t D = D := zoneRebalanceData_of_short dir t D hshort
      have hc₁ : (((R.post D (d.mapState fun _ => entry)).mapState
          fun _ => (Sum.inl e' : S' ⊕ S)).mapState fun _ => e').state = some e' := by
        rw [hpost]
        simp [Cfg.mapState, zoneRebalancePost]
      have hpc₁ : E.pre (zoneRebalanceData dir t D)
          (((R.post D (d.mapState fun _ => entry)).mapState
              fun _ => (Sum.inl e' : S' ⊕ S)).mapState
            fun _ => e') := by
        rw [hEpre, hpost]
        exact ⟨rfl, hp.2.1, hp.2.2⟩
      have htE := hEtime _ _ hc₁ hpc₁
      have hc₂ : ((E.post (zoneRebalanceData dir t D)
          (((R.post D (d.mapState fun _ => entry)).mapState
              fun _ => (Sum.inl e' : S' ⊕ S)).mapState
            fun _ => e')).mapState fun _ => entry).state = some entry := by
        rw [hEpost]
        simp [Cfg.mapState, zoneExtendPost]
      have hpc₂ := hlink _ _ hc₁ hpc₁
      have hl : (zoneRebalanceData dir t D).1 = D.1 := rfl
      rw [hl] at htE
      show R.time D _ + 1 + (E.time (zoneRebalanceData dir t D) _ + 1 +
        R.time (zoneExtendData (zoneRebalanceData dir t D)) _) ≤ _
      rw [hidx] at ht₀ ⊢
      have hR2 : R.time (zoneExtendData (zoneRebalanceData dir t D))
          ((E.post (zoneRebalanceData dir t D)
            (((R.post D (d.mapState fun _ => entry)).mapState
              fun _ => (Sum.inl e' : S' ⊕ S)).mapState
              fun _ => e')).mapState fun _ => entry) ≤ C * (2 ^ D.1 + 1) := by
        refine (htime _ _ hc₂ hpc₂).trans (le_of_eq ?_)
        rw [hD, zoneRebalanceIndex_extend_of_short dir t D hshort]
      nlinarith [Nat.one_le_two_pow (n := D.1)]
  · intro D d hd hp
    have hd₀ : (d.mapState fun _ => entry).state = some entry := by simp [Cfg.mapState, hd]
    have hp₀ : R.pre D (d.mapState fun _ => entry) := by rw [hpre]; exact hp
    show zoneRowPre (zoneTrackStepData dir t D)
      (if (R.post D (d.mapState fun _ => entry)).state = some done then
      ((stop.post (id D) ((R.post D (d.mapState fun _ => entry)).mapState fun _ => done)).mapState
        Sum.inr).mapState Sum.inl
      else (retry.post (zoneRebalanceData dir t D)
        ((R.post D (d.mapState fun _ => entry)).mapState fun _ => Sum.inl e')).mapState
          Sum.inr)
    rw [hpre] at hp₀
    have hstate := zoneRebalancePost_state_done dir t hds D (d.mapState fun _ => entry)
    rw [← hpost] at hstate
    split_ifs with hdone
    · rw [zoneTrackStepData, if_pos (hstate.mp hdone), hpost]
      exact ⟨rfl, hp₀.2.1, hp₀.2.2⟩
    · have hshort : ¬ zoneRebalanceIndex dir t D < D.1 := fun h => hdone (hstate.mpr h)
      have hD : zoneRebalanceData dir t D = D := zoneRebalanceData_of_short dir t D hshort
      rw [zoneTrackStepData, if_neg hshort]
      show zoneRowPre _ (((R.post _ (((E.post _ (((R.post D (d.mapState fun _ => entry)).mapState
        fun _ => Sum.inl e').mapState fun _ => e')).mapState fun _ => entry))).mapState
          Sum.inr).mapState Sum.inr)
      rw [hpost, hEpost, hD]
      exact ⟨rfl, hp₀.2.1, hp₀.2.2⟩

/-- G5 arithmetic: `2^n = 1 + Σ_{i < n} 2^i`. -/
theorem two_pow_eq_succ_sum (n : ℕ) : 2 ^ n = 1 + ∑ i ∈ Finset.range n, 2 ^ i := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [Finset.sum_range_succ, pow_succ]
    omega

/-- **The amortization, layer-cake form** ([AB09, §1.7]: at most `T/2^{i-1}` shifts of index
`i`, each `O(2^i)`, so `Σ_i T/2^{i-1} · 2^i = O(T log T)`). If every index of a run of `T`
rebalances on one track is at most `L`, and for each level `i < L` at most `T / 2^i + 1` of them
have index above `i` (the **G5-internal count hypothesis**, from the classical fullness
invariant), then `Σ_s 2^{idx s} ≤ (L + 1) · T + 2^L`.

**Proof sketch.** Write `2^{idx s} = 1 + Σ_{i < idx s} 2^i`, exchange the sums, and bound each
level's term `2^i · #{s | i < idx s}` by `2^i · (T / 2^i + 1) ≤ T + 2^i`; the geometric sum of the
`2^i` is below `2^L`. -/
theorem amortized_le (T L : ℕ) (idx : ℕ → ℕ) (hL : ∀ s < T, idx s ≤ L)
    (hcount : ∀ i < L,
      ((Finset.range T).filter (fun s => i < idx s)).card ≤ T / 2 ^ i + 1) :
    ∑ s ∈ Finset.range T, 2 ^ idx s ≤ (L + 1) * T + 2 ^ L := by
  have hsplit : ∀ s ∈ Finset.range T, 2 ^ idx s =
      1 + ∑ i ∈ Finset.range L, if i < idx s then 2 ^ i else 0 := by
    intro s hs
    rw [two_pow_eq_succ_sum, ← Finset.sum_filter]
    congr 2
    ext i
    simp only [Finset.mem_range, Finset.mem_filter]
    have := hL s (Finset.mem_range.mp hs)
    omega
  rw [Finset.sum_congr rfl hsplit, Finset.sum_add_distrib, Finset.sum_comm]
  simp only [Finset.sum_const, Finset.card_range, nsmul_eq_mul, Nat.cast_id, mul_one]
  have hlev : ∀ i ∈ Finset.range L,
      (∑ s ∈ Finset.range T, if i < idx s then 2 ^ i else 0) ≤ T + 2 ^ i := by
    intro i hi
    rw [← Finset.sum_filter, Finset.sum_const, nsmul_eq_mul, Nat.cast_id]
    have hc := hcount i (Finset.mem_range.mp hi)
    have hd : T / 2 ^ i * 2 ^ i ≤ T := Nat.div_mul_le_self T (2 ^ i)
    calc ((Finset.range T).filter (fun s => i < idx s)).card * 2 ^ i
        ≤ (T / 2 ^ i + 1) * 2 ^ i := Nat.mul_le_mul_right _ hc
      _ = T / 2 ^ i * 2 ^ i + 2 ^ i := by ring
      _ ≤ T + 2 ^ i := by omega
  have hsum := Finset.sum_le_sum hlev
  rw [Finset.sum_add_distrib, Finset.sum_const, Finset.card_range, nsmul_eq_mul,
    Nat.cast_id] at hsum
  have hgeo := two_pow_eq_succ_sum L
  nlinarith

/-- **The rebalance cost of a run, `O(k · T log T)`** (the fit's conclusion): if one simulated
step's rebalance phase costs at most `A · Σ_t (2^{idx t s} + 1) + k` (the per-track steps of
`Turing.G24Fit.trackStep_fit` run in sequence, one dispatch each — a G5-internal chaining fact,
a hypothesis here), and every track satisfies the count hypothesis of
`Turing.G24Fit.amortized_le`, then `T` steps cost at most
`k · (A · ((L + 2) · T + 2^L) + T)`. With `L ≤ log₂ T + 2` levels (the extension happens only
when a head leaves the laid-out extent, a G5-internal fact) this is `O(k · T log T)`. -/
theorem run_cost_le (k T L A : ℕ) (idx : Fin k → ℕ → ℕ) (cost : ℕ → ℕ)
    (hstep : ∀ s < T, cost s ≤ A * ∑ t, (2 ^ idx t s + 1) + k)
    (hL : ∀ t, ∀ s < T, idx t s ≤ L)
    (hcount : ∀ t, ∀ i < L,
      ((Finset.range T).filter (fun s => i < idx t s)).card ≤ T / 2 ^ i + 1) :
    ∑ s ∈ Finset.range T, cost s ≤ k * (A * ((L + 2) * T + 2 ^ L) + T) := by
  have h1 : ∑ s ∈ Finset.range T, cost s ≤
      ∑ s ∈ Finset.range T, (A * ∑ t, (2 ^ idx t s + 1) + k) :=
    Finset.sum_le_sum fun s hs => hstep s (Finset.mem_range.mp hs)
  have h2 : ∑ s ∈ Finset.range T, (A * ∑ t, (2 ^ idx t s + 1) + k) =
      A * ∑ t, ∑ s ∈ Finset.range T, 2 ^ idx t s + A * (k * T) + T * k := by
    rw [Finset.sum_add_distrib, ← Finset.mul_sum, Finset.sum_comm]
    simp only [Finset.sum_add_distrib, Finset.sum_const, Finset.card_range, Finset.card_univ,
      Fintype.card_fin, nsmul_eq_mul, Nat.cast_id, mul_one]
    ring
  have h3 : ∑ t, ∑ s ∈ Finset.range T, 2 ^ idx t s ≤ k * ((L + 1) * T + 2 ^ L) := by
    calc ∑ t, ∑ s ∈ Finset.range T, 2 ^ idx t s
        ≤ ∑ _t : Fin k, ((L + 1) * T + 2 ^ L) :=
          Finset.sum_le_sum fun t _ => amortized_le T L (idx t) (hL t) (hcount t)
      _ = k * ((L + 1) * T + 2 ^ L) := by simp
  calc ∑ s ∈ Finset.range T, cost s ≤ _ := h1
    _ = _ := h2
    _ ≤ A * (k * ((L + 1) * T + 2 ^ L)) + A * (k * T) + T * k := by
        have := Nat.mul_le_mul_left A h3
        omega
    _ = k * (A * ((L + 2) * T + 2 ^ L) + T) := by ring

end Turing.G24Fit
