@Turing.Contract.ofSegment_pre : ∀ {k : ℕ} {Γ S : Type} {M : Turing.MultiTapeTM k Γ S} {entry : S}
  {exits : Set (Option S)} {ι : Type} {x : List Γ} (pre : ι → Turing.Cfg k Γ S x → Prop)
  (time : ι → Turing.Cfg k Γ S x → ℕ) (post : ι → Turing.Cfg k Γ S x → Turing.Cfg k Γ S x)
  (lo hi : ι → Turing.Cfg k Γ S x → Fin k → ℤ)
  (seg :
    ∀ (i : ι) (d : Turing.Cfg k Γ S x),
      d.state = some entry →
        pre i d → Turing.Segment M exits (Turing.HeadBox (lo i d) (hi i d)) d (post i d) (time i d))
  (exit_mem : ∀ (i : ι) (d : Turing.Cfg k Γ S x), d.state = some entry → pre i d → (post i d).state ∈ exits) (a : ι)
  (a_1 : Turing.Cfg k Γ S x), (Turing.Contract.ofSegment pre time post lo hi seg exit_mem).pre a a_1 = pre a a_1
@Turing.Contract.ofSegment_time : ∀ {k : ℕ} {Γ S : Type} {M : Turing.MultiTapeTM k Γ S} {entry : S}
  {exits : Set (Option S)} {ι : Type} {x : List Γ} (pre : ι → Turing.Cfg k Γ S x → Prop)
  (time : ι → Turing.Cfg k Γ S x → ℕ) (post : ι → Turing.Cfg k Γ S x → Turing.Cfg k Γ S x)
  (lo hi : ι → Turing.Cfg k Γ S x → Fin k → ℤ)
  (seg :
    ∀ (i : ι) (d : Turing.Cfg k Γ S x),
      d.state = some entry →
        pre i d → Turing.Segment M exits (Turing.HeadBox (lo i d) (hi i d)) d (post i d) (time i d))
  (exit_mem : ∀ (i : ι) (d : Turing.Cfg k Γ S x), d.state = some entry → pre i d → (post i d).state ∈ exits) (a : ι)
  (a_1 : Turing.Cfg k Γ S x), (Turing.Contract.ofSegment pre time post lo hi seg exit_mem).time a a_1 = time a a_1
@Turing.Contract.ofSegment_post : ∀ {k : ℕ} {Γ S : Type} {M : Turing.MultiTapeTM k Γ S} {entry : S}
  {exits : Set (Option S)} {ι : Type} {x : List Γ} (pre : ι → Turing.Cfg k Γ S x → Prop)
  (time : ι → Turing.Cfg k Γ S x → ℕ) (post : ι → Turing.Cfg k Γ S x → Turing.Cfg k Γ S x)
  (lo hi : ι → Turing.Cfg k Γ S x → Fin k → ℤ)
  (seg :
    ∀ (i : ι) (d : Turing.Cfg k Γ S x),
      d.state = some entry →
        pre i d → Turing.Segment M exits (Turing.HeadBox (lo i d) (hi i d)) d (post i d) (time i d))
  (exit_mem : ∀ (i : ι) (d : Turing.Cfg k Γ S x), d.state = some entry → pre i d → (post i d).state ∈ exits) (a : ι)
  (a_1 : Turing.Cfg k Γ S x), (Turing.Contract.ofSegment pre time post lo hi seg exit_mem).post a a_1 = post a a_1
@Turing.Contract.ofSegment_lo : ∀ {k : ℕ} {Γ S : Type} {M : Turing.MultiTapeTM k Γ S} {entry : S}
  {exits : Set (Option S)} {ι : Type} {x : List Γ} (pre : ι → Turing.Cfg k Γ S x → Prop)
  (time : ι → Turing.Cfg k Γ S x → ℕ) (post : ι → Turing.Cfg k Γ S x → Turing.Cfg k Γ S x)
  (lo hi : ι → Turing.Cfg k Γ S x → Fin k → ℤ)
  (seg :
    ∀ (i : ι) (d : Turing.Cfg k Γ S x),
      d.state = some entry →
        pre i d → Turing.Segment M exits (Turing.HeadBox (lo i d) (hi i d)) d (post i d) (time i d))
  (exit_mem : ∀ (i : ι) (d : Turing.Cfg k Γ S x), d.state = some entry → pre i d → (post i d).state ∈ exits) (a : ι)
  (a_1 : Turing.Cfg k Γ S x) (a_2 : Fin k),
