        {tm : Turing.MultiTapeTM k Symbol State} → Turing.Cfg k Symbol State input → ℕ → Fin k → Finset ℤ
@Turing.MultiTapeTM.spaceUsed_le_mul_succ : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {input : List Symbol}
  (tm : Turing.MultiTapeTM k Symbol State) (cfg : Turing.Cfg k Symbol State input) (t : ℕ),
  Turing.MultiTapeTM.spaceUsed cfg t ≤ k * (t + 1)
@Turing.MultiTapeTM.exists_first_halt : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2} {input : List Symbol}
  (tm : Turing.MultiTapeTM k Symbol State) (cfg : Turing.Cfg k Symbol State input) {t : ℕ},
  (Turing.MultiTapeTM.runFrom cfg t).state = none →
    ∃ u ≤ t,
      (∀ v < u, ¬(Turing.MultiTapeTM.runFrom cfg v).Halted) ∧
        Turing.MultiTapeTM.runFrom cfg u = Turing.MultiTapeTM.runFrom cfg t
Turing.exists_inputLengthTM : ∃ K S x x R entry exit C,
  ∀ {x : List Bool} (d : Turing.Cfg (K + 1) Bool S x),
    d.state = some entry →
      d.inputPos = 1 →
        (∀ (p : ℤ), -1 ≤ p → p ≤ ↑x.length.bits.length → d.workTapes 0 (d.workTapePos 0 + p) = none) →
          (∀ (j : Fin (K + 1)), j ≠ 0 → ∀ (p : ℤ), d.workTapes j p = none) →
            ∃ t ≤ C * (x.length + 1),
              (∀ u < t, (Turing.MultiTapeTM.runFrom d u).state ≠ some exit) ∧
                (∀ u ≤ t,
                    ∀ (j : Fin (K + 1)),
                      |(Turing.MultiTapeTM.runFrom d u).workTapePos j - d.workTapePos j| ≤
                        ↑(C * (x.length.bits.length + 1))) ∧
                  Turing.MultiTapeTM.runFrom d t =
                    { state := some exit, inputPos := d.inputPos,
                      workTapes := fun j q =>
                        if j = 0 ∧ d.workTapePos j ≤ q ∧ q < d.workTapePos j + ↑x.length.bits.length then
                          Turing.FinTM.bufferTape x.length.bits (q - d.workTapePos j)
                        else d.workTapes j q,
                      workTapePos := d.workTapePos, output := d.output }
@Turing.writeConstTM : {Symbol : Type u_1} →
  (k : ℕ) → Fin k → (w₀ : List Symbol) → Turing.MultiTapeTM k Symbol (Turing.WritePhase w₀.length)
@Turing.writeConstTM_run_ofCfg : ∀ {Symbol : Type u_1} {k : ℕ} {x : List Symbol} (i : Fin k) (w₀ : List Symbol)
  (d : Turing.Cfg k Symbol (Turing.WritePhase w₀.length) x),
  d.state = some (Turing.WritePhase.wr 0) →
    Turing.MultiTapeTM.runFrom d (2 * w₀.length + 2) =
        { state := some Turing.WritePhase.done, inputPos := d.inputPos,
          workTapes := fun j q =>
            if j = i ∧ d.workTapePos j ≤ q ∧ q < d.workTapePos j + ↑w₀.length then
              Turing.FinTM.bufferTape w₀ (q - d.workTapePos j)
            else d.workTapes j q,
          workTapePos := d.workTapePos, output := d.output } ∧
      (∀ t < 2 * w₀.length + 2, (Turing.MultiTapeTM.runFrom d t).state ≠ some Turing.WritePhase.done) ∧
        ∀ (j : Fin k),
          ∀ t ≤ 2 * w₀.length + 2,
            if j = i then
              (Turing.MultiTapeTM.runFrom d t).workTapePos j ∈
                Finset.Icc (d.workTapePos j) (d.workTapePos j + ↑w₀.length)
            else (Turing.MultiTapeTM.runFrom d t).workTapePos j = d.workTapePos j
@Turing.vhostEmitTM : {m : ℕ} →
  {S : Type u_1} → Turing.MultiTapeTM m Bool S → Turing.MultiTapeTM (1 + m) Bool (S × Bool)
@Turing.vhostCfg : {m : ℕ} →
  {S : Type u_1} →
    {x y : List Bool} →
      Turing.Cfg m Bool S y → Bool → Fin (x.length + 2) → List Bool → Turing.Cfg (1 + m) Bool (S × Bool) x
Turing.vhostBuffer : (m : ℕ) → Fin (1 + m)
@Turing.vhostBank : {m : ℕ} → Fin m → Fin (1 + m)
@Turing.vhostEmitTM_runFrom : ∀ {m : ℕ} {S : Type u_1} {x y : List Bool} (M : Turing.MultiTapeTM m Bool S)
  (c : Turing.Cfg m Bool S y) (b : Bool),
  Turing.FinTM.VirtualTag c.inputPos b →
    ∀ (p : Fin (x.length + 2)) (pre : List Bool) (t : ℕ),
      ∃ b',
        Turing.FinTM.VirtualTag (Turing.MultiTapeTM.runFrom c t).inputPos b' ∧
          Turing.MultiTapeTM.runFrom (Turing.vhostCfg c b p pre) t =
            Turing.vhostCfg (Turing.MultiTapeTM.runFrom c t) b' p pre
@Turing.vhostEmitTM_visitedByTapeHead_bank : ∀ {m : ℕ} {S : Type u_1} {x y : List Bool}
  (M : Turing.MultiTapeTM m Bool S) (c : Turing.Cfg m Bool S y) (b : Bool),
  Turing.FinTM.VirtualTag c.inputPos b →
    ∀ (p : Fin (x.length + 2)) (pre : List Bool) (t : ℕ) (i : Fin m),
      Turing.MultiTapeTM.visitedByTapeHead (Turing.vhostCfg c b p pre) t (Turing.vhostBank i) =
        Turing.MultiTapeTM.visitedByTapeHead c t i
@Turing.vhostEmitTM_visitedByTapeHead_buffer : ∀ {m : ℕ} {S : Type u_1} {x y : List Bool}
  (M : Turing.MultiTapeTM m Bool S) (c : Turing.Cfg m Bool S y) (b : Bool),
  Turing.FinTM.VirtualTag c.inputPos b →
    ∀ (p : Fin (x.length + 2)) (pre : List Bool) (t : ℕ),
      Turing.MultiTapeTM.visitedByTapeHead (Turing.vhostCfg c b p pre) t (Turing.vhostBuffer m) =
        Finset.image (fun u => ↑↑(Turing.MultiTapeTM.runFrom c u).inputPos - 1) (Finset.range (t + 1))
@Turing.vhostEmitTM_spaceUsed_le : ∀ {m : ℕ} {S : Type u_1} {x y : List Bool} (M : Turing.MultiTapeTM m Bool S)
  (c : Turing.Cfg m Bool S y) (b : Bool),
  Turing.FinTM.VirtualTag c.inputPos b →
    ∀ (p : Fin (x.length + 2)) (pre : List Bool) (t : ℕ),
      Turing.MultiTapeTM.spaceUsed (Turing.vhostCfg c b p pre) t ≤ Turing.MultiTapeTM.spaceUsed c t + (y.length + 2)
@Turing.vhostCfg_buffer_head_mem : ∀ {m : ℕ} {S : Type u_1} {x y : List Bool} (M : Turing.MultiTapeTM m Bool S)
  (c : Turing.Cfg m Bool S y) (b : Bool),
  Turing.FinTM.VirtualTag c.inputPos b →
    ∀ (p : Fin (x.length + 2)) (pre : List Bool) (t : ℕ),
      (Turing.MultiTapeTM.runFrom (Turing.vhostCfg c b p pre) t).workTapePos (Turing.vhostBuffer m) ∈
        Finset.Icc (-1) ↑y.length
@Turing.vhostEmitTM_emitting_halt : ∀ {m : ℕ} {S : Type u_1} {x y : List Bool} (M : Turing.MultiTapeTM m Bool S)
  (c : Turing.Cfg m Bool S y) (b : Bool),
  Turing.FinTM.VirtualTag c.inputPos b →
    ∀ (p : Fin (x.length + 2)) (pre : List Bool) (q : S) (bit : Bool),
      c.state = some q →
        (M.tr q c.inputSymbol c.workTapeSymbols).state = none →
          (M.tr q c.inputSymbol c.workTapeSymbols).output = some bit →
            (Turing.MultiTapeTM.step (Turing.vhostCfg c b p pre)).state = none ∧
              (Turing.MultiTapeTM.step (Turing.vhostCfg c b p pre)).output = pre ++ c.output ++ [bit]
@Turing.FinTM.VirtualTag : {n : ℕ} → Fin (n + 2) → Bool → Prop
@Turing.FinTM.bufferTape : {Symbol : Type u_1} → List Symbol → ℤ → Option Symbol
@Turing.embedEmitTM : {m k : ℕ} →
  {S : Type u_1} → {Symbol : Type u_2} → (Fin m ↪ Fin k) → Turing.MultiTapeTM m Symbol S → Turing.MultiTapeTM k Symbol S
@Turing.embedEmitCfg : {m k : ℕ} →
  {S : Type u_1} →
    {Symbol : Type u_2} →
      {x : List Symbol} →
        (Fin m ↪ Fin k) →
          (Fin k → ℤ → Option Symbol) → (Fin k → ℤ) → List Symbol → Turing.Cfg m Symbol S x → Turing.Cfg k Symbol S x
@Turing.embedEmitTM_runFrom : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol} (ι : Fin m ↪ Fin k)
  (M : Turing.MultiTapeTM m Symbol S) (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ) (pre : List Symbol)
  (c : Turing.Cfg m Symbol S x) (t : ℕ),
  Turing.MultiTapeTM.runFrom (Turing.embedEmitCfg ι tapes heads pre c) t =
    Turing.embedEmitCfg ι tapes heads pre (Turing.MultiTapeTM.runFrom c t)
@Turing.embedEmitTM_frame : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol} (ι : Fin m ↪ Fin k)
  (M : Turing.MultiTapeTM m Symbol S) (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ) (pre : List Symbol)
  (c : Turing.Cfg m Symbol S x) (t : ℕ),
  (∀ j ∉ Set.range ⇑ι,
      (Turing.MultiTapeTM.runFrom (Turing.embedEmitCfg ι tapes heads pre c) t).workTapes j = tapes j ∧
        (Turing.MultiTapeTM.runFrom (Turing.embedEmitCfg ι tapes heads pre c) t).workTapePos j = heads j) ∧
    (Turing.MultiTapeTM.runFrom (Turing.embedEmitCfg ι tapes heads pre c) t).inputPos =
        (Turing.MultiTapeTM.runFrom c t).inputPos ∧
      (Turing.MultiTapeTM.runFrom (Turing.embedEmitCfg ι tapes heads pre c) t).output =
        pre ++ (Turing.MultiTapeTM.runFrom c t).output
@Turing.embedEmitTM_visitedByTapeHead : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol}
  (ι : Fin m ↪ Fin k) (M : Turing.MultiTapeTM m Symbol S) (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ)
  (pre : List Symbol) (c : Turing.Cfg m Symbol S x) (t : ℕ) (i : Fin m),
  Turing.MultiTapeTM.visitedByTapeHead (Turing.embedEmitCfg ι tapes heads pre c) t (ι i) =
      Turing.MultiTapeTM.visitedByTapeHead c t i ∧
    Turing.MultiTapeTM.spaceUsedByTape (Turing.embedEmitCfg ι tapes heads pre c) t (ι i) =
      Turing.MultiTapeTM.spaceUsedByTape c t i
@Turing.embedEmitTM_visitedByTapeHead_frame : ∀ {m k : ℕ} {S : Type u_1} {Symbol : Type u_2} {x : List Symbol}
  (ι : Fin m ↪ Fin k) (M : Turing.MultiTapeTM m Symbol S) (tapes : Fin k → ℤ → Option Symbol) (heads : Fin k → ℤ)
  (pre : List Symbol) (c : Turing.Cfg m Symbol S x) (t : ℕ),
  ∀ j ∉ Set.range ⇑ι,
    Turing.MultiTapeTM.visitedByTapeHead (Turing.embedEmitCfg ι tapes heads pre c) t j = {heads j} ∧
      Turing.MultiTapeTM.spaceUsedByTape (Turing.embedEmitCfg ι tapes heads pre c) t j = 1
@Turing.seamCompTM : {k : ℕ} →
  {S₁ : Type u_1} →
    {S₂ : Type u_2} →
      {Symbol : Type u_3} →
        [DecidableEq S₁] →
          Turing.MultiTapeTM k Symbol S₁ →
            S₁ → Turing.MultiTapeTM k Symbol S₂ → S₂ → Turing.MultiTapeTM k Symbol (S₁ ⊕ S₂)
@Turing.seamCompTM_run_ofCfg : ∀ {k : ℕ} {S₁ : Type u_1} {S₂ : Type u_2} {Symbol : Type u_3} {x : List Symbol}
  [inst : DecidableEq S₁] (M₁ : Turing.MultiTapeTM k Symbol S₁) (exit : S₁) (M₂ : Turing.MultiTapeTM k Symbol S₂)
  (entry : S₂) {c₀ c₁ : Turing.Cfg k Symbol S₁ x} {c₃ : Turing.Cfg k Symbol S₂ x} {T₁ T₂ : ℕ},
  Turing.MultiTapeTM.runFrom c₀ T₁ = c₁ →
    c₁.state = some exit →
      (∀ t < T₁, (Turing.MultiTapeTM.runFrom c₀ t).state ≠ some exit) →
        Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState (fun x => entry) c₁) T₂ = c₃ →
          Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState Sum.inl c₀) (T₁ + 1 + T₂) = Turing.Cfg.mapState Sum.inr c₃
@Turing.seamCompTM_firstReturn_ofCfg : ∀ {k : ℕ} {S₁ : Type u_1} {S₂ : Type u_2} {Symbol : Type u_3} {x : List Symbol}
  [inst : DecidableEq S₁] (M₁ : Turing.MultiTapeTM k Symbol S₁) (exit : S₁) (M₂ : Turing.MultiTapeTM k Symbol S₂)
  (entry q₂ : S₂) {c₀ c₁ : Turing.Cfg k Symbol S₁ x} {c₃ : Turing.Cfg k Symbol S₂ x} {T₁ T₂ : ℕ},
  Turing.MultiTapeTM.runFrom c₀ T₁ = c₁ →
    c₁.state = some exit →
      (∀ t < T₁, (Turing.MultiTapeTM.runFrom c₀ t).state ≠ some exit) →
        Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState (fun x => entry) c₁) T₂ = c₃ →
          c₃.state = some q₂ →
            (∀ t < T₂, (Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState (fun x => entry) c₁) t).state ≠ some q₂) →
              ∀ t < T₁ + 1 + T₂,
                (Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState Sum.inl c₀) t).state ≠ some (Sum.inr q₂)
@Turing.seamCompTM_visitedByTapeHead_ofCfg : ∀ {k : ℕ} {S₁ : Type u_1} {S₂ : Type u_2} {Symbol : Type u_3}
  {x : List Symbol} [inst : DecidableEq S₁] (M₁ : Turing.MultiTapeTM k Symbol S₁) (exit : S₁)
  (M₂ : Turing.MultiTapeTM k Symbol S₂) (entry : S₂) {c₀ c₁ : Turing.Cfg k Symbol S₁ x} {T₁ T₂ : ℕ},
  Turing.MultiTapeTM.runFrom c₀ T₁ = c₁ →
    c₁.state = some exit →
      (∀ t < T₁, (Turing.MultiTapeTM.runFrom c₀ t).state ≠ some exit) →
        ∀ (i : Fin k),
          Turing.MultiTapeTM.visitedByTapeHead (Turing.Cfg.mapState Sum.inl c₀) (T₁ + 1 + T₂) i ⊆
            Turing.MultiTapeTM.visitedByTapeHead c₀ T₁ i ∪
              Turing.MultiTapeTM.visitedByTapeHead (Turing.Cfg.mapState (fun x => entry) c₁) T₂ i
@Turing.phaseHostTM : {k : ℕ} →
  {Γ I : Type} →
    {Ph : I → Type} →
      ((i : I) → Turing.MultiTapeTM k Γ (Ph i)) →
        (i : I) × Ph i → ((i : I) → Ph i → Option ((i : I) × Ph i)) → Turing.MultiTapeTM k Γ ((i : I) × Ph i)
@Turing.phaseHostTM_run : ∀ {k : ℕ} {Γ I : Type} {Ph : I → Type} (M : (i : I) → Turing.MultiTapeTM k Γ (Ph i))
  (q0 : (i : I) × Ph i) (red : (i : I) → Ph i → Option ((i : I) × Ph i)) (i : I) {x : List Γ}
  (c c' : Turing.Cfg k Γ (Ph i) x) (T : ℕ),
  Turing.MultiTapeTM.runFrom c T = c' →
    ∀ (s' : Ph i),
      c'.state = some s' →
        ∀ (q' : (i : I) × Ph i),
          red i s' = some q' →
            (∀ u < T, ∀ (s : Ph i), (Turing.MultiTapeTM.runFrom c u).state = some s → red i s = none) →
              (∀ u ≤ T,
                  Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState (Sigma.mk i) c) u =
                    Turing.Cfg.mapState (Sigma.mk i) (Turing.MultiTapeTM.runFrom c u)) ∧
                Turing.MultiTapeTM.runFrom (Turing.Cfg.mapState (Sigma.mk i) c) (T + 1) =
                  Turing.Cfg.mapState (fun x => q') c'
Turing.FinTM.computesFunInTime_lengthBits_spaceUsed : ∃ M c,
  (M.ComputesFunInTime (fun x => x.length.bits) fun n => c * (n + 1)) ∧
    ∀ (x : List Bool) (t : ℕ), Turing.MultiTapeTM.spaceUsed (Turing.MultiTapeTM.initCfg x) t ≤ c * (x.length.size + 1)
Turing.FinTM.computesFunInTime_prepend_spaceUsed : ∀ (w : List Bool),
  ∃ M c,
    (M.ComputesFunInTime (fun x => w ++ x) fun n => c * (n + 1)) ∧
      ∀ (x : List Bool) (t : ℕ), Turing.MultiTapeTM.spaceUsed (Turing.MultiTapeTM.initCfg x) t ≤ c
Turing.FinTM.computesFunInTime_const_spaceUsed : ∀ (w : List Bool),
  ∃ M c,
    (M.ComputesFunInTime (fun x => w) fun n => c * (n + 1)) ∧
      ∀ (x : List Bool) (t : ℕ), Turing.MultiTapeTM.spaceUsed (Turing.MultiTapeTM.initCfg x) t ≤ c
Turing.FinTM.computesFunInTime_id_spaceUsed : ∃ M c,
  (M.ComputesFunInTime id fun n => c * (n + 1)) ∧
    ∀ (x : List Bool) (t : ℕ), Turing.MultiTapeTM.spaceUsed (Turing.MultiTapeTM.initCfg x) t ≤ c
@Turing.FinTM.computesFunInTime_cond_spaceUsed : ∀ {D M₁ M₂ : Turing.FinTM Bool} {p : List Bool → Bool}
  {f₁ f₂ : List Bool → List Bool} {T₀ T₁ T₂ : ℕ → ℕ} (sD s₁ s₂ : ℕ → ℕ),
  D.ComputesFunInTime (fun x => [p x]) T₀ →
    M₁.ComputesFunInTime f₁ T₁ →
      M₂.ComputesFunInTime f₂ T₂ →
        (∀ (x : List Bool) (t : ℕ), Turing.MultiTapeTM.spaceUsed (Turing.MultiTapeTM.initCfg x) t ≤ sD x.length) →
          (∀ (x : List Bool) (t : ℕ), Turing.MultiTapeTM.spaceUsed (Turing.MultiTapeTM.initCfg x) t ≤ s₁ x.length) →
            (∀ (x : List Bool) (t : ℕ), Turing.MultiTapeTM.spaceUsed (Turing.MultiTapeTM.initCfg x) t ≤ s₂ x.length) →
              ∃ M c,
                (M.ComputesFunInTime (fun x => if p x = true then f₁ x else f₂ x) fun n =>
                    c * (T₀ n + max (T₁ n) (T₂ n) + 1)) ∧
                  ∀ (x : List Bool) (t : ℕ),
                    Turing.MultiTapeTM.spaceUsed (Turing.MultiTapeTM.initCfg x) t ≤
                      sD x.length + max (s₁ x.length) (s₂ x.length) + c
Turing.FinTM.bufferedCompTM : Turing.FinTM Bool → Turing.FinTM Bool → Turing.FinTM Bool
Turing.FinTM.bufferedCompTM_computesInTime : ∀ (M₁ M₂ : Turing.FinTM Bool) {x y o : List Bool} {t₁ t₂ : ℕ},
  M₁.ComputesInTime x y t₁ →
    M₂.ComputesInTime y o t₂ → (M₁.bufferedCompTM M₂).ComputesInTime x o (t₁ + y.length + 2 + t₂)
Turing.incrementTM : (k : ℕ) → Fin k → Turing.MultiTapeTM k Bool Turing.FlagPhase
@Turing.incrementTM_run_succ_ofCfg : ∀ {k : ℕ} {x : List Bool} (i : Fin k) (w v : List Bool),
  Turing.incFixed w = some v →
    ∀ (d : Turing.Cfg k Bool Turing.FlagPhase x),
      d.state = some Turing.FlagPhase.run →
        (∀ (p : ℤ), -1 ≤ p → p ≤ ↑w.length → d.workTapes i (d.workTapePos i + p) = Turing.FinTM.bufferTape w p) →
          Turing.MultiTapeTM.runFrom d (2 * (List.takeWhile id w).length + 2) =
              { state := some (Turing.FlagPhase.done true), inputPos := d.inputPos,
                workTapes := fun j q =>
                  if j = i ∧ d.workTapePos j ≤ q ∧ q < d.workTapePos j + ↑w.length then
                    Turing.FinTM.bufferTape v (q - d.workTapePos j)
                  else d.workTapes j q,
                workTapePos := d.workTapePos, output := d.output } ∧
            (∀ t < 2 * (List.takeWhile id w).length + 2,
                ∀ (b : Bool), (Turing.MultiTapeTM.runFrom d t).state ≠ some (Turing.FlagPhase.done b)) ∧
              ∀ (j : Fin k),
                ∀ t ≤ 2 * (List.takeWhile id w).length + 2,
                  if j = i then
                    (Turing.MultiTapeTM.runFrom d t).workTapePos j ∈
                      Finset.Icc (d.workTapePos j - 1) (d.workTapePos j + ↑(List.takeWhile id w).length)
                  else (Turing.MultiTapeTM.runFrom d t).workTapePos j = d.workTapePos j
@Turing.incrementTM_run_overflow_ofCfg : ∀ {k : ℕ} {x : List Bool} (i : Fin k) (w : List Bool),
  Turing.incFixed w = none →
    ∀ (d : Turing.Cfg k Bool Turing.FlagPhase x),
      d.state = some Turing.FlagPhase.run →
        (∀ (p : ℤ), -1 ≤ p → p ≤ ↑w.length → d.workTapes i (d.workTapePos i + p) = Turing.FinTM.bufferTape w p) →
          Turing.MultiTapeTM.runFrom d (2 * w.length + 2) =
              { state := some (Turing.FlagPhase.done false), inputPos := d.inputPos,
                workTapes := fun j q =>
                  if j = i ∧ d.workTapePos j ≤ q ∧ q < d.workTapePos j + ↑w.length then
                    Turing.FinTM.bufferTape (List.replicate w.length false) (q - d.workTapePos j)
                  else d.workTapes j q,
                workTapePos := d.workTapePos, output := d.output } ∧
            (∀ t < 2 * w.length + 2,
                ∀ (b : Bool), (Turing.MultiTapeTM.runFrom d t).state ≠ some (Turing.FlagPhase.done b)) ∧
              ∀ (j : Fin k),
                ∀ t ≤ 2 * w.length + 2,
                  if j = i then
                    (Turing.MultiTapeTM.runFrom d t).workTapePos j ∈
                      Finset.Icc (d.workTapePos j - 1) (d.workTapePos j + ↑w.length)
                  else (Turing.MultiTapeTM.runFrom d t).workTapePos j = d.workTapePos j
Turing.FinTM.exists_emitCallTM : ∀ (M : Turing.FinTM Bool) (f : List Bool → List Bool) (T : ℕ → ℕ),
  M.ComputesFunInTime f T →
    ∃ C entry exit c,
      0 < C.k ∧
        ∀ (x arg : List Bool),
          ∃ t ≤ c * (T arg.length + arg.length + (f arg).length + 1),
            0 < t ∧
              (∀ (t' : ℕ),
                  0 < t' →
                    t' < t →
                      (Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords entry (Turing.stateWord C.k arg)) t').state ≠
                        some exit) ∧
                Turing.MultiTapeTM.runFrom (Turing.Cfg.ofWords entry (Turing.stateWord C.k arg)) t =
                  have __src := Turing.Cfg.ofWords exit (Turing.stateWord C.k arg);
                  { state := __src.state, inputPos := __src.inputPos, workTapes := __src.workTapes,
                    workTapePos := __src.workTapePos, output := f arg }
Complexity.LogProg.length_bits_le_log : ∀ (n : ℕ), n.bits.length ≤ Nat.log 2 n + 1
Turing.length_bits_le_self : ∀ (m : ℕ), m.bits.length ≤ m
EXIT 0
