@Turing.OracleTM.toOracleNDTM_runWith : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2}
  (M : Turing.OracleTM k Symbol State) (O : Language Symbol) {input : List Symbol} (w : List Bool)
  (cfg : Turing.Cfg (k + 1) Symbol State input), M.toOracleNDTM.runWith O w cfg = M.runFrom O cfg w.length
Complexity.P_subset_POracle : ∀ (O : Language Bool), Complexity.P ⊆ Complexity.POracle O
Complexity.POracle_subset_NPOracle : ∀ (O : Language Bool), Complexity.POracle O ⊆ Complexity.NPOracle O
@Turing.OracleTM.queriesWithin_length_le : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2}
  (M : Turing.OracleTM k Symbol State) (O : Language Symbol) (x : List Symbol) (t : ℕ),
  (M.queriesWithin O x t).length ≤ t
@Turing.OracleNDTM.length_le_of_mem_queriesAlong : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2}
  {N : Turing.OracleNDTM k Symbol State} {O : Language Symbol} {x : List Symbol} {w : List Bool} {z : List Symbol},
  z ∈ N.queriesAlong O x w → z.length ≤ w.length
@Turing.OracleNDTM.runWith_eq_of_agree_length_lt : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2}
  (N : Turing.OracleNDTM k Symbol State) (O O' : Language Symbol) (x : List Symbol) (w : List Bool),
  (∀ (z : List Symbol), z.length < w.length → (z ∈ O ↔ z ∈ O')) →
    N.runWith O w (N.initCfg x) = N.runWith O' w (N.initCfg x)
@Turing.OracleNDTM.runWith_eq_of_agree_queriesAlong : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2}
  (N : Turing.OracleNDTM k Symbol State) (O O' : Language Symbol) (x : List Symbol) (w : List Bool),
  (∀ z ∈ N.queriesAlong O x w, z ∈ O ↔ z ∈ O') → N.runWith O w (N.initCfg x) = N.runWith O' w (N.initCfg x)
@Turing.OracleTM.runFrom_eq_of_agree_length_lt : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2}
  (M : Turing.OracleTM k Symbol State) (O O' : Language Symbol) (x : List Symbol) (t : ℕ),
  (∀ (z : List Symbol), z.length < t → (z ∈ O ↔ z ∈ O')) → M.runFrom O (M.initCfg x) t = M.runFrom O' (M.initCfg x) t
@Turing.OracleTM.runFrom_eq_of_agree_queriesWithin : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2}
  (M : Turing.OracleTM k Symbol State) (O O' : Language Symbol) (x : List Symbol) (t : ℕ),
  (∀ z ∈ M.queriesWithin O x t, z ∈ O ↔ z ∈ O') → M.runFrom O (M.initCfg x) t = M.runFrom O' (M.initCfg x) t
@Turing.OracleTM.length_le_of_mem_queriesWithin : ∀ {k : ℕ} {Symbol : Type u_1} {State : Type u_2}
  {M : Turing.OracleTM k Symbol State} {O : Language Symbol} {x : List Symbol} {t : ℕ} {z : List Symbol},
  z ∈ M.queriesWithin O x t → z.length ≤ t
