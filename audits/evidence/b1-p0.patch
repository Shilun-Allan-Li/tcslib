 private lemma apply_workTapes_eq_of_ne {k' : ℕ} (a : Action k' Symbol State)
     (cfg : Cfg k' Symbol State input) (i : Fin k') {z : ℤ}
@@ -270,6 +368,62 @@ private lemma runFrom_workTapes_invariant (M : OracleTM k Symbol State)
