+    intro j hj
+    obtain ⟨hj₁, hj₂⟩ := Finset.mem_Icc.mp hj
+    obtain ⟨i, u, hu, he⟩ := w.visited j hj₁ (by omega)
+    exact Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ _,
+      Finset.mem_image.mpr ⟨u, Finset.mem_range.mpr (by omega), he⟩⟩
