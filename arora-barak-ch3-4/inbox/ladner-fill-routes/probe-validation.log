  y ∈ padSAT h ↔ ∃ ψ ∈ SAT, y = ψ ++ false :: List.replicate (ψ.length ^ h ψ.length) true
Complexity.padSAT_congr {h g : ℕ → ℕ} {y : List Bool} (hfg : ∀ m < y.length, h m = g m) : y ∈ padSAT h ↔ y ∈ padSAT g
Complexity.ladnerMachine_eq (i : ℕ) : ladnerMachine i = (expCode.decode i.bits).toFinTM
Complexity.ladnerH_eq (n : ℕ) :
  ladnerH n =
    if hex :
        ∃ i < Nat.log 2 (Nat.log 2 n),
          ∀ (x : List Bool),
            x.length ≤ Nat.log 2 n →
              ((ladnerMachine i).ComputesInTime x [true] (i * x.length ^ i) ↔ x ∈ padSAT ladnerH) then
      Nat.find hex
    else Nat.log 2 (Nat.log 2 n)
Complexity.ladnerH_le (n : ℕ) : ladnerH n ≤ Nat.log 2 (Nat.log 2 n)
Complexity.SAT_H_eq : SAT_H = padSAT ladnerH
Complexity.padSAT (h : ℕ → ℕ) : Language Bool
Complexity.ladnerMachine (i : ℕ) : FinTM Bool
Complexity.ladnerH (n : ℕ) : ℕ
Complexity.SAT_H : Language Bool
Complexity.ladnerH_polyTime : PolyTimeComputable fun x => (ladnerH x.length).bits
Complexity.SAT_H_mem_NP : SAT_H ∈ NP
Complexity.ladnerH_bounded_of_mem_P : SAT_H ∈ P → ∃ C, ∀ (n : ℕ), ladnerH n ≤ C
Complexity.ladnerH_unbounded_of_not_mem_P : SAT_H ∉ P → ∀ (C : ℕ), ∃ N, ∀ n ≥ N, C ≤ ladnerH n
Complexity.SAT_mem_P_of_padSAT_NPHard {h : ℕ → ℕ} (hp : PolyTimeComputable fun x => (h x.length).bits)
  (hu : ∀ (C : ℕ), ∃ N, ∀ n ≥ N, C ≤ h n) (hH : NPHard (padSAT h)) : SAT ∈ P
Complexity.SAT_H_intermediate (h : P ≠ NP) : SAT_H ∈ NP ∧ SAT_H ∉ P ∧ ¬NPComplete SAT_H
Complexity.mem_P_iff {L : Language Bool} : L ∈ P ↔ ∃ C d M, M.DecidesInTime L fun n => C * (n + 1) ^ d
Complexity.mem_P_iff_one_work_tape {L : Language Bool} :
  L ∈ P ↔ ∃ M C d, M.k = 1 ∧ M.DecidesInTime L fun n => C * (n + 1) ^ d
Complexity.mem_NP_iff_exists_length_le {L : Language Bool} :
  L ∈ NP ↔ ∃ C c, ∃ V ∈ P, ∀ (x : List Bool), x ∈ L ↔ ∃ u, u.length ≤ C * (x.length + 1) ^ c ∧ pairEncode x u ∈ V
Complexity.SAT_mem_NP : SAT ∈ NP
Complexity.SAT_NPHard : NPHard SAT
Complexity.mem_P_of_polyTimeReducible {L L' : Language Bool} (h : L ≤ₚ L') (h' : L' ∈ P) : L ∈ P
Complexity.P_eq_NP_of_NPHard_mem_P {L : Language Bool} (hL : NPHard L) (h : L ∈ P) : P = NP
Complexity.PolyTimeComputable.output_length_le {f : List Bool → List Bool} (h : PolyTimeComputable f) :
  ∃ C c, ∀ (x : List Bool), (f x).length ≤ C * (x.length + 1) ^ c
Complexity.PolyTimeComputable.comp {f g : List Bool → List Bool} (hg : PolyTimeComputable g)
  (hf : PolyTimeComputable f) : PolyTimeComputable (g ∘ f)
Complexity.PolyTimeComputable.pairEncode {f g : List Bool → List Bool} (hf : PolyTimeComputable f)
  (hg : PolyTimeComputable g) : PolyTimeComputable fun x => pairEncode (f x) (g x)
Complexity.PolyTimeComputable.append {f g : List Bool → List Bool} (hf : PolyTimeComputable f)
  (hg : PolyTimeComputable g) : PolyTimeComputable fun x => f x ++ g x
Complexity.mem_P_of_test {b : List Bool → Bool} (h : PolyTimeComputable fun z => [b z]) : {z | b z = true} ∈ P
Complexity.test_of_mem_P {L : Language Bool} (h : L ∈ P) : PolyTimeComputable fun z => [MultiTapeTM.indicator L z]
Complexity.mem_P_iff_polyTimeComputable {V : Language Bool} :
  V ∈ P ↔ PolyTimeComputable fun x => [MultiTapeTM.indicator V x]
Complexity.preimage_mem_P {V : Language Bool} {g : List Bool → List Bool} (hV : V ∈ P) (hg : PolyTimeComputable g) :
  g ⁻¹' V ∈ P
Complexity.inter_mem_P {L₁ L₂ : Language Bool} (h₁ : L₁ ∈ P) (h₂ : L₂ ∈ P) : {z | z ∈ L₁ ∧ z ∈ L₂} ∈ P
Complexity.polyTimeComputable_of_linear {f : List Bool → List Bool}
  (h : ∃ M a, M.ComputesFunInTime f fun n => a * (n + 1)) : PolyTimeComputable f
Complexity.polyTimeComputable_const (w : List Bool) : PolyTimeComputable fun x => w
Complexity.polyTimeComputable_id : PolyTimeComputable id
Complexity.polyTimeComputable_unary : PolyTimeComputable fun x => List.replicate x.length true
Complexity.polyTimeComputable_polyUnary (C d : ℕ) :
  PolyTimeComputable fun x => List.replicate (C * (x.length + 1) ^ d) true
Complexity.polyTimeComputable_pairFstD : PolyTimeComputable pairFstD
Complexity.polyTimeComputable_pairSndD : PolyTimeComputable pairSndD
Complexity.polyTimeComputable_ite {p : List Bool → Bool} {f g : List Bool → List Bool}
  (hp : PolyTimeComputable fun x => [p x]) (hf : PolyTimeComputable f) (hg : PolyTimeComputable g) :
  PolyTimeComputable fun x => if p x = true then f x else g x
Complexity.polyTimeComputable_and {p q : List Bool → Bool} (hp : PolyTimeComputable fun x => [p x])
  (hq : PolyTimeComputable fun x => [q x]) : PolyTimeComputable fun x => [p x && q x]
Complexity.polyTimeComputable_or {p q : List Bool → Bool} (hp : PolyTimeComputable fun x => [p x])
  (hq : PolyTimeComputable fun x => [q x]) : PolyTimeComputable fun x => [p x || q x]
Complexity.polyTimeComputable_not {p : List Bool → Bool} (hp : PolyTimeComputable fun x => [p x]) :
  PolyTimeComputable fun x => [!p x]
Complexity.polyTimeComputable_tail : PolyTimeComputable fun w => List.drop 1 w
Complexity.polyTimeComputable_takePrefixByLength : PolyTimeComputable PrefixByLength.take
Complexity.polyTimeComputable_dropPrefixByLength : PolyTimeComputable PrefixByLength.drop
Complexity.pairFstD_pairEncode (a b : List Bool) : pairFstD (pairEncode a b) = a
Complexity.pairSndD_pairEncode (a b : List Bool) : pairSndD (pairEncode a b) = b
Complexity.length_pairFstD_le (z : List Bool) : (pairFstD z).length ≤ z.length
Complexity.length_pairSndD_le (z : List Bool) : (pairSndD z).length ≤ z.length
Complexity.transduce_nil {σ : Type} (δ : σ → Bool → σ) (o : σ → Bool → Option Bool) (q : σ) : transduce δ o q [] = []
Complexity.transduce_cons {σ : Type} (δ : σ → Bool → σ) (o : σ → Bool → Option Bool) (q : σ) (b : Bool)
  (l : List Bool) : transduce δ o q (b :: l) = (o q b).toList ++ transduce δ o (δ q b) l
Complexity.polyTimeComputable_transduce {σ : Type} [Fintype σ] [DecidableEq σ] (δ : σ → Bool → σ)
  (o : σ → Bool → Option Bool) (q₀ : σ) : PolyTimeComputable (transduce δ o q₀)
Complexity.exists_proj_decider (C c : ℕ) (V : Language Bool) (Tv : ℕ → ℕ) (MV : FinTM Bool)
  (hV : MV.DecidesInTime V Tv) :
  ∃ b E,
    E.DecidesInTime {x | ∃ u, u.length = C * (x.length + 1) ^ c ∧ x ++ u ∈ V} fun n =>
      b * 2 ^ (C * (n + 1) ^ c) * (Tv (n + C * (n + 1) ^ c) + (n + C * (n + 1) ^ c + 1) ^ (c + 1))
Complexity.expCode : UniformMachineCode
Turing.UniformMachineCode.simulator_accepts (self : UniformMachineCode) (α x : List Bool) (t : ℕ) :
  (self.decode α).toFinTM.ComputesInTime x [true] t →
    self.simulator.ComputesInTime (pairEncode (pairEncode t.bits α) x) [true]
      (self.simDegree * (α.length + x.length + t + 1) ^ self.simDegree)
Turing.UniformMachineCode.simulator_rejects (self : UniformMachineCode) (α x : List Bool) (t : ℕ) :
  ¬(self.decode α).toFinTM.ComputesInTime x [true] t →
    self.simulator.ComputesInTime (pairEncode (pairEncode t.bits α) x) [false]
      (self.simDegree * (α.length + x.length + t + 1) ^ self.simDegree)
Turing.MachineCode.decode_encode_pad (self : MachineCode) (M : CodeTM) (m : ℕ) :
  self.decode (self.encode M ++ List.replicate m true) = M
Turing.FinTM.toCodeTM_computesInTime_iff (M : FinTM Bool) (hk : M.k = 1) (x output : List Bool) (t : ℕ) :
  (M.toCodeTM hk).toFinTM.ComputesInTime x output t ↔ M.ComputesInTime x output t
Turing.FinTM.not_computesInTime_zero {Symbol : Type} (M : FinTM Symbol) (input output : List Symbol) :
  ¬M.ComputesInTime input output 0
Turing.FinTM.ComputesInTime.mono {Symbol : Type} {M : FinTM Symbol} {input output : List Symbol} {t t' : ℕ}
  (h : M.ComputesInTime input output t) (hle : t ≤ t') : M.ComputesInTime input output t'
Turing.FinTM.ComputesInTime.output_unique {Symbol : Type} {M : FinTM Symbol} {input w w' : List Symbol} {t t' : ℕ}
  (h : M.ComputesInTime input w t) (h' : M.ComputesInTime input w' t') : w = w'
Turing.FinTM.computesFunInTime_iff {Symbol : Type} (M : FinTM Symbol) (f : List Symbol → List Symbol) (T : ℕ → ℕ) :
  M.ComputesFunInTime f T ↔ ∀ (input : List Symbol), M.ComputesInTime input (f input) (T input.length)
Turing.FinTM.computesInTime_iff {Symbol : Type} (M : FinTM Symbol) (x w : List Symbol) (t : ℕ) :
  M.ComputesInTime x w t ↔
    (MultiTapeTM.runFrom (MultiTapeTM.initCfg x) t).state = none ∧
      (MultiTapeTM.runFrom (MultiTapeTM.initCfg x) t).output = w
Turing.FinTM.exists_comp_on_image (M U : FinTM Bool) (f g : List Bool → List Bool) (T₁ T₂ : ℕ → ℕ)
  (hM : M.ComputesFunInTime f T₁) (hU : ∀ (x : List Bool), U.ComputesInTime (f x) (g x) (T₂ x.length)) :
  ∃ N, N.ComputesFunInTime g fun n => 2 * T₁ n + T₂ n + 2
Turing.FinTM.computesFunInTime_lengthBits : ∃ M c, M.ComputesFunInTime (fun x => x.length.bits) fun n => c * (n + 1)
Turing.FinTM.computesFunInTime_polyBits (C e : ℕ) :
  ∃ M c, M.ComputesFunInTime (fun x => (C * (x.length + 1) ^ e).bits) fun n => c * (n + 1) ^ (e + 1)
Turing.FinTM.computesFunInTime_decideEq (w : List Bool) :
  ∃ M c, M.ComputesFunInTime (fun x => [decide (x = w)]) fun n => c * (n + 1)
Turing.length_bits_le_self (m : ℕ) : m.bits.length ≤ m
Turing.length_pairEncode (x y : List Bool) : (pairEncode x y).length = 2 * x.length + 2 + y.length
Turing.pairEncode_injective : Function.Injective fun p => pairEncode p.1 p.2
Complexity.BinArith.polyTimeComputable_iterate {g init : List Bool → List Bool} (hg : PolyTimeComputable g)
  (hinit : PolyTimeComputable init) (a k B b : ℕ)
  (hbound : ∀ (z : List Bool), ∀ i ≤ a * (z.length + 1) ^ k, (g^[i] (init z)).length ≤ B * (z.length + 1) ^ b) :
  PolyTimeComputable fun z => g^[a * (z.length + 1) ^ k] (init z)
Complexity.BinArith.iterate_invariant {α : Type} {g : α → α} (I : α → Prop) (hI : ∀ (s : α), I s → I (g s)) (n : ℕ)
  {s : α} (hs : I s) : I (g^[n] s)
Complexity.BinArith.iterate_measure_eq_zero {α : Type} {g : α → α} (I : α → Prop) (μ : α → ℕ)
  (hI : ∀ (s : α), I s → I (g s)) (hdec : ∀ (s : α), I s → 0 < μ s → μ (g s) < μ s)
  (hfix : ∀ (s : α), I s → μ s = 0 → g s = s) (n : ℕ) (s : α) : I s → μ s ≤ n → μ (g^[n] s) = 0
Complexity.BinArith.polyTimeComputable_forLoop {f : List Bool → List Bool} (hf : PolyTimeComputable f) (B b : ℕ)
  (hbound : ∀ (c d : List Bool), ∀ j ≤ c.length, (f^[j] d).length ≤ B * ((pairEncode c d).length + 1) ^ b) :
  PolyTimeComputable (BinArith.forLoop f)
Complexity.BinArith.forLoop_pairEncode (f : List Bool → List Bool) (c d : List Bool) :
  BinArith.forLoop f (pairEncode c d) = pairEncode [] (f^[c.length] d)
Complexity.BinArith.polyTimeComputable_normBits : PolyTimeComputable fun w => (LogProg.bitsVal w).bits
Complexity.BinArith.polyTimeComputable_reverse : PolyTimeComputable fun w => w.reverse
Complexity.BinArith.polyTimeComputable_add : PolyTimeComputable BinArith.add
Complexity.BinArith.polyTimeComputable_sub : PolyTimeComputable BinArith.sub
Complexity.BinArith.polyTimeComputable_mul : PolyTimeComputable BinArith.mul
Complexity.BinArith.polyTimeComputable_lt : PolyTimeComputable fun z => [BinArith.lt z]
Complexity.BinArith.polyTimeComputable_le : PolyTimeComputable fun z => [BinArith.le z]
Complexity.BinArith.polyTimeComputable_beq : PolyTimeComputable fun z => [BinArith.beq z]
Complexity.BinArith.add_pairEncode (a b : ℕ) : BinArith.add (pairEncode a.bits b.bits) = (a + b).bits
Complexity.BinArith.sub_pairEncode (a b : ℕ) : BinArith.sub (pairEncode a.bits b.bits) = (a - b).bits
Complexity.BinArith.mul_pairEncode (a b : ℕ) : BinArith.mul (pairEncode a.bits b.bits) = (a * b).bits
Complexity.BinArith.lt_pairEncode (a b : ℕ) : BinArith.lt (pairEncode a.bits b.bits) = decide (a < b)
Complexity.BinArith.le_pairEncode (a b : ℕ) : BinArith.le (pairEncode a.bits b.bits) = decide (a ≤ b)
Complexity.BinArith.beq_pairEncode (a b : ℕ) : BinArith.beq (pairEncode a.bits b.bits) = decide (a = b)
Complexity.BinArith.bitsVal_eq_headD (w : List Bool) :
  LogProg.bitsVal w = (w.headD false).toNat + 2 * LogProg.bitsVal (List.drop 1 w)
Complexity.BinArith.bitsVal_drop_one (w : List Bool) : LogProg.bitsVal (List.drop 1 w) = LogProg.bitsVal w / 2
Complexity.BinArith.polyTimeComputable_uRest : PolyTimeComputable BinArith.uRest
Complexity.BinArith.polyTimeComputable_hasFalse : PolyTimeComputable fun w => [BinArith.hasFalse w]
Complexity.BinArith.uRest_nil : BinArith.uRest [] = []
Complexity.BinArith.uRest_true_cons (w : List Bool) : BinArith.uRest (true :: w) = BinArith.uRest w
Complexity.BinArith.uRest_false_cons (w : List Bool) : BinArith.uRest (false :: w) = w
Complexity.BinArith.hasFalse_nil : BinArith.hasFalse [] = false
Complexity.BinArith.hasFalse_cons (b : Bool) (w : List Bool) : BinArith.hasFalse (b :: w) = (!b || BinArith.hasFalse w)
Complexity.BinArith.encWords_nil : BinArith.encWords [] = []
Complexity.BinArith.encWords_cons (w : List Bool) (L : List (List Bool)) :
  BinArith.encWords (w :: L) = pairEncode w (BinArith.encWords L)
Complexity.BinArith.encWords_append_singleton (L : List (List Bool)) (w : List Bool) :
  BinArith.encWords (L ++ [w]) = BinArith.encWords L ++ pairEncode w []
Complexity.BinArith.length_encWords_le (L : List (List Bool)) (c : ℕ) (h : ∀ w ∈ L, w.length ≤ c) :
  (BinArith.encWords L).length ≤ L.length * (2 * c + 2)
Complexity.BinArith.length_decWords_le (w : List Bool) : (BinArith.decWords w).length ≤ w.length
Complexity.BinArith.polyTimeComputable_countW : PolyTimeComputable BinArith.countW
Complexity.BinArith.countW_eq (w : List Bool) : BinArith.countW w = List.replicate (BinArith.decWords w).length true
Complexity.BinArith.polyTimeComputable_getW : PolyTimeComputable BinArith.getW
Complexity.BinArith.getW_pairEncode_bits (J : List Bool) (vs : List ℕ) :
  BinArith.getW (pairEncode J (BinArith.encWords (List.map Nat.bits vs))) = (vs.getD J.length 0).bits
Complexity.BinArith.polyTimeComputable_mapW {g : List Bool → List Bool} (hg : PolyTimeComputable g) :
  PolyTimeComputable (BinArith.mapW g)
Complexity.BinArith.mapW_pairEncode (g : List Bool → List Bool) (q w : List Bool) :
  BinArith.mapW g (pairEncode q w) = BinArith.encWords (List.map (fun x => g (pairEncode q x)) (BinArith.decWords w))
Complexity.BinArith.polyTimeComputable_eqW : PolyTimeComputable fun z => [BinArith.eqW z]
Complexity.BinArith.eqW_pairEncode (a b : List Bool) : BinArith.eqW (pairEncode a b) = decide (a = b)
Complexity.BinArith.polyTimeComputable_mulU : PolyTimeComputable BinArith.mulU
Complexity.BinArith.length_mulU (a b : List Bool) : (BinArith.mulU (pairEncode a b)).length = a.length * b.length
Complexity.LogProg.bitsVal_bits (n : ℕ) : LogProg.bitsVal n.bits = n
Complexity.LogProg.bits_injective : Function.Injective Nat.bits
Complexity.LogProg.bitsVal_lt_two_pow (w : List Bool) : LogProg.bitsVal w < 2 ^ w.length
Nat.find_spec {p : ℕ → Prop} [DecidablePred p] (H : ∃ n, p n) : p (Nat.find H)
Nat.find_min' {p : ℕ → Prop} [DecidablePred p] (H : ∃ n, p n) {m : ℕ} (h : p m) : Nat.find H ≤ m
Nat.log_lt_self (b : ℕ) {x : ℕ} (hx : x ≠ 0) : Nat.log b x < x
Nat.log_le_self (b x : ℕ) : Nat.log b x ≤ x
Nat.le_log_of_pow_le {b x y : ℕ} (hb : 1 < b) (h : b ^ x ≤ y) : x ≤ Nat.log b y
Nat.pow_log_le_self (b : ℕ) {x : ℕ} (hx : x ≠ 0) : b ^ Nat.log b x ≤ x
Nat.pow_le_of_le_log {b x y : ℕ} (hy : y ≠ 0) (h : x ≤ Nat.log b y) : b ^ x ≤ y
Nat.lt_pow_succ_log_self {b : ℕ} (hb : 1 < b) (x : ℕ) : x < b ^ (Nat.log b x).succ
Nat.bits_append_bit (n : ℕ) (b : Bool) (hn : n = 0 → b = true) : (Nat.bit b n).bits = b :: n.bits
Nat.bit_val (b : Bool) (n : ℕ) : Nat.bit b n = 2 * n + b.toNat
Nat.one_bits : Nat.bits 1 = [true]
Nat.pow_le_pow_left {n m : ℕ} (h : n ≤ m) (i : ℕ) : n ^ i ≤ m ^ i
Nat.pow_le_pow_right {n : ℕ} (hx : n > 0) {i j : ℕ} : i ≤ j → n ^ i ≤ n ^ j
Function.iterate_succ_apply.{u} {α : Type u} (f : α → α) (n : ℕ) (x : α) : f^[n.succ] x = f^[n] (f x)
Function.iterate_succ_apply'.{u} {α : Type u} (f : α → α) (n : ℕ) (x : α) : f^[n.succ] x = f (f^[n] x)
Finset.le_sup.{u_2, u_3} {α : Type u_2} {β : Type u_3} [SemilatticeSup α] [OrderBot α] {s : Finset β} {f : β → α}
  {b : β} (hb : b ∈ s) : f b ≤ s.sup f
Finset.mem_range {n m : ℕ} : m ∈ Finset.range n ↔ m < n
Complexity.ladner (h : P ≠ NP) : ∃ L ∈ NP, L ∉ P ∧ ¬NPComplete L
