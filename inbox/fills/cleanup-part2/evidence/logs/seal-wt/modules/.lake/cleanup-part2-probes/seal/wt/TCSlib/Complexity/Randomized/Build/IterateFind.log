A : ℕ := aS + aV + aI + aE + aF + 5
pow : ℕ → ℕ := fun n => (2 * n + 2 + P.eval n + 5) ^ D
T : ℕ → ℕ := fun n => A * pow n
hpow : ∀ (n : ℕ), n + 1 ≤ pow n
hstart :
