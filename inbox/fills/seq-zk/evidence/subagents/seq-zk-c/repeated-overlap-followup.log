682:`g.FactorsThrough f`). In particular this holds if `f` is injective.
683:
684:A typical use case is extending a function from a subtype to the entire type. If you wish to extend
685:`g : {b : β // p b} → γ` to a function `β → γ`, you should use `Function.extend Subtype.val g j`. -/
686:def extend (f : α → β) (g : α → γ) (j : β → γ) : β → γ := fun b ↦
687:  open scoped Classical in
688:  if h : ∃ a, f a = b then g (Classical.choose h) else j b
689:
690:/-- g factors through f : `f a = f b → g a = g b` -/
691:def FactorsThrough (g : α → γ) (f : α → β) : Prop :=
692:  ∀ ⦃a b⦄, f a = f b → g a = g b
693:
694:theorem extend_def (f : α → β) (g : α → γ) (e' : β → γ) (b : β) [Decidable (∃ a, f a = b)] :
695:    extend f g e' b = if h : ∃ a, f a = b then g (Classical.choose h) else e' b := by
