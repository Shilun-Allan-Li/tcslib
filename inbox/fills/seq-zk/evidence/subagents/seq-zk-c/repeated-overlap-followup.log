194:/-- A finite list `W : Fin q → O` of values as an answer stream; entries beyond `q` are
195:an arbitrary fixed value and are never read by trees making at most `q` queries. -/
196:noncomputable def extendStream {O : Type*} [Nonempty O] {q : ℕ} (W : Fin q → O) : ℕ → O :=
197:  fun k => if h : k < q then W ⟨k, h⟩ else Classical.arbitrary O
198:
199:/-- The defining equation of `extendStream`: `extendStream W = fun k => if h : k < q then W ⟨k, h⟩
200:else Classical.arbitrary O`. -/
201:theorem extendStream_def {O : Type*} [Nonempty O] {q : ℕ} (W : Fin q → O) :
202:    (extendStream W : ℕ → O) =
203:      (fun k => if h : k < q then W ⟨k, h⟩ else Classical.arbitrary O :
204:        ℕ → O) := rfl

