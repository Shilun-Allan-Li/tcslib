+    simpa only [Function.comp_def, pairFstD_pairEncode, pairSndD_pairEncode, PolyExpr.eval_const,
+      PolyExpr.eval_var] using h
+  have htest := polyTimeComputable_lenEq.comp (hout.pairEncode (polyTimeComputable_const []))
