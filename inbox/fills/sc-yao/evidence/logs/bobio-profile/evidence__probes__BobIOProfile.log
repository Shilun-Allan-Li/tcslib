[Elab.command] [3.206944] /-- The one-bit output reader is polynomial-time on every raw word:
    `PolyTimeComputable (fun z => [outputBit z])`.
    
    **Proof sketch.** Use unary word-list lookup for the output vertex and the decoding pair.
    The vertex's key is another word-list lookup, padded to the parameter length. Two word
    comparisons implement the decoding rule. Each lookup and padding operation is total, so
    malformed words require no separate machine. -/
    theorem outputBit_poly : PolyTimeComputable fun z => [outputBit z] :=
      by
      let ctx := pairFstD
      let vals := fun z => pairFstD (pairSndD (ctx z))
      let pairs := fun z => pairFstD (pairSndD (pairSndD (ctx z)))
      let outs := fun z => pairSndD (pairSndD (pairSndD (ctx z)))
      have hc : PolyTimeComputable ctx := polyTimeComputable_pairFstD
      have hv : PolyTimeComputable vals := polyTimeComputable_pairFstD.comp (polyTimeComputable_pairSndD.comp hc)
      have hp : PolyTimeComputable pairs :=
        polyTimeComputable_pairFstD.comp (polyTimeComputable_pairSndD.comp (polyTimeComputable_pairSndD.comp hc))
      have ho : PolyTimeComputable outs :=
        polyTimeComputable_pairSndD.comp (polyTimeComputable_pairSndD.comp (polyTimeComputable_pairSndD.comp hc))
      let vertex := fun z => BinArith.uHead (BinArith.getW (pairEncode (pairSndD z) (outs z)))
      have hvertex : PolyTimeComputable vertex :=
        BinArith.polyTimeComputable_uHead.comp
          (BinArith.polyTimeComputable_getW.comp (polyTimeComputable_pairSndD.pairEncode ho))
      let key := fun z => EnsembleLemmas.padL (pairFstD (ctx z)).length (BinArith.getW (pairEncode (vertex z) (vals z)))
      have hk0 :=
        EnsembleLemmas.polyTimeComputable_padL .var (u := fun z => pairFstD (ctx z)) (a := fun z =>
          BinArith.getW (pairEncode (vertex z) (vals z))) (polyTimeComputable_pairFstD.comp' hc)
          (BinArith.polyTimeComputable_getW.comp' (hvertex.pairEncode hv))
      have hk : PolyTimeComputable key := hk0.congr (g := key) fun z => by simp only [key, PolyExpr.eval_var]
      let pair := fun z => BinArith.getW (pairEncode (pairSndD z) (pairs z))
      have hpair : PolyTimeComputable pair :=
        BinArith.polyTimeComputable_getW.comp (polyTimeComputable_pairSndD.pairEncode hp)
      have heq0 : PolyTimeComputable fun z => [decide (key z = pairFstD (pair z))] :=
        (polyTimeComputable_pairEq.comp (hk.pairEncode (polyTimeComputable_pairFstD.comp hpair))).congr fun z => by
          simp only [Function.comp_apply, pairFstD_pairEncode, pairSndD_pairEncode]
      have heq1 : PolyTimeComputable fun z => [decide (key z = pairSndD (pair z))] :=
        (polyTimeComputable_pairEq.comp (hk.pairEncode (polyTimeComputable_pairSndD.comp hpair))).congr fun z => by
          simp only [Function.comp_apply, pairFstD_pairEncode, pairSndD_pairEncode]
      refine
        (polyTimeComputable_ite heq0 (polyTimeComputable_const [false]) heq1).congr (g := fun z => [outputBit z]) ?_
      intro z
      by_cases h : key z = pairFstD (pair z) <;>
          simp only [outputBit_eq, ctx, vals, pairs, outs, vertex, key, pair] at h ⊢ <;>
        simp only [h, decide_true, decide_false, Bool.true_eq_true, Bool.false_eq_true, if_true, if_false]
