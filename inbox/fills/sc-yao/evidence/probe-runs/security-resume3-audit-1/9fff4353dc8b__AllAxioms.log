SIGNATURE	TCSlib.Cryptography.SecureComputation.YaoHybridProof.BobProgram.output_poly	∀
  (inA inB outLen : Complexity.PolyExpr) (circ : (n : ℕ) → BoolCircuit.DAGCircuit (inA.eval n + inB.eval n))
