import Mathlib.RingTheory.MvPolynomial.Homogeneous
import Lean.Elab.Tactic.LibrarySearch

set_option maxHeartbeats 0
set_option relaxedAutoImplicit false
set_option autoImplicit false

open scoped BigOperators

namespace IoSprgOverlapProbe

example {σ τ σ' τ' R : Type*} [CommSemiring R] (e : σ ≃ σ') (f : τ ≃ τ')
    (p : MvPolynomial (σ ⊕ τ) R) :
    (MvPolynomial.rename (Sum.map e f) p).weightedTotalDegree
        (Sum.elim (fun _ : σ' => 1) (fun _ : τ' => 0)) =
      p.weightedTotalDegree (Sum.elim (fun _ : σ => 1) (fun _ : τ => 0)) := __PROBE_BODY__

end IoSprgOverlapProbe
