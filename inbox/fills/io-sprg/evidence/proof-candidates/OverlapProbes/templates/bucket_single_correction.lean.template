open scoped BigOperators

namespace IoSprgOverlapProbe

example {m B rc : ℕ} {R : Type*} [AddCommMonoid R] (φ : Fin m → Fin B)
    (pos : Fin m → Option (Fin rc × Fin rc)) (corr : Fin m → R) (j : Fin m)
    (c : Fin rc × Fin rc) (hj : pos j = some c)
    (hunique : ∀ i, φ i = φ j → pos i = some c → i = j) :
    (∑ i : Fin m, if φ i = φ j ∧ pos i = some c then corr i else 0) = corr j := __PROBE_BODY__

end IoSprgOverlapProbe
