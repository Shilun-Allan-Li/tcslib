by
  obtain ⟨f, hf, hgen⟩ := (P.qGenTarget_iff).mp hT
  rw [SPRG.Raw.hasComplexityEff_iff, jlsSPRG_raw_eq]
  refine ⟨f, hf, ?_⟩
  intro κ I
  refine ⟨P.G4 κ (π κ) I, ?_, ?_, ?_⟩
  · intro j
    simpa only [SPRG.Raw.encPP_eq, PrimeParam.enc_eq,
      PolyExpr.eval_add, PolyExpr.eval_var, PolyExpr.eval_const]
      using hgen κ (π κ) I j
  · exact fun j => P.G4_degrees κ (π κ) I j
  · have hsampler := jlsSPRG_raw_sdSamp P π κ I
    rw [jlsSPRG_raw_eq] at hsampler
    rw [hsampler]
    exact P.G4_seed_allOutputs κ (π κ) I
