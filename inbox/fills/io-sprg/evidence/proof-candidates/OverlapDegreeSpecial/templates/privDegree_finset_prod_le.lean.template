set_option autoImplicit false

open scoped BigOperators

namespace IoSprgDegreeSpecialOverlap

example {σ τ R ι : Type*} [CommSemiring R] (s : Finset ι)
    (q : ι → MvPolynomial (σ ⊕ τ) R) :
    (∏ i ∈ s, q i).weightedTotalDegree
      (Sum.elim (fun _ : σ => (0 : ℕ)) (fun _ : τ => (1 : ℕ))) ≤
        ∑ i ∈ s, (q i).weightedTotalDegree
          (Sum.elim (fun _ : σ => (0 : ℕ)) (fun _ : τ => (1 : ℕ))) := __PROBE_BODY__

end IoSprgDegreeSpecialOverlap
