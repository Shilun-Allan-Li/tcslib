import TCSlib.Cryptography.Games.Advantage
import Mathlib.Data.Finset.Max
import Lean.Elab.Tactic.LibrarySearch

set_option maxHeartbeats 100000
set_option relaxedAutoImplicit false
set_option autoImplicit false

open TCSlib.Cryptography TCSlib.Cryptography.Games

example (C : ℕ → ℕ → ProbComp Bool) :
    ∀ κ : ℕ, ∃ i : Fin (κ + 1), 0 < κ → i.val < κ ∧
      advantage (C κ 0) (C κ κ) ≤
        (κ : ℝ) * advantage (C κ i.val) (C κ (i.val + 1)) := __PROBE_BODY__
