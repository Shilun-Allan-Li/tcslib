import TCSlib.Cryptography.Obfuscation.StructuredSeed.Reductions.LPN.Defs
import Lean.Elab.Tactic.LibrarySearch

set_option maxHeartbeats 100000
set_option relaxedAutoImplicit false
set_option autoImplicit false

namespace TCSlib.Cryptography.Obfuscation.StructuredSeed

open Complexity Turing Games

namespace Internal

example (P : Params) (π : PrimeSchedule) (A B : NUPPT)
    (ω : ∀ L, P.LPNAdvice π L)
    (hB : B.RealizesOn (P.lpnEnc π) (A.coins.subst .var)
      (fun L x r => P.lpnRed π A L (ω L) x r))
    (L : ℕ) {σ : Type} [Fintype σ] (X : σ → P.LPNChal π L) :
    acceptProb X (fun x (r : B.Coins L) => B.distinguisherL L (P.lpnEnc π L x) r) =
      acceptProb X (fun x (r : A.Coins (P.kappaOf L)) =>
        decide (A.runAtL (P.kappaOf L) (P.lpnPre π L (ω L) x)
          (List.ofFn r) = [true]))
  := __PROBE_BODY__

end Internal

end TCSlib.Cryptography.Obfuscation.StructuredSeed
