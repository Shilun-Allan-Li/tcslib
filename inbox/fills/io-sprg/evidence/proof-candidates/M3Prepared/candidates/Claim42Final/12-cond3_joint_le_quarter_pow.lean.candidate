/- NOT_RUN. Proposed area-local Internal helper, dependency candidate11.
The joint event ignores SdSamp, then generator draw and matrix. All are
removed using existing expectation/product APIs; the bucket map retains its
actual uniform marginal. No claim of OracleComp syntax equality is made.
No new imports. Type-reader transport/elaboration and exact?/apply? pending. -/

theorem cond3_joint_le_quarter_pow (P : Params) (κ : ℕ)
    (pp : PrimeParam κ) (hκ : 12 ≤ κ) :
    Games.ProbComp.prob (P.jointLaw κ pp) (fun x => P.Cond3 κ pp x.1) ≤
      (P.B κ : ℝ) * (4 : ℝ)⁻¹ ^ κ := by
  classical
  rw [P.jointLaw_eq, Games.ProbComp.prob_eq_expect, Games.ProbComp.expect_bind]
  simp_rw [Games.ProbComp.expect_map, Games.ProbComp.expect_const]
  rw [← Games.ProbComp.prob_eq_expect, P.idSamp'_eq,
    Games.ProbComp.prob_eq_expect, Games.ProbComp.expect_map,
    ← Games.ProbComp.prob_eq_expect, Games.Bridge.prob_sample_eq_uprob]
  simp_rw [P.idCore_eq, P.cond3_iff, Buckets.overfull_iff]
  let GDraw := P.G.IdDraw (P.n κ)
  let Buck := Fin (P.m κ) → Fin (P.B κ)
  let Mat := Matrix (Fin (P.n κ)) (Fin (P.ℓ κ)) (ZMod pp.p)
  let q : Buck → Prop := fun φ => ∃ b, P.cap κ < Buckets.load φ b
  change uprob (fun z : GDraw × (Buck × Mat) => q z.2.1) ≤ _
  have hdrop : uprob (fun z : GDraw × (Buck × Mat) => q z.2.1) = uprob q :=
    (uprob_comp_equiv (Equiv.prodComm (Buck × Mat) GDraw)
      (fun z : GDraw × (Buck × Mat) => q z.2.1)).symm.trans
      ((uprob_fst (β := GDraw) (fun z : Buck × Mat => q z.1)).trans
        (uprob_fst (β := Mat) q))
  exact hdrop.le.trans (capacity_bucket_tail_quarter P κ hκ)
