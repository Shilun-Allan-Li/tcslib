/-- The JLS payload contains at least one (kappa+1)-bit public residue. -/
theorem jls_seedBits_lower (P : Params) (π : PrimeSchedule) (κ : ℕ) :
    κ + 1 ≤ (jlsSPRG_raw P π).seedBits κ := by
  rw [jls_seedBits_eq, Params.seedBitsAt_eq, Params.pubLen_eq]
  exact Nat.le_mul_of_pos_left (κ + 1)
    (Nat.lt_of_lt_of_le (Nat.zero_lt_succ (κ * P.n κ))
      (Nat.le_add_right (κ * P.n κ + 1) (P.privLen κ)))
