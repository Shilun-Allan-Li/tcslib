import TCSlib.Cryptography.Games.Bridges.Experiments
import TCSlib.Cryptography.OneWayFunctions.Basic
import Mathlib.Data.Finset.Powerset
import Lean.Elab.Tactic.LibrarySearch

set_option maxHeartbeats 0
set_option relaxedAutoImplicit false
set_option autoImplicit false

open TCSlib.Cryptography

example {I D : Type} [Fintype I] [Nonempty I] [Fintype D] [Nonempty D]
    (event : I × D → Prop) :
    Games.ProbComp.prob
      ((Games.ProbComp.sample I).bind fun i =>
        (Games.ProbComp.sample D).bind fun d => pure (i, d)) event = uprob event := __PROBE_BODY__
