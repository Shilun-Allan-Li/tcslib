+    (ω : P.PRGAdvice π N) (x : P.PRGChal N) (r : List Bool) :
+    P.prgRed π A N ω x r = A.runAtL (P.kappaOfN N) (P.prgPre π N ω x)
+      (r.take (A.coinLen (P.kappaOfN N))) := rfl
