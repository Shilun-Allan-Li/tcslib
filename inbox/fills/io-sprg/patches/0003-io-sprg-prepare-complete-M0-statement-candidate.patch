+/-- The preprocessing map has the stated schedule guard, explicit transports and layout; glue. -/
+theorem prgPre_eq (P : Params) (π : PrimeSchedule) (N : ℕ)
+    (ω : P.PRGAdvice π N) (x : P.PRGChal N) :
+    P.prgPre π N ω x =
