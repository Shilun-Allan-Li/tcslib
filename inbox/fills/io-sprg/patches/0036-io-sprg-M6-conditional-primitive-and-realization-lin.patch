+        fun κ I => hfail κ ⟨π κ, I⟩⟩
+  · exact (coreComputable_iff _ _ _ _).mpr
+      ⟨f, hf, fun κ I d => hcore κ ⟨π κ, I⟩ d⟩
 
 /-- T6 specializes to the sampler field of each raw LPN family; glue.
 
@@ -272,7 +332,14 @@ theorem lpnSamplerEfficient_of_target (P : Params) (π : PrimeSchedule)
       (fun L _ => (P.lpnFamily_raw π).sampleWord L)
       (fun L _ => (P.lpnFamily_raw π).encDraw L)
       (fun L _ => (P.lpnFamily_raw π).encSample L)
-      (fun L _ => (P.lpnFamily_raw π).sampleCore L) := sorry
+      (fun L _ => (P.lpnFamily_raw π).sampleCore L) := by
+  have hs := (P.lpnSamplerTarget_iff).mp hT
+  obtain ⟨U, c, e, he, hfail⟩ := (drawSamplable_iff _ _).mp hs.drawSamplable
+  obtain ⟨f, hf, hcore⟩ := (coreComputable_iff _ _ _ _).mp hs.coreComputable
