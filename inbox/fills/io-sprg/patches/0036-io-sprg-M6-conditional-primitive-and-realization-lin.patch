+  obtain ⟨U, c, e, he, hfail⟩ := (drawSamplable_iff _ _).mp hd
+  obtain ⟨f, hf, hcore⟩ := (coreComputable_iff _ _ _ _).mp hc
+  rw [jlsSPRG_raw_eq]
+  simp only [SPRG.Raw.sdWord_eq, SPRG.Raw.encPP_eq, SPRG.Raw.encSeed_eq,
