--- a/TCSlib/Cryptography/Obfuscation/StructuredSeed/Targets.lean
+++ b/TCSlib/Cryptography/Obfuscation/StructuredSeed/Targets.lean
@@ -230,13 +230,44 @@ Dv16 uses the shared layout-coin RealizesOn predicate and its public link theore
 Apply exists_realizesOn_of_preTarget with the inverse parameter map, polynomial var,
 the explicit advice encoding and length bound. Match the named reduction by its reader. -/
 theorem realizable_of_targets (P : Params) (hT : P.ReductionTargets) :
-    ∀ π : PrimeSchedule, P.Realizable π := sorry
+    ∀ π : PrimeSchedule, P.Realizable π := by
+  obtain ⟨hL, hG⟩ := (P.reductionTargets_iff).mp hT
+  obtain ⟨fL, hfL, hpreL⟩ := (P.lpnPreTarget_iff).mp hL
+  obtain ⟨fG, hfG, hpreG⟩ := (P.prgPreTarget_iff).mp hG
+  intro π
+  apply (P.realizable_iff π).mpr
+  constructor
+  · apply (P.LPNRealizable_iff π).mpr
+    intro A ω
+    obtain ⟨B, hB⟩ := NUPPT.exists_realizesOn_of_preTarget A P.kappaOf .var
+      (fun L : ℕ => (P.kappaOf_le L).trans (PolyExpr.eval_var L).ge)
+      (P.lpnEnc π) (P.encLPNAdvice π) (P.lpnPre π) hfL
+      (hpreL π) ω P.lpnAdviceBound
+      (fun L : ℕ => P.encLPNAdvice_length_le π L (ω L))
+    exact ⟨B, hB.congr (fun (L : ℕ) (x : P.LPNChal π L) (r : List Bool) _hr =>
+      (P.lpnRed_eq π A L (ω L) x r).symm)⟩
+  · apply (P.PRGRealizable_iff π).mpr
+    intro A ω
+    obtain ⟨B, hB⟩ := NUPPT.exists_realizesOn_of_preTarget A P.kappaOfN .var
+      (fun N : ℕ => (P.kappaOfN_le N).trans (PolyExpr.eval_var N).ge)
+      P.prgEnc (P.encPRGAdvice π) (P.prgPre π) hfG
+      (hpreG π) ω P.prgAdviceBound
+      (fun N : ℕ => P.encPRGAdvice_length_le π N (ω N))
+    exact ⟨B, hB.congr (fun (N : ℕ) (x : P.PRGChal N) (r : List Bool) _hr =>
+      (P.prgRed_eq π A N (ω N) x r).symm)⟩
 
 /-- T1 gives the raw evaluator's uniform efficiency; glue.
 
 **Proof sketch.** Specialize the target at pp=π κ and read the raw construction's encodings. -/
 theorem evalEfficient_of_target (P : Params) (π : PrimeSchedule) (hT : P.evalTarget) :
-    (jlsSPRG_raw P π).EvalEfficient := sorry
+    (jlsSPRG_raw P π).EvalEfficient := by
+  obtain ⟨f, hf, heval⟩ := (P.evalTarget_iff).mp hT
+  rw [SPRG.Raw.evalEfficient_iff, jlsSPRG_raw_eq]
+  refine ⟨f, hf, ?_⟩
+  intro κ I sd
+  simpa only [SPRG.Raw.encPP_eq, SPRG.Raw.encSeed_eq, Params.encSeed'_eq,
+    PrimeParam.enc_eq, PolyExpr.eval_add, PolyExpr.eval_var, PolyExpr.eval_const]
+    using heval κ (π κ) I sd
 
 /-- T3 and T5 give the exact index sampler's efficiency through the shared contract; glue.
 
@@ -248,7 +279,21 @@ theorem idSampEfficient_of_targets (P : Params) (π : PrimeSchedule)
       (fun κ _ => (jlsSPRG_raw P π).idWord κ)
       (fun κ _ => (jlsSPRG_raw P π).encIdDraw κ)
       (fun κ _ => (jlsSPRG_raw P π).encIdx κ)
-      (fun κ _ => (jlsSPRG_raw P π).idCore κ) := sorry
+      (fun κ _ => (jlsSPRG_raw P π).idCore κ) := by
+  have hc := ((P.coreTarget_iff).mp hC).1
+  have hd := ((P.drawSamplerTarget_iff).mp hD).1
+  simp only [Params.idWord_eq, PrimeParam.enc_eq] at hc hd
+  obtain ⟨U, c, e, he, hfail⟩ := (drawSamplable_iff _ _).mp hd
+  obtain ⟨f, hf, hcore⟩ := (coreComputable_iff _ _ _ _).mp hc
+  rw [jlsSPRG_raw_eq]
+  simp only [SPRG.Raw.idWord_eq, SPRG.Raw.encPP_eq,
+    PolyExpr.eval_add, PolyExpr.eval_var, PolyExpr.eval_const]
+  apply SamplesEfficiently.intro
+  · exact (drawSamplable_iff _ _).mpr
+      ⟨U, c, fun κ _ => e κ (π κ), fun κ _ w => he κ (π κ) w,
+        fun κ _ => hfail κ (π κ)⟩
+  · exact (coreComputable_iff _ _ _ _).mpr
+      ⟨f, hf, fun κ _ d => hcore κ (π κ) d⟩
 
 /-- T3 and T5 give the exact seed sampler's efficiency through the shared contract; glue.
 
@@ -260,7 +305,22 @@ theorem sdSampEfficient_of_targets (P : Params) (π : PrimeSchedule)
       (fun κ I => (jlsSPRG_raw P π).sdWord κ I)
       (fun κ I => (jlsSPRG_raw P π).encSdDraw κ I)
       (fun κ _ => (jlsSPRG_raw P π).encSeed κ)
-      (fun κ I => (jlsSPRG_raw P π).sdCore κ I) := sorry
