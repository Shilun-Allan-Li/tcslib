+      ⟨U, c, fun L _ => e L π, fun L _ w => he L π w, fun L _ => hfail L π⟩
+  · exact (coreComputable_iff _ _ _ _).mpr ⟨f, hf, fun L _ d => hcore L π d⟩
 
 /-- The construction's LPN primitive is assembled from its raw family and T6
 [JLS26, Definition 2.3, pp. 9-10]. Dv18 requires this efficiency witness for any instance. -/
@@ -291,7 +358,21 @@ theorem lpnFamily_toRaw (P : Params) (π : PrimeSchedule) (hT : P.Targets) :
 **Proof sketch.** Use G4 as the polynomial witness, the target's term-list equations,
 its degree theorem, and exact sampled-seed correctness. -/
 theorem hasComplexityEff_of_target (P : Params) (π : PrimeSchedule)
-    (hT : P.qGenTarget) : (jlsSPRG_raw P π).HasComplexityEff P.d 2 := sorry
+    (hT : P.qGenTarget) : (jlsSPRG_raw P π).HasComplexityEff P.d 2 := by
+  obtain ⟨f, hf, hgen⟩ := (P.qGenTarget_iff).mp hT
+  rw [SPRG.Raw.hasComplexityEff_iff, jlsSPRG_raw_eq]
+  refine ⟨f, hf, ?_⟩
+  intro κ I
+  refine ⟨P.G4 κ (π κ) I, ?_, ?_, ?_⟩
+  · intro j
+    simpa only [SPRG.Raw.encPP_eq, PrimeParam.enc_eq,
+      PolyExpr.eval_add, PolyExpr.eval_var, PolyExpr.eval_const]
+      using hgen κ (π κ) I j
+  · exact fun j => P.G4_degrees κ (π κ) I j
+  · have hsampler := jlsSPRG_raw_sdSamp P π κ I
+    simp only [jlsSPRG_raw_eq] at hsampler
+    rw [hsampler]
+    exact P.G4_seed_allOutputs κ (π κ) I
 
 end Params
 
@@ -321,7 +402,19 @@ theorem theorem41_of_targets (P : Params) (π : PrimeSchedule) {cLoc : ℕ} {τ
     (hE : E0 P.d (P.δ : ℝ) τ ≤ P.E) (hT : P.Targets)
     (hG : P.G.Secure) (hLPN : (P.lpnFamily_raw π).Assumption) :
     (jlsSPRG P π hT).Secure ∧ (jlsSPRG P π hT).HasComplexityEff P.d 2 ∧
-      (jlsSPRG P π hT).HasPolyStretch := sorry
+      (jlsSPRG P π hT).HasPolyStretch := by
+  have hR := P.realizable_of_targets hT.2.2.2.1 π
+  have hraw := theorem41 P π hLoc hτ hs hE hR hG hLPN
+  refine ⟨?_, ?_, ?_⟩
+  · apply (SPRG.secure_iff (jlsSPRG P π hT)).mpr
+    rw [jlsSPRG_toRaw]
+    exact hraw.1
+  · apply (SPRG.hasComplexityEff_iff (jlsSPRG P π hT) P.d 2).mpr
+    rw [jlsSPRG_toRaw]
+    exact P.hasComplexityEff_of_target π hT.2.1
+  · apply (SPRG.hasPolyStretch_iff (jlsSPRG P π hT)).mpr
+    rw [jlsSPRG_toRaw]
+    exact hraw.2.2
 
 /-- Under the efficiency targets an efficient secure sPRG exists
 [JLS26, Theorem 4.1, p. 11]. Dv3 uses the construction's own LPN families; Dv18
@@ -338,7 +431,17 @@ theorem exists_sprg_of_targets {d cLoc : ℕ} (hd : 1 ≤ d) {δ : ℚ} {τ : 
       (Params.lpnFamily_raw ⟨d, hd, δ, hδ, hδ1, E, hE, G, R⟩ π).Assumption)
     (hT : ∀ P : Params, P.Targets) :
     ∃ S : SPRG, (∀ κ, S.modulus κ = (π κ).p) ∧ S.Secure ∧
-      S.HasComplexityEff d 2 ∧ S.HasPolyStretch := sorry
+      S.HasComplexityEff d 2 ∧ S.HasPolyStretch := by
+  let E := max 1 (E0 d (δ : ℝ) τ)
+  have hE1 : 1 ≤ E := le_max_left _ _
+  let P : Params := ⟨d, hd, δ, hδ, hδ1, E, hE1, G, R⟩
+  let hTP : P.Targets := hT P
+  have hEb : E0 P.d (P.δ : ℝ) τ ≤ P.E := le_max_right _ _
+  have hall := theorem41_of_targets P π hLoc hτ hs hEb hTP hG (hLPN E hE1)
+  refine ⟨jlsSPRG P π hTP, ?_, hall⟩
+  intro κ
+  exact (congrArg (fun S : SPRG.Raw => S.modulus κ) (jlsSPRG_toRaw P π hTP)).trans
+    (jlsSPRG_raw_modulus P π κ)
 
 /-- Under the targets and subexponential assumptions an efficient subexponentially secure
 sPRG exists [JLS26, Theorem 4.1, p. 11]. Dv13 bounds advantage against NUPPT;
@@ -354,6 +457,29 @@ theorem exists_sprg_of_targets_subexp {d cLoc : ℕ} (hd : 1 ≤ d) {δ : ℚ} {
       SubexpHard (Params.lpnFamily_raw ⟨d, hd, δ, hδ, hδ1, E, hE, G, R⟩ π).adv)
     (hT : ∀ P : Params, P.Targets) :
     ∃ S : SPRG, (∀ κ, S.modulus κ = (π κ).p) ∧ SubexpHard S.adv ∧
-      S.HasComplexityEff d 2 ∧ S.HasPolyStretch := sorry
+      S.HasComplexityEff d 2 ∧ S.HasPolyStretch := by
+  let E := max 1 (E0 d (δ : ℝ) τ)
+  have hE1 : 1 ≤ E := le_max_left _ _
+  let P : Params := ⟨d, hd, δ, hδ, hδ1, E, hE1, G, R⟩
+  let hTP : P.Targets := hT P
+  have hEb : E0 P.d (P.δ : ℝ) τ ≤ P.E := le_max_right _ _
+  have hR := P.realizable_of_targets hTP.2.2.2.1 π
+  have hraw := theorem41_subexp P π hLoc hτ hs hEb hR hG (hLPN E hE1)
+  refine ⟨jlsSPRG P π hTP, ?_, ?_, ?_, ?_⟩
+  · intro κ
+    exact (congrArg (fun S : SPRG.Raw => S.modulus κ) (jlsSPRG_toRaw P π hTP)).trans
+      (jlsSPRG_raw_modulus P π κ)
+  · have hadv : (jlsSPRG P π hTP).adv = (jlsSPRG_raw P π).adv :=
+      funext (fun A => funext (fun κ =>
+        (SPRG.adv_eq (jlsSPRG P π hTP) A κ).trans
+          (congrArg (fun S : SPRG.Raw => S.adv A κ) (jlsSPRG_toRaw P π hTP))))
+    rw [hadv]
+    exact hraw.1
+  · apply (SPRG.hasComplexityEff_iff (jlsSPRG P π hTP) d 2).mpr
+    rw [jlsSPRG_toRaw]
+    exact P.hasComplexityEff_of_target π hTP.2.1
+  · apply (SPRG.hasPolyStretch_iff (jlsSPRG P π hTP)).mpr
+    rw [jlsSPRG_toRaw]
+    exact hraw.2.2
 
 end TCSlib.Cryptography.Obfuscation.StructuredSeed
