From 4efedfad01b049abd1a393e1c449c6e49552119a Mon Sep 17 00:00:00 2001
From: Seyoon Ragavan <complexzetaprime@gmail.com>
Date: Wed, 18 Nov 2026 03:01:06 -0800
Subject: [PATCH 09/25] io-sprg: repair sampler readers under canonical seals

---
 .../Obfuscation/StructuredSeed/Samplers.lean  | 31 ++++++++++---------
 1 file changed, 17 insertions(+), 14 deletions(-)

diff --git a/TCSlib/Cryptography/Obfuscation/StructuredSeed/Samplers.lean b/TCSlib/Cryptography/Obfuscation/StructuredSeed/Samplers.lean
index 863f548912a0a1cd3629a8983773b034f24a71be..d88239dd89b97906c97d8733012305810f05586c 100644
--- a/TCSlib/Cryptography/Obfuscation/StructuredSeed/Samplers.lean
+++ b/TCSlib/Cryptography/Obfuscation/StructuredSeed/Samplers.lean
@@ -356,13 +356,13 @@ noncomputable def jlsSPRG_raw (P : Params) (π : PrimeSchedule) : SPRG.Raw where
   residueBits := .add .var (.const 1)
   modulus_le_pow κ := Params.primeWidthBound κ (π κ)
   Idx κ := P.Idx' κ (π κ)
-  idxFintype κ := inferInstance
-  idxNonempty κ := inferInstance
+  idxFintype _κ := inferInstance
+  idxNonempty _κ := inferInstance
   idxCard κ := P.idxCard κ (π κ)
   idxEquiv κ := P.idxEquiv κ (π κ)
   IdDraw κ := P.IdDraw κ (π κ)
-  idDrawFintype κ := inferInstance
-  idDrawNonempty κ := inferInstance
+  idDrawFintype _κ := inferInstance
+  idDrawNonempty _κ := inferInstance
   idDrawCard κ := P.idDrawCard κ (π κ)
   idDrawEquiv κ := P.idDrawEquiv κ (π κ)
   idCore κ := P.idCore κ (π κ)
@@ -381,8 +381,8 @@ noncomputable def jlsSPRG_raw (P : Params) (π : PrimeSchedule) : SPRG.Raw where
   privLen_le := P.privLen_le_seedBound
   outLen_le := P.m_le_mBound
   SdDraw κ _ := P.Draw κ (π κ)
-  sdDrawFintype κ _ := inferInstance
-  sdDrawNonempty κ _ := inferInstance
+  sdDrawFintype _κ _ := inferInstance
+  sdDrawNonempty _κ _ := inferInstance
   sdDrawCard κ _ := P.drawCard κ (π κ)
   sdDrawEquiv κ _ := P.drawEquiv κ (π κ)
   sdCore κ I d := (P.sdCore κ (π κ) I d).seed
@@ -402,13 +402,13 @@ theorem jlsSPRG_raw_eq (P : Params) (π : PrimeSchedule) :
   residueBits := .add .var (.const 1)
   modulus_le_pow κ := Params.primeWidthBound κ (π κ)
   Idx κ := P.Idx' κ (π κ)
-  idxFintype κ := inferInstance
-  idxNonempty κ := inferInstance
+  idxFintype _κ := inferInstance
+  idxNonempty _κ := inferInstance
   idxCard κ := P.idxCard κ (π κ)
   idxEquiv κ := P.idxEquiv κ (π κ)
   IdDraw κ := P.IdDraw κ (π κ)
-  idDrawFintype κ := inferInstance
-  idDrawNonempty κ := inferInstance
+  idDrawFintype _κ := inferInstance
+  idDrawNonempty _κ := inferInstance
   idDrawCard κ := P.idDrawCard κ (π κ)
   idDrawEquiv κ := P.idDrawEquiv κ (π κ)
   idCore κ := P.idCore κ (π κ)
@@ -427,8 +427,8 @@ theorem jlsSPRG_raw_eq (P : Params) (π : PrimeSchedule) :
   privLen_le := P.privLen_le_seedBound
   outLen_le := P.m_le_mBound
   SdDraw κ _ := P.Draw κ (π κ)
-  sdDrawFintype κ _ := inferInstance
-  sdDrawNonempty κ _ := inferInstance
+  sdDrawFintype _κ _ := inferInstance
+  sdDrawNonempty _κ _ := inferInstance
   sdDrawCard κ _ := P.drawCard κ (π κ)
   sdDrawEquiv κ _ := P.drawEquiv κ (π κ)
   sdCore κ I d := (P.sdCore κ (π κ) I d).seed
@@ -501,8 +501,10 @@ theorem jlsSPRG_raw_eval (P : Params) (π : PrimeSchedule) (κ : ℕ)
 **Proof sketch.** Read the raw sampler and concrete sampler equations, then use the
 raw construction's index-draw and core fields. -/
 theorem jlsSPRG_raw_idSamp (P : Params) (π : PrimeSchedule) (κ : ℕ) :
-    (jlsSPRG_raw P π).idSamp κ = P.idSamp' κ (π κ) :=
-  (SPRG.Raw.idSamp_eq (jlsSPRG_raw P π) κ).trans rfl
+    (jlsSPRG_raw P π).idSamp κ = P.idSamp' κ (π κ) := by
+  rw [SPRG.Raw.idSamp_eq]
+  simp only [SPRG.Raw.instIdDrawFintype_eq]
+  rfl
 
 /-- The raw seed sampler equals SdSamp'; glue.
 
@@ -511,6 +513,7 @@ theorem jlsSPRG_raw_sdSamp (P : Params) (π : PrimeSchedule) (κ : ℕ)
     (I : P.Idx' κ (π κ)) :
     (jlsSPRG_raw P π).sdSamp κ I = P.sdSamp' κ (π κ) I := by
   rw [SPRG.Raw.sdSamp_eq, Params.sdSamp'_eq, Params.sdSampFull_eq, ← comp_map]
+  simp only [SPRG.Raw.instSdDrawFintype_eq]
   rfl
 
 /-- The raw challenge's modulus prefix equals the input prime encoding; glue.
