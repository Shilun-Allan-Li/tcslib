 /-- Weighted degree of a sum is at most the maximum of the summands' degrees.
 Mathematical glue for [JLS26, §4, p. 17].
 
-**Proof sketch.** Bound the support by the union and use `le_weightedTotalDegree`. -/
+**Proof sketch.** Apply the published support-degree addition bound to the
+`Finsupp.weight` map; weighted total degree is its support supremum. -/
 theorem weightedTotalDegree_add_le (w : σ → ℕ) (q r : MvPolynomial σ R) :
     (q + r).weightedTotalDegree w ≤ max (q.weightedTotalDegree w)
-      (r.weightedTotalDegree w) := sorry
+      (r.weightedTotalDegree w) :=
+  show (q + r).support.sup (Finsupp.weight w) ≤
+      q.support.sup (Finsupp.weight w) ⊔ r.support.sup (Finsupp.weight w) from
+    AddMonoidAlgebra.sup_support_add_le (Finsupp.weight w) q r
 
 /-- Weighted degree of a product is at most the sum of the factors' degrees.
 Mathematical glue for [JLS26, §4, p. 17].
 
-**Proof sketch.** Split monomials by `support_mul` and add their `Finsupp.weight`s. -/
+**Proof sketch.** Apply the published support-degree multiplication bound with the
+additive `Finsupp.weight` map. Its existing map-add equation supplies subadditivity. -/
 theorem weightedTotalDegree_mul_le (w : σ → ℕ) (q r : MvPolynomial σ R) :
     (q * r).weightedTotalDegree w ≤ q.weightedTotalDegree w +
-      r.weightedTotalDegree w := sorry
+      r.weightedTotalDegree w :=
+  show (q * r).support.sup (Finsupp.weight w) ≤
+      q.support.sup (Finsupp.weight w) + r.support.sup (Finsupp.weight w) from
+    AddMonoidAlgebra.sup_support_mul_le
+      (fun a b => (map_add (Finsupp.weight w) a b).le) q r
 
 /-- A finite sum of polynomials of weighted degree at most `d` has degree at most `d`.
 Mathematical glue for [JLS26, §4, p. 17].
 
-**Proof sketch.** Induct on the finite set using the zero and addition bounds. -/
+**Proof sketch.** Use the published supremum bound for a sum of supported
+polynomials, then apply the supplied pointwise bound to that finite supremum. -/
 theorem weightedTotalDegree_finset_sum_le (w : σ → ℕ) (s : Finset ι)
     (q : ι → MvPolynomial σ R) (d : ℕ)
     (h : ∀ i ∈ s, (q i).weightedTotalDegree w ≤ d) :
-    (∑ i ∈ s, q i).weightedTotalDegree w ≤ d := sorry
+    (∑ i ∈ s, q i).weightedTotalDegree w ≤ d :=
+  show (∑ i ∈ s, q i).support.sup (Finsupp.weight w) ≤ d from
+    (AddMonoidAlgebra.supDegree_sum_le
+      (D := Finsupp.weight w) (s := s) (f := q)).trans
+        (Finset.sup_le h)
 
 /-- A finite product has weighted degree at most the sum of the factors' degrees.
 Mathematical glue for [JLS26, §4, p. 17].
 
-**Proof sketch.** Induct on the finite set using the multiplication bound. -/
+**Proof sketch.** Apply the published finite-product support-degree bound. The
+existing zero and addition equations of `Finsupp.weight` discharge its map hypotheses. -/
 theorem weightedTotalDegree_finset_prod_le (w : σ → ℕ) (s : Finset ι)
     (q : ι → MvPolynomial σ R) :
-    (∏ i ∈ s, q i).weightedTotalDegree w ≤ ∑ i ∈ s, (q i).weightedTotalDegree w := sorry
+    (∏ i ∈ s, q i).weightedTotalDegree w ≤ ∑ i ∈ s, (q i).weightedTotalDegree w :=
+  show (∏ i ∈ s, q i).support.sup (Finsupp.weight w) ≤
+      ∑ i ∈ s, (q i).support.sup (Finsupp.weight w) from
+    AddMonoidAlgebra.supDegree_prod_le (D := Finsupp.weight w)
+      (map_zero (Finsupp.weight w)) (map_add (Finsupp.weight w))
 
 /-- Constants have weighted degree zero, `weightedTotalDegree w (C a) = 0`.
 Mathematical glue for [JLS26, §4, p. 17].
 
-**Proof sketch.** Only the zero monomial can occur in the support. -/
+**Proof sketch.** Reuse weighted homogeneity of a constant and the published
+equivalence between homogeneity of weight zero and weighted degree zero. -/
 theorem weightedTotalDegree_C (w : σ → ℕ) (a : R) :
-    (MvPolynomial.C a : MvPolynomial σ R).weightedTotalDegree w = 0 := sorry
+    (MvPolynomial.C a : MvPolynomial σ R).weightedTotalDegree w = 0 :=
+  (MvPolynomial.isWeightedHomogeneous_zero_iff_weightedTotalDegree_eq_zero
+    (w := w)).mp (MvPolynomial.isWeightedHomogeneous_C w a)
 
 /-- A variable's weighted degree is at most its weight, also over the zero ring.
 Mathematical glue for [JLS26, §4, p. 17].
 
-**Proof sketch.** Bound its singleton support and evaluate the monomial weight. -/
+**Proof sketch.** Use weighted homogeneity of X to bound every supported
+monomial, then apply the published finite-supremum bound. -/
 theorem weightedTotalDegree_X_le (w : σ → ℕ) (i : σ) :
-    (MvPolynomial.X i : MvPolynomial σ R).weightedTotalDegree w ≤ w i := sorry
+    (MvPolynomial.X i : MvPolynomial σ R).weightedTotalDegree w ≤ w i :=
+  show (MvPolynomial.X i : MvPolynomial σ R).support.sup (Finsupp.weight w) ≤ w i from
+    Finset.sup_le fun d hd =>
+      ((MvPolynomial.isWeightedHomogeneous_X R w i)
+        (MvPolynomial.mem_support_iff.mp hd)).le
 
 end Internal
 
