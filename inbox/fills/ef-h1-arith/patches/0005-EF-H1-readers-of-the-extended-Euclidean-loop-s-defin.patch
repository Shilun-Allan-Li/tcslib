     xgcdLoopStep (xgcdState b r' r ((s' % b).toNat) ((s % b).toNat)) =
       xgcdState b r (r' % r) ((s % b).toNat) (((s' - (r' / r : ℕ) * s) % b).toNat) := by
-  rw [xgcdLoopStep, xgcdCoefStep, xgcdState_eq, xgcdState_eq]
