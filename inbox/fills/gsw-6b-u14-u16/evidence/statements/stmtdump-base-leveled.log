TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.leveledEval_eq : ∀
  (P : TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.Parameters) {L k : ℕ}
  (lk : Fin L → Fin P.columns → TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.Ciphertext P)
  (Cc : BoolCircuit.DAGCircuit (k + k))
  (cts : Fin (k + k) → TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.Ciphertext P),
  TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.leveledEval P lk Cc cts =
    (BoolCircuit.runWith
          (fun (g : BoolCircuit.DAGGate)
              (vs : List (TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.Ciphertext P)) =>
            TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.levelGate P lk (Cc.depthAt vs.length) g vs)
          Cc.gates (List.ofFn cts)).getD
      Cc.output 0
