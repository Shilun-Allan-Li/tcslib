+**Proof sketch.** Regroup the seeds `(rg, R, R₀)` as `((rg, R₀), R)`, the bijection
+`Seeds P χ ≃ (KeySeed P χ × Coins P) × (Fin N → Coins P)` built from `Equiv.prodComm` and
+`Equiv.prodAssoc`. Through `fheView_fst`, `fheView_snd`, `Regev.keygen_fst`, `realView_eq` and
+`view_eq`, the projected view at `(rg, R, R₀)` is `realView P χ μ (rg, R₀)`, the first factor
+only: it does not read the evaluation-key coins `R`. So `acceptProb_comp_equiv` and
+`acceptProb_fst` (the unused factor dropped) make each `acceptProb` that of `realView P χ μ`.
+Then `distAdv_def` and phase 5's `distAdv_encrypt_le`. -/
 theorem distAdv_fheView_noEvk_le (P : Parameters) (χ : LWE.Noise) {ρ : Type*} [Fintype ρ]
     [Nonempty ρ] (μ₀ μ₁ : Bool) (D : PublicKey P × Ciphertext P → ρ → Bool) :
     distAdv (fun r : Seeds P χ => ((fheView P χ μ₀ r).1, (fheView P χ μ₀ r).2.2))
@@ -144,6 +143,19 @@ theorem distAdv_fheView_noEvk_le (P : Parameters) (χ : LWE.Noise) {ρ : Type*}
       LWE.decisionAdvantage P.lwe χ (reduction P μ₀ D) +
         LWE.decisionAdvantage P.lwe χ (reduction P μ₁ D) +
         2 * (P.columns * Regev.extractionError P.lwe) := by
-  sorry
+  -- Regroup `(rg, R, R₀)` as `((rg, R₀), R)`; the projected view reads only the first factor.
+  let e : Seeds P χ ≃ (KeySeed P χ × Coins P) × (Fin P.columns → Coins P) :=
+    ((Equiv.refl (KeySeed P χ)).prodCongr (Equiv.prodComm _ _)).trans (Equiv.prodAssoc _ _ _).symm
+  have hview : ∀ μ : Bool, acceptProb (fun r : Seeds P χ =>
+      ((fheView P χ μ r).1, (fheView P χ μ r).2.2)) D = acceptProb (realView P χ μ) D := by
+    intro μ
+    have hfun : (fun r : Seeds P χ => ((fheView P χ μ r).1, (fheView P χ μ r).2.2)) =
+        fun r => realView P χ μ (e r).1 := by
+      funext r
+      rw [fheView_fst, fheView_snd, realView_eq, view_eq, Regev.keygen_fst]
+      rfl
+    rw [hfun, acceptProb_comp_equiv e (fun z => realView P χ μ z.1) D, acceptProb_fst]
+  rw [distAdv_def, hview, hview, ← distAdv_def]
+  exact distAdv_encrypt_le P χ μ₀ μ₁ D
 
