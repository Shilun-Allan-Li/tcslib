                        fun res => TCSlib.Cryptography.Games.OracleComp.pure (res.1 0))
            fun x => x = Bool.true) =
          TCSlib.Cryptography.Games.ProbComp.prob
            (TCSlib.Cryptography.Games.OracleComp.bind (TCSlib.Cryptography.Games.ProbComp.sample { x // x ≠ 1 })
