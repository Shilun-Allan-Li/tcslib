  TCSlib.Cryptography.LWE.BitEncoding.distance P (x + a) (y + a) = TCSlib.Cryptography.LWE.BitEncoding.distance P x y
  CONSTS [TCSlib.Cryptography.LWE.Parameters, TCSlib.Cryptography.LWE.Parameters.modulus, TCSlib.Cryptography.LWE.BitEncoding.distance]
TCSlib.Cryptography.LWE.BitEncoding.distance_codepoints	theorem	TCSlib.Cryptography.LWE.BitEncoding
  : ∀ (P : TCSlib.Cryptography.LWE.Parameters),
  TCSlib.Cryptography.LWE.BitEncoding.distance P (TCSlib.Cryptography.LWE.BitEncoding.codepoint P Bool.false)
      (TCSlib.Cryptography.LWE.BitEncoding.codepoint P Bool.true) =
    P.modulus / 2
  CONSTS [TCSlib.Cryptography.LWE.Parameters, TCSlib.Cryptography.LWE.BitEncoding.distance, TCSlib.Cryptography.LWE.BitEncoding.codepoint, TCSlib.Cryptography.LWE.Parameters.modulus]
TCSlib.Cryptography.LWE.BitEncoding.distance_eq	theorem	TCSlib.Cryptography.LWE.BitEncoding
  : ∀ (P : TCSlib.Cryptography.LWE.Parameters) (x y : ZMod P.modulus),
  TCSlib.Cryptography.LWE.BitEncoding.distance P x y = (x - y).valMinAbs.natAbs
  CONSTS [TCSlib.Cryptography.LWE.Parameters, TCSlib.Cryptography.LWE.Parameters.modulus, TCSlib.Cryptography.LWE.BitEncoding.distance]
TCSlib.Cryptography.LWE.BitEncoding.distance_intCast_zero_le	theorem	TCSlib.Cryptography.LWE.BitEncoding
  : ∀ (P : TCSlib.Cryptography.LWE.Parameters) (e : ℤ), TCSlib.Cryptography.LWE.BitEncoding.distance P (↑e) 0 ≤ e.natAbs
  CONSTS [TCSlib.Cryptography.LWE.Parameters, TCSlib.Cryptography.LWE.BitEncoding.distance, TCSlib.Cryptography.LWE.Parameters.modulus]
TCSlib.Cryptography.LWE.BitEncoding.distance_symm	theorem	TCSlib.Cryptography.LWE.BitEncoding
  : ∀ (P : TCSlib.Cryptography.LWE.Parameters) (x y : ZMod P.modulus),
  TCSlib.Cryptography.LWE.BitEncoding.distance P x y = TCSlib.Cryptography.LWE.BitEncoding.distance P y x
  CONSTS [TCSlib.Cryptography.LWE.Parameters, TCSlib.Cryptography.LWE.Parameters.modulus, TCSlib.Cryptography.LWE.BitEncoding.distance]
TCSlib.Cryptography.LWE.BitEncoding.distance_triangle	theorem	TCSlib.Cryptography.LWE.BitEncoding
  : ∀ (P : TCSlib.Cryptography.LWE.Parameters) (x y z : ZMod P.modulus),
  TCSlib.Cryptography.LWE.BitEncoding.distance P x z ≤
    TCSlib.Cryptography.LWE.BitEncoding.distance P x y + TCSlib.Cryptography.LWE.BitEncoding.distance P y z
  CONSTS [TCSlib.Cryptography.LWE.Parameters, TCSlib.Cryptography.LWE.Parameters.modulus, TCSlib.Cryptography.LWE.BitEncoding.distance]
TCSlib.Cryptography.LWE.Family.RatioBounded	def	TCSlib.Cryptography.LWE.Ratio
  : TCSlib.Cryptography.LWE.Family → (ℕ → ℕ) → Complexity.PolyExpr → Prop
  CONSTS [TCSlib.Cryptography.LWE.Family, Complexity.PolyExpr]
TCSlib.Cryptography.LWE.Family.ratioBounded_iff	theorem	TCSlib.Cryptography.LWE.Ratio
  : ∀ (F : TCSlib.Cryptography.LWE.Family) (B : ℕ → ℕ) (p : Complexity.PolyExpr),
  F.RatioBounded B p ↔ ∀ (κ : ℕ), (F.noise κ).Bounded (B κ) ∧ (F.parameters κ).modulus ≤ p.eval κ * B κ
  CONSTS [TCSlib.Cryptography.LWE.Family, Complexity.PolyExpr, TCSlib.Cryptography.LWE.Family.RatioBounded, TCSlib.Cryptography.LWE.Noise.Bounded, TCSlib.Cryptography.LWE.Family.noise, TCSlib.Cryptography.LWE.Parameters.modulus, TCSlib.Cryptography.LWE.Family.parameters, Complexity.PolyExpr.eval]
