    (P.lwe.dimension + 1) * w + 2 * κ ≤ P.lwe.samples →
      ∀
        (D :
          (Matrix (Fin P.lwe.samples) (Fin P.lwe.dimension) (ZMod P.lwe.modulus) ×
                (Fin P.lwe.samples → ZMod P.lwe.modulus)) ×
              Ciphertext P →
            ρ → Bool),
        distAdv (realView P χ μ₀) (realView P χ μ₁) D ≤
          decisionAdvantage P.lwe χ (reduction P μ₀ D) + decisionAdvantage P.lwe χ (reduction P μ₁ D) +
            ↑P.columns * 2⁻¹ ^ κ
distAdv_levelHybrid_le : ∀ (P : Parameters) (χ : Noise) (L : ℕ) (μ : Bool) (e : Fin L) {ρ : Type u_1} [inst : Fintype ρ]
  [inst_1 : Nonempty ρ] (D : LeveledView P L → ρ → Bool),
  distAdv (levelHybrid P χ L μ (↑e + 1)) (levelHybrid P χ L μ ↑e) D ≤ ∑ j, levelTerm P χ L μ e j D
distAdv_leveledView_le : ∀ (P : Parameters) (χ : Noise) (L : ℕ) (μ₀ μ₁ : Bool) {ρ : Type u_1} [inst : Fintype ρ]
  [inst_1 : Nonempty ρ] (D : LeveledView P L → ρ → Bool),
  distAdv (leveledView P χ L μ₀) (leveledView P χ L μ₁) D ≤
    ∑ e, ∑ j, (levelTerm P χ L μ₀ e j D + levelTerm P χ L μ₁ e j D) + challengeTerm P χ L μ₀ μ₁ D
@distAdv_multi_le_sum : ∀ {κ : Type u_1} {π : Type u_2} {μ : Type u_3} {γ : Type u_4} {ρ : Type u_5} {ρ' : Type u_6}
