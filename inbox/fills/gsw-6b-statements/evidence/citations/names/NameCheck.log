  (m m' : Fin (q + 1) → μ) (D : π × (Fin (q + 1) → γ) → ρ' → Bool),
  distAdv (fun z => (P z.1, fun i => E (P z.1) (m i) (z.2 i))) (fun z => (P z.1, fun i => E (P z.1) (m' i) (z.2 i))) D ≤
    ∑ j,
      distAdv (fun z => (P z.1, E (P z.1) (m j) z.2)) (fun z => (P z.1, E (P z.1) (m' j) z.2)) (hybridPlant E m m' j D)
