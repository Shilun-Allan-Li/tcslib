@distAdv_def : ∀ {ρ : Type u_1} {σ : Type u_2} {τ : Type u_3} {γ : Type u_4} [inst : Fintype ρ] [inst_1 : Fintype σ]
  [inst_2 : Fintype τ] (X : σ → γ) (Y : τ → γ) (D : γ → ρ → Bool), distAdv X Y D = |acceptProb X D - acceptProb Y D|
@distAdv_encrypt_le : ∀ {ρ : Type u_1} [inst : Fintype ρ] [inst_1 : Nonempty ρ] (P : Parameters) (χ : Noise)
  (μ₀ μ₁ : Bool)
  (D :
    (Matrix (Fin P.lwe.samples) (Fin P.lwe.dimension) (ZMod P.lwe.modulus) × (Fin P.lwe.samples → ZMod P.lwe.modulus)) ×
        Ciphertext P →
      ρ → Bool),
  distAdv (realView P χ μ₀) (realView P χ μ₁) D ≤
    decisionAdvantage P.lwe χ (reduction P μ₀ D) + decisionAdvantage P.lwe χ (reduction P μ₁ D) +
      2 * (↑P.columns * Regev.extractionError P.lwe)
