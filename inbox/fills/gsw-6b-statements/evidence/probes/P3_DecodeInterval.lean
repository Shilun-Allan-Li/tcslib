/-- Mismatches of the interval test against `decode`, over every residue of `q`. -/
def mismatches (q : ℕ) (h : 2 ≤ q) : ℕ :=
  ((List.range q).filter fun a =>
    decode (LP q h) (a : ZMod q) !=
      decide (decodeLo (LP q h) ≤ (a : ZMod q).val ∧ (a : ZMod q).val < decodeHi (LP q h))).length

/-- Total mismatches over `lo ≤ q ≤ hi`, and the number of moduli checked. -/
def sweep (lo hi : ℕ) : ℕ × ℕ :=
  (List.range (hi + 1 - lo)).foldl (fun acc i =>
    let q := lo + i
    if h : 2 ≤ q then (acc.1 + mismatches q h, acc.2 + 1) else acc) (0, 0)

end P3

