+images paired with its secret serialization [PS10, Protocol 137.1]. -/
+theorem lamportGenFun_table (n : ℕ) (T : LamportFill.Table n) :
+    lamportGenFun E (NUPPT.layout (List.replicate n true) [] [] (LamportFill.secretWord T)) =
