+-/
+import TCSlib.Cryptography.Authentication.Signatures.Defs
+import TCSlib.Cryptography.Asymptotic.OneWay
+
+set_option maxHeartbeats 0
+set_option relaxedAutoImplicit false
+set_option autoImplicit false
