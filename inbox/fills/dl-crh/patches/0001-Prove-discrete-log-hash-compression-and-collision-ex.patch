+      listToNat (natToList n (u : ZMod (dlP i)).val) < dlP i
+  rw [length_natToList, listToNat_natToList hval]
+  exact ⟨rfl, lt_of_lt_of_le Nat.zero_lt_one hu.1, ZMod.val_lt _⟩
+
