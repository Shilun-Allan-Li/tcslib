+    prob (simulate impl c s) (fun r => bad r.2) ≤ m * (sz s + m) * δ := by
+  induction c generalizing m s with
+  | pure a =>
+    rw [simulate_pure, prob_pure, if_neg hs]
+    exact mul_nonneg (by positivity) hδ
