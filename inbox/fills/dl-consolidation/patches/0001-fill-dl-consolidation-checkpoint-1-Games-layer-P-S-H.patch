+    (O : QueryImpl (bitSpec ins' outs') σ unifSpec) (i : Fin k) (x : Fin (ins i) → Bool)
+    (s : σ) :
+    castImpl (ins := ins) (outs := outs) O i x s =
+      (O i (padFin (ins' i) (List.ofFn x)) s).bind fun p =>
+        .pure (padFin (outs i) (List.ofFn p.1), p.2) :=
