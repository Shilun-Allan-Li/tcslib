+    P.lwe.modulus (LWE.BitEncoding.decodeLo P.lwe) (LWE.BitEncoding.decodeHi P.lwe)
+  have h₂ := FormulaArith.depth_modSumInterval_le (fun i => (decConstants P C₂ i).val)
