TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.vecMul_secretVector_eq_sum : ∀
  (P : TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.Parameters) (s : Fin P.lwe.dimension → ZMod P.lwe.modulus)
  (C : TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.Ciphertext P),
  TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.secretVector P s ⬝ᵥ
      TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.decryptColumn P C =
    ∑ i : Fin P.columns,
      ↑(TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.keyBits P s i).toNat *
        TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.decConstants P C i
TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.decryptFormula_eval : ∀
  (P : TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.Parameters) (s : Fin P.lwe.dimension → ZMod P.lwe.modulus)
  (C : TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.Ciphertext P),
  (TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.decryptFormula P C).eval
      (TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.keyBits P s) =
    TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.decrypt P s C
TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.nandFormula_eval : ∀
  (P : TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.Parameters) (s : Fin P.lwe.dimension → ZMod P.lwe.modulus)
  (C₁ C₂ : TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.Ciphertext P),
  (TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.nandFormula P C₁ C₂).eval
      (TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.keyBits P s) =
    !(TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.decrypt P s C₁ &&
        TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.decrypt P s C₂)
