  TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.Ciphertext P →
    TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.Ciphertext P → BoolCircuit.TreeCircuit P.columns
TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.nandFormula_eq : ∀
  (P : TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.Parameters)
  (C₁ C₂ : TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.Ciphertext P),
  TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.nandFormula P C₁ C₂ =
