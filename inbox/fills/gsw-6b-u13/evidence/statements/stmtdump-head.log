  (Fin P.lwe.dimension → ZMod P.lwe.modulus) → Fin P.columns → Bool
TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.keyBits_eq : ∀
  (P : TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.Parameters)
  (s : Fin P.lwe.dimension → ZMod P.lwe.modulus),
  TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.keyBits P s =
    TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.decomposeVec P
      (TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.secretVector P s)
TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.decConstants : (P :
    TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.Parameters) →
  TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.Ciphertext P → Fin P.columns → ZMod P.lwe.modulus
TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.decConstants_eq : ∀
  (P : TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.Parameters)
  (C : TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.Ciphertext P),
  TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.decConstants P C =
    Matrix.vecMul (TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.decryptColumn P C)
      (TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.gadget P)
TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.decryptFormula : (P :
    TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.Parameters) →
  TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.Ciphertext P → BoolCircuit.TreeCircuit P.columns
TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.decryptFormula_eq : ∀
