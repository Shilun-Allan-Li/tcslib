  (C : TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.Ciphertext P),
  TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.decryptFormula P C =
    BoolCircuit.FormulaArith.modSumInterval
      (fun (i : Fin P.columns) => (TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.decConstants P C i).val)
      P.lwe.modulus (TCSlib.Cryptography.LWE.BitEncoding.decodeLo P.lwe)
      (TCSlib.Cryptography.LWE.BitEncoding.decodeHi P.lwe)
TCSlib.Cryptography.AdvancedEncryption.Homomorphic.GSW.nandFormula : (P :
