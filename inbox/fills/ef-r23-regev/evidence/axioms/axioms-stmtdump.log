TCSlib.Cryptography.Encryption.Symmetric.Regev.shiftPre : List Bool → List Bool
'TCSlib.Cryptography.Encryption.Symmetric.Regev.shiftPre_eq' depends on axioms: [propext, Quot.sound]
TCSlib.Cryptography.Encryption.Symmetric.Regev.shiftPre_eq : ∀ (z : List Bool),
  TCSlib.Cryptography.Encryption.Symmetric.Regev.shiftPre z =
    have adv := Complexity.pairFstD z;
    have y := Complexity.pairSndD z;
    have cut := (Complexity.pairFstD (Complexity.pairSndD adv)).length;
    List.take cut y ++
      TCSlib.Cryptography.Encoding.ModularArithmetic.vecAddModWords (Complexity.pairFstD (Complexity.pairFstD adv))
        (Complexity.pairSndD (Complexity.pairFstD adv)) (List.drop cut y)
        (Complexity.pairSndD (Complexity.pairSndD adv))
