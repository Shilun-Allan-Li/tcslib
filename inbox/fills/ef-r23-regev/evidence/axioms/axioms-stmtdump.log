TCSlib.Cryptography.Encryption.PublicKey.Regev.encryptAdviceBound_eval : ∀ (F : TCSlib.Cryptography.LWE.Family) (κ : ℕ),
  (TCSlib.Cryptography.Encryption.PublicKey.Regev.encryptAdviceBound F).eval κ =
    2 * (F.samplesBound.eval κ * F.dimensionBound.eval κ * F.residueBits.eval κ) + 4 * F.dimensionBound.eval κ +
