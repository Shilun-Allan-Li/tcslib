  ∃ D',
    ∀ (κ : ℕ),
      (TCSlib.Cryptography.LWE.decisionAdvantage (F.parameters κ) (F.noise κ) fun c r =>
          D.distinguisherL κ
            (TCSlib.Cryptography.LWE.encodeChallenge (F.parameters κ) (F.residueBits.eval κ)
              (TCSlib.Cryptography.Encryption.Symmetric.Regev.shift (F.parameters κ) (μ κ) c))
