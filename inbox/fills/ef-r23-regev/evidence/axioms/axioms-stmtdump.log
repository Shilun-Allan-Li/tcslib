TCSlib.Cryptography.Encryption.PublicKey.Regev.encryptPre : List Bool → List Bool
'TCSlib.Cryptography.Encryption.PublicKey.Regev.encryptPre_encryptAdvice' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
TCSlib.Cryptography.Encryption.PublicKey.Regev.encryptPre_encryptAdvice : ∀ (P : TCSlib.Cryptography.LWE.Parameters)
  (w : ℕ),
  P.modulus ≤ 2 ^ w →
    ∀ (μ : Bool) (pk : Matrix (Fin P.samples) (Fin P.dimension) (ZMod P.modulus) × (Fin P.samples → ZMod P.modulus))
      (r : Fin P.samples → Bool) (extra : List Bool),
      TCSlib.Cryptography.Encryption.PublicKey.Regev.encryptPre
          (Turing.pairEncode (TCSlib.Cryptography.Encryption.PublicKey.Regev.encryptAdvice P w μ)
            (Turing.pairEncode (TCSlib.Cryptography.LWE.encodeChallenge P w pk) (List.ofFn r ++ extra))) =
        TCSlib.Cryptography.Encryption.PublicKey.Regev.encodeView P w
          (TCSlib.Cryptography.Encryption.PublicKey.Regev.view P μ pk r)
'TCSlib.Cryptography.Encryption.PublicKey.Regev.encryptPre_eq' depends on axioms: [propext, Quot.sound]
TCSlib.Cryptography.Encryption.PublicKey.Regev.encryptPre_eq : ∀ (z : List Bool),
  TCSlib.Cryptography.Encryption.PublicKey.Regev.encryptPre z =
    have adv := Complexity.pairFstD z;
    have y := Complexity.pairFstD (Complexity.pairSndD z);
    have s := Complexity.pairSndD (Complexity.pairSndD z);
    have ctx := Complexity.pairFstD (Complexity.pairFstD adv);
    have nT := Complexity.pairFstD (Complexity.pairSndD (Complexity.pairFstD adv));
    have mT := Complexity.pairSndD (Complexity.pairSndD (Complexity.pairFstD adv));
    have cut := (Complexity.pairFstD (Complexity.pairSndD adv)).length;
    y ++
      (TCSlib.Cryptography.Encoding.ModularArithmetic.subsetSumModWords ctx nT mT (List.take cut y) s ++
        TCSlib.Cryptography.Encoding.ModularArithmetic.addMod
          (Turing.pairEncode ctx
            (Turing.pairEncode
              (TCSlib.Cryptography.Encoding.ModularArithmetic.subsetSumModWords ctx [Bool.true] mT (List.drop cut y) s)
              (Complexity.pairSndD (Complexity.pairSndD adv)))))
