  (μ : Fin P.samples → Bool),
  (TCSlib.Cryptography.Encryption.Symmetric.Regev.shiftAdvice P w μ).length =
    2 * (P.samples * P.dimension * w) + P.samples * w + 2 * P.samples + 12 * w + 20
'TCSlib.Cryptography.Encryption.Symmetric.Regev.shiftAdvice_length_le' depends on axioms: [propext, Quot.sound]
TCSlib.Cryptography.Encryption.Symmetric.Regev.shiftAdvice_length_le : ∀ (F : TCSlib.Cryptography.LWE.Family) (κ : ℕ)
  (μ : Fin (F.parameters κ).samples → Bool),
  (TCSlib.Cryptography.Encryption.Symmetric.Regev.shiftAdvice (F.parameters κ) (F.residueBits.eval κ) μ).length ≤
    (TCSlib.Cryptography.Encryption.Symmetric.Regev.shiftAdviceBound F).eval κ
