  P.modulus ≤ 2 ^ w →
    ∀ (μ : Fin P.samples → Bool)
      (x : Matrix (Fin P.samples) (Fin P.dimension) (ZMod P.modulus) × (Fin P.samples → ZMod P.modulus)),
      TCSlib.Cryptography.Encryption.Symmetric.Regev.shiftPre
          (Turing.pairEncode (TCSlib.Cryptography.Encryption.Symmetric.Regev.shiftAdvice P w μ)
