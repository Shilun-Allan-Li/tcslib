'TCSlib.Cryptography.Encoding.ModularArithmetic.vecAddStep' depends on axioms: [propext, Quot.sound]
TCSlib.Cryptography.Encoding.ModularArithmetic.vecAddStep : List Bool → List Bool
'TCSlib.Cryptography.Encoding.ModularArithmetic.vecAddStep_eq' depends on axioms: [propext, Quot.sound]
TCSlib.Cryptography.Encoding.ModularArithmetic.vecAddStep_eq : ∀ (z : List Bool),
  TCSlib.Cryptography.Encoding.ModularArithmetic.vecAddStep z =
    have ctx := Complexity.pairFstD z;
    have w := (Complexity.pairFstD ctx).length;
    have xs := Complexity.pairFstD (Complexity.pairSndD z);
    have ys := Complexity.pairFstD (Complexity.pairSndD (Complexity.pairSndD z));
    have out := Complexity.pairSndD (Complexity.pairSndD (Complexity.pairSndD z));
    Turing.pairEncode ctx
      (Turing.pairEncode (List.drop w xs)
        (Turing.pairEncode (List.drop w ys)
          (out ++
            TCSlib.Cryptography.Encoding.ModularArithmetic.addMod
              (Turing.pairEncode ctx (Turing.pairEncode (List.take w xs) (List.take w ys))))))
