    Turing.pairEncode
      (Turing.pairEncode (TCSlib.Cryptography.Encoding.ModularArithmetic.modContext w P.modulus)
        (Turing.pairEncode (List.replicate P.dimension Bool.true) (List.replicate P.samples Bool.true)))
      (Turing.pairEncode (List.replicate (P.samples * P.dimension * w) Bool.true)
        (TCSlib.Cryptography.Candidates.natToList w (TCSlib.Cryptography.LWE.BitEncoding.codepoint P μ).val))
