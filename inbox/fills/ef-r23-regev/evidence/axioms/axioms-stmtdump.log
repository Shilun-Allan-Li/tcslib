  (μ : Bool),
  (TCSlib.Cryptography.Encryption.PublicKey.Regev.encryptAdvice P w μ).length =
    2 * (P.samples * P.dimension * w) + 4 * P.dimension + 2 * P.samples + 13 * w + 24
