'TCSlib.Cryptography.Encoding.ModularArithmetic.subsetSumStep_eq' depends on axioms: [propext, Quot.sound]
TCSlib.Cryptography.Encoding.ModularArithmetic.subsetSumStep_eq : ∀ (z : List Bool),
  TCSlib.Cryptography.Encoding.ModularArithmetic.subsetSumStep z =
    have ctx₂ := Complexity.pairFstD z;
    have ctx := Complexity.pairFstD ctx₂;
    have nT := Complexity.pairSndD ctx₂;
    have rowLen := nT.length * (Complexity.pairFstD ctx).length;
    have rows := Complexity.pairFstD (Complexity.pairSndD z);
    have bits := Complexity.pairFstD (Complexity.pairSndD (Complexity.pairSndD z));
    have acc := Complexity.pairSndD (Complexity.pairSndD (Complexity.pairSndD z));
    Turing.pairEncode ctx₂
      (Turing.pairEncode (List.drop rowLen rows)
        (Turing.pairEncode (List.drop 1 bits)
          (if bits.headD Bool.false = Bool.true then
            TCSlib.Cryptography.Encoding.ModularArithmetic.vecAddModWords ctx nT acc (List.take rowLen rows)
          else acc)))
