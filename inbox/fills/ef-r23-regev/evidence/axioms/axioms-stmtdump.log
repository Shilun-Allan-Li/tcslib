'TCSlib.Cryptography.Encryption.Symmetric.Regev.shiftAdviceBound' depends on axioms: [propext, Quot.sound]
TCSlib.Cryptography.Encryption.Symmetric.Regev.shiftAdviceBound : TCSlib.Cryptography.LWE.Family → Complexity.PolyExpr
'TCSlib.Cryptography.Encryption.Symmetric.Regev.shiftAdviceBound_eval' depends on axioms: [propext, Quot.sound]
TCSlib.Cryptography.Encryption.Symmetric.Regev.shiftAdviceBound_eval : ∀ (F : TCSlib.Cryptography.LWE.Family) (κ : ℕ),
  (TCSlib.Cryptography.Encryption.Symmetric.Regev.shiftAdviceBound F).eval κ =
    2 * (F.samplesBound.eval κ * F.dimensionBound.eval κ * F.residueBits.eval κ) +
            F.samplesBound.eval κ * F.residueBits.eval κ +
          2 * F.samplesBound.eval κ +
        12 * F.residueBits.eval κ +
      20
'TCSlib.Cryptography.Encryption.Symmetric.Regev.shiftAdvice_eq' depends on axioms: [propext, Quot.sound]
TCSlib.Cryptography.Encryption.Symmetric.Regev.shiftAdvice_eq : ∀ (P : TCSlib.Cryptography.LWE.Parameters) (w : ℕ)
  (μ : Fin P.samples → Bool),
  TCSlib.Cryptography.Encryption.Symmetric.Regev.shiftAdvice P w μ =
    Turing.pairEncode
      (Turing.pairEncode (TCSlib.Cryptography.Encoding.ModularArithmetic.modContext w P.modulus)
        (List.replicate P.samples Bool.true))
      (Turing.pairEncode (List.replicate (P.samples * P.dimension * w) Bool.true)
        (TCSlib.Cryptography.Encoding.Modular.encodeVector w fun i =>
          TCSlib.Cryptography.LWE.BitEncoding.codepoint P (μ i)))
