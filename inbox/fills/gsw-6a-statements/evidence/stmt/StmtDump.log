                (fun (k : ℕ) =>
                  (U.getD (j + 1 + k) (BoolCircuit.TreeCircuit.const Bool.false)).or2
                    (W.getD (j + 1 + k) (BoolCircuit.TreeCircuit.const Bool.false)))
