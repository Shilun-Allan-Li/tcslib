  BoolCircuit.FormulaArith.modSumInterval a q lo hi =
    BoolCircuit.TreeCircuit.balanced Bool.false
      (List.map
        (fun (j : ℕ) =>
          (BoolCircuit.FormulaArith.geConst
                (List.take (Nat.clog 2 M + Nat.clog 2 q)
                  (BoolCircuit.FormulaArith.csaReduce
                      (List.ofFn fun (i : Fin M) => BoolCircuit.FormulaArith.maskedConst i (a i) (Nat.clog 2 q))).1)
                (List.take (Nat.clog 2 M + Nat.clog 2 q)
                  (BoolCircuit.FormulaArith.csaReduce
                      (List.ofFn fun (i : Fin M) => BoolCircuit.FormulaArith.maskedConst i (a i) (Nat.clog 2 q))).2)
                (j * q + lo)).and2
            (BoolCircuit.FormulaArith.geConst
                (List.take (Nat.clog 2 M + Nat.clog 2 q)
                  (BoolCircuit.FormulaArith.csaReduce
                      (List.ofFn fun (i : Fin M) => BoolCircuit.FormulaArith.maskedConst i (a i) (Nat.clog 2 q))).1)
                (List.take (Nat.clog 2 M + Nat.clog 2 q)
                  (BoolCircuit.FormulaArith.csaReduce
                      (List.ofFn fun (i : Fin M) => BoolCircuit.FormulaArith.maskedConst i (a i) (Nat.clog 2 q))).2)
                (j * q + hi)).neg)
