BranchingProgram.commutatorProgram_eq	theorem	TCSlib.Complexity.BranchingPrograms.Barrington
  : ∀ {n : ℕ} (P₁ P₂ : Equiv.Perm (Fin 5) → BranchingProgram 5 n) (σ : Equiv.Perm (Fin 5)),
  BranchingProgram.commutatorProgram P₁ P₂ σ =
