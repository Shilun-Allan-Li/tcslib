          P₂
            (BranchingProgram.conjugator
                  (BranchingProgram.sigma2⁻¹ * BranchingProgram.sigma1⁻¹ * BranchingProgram.sigma2 *
                    BranchingProgram.sigma1)
                  σ *
                BranchingProgram.sigma2 *
              (BranchingProgram.conjugator
                  (BranchingProgram.sigma2⁻¹ * BranchingProgram.sigma1⁻¹ * BranchingProgram.sigma2 *
                    BranchingProgram.sigma1)
