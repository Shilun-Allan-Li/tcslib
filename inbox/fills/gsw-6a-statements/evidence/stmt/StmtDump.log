  : ∀ {n : ℕ} (U W : List (BoolCircuit.TreeCircuit n)) (b : ℕ),
  BoolCircuit.FormulaArith.carryOut U W b =
    BoolCircuit.TreeCircuit.balanced Bool.false
      (List.map
        (fun (j : ℕ) =>
