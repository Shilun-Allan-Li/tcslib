    | [ι] => ι.wire
    | ι₁ :: ι₂ :: l =>
      BranchingProgram.wireComp (BranchingProgram.compTree (List.take ((ι₁ :: ι₂ :: l).length / 2) (ι₁ :: ι₂ :: l)))
        (BranchingProgram.compTree (List.drop ((ι₁ :: ι₂ :: l).length / 2) (ι₁ :: ι₂ :: l)))
