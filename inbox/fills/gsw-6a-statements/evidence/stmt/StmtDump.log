  : ∀ {n : ℕ} [inst : NeZero n] (x : Equiv.Perm (Fin 5)) (c₁ c₂ : BoolCircuit.TreeCircuit n)
  (tail : List (BoolCircuit.TreeCircuit n)),
  BranchingProgram.barrington (BoolCircuit.TreeCircuit.node Bool.false (c₁ :: c₂ :: tail)) x =
    (BranchingProgram.commutatorProgram
          (fun (ρ : Equiv.Perm (Fin 5)) => (BranchingProgram.barrington c₁ ρ⁻¹).complementLast ρ⁻¹)
          (fun (ρ : Equiv.Perm (Fin 5)) => (BranchingProgram.barrington c₂ ρ⁻¹).complementLast ρ⁻¹) x⁻¹).complementLast
      x⁻¹
  CONSTS [BoolCircuit.TreeCircuit, BranchingProgram, BranchingProgram.barrington, BoolCircuit.TreeCircuit.node, BranchingProgram.complementLast, BranchingProgram.commutatorProgram]
BranchingProgram.barrington.eq_def	theorem	TCSlib.Complexity.BranchingPrograms.Barrington
  : ∀ {n : ℕ} [inst : NeZero n] (x : BoolCircuit.TreeCircuit n) (x_1 : Equiv.Perm (Fin 5)),
  BranchingProgram.barrington x x_1 =
    match x, x_1 with
    | BoolCircuit.TreeCircuit.lit { idx := i, sign := Bool.true }, σ =>
      { instrs := [BranchingProgram.Instr.ofPerm i 1 σ] }
    | BoolCircuit.TreeCircuit.lit { idx := i, sign := Bool.false }, σ =>
      { instrs := [BranchingProgram.Instr.ofPerm i σ 1] }
    | BoolCircuit.TreeCircuit.node Bool.true [], σ => { instrs := [BranchingProgram.Instr.ofPerm 0 σ σ] }
    | BoolCircuit.TreeCircuit.node Bool.false [], x => { instrs := [BranchingProgram.Instr.ofPerm 0 1 1] }
    | BoolCircuit.TreeCircuit.node isAnd [c], σ => BranchingProgram.barrington c σ
    | BoolCircuit.TreeCircuit.node Bool.true (c₁ :: c₂ :: tail), σ =>
      BranchingProgram.commutatorProgram (fun (ρ : Equiv.Perm (Fin 5)) => BranchingProgram.barrington c₁ ρ)
        (fun (ρ : Equiv.Perm (Fin 5)) => BranchingProgram.barrington c₂ ρ) σ
    | BoolCircuit.TreeCircuit.node Bool.false (c₁ :: c₂ :: tail), σ =>
      (BranchingProgram.commutatorProgram
            (fun (ρ : Equiv.Perm (Fin 5)) => (BranchingProgram.barrington c₁ ρ⁻¹).complementLast ρ⁻¹)
            (fun (ρ : Equiv.Perm (Fin 5)) => (BranchingProgram.barrington c₂ ρ⁻¹).complementLast ρ⁻¹)
            σ⁻¹).complementLast
        σ⁻¹
  CONSTS [BoolCircuit.TreeCircuit, BranchingProgram, BranchingProgram.barrington, BranchingProgram.barrington.match_1, BranchingProgram.mk, BranchingProgram.Instr, BranchingProgram.Instr.ofPerm, BranchingProgram.commutatorProgram, BranchingProgram.complementLast]
BranchingProgram.barrington.match_1	def	TCSlib.Complexity.BranchingPrograms.Barrington
  : {n : ℕ} →
  (motive : BoolCircuit.TreeCircuit n → Equiv.Perm (Fin 5) → Sort u_1) →
    (x : BoolCircuit.TreeCircuit n) →
      (x_1 : Equiv.Perm (Fin 5)) →
        ((i : Fin n) →
            (σ : Equiv.Perm (Fin 5)) → motive (BoolCircuit.TreeCircuit.lit { idx := i, sign := Bool.true }) σ) →
          ((i : Fin n) →
              (σ : Equiv.Perm (Fin 5)) → motive (BoolCircuit.TreeCircuit.lit { idx := i, sign := Bool.false }) σ) →
            ((σ : Equiv.Perm (Fin 5)) → motive (BoolCircuit.TreeCircuit.node Bool.true []) σ) →
              ((x : Equiv.Perm (Fin 5)) → motive (BoolCircuit.TreeCircuit.node Bool.false []) x) →
                ((isAnd : Bool) →
                    (c : BoolCircuit.TreeCircuit n) →
                      (σ : Equiv.Perm (Fin 5)) → motive (BoolCircuit.TreeCircuit.node isAnd [c]) σ) →
                  ((c₁ c₂ : BoolCircuit.TreeCircuit n) →
                      (tail : List (BoolCircuit.TreeCircuit n)) →
                        (σ : Equiv.Perm (Fin 5)) →
                          motive (BoolCircuit.TreeCircuit.node Bool.true (c₁ :: c₂ :: tail)) σ) →
                    ((c₁ c₂ : BoolCircuit.TreeCircuit n) →
                        (tail : List (BoolCircuit.TreeCircuit n)) →
                          (σ : Equiv.Perm (Fin 5)) →
                            motive (BoolCircuit.TreeCircuit.node Bool.false (c₁ :: c₂ :: tail)) σ) →
                      motive x x_1
  CONSTS [BoolCircuit.TreeCircuit, BoolCircuit.TreeCircuit.lit, BoolCircuit.Lit.mk, BoolCircuit.TreeCircuit.node]
