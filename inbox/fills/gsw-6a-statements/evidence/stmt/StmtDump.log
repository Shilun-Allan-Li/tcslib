  : ∀ (N : ℕ) (gs : List BoolCircuit.DAGGate) (a b s : ℕ),
  BoolCircuit.layerChain N gs a b (s + 1) =
    ((BoolCircuit.layerChain N
          (gs ++
            [{ kind := BoolCircuit.GateKind.not, args := [a] },
              { kind := BoolCircuit.GateKind.not, args := [N + gs.length] }])
          b (N + gs.length + 1) s).1,
      (N + gs.length + 1) ::
        (BoolCircuit.layerChain N
            (gs ++
              [{ kind := BoolCircuit.GateKind.not, args := [a] },
                { kind := BoolCircuit.GateKind.not, args := [N + gs.length] }])
