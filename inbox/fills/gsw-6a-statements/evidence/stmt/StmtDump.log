BoolCircuit.DAGCircuit.layerColumn_eq	theorem	TCSlib.Complexity.CircuitComplexity.NANDLayering
  : ∀ {n : ℕ} (C : BoolCircuit.DAGCircuit n) (s : List BoolCircuit.DAGGate × List (List ℕ)) (v : ℕ),
  C.layerColumn s v =
    if C.depth < C.depthAt v then (s.1, s.2 ++ [[]])
    else
      if v < n then
        if C.depth = 0 then (s.1, s.2 ++ [[v]])
        else
          ((BoolCircuit.layerChain (n + n) (s.1 ++ [{ kind := BoolCircuit.GateKind.not, args := [n + v] }]) v
                (n + n + s.1.length) (C.depth - 1)).1,
            s.2 ++
              [v ::
                  (n + n + s.1.length) ::
                    (BoolCircuit.layerChain (n + n) (s.1 ++ [{ kind := BoolCircuit.GateKind.not, args := [n + v] }]) v
                        (n + n + s.1.length) (C.depth - 1)).2])
      else
        if C.depth = C.depthAt v then
          (s.1 ++
              [{ kind := BoolCircuit.GateKind.not,
                  args :=
                    List.map (fun (a : ℕ) => C.layerAt s.2 a (C.depthAt v - 1))
                      (C.gates.getD (v - n) { kind := BoolCircuit.GateKind.not, args := [] }).args }],
            s.2 ++ [[n + n + s.1.length]])
        else
          have gs₁ :=
            s.1 ++
              [{ kind := BoolCircuit.GateKind.not,
                  args :=
                    List.map (fun (a : ℕ) => C.layerAt s.2 a (C.depthAt v - 1))
                      (C.gates.getD (v - n) { kind := BoolCircuit.GateKind.not, args := [] }).args }];
          have tw :=
            if (C.gates.getD (v - n) { kind := BoolCircuit.GateKind.not, args := [] }).args = [] then
              (gs₁ ++
                  [{ kind := BoolCircuit.GateKind.not, args := [0, n] },
                    { kind := BoolCircuit.GateKind.not, args := [n + n + s.1.length + 1] }],
                n + n + s.1.length + 2)
            else
              (gs₁ ++
                  [{ kind := BoolCircuit.GateKind.not,
                      args :=
                        List.map (fun (a : ℕ) => C.layerAt s.2 a (C.depthAt v))
                          (C.gates.getD (v - n) { kind := BoolCircuit.GateKind.not, args := [] }).args }],
                n + n + s.1.length + 1);
          ((BoolCircuit.layerChain (n + n) tw.1 (n + n + s.1.length) tw.2 (C.depth - C.depthAt v - 1)).1,
            s.2 ++
              [(n + n + s.1.length) ::
                  tw.2 ::
                    (BoolCircuit.layerChain (n + n) tw.1 (n + n + s.1.length) tw.2 (C.depth - C.depthAt v - 1)).2])
  CONSTS [BoolCircuit.DAGCircuit, BoolCircuit.DAGGate, BoolCircuit.DAGCircuit.layerColumn, BoolCircuit.DAGCircuit.depth, BoolCircuit.DAGCircuit.depthAt, BoolCircuit.layerChain, BoolCircuit.DAGGate.mk, BoolCircuit.GateKind.not, BoolCircuit.DAGCircuit.layerAt, BoolCircuit.DAGGate.args, BoolCircuit.DAGCircuit.gates]
