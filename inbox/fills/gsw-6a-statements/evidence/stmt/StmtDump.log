BranchingProgram.compTree.eq_3	theorem	TCSlib.Complexity.BranchingPrograms.BarringtonConverse
  : ∀ {w n : ℕ} (ι₁ ι₂ : BranchingProgram.Instr w n) (l : List (BranchingProgram.Instr w n)),
  BranchingProgram.compTree (ι₁ :: ι₂ :: l) =
    BranchingProgram.wireComp (BranchingProgram.compTree (List.take ((ι₁ :: ι₂ :: l).length / 2) (ι₁ :: ι₂ :: l)))
      (BranchingProgram.compTree (List.drop ((ι₁ :: ι₂ :: l).length / 2) (ι₁ :: ι₂ :: l)))
  CONSTS [BranchingProgram.Instr, BoolCircuit.TreeCircuit, BranchingProgram.compTree, BranchingProgram.wireComp]
BranchingProgram.compTree.eq_def	theorem	TCSlib.Complexity.BranchingPrograms.BarringtonConverse
  : ∀ {w n : ℕ} (x : List (BranchingProgram.Instr w n)),
  BranchingProgram.compTree x =
    match (motive := List (BranchingProgram.Instr w n) → Fin w → Fin w → BoolCircuit.TreeCircuit n) x with
    | [] => fun (i j : Fin w) =>
