BoolCircuit.DAGCircuit.layerColumn	def	TCSlib.Complexity.CircuitComplexity.NANDLayering
  : {n : ℕ} →
  BoolCircuit.DAGCircuit n → List BoolCircuit.DAGGate × List (List ℕ) → ℕ → List BoolCircuit.DAGGate × List (List ℕ)
