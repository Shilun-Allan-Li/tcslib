STMTDUMP TCSlib.Cryptography.Pairing.BilinearGroup.pow_val_add : ∀ {wG wT : ℕ}
  (B : TCSlib.Cryptography.Pairing.BilinearGroup wG wT) (x : B.G) (a b : ZMod B.order),
  x ^ (a + b).val = x ^ a.val * x ^ b.val
STMTDUMP TCSlib.Cryptography.Pairing.BilinearGroup.pow_val_neg : ∀ {wG wT : ℕ}
  (B : TCSlib.Cryptography.Pairing.BilinearGroup wG wT) (x : B.G) (a : ZMod B.order), x ^ (-a).val = (x ^ a.val)⁻¹
STMTDUMP TCSlib.Cryptography.Pairing.BilinearGroup.pow_val_bijective_of_ne_one : ∀ {wG wT : ℕ}
  (B : TCSlib.Cryptography.Pairing.BilinearGroup wG wT) {g : B.G}, g ≠ 1 → Function.Bijective fun a => g ^ a.val
STMTDUMP TCSlib.Cryptography.Pairing.BilinearGroup.natCast_inj_of_lt : ∀ {wG wT : ℕ}
  (B : TCSlib.Cryptography.Pairing.BilinearGroup wG wT) {m n : ℕ}, m < B.order → n < B.order → (↑m = ↑n ↔ m = n)
