Complexity.IterateFind.host_dispatch_view : ∀ (M : Fin 5 → Turing.FinTM Bool) (K : ℕ)
  (hk : ∀ (i : Fin 5), (M i).k ≤ K + 1) (x w : List Bool),
  Turing.MultiTapeTM.step (Turing.Cfg.ofWords (Sum.inl 0) (Turing.stateWord (K + 1) w)) =
    Turing.Cfg.ofWords (Turing.ModuleHost.entry M 2) (Turing.stateWord (K + 1) w)
'Complexity.IterateFind.host_dispatch_view' depends on axioms: [propext, Classical.choice, Quot.sound]
Complexity.IterateFind.host_branch_view : ∀ (M : Fin 5 → Turing.FinTM Bool) (K : ℕ)
  (hk : ∀ (i : Fin 5), (M i).k ≤ K + 1) (x : List Bool) (b : Bool) (w : List Bool),
  w[0]? = Option.some b →
    Turing.MultiTapeTM.step (Turing.Cfg.ofWords (Sum.inl 1) (Turing.stateWord (K + 1) w)) =
      Turing.Cfg.ofWords (Turing.ModuleHost.entry M (if b = Bool.true then 4 else 3)) (Turing.stateWord (K + 1) w)
'Complexity.IterateFind.host_branch_view' depends on axioms: [propext, Classical.choice, Quot.sound]
Complexity.IterateFind.host_halt_view : ∀ (M : Fin 5 → Turing.FinTM Bool) (K : ℕ) (hk : ∀ (i : Fin 5), (M i).k ≤ K + 1)
  (x w o : List Bool),
  Turing.MultiTapeTM.step
      (have __src := Turing.Cfg.ofWords (Sum.inl 2) (Turing.stateWord (K + 1) w);
      { state := __src.state, inputPos := __src.inputPos, workTapes := __src.workTapes,
        workTapePos := __src.workTapePos, output := o }) =
    have __src := Turing.Cfg.ofWords (Sum.inl 2) (Turing.stateWord (K + 1) w);
    { state := Option.none, inputPos := __src.inputPos, workTapes := __src.workTapes, workTapePos := __src.workTapePos,
      output := o }
'Complexity.IterateFind.host_halt_view' depends on axioms: [propext, Classical.choice, Quot.sound]
