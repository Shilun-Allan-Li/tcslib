+section Forward
+
+variable (din dout : Fin k → PolyExpr) (seedLen : PolyExpr) (advIn : List Bool → List Bool)
+  (advIn_poly : PolyTimeComputable advIn) (outLen finCall : PolyExpr)
+  (finRun : List Bool → List Bool) (finRun_poly : PolyTimeComputable finRun)
