 theorem prfFixedScheme_not_cca2 :
     ∃ (A : NUPPT) (q : PolyExpr), ∀ n, 0 < n →
       advantage ((prfFixedScheme F E hE hFE).indGame .cca2 A (q.eval n) false n)
