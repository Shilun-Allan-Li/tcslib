-      expect (simulate (fImpl ins outs c n atk b f) (B.toCompOn (bitCodec ins outs d') n Q x r)
-        none) (fun p => if (List.ofFn p.1).headD false = true then (1 : ℝ) else 0) := by
-  subst hd
-  rfl
