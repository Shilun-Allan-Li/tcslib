+/-- The complete canonical simulator-state word has exactly its fixed polynomial width,
+for every typed state, including singular bases and empty input dimensions.
+
+**Proof sketch.** Read both simulator-state wire equations. Consume shared scalar/group
+matrix and vector length laws, the fixed nested-pair length law and the public dimension
+and polynomial evaluation readers; collect the resulting scalar arithmetic. -/
+theorem quadraticSimState_length (G : BilinearGen) (ℓ n : PolyExpr) (κ : ℕ)
+    (pp : PublicParams G κ) (st : Quadratic.SimState G ℓ n n κ pp) :
+    (Wire.quadraticSimState pp st).length = (simStLen G ℓ n).eval κ := by
+  simp only [Wire.quadraticSimState_eq, Wire.linearSimState_eq,
+    List.foldr_cons, List.foldr_nil, length_pairEncode, List.length_nil,
+    Wire.groupMatrix_length, Wire.scalarMatrix_eq, Wire.scalarVector_eq,
+    Encoding.Modular.encodeMatrix_length, Encoding.Modular.encodeVector_length,
+    simStLen_eval, Quadratic.piDim_eq,
+    PolyExpr.eval_add, PolyExpr.eval_mul, PolyExpr.eval_const]
+  ring
+
+/-- Encode the complete quadratic simulator state at its fixed polynomial width.
+The exact word-recovery law retains the original canonical state representation. -/
+def encSimState (G : BilinearGen) (ℓ n : PolyExpr) (κ : ℕ) (pp : PublicParams G κ)
+    (st : Quadratic.SimState G ℓ n n κ pp) : Fin ((simStLen G ℓ n).eval κ) → Bool :=
+  padFin ((simStLen G ℓ n).eval κ) (Wire.quadraticSimState pp st)
+
+/-- The simulator-state encoder is the shared fixed-width word adapter. -/
+theorem encSimState_eq (G : BilinearGen) (ℓ n : PolyExpr) (κ : ℕ) (pp : PublicParams G κ)
+    (st : Quadratic.SimState G ℓ n n κ pp) :
+    encSimState G ℓ n κ pp st =
+      padFin ((simStLen G ℓ n).eval κ) (Wire.quadraticSimState pp st) := rfl
+
+/-- The fixed-width simulator-state codec retains exactly the complete canonical word.
+
+**Proof sketch.** Use encSimState_eq and the existing ofFn_padFin_of_length with the
+exact quadraticSimState_length theorem. -/
+theorem ofFn_encSimState (G : BilinearGen) (ℓ n : PolyExpr) (κ : ℕ) (pp : PublicParams G κ)
+    (st : Quadratic.SimState G ℓ n n κ pp) :
+    List.ofFn (encSimState G ℓ n κ pp st) = Wire.quadraticSimState pp st := by
+  rw [encSimState_eq]
+  exact ofFn_padFin_of_length (quadraticSimState_length G ℓ n κ pp st)
+
+/-- Fixed-width simulator-state encodings distinguish every typed state.
+
+**Proof sketch.** Map the encoding equality through List.ofFn, recover each complete
+canonical word, and consume quadraticSimState_injective whole. -/
+theorem encSimState_injective (G : BilinearGen) (ℓ n : PolyExpr) (κ : ℕ)
+    (pp : PublicParams G κ) : Function.Injective (encSimState G ℓ n κ pp) := by
+  intro a b h
+  have hw := congrArg List.ofFn h
+  rw [ofFn_encSimState, ofFn_encSimState] at hw
+  exact quadraticSimState_injective G ℓ n κ pp hw
+
 end TCSlib.Cryptography.AdvancedEncryption.FunctionalEncryption.Wee20.PHFE
