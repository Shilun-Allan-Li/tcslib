+    (B.expVec_apply g (a + b) i).trans
+      ((B.pow_val_add g (a i) (b i)).trans
+        (congrArg₂ (fun x y : B.G => x * y)
+          (B.expVec_apply g a i).symm (B.expVec_apply g b i).symm))
 
