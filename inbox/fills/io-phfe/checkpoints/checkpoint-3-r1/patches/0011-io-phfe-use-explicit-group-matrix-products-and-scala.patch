 5 files changed, 29 insertions(+), 28 deletions(-)

diff --git a/TCSlib/Cryptography/AdvancedEncryption/FunctionalEncryption/Wee20/Linear.lean b/TCSlib/Cryptography/AdvancedEncryption/FunctionalEncryption/Wee20/Linear.lean
index f5299f6b5..651b8febd 100644
--- a/TCSlib/Cryptography/AdvancedEncryption/FunctionalEncryption/Wee20/Linear.lean
+++ b/TCSlib/Cryptography/AdvancedEncryption/FunctionalEncryption/Wee20/Linear.lean
@@ -213,9 +213,9 @@ def keyCore (G : BilinearGen) {ℓ n' : PolyExpr} {Fn : ℕ → ℕ+ → Type}
   let Tbar := fun i j => T i (Sum.inr j)
   let tensorR := Matrix.kroneckerMap (fun a b => a * b)
     (1 : Matrix (Fin (ℓ.eval κ)) (Fin (ℓ.eval κ)) (ZMod pp.group.order)) R
-  ⟨pp.group.expMat pp.generator Tbar * matMulGroup msk.W M,
-    pp.group.expMat pp.generator (T * PG.L1 κ pp.orderParam f + msk.U * tensorR),
-    pp.group.expMat pp.generator (T * PG.L0 κ pp.orderParam f + msk.V * R),
+  ⟨pp.group.expMat pp.generator Tbar ⊙ matMulGroup msk.W M,
+    pp.group.expMat pp.generator (T * (show Matrix _ _ (ZMod pp.group.order) from PG.L1 κ pp.orderParam f) + msk.U * tensorR),
+    pp.group.expMat pp.generator (T * (show Matrix _ _ (ZMod pp.group.order) from PG.L0 κ pp.orderParam f) + msk.V * R),
     pp.group.expMat pp.generator R⟩
 
 /-- Key generation is the displayed scalar garbling arithmetic and group matrix action. -/
@@ -227,11 +227,11 @@ theorem keyCore_eq (G : BilinearGen) {ℓ n' : PolyExpr} {Fn : ℕ → ℕ+ →
     keyCore G PG zDim κ pp msk f M ω =
       let tensorR := Matrix.kroneckerMap (fun a b => a * b)
         (1 : Matrix (Fin (ℓ.eval κ)) (Fin (ℓ.eval κ)) (ZMod pp.group.order)) ω.2
-      ⟨pp.group.expMat pp.generator (fun i j => ω.1 i (Sum.inr j)) * matMulGroup msk.W M,
+      ⟨pp.group.expMat pp.generator (fun i j => ω.1 i (Sum.inr j)) ⊙ matMulGroup msk.W M,
         pp.group.expMat pp.generator
-          (ω.1 * PG.L1 κ pp.orderParam f + msk.U * tensorR),
+          (ω.1 * (show Matrix _ _ (ZMod pp.group.order) from PG.L1 κ pp.orderParam f) + msk.U * tensorR),
         pp.group.expMat pp.generator
-          (ω.1 * PG.L0 κ pp.orderParam f + msk.V * ω.2),
+          (ω.1 * (show Matrix _ _ (ZMod pp.group.order) from PG.L0 κ pp.orderParam f) + msk.V * ω.2),
         pp.group.expMat pp.generator ω.2⟩ := rfl
 
 /-- Decryption's first block is `e(c1,M)/e(c0,K1)`
diff --git a/TCSlib/Cryptography/AdvancedEncryption/FunctionalEncryption/Wee20/LinearCorrect.lean b/TCSlib/Cryptography/AdvancedEncryption/FunctionalEncryption/Wee20/LinearCorrect.lean
