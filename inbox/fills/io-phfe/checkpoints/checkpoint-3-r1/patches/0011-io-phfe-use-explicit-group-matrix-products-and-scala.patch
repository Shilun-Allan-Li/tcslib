     (PG : PartialGarbling.Raw ℓ n' Fn) (κ : ℕ) (pp : PublicParams G κ)
     (f : Fn κ pp.orderParam) (x : Fin (ℓ.eval κ) → ZMod pp.group.order) :
-    (PG.L1 κ pp.orderParam f *
+    ((show Matrix _ _ (ZMod pp.group.order) from PG.L1 κ pp.orderParam f) *
         PartialGarbling.publicTensor (p := pp.orderParam) (M := PG.MIdx κ pp.orderParam f) x +
-      PG.L0 κ pp.orderParam f) *ᵥ (fun u => PG.recVec κ pp.orderParam f x (Sum.inr u)) =
+      (show Matrix _ _ (ZMod pp.group.order) from PG.L0 κ pp.orderParam f)) *ᵥ (fun u => PG.recVec κ pp.orderParam f x (Sum.inr u)) =
         Sum.elim (fun _ => 0) (PG.eval κ pp.orderParam f x) := sorry
 
 /-- The leakage is the product of the supplied group-matrix entries raised to the known
@@ -121,9 +121,9 @@ theorem decSecond_correct (G : BilinearGen) {ℓ n' : PolyExpr} {Fn : ℕ → 
           (pp.group.expVec pp.generator z) s) =
       pp.group.expVecT (pp.group.pair pp.generator pp.generator)
         (Matrix.vecMul (Matrix.vecMul (Matrix.vecMul s a.1) t.1)
-          (PG.L1 κ pp.orderParam f *
+          ((show Matrix _ _ (ZMod pp.group.order) from PG.L1 κ pp.orderParam f) *
               PartialGarbling.publicTensor (p := pp.orderParam)
-                (M := PG.MIdx κ pp.orderParam f) x + PG.L0 κ pp.orderParam f)) := sorry
+                (M := PG.MIdx κ pp.orderParam f) x + (show Matrix _ _ (ZMod pp.group.order) from PG.L0 κ pp.orderParam f))) := sorry
 
