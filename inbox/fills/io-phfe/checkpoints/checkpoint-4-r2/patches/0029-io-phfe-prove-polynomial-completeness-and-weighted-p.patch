-          (-(Matrix.vecMul (Matrix.vecMul s a.1) t.1 (Sum.inr j))).val := sorry
+          (-(Matrix.vecMul (Matrix.vecMul s a.1) t.1 (Sum.inr j))).val := by
+  -- Normalize the ciphertext numerator while keeping M group-valued.
