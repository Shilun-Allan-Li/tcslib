 /-- Every fixed prime schedule bounds the averaged correction by 3/p(κ).
 
@@ -66,7 +118,17 @@ theorem linearSlack_nonneg (G : BilinearGen) (κ : ℕ) : 0 ≤ linearSlack G κ
 then average rankSlack_le_three_div and apply the constant expectation reader. -/
 theorem linearSlack_le_fixedOrder (G : BilinearGen) (p : ℕ → ℕ)
     (hp : ∀ κ r, (G.inst κ r).order = p κ) (κ : ℕ) :
-    linearSlack G κ ≤ 3 / (p κ : ℝ) := sorry
+    linearSlack G κ ≤ 3 / (p κ : ℝ) := by
+  rw [linearSlack_eq]
+  calc
+    _ ≤ TCSlib.Cryptography.Games.ProbComp.expect (publicParamsGen G κ)
+        (fun _ => 3 / (p κ : ℝ)) :=
+      TCSlib.Cryptography.Games.ProbComp.expect_mono (publicParamsGen G κ) ?_
+    _ = 3 / (p κ : ℝ) :=
+      TCSlib.Cryptography.Games.ProbComp.expect_const (publicParamsGen G κ) _
+  intro pp
+  simpa only [PublicParams.group_eq, order_eq_of_publicParams G p hp κ pp] using
+    (rankSlack_le_three_div pp)
 
 /-- Exponential order growth makes the exact rank correction subexponentially small at
 any positive exponent below one [JLS26, Section 1.1].
@@ -76,7 +138,20 @@ Use subexpSmall_two_pow_neg and the shared constant-multiple and domination clos
 the requested smaller exponent. No negligible estimate is reproved locally. -/
 theorem linearSlack_subexpSmall (G : BilinearGen) (p : ℕ → ℕ)
     (hp : ∀ κ r, (G.inst κ r).order = p κ) (hpb : ∀ κ, 2 ^ κ ≤ p κ)
-    {c : ℝ} (hc₀ : 0 < c) (hc₁ : c < 1) : SubexpSmall c (linearSlack G) := sorry
+    {c : ℝ} (hc₀ : 0 < c) (hc₁ : c < 1) : SubexpSmall c (linearSlack G) := by
+  refine (subexpSmall_two_pow_neg.const_mul zero_lt_one hc₁ 3).mono ⟨0, ?_⟩
+  intro κ _
+  have hcast : (2 : ℝ) ^ κ ≤ (p κ : ℝ) := ?_
+  swap
+  · exact_mod_cast hpb κ
+  rw [abs_of_nonneg (linearSlack_nonneg G κ)]
+  calc
+    _ ≤ 3 / (p κ : ℝ) := linearSlack_le_fixedOrder G p hp κ
+    _ ≤ 3 * (2 : ℝ)⁻¹ ^ κ := ?_
+    _ ≤ |3 * (2 : ℝ)⁻¹ ^ κ| := le_abs_self _
+  simpa only [div_eq_mul_inv, inv_pow] using
+    (div_le_div_of_nonneg_left (a := (3 : ℝ)) zero_le_three
+      (pow_pos two_pos κ) hcast)
 
 /-- Exponential order growth makes the exact rank correction negligible.
 
@@ -84,6 +159,8 @@ theorem linearSlack_subexpSmall (G : BilinearGen) (p : ℕ → ℕ)
 SubexpSmall.negligible theorem. -/
 theorem linearSlack_negligible (G : BilinearGen) (p : ℕ → ℕ)
