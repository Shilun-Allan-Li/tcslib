+    exact (uprob_comp_equiv e
+      (fun z : Matrix (Fin 3) (Fin 3) K × Tail => IsUnit z.1)).trans
+        (uprob_fst (β := Tail) (fun M : Matrix (Fin 3) (Fin 3) K => IsUnit M))
+  have hCount :
+      (((∏ i : Fin 3,
