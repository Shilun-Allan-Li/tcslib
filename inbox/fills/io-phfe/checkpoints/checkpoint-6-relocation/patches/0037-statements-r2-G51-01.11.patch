+/-- Every PHFE scalar-value word has at most one bit more than the public group width.
+This bounds all class values at the drawn modulus, independently of the value itself.
+
+**Proof sketch.** Read the scalar class codec and singleton-vector encoding length. The
+modulus is at most two to the source-group width; monotonicity of Nat.size and size_pow
+then bound its binary width by the source-group width plus one. -/
+theorem valueEncoding_length_le (G : BilinearGen) (ℓ n : PolyExpr) (d κ : ℕ)
+    (pp : PublicParams G κ)
+    (v : (phfeClass ℓ n G.wG d).Out κ (classParam G ℓ n d κ pp)) :
+    ((phfeClass ℓ n G.wG d).encValue κ (classParam G ℓ n d κ pp) v).length ≤
+      G.wG.eval κ + 1 := by
+  have hword :
+      (phfeClass ℓ n G.wG d).encValue κ (classParam G ℓ n d κ pp) v =
+        encodeScalar pp.orderParam (valueEquiv G ℓ n d κ pp v) := ?_
+  swap
+  · simpa only [← valueEquiv_eq G ℓ n d κ pp, Equiv.symm_apply_apply, classParam_eq] using
+      (phfeClass_encValue_codec ℓ n G.wG d κ pp.orderParam
+        (valueEquiv G ℓ n d κ pp v))
+  rw [hword, encodeScalar_eq, Encoding.Modular.encodeVector_length, Nat.one_mul]
+  exact le_trans
+    (Nat.size_le_size (le_trans (le_of_eq (PublicParams.orderParam_val pp))
+      (IdentityBased.BB1Machine.order_le_two_pow G κ pp.description.val)))
+    (le_of_eq Nat.size_pow)
+
 end TCSlib.Cryptography.AdvancedEncryption.FunctionalEncryption.Wee20.PHFE
