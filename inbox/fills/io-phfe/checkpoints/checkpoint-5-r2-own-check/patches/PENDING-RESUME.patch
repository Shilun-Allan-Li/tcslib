+-/
+import TCSlib.Cryptography.Asymptotic.Realization
+import TCSlib.Cryptography.Games.Probability
+
+set_option maxHeartbeats 0
+set_option relaxedAutoImplicit false
+set_option autoImplicit false
+
+/-!
+# Uniform-coin laws for realised reduction functions
+
+## Main definitions
+
+This module introduces no definitions.
+
+## Main results
+
+* `ReductionLaws.expect_realizesOn_verdict_eq`: the shared verdict reader under a
+  uniform expectation at the prescribed coin layout.
+
+## References
+
+* TCSlib contributors, *TCSlib*, `Cryptography/Asymptotic/Realization.lean`, the shared
+  realisation predicate and verdict reader; `Complexity/Randomized/PPT.lean`, the
+  coin-layout equivalence and its bit-list reader.
+
+The result is technical probability transport for those existing interfaces.
+-/
+
+namespace TCSlib.Cryptography.AdvancedEncryption.FunctionalEncryption.ReductionLaws
+
+open Complexity TCSlib.Cryptography.Games
+
+/-- Uniform machine-coin acceptance on an encoded challenge equals acceptance of the
+realised word function on a uniform bit string of its stated coin layout. Acceptance
+means output exactly `[true]`; the realisation premise is needed only at layout-length
+coin strings. This transports the shared realiser verdict reader through uniform sampling.
+
+**Proof sketch.** Reindex machine coins by coinsEquivPoly, preserving their complete bit
+list. The published RealizesOn verdict reader identifies each integrand. No machine,
+encoding, reduction, coin splitter or sampler is constructed. -/
+theorem expect_realizesOn_verdict_eq {X : ℕ → Type} {D : NUPPT}
+    {enc : ∀ m, X m → List Bool} {c : PolyExpr}
+    {R : ∀ m, X m → List Bool → List Bool}
+    (h : D.RealizesOn enc c R) (κ : ℕ) (x : X κ) :
+    ProbComp.expect (ProbComp.sample (D.Coins κ))
+        (fun ρ => if D.distinguisherL κ (enc κ x) ρ = true then (1 : ℝ) else 0) =
+      ProbComp.expect (ProbComp.sample (Fin (c.eval κ) → Bool))
+        (fun w => if R κ x (List.ofFn w) = [true] then (1 : ℝ) else 0) := by
+  rw [← ProbComp.expect_sample_equiv (NUPPT.coinsEquivPoly h.coins_eq κ)
+    (fun w : Fin (c.eval κ) → Bool =>
+      if R κ x (List.ofFn w) = [true] then (1 : ℝ) else 0)]
+  apply congrArg (ProbComp.expect (ProbComp.sample (D.Coins κ)))
+  funext ρ
+  rw [h.distinguisherL_eq κ x ρ, NUPPT.coinsEquivPoly_ofFn h.coins_eq κ ρ]
+  simp only [decide_eq_true_eq]
+
+end TCSlib.Cryptography.AdvancedEncryption.FunctionalEncryption.ReductionLaws
