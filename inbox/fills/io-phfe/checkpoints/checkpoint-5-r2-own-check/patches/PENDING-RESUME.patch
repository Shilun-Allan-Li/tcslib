+    let split : SimKeyDraw G PG κ pp f ≃ (KeyDraw G PG κ pp f × Extra) :=
+      (Equiv.prodAssoc _ _ _).symm.trans (Equiv.prodProdProdComm _ _ _ _)
+    have hReindex := ProbComp.expect_sample_equiv split
+      (fun o : KeyDraw G PG κ pp f × Extra => F o.1)
+    have hMarginal := Bridge.expect_sample_pair
+      (α := KeyDraw G PG κ pp f) (β := Extra)
+      (fun o : KeyDraw G PG κ pp f × Extra => F o.1)
+    simp only [ProbComp.expect_bind, ProbComp.expect_pure,
+      ProbComp.expect_const] at hMarginal
+    exact h.trans (hReindex.trans hMarginal.symm)
+  have hSeedBound : ∀ i : Fin 2, head + i.val < N := by
+    intro i
+    have hi : head + i.val < base := (Fin.natAddEmb head i).isLt
+    rw [hTapeCount]
+    omega
+  let seedEmbedding : Fin 2 ↪ Fin N :=
+    ⟨fun i => ⟨head + i.val, hSeedBound i⟩,
+      fun _ _ h => Fin.ext (Nat.add_left_cancel (congrArg Fin.val h))⟩
+  have hSeedRead : ∀ (pp : PublicParams G κ) (xi : Draw pp),
+      seedAt G PG zDim A.budget κ pp xi = fun i => xi (seedEmbedding i) := by
+    intro pp xi
+    funext i
+    have hi : 17 + 4 * zDim.eval κ + 8 * ℓ.eval κ + i.val <
+        (securityCount PG zDim A.budget).eval κ := hSeedBound i
+    simp only [seedAt_eq, securityAt_eq, dif_pos hi]
+    rfl
+  have hSeedUniform (pp : PublicParams G κ) (F : EncDraw G κ pp → ℝ) :
+      ProbComp.expect (ProbComp.sample (Draw pp))
+          (fun xi => F (seedAt G PG zDim A.budget κ pp xi)) =
+        ProbComp.expect (ProbComp.sample (EncDraw G κ pp)) F := ?_
+  swap
+  · simp_rw [hSeedRead pp]
+    simpa only [ProbComp.expect_const] using
+      (FiniteRandomness.expect_sample_embedding_independent seedEmbedding
+        (fun v _ => F v) (fun _ _ _ _ => rfl))
+  -- The complete original array is embedded diagonally in independent complete rows.
+  let rowOf (a : Fin N) : ℕ :=
+    if a.val < off 1 then (a.val - off 0) / (3 * (b + n))
+    else if a.val < off 2 then (a.val - off 1) / (2 * b)
+    else if a.val < off 3 then (a.val - off 2) / (l * b)
+    else (a.val - off 3) / (b + n)
+  have hRowBound : ∀ a : Fin N, base ≤ a.val → rowOf a + delta < q + 1 := sorry
+  let slot (a : Fin N) : Option (Fin (q + 1)) :=
+    if hHead : a.val < head then none
+    else if hSeed : a.val < base then some 0
+    else some ⟨rowOf a + delta, hRowBound a (Nat.le_of_not_lt hSeed)⟩
+  let coordinateEmbedding : Fin N ↪ Option (Fin (q + 1)) × Fin N :=
+    ⟨fun a => (slot a, a), fun _ _ h => congrArg Prod.snd h⟩
+  let merge (pp : PublicParams G κ) (rho : Draw pp)
+      (T : Fin (q + 1) → Draw pp) : Draw pp :=
+    fun a => match slot a with | none => rho a | some k => T k a
+  let rowEquiv (pp : PublicParams G κ) :
+      ((Option (Fin (q + 1)) × Fin N) → K pp) ≃
+        (Draw pp × (Fin (q + 1) → Draw pp)) :=
+    (Equiv.curry _ _ _).trans Equiv.piOptionEquivProd
+  have hRowRead (pp : PublicParams G κ)
+      (W : (Option (Fin (q + 1)) × Fin N) → K pp) :
+      merge pp (rowEquiv pp W).1 (rowEquiv pp W).2 =
+        fun a => W (coordinateEmbedding a) := ?_
+  swap
+  · funext a
+    refine (show
+      (match slot a with | none => W (none, a) | some k => W (some k, a)) =
+        W (slot a, a) from ?_)
+    cases slot a <;> rfl
+  have hMergeLaw (pp : PublicParams G κ) (F : Draw pp → ℝ) :
+      ProbComp.expect (ProbComp.sample (Draw pp)) (fun rho =>
+        ProbComp.expect (ProbComp.sample (Fin (q + 1) → Draw pp))
+          (fun T => F (merge pp rho T))) =
+        ProbComp.expect (ProbComp.sample (Draw pp)) F := ?_
+  swap
+  · have h := FiniteRandomness.expect_sample_embedding_independent coordinateEmbedding
+      (fun v _ => F v) (fun _ _ _ _ => rfl)
+    simp only [ProbComp.expect_const] at h
+    have hRows := ProbComp.expect_sample_equiv (rowEquiv pp)
+      (fun p => F (merge pp p.1 p.2))
+    simp only [hRowRead] at hRows
+    rw [← Bridge.expect_sample_pair (α := Draw pp) (β := Fin (q + 1) → Draw pp)
+      (fun p => F (merge pp p.1 p.2))] at hRows
+    simp only [ProbComp.expect_bind, ProbComp.expect_pure] at hRows
+    exact hRows.symm.trans h
+  have hSetupMerged : ∀ (pp : PublicParams G κ) (rho : Draw pp)
+      (T : Fin (q + 1) → Draw pp),
+      setupAt G PG zDim A.budget κ pp (merge pp rho T) =
+        setupAt G PG zDim A.budget κ pp rho := sorry
+  -- Both channels use the same existing simulator host; this handler only issues draws.
+  let drawSpec (pp : PublicParams G κ) : OracleSpec Unit :=
+    { dom := fun _ => Unit, rng := fun _ => Draw pp }
+  let drawK (pp : PublicParams G κ) :
+      ∀ i, (drawSpec pp).dom i → Unit → Draw pp →
+        ProbComp ((drawSpec pp).rng i × Unit) := fun _ _ _ xi => .pure (xi, ())
+  let blockHandler (pp : PublicParams G κ) (rho : Draw pp) :
+      QueryImpl (saSpec G PG zDim κ pp) (State pp) (drawSpec pp) := fun
+    | false, msg, st => match st.challenge with
+      | some _ => .pure (none, st)
+      | none => if ideal then
+          .pure (some (simEncCore G ℓ zDim κ pp (ctx pp rho).2 msg.1),
+            ⟨some msg, st.used⟩)
+        else .query () () (fun xi => .pure
+          (some (encCore G ℓ zDim κ pp (ctx pp rho).1 msg.1
+            (pp.group.expVec pp.generator msg.2) (seedAt G PG zDim A.budget κ pp xi)),
+            ⟨some msg, st.used⟩))
+    | true, query, st => match st.challenge with
+      | none => .pure (none, st)
+      | some msg => if st.used < q then .query () () (fun xi =>
+          let sk := if ideal then
+              simKeyCore G PG zDim κ pp (ctx pp rho).2 query.fn query.matrix msg.1
+                (leak G PG zDim κ pp query.fn query.matrix msg.1 msg.2)
+                (simKeyAt G PG zDim A.budget κ pp xi st.used query.fn)
+            else keyCore G PG zDim κ pp (secret pp rho) query.fn query.matrix
+              (keyAt G PG zDim A.budget κ pp xi st.used query.fn)
+          .pure (some ⟨query.fn, sk⟩, ⟨st.challenge, st.used + 1⟩))
+        else .pure (none, st)
+  let inner (pp : PublicParams G κ) (rho : Draw pp) (r : List Bool) :=
+    simulate (blockHandler pp rho) (c pp rho r) (start pp)
+  let actualHandler (pp : PublicParams G κ) (rho : Draw pp) :
+      QueryImpl (saSpec G PG zDim κ pp) (State pp) unifSpec :=
+    if ideal then freshIdealHandler G PG zDim A.budget κ pp (ctx pp rho).2
+    else freshRealHandler G PG zDim A.budget κ pp (ctx pp rho).1 (secret pp rho)
+  have hOuterCost (pp : PublicParams G κ) (rho : Draw pp) (r : List Bool) :
+      (c pp rho r).CostBoundedBy (fun _ => 1) q := ?_
+  swap
+  · dsimp only [c, q]
+    rw [SAAdv.run_eq]
+    exact buildComp_costBoundedBy _ _ _ _
+  have hBlockCost : ∀ (pp : PublicParams G κ) (rho : Draw pp) i x st,
+      ((blockHandler pp rho) i x st).CostBoundedBy (fun _ => 1) 1 := sorry
+  have hInnerCost (pp : PublicParams G κ) (rho : Draw pp) (r : List Bool) :
+      (inner pp rho r).CostBoundedBy (fun _ => 1) q :=
+    simulate_costBoundedBy (hBlockCost pp rho) (hOuterCost pp rho r) (start pp)
+  have hTapeLaw (pp : PublicParams G κ) (rho : Draw pp) (r : List Bool) :
+      ProbComp.expect (ProbComp.sample (Fin (q + 1) → Draw pp)) (fun T =>
+        ProbComp.expect (simulate (Games.tapeImpl (drawK pp) (Games.extTape T))
+          (inner pp rho r) ((), 0)) (fun p => bit p.1.1)) =
+        ProbComp.expect (simulate (Games.freshImpl (drawK pp)) (inner pp rho r) ())
+          (fun p => bit p.1.1) :=
+    Games.expect_simulate_tapeImpl (drawK pp) (q + 1) (fun p => bit p.1)
+      (inner pp rho r) q (hInnerCost pp rho r) () 0
+      ((Nat.zero_add q).le.trans (Nat.le_succ q))
+  -- Inner calls, not outer queries or keys alone, determine the coin counter.
+  let PadRel (pp : PublicParams G κ) :
+      State pp → (State pp × (Unit × ℕ)) → Prop := fun s t =>
+    s = t.1 ∧ t.2.2 = s.used + (if ideal then 0 else if s.challenge.isSome then 1 else 0) ∧
+      (s.challenge = none → s.used = 0) ∧ s.used ≤ q
+  let paddedImpl (pp : PublicParams G κ) (rho : Draw pp)
+      (T : Fin (q + 1) → Draw pp) :
+      QueryImpl (saSpec G PG zDim κ pp) (State pp) unifSpec :=
+    detImpl (gameHandler G PG zDim A.budget mode κ pp (ctx pp rho).2 (merge pp rho T))
+  let tapedComp (pp : PublicParams G κ) (rho : Draw pp)
+      (T : Fin (q + 1) → Draw pp) :=
+    (Games.tapeImpl (drawK pp) (Games.extTape T)).comp (blockHandler pp rho)
+  have hPadStart (pp : PublicParams G κ) : PadRel pp (start pp) (start pp, ((), 0)) := ?_
+  swap
+  · refine ⟨rfl, ?_, (fun _ => rfl), Nat.zero_le q⟩
+    cases ideal <;> rfl
+  have hPaddedCalls : ∀ (pp : PublicParams G κ) (rho : Draw pp)
+      (T : Fin (q + 1) → Draw pp) i x s t, PadRel pp s t →
+      ∀ (g0 : (saSpec G PG zDim κ pp).rng i × State pp → ℝ)
+        (g1 : (saSpec G PG zDim κ pp).rng i × (State pp × (Unit × ℕ)) → ℝ),
+      (∀ y s' t', PadRel pp s' t' → g0 (y, s') = g1 (y, t')) →
+      ProbComp.expect (paddedImpl pp rho T i x s) g0 =
+        ProbComp.expect (tapedComp pp rho T i x t) g1 := sorry
+  have hPaddedRel (pp : PublicParams G κ) (rho : Draw pp)
+      (T : Fin (q + 1) → Draw pp) (r : List Bool) :
+      ProbComp.expect (simulate (paddedImpl pp rho T) (c pp rho r) (start pp))
+          (fun p => bit p.1) =
+        ProbComp.expect (simulate (tapedComp pp rho T) (c pp rho r) (start pp, ((), 0)))
+          (fun p => bit p.1) :=
+    ProbComp.expect_simulate_rel (paddedImpl pp rho T) (tapedComp pp rho T) (PadRel pp)
+      (hPaddedCalls pp rho T) (c pp rho r) _ _ (fun _ _ _ _ => rfl) (hPadStart pp)
+  have hPadRead (pp : PublicParams G κ) (rho : Draw pp)
+      (T : Fin (q + 1) → Draw pp) (r : List Bool) :
+      bit (runGameDet G PG zDim A mode false κ pp (merge pp rho T) r) =
+        ProbComp.expect (simulate (paddedImpl pp rho T) (c pp rho r) (start pp))
+          (fun p => bit p.1) := ?_
+  swap
+  · dsimp only [paddedImpl, c]
+    rw [simulate_saRun_det, ProbComp.expect_pure, runGameDet_eq, hSetupMerged]
+    simp only [ctx, start, Bool.false_and, Bool.false_eq_true, if_false]
+  have hPaddedRun (pp : PublicParams G κ) (rho : Draw pp)
+      (T : Fin (q + 1) → Draw pp) (r : List Bool) :
+      bit (runGameDet G PG zDim A mode false κ pp (merge pp rho T) r) =
+        ProbComp.expect (simulate (Games.tapeImpl (drawK pp) (Games.extTape T))
+          (inner pp rho r) ((), 0)) (fun p => bit p.1.1) := ?_
+  swap
+  · have hCompose := congrArg
+      (fun d : ProbComp ((Bool × State pp) × (Unit × ℕ)) =>
+        ProbComp.expect d (fun p => bit p.1.1))
+      (simulate_comp (Games.tapeImpl (drawK pp) (Games.extTape T))
+        (blockHandler pp rho) (c pp rho r) (start pp) ((), 0))
+    simp only [ProbComp.expect_bind, ProbComp.expect_pure] at hCompose
+    exact (hPadRead pp rho T r).trans ((hPaddedRel pp rho T r).trans hCompose.symm)
+  let FreshRel (pp : PublicParams G κ) : State pp → (State pp × Unit) → Prop :=
+    fun s t => s = t.1
+  let freshComp (pp : PublicParams G κ) (rho : Draw pp) :=
+    (Games.freshImpl (drawK pp)).comp (blockHandler pp rho)
+  have hFreshCalls : ∀ (pp : PublicParams G κ) (rho : Draw pp) i x s t,
+      FreshRel pp s t →
+      ∀ (g0 : (saSpec G PG zDim κ pp).rng i × State pp → ℝ)
+        (g1 : (saSpec G PG zDim κ pp).rng i × (State pp × Unit) → ℝ),
+      (∀ y s' t', FreshRel pp s' t' → g0 (y, s') = g1 (y, t')) →
+      ProbComp.expect (actualHandler pp rho i x s) g0 =
+        ProbComp.expect (freshComp pp rho i x t) g1 := sorry
+  have hFreshRel (pp : PublicParams G κ) (rho : Draw pp) (r : List Bool) :
+      ProbComp.expect (simulate (actualHandler pp rho) (c pp rho r) (start pp))
+          (fun p => bit p.1) =
+        ProbComp.expect (simulate (freshComp pp rho) (c pp rho r) (start pp, ()))
+          (fun p => bit p.1) :=
+    ProbComp.expect_simulate_rel (actualHandler pp rho) (freshComp pp rho) (FreshRel pp)
+      (hFreshCalls pp rho) (c pp rho r) _ _ (fun _ _ _ _ => rfl) rfl
+  have hFreshRun (pp : PublicParams G κ) (rho : Draw pp) (r : List Bool) :
+      ProbComp.expect (simulate (actualHandler pp rho) (c pp rho r) (start pp))
+          (fun p => bit p.1) =
+        ProbComp.expect (simulate (Games.freshImpl (drawK pp)) (inner pp rho r) ())
+          (fun p => bit p.1.1) := ?_
+  swap
+  · have hCompose := congrArg
+      (fun d : ProbComp ((Bool × State pp) × Unit) =>
+        ProbComp.expect d (fun p => bit p.1.1))
+      (simulate_comp (Games.freshImpl (drawK pp)) (blockHandler pp rho)
+        (c pp rho r) (start pp) ())
+    simp only [ProbComp.expect_bind, ProbComp.expect_pure] at hCompose
+    exact (hFreshRel pp rho r).trans hCompose.symm
+  have hConditioned (pp : PublicParams G κ) (rho : Draw pp) (r : List Bool) :
+      ProbComp.expect (ProbComp.sample (Fin (q + 1) → Draw pp)) (fun T =>
+        bit (runGameDet G PG zDim A mode false κ pp (merge pp rho T) r)) =
+        ProbComp.expect (simulate (actualHandler pp rho) (c pp rho r) (start pp))
+          (fun p => bit p.1) := ?_
+  swap
+  · simp_rw [hPaddedRun pp rho]
+    exact (hTapeLaw pp rho r).trans (hFreshRun pp rho r).symm
+  have hRunLaw (pp : PublicParams G κ) (r : List Bool) :
+      ProbComp.expect (ProbComp.sample (Draw pp))
+          (fun omega => bit (runGameDet G PG zDim A mode false κ pp omega r)) =
+        ProbComp.expect (ProbComp.sample (Draw pp)) (fun rho =>
+          ProbComp.expect (simulate (actualHandler pp rho) (c pp rho r) (start pp))
+            (fun p => bit p.1)) :=
+    (hMergeLaw pp (fun omega => bit (runGameDet G PG zDim A mode false κ pp omega r))).symm.trans
+      (congrArg (ProbComp.expect (ProbComp.sample (Draw pp)))
+        (funext fun rho => hConditioned pp rho r))
+  -- Setup reindexing retains the extra scalar fields and imposes no rank condition.
+  have hSetupReal : ∀ (pp : PublicParams G κ)
+      (F : MPK G ℓ zDim κ pp × MSK G ℓ zDim κ pp → ℝ),
+      ProbComp.expect (ProbComp.sample (Draw pp))
+          (fun rho => F ((ctx pp rho).1, secret pp rho)) =
+        ProbComp.expect (setup G ℓ zDim κ pp) F := sorry
+  have hSetupIdeal : ∀ (pp : PublicParams G κ)
+      (F : MPK G ℓ zDim κ pp × SimState G ℓ zDim κ pp → ℝ),
+      ProbComp.expect (ProbComp.sample (Draw pp)) (fun rho => F (ctx pp rho)) =
+        ProbComp.expect (simSetup G ℓ zDim κ pp) F := sorry
+  have hPaddedOuter : accept (saGame G PG zDim A ideal κ) =
+      ProbComp.expect (publicParamsGen G κ) (fun pp =>
+        ProbComp.expect (ProbComp.sample (Fin (A.coins.eval κ) → Bool)) (fun r =>
+          ProbComp.expect (ProbComp.sample (Draw pp))
+            (fun omega => bit (runGameDet G PG zDim A mode false κ pp omega (List.ofFn r))))) := ?_
+  swap
+  · simp only [saGame_eq, accept_eq, ProbComp.prob_bind, ProbComp.prob_pure]
+    apply congrArg (ProbComp.expect (publicParamsGen G κ))
+    funext pp
+    exact ProbComp.expect_sample_comm (fun omega r =>
+      bit (runGameDet G PG zDim A mode false κ pp omega (List.ofFn r)))
+  have hFreshOuter : accept (freshSaGame G PG zDim A ideal κ) =
+      ProbComp.expect (publicParamsGen G κ) (fun pp =>
+        ProbComp.expect (ProbComp.sample (Fin (A.coins.eval κ) → Bool)) (fun r =>
+          ProbComp.expect (ProbComp.sample (Draw pp)) (fun rho =>
+            ProbComp.expect (simulate (actualHandler pp rho) (c pp rho (List.ofFn r))
+              (start pp)) (fun p => bit p.1)))) := sorry
+  rw [hPaddedOuter, hFreshOuter]
+  apply congrArg (ProbComp.expect (publicParamsGen G κ))
+  funext pp
+  apply congrArg (ProbComp.expect (ProbComp.sample (Fin (A.coins.eval κ) → Bool)))
+  funext r
+  exact hRunLaw pp (List.ofFn r)
 
