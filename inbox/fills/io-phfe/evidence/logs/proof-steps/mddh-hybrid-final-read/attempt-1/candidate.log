D : NUPPT
Tape : ℕ → Type :=
  fun κ =>
    Matrix (Fin (ℓ.eval κ)) (Fin 3) (ZMod (p κ)) ×
      Matrix (Fin 2) (Fin (d.eval κ)) (ZMod (p κ)) × Matrix (Fin (ℓ.eval κ)) (Fin (d.eval κ)) (ZMod (p κ))
avgTape : (κ : ℕ) → (Tape κ → ℝ) → ℝ := fun κ f => (ProbComp.sample (Tape κ)).expect f
hybrid : ℕ → ℕ → ProbComp Bool :=
  fun κ i =>
    OracleComp.bind (publicParamsGen G κ) fun pp =>
      OracleComp.bind (ProbComp.sample (Matrix (Fin (ℓ.eval κ)) (Fin 2) (ZMod pp.group.order))) fun M =>
        OracleComp.bind (ProbComp.sample (Matrix (Fin 2) (Fin (d.eval κ)) (ZMod pp.group.order))) fun S =>
          OracleComp.bind (ProbComp.sample (Matrix (Fin (ℓ.eval κ)) (Fin (d.eval κ)) (ZMod pp.group.order))) fun U =>
            OracleComp.bind (ProbComp.sample (D.Coins κ)) fun r =>
              OracleComp.pure
                (D.distinguisherL κ
                  (G.mddhEnc d ℓ κ
                    { pp := pp, matrix := pp.group.expMat pp.generator M,
                      response := pp.group.expMat pp.generator fun a b => if ↑b < i then (M * S) a b else U a b })
                  r)
redGame : (κ : ℕ) → MddhAdvice p d ℓ κ → Bool → ProbComp Bool :=
  fun κ w real =>
    OracleComp.bind (G.dlinSample real κ) fun c =>
      OracleComp.bind (ProbComp.sample (D.Coins κ)) fun r =>
        OracleComp.pure (D.distinguisherL κ (G.mddhPre p hp d ℓ κ w c) r)
redGap : (κ : ℕ) → MddhAdvice p d ℓ κ → ℝ := fun κ w => advantage (redGame κ w false) (redGame κ w true)
hEnds :
  ∀ (κ : ℕ),
    accept (hybrid κ 0) = accept (G.mddhGame d ℓ D false κ) ∧
      accept (hybrid κ (d.eval κ)) = accept (G.mddhGame d ℓ D true κ)
hEndpointGap : ∀ (κ : ℕ), G.mddhAdv d ℓ D κ = advantage (hybrid κ 0) (hybrid κ (d.eval κ))
hPreScalar :
  ∀ (κ : ℕ) (w : MddhAdvice p d ℓ κ) (pp : PublicParams G κ) (ab rs : Fin 2 → ZMod pp.group.order)
    (t : ZMod pp.group.order) (real : Bool),
    let castScalar := ZMod.ringEquivCongr ⋯;
    let L := fun i j => castScalar (w.2.1 i j);
    let S := fun i j => castScalar (w.2.2.1 i j);
    let U := fun i j => castScalar (w.2.2.2 i j);
    let A0 := ![![ab 0, 0], ![0, ab 1], ![1, 1]];
    let v0 := ![ab 0 * rs 0, ab 1 * rs 1, if real = true then rs 0 + rs 1 else t];
    G.mddhPreChallenge p hp d ℓ κ w
        (G.dlinChallenge κ pp (pp.generator ^ (ab 0).val) (pp.generator ^ (ab 1).val) (pp.generator ^ (ab 0 * rs 0).val)
          (pp.generator ^ (ab 1 * rs 1).val) (pp.generator ^ (if real = true then rs 0 + rs 1 else t).val)) =
      { pp := pp, matrix := pp.group.expMat pp.generator (L * A0),
        response :=
          pp.group.expMat pp.generator fun i j =>
            if ↑j = ↑w.1 then L.mulVec v0 i else if ↑j < ↑w.1 then (L * A0 * S) i j else U i j }
SType : (κ : ℕ) → PublicParams G κ → Type := fun κ pp => Matrix (Fin 2) (Fin (d.eval κ)) (ZMod pp.group.order)
UType : (κ : ℕ) → PublicParams G κ → Type := fun κ pp => Matrix (Fin (ℓ.eval κ)) (Fin (d.eval κ)) (ZMod pp.group.order)
A0 : (κ : ℕ) → (pp : PublicParams G κ) → (Fin 2 → ZMod pp.group.order) → Matrix (Fin 3) (Fin 2) (ZMod pp.group.order) :=
  fun κ pp ab => ![![ab 0, 0], ![0, ab 1], ![1, 1]]
obs : (κ : ℕ) →
  Fin (d.eval κ) →
    (pp : PublicParams G κ) →
      SType κ pp →
        UType κ pp →
          Matrix (Fin (ℓ.eval κ)) (Fin 2) (ZMod pp.group.order) → (Fin (ℓ.eval κ) → ZMod pp.group.order) → ℝ :=
  fun κ j pp S U M v =>
    (ProbComp.sample (D.Coins κ)).prob fun r =>
      D.distinguisherL κ
          (G.mddhEnc d ℓ κ
            { pp := pp, matrix := pp.group.expMat pp.generator M,
              response :=
                pp.group.expMat pp.generator fun a b =>
                  if ↑b = ↑j then v a else if ↑b < ↑j then (M * S) a b else U a b })
          r =
        true
idealCore : (κ : ℕ) → Fin (d.eval κ) → Bool → (pp : PublicParams G κ) → SType κ pp → UType κ pp → ℝ :=
  fun κ j real pp S U =>
    (ProbComp.sample (Matrix (Fin (ℓ.eval κ)) (Fin 2) (ZMod pp.group.order))).expect fun M =>
      if real = true then
        (ProbComp.sample (Fin 2 → ZMod pp.group.order)).expect fun rs => obs κ j pp S U M (M.mulVec rs)
      else (ProbComp.sample (Fin (ℓ.eval κ) → ZMod pp.group.order)).expect (obs κ j pp S U M)
plantedCore : (κ : ℕ) → Fin (d.eval κ) → Bool → (pp : PublicParams G κ) → SType κ pp → UType κ pp → ℝ :=
  fun κ j real pp S U =>
    (ProbComp.sample (Fin 2 → ZMod pp.group.order)).expect fun ab =>
      (ProbComp.sample (Fin 2 → ZMod pp.group.order)).expect fun rs =>
        (ProbComp.sample (ZMod pp.group.order)).expect fun t =>
          (ProbComp.sample (Matrix (Fin (ℓ.eval κ)) (Fin 3) (ZMod pp.group.order))).expect fun L =>
            obs κ j pp S U (L * A0 κ pp ab)
              (L.mulVec ![ab 0 * rs 0, ab 1 * rs 1, if real = true then rs 0 + rs 1 else t])
ideal : (κ : ℕ) → Fin (d.eval κ) → Bool → PublicParams G κ → ℝ :=
  fun κ j real pp =>
    (ProbComp.sample (SType κ pp)).expect fun S => (ProbComp.sample (UType κ pp)).expect (idealCore κ j real pp S)
planted : (κ : ℕ) → Fin (d.eval κ) → Bool → PublicParams G κ → ℝ :=
  fun κ j real pp =>
    (ProbComp.sample (SType κ pp)).expect fun S => (ProbComp.sample (UType κ pp)).expect (plantedCore κ j real pp S)
coreLoss : ℕ → Bool → ℝ := fun κ real => if real = true then 1 / ↑(p κ) ^ 2 else 1 - (1 - 1 / ↑(p κ)) ^ 3
hReductionTransport :
  ∀ (κ : ℕ) (j : Fin (d.eval κ)) (real : Bool),
    (avgTape κ fun τ => accept (redGame κ (j.castSucc, τ) real)) = (publicParamsGen G κ).expect (planted κ j real)
