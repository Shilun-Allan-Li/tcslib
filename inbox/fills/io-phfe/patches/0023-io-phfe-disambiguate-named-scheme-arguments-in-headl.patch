From 7d42a6ef6a20d379c524c11db87a1b0c0e4c25df Mon Sep 17 00:00:00 2001
From: Seyoon Ragavan <complexzetaprime@gmail.com>
Date: Wed, 18 Nov 2026 04:10:03 -0800
Subject: [PATCH 23/25] io-phfe: disambiguate named scheme arguments in
 headline bounds

---
 .../FunctionalEncryption/Wee20/PHFE/Adapter.lean     |  6 ++++--
 .../FunctionalEncryption/Wee20/PHFE/Security.lean    | 12 ++++++------
 2 files changed, 10 insertions(+), 8 deletions(-)

diff --git a/TCSlib/Cryptography/AdvancedEncryption/FunctionalEncryption/Wee20/PHFE/Adapter.lean b/TCSlib/Cryptography/AdvancedEncryption/FunctionalEncryption/Wee20/PHFE/Adapter.lean
index 8c9856272..677059e79 100644
--- a/TCSlib/Cryptography/AdvancedEncryption/FunctionalEncryption/Wee20/PHFE/Adapter.lean
+++ b/TCSlib/Cryptography/AdvancedEncryption/FunctionalEncryption/Wee20/PHFE/Adapter.lean
@@ -77,7 +77,8 @@ def wrapKey (κ : ℕ) (pp : PublicParams (S).G κ) (f : ((S).saSpec κ).dom 1)
   let bits := (S).saKeyFunction κ f
   let decoded := decodeFunction G ℓ n d κ (params κ pp) bits
   if h : decoded = key.1 then
-    some ((keyEquiv G ℓ n d PG κ pp).symm ⟨bits, Eq.mp (congrArg (fun f => Quadratic.Key G n n PG κ (params κ pp) f) h.symm) key.2⟩)
+    some ((keyEquiv G ℓ n d PG κ pp).symm ⟨bits, Eq.mp (congrArg (fun f => Quadratic.Key G n n PG κ
+      (params κ pp) f) h.symm) key.2⟩)
   else none
 
 /-- The key wrapper's only accepted branch retains the original function word. -/
@@ -87,7 +88,8 @@ theorem wrapKey_eq (κ : ℕ) (pp : PublicParams (S).G κ) (f : ((S).saSpec κ).
       let bits := (S).saKeyFunction κ f
       let decoded := decodeFunction G ℓ n d κ (params κ pp) bits
       if h : decoded = key.1 then
-        some ((keyEquiv G ℓ n d PG κ pp).symm ⟨bits, Eq.mp (congrArg (fun f => Quadratic.Key G n n PG κ (params κ pp) f) h.symm) key.2⟩)
+        some ((keyEquiv G ℓ n d PG κ pp).symm ⟨bits, Eq.mp (congrArg (fun f => Quadratic.Key G n n
+          PG κ (params κ pp) f) h.symm) key.2⟩)
       else none := rfl
 
 /-- One replay step recovers the original next query from the original-bit history.
diff --git a/TCSlib/Cryptography/AdvancedEncryption/FunctionalEncryption/Wee20/PHFE/Security.lean b/TCSlib/Cryptography/AdvancedEncryption/FunctionalEncryption/Wee20/PHFE/Security.lean
index b83fe906b..140a8d513 100644
--- a/TCSlib/Cryptography/AdvancedEncryption/FunctionalEncryption/Wee20/PHFE/Security.lean
+++ b/TCSlib/Cryptography/AdvancedEncryption/FunctionalEncryption/Wee20/PHFE/Security.lean
@@ -98,7 +98,7 @@ used. The advice is chosen before all four machine realisers.
 -/
 theorem wee20PHFE_simAdv_le (hPG : PHFE.PGSound PG) (p : ℕ → ℕ)
     (hp : ∀ κ r, (G.inst κ r).order = p κ) (A : TwoStage) (q : PolyExpr) :
-    let B := A.toSA (S := S) q
+    let B := A.toSA («S» := S) q
     ∃ φ : ∀ κ, Quadratic.MaskAdvice n n p κ,
     ∃ ωPi : Fin 2 → ∀ κ, Linear.Advice PG (Quadratic.piDim n n) B.budget p κ,
     ∃ ωOuter : Fin 2 → ∀ κ, Quadratic.Advice n n B.budget PG p κ,
@@ -126,7 +126,7 @@ The shared realiser constrains only encoded challenges and layout-length coins.
 def Wee20RealizableSA (p : ℕ → ℕ)
     (hp : ∀ κ r, (G.inst κ r).order = p κ) : Prop :=
   ∀ (A : NUPPT) (q : PolyExpr),
-    let B := toSAAdv (S := S) A q
+    let B := toSAAdv («S» := S) A q
     ∀ φ : ∀ κ, Quadratic.MaskAdvice n n p κ,
     ∀ ωPi : Fin 2 → ∀ κ, Linear.Advice PG (Quadratic.piDim n n) B.budget p κ,
     ∀ ωOuter : Fin 2 → ∀ κ, Quadratic.Advice n n B.budget PG p κ,
@@ -147,7 +147,7 @@ theorem wee20RealizableSA_iff (p : ℕ → ℕ)
     (hp : ∀ κ r, (G.inst κ r).order = p κ) :
     Wee20RealizableSA G ℓ n d PG p hp ↔
   ∀ (A : NUPPT) (q : PolyExpr),
-    let B := toSAAdv (S := S) A q
+    let B := toSAAdv («S» := S) A q
     ∀ φ : ∀ κ, Quadratic.MaskAdvice n n p κ,
     ∀ ωPi : Fin 2 → ∀ κ, Linear.Advice PG (Quadratic.piDim n n) B.budget p κ,
     ∀ ωOuter : Fin 2 → ∀ κ, Quadratic.Advice n n B.budget PG p κ,
@@ -170,7 +170,7 @@ The shared realiser constrains only encoded challenges and layout-length coins.
 def Wee20Realizable43 (p : ℕ → ℕ)
     (hp : ∀ κ r, (G.inst κ r).order = p κ) : Prop :=
   ∀ (A : TwoStage) (q : PolyExpr),
-    let B := A.toSA (S := S) q
+    let B := A.toSA («S» := S) q
     ∀ φ : ∀ κ, Quadratic.MaskAdvice n n p κ,
     ∀ ωPi : Fin 2 → ∀ κ, Linear.Advice PG (Quadratic.piDim n n) B.budget p κ,
     ∀ ωOuter : Fin 2 → ∀ κ, Quadratic.Advice n n B.budget PG p κ,
@@ -191,7 +191,7 @@ theorem wee20Realizable43_iff (p : ℕ → ℕ)
     (hp : ∀ κ r, (G.inst κ r).order = p κ) :
     Wee20Realizable43 G ℓ n d PG p hp ↔
   ∀ (A : TwoStage) (q : PolyExpr),
-    let B := A.toSA (S := S) q
+    let B := A.toSA («S» := S) q
     ∀ φ : ∀ κ, Quadratic.MaskAdvice n n p κ,
     ∀ ωPi : Fin 2 → ∀ κ, Linear.Advice PG (Quadratic.piDim n n) B.budget p κ,
     ∀ ωOuter : Fin 2 → ∀ κ, Quadratic.Advice n n B.budget PG p κ,
@@ -253,7 +253,7 @@ and shared realisers are constrained only on encoded challenges and layout-lengt
 -/
 theorem wee20PHFE_simAdv_dlin_le (hPG : PHFE.PGSound PG) (p : ℕ → ℕ)
     (hp : ∀ κ r, (G.inst κ r).order = p κ) (A : TwoStage) (q : PolyExpr) :
-    let W := A.toSA (S := S) q
+    let W := A.toSA («S» := S) q
     ∃ φ : ∀ κ, Quadratic.MaskAdvice n n p κ,
     ∃ ωPi : Fin 2 → ∀ κ, Linear.Advice PG (Quadratic.piDim n n) W.budget p κ,
     ∃ ωOuter : Fin 2 → ∀ κ, Quadratic.Advice n n W.budget PG p κ,
