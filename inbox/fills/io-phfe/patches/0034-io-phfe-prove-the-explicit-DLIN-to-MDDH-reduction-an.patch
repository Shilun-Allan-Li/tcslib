+  -- The column index is fixed by the hybrid lemma; only its three scalar tapes are averaged.
+  let Tape (κ : ℕ) : Type :=
+    Matrix (Fin (ℓ.eval κ)) (Fin 3) (ZMod (p κ)) ×
