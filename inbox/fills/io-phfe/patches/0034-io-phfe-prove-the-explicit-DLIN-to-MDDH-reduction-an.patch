+      let U : Matrix (Fin (ℓ.eval κ)) (Fin (d.eval κ)) (ZMod pp.group.order) :=
+        fun i j => castScalar (w.2.2.2 i j)
+      let A0 : Matrix (Fin 3) (Fin 2) (ZMod pp.group.order) :=
