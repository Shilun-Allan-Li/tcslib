              (X ^ (-BB1.idToZ (G.group κ d) t).val * g ^ α₁.val)) ^ u.val)) ++
          List.ofFn ((G.group κ d).encG
            (Y ^ (-1 / (BB1.idToZ (G.group κ d)
                (padFin ((bb1Scheme G ℓ).idLen.eval κ) (List.ofFn x)) -
              BB1.idToZ (G.group κ d) t)).val * g ^ u.val)))), s)
    | none => .pure (zeroBits _, s)
  | 2, mm, s, _ =>
    match s.1, s.2 with
