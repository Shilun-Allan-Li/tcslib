TCSlib.Cryptography.SecretSharing.ShamirEfficient	TCSlib.Shamir.iterate_lagStep	theorem	[propext, Classical.choice, Quot.sound]	∀ {q : ℕ} [inst : Fact (Nat.Prime q)] (f : TCSlib.Shamir.Party (ZMod q) → ZMod q) (a : TCSlib.Shamir.Party (ZMod q))   (l : List (TCSlib.Shamir.Party (ZMod q))) (n d : ZMod q),   TCSlib.Shamir.lagStep^[l.length]       (Turing.pairEncode (Turing.pairEncode q.bits (TCSlib.SecretSharing.resWord (TCSlib.Shamir.label a)))         (Turing.pairEncode (Complexity.BinArith.encWords (List.map (TCSlib.Shamir.entryWord f) l))           (Turing.pairEncode (TCSlib.SecretSharing.resWord n) (TCSlib.SecretSharing.resWord d)))) =     Turing.pairEncode (Turing.pairEncode q.bits (TCSlib.SecretSharing.resWord (TCSlib.Shamir.label a)))       (Turing.pairEncode []         (Turing.pairEncode (TCSlib.SecretSharing.resWord (n * TCSlib.Shamir.lagNum l a))           (TCSlib.SecretSharing.resWord (d * TCSlib.Shamir.lagDen l a))))
TCSlib.Cryptography.SecretSharing.ShamirEfficient	TCSlib.Shamir.iterate_recStep	theorem	[propext, Classical.choice, Quot.sound]	∀ {q : ℕ} [inst : Fact (Nat.Prime q)] (l : List (TCSlib.Shamir.Party (ZMod q)))   (f : TCSlib.Shamir.Party (ZMod q) → ZMod q) (l' : List (TCSlib.Shamir.Party (ZMod q))) (acc : ZMod q),   TCSlib.Shamir.recStep^[l'.length]       (Turing.pairEncode         (Turing.pairEncode q.bits (Complexity.BinArith.encWords (List.map (TCSlib.Shamir.entryWord f) l)))         (Turing.pairEncode (Complexity.BinArith.encWords (List.map (TCSlib.Shamir.entryWord f) l'))           (TCSlib.SecretSharing.resWord acc))) =     Turing.pairEncode (Turing.pairEncode q.bits (Complexity.BinArith.encWords (List.map (TCSlib.Shamir.entryWord f) l)))       (Turing.pairEncode []         (TCSlib.SecretSharing.resWord           (acc + (List.map (fun a => TCSlib.Shamir.lagNum l a * (TCSlib.Shamir.lagDen l a)⁻¹ * f a) l').sum)))
TCSlib.Cryptography.SecretSharing.ShamirEfficient	TCSlib.Shamir.iterate_shareStep	theorem	[propext, Quot.sound, Classical.choice]	∀ {p : ℕ} [NeZero p] (sec x : ZMod p) (r j : ℕ),   TCSlib.Shamir.shareStep^[j] (TCSlib.Shamir.shareState p sec x r 0) = TCSlib.Shamir.shareState p sec x r j
