TCSlib.Cryptography.SecretSharing.ShamirEfficient	TCSlib.Shamir.lagDen_eq	theorem	[propext, Classical.choice, Quot.sound]	∀ {F : Type u_1} [inst : Field F] [inst_1 : DecidableEq F] (l : List (TCSlib.Shamir.Party F))   (a : TCSlib.Shamir.Party F),   TCSlib.Shamir.lagDen l a =     (List.map (fun b => if b = a then 1 else TCSlib.Shamir.label b - TCSlib.Shamir.label a) l).prod
