TCSlib.Cryptography.SecretSharing.Efficient	TCSlib.SecretSharing.subModW_eq	theorem	[propext, Quot.sound]	∀ (z : List Bool),   TCSlib.SecretSharing.subModW z =     Complexity.PrefixByLength.take       (Turing.pairEncode (Complexity.pairFstD z)         (Complexity.BinArith.mod           (Turing.pairEncode             (Complexity.BinArith.sub               (Turing.pairEncode                 (Complexity.BinArith.add                   (Turing.pairEncode (Complexity.pairFstD (Complexity.pairSndD z)) (Complexity.pairFstD z)))                 (Complexity.pairSndD (Complexity.pairSndD z))))             (Complexity.pairFstD z))))
TCSlib.Cryptography.SecretSharing.Efficient	TCSlib.SecretSharing.subModW_resWord	theorem	[propext, Quot.sound, Classical.choice]	∀ {p : ℕ} [NeZero p] (a b : ZMod p),   TCSlib.SecretSharing.subModW       (Turing.pairEncode p.bits (Turing.pairEncode (TCSlib.SecretSharing.resWord a) (TCSlib.SecretSharing.resWord b))) =     TCSlib.SecretSharing.resWord (a - b)
TCSlib.Cryptography.SecretSharing.Efficient	TCSlib.SecretSharing.take_pairEncode_resWord	theorem	[propext, Quot.sound, Classical.choice]	∀ {p : ℕ} [NeZero p] (a : ZMod p),   Complexity.PrefixByLength.take (Turing.pairEncode p.bits (TCSlib.SecretSharing.resWord a)) =     TCSlib.SecretSharing.resWord a
TCSlib.Cryptography.SecretSharing.Efficient	TCSlib.SecretSharing.val_sub_eq_add_sub_mod	theorem	[propext, Quot.sound]	∀ {p : ℕ} [NeZero p] (a b : ZMod p), (a - b).val = (a.val + p - b.val) % p
TCSlib.Cryptography.SecretSharing.ShamirEfficient	TCSlib.Shamir.beq_resWord_label	theorem	[propext, Classical.choice, Quot.sound]	∀ {q : ℕ} [inst : Fact (Nat.Prime q)] (a b : TCSlib.Shamir.Party (ZMod q)),   Complexity.BinArith.beq       (Turing.pairEncode (TCSlib.SecretSharing.resWord (TCSlib.Shamir.label b))         (TCSlib.SecretSharing.resWord (TCSlib.Shamir.label a))) =     decide (b = a)
TCSlib.Cryptography.SecretSharing.ShamirEfficient	TCSlib.Shamir.coe_coinModulus	theorem	[propext]	∀ (b : Complexity.PolyExpr) (κ : ℕ) (π : { π // TCSlib.Shamir.shamirAdm b κ π }),   ↑↑(TCSlib.Shamir.coinModulus b κ π) = (↑π).p ^ ((↑π).k - 1)
TCSlib.Cryptography.SecretSharing.ShamirEfficient	TCSlib.Shamir.coeff_coinEquiv	theorem	[propext, Quot.sound, Classical.choice]	∀ (π : TCSlib.SecretSharing.ShamirParams) (r : Fin (π.p ^ (π.k - 1))) {j : ℕ},   j < π.k - 1 → (↑((TCSlib.Shamir.coinEquiv π) r)).coeff j = ↑(↑r / π.p ^ j % π.p)
TCSlib.Cryptography.SecretSharing.ShamirEfficient	TCSlib.Shamir.coinEquiv	def	[propext, Quot.sound, Classical.choice]	(π : TCSlib.SecretSharing.ShamirParams) → Fin (π.p ^ (π.k - 1)) ≃ ↥(Polynomial.degreeLT (ZMod π.p) (π.k - 1))
TCSlib.Cryptography.SecretSharing.ShamirEfficient	TCSlib.Shamir.coinEquiv_apply	theorem	[propext, Quot.sound, Classical.choice]	∀ (π : TCSlib.SecretSharing.ShamirParams) (r : Fin (π.p ^ (π.k - 1))),   (TCSlib.Shamir.coinEquiv π) r =     (Polynomial.degreeLTEquiv (ZMod π.p) (π.k - 1)).symm fun j =>       (TCSlib.Shamir.finZModEquiv π.p) (finFunctionFinEquiv.symm r j)
TCSlib.Cryptography.SecretSharing.ShamirEfficient	TCSlib.Shamir.coinModulus	def	[propext]	(b : Complexity.PolyExpr) →   (κ : ℕ) → { π // TCSlib.Shamir.shamirAdm b κ π } → TCSlib.Cryptography.CoinSampling.BoundedModulus b κ
TCSlib.Cryptography.SecretSharing.ShamirEfficient	TCSlib.Shamir.coinModulus_eq	theorem	[propext]	∀ (b : Complexity.PolyExpr) (κ : ℕ) (π : { π // TCSlib.Shamir.shamirAdm b κ π }),   TCSlib.Shamir.coinModulus b κ π = ⟨⟨(↑π).p ^ ((↑π).k - 1), ⋯⟩, ⋯⟩
TCSlib.Cryptography.SecretSharing.ShamirEfficient	TCSlib.Shamir.dealerPowStep	def	[propext, Quot.sound]	List Bool → List Bool
TCSlib.Cryptography.SecretSharing.ShamirEfficient	TCSlib.Shamir.dealerPowStep_eq	theorem	[propext, Quot.sound]	∀ (d : List Bool),   TCSlib.Shamir.dealerPowStep d =     Turing.pairEncode (Complexity.pairFstD d)       (Complexity.PrefixByLength.take         (Turing.pairEncode (Complexity.pairSndD d ++ Complexity.pairFstD d)           (Complexity.BinArith.mul (Turing.pairEncode (Complexity.pairSndD d) (Complexity.pairFstD d)))))
TCSlib.Cryptography.SecretSharing.ShamirEfficient	TCSlib.Shamir.dealerSamples_shamir	theorem	[propext, Quot.sound, Classical.choice]	∀ (b : Complexity.PolyExpr),   TCSlib.SecretSharing.DealerSamples (fun π => Fin (π.p ^ (π.k - 1))) (TCSlib.Shamir.shamirAdm b)     TCSlib.SecretSharing.ShamirParams.encode fun x r => (↑r).bits
TCSlib.Cryptography.SecretSharing.ShamirEfficient	TCSlib.Shamir.dealerWord	def	[propext, Quot.sound]	Complexity.PolyExpr → List Bool → List Bool
TCSlib.Cryptography.SecretSharing.ShamirEfficient	TCSlib.Shamir.dealerWord_eq	theorem	[propext, Quot.sound]	∀ (b : Complexity.PolyExpr) (z : List Bool),   TCSlib.Shamir.dealerWord b z =     TCSlib.Cryptography.Encoding.BinaryArith.fromLEPoly (b.add (Complexity.PolyExpr.const 1))       (Turing.pairEncode (Complexity.pairFstD z)         (Complexity.pairSndD           (Complexity.pairSndD             (Complexity.BinArith.forLoop TCSlib.Shamir.dealerPowStep               (Turing.pairEncode (List.drop 1 (Complexity.pairFstD (Complexity.pairSndD (Complexity.pairSndD z))))                 (Turing.pairEncode (Complexity.pairFstD (Complexity.pairSndD z)) [true]))))))
TCSlib.Cryptography.SecretSharing.ShamirEfficient	TCSlib.Shamir.entryWord	def	[propext, Classical.choice, Quot.sound]	{q : ℕ} →   [inst : Fact (Nat.Prime q)] → (TCSlib.Shamir.Party (ZMod q) → ZMod q) → TCSlib.Shamir.Party (ZMod q) → List Bool
TCSlib.Cryptography.SecretSharing.ShamirEfficient	TCSlib.Shamir.entryWord_eq	theorem	[propext, Classical.choice, Quot.sound]	∀ {q : ℕ} [inst : Fact (Nat.Prime q)] (f : TCSlib.Shamir.Party (ZMod q) → ZMod q) (b : TCSlib.Shamir.Party (ZMod q)),   TCSlib.Shamir.entryWord f b =     Turing.pairEncode (TCSlib.SecretSharing.resWord (TCSlib.Shamir.label b)) (TCSlib.SecretSharing.resWord (f b))
TCSlib.Cryptography.SecretSharing.ShamirEfficient	TCSlib.Shamir.eval_coinEquiv	theorem	[propext, Quot.sound, Classical.choice]	∀ (π : TCSlib.SecretSharing.ShamirParams) (r : Fin (π.p ^ (π.k - 1))) (x : ZMod π.p),   Polynomial.eval x ↑((TCSlib.Shamir.coinEquiv π) r) = ∑ j ∈ Finset.range (π.k - 1), ↑(↑r / π.p ^ j % π.p) * x ^ j
