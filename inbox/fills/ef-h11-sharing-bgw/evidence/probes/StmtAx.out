TCSlib.Cryptography.SecretSharing.ShamirEfficient	TCSlib.Shamir.recStep_eq	theorem	[propext, Quot.sound]	∀ (d : List Bool),   TCSlib.Shamir.recStep d =     Turing.pairEncode (Complexity.pairFstD d)       (Turing.pairEncode (Complexity.pairSndD (Complexity.pairFstD (Complexity.pairSndD d)))         (TCSlib.SecretSharing.addModW           (Turing.pairEncode (Complexity.pairFstD (Complexity.pairFstD d))             (Turing.pairEncode (Complexity.pairSndD (Complexity.pairSndD d))               (TCSlib.Shamir.lagTerm                 (Turing.pairEncode (Complexity.pairFstD d)                   (Complexity.pairFstD (Complexity.pairFstD (Complexity.pairSndD d)))))))))
TCSlib.Cryptography.SecretSharing.ShamirEfficient	TCSlib.Shamir.recombineRaw	def	[propext, Quot.sound]	List Bool → List Bool
TCSlib.Cryptography.SecretSharing.ShamirEfficient	TCSlib.Shamir.recombineRaw_eq	theorem	[propext, Quot.sound]	∀ (z : List Bool),   TCSlib.Shamir.recombineRaw z =     Complexity.pairSndD       (Complexity.pairSndD         (Complexity.pairSndD           (Complexity.BinArith.forLoop TCSlib.Shamir.recStep             (Turing.pairEncode (Complexity.BinArith.countW (Complexity.pairSndD z))               (Turing.pairEncode z (Turing.pairEncode (Complexity.pairSndD z) []))))))
TCSlib.Cryptography.SecretSharing.ShamirEfficient	TCSlib.Shamir.recombineRaw_spec	theorem	[propext, Classical.choice, Quot.sound]	∀ {q : ℕ} [inst : Fact (Nat.Prime q)] (l : List (TCSlib.Shamir.Party (ZMod q))),   l.Nodup →     ∀ (f : TCSlib.Shamir.Party (ZMod q) → ZMod q),       TCSlib.Shamir.recombineRaw           (Turing.pairEncode q.bits             (Complexity.BinArith.encWords               (List.map                 (fun a =>                   Turing.pairEncode (TCSlib.SecretSharing.resWord (TCSlib.Shamir.label a))                     (TCSlib.SecretSharing.resWord (f a)))                 l))) =         TCSlib.SecretSharing.resWord (TCSlib.Shamir.recombine l.toFinset f)
TCSlib.Cryptography.SecretSharing.ShamirEfficient	TCSlib.Shamir.recombine_toFinset_eq	theorem	[propext, Classical.choice, Quot.sound]	∀ {F : Type u_1} [inst : Field F] [inst_1 : DecidableEq F] (l : List (TCSlib.Shamir.Party F)),   l.Nodup →     ∀ (f : TCSlib.Shamir.Party F → F),       TCSlib.Shamir.recombine l.toFinset f =         (List.map (fun a => TCSlib.Shamir.lagNum l a * (TCSlib.Shamir.lagDen l a)⁻¹ * f a) l).sum
