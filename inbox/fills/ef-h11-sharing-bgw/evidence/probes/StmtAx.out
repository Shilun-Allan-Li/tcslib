TCSlib.Cryptography.SecretSharing.Efficient	TCSlib.SecretSharing.Scheme.restrict	def	[propext, Quot.sound, Classical.choice]	{P : Type u_1} →   {Q : Type u_2} →     {Secret : Type u_3} →       {Share : Type u_4} →         {Rand : Type u_5} →           {Rand' : Type u_6} →             TCSlib.SecretSharing.Scheme P Secret Share Rand →               (Q ↪ P) → Rand' ≃ Rand → Share → TCSlib.SecretSharing.Scheme Q Secret Share Rand'
TCSlib.Cryptography.SecretSharing.Efficient	TCSlib.SecretSharing.Scheme.restrict_correct	theorem	[propext, Quot.sound, Classical.choice]	∀ {P : Type u_1} {Q : Type u_2} {Secret : Type u_3} {Share : Type u_4} {Rand : Type u_5} {Rand' : Type u_6}   {S : TCSlib.SecretSharing.Scheme P Secret Share Rand} (e : Q ↪ P) (ε : Rand' ≃ Rand) (s₀ : Share)   {Γ : TCSlib.SecretSharing.AccessStructure P} {Γ' : TCSlib.SecretSharing.AccessStructure Q},   S.Correct Γ →     S.LocalReconstruct → (∀ (A : Finset Q), Γ'.Auth A → Γ.Auth (Finset.map e A)) → (S.restrict e ε s₀).Correct Γ'
TCSlib.Cryptography.SecretSharing.Efficient	TCSlib.SecretSharing.Scheme.restrict_localReconstruct	theorem	[propext, Quot.sound, Classical.choice]	∀ {P : Type u_1} {Q : Type u_2} {Secret : Type u_3} {Share : Type u_4} {Rand : Type u_5} {Rand' : Type u_6}   {S : TCSlib.SecretSharing.Scheme P Secret Share Rand} (e : Q ↪ P) (ε : Rand' ≃ Rand) (s₀ : Share),   S.LocalReconstruct → (S.restrict e ε s₀).LocalReconstruct
TCSlib.Cryptography.SecretSharing.Efficient	TCSlib.SecretSharing.Scheme.restrict_perfectPrivacy	theorem	[propext, Quot.sound, Classical.choice]	∀ {P : Type u_1} {Q : Type u_2} {Secret : Type u_3} {Share : Type u_4} {Rand : Type u_5} {Rand' : Type u_6}   {S : TCSlib.SecretSharing.Scheme P Secret Share Rand} (e : Q ↪ P) (ε : Rand' ≃ Rand) (s₀ : Share)   {Γ : TCSlib.SecretSharing.AccessStructure P} {Γ' : TCSlib.SecretSharing.AccessStructure Q},   S.PerfectPrivacy Γ → (∀ (B : Finset Q), ¬Γ'.Auth B → ¬Γ.Auth (Finset.map e B)) → (S.restrict e ε s₀).PerfectPrivacy Γ'
TCSlib.Cryptography.SecretSharing.Efficient	TCSlib.SecretSharing.Scheme.restrict_reconstruct	theorem	[propext, Quot.sound, Classical.choice]	∀ {P : Type u_1} {Q : Type u_2} {Secret : Type u_3} {Share : Type u_4} {Rand : Type u_5} {Rand' : Type u_6}   (S : TCSlib.SecretSharing.Scheme P Secret Share Rand) (e : Q ↪ P) (ε : Rand' ≃ Rand) (s₀ : Share) (A : Finset Q)   (f : Q → Share),   (S.restrict e ε s₀).reconstruct A f = S.reconstruct (Finset.map e A) (Function.extend (⇑e) f fun x => s₀)
TCSlib.Cryptography.SecretSharing.Efficient	TCSlib.SecretSharing.Scheme.restrict_reconstruct_of_eqOn	theorem	[propext, Quot.sound, Classical.choice]	∀ {P : Type u_1} {Q : Type u_2} {Secret : Type u_3} {Share : Type u_4} {Rand : Type u_5} {Rand' : Type u_6}   {S : TCSlib.SecretSharing.Scheme P Secret Share Rand} (e : Q ↪ P) (ε : Rand' ≃ Rand) (s₀ : Share),   S.LocalReconstruct →     ∀ (A : Finset Q) (f : Q → Share) (g : P → Share),       (∀ i ∈ A, g (e i) = f i) → (S.restrict e ε s₀).reconstruct A f = S.reconstruct (Finset.map e A) g
TCSlib.Cryptography.SecretSharing.Efficient	TCSlib.SecretSharing.Scheme.restrict_share	theorem	[propext, Quot.sound, Classical.choice]	∀ {P : Type u_1} {Q : Type u_2} {Secret : Type u_3} {Share : Type u_4} {Rand : Type u_5} {Rand' : Type u_6}   (S : TCSlib.SecretSharing.Scheme P Secret Share Rand) (e : Q ↪ P) (ε : Rand' ≃ Rand) (s₀ : Share) (sec : Secret)   (r : Rand') (i : Q), (S.restrict e ε s₀).share sec r i = S.share sec (ε r) (e i)
