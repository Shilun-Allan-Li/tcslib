TCSlib.Cryptography.SecretSharing.Efficient	TCSlib.SecretSharing.addModW_eq	theorem	[propext, Quot.sound]	∀ (z : List Bool),   TCSlib.SecretSharing.addModW z =     Complexity.PrefixByLength.take       (Turing.pairEncode (Complexity.pairFstD z)         (Complexity.BinArith.mod           (Turing.pairEncode             (Complexity.BinArith.add               (Turing.pairEncode (Complexity.pairFstD (Complexity.pairSndD z))                 (Complexity.pairSndD (Complexity.pairSndD z))))             (Complexity.pairFstD z))))
TCSlib.Cryptography.SecretSharing.Efficient	TCSlib.SecretSharing.addModW_resWord	theorem	[propext, Quot.sound, Classical.choice]	∀ {p : ℕ} [NeZero p] (a b : ZMod p),   TCSlib.SecretSharing.addModW       (Turing.pairEncode p.bits (Turing.pairEncode (TCSlib.SecretSharing.resWord a) (TCSlib.SecretSharing.resWord b))) =     TCSlib.SecretSharing.resWord (a + b)
