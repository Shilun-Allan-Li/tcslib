TCSlib.Cryptography.SecretSharing.ShamirEfficient	TCSlib.Shamir.lagStep_eq	theorem	[propext, Quot.sound]	∀ (d : List Bool),   TCSlib.Shamir.lagStep d =     if         Complexity.BinArith.beq             (Turing.pairEncode (Complexity.pairFstD (Complexity.pairFstD (Complexity.pairFstD (Complexity.pairSndD d))))               (Complexity.pairSndD (Complexity.pairFstD d))) =           true then       Turing.pairEncode (Complexity.pairFstD d)         (Turing.pairEncode (Complexity.pairSndD (Complexity.pairFstD (Complexity.pairSndD d)))           (Complexity.pairSndD (Complexity.pairSndD d)))     else       Turing.pairEncode (Complexity.pairFstD d)         (Turing.pairEncode (Complexity.pairSndD (Complexity.pairFstD (Complexity.pairSndD d)))           (Turing.pairEncode             (TCSlib.SecretSharing.mulModW               (Turing.pairEncode (Complexity.pairFstD (Complexity.pairFstD d))                 (Turing.pairEncode (Complexity.pairFstD (Complexity.pairSndD (Complexity.pairSndD d)))                   (Complexity.pairFstD (Complexity.pairFstD (Complexity.pairFstD (Complexity.pairSndD d)))))))             (TCSlib.SecretSharing.mulModW               (Turing.pairEncode (Complexity.pairFstD (Complexity.pairFstD d))                 (Turing.pairEncode (Complexity.pairSndD (Complexity.pairSndD (Complexity.pairSndD d)))                   (TCSlib.SecretSharing.subModW                     (Turing.pairEncode (Complexity.pairFstD (Complexity.pairFstD d))                       (Turing.pairEncode                         (Complexity.pairFstD (Complexity.pairFstD (Complexity.pairFstD (Complexity.pairSndD d))))                         (Complexity.pairSndD (Complexity.pairFstD d))))))))))
