TCSlib.Cryptography.MPC.BGW.Efficient	TCSlib.MPC.BGW.addModW_bgwEval	theorem	[propext, Classical.choice, Quot.sound]	∀ {p : ℕ} [inst : Fact (Nat.Prime p)] {d : ℕ} {ι : Type u_1} (R : TCSlib.MPC.BGW.Resharer (ZMod p) d)   (A : Finset (TCSlib.Shamir.Party (ZMod p))) (inp : ι → TCSlib.Shamir.Party (ZMod p) → ZMod p)   (j : TCSlib.Shamir.Party (ZMod p)) (a b : TCSlib.MPC.Circuit (ZMod p) ι),   TCSlib.SecretSharing.addModW       (Turing.pairEncode p.bits         (Turing.pairEncode (TCSlib.SecretSharing.resWord (TCSlib.MPC.BGW.bgwEval R A inp a j))           (TCSlib.SecretSharing.resWord (TCSlib.MPC.BGW.bgwEval R A inp b j)))) =     TCSlib.SecretSharing.resWord (TCSlib.MPC.BGW.bgwEval R A inp (a.add b) j)
