TCSlib.Cryptography.SecretSharing.Efficient	TCSlib.SecretSharing.EfficientScheme.mk.sizeOf_spec	theorem	[propext, Quot.sound, Classical.choice]	∀ (Pub : Type) (Party Secret Share Rand : Pub → Type)   (scheme : (π : Pub) → TCSlib.SecretSharing.Scheme (Party π) (Secret π) (Share π) (Rand π))   (access : (π : Pub) → TCSlib.SecretSharing.AccessStructure (Party π)) (Adm : ℕ → Pub → Prop)   (encPub : Pub → List Bool) (encParty : (π : Pub) → Party π → List Bool) (encSecret : (π : Pub) → Secret π → List Bool)   (encShare : (π : Pub) → Share π → List Bool) (encRand : (π : Pub) → Rand π → List Bool)   (share_poly :     ∃ f,       Complexity.PolyTimeComputable f ∧         ∀ (π : Pub) (sec : Secret π) (r : Rand π) (i : Party π),           f               (Turing.pairEncode (encPub π)                 (Turing.pairEncode (encSecret π sec) (Turing.pairEncode (encRand π r) (encParty π i)))) =             encShare π ((scheme π).share sec r i))   (reconstruct_poly :     ∃ f,       Complexity.PolyTimeComputable f ∧         ∀ (π : Pub) (A : Finset (Party π)) (l : List (Party π)) (sh : Party π → Share π),           l.Nodup →             (∀ (i : Party π), i ∈ l ↔ i ∈ A) →               f                   (Turing.pairEncode (encPub π)                     (Complexity.BinArith.encWords                       (List.map (fun i => Turing.pairEncode (encParty π i) (encShare π (sh i))) l))) =                 encSecret π ((scheme π).reconstruct A sh))   (dealer_efficient : TCSlib.SecretSharing.DealerSamples Rand Adm encPub encRand),   sizeOf       { Pub := Pub, Party := Party, Secret := Secret, Share := Share, Rand := Rand, scheme := scheme, access := access,         Adm := Adm, encPub := encPub, encParty := encParty, encSecret := encSecret, encShare := encShare,         encRand := encRand, share_poly := share_poly, reconstruct_poly := reconstruct_poly,         dealer_efficient := dealer_efficient } =     1 + sizeOf Pub + sizeOf share_poly + sizeOf reconstruct_poly + sizeOf dealer_efficient
