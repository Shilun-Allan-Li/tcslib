TCSlib.Cryptography.SecretSharing.Efficient	TCSlib.SecretSharing.dealerSamples_iff	theorem	[propext, Quot.sound, Classical.choice]	∀ {Pub : Type} (Rand : Pub → Type) (Adm : ℕ → Pub → Prop) (encPub : Pub → List Bool)   (encRand : (π : Pub) → Rand π → List Bool),   TCSlib.SecretSharing.DealerSamples Rand Adm encPub encRand ↔     ∃ y encDraw,       (∃ g,           Complexity.PolyTimeComputable g ∧             ∀ (κ : ℕ) (π : { π // Adm κ π }), g (Complexity.NUPPT.advInput κ (encPub ↑π)) = y κ π) ∧         TCSlib.Cryptography.CoinSampling.SamplesEfficiently y encDraw (fun x π => encRand ↑π) fun x x_1 r => r
