TCSlib.Cryptography.MPC.BGW.Efficient	TCSlib.MPC.BGW.reshare_dealerSamples	theorem	[propext, Quot.sound, Classical.choice]	∀ (b : Complexity.PolyExpr),   ∃ f,     Complexity.PolyTimeComputable f ∧       (∀ (π : TCSlib.SecretSharing.ShamirParams) (ρ : TCSlib.Shamir.Party (ZMod π.p) → ZMod π.p → Fin (π.p ^ (π.k - 1)))           (i : TCSlib.Shamir.Party (ZMod π.p)) (x : ZMod π.p) (j : TCSlib.Shamir.Party (ZMod π.p)),           f               (Turing.pairEncode π.encode                 (Turing.pairEncode (TCSlib.SecretSharing.resWord x)                   (Turing.pairEncode (↑(ρ i x)).bits (TCSlib.SecretSharing.resWord (TCSlib.Shamir.label j))))) =             TCSlib.SecretSharing.resWord ((TCSlib.MPC.BGW.shamirResharer π ρ).reshare i x j)) ∧         TCSlib.SecretSharing.DealerSamples (fun π => Fin (π.p ^ (π.k - 1))) (TCSlib.Shamir.shamirAdm b)           TCSlib.SecretSharing.ShamirParams.encode fun x r => (↑r).bits
