TCSlib.Cryptography.SecretSharing.ShamirEfficient	TCSlib.Shamir.shamirScheme_localReconstruct	theorem	[propext, Quot.sound, Classical.choice]	∀ (π : TCSlib.SecretSharing.ShamirParams), (TCSlib.Shamir.shamirScheme π).LocalReconstruct
TCSlib.Cryptography.SecretSharing.ShamirEfficient	TCSlib.Shamir.shamirScheme_perfectPrivacy	theorem	[propext, Quot.sound, Classical.choice]	∀ (π : TCSlib.SecretSharing.ShamirParams),   (TCSlib.Shamir.shamirScheme π).PerfectPrivacy (TCSlib.SecretSharing.AccessStructure.threshold π.k)
TCSlib.Cryptography.SecretSharing.ShamirEfficient	TCSlib.Shamir.shamirScheme_reconstruct	theorem	[propext, Quot.sound, Classical.choice]	∀ (π : TCSlib.SecretSharing.ShamirParams) (A : Finset (Fin π.n)) (f : Fin π.n → ZMod π.p)   (g : TCSlib.Shamir.Party (ZMod π.p) → ZMod π.p),   (∀ i ∈ A, g ((TCSlib.Shamir.partyEmb π) i) = f i) →     (TCSlib.Shamir.shamirScheme π).reconstruct A f = TCSlib.Shamir.recombine (Finset.map (TCSlib.Shamir.partyEmb π) A) g
TCSlib.Cryptography.SecretSharing.ShamirEfficient	TCSlib.Shamir.shamirScheme_share	theorem	[propext, Quot.sound, Classical.choice]	∀ (π : TCSlib.SecretSharing.ShamirParams) (sec : ZMod π.p) (r : Fin (π.p ^ (π.k - 1))) (i : Fin π.n),   (TCSlib.Shamir.shamirScheme π).share sec r i =     (TCSlib.Shamir.scheme π.k (ZMod π.p)).share sec ((TCSlib.Shamir.coinEquiv π) r) ((TCSlib.Shamir.partyEmb π) i)
TCSlib.Cryptography.SecretSharing.ShamirEfficient	TCSlib.Shamir.shareRaw	def	[propext, Quot.sound]	List Bool → List Bool
TCSlib.Cryptography.SecretSharing.ShamirEfficient	TCSlib.Shamir.shareRaw_eq	theorem	[propext, Quot.sound]	∀ (z : List Bool),   TCSlib.Shamir.shareRaw z =     Complexity.pairSndD       (Complexity.pairSndD         (Complexity.pairSndD           (Complexity.pairSndD             (Complexity.BinArith.forLoop TCSlib.Shamir.shareStep               (Turing.pairEncode (List.drop 1 (Complexity.pairFstD (Complexity.pairSndD (Complexity.pairFstD z))))                 (Turing.pairEncode                   (Turing.pairEncode (Complexity.pairFstD (Complexity.pairFstD z))                     (Complexity.pairSndD (Complexity.pairSndD (Complexity.pairSndD z))))                   (Turing.pairEncode (Complexity.pairFstD (Complexity.pairSndD (Complexity.pairSndD z)))                     (Turing.pairEncode (Complexity.pairSndD (Complexity.pairSndD (Complexity.pairSndD z)))                       (Complexity.pairFstD (Complexity.pairSndD z))))))))))
TCSlib.Cryptography.SecretSharing.ShamirEfficient	TCSlib.Shamir.shareRaw_spec	theorem	[propext, Quot.sound, Classical.choice]	∀ (π : TCSlib.SecretSharing.ShamirParams) (sec : ZMod π.p) (r : Fin (π.p ^ (π.k - 1))) (x : ZMod π.p),   TCSlib.Shamir.shareRaw       (Turing.pairEncode π.encode         (Turing.pairEncode (TCSlib.SecretSharing.resWord sec)           (Turing.pairEncode (↑r).bits (TCSlib.SecretSharing.resWord x)))) =     TCSlib.SecretSharing.resWord (Polynomial.eval x (TCSlib.Shamir.poly sec ((TCSlib.Shamir.coinEquiv π) r)))
