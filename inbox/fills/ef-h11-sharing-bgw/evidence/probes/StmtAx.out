TCSlib.Cryptography.SecretSharing.ShamirEfficient	TCSlib.Shamir.lagTerm_eq	theorem	[propext, Quot.sound]	∀ (w : List Bool),   TCSlib.Shamir.lagTerm w =     have S :=       Complexity.pairSndD         (Complexity.BinArith.forLoop TCSlib.Shamir.lagStep           (Turing.pairEncode (Complexity.BinArith.countW (Complexity.pairSndD (Complexity.pairFstD w)))             (Turing.pairEncode               (Turing.pairEncode (Complexity.pairFstD (Complexity.pairFstD w))                 (Complexity.pairFstD (Complexity.pairSndD w)))               (Turing.pairEncode (Complexity.pairSndD (Complexity.pairFstD w)) (Turing.pairEncode [true] [true])))));     TCSlib.SecretSharing.mulModW       (Turing.pairEncode (Complexity.pairFstD (Complexity.pairFstD w))         (Turing.pairEncode           (TCSlib.SecretSharing.mulModW             (Turing.pairEncode (Complexity.pairFstD (Complexity.pairFstD w))               (Turing.pairEncode (Complexity.pairFstD (Complexity.pairSndD (Complexity.pairSndD S)))                 (TCSlib.SecretSharing.invModW                   (Turing.pairEncode (Complexity.pairFstD (Complexity.pairFstD w))                     (Complexity.pairSndD (Complexity.pairSndD (Complexity.pairSndD S))))))))           (Complexity.pairSndD (Complexity.pairSndD w))))
TCSlib.Cryptography.SecretSharing.ShamirEfficient	TCSlib.Shamir.lagTerm_spec	theorem	[propext, Classical.choice, Quot.sound]	∀ {q : ℕ} [inst : Fact (Nat.Prime q)] (l : List (TCSlib.Shamir.Party (ZMod q)))   (f : TCSlib.Shamir.Party (ZMod q) → ZMod q) (a : TCSlib.Shamir.Party (ZMod q)) (s : ZMod q),   TCSlib.Shamir.lagTerm       (Turing.pairEncode         (Turing.pairEncode q.bits (Complexity.BinArith.encWords (List.map (TCSlib.Shamir.entryWord f) l)))         (Turing.pairEncode (TCSlib.SecretSharing.resWord (TCSlib.Shamir.label a)) (TCSlib.SecretSharing.resWord s))) =     TCSlib.SecretSharing.resWord (TCSlib.Shamir.lagNum l a * (TCSlib.Shamir.lagDen l a)⁻¹ * s)
