DERAND-AXIOMS {"axioms":[],"home":"TCSlib.Complexity.Randomized.Classes","name":"Randomized.majorityVerifier_def","type":"∀ (M : List Bool → List Bool → Bool) (p k : ℕ → ℕ),\n  Randomized.majorityVerifier M p k = fun x r =>\n    have n := x.length;\n    have votes := List.countP (fun i => M x (List.take (p n) (List.drop (i * p n) r))) (List.range (k n));\n    decide (k n < 2 * votes)"}
