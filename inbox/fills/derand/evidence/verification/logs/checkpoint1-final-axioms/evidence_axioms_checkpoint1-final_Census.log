DERAND-AXIOMS {"axioms":["propext","Quot.sound","Classical.choice"],"home":"TCSlib.Complexity.Randomized.Build.IterateFind","name":"Complexity.IterateFind.polyTimeComputable_find","type":"∀ {g : List Bool → List Bool},\n  Complexity.PolyTimeComputable g →\n    ∀ {acc : List Bool → Bool},\n      (Complexity.PolyTimeComputable fun s => [acc s]) →\n        ∀ {out : List Bool → List Bool},\n          Complexity.PolyTimeComputable out →\n            ∀ (R P : Complexity.PolyExpr),\n              (∀ (x : List Bool), ∀ i ≤ R.eval x.length, (g^[i] x).length ≤ P.eval x.length) →\n                Complexity.PolyTimeComputable fun x =>\n                  match\n                    List.find?\n                      (fun i =>\n                        acc (Complexity.pairSndD ((Complexity.IterateFind.step g P x)^[i] (Turing.pairEncode x x))))\n                      (List.range (R.eval x.length + 1)) with\n                  | some i =>\n                    out (Complexity.pairSndD ((Complexity.IterateFind.step g P x)^[i] (Turing.pairEncode x x)))\n                  | none => []"}
